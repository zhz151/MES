@using MES.Core.Models
@using MES.Blazor.Services

<div class="column-filter" style="display:inline-flex; align-items:center; position:relative;">
    @if (Column?.FilterType != null)
    {
        <button type="button"
                id="@_dropId"
                class="filter-btn"
                title="筛选"
                @onclick="ToggleMenu"
                style="background:none; border:none; cursor:pointer; padding:2px 4px; display:inline-flex; align-items:center; font-size:16px; color:@FilterColor; line-height:1;">
            ▼
        </button>
    }

    @* 遮罩 *@
    <div class="filter-overlay"
         style="display:@(_showMenu ? "block" : "none"); position:fixed; inset:0; z-index:999; background:rgba(0,0,0,0.15);"
         @onclick="CloseMenu"></div>

    @* 弹窗 *@
    <div class="filter-popup"
         style="display:@(_showMenu ? "block" : "none"); position:fixed; z-index:1000; background:#fff; border:1px solid #d0d0d0; border-radius:4px; box-shadow:0 4px 16px rgba(0,0,0,0.18); padding:8px; min-width:200px; max-width:260px; left:50%; top:50%; transform:translate(-50%,-50%);">
        @if (Column != null)
        {
            <div style="font-size:12px; color:#666; margin-bottom:4px; border-bottom:1px solid #eee; padding-bottom:4px;">
                @Column.Label
            </div>
            @switch (Column.FilterType)
            {
                case "enum":
                    @RenderEnumFilter()
                    break;
                case "string":
                    @RenderStringFilter()
                    break;
                case "number":
                    @RenderNumberFilter()
                    break;
                case "date":
                    @RenderDateFilter()
                    break;
                case "boolean":
                    @RenderBoolFilter()
                    break;
            }
            <button @onclick="ClearFilter"
                    style="width:100%; padding:4px; cursor:pointer; border:none; background:transparent; color:#999; margin-top:4px; font-size:12px;">清除</button>
        }
    </div>
</div>

@code {
    private static int _counter;
    private string _dropId = $"cf-{++_counter}";

    private bool _showMenu;
    private bool _hasActiveFilter;

    // 通用输入
    private string? _filterValue;
    private string _selectedOperator = "contains";

    // 日期范围
    private string? _dateFrom;
    private string? _dateTo;

    // 枚举多选
    private HashSet<string> _selectedEnumValues = new();

    private string FilterColor => _hasActiveFilter ? "#1976d2" : "#999";

    [Parameter] public ColumnDef? Column { get; set; }
    [Parameter] public EventCallback<FilterDescriptor?> FilterChanged { get; set; }
    [CascadingParameter] public FilterCallback? FilterHost { get; set; }

    // ==================== 弹出控制 ====================

    private void ToggleMenu()
    {
        _showMenu = !_showMenu;
        if (_showMenu)
        {
            InitMenu();
        }
        StateHasChanged();
    }

    private void CloseMenu()
    {
        _showMenu = false;
        StateHasChanged();
    }

    private void InitMenu()
    {
        _filterValue = null;
        _dateFrom = null;
        _dateTo = null;
        _selectedEnumValues = new();
        _selectedOperator = Column?.FilterType switch
        {
            "string" => "contains",
            "number" => "equals",
            "date" => "equals",
            _ => "equals"
        };
    }

    // ==================== 渲染片段 ====================

    // -- 枚举多选 --
    private const string NullSentinel = "__NULL__";
    private RenderFragment RenderEnumFilter() => builder =>
    {
        var options = Column?.EnumOptions;
        if (options == null || options.Count == 0) return;

        // 全选 / 清除
        builder.OpenElement(0, "div");
        builder.AddAttribute(1, "style", "display:flex; gap:8px; margin-bottom:4px;");
        builder.OpenElement(2, "button");
        builder.AddAttribute(3, "type", "button");
        builder.AddAttribute(4, "onclick", EventCallback.Factory.Create(this, SelectAll));
        builder.AddAttribute(5, "style", "font-size:12px; padding:2px 8px; cursor:pointer; border:1px solid #ccc; background:#f5f5f5; border-radius:3px;");
        builder.AddContent(6, "全选");
        builder.CloseElement();
        builder.OpenElement(7, "button");
        builder.AddAttribute(8, "type", "button");
        builder.AddAttribute(9, "onclick", EventCallback.Factory.Create(this, ClearAll));
        builder.AddAttribute(10, "style", "font-size:12px; padding:2px 8px; cursor:pointer; border:1px solid #ccc; background:#f5f5f5; border-radius:3px;");
        builder.AddContent(11, "清除");
        builder.CloseElement();
        builder.CloseElement();

        // 选项列表（可滚动）
        builder.OpenElement(12, "div");
        builder.AddAttribute(13, "style", "max-height:200px; overflow-y:auto; margin-bottom:4px;");
        var idx = 14;
        foreach (var opt in options)
        {
            builder.OpenElement(idx++, "label");
            builder.AddAttribute(idx++, "style", "display:flex; align-items:center; padding:2px 0; cursor:pointer; font-size:13px;");
            builder.OpenElement(idx++, "input");
            builder.AddAttribute(idx++, "type", "checkbox");
            builder.AddAttribute(idx++, "checked", _selectedEnumValues.Contains(opt.Value));
            builder.AddAttribute(idx++, "onchange", EventCallback.Factory.Create<ChangeEventArgs>(this, e => ToggleEnumValue(opt.Value, (bool)(e.Value ?? false))));
            builder.CloseElement();
            builder.AddContent(idx++, " ");
            builder.AddContent(idx++, opt.Display);
            builder.CloseElement();
        }
        // 空值选项（作为列表中的一项）
        builder.OpenElement(idx++, "label");
        builder.AddAttribute(idx++, "style", "display:flex; align-items:center; padding:2px 0; cursor:pointer; font-size:13px; color:#888; border-top:1px solid #eee;");
        builder.OpenElement(idx++, "input");
        builder.AddAttribute(idx++, "type", "checkbox");
        builder.AddAttribute(idx++, "checked", _selectedEnumValues.Contains(NullSentinel));
        builder.AddAttribute(idx++, "onchange", EventCallback.Factory.Create<ChangeEventArgs>(this, e => ToggleEnumValue(NullSentinel, (bool)(e.Value ?? false))));
        builder.CloseElement();
        builder.AddContent(idx++, " (空值)");
        builder.CloseElement();
        builder.CloseElement();

        // 确定按钮
        builder.OpenElement(idx++, "button");
        builder.AddAttribute(idx++, "type", "button");
        builder.AddAttribute(idx++, "onclick", EventCallback.Factory.Create(this, ApplyEnumFilter));
        builder.AddAttribute(idx++, "style", "width:100%; padding:8px; cursor:pointer; border:1px solid #1976d2; background:#1976d2; color:#fff; border-radius:4px; margin-top:6px; font-size:14px;");
        builder.AddContent(idx++, "确定");
        builder.CloseElement();
    };

    // -- 文本筛选 --
    private RenderFragment RenderStringFilter() => builder =>
    {
        // 操作符下拉
        builder.OpenElement(0, "select");
        builder.AddAttribute(1, "value", _selectedOperator);
        builder.AddAttribute(2, "onchange", EventCallback.Factory.Create<ChangeEventArgs>(this, e => _selectedOperator = e.Value?.ToString() ?? "contains"));
        builder.AddAttribute(3, "style", "width:100%; padding:6px; border:1px solid #ccc; border-radius:4px; font-size:13px; margin-bottom:6px;");
        builder.OpenElement(4, "option"); builder.AddAttribute(5, "value", "contains"); builder.AddContent(6, "包含"); builder.CloseElement();
        builder.OpenElement(7, "option"); builder.AddAttribute(8, "value", "equals"); builder.AddContent(9, "等于"); builder.CloseElement();
        builder.OpenElement(10, "option"); builder.AddAttribute(11, "value", "startswith"); builder.AddContent(12, "开头是"); builder.CloseElement();
        builder.OpenElement(13, "option"); builder.AddAttribute(14, "value", "isnull"); builder.AddContent(15, "(空)"); builder.CloseElement();
        builder.CloseElement();

        // 文本输入（空值操作符时隐藏）
        if (_selectedOperator != "isnull")
        {
            builder.OpenElement(16, "input");
            builder.AddAttribute(17, "type", "text");
            builder.AddAttribute(18, "placeholder", GetPlaceholder());
            builder.AddAttribute(19, "value", _filterValue);
            builder.AddAttribute(20, "oninput", EventCallback.Factory.Create<ChangeEventArgs>(this, e => _filterValue = e.Value?.ToString()));
            builder.AddAttribute(21, "style", "width:100%; padding:8px; box-sizing:border-box; border:1px solid #ccc; border-radius:4px; font-size:14px;");
            builder.CloseElement();
        }

        // 确定按钮
        builder.OpenElement(22, "button");
        builder.AddAttribute(23, "type", "button");
        builder.AddAttribute(24, "onclick", EventCallback.Factory.Create(this, ApplyCurrentFilter));
        builder.AddAttribute(25, "style", "width:100%; padding:8px; cursor:pointer; border:1px solid #1976d2; background:#1976d2; color:#fff; border-radius:4px; margin-top:6px;");
        builder.AddContent(26, "确定");
        builder.CloseElement();
    };

    // -- 数字筛选 --
    private RenderFragment RenderNumberFilter() => builder =>
    {
        // 操作符下拉
        builder.OpenElement(0, "select");
        builder.AddAttribute(1, "value", _selectedOperator);
        builder.AddAttribute(2, "onchange", EventCallback.Factory.Create<ChangeEventArgs>(this, e => _selectedOperator = e.Value?.ToString() ?? "equals"));
        builder.AddAttribute(3, "style", "width:100%; padding:6px; border:1px solid #ccc; border-radius:4px; font-size:13px; margin-bottom:6px;");
        builder.OpenElement(4, "option"); builder.AddAttribute(5, "value", "equals"); builder.AddContent(6, "等于"); builder.CloseElement();
        builder.OpenElement(7, "option"); builder.AddAttribute(8, "value", "gt"); builder.AddContent(9, "大于"); builder.CloseElement();
        builder.OpenElement(10, "option"); builder.AddAttribute(11, "value", "gte"); builder.AddContent(12, "大于等于"); builder.CloseElement();
        builder.OpenElement(13, "option"); builder.AddAttribute(14, "value", "lt"); builder.AddContent(15, "小于"); builder.CloseElement();
        builder.OpenElement(16, "option"); builder.AddAttribute(17, "value", "lte"); builder.AddContent(18, "小于等于"); builder.CloseElement();
        builder.OpenElement(19, "option"); builder.AddAttribute(20, "value", "range"); builder.AddContent(21, "范围"); builder.CloseElement();
        builder.OpenElement(22, "option"); builder.AddAttribute(23, "value", "isnull"); builder.AddContent(24, "(空)"); builder.CloseElement();
        builder.CloseElement();

        if (_selectedOperator == "range")
        {
            builder.OpenElement(25, "input");
            builder.AddAttribute(26, "type", "text"); builder.AddAttribute(27, "placeholder", "最小值");
            builder.AddAttribute(28, "value", _dateFrom); builder.AddAttribute(29, "oninput", EventCallback.Factory.Create<ChangeEventArgs>(this, e => _dateFrom = e.Value?.ToString()));
            builder.AddAttribute(30, "style", "width:100%; padding:8px; box-sizing:border-box; border:1px solid #ccc; border-radius:4px; font-size:14px; margin-bottom:4px;");
            builder.CloseElement();
            builder.OpenElement(31, "input");
            builder.AddAttribute(32, "type", "text"); builder.AddAttribute(33, "placeholder", "最大值");
            builder.AddAttribute(34, "value", _dateTo); builder.AddAttribute(35, "oninput", EventCallback.Factory.Create<ChangeEventArgs>(this, e => _dateTo = e.Value?.ToString()));
            builder.AddAttribute(36, "style", "width:100%; padding:8px; box-sizing:border-box; border:1px solid #ccc; border-radius:4px; font-size:14px;");
            builder.CloseElement();
        }
        else if (_selectedOperator != "isnull")
        {
            builder.OpenElement(25, "input");
            builder.AddAttribute(26, "type", "text"); builder.AddAttribute(27, "placeholder", "数值");
            builder.AddAttribute(28, "value", _filterValue); builder.AddAttribute(29, "oninput", EventCallback.Factory.Create<ChangeEventArgs>(this, e => _filterValue = e.Value?.ToString()));
            builder.AddAttribute(30, "style", "width:100%; padding:8px; box-sizing:border-box; border:1px solid #ccc; border-radius:4px; font-size:14px;");
            builder.CloseElement();
        }

        // 确定
        builder.OpenElement(37, "button");
        builder.AddAttribute(38, "type", "button");
        builder.AddAttribute(39, "onclick", EventCallback.Factory.Create(this, ApplyCurrentFilter));
        builder.AddAttribute(40, "style", "width:100%; padding:8px; cursor:pointer; border:1px solid #1976d2; background:#1976d2; color:#fff; border-radius:4px; margin-top:6px;");
        builder.AddContent(41, "确定");
        builder.CloseElement();
    };

    // -- 日期筛选 --
    private RenderFragment RenderDateFilter() => builder =>
    {
        // 操作符下拉
        builder.OpenElement(0, "select");
        builder.AddAttribute(1, "value", _selectedOperator);
        builder.AddAttribute(2, "onchange", EventCallback.Factory.Create<ChangeEventArgs>(this, e => _selectedOperator = e.Value?.ToString() ?? "equals"));
        builder.AddAttribute(3, "style", "width:100%; padding:6px; border:1px solid #ccc; border-radius:4px; font-size:13px; margin-bottom:6px;");
        builder.OpenElement(4, "option"); builder.AddAttribute(5, "value", "equals"); builder.AddContent(6, "等于"); builder.CloseElement();
        builder.OpenElement(7, "option"); builder.AddAttribute(8, "value", "range"); builder.AddContent(9, "范围"); builder.CloseElement();
        builder.OpenElement(10, "option"); builder.AddAttribute(11, "value", "isnull"); builder.AddContent(12, "(空)"); builder.CloseElement();
        builder.CloseElement();

        if (_selectedOperator == "range")
        {
            builder.OpenElement(13, "input");
            builder.AddAttribute(14, "type", "text"); builder.AddAttribute(15, "placeholder", "yyyy-MM-dd 起");
            builder.AddAttribute(16, "value", _dateFrom); builder.AddAttribute(17, "oninput", EventCallback.Factory.Create<ChangeEventArgs>(this, e => _dateFrom = e.Value?.ToString()));
            builder.AddAttribute(18, "style", "width:100%; padding:8px; box-sizing:border-box; border:1px solid #ccc; border-radius:4px; font-size:14px; margin-bottom:4px;");
            builder.CloseElement();
            builder.OpenElement(19, "input");
            builder.AddAttribute(20, "type", "text"); builder.AddAttribute(21, "placeholder", "yyyy-MM-dd 止");
            builder.AddAttribute(22, "value", _dateTo); builder.AddAttribute(23, "oninput", EventCallback.Factory.Create<ChangeEventArgs>(this, e => _dateTo = e.Value?.ToString()));
            builder.AddAttribute(24, "style", "width:100%; padding:8px; box-sizing:border-box; border:1px solid #ccc; border-radius:4px; font-size:14px;");
            builder.CloseElement();
        }
        else if (_selectedOperator != "isnull")
        {
            builder.OpenElement(13, "input");
            builder.AddAttribute(14, "type", "text"); builder.AddAttribute(15, "placeholder", "yyyy-MM-dd");
            builder.AddAttribute(16, "value", _filterValue); builder.AddAttribute(17, "oninput", EventCallback.Factory.Create<ChangeEventArgs>(this, e => _filterValue = e.Value?.ToString()));
            builder.AddAttribute(18, "style", "width:100%; padding:8px; box-sizing:border-box; border:1px solid #ccc; border-radius:4px; font-size:14px;");
            builder.CloseElement();
        }

        // 确定
        builder.OpenElement(25, "button");
        builder.AddAttribute(26, "type", "button");
        builder.AddAttribute(27, "onclick", EventCallback.Factory.Create(this, ApplyCurrentFilter));
        builder.AddAttribute(28, "style", "width:100%; padding:8px; cursor:pointer; border:1px solid #1976d2; background:#1976d2; color:#fff; border-radius:4px; margin-top:6px;");
        builder.AddContent(29, "确定");
        builder.CloseElement();
    };

    // -- 布尔筛选 --
    private RenderFragment RenderBoolFilter() => builder =>
    {
        var trueLabel = Column?.BoolTrueLabel ?? "是";
        var falseLabel = Column?.BoolFalseLabel ?? "否";

        builder.OpenElement(0, "div");
        builder.AddAttribute(1, "style", "display:flex; gap:6px;");
        builder.OpenElement(2, "button");
        builder.AddAttribute(3, "type", "button");
        builder.AddAttribute(4, "onclick", EventCallback.Factory.Create<MouseEventArgs>(this, _ => ApplyBoolFilter(true)));
        builder.AddAttribute(5, "style", "flex:1; padding:8px; cursor:pointer; border:1px solid #1976d2; background:#1976d2; color:#fff; border-radius:4px;");
        builder.AddContent(6, trueLabel);
        builder.CloseElement();
        builder.OpenElement(7, "button");
        builder.AddAttribute(8, "type", "button");
        builder.AddAttribute(9, "onclick", EventCallback.Factory.Create<MouseEventArgs>(this, _ => ApplyBoolFilter(false)));
        builder.AddAttribute(10, "style", "flex:1; padding:8px; cursor:pointer; border:1px solid #ccc; background:#fff; color:#333; border-radius:4px;");
        builder.AddContent(11, falseLabel);
        builder.CloseElement();
        builder.CloseElement();
    };

    // ==================== 枚举操作 ====================

    private void ToggleEnumValue(string value, bool selected)
    {
        if (selected) _selectedEnumValues.Add(value);
        else _selectedEnumValues.Remove(value);
    }

    private void SelectAll()
    {
        var options = Column?.EnumOptions;
        if (options != null)
            foreach (var o in options) _selectedEnumValues.Add(o.Value);
        _selectedEnumValues.Add(NullSentinel);
    }

    private void ClearAll()
    {
        _selectedEnumValues.Clear();
    }

    // ==================== 筛选应用 ====================

    private string GetPlaceholder()
    {
        return _selectedOperator switch
        {
            "contains" => "包含...",
            "startswith" => "开头是...",
            _ => "精确值"
        };
    }

    private async Task ApplyCurrentFilter()
    {
        var filterType = Column?.FilterType;
        var hasValue = !string.IsNullOrWhiteSpace(_filterValue);

        // 空值操作符：仅匹配 null
        if (_selectedOperator == "isnull")
        {
            _hasActiveFilter = true;
            var desc = new FilterDescriptor
            {
                Field = Column?.Key ?? "",
                Operator = "isnull",
                IncludeNull = true
            };
            await InvokeFilterAsync(desc);
            _showMenu = false;
            StateHasChanged();
            return;
        }

        // 数字/日期范围模式
        if (_selectedOperator == "range" && (filterType == "number" || filterType == "date"))
        {
            var hasFrom = !string.IsNullOrWhiteSpace(_dateFrom);
            var hasTo = !string.IsNullOrWhiteSpace(_dateTo);
            if (!hasFrom && !hasTo)
            {
                await ClearFieldFilter();
                return;
            }
            _hasActiveFilter = true;
            var desc = new FilterDescriptor
            {
                Field = Column?.Key ?? "",
                Operator = "range",
                From = hasFrom ? _dateFrom : null,
                To = hasTo ? _dateTo : null
            };
            await InvokeFilterAsync(desc);
            _showMenu = false;
            StateHasChanged();
            return;
        }

        // 普通单值筛选
        if (!hasValue)
        {
            await ClearFieldFilter();
            return;
        }

        _hasActiveFilter = true;
        var desc2 = new FilterDescriptor
        {
            Field = Column?.Key ?? "",
            Operator = _selectedOperator,
            Value = hasValue ? _filterValue : null
        };
        await InvokeFilterAsync(desc2);
        _showMenu = false;
        StateHasChanged();
    }

    private async Task ApplyEnumFilter()
    {
        bool includeNull = _selectedEnumValues.Remove(NullSentinel);

        if (_selectedEnumValues.Count == 0 && !includeNull)
        {
            await ClearFilter();
            return;
        }

        _hasActiveFilter = true;
        var desc = new FilterDescriptor
        {
            Field = Column?.Key ?? "",
            Operator = "in",
            Values = _selectedEnumValues.Count > 0 ? _selectedEnumValues.ToList() : null,
            IncludeNull = includeNull
        };
        await InvokeFilterAsync(desc);
        _showMenu = false;
        StateHasChanged();
    }

    private async Task ApplyBoolFilter(bool val)
    {
        _hasActiveFilter = true;
        _showMenu = false;
        var desc = new FilterDescriptor
        {
            Field = Column?.Key ?? "",
            Operator = "equals",
            Value = val ? "true" : "false"
        };
        await InvokeFilterAsync(desc);
        StateHasChanged();
    }

    private async Task InvokeFilterAsync(FilterDescriptor? desc)
    {
        if (FilterChanged.HasDelegate)
        {
            await FilterChanged.InvokeAsync(desc);
            return;
        }
        if (FilterHost?.Handler != null)
        {
            await FilterHost.Handler(desc);
        }
    }

    private async Task ClearFilter()
    {
        _filterValue = null;
        _dateFrom = null;
        _dateTo = null;
        _selectedEnumValues = new();
        _hasActiveFilter = false;
        _showMenu = false;
        // 发送字段级清除信号（空 Operator 表示仅清除该字段）
        await InvokeFilterAsync(new FilterDescriptor { Field = Column?.Key ?? "", Operator = "" });
        StateHasChanged();
    }

    /// <summary>
    /// 清除当前字段筛选（内部使用，与 ClearFilter 行为一致）
    /// </summary>
    private async Task ClearFieldFilter()
    {
        _filterValue = null;
        _dateFrom = null;
        _dateTo = null;
        _selectedEnumValues = new();
        _hasActiveFilter = false;
        _showMenu = false;
        await InvokeFilterAsync(new FilterDescriptor { Field = Column?.Key ?? "", Operator = "" });
        StateHasChanged();
    }
}
