@* 统一通知横幅组件 - 支持溢出滚动和关闭按钮 *@
<MudAlert Severity="Severity.Warning" Variant="Variant.Filled" Class="mb-4 notification-banner">
    <div class="d-flex justify-space-between align-center">
        <div class="notification-banner-body">
            @ChildContent
        </div>
        @if (ShowDismiss)
        {
            <MudButton Variant="Variant.Text" Size="Size.Small" Color="Color.Inherit"
                       OnClick="OnDismiss" Class="ml-4 flex-shrink-0">
                @DismissText
            </MudButton>
        }
    </div>
</MudAlert>

@code {
    /// <summary>是否显示关闭按钮</summary>
    [Parameter] public bool ShowDismiss { get; set; }

    /// <summary>关闭按钮文字，默认"全部忽略"</summary>
    [Parameter] public string DismissText { get; set; } = "全部忽略";

    /// <summary>关闭回调</summary>
    [Parameter] public EventCallback OnDismiss { get; set; }

    /// <summary>通知内容</summary>
    [Parameter] public RenderFragment ChildContent { get; set; } = default!;
}
