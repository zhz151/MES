@using System.Net.Http
@inject HttpClient Http
@inject IJSRuntime JS

<CascadingAuthenticationState>
    <Router AppAssembly="@typeof(App).Assembly">
        <Found Context="routeData">
            <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(Shared.ResponsiveLayout)" />
            <FocusOnNavigate RouteData="@routeData" Selector="h1" />
        </Found>
        <NotFound>
            <LayoutView Layout="@typeof(Shared.ResponsiveLayout)">
                <p>抱歉，此页面不存在。</p>
            </LayoutView>
        </NotFound>
    </Router>
</CascadingAuthenticationState>

@code {
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var apiBaseUrl = Http.BaseAddress?.ToString().TrimEnd('/');
            if (!string.IsNullOrEmpty(apiBaseUrl))
            {
                await JS.InvokeVoidAsync("MES_setApiUrl", apiBaseUrl);
            }
        }
    }
}
