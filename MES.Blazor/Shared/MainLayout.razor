            <!-- 首页 -->
            <MudNavLink Href="/" Match="NavLinkMatch.All">首页</MudNavLink>

            <!-- 订单模块（二级各自选档位） -->
            <AuthorizeView Roles="@Roles.Policies.OrderMenu">
                <MudNavGroup Title="订单管理" ExpandedIcon="@Icons.Material.Filled.ExpandMore" CollapsedIcon="@Icons.Material.Filled.ChevronRight">
                    <MudNavLink Href="/orders">订单列表</MudNavLink>
                    <MudNavLink Href="/customers">客户管理</MudNavLink>
                    <MudNavLink Href="/orders/pending-delivery">订单成品(在库)</MudNavLink>
                </MudNavGroup>
            </AuthorizeView>

            <!-- 工单模块（二级各自选档位） -->
            <AuthorizeView Roles="@Roles.Policies.WorkOrderMenu">
                <MudNavGroup Title="工单管理" ExpandedIcon="@Icons.Material.Filled.ExpandMore" CollapsedIcon="@Icons.Material.Filled.ChevronRight">
                    <MudNavLink Href="/workorders">工单首页</MudNavLink>
                    <MudNavLink Href="/material-plan-overview">用料计划总览</MudNavLink>
                    <MudNavLink Href="/workorders-demand-adjustment">工单需求调整</MudNavLink>
                    <MudNavLink Href="/workorder-execution">工单执行状况</MudNavLink>
                    <MudNavLink Href="/fixed-length-work-order-view">定尺工单定尺数据</MudNavLink>
                </MudNavGroup>
            </AuthorizeView>

            <!-- 计划排程（二级各自选档位） -->
            <AuthorizeView Roles="@Roles.Policies.SchedulingMenu">
                <MudNavGroup Title="计划排程" ExpandedIcon="@Icons.Material.Filled.ExpandMore" CollapsedIcon="@Icons.Material.Filled.ChevronRight">
                    <MudNavLink Href="/plan-overview">订单负荷总量</MudNavLink>
                    <MudNavLink Href="/scheduling-plans">工单排程</MudNavLink>
                    <MudNavLink Href="/cold-roll-plans">冷轧排程</MudNavLink>
                    <MudNavLink Href="/batch-plans">批次计划</MudNavLink>
                    <MudNavLink Href="/final-inspection-plan">成检计划</MudNavLink>
                </MudNavGroup>
            </AuthorizeView>

            <!-- 批次模块（二级各自选档位） -->
            <AuthorizeView Roles="@Roles.Policies.BatchMenu">
                <MudNavGroup Title="批次管理" ExpandedIcon="@Icons.Material.Filled.ExpandMore" CollapsedIcon="@Icons.Material.Filled.ChevronRight">
                    <MudNavLink Href="/batches">批次首页</MudNavLink>
                    <MudNavLink Href="/production-records">生产记录</MudNavLink>
                    <MudNavLink Href="/pickling-in-records">去油酸洗</MudNavLink>
                    <MudNavLink Href="/section-outsources">工段委外</MudNavLink>
                    <MudNavLink Href="/process-card-print">工艺卡打印</MudNavLink>
                </MudNavGroup>
            </AuthorizeView>

            <!-- 质量模块（二级各自选档位） -->
            <AuthorizeView Roles="@Roles.Policies.QualityMenu">
                <MudNavGroup Title="质量管理" ExpandedIcon="@Icons.Material.Filled.ExpandMore" CollapsedIcon="@Icons.Material.Filled.ChevronRight">
                    <MudNavLink Href="/quality/process-inspection">过程检验</MudNavLink>
                    <MudNavLink Href="/quality/material-receive-checks">成检到料</MudNavLink>
                    <MudNavLink Href="/quality/final-inspection">成品检验</MudNavLink>
                    <MudNavLink Href="/quality/process-tracking">成检追踪</MudNavLink>
                    <MudNavLink Href="/quality/ncr">不合格报告</MudNavLink>
                    
                        <MudNavGroup Title="炉号/化学" ExpandedIcon="@Icons.Material.Filled.ExpandMore" CollapsedIcon="@Icons.Material.Filled.ChevronRight">
                            <MudNavLink Href="/quality/furnace">炉号登记</MudNavLink>
                        </MudNavGroup>
                    
                    
