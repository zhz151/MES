                            <MudNavLink Href="/quality/chemical-analysis">化学检验</MudNavLink>
                            <MudNavLink Href="/quality/hardness-test">硬度检验</MudNavLink>
                            <MudNavLink Href="/quality/grain-size-test">晶粒度检验</MudNavLink>
                            <MudNavLink Href="/quality/pitting-corrosion-test">点腐蚀检验</MudNavLink>
                            <MudNavLink Href="/quality/intergranular-corrosion-test">晶间腐蚀检验</MudNavLink>
                            <MudNavLink Href="/quality/tensile-test">室温拉伸检验</MudNavLink>
                            <MudNavLink Href="/quality/metallographic-test">金相检验</MudNavLink>
                            <MudNavLink Href="/quality/flattening-test">压扁检验</MudNavLink>
                            <MudNavLink Href="/quality/flaring-test">扩口检验</MudNavLink>
                        </MudNavGroup>
                    
                    <MudNavLink Href="/quality/certificates">质量证明书</MudNavLink>
                </MudNavGroup>
            </AuthorizeView>

            <!-- 物料模块（二级各自选档位） -->
            <AuthorizeView Roles="@Roles.Policies.MaterialMenu">
                <MudNavGroup Title="物料管理" ExpandedIcon="@Icons.Material.Filled.ExpandMore" CollapsedIcon="@Icons.Material.Filled.ChevronRight">
                    <MudNavLink Href="/purchase-orders">采购订单</MudNavLink>
                    
                        <MudNavGroup Title="圆棒穿孔" ExpandedIcon="@Icons.Material.Filled.ExpandMore" CollapsedIcon="@Icons.Material.Filled.ChevronRight">
                            <MudNavLink Href="/subcontract-orders">圆棒穿孔</MudNavLink>
                            <MudNavLink Href="/subcontract-return-items">子项查询</MudNavLink>
                        </MudNavGroup>
                    
                    <MudNavLink Href="/suppliers">供应商管理</MudNavLink>
                </MudNavGroup>
            </AuthorizeView>

            <!-- 仓库模块（二级菜单权限：6 个子项各自门控，Admin 恒显示） -->
            <AuthorizeView Roles="@Roles.Policies.WarehouseMenu">
                <MudNavGroup Title="仓库管理" ExpandedIcon="@Icons.Material.Filled.ExpandMore" CollapsedIcon="@Icons.Material.Filled.ChevronRight">
                    <MudNavLink Href="/warehouse/raw">原料库</MudNavLink>
                    <MudNavLink Href="/warehouse/fg">成品库</MudNavLink>
                    <MudNavLink Href="/warehouse/wip">在制品库</MudNavLink>
                    <MudNavLink Href="/warehouse/defect">次品库</MudNavLink>
                    <MudNavLink Href="/warehouse/monthly-stock">物料进出存报表</MudNavLink>
                </MudNavGroup>
            </AuthorizeView>

            <!-- 设备模块（二级各自选档位） -->
            <AuthorizeView Roles="@Roles.Policies.EquipmentView">
                <MudNavGroup Title="设备管理" ExpandedIcon="@Icons.Material.Filled.ExpandMore" CollapsedIcon="@Icons.Material.Filled.ChevronRight">
                    <MudNavLink Href="/equipment">设备台账</MudNavLink>
                    <MudNavLink Href="/repair-orders">维修工单</MudNavLink>
                    <MudNavLink Href="/maintenance-orders">保养工单</MudNavLink>
                    <MudNavLink Href="/inspection-records">点检记录</MudNavLink>
                </MudNavGroup>
            </AuthorizeView>

            <!-- 生产标准（二级各自选档位） -->
            <AuthorizeView Roles="@Roles.Policies.StandardView">
                <MudNavGroup Title="生产标准" ExpandedIcon="@Icons.Material.Filled.ExpandMore" CollapsedIcon="@Icons.Material.Filled.ChevronRight">
                    <MudNavLink Href="/standard-registers">标准号列表</MudNavLink>
                    <MudNavLink Href="/standard-inspection-requirements">标准号检验项要求</MudNavLink>
                    <MudNavLink Href="/sub-standard-quick-views">子标准速览</MudNavLink>
                    <MudNavLink Href="/grade-mappings">牌号对照</MudNavLink>
                    <MudNavLink Href="/grade-chemical-compositions">标准牌号化学成分</MudNavLink>
                    <MudNavLink Href="/grade-physical-properties">牌号物理性能</MudNavLink>
                    <MudNavLink Href="/factory-inspection-requirements">工厂检验项要求</MudNavLink>
                    <MudNavLink Href="/chemical-composition">工厂牌号化学成分</MudNavLink>
                    <MudNavLink Href="/chemical-validate">工厂牌号化分验证</MudNavLink>
                </MudNavGroup>
            </AuthorizeView>

            <!-- 报表系统 -->
            <AuthorizeView Roles="@Roles.Policies.ReportView">
                <MudNavGroup Title="报表系统" ExpandedIcon="@Icons.Material.Filled.ExpandMore" CollapsedIcon="@Icons.Material.Filled.ChevronRight">
                    <MudNavLink Href="/reports/overview">报表总览</MudNavLink>
                </MudNavGroup>
            </AuthorizeView>

            <!-- 数据工具 -->
            <AuthorizeView Roles="@Roles.Policies.DataToolView">
                <MudNavLink Href="/data-exchange">数据工具</MudNavLink>
            </AuthorizeView>

            <!-- 扫码管理 -->
            <MudNavGroup Title="扫码管理" ExpandedIcon="@Icons.Material.Filled.ExpandMore" CollapsedIcon="@Icons.Material.Filled.ChevronRight">
                <MudNavLink Href="/mobile-report">扫码报工</MudNavLink>
                <MudNavLink Href="/equipment-scan">设备扫码</MudNavLink>
                <AuthorizeView Roles="@Roles.Policies.ScanView">
                    <MudNavLink Href="/workstations">工位管理</MudNavLink>
                    <MudNavLink Href="/employees">员工管理</MudNavLink>
                </AuthorizeView>
            </MudNavGroup>

            <!-- 参数表（二级各自选档位） -->
            <AuthorizeView Roles="@Roles.Policies.ConfigurationView">
                <MudNavGroup Title="参数表" ExpandedIcon="@Icons.Material.Filled.ExpandMore" CollapsedIcon="@Icons.Material.Filled.ChevronRight">
                    <MudNavLink Href="/process-definitions">工序组定义(批次/工艺)</MudNavLink>
                    <MudNavLink Href="/standard-work-days">工段工量天数(排程/用料)</MudNavLink>
                    <MudNavLink Href="/standard-work-day-delivery-states">交货状态附加天数(排程/用料)</MudNavLink>
                    <MudNavLink Href="/daily-output-estimates">规格日产预估(工单执行)</MudNavLink>
                    <MudNavLink Href="/cold-roll-capacities">冷轧产能档案(冷轧排程)</MudNavLink>
                    <MudNavLink Href="/cold-roll-machine-configs">冷轧机台数配置(冷轧排程)</MudNavLink>
                    <MudNavLink Href="/cold-roll-machine-group-configs">冷轧机台组配置(冷轧排程)</MudNavLink>
                    <MudNavLink Href="/daily-production-capacities">重点工段日产(生产总览)</MudNavLink>
                    <MudNavLink Href="/section-paragraph-config-settings">段落日产配置(段落流转)</MudNavLink>
                    <MudNavLink Href="/enum-display-definitions">枚举显示配置(全局显示)</MudNavLink>
                    <MudNavLink Href="/dict-value-definitions">字典显示配置(全局显示)</MudNavLink>
                    <MudNavLink Href="/config-parameters">系统参数(全局参数)</MudNavLink>
                </MudNavGroup>
            </AuthorizeView>

            <!-- 用户管理 -->
            <AuthorizeView Roles="@Roles.Policies.UserView">
                <MudNavLink Href="/admin/users">用户管理</MudNavLink>
            </AuthorizeView>
        </MudNavMenu>
    </MudDrawer>

    <MudMainContent>
        @ChildContent
    </MudMainContent>
</MudLayout>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    private bool _drawerOpen = true;
    private void ToggleDrawer() => _drawerOpen = !_drawerOpen;

    protected override async Task OnInitializedAsync()
    {
        AuthProvider.AuthenticationStateChanged += OnAuthenticationStateChanged;
        var authState = await AuthProvider.GetAuthenticationStateAsync();

        // 未登录不预加载显示映射：避免未认证 API 调用触发 AuthHttpClient
        // 401 → 刷新失败 → NavigateTo("/login", true) 强制重载 → 无限循环
        if (authState.User.Identity?.IsAuthenticated != true)
            return;

        // 预加载工段显示映射（Key→中文），供全站 SectionDisplayHelper 显示使用
        var sectionNameMap = await StandardWorkDayService.GetSectionNameMapAsync();
        if (sectionNameMap != null)
            SectionDisplayHelper.OverrideMap = sectionNameMap;

        // 预加载工序组显示映射（Key→中文），供全站 ProcessDisplayHelper 显示使用
        var processNameMap = await ProcessDefinitionService.GetProcessNameMapAsync();
        if (processNameMap != null)
            ProcessDisplayHelper.OverrideMap = processNameMap;

        // 预加载枚举显示配置（EnumKey→Value→DisplayName），注入 EnumHelper 覆盖
        // （配置表优先，兜底 EnumHelper 静态字典），全站 DisplayHelper/DataExchange/打印自动生效
        var enumDisplayMap = await EnumDisplayDefinitionService.GetDisplayMapAsync();
        if (enumDisplayMap != null)
        {
            foreach (var kvp in enumDisplayMap)
                EnumHelper.ApplyEnumOverrides(kvp.Key, kvp.Value);
        }

        // 预加载枚举排序配置（EnumKey→有序选项），注入 EnumHelper.ApplyEnumOrder，
        // 列筛选/表单下拉按 DisplayOrder 排序
        var enumOptionsMap = await EnumDisplayDefinitionService.GetOptionsMapAsync();
        if (enumOptionsMap != null)
        {
            foreach (var kvp in enumOptionsMap)
            {
                var order = new Dictionary<string, int>(StringComparer.Ordinal);
                foreach (var opt in kvp.Value)
                    order[opt.Value] = opt.DisplayOrder;
                EnumHelper.ApplyEnumOrder(kvp.Key, order);
            }
        }

        // 预加载字典显示映射（DictKey→Value→DisplayName），供 DictValueDisplayHelper 显示使用
        var dictDisplayMap = await DictValueDefinitionService.GetDisplayMapAsync();
        if (dictDisplayMap != null)
            DictValueDisplayHelper.OverrideMap = dictDisplayMap;
    }

    private void OnAuthenticationStateChanged(Task<AuthenticationState> task)
    {
        _ = InvokeAsync(async () =>
        {
            await task;
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        AuthProvider.AuthenticationStateChanged -= OnAuthenticationStateChanged;
    }

    private void NavigateToLogin() => Navigation.NavigateTo("/login");

    private async Task Logout()
    {
        if (AuthProvider is CustomAuthStateProvider customAuth)
        {
            await customAuth.MarkUserAsLoggedOut();
        }
        else
        {
            try
            {
                await LocalStorage.RemoveItemAsync("authToken");
                await LocalStorage.RemoveItemAsync("refreshToken");
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Logout error: {ex.Message}");
            }

            await JSRuntime.InvokeVoidAsync("localStorage.removeItem", "authToken");
            await JSRuntime.InvokeVoidAsync("localStorage.removeItem", "refreshToken");
            Navigation.NavigateTo("/", true);
        }
    }

}
