@* 文件路径: MES.Blazor/Shared/MainLayout.razor *@
@using MES.Blazor.Services
@using MES.Blazor.Helpers
@using MES.Core.Helpers
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthProvider
@inject Blazored.LocalStorage.ILocalStorageService LocalStorage
@inject IJSRuntime JSRuntime
@inject StandardWorkDayService StandardWorkDayService
@inject ProcessDefinitionService ProcessDefinitionService
@inject EnumDisplayDefinitionService EnumDisplayDefinitionService
@inject DictValueDefinitionService DictValueDefinitionService
@implements IDisposable

<MudThemeProvider />
<MudDialogProvider />
<MudSnackbarProvider />
<MudLayout>
    <MudAppBar Elevation="1" Style="background-color: #1a1a2e; color: #fff;">
        <AuthorizeView>
            <Authorized>
                <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" OnClick="@ToggleDrawer" Class="mr-2" />
            </Authorized>
        </AuthorizeView>
        <MudText Typo="Typo.h6" Style="white-space: nowrap; color: #fff;">MES 制造执行系统</MudText>
        <MudSpacer />
        <AuthorizeView>
            <Authorized>
                <MudText Typo="Typo.body2" Class="mr-2" Style="color: #ccc;">@context.User.Identity?.Name</MudText>
                <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="Logout" Style="color: #fff;">退出</MudButton>
            </Authorized>
            <NotAuthorized>
                <MudButton Variant="Variant.Text" OnClick="NavigateToLogin" Style="color: #fff;">登录</MudButton>
            </NotAuthorized>
        </AuthorizeView>
    </MudAppBar>

    @* 菜单抽屉仅在登录后渲染：未登录（登录页/跳转中）完全无菜单，登录后正常展示 *@
    <AuthorizeView>
        <Authorized Context="mainMenu">
    <MudDrawer @bind-Open="_drawerOpen" Variant="DrawerVariant.Responsive" Elevation="1" Width="200px">
        <MudNavMenu>
            @* 菜单树单一数据源：与手机版共用 AppMenu.Root，见 Shared/AppMenu.cs *@
            @foreach (var menuNode in AppMenu.Root)
            {
                <DesktopMenuNode Node="menuNode" />
            }
        </MudNavMenu>
    </MudDrawer>
        </Authorized>
    </AuthorizeView>

    <MudMainContent>
        @ChildContent
    </MudMainContent>
</MudLayout>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    // 侧栏一律默认收起、由左上角汉堡点击展开/收起，永不自动展开。
    // 原因：手机浏览器（夸克等）的“电脑模式/极速模式”会把布局视口拉宽到 ~1280 并改写 UA，
    // 宽度/UA 判定必然被钻空子 → 任何“按宽度自动展开”都会在手机上冒出常驻深色竖栏。
    // 统一默认关闭后，无论视口/UA 如何伪装都不可能在首屏自现侧栏。
    private bool _drawerOpen;
    private void ToggleDrawer() => _drawerOpen = !_drawerOpen;

    protected override async Task OnInitializedAsync()
    {
        AuthProvider.AuthenticationStateChanged += OnAuthenticationStateChanged;

        var authState = await AuthProvider.GetAuthenticationStateAsync();

        // 未登录不预加载显示映射：避免未认证 API 调用触发 AuthHttpClient
        // 401 → 刷新失败 → NavigateTo("/login", true) 强制重载 → 无限循环
        if (authState.User.Identity?.IsAuthenticated != true)
            return;

        // 预加载工段显示映射（Key→中文），供全站 SectionDisplayHelper 显示使用
        var sectionNameMap = await StandardWorkDayService.GetSectionNameMapAsync();
        if (sectionNameMap != null)
            SectionDisplayHelper.OverrideMap = sectionNameMap;

        // 预加载工序组显示映射（Key→中文），供全站 ProcessDisplayHelper 显示使用
        var processNameMap = await ProcessDefinitionService.GetProcessNameMapAsync();
        if (processNameMap != null)
            ProcessDisplayHelper.OverrideMap = processNameMap;

        // 预加载枚举显示配置（EnumKey→Value→DisplayName），注入 EnumHelper 覆盖
        // （配置表优先，兜底 EnumHelper 静态字典），全站 DisplayHelper/DataExchange/打印自动生效
        var enumDisplayMap = await EnumDisplayDefinitionService.GetDisplayMapAsync();
        if (enumDisplayMap != null)
        {
            foreach (var kvp in enumDisplayMap)
                EnumHelper.ApplyEnumOverrides(kvp.Key, kvp.Value);
        }

        // 预加载枚举排序配置（EnumKey→有序选项），注入 EnumHelper.ApplyEnumOrder，
        // 列筛选/表单下拉按 DisplayOrder 排序
        var enumOptionsMap = await EnumDisplayDefinitionService.GetOptionsMapAsync();
        if (enumOptionsMap != null)
        {
            foreach (var kvp in enumOptionsMap)
            {
                var order = new Dictionary<string, int>(StringComparer.Ordinal);
                foreach (var opt in kvp.Value)
                    order[opt.Value] = opt.DisplayOrder;
                EnumHelper.ApplyEnumOrder(kvp.Key, order);
            }
        }

        // 预加载字典显示映射（DictKey→Value→DisplayName），供 DictValueDisplayHelper 显示使用
        // （注入晚于页面组件首次渲染；setter 赋值自动触发 OverrideMapChanged 事件，页面订阅后重建选项并重渲染）
        var dictDisplayMap = await DictValueDefinitionService.GetDisplayMapAsync();
        if (dictDisplayMap != null)
            DictValueDisplayHelper.OverrideMap = dictDisplayMap;
    }

    private void OnAuthenticationStateChanged(Task<AuthenticationState> task)
    {
        _ = InvokeAsync(async () =>
        {
            await task;
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        AuthProvider.AuthenticationStateChanged -= OnAuthenticationStateChanged;
    }

    private void NavigateToLogin() => Navigation.NavigateTo("/login");

    private async Task Logout()
    {
        if (AuthProvider is CustomAuthStateProvider customAuth)
        {
            await customAuth.MarkUserAsLoggedOut();
        }
        else
        {
            try
            {
                await LocalStorage.RemoveItemAsync("authToken");
                await LocalStorage.RemoveItemAsync("refreshToken");
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Logout error: {ex.Message}");
            }

            await JSRuntime.InvokeVoidAsync("localStorage.removeItem", "authToken");
            await JSRuntime.InvokeVoidAsync("localStorage.removeItem", "refreshToken");
            Navigation.NavigateTo("/", true);
        }
    }

}
