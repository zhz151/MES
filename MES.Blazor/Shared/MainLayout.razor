@* 文件路径: MES.Blazor/Shared/MainLayout.razor *@
@inherits LayoutComponentBase
@using MES.Blazor.Services
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthProvider
@inject Blazored.LocalStorage.ILocalStorageService LocalStorage
@inject IJSRuntime JSRuntime
@implements IDisposable

<MudThemeProvider />
<MudDialogProvider />
<MudSnackbarProvider />
<MudLayout>
    <MudAppBar Elevation="1" Style="background-color: #1a1a2e; color: #fff;">
        <div style="display: flex; align-items: center; width: 100%;">
            <MudText Typo="Typo.h6" Class="mr-4" Style="white-space: nowrap; color: #fff;">MES 制造执行系统</MudText>

            <!-- 水平导航菜单 -->
            <div class="top-nav" style="display: flex; align-items: center; gap: 2px; flex: 1; overflow: visible;">
                <MudButton Variant="Variant.Text" Size="Size.Small" Class="@GetNavClass("")" OnClick='() => NavigateTo("/")'>仪表板</MudButton>

                <!-- 订单模块 -->
                <AuthorizeView Roles="OrderStaff,OrderDirector,Admin">
                    <MudMenu Label="订单管理" Dense="true" FullWidth="false" AnchorOrigin="Origin.BottomCenter" TransformOrigin="Origin.TopCenter" Class="@GetMenuClass("orders","customers","standards","grade-mappings")">
                        <MudMenuItem Class="@GetMenuItemClass("/orders")" OnClick='() => NavigateTo("/orders")'>订单列表</MudMenuItem>
                        <MudMenuItem Class="@GetMenuItemClass("/customers")" OnClick='() => NavigateTo("/customers")'>客户管理</MudMenuItem>
                        <MudMenuItem Class="@GetMenuItemClass("/standards")" OnClick='() => NavigateTo("/standards")'>产品标准</MudMenuItem>
                        <MudMenuItem Class="@GetMenuItemClass("/grade-mappings")" OnClick='() => NavigateTo("/grade-mappings")'>牌号对照</MudMenuItem>
                    </MudMenu>
                </AuthorizeView>

                <!-- 工单模块 -->
                <AuthorizeView Roles="WorkOrderStaff,WorkOrderDirector,Admin">
                    <MudMenu Label="工单管理" Dense="true" FullWidth="false" AnchorOrigin="Origin.BottomCenter" TransformOrigin="Origin.TopCenter" Class="@GetMenuClass("workorders","material-plan-overview","standard-process-cycles")">
                        <MudMenuItem Class="@GetMenuItemClass("/workorders")" OnClick='() => NavigateTo("/workorders")'>工单首页</MudMenuItem>
                        <MudMenuItem Class="@GetMenuItemClass("/material-plan-overview")" OnClick='() => NavigateTo("/material-plan-overview")'>用料计划总览</MudMenuItem>
                        <MudMenuItem Class="@GetMenuItemClass("/standard-process-cycles")" OnClick='() => NavigateTo("/standard-process-cycles")'>标准工艺生产周期</MudMenuItem>
                    </MudMenu>
                </AuthorizeView>

                <!-- 批次模块 -->
                <AuthorizeView Roles="BatchStaff,BatchDirector,Admin">
                    <MudMenu Label="批次管理" Dense="true" FullWidth="false" AnchorOrigin="Origin.BottomCenter" TransformOrigin="Origin.TopCenter" Class="@GetMenuClass("batches","production-records","section-outsources")">
                        <MudMenuItem Class="@GetMenuItemClass("/batches")" OnClick='() => NavigateTo("/batches")'>批次首页</MudMenuItem>
                        <MudMenuItem Class="@GetMenuItemClass("/production-records")" OnClick='() => NavigateTo("/production-records")'>生产记录</MudMenuItem>
                        <MudMenuItem Class="@GetMenuItemClass("/section-outsources")" OnClick='() => NavigateTo("/section-outsources")'>工段委外</MudMenuItem>
                    </MudMenu>
                    <MudButton Variant="Variant.Text" Size="Size.Small" Class="@GetNavClass("process-card-print")" OnClick='() => NavigateTo("/process-card-print")'>工艺卡打印</MudButton>
                    <MudButton Variant="Variant.Text" Size="Size.Small" Class="@GetNavClass("mobile-report")" OnClick='() => NavigateTo("/mobile-report")'>扫码报工</MudButton>
                </AuthorizeView>

                <!-- 质量模块 -->
                <AuthorizeView Roles="QualityStaff,QualityDirector,Admin">
                    <MudMenu Label="质量管理" Dense="true" FullWidth="false" AnchorOrigin="Origin.BottomCenter" TransformOrigin="Origin.TopCenter" Class="@GetMenuClass("quality/furnace","quality/process-inspection","material-checks","quality/chemical-composition","quality/chemical-validate","quality/final-inspection","quality/lab-testing","quality/certificate","quality-process-tracking")">
                        <MudMenuItem Class="@GetMenuItemClass("/quality/furnace")">
                            <span @onmouseenter="ShowFurnaceSub" @onmouseleave="StartFurnaceHideTimer"
                                  style="display: flex; width: 100%; justify-content: space-between; align-items: center;">
                                <span>炉号登记</span>
                                <span style="font-size: 10px; opacity: 0.6;">▶</span>
                            </span>
                        </MudMenuItem>
                        <MudMenuItem Class="@GetMenuItemClass("/quality/furnace")"
                                     Style="@(_showFurnaceSubmenu ? "padding-left: 28px;" : "display: none;")"
                                     @onmouseenter="CancelFurnaceHideTimer" @onmouseleave="StartFurnaceHideTimer"
                                     OnClick='() => NavigateTo("/quality/furnace")'>炉号登记</MudMenuItem>
                        <MudMenuItem Class="@GetMenuItemClass("/quality/chemical-composition")"
                                     Style="@(_showFurnaceSubmenu ? "padding-left: 28px;" : "display: none;")"
                                     @onmouseenter="CancelFurnaceHideTimer" @onmouseleave="StartFurnaceHideTimer"
                                     OnClick='() => NavigateTo("/quality/chemical-composition")'>牌号化学</MudMenuItem>
                        <MudMenuItem Class="@GetMenuItemClass("/quality/chemical-validate")"
                                     Style="@(_showFurnaceSubmenu ? "padding-left: 28px;" : "display: none;")"
                                     @onmouseenter="CancelFurnaceHideTimer" @onmouseleave="StartFurnaceHideTimer"
                                     OnClick='() => NavigateTo("/quality/chemical-validate")'>牌号验证</MudMenuItem>
                        <MudMenuItem Class="@GetMenuItemClass("/quality/process-inspection")" OnClick='() => NavigateTo("/quality/process-inspection")'>过程检验</MudMenuItem>
                        <MudMenuItem Class="@GetMenuItemClass("/material-checks")" OnClick='() => NavigateTo("/material-checks")'>检验到料</MudMenuItem>
                        <MudMenuItem Class="@GetMenuItemClass("/quality/final-inspection")" OnClick='() => NavigateTo("/quality/final-inspection")'>成品检验</MudMenuItem>
                        <MudMenuItem Class="@GetMenuItemClass("/quality-process-tracking")" OnClick='() => NavigateTo("/quality-process-tracking")'>成检到料及执行</MudMenuItem>
                        <MudMenuItem Class="@GetMenuItemClass("/quality/lab-testing")" OnClick='() => NavigateTo("/quality/lab-testing")'>理化检测</MudMenuItem>
                        <MudMenuItem Class="@GetMenuItemClass("/quality/certificate")" OnClick='() => NavigateTo("/quality/certificate")'>质量证明书</MudMenuItem>
                    </MudMenu>
                </AuthorizeView>

                <!-- 设备模块 -->
                <AuthorizeView Roles="EquipmentStaff,EquipmentDirector,Admin">
                    <MudMenu Label="设备管理" Dense="true" FullWidth="false" AnchorOrigin="Origin.BottomCenter" TransformOrigin="Origin.TopCenter" Class="@GetMenuClass("equipment","repair-orders","maintenance-orders","inspection-records")">
                        <MudMenuItem Class="@GetMenuItemClass("/equipment")" OnClick='() => NavigateTo("/equipment")'>设备台账</MudMenuItem>
                        <MudMenuItem Class="@GetMenuItemClass("/repair-orders")" OnClick='() => NavigateTo("/repair-orders")'>维修工单</MudMenuItem>
                        <MudMenuItem Class="@GetMenuItemClass("/maintenance-orders")" OnClick='() => NavigateTo("/maintenance-orders")'>保养工单</MudMenuItem>
                        <MudMenuItem Class="@GetMenuItemClass("/inspection-records")" OnClick='() => NavigateTo("/inspection-records")'>点检记录</MudMenuItem>
                    </MudMenu>
                </AuthorizeView>

                <!-- 物料模块 -->
                <AuthorizeView Roles="MaterialStaff,MaterialDirector,Admin">
                    <MudMenu Label="物料管理" Dense="true" FullWidth="false" AnchorOrigin="Origin.BottomCenter" TransformOrigin="Origin.TopCenter" Class="@GetMenuClass("purchase-orders","subcontract-orders","suppliers","materials")">
                        <MudMenuItem Class="@GetMenuItemClass("/purchase-orders")" OnClick='() => NavigateTo("/purchase-orders")'>采购订单</MudMenuItem>
                        <MudMenuItem Class="@GetMenuItemClass("/subcontract-orders")" OnClick='() => NavigateTo("/subcontract-orders")'>圆棒穿孔</MudMenuItem>
                        <MudMenuItem Class="@GetMenuItemClass("/suppliers")" OnClick='() => NavigateTo("/suppliers")'>供应商管理</MudMenuItem>
                        <MudMenuItem Class="@GetMenuItemClass("/materials")" OnClick='() => NavigateTo("/materials")'>物料档案</MudMenuItem>
                    </MudMenu>
                </AuthorizeView>

                <!-- 仓库模块 -->
                <AuthorizeView Roles="WarehouseStaff,WarehouseDirector,Admin">
                    <MudMenu Label="仓库管理" Dense="true" FullWidth="false" AnchorOrigin="Origin.BottomCenter" TransformOrigin="Origin.TopCenter" Class="@GetMenuClass("warehouse/raw","warehouse/fg","warehouse/defect","warehouse/wip")">
                        <MudMenuItem Class="@GetMenuItemClass("/warehouse/raw")" OnClick='() => NavigateTo("/warehouse/raw")'>原料库</MudMenuItem>
                        <MudMenuItem Class="@GetMenuItemClass("/warehouse/fg")" OnClick='() => NavigateTo("/warehouse/fg")'>成品库</MudMenuItem>
                        <MudMenuItem Class="@GetMenuItemClass("/warehouse/defect")" OnClick='() => NavigateTo("/warehouse/defect")'>次品库</MudMenuItem>
                        <MudMenuItem Class="@GetMenuItemClass("/warehouse/wip")" OnClick='() => NavigateTo("/warehouse/wip")'>在制品库</MudMenuItem>
                    </MudMenu>
                </AuthorizeView>

                <!-- 现况查询 -->
                <AuthorizeView>
                    <MudMenu Label="现况查询" Dense="true" FullWidth="false" AnchorOrigin="Origin.BottomCenter" TransformOrigin="Origin.TopCenter" Class="@GetMenuClass("workorder-execution","sales-urgings","raw-material-lock-plan")">
                        <MudMenuItem Class="@GetMenuItemClass("/workorder-execution")" OnClick='() => NavigateTo("/workorder-execution")'>工单执行状况</MudMenuItem>
                        <MudMenuItem Class="@GetMenuItemClass("/sales-urgings")" OnClick='() => NavigateTo("/sales-urgings")'>销售催单</MudMenuItem>
                        <MudMenuItem Class="@GetMenuItemClass("/raw-material-lock-plan")" OnClick='() => NavigateTo("/raw-material-lock-plan")'>原锁计划及执行</MudMenuItem>
                    </MudMenu>
                </AuthorizeView>

                <!-- 数据工具 -->
                <MudButton Variant="Variant.Text" Size="Size.Small" Class="@GetNavClass("data-exchange")" OnClick='() => NavigateTo("/data-exchange")'>数据工具</MudButton>

                <!-- 用户管理 -->
                <AuthorizeView Roles="Admin">
                    <MudButton Variant="Variant.Text" Size="Size.Small" Class="@GetNavClass("admin/users")" OnClick='() => NavigateTo("/admin/users")'>用户管理</MudButton>
                </AuthorizeView>
            </div>

            <MudSpacer />

            <AuthorizeView>
                <Authorized>
                    <MudText Typo="Typo.body2" Class="mr-2" Style="color: #ccc;">@context.User.Identity?.Name</MudText>
                    <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="Logout" Style="color: #fff;">退出</MudButton>
                </Authorized>
                <NotAuthorized>
                    <MudButton Variant="Variant.Text" OnClick="NavigateToLogin" Style="color: #fff;">登录</MudButton>
                </NotAuthorized>
            </AuthorizeView>
        </div>
    </MudAppBar>

    <MudMainContent Style="min-height: calc(100vh - 64px); padding: 0; margin-top: 64px;">
        @Body
    </MudMainContent>
</MudLayout>

@code {
    private AuthenticationState? _authenticationState;
    private bool _showFurnaceSubmenu;
    private CancellationTokenSource? _hideSubmenuCts;

    private void ShowFurnaceSub()
    {
        _hideSubmenuCts?.Cancel();
        _showFurnaceSubmenu = true;
    }

    private void CancelFurnaceHideTimer()
    {
        _hideSubmenuCts?.Cancel();
    }

    private async void StartFurnaceHideTimer()
    {
        _hideSubmenuCts?.Cancel();
        _hideSubmenuCts = new CancellationTokenSource();
        var token = _hideSubmenuCts.Token;
        try
        {
            await Task.Delay(200, token);
            _showFurnaceSubmenu = false;
            StateHasChanged();
        }
        catch (TaskCanceledException) { }
    }

    protected override async Task OnInitializedAsync()
    {
        AuthProvider.AuthenticationStateChanged += OnAuthenticationStateChanged;
        _authenticationState = await AuthProvider.GetAuthenticationStateAsync();
    }

    private void OnAuthenticationStateChanged(Task<AuthenticationState> task)
    {
        _ = InvokeAsync(async () =>
        {
            _authenticationState = await task;
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        AuthProvider.AuthenticationStateChanged -= OnAuthenticationStateChanged;
    }

    private string GetCurrentPath()
    {
        return new Uri(Navigation.Uri).AbsolutePath.TrimEnd('/');
    }

    private string GetNavClass(string path)
    {
        var current = GetCurrentPath();
        var target = "/" + path.TrimStart('/');
        var active = string.Equals(current, target.TrimEnd('/'), StringComparison.OrdinalIgnoreCase) ? "nav-active" : "";
        return "nav-btn " + active;
    }

    private string GetMenuClass(params string[] paths)
    {
        var current = GetCurrentPath();
        var active = paths.Any(p => current.StartsWith("/" + p.TrimStart('/'), StringComparison.OrdinalIgnoreCase)) ? "nav-active" : "";
        return "nav-btn " + active;
    }

    private string GetMenuItemClass(string path)
    {
        var current = GetCurrentPath();
        return string.Equals(current, path.TrimEnd('/'), StringComparison.OrdinalIgnoreCase) ? "menu-item-active" : "";
    }

    private void NavigateTo(string url) => Navigation.NavigateTo(url);

    private void NavigateToLogin() => Navigation.NavigateTo("/login");

    private async Task Logout()
    {
        if (AuthProvider is CustomAuthStateProvider customAuth)
        {
            await customAuth.MarkUserAsLoggedOut();
        }
        else
        {
            try
            {
                await LocalStorage.RemoveItemAsync("authToken");
                await LocalStorage.RemoveItemAsync("refreshToken");
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Logout error: {ex.Message}");
            }

            await JSRuntime.InvokeVoidAsync("localStorage.removeItem", "authToken");
            await JSRuntime.InvokeVoidAsync("localStorage.removeItem", "refreshToken");
            Navigation.NavigateTo("/", true);
        }
    }
}
