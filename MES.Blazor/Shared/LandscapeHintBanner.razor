@* 手机端「横屏提示条」：竖屏进入宽表页时轻提示横屏查看，可关闭并本地持久记忆。
   只在 MobileLayout 内渲染 —— 真手机横屏 innerWidth≥700 时 ResponsiveLayout 已整壳切 MainLayout，
   本组件随壳销毁自动消失；<700 的窄横屏残留 MobileLayout 时靠自身 orientation/resize 监听收起。
   判定规则见 LandscapeHintRule.cs，防漂移单测见 MES.Tests/Components/LandscapeHintRuleTests.cs。 *@
@inject NavigationManager Navigation
@inject Blazored.LocalStorage.ILocalStorageService LocalStorage
@inject IJSRuntime JSRuntime
@implements IAsyncDisposable

@if (ShouldShow)
{
    <div class="rotate-hint-banner notice-card d-flex align-center" role="status">
        <MudIcon Icon="@(_locked ? Icons.Material.Filled.ScreenLockPortrait : Icons.Material.Filled.ScreenRotation)" Size="Size.Small" Class="flex-shrink-0" />
        <span class="flex-grow-1">@MessageText</span>
        <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" Title="知道了" aria-label="知道了" OnClick="DismissAsync" />
    </div>
}

@code {
    private DotNetObjectReference<LandscapeHintBanner>? _dotNetRef;
    private bool _dismissed;  // 用户点过「知道了」，本地持久
    private bool _locked;     // 锁竖屏浏览器（夸克/微信）：特制文案，引导去系统开自动旋转
    private bool _touch;      // 触屏设备才提示，防桌面窄窗误提示
    private bool _portrait;   // 当前竖屏（随 orientation/resize 刷新）
    private string _currentPath = "/";

    private bool ShouldShow =>
        !_dismissed && _touch && _portrait
        && LandscapeHintRule.IsWideRoute(_currentPath);

    private string MessageText =>
        _locked
            ? "浏览器已锁定竖屏，请在系统设置中开启「自动旋转」后再横屏查看"
            : "需横屏查看（旋转手机自动切换）";

    protected override async Task OnInitializedAsync()
    {
        // 1. 读取持久关闭标记（Blazored 缺键可能抛 → 兜底 false）
        try
        {
            _dismissed = await LocalStorage.ContainKeyAsync(LandscapeHintRule.DismissedStorageKey)
                && await LocalStorage.GetItemAsync<bool>(LandscapeHintRule.DismissedStorageKey);
        }
        catch
        {
            _dismissed = false;
        }

        // 2. 一次性设备特征（UA/触屏/当前横竖屏）
        _locked = await JSRuntime.InvokeAsync<bool>("eval", "/(?:Quark|MicroMessenger)/i.test(navigator.userAgent)");
        _touch = await JSRuntime.InvokeAsync<bool>("eval",
            "(window.matchMedia && window.matchMedia('(pointer: coarse)').matches) || (navigator.maxTouchPoints || 0) > 0");
        _portrait = await RefreshPortraitAsync();

        // 3. 注册横竖屏监听（index.html 多监听器总线，不抢 ResponsiveLayout 的 _resizeRef 单槽）
        _dotNetRef = DotNetObjectReference.Create(this);
        await JSRuntime.InvokeVoidAsync("listenLandscapeHintRefresh", _dotNetRef, nameof(OnLandscapeHintChanged));

        // 4. 路径变化 → 重判当前页是否宽页（跨页时提示条随页面进出）
        _currentPath = LandscapeHintRule.NormalizePath(Navigation.ToBaseRelativePath(Navigation.Uri));
        Navigation.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        _currentPath = LandscapeHintRule.NormalizePath(Navigation.ToBaseRelativePath(e.Location));
        StateHasChanged();
    }

    /// <summary>JS 监听 orientationchange/resize 回调入口：重算竖屏态。</summary>
    [JSInvokable]
    public async Task OnLandscapeHintChanged()
    {
        _portrait = await RefreshPortraitAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task<bool> RefreshPortraitAsync()
        => await JSRuntime.InvokeAsync<bool>("eval",
            "!window.matchMedia || window.matchMedia('(orientation: portrait)').matches");

    private async Task DismissAsync()
    {
        _dismissed = true;
        await LocalStorage.SetItemAsync(LandscapeHintRule.DismissedStorageKey, true);
        StateHasChanged();
    }

    public async ValueTask DisposeAsync()
    {
        Navigation.LocationChanged -= OnLocationChanged;
        if (_dotNetRef is not null)
        {
            try
            {
                await JSRuntime.InvokeVoidAsync("stopLandscapeHintRefresh", _dotNetRef);
            }
            catch
            {
                // 页面卸载期 JS 运行时可能已不可用，忽略
            }
            _dotNetRef.Dispose();
        }
    }
}
