@* 响应式布局路由器 — 根据屏幕宽度切换 MobileLayout / MainLayout *@
@inherits LayoutComponentBase
@implements IDisposable

@if (_isMobile)
{
    <MobileLayout>
        <CascadingAuthenticationState>
            @Body
        </CascadingAuthenticationState>
    </MobileLayout>
}
else
{
    <MainLayout>
        <CascadingAuthenticationState>
            @Body
        </CascadingAuthenticationState>
    </MainLayout>
}

@code {
    private bool _isMobile;

    [Inject] private IJSRuntime JSRuntime { get; set; } = null!;

    protected override async Task OnInitializedAsync()
    {
        _isMobile = await DetectMobile();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var dotNetRef = DotNetObjectReference.Create(this);
            await JSRuntime.InvokeVoidAsync("listenResize", dotNetRef, nameof(OnResize));
        }
    }

    private async Task<bool> DetectMobile()
    {
        // 布局判定放 wasm（内容指纹 URL，不会被中间缓存滞留旧版），不依赖 index.html 里的 JS 全局函数。
        // 实时读取窗口宽度 / UA / 触屏信息：
        //   - 宽 <960                                 → 移动布局
        //   - UA 含移动端/Quark/微信                     → 移动布局
        //   - pointer:coarse 触屏主输入                  → 移动布局
        //   - maxTouchPoints>0 且宽 <1600               → 移动布局（覆盖手机“桌面版网站”的 980/1280/1440 视口）
        //   - max-device-width<=767（设备物理屏宽）         → 移动布局
        //     ⚠️ 夸克“电脑模式”会剥掉 UA 的 Quark 字样、把布局视口拉宽到 ~1280、把主指针模拟成鼠标
        //     （coarse=false、touch=0），上述 UA/宽度/触屏判定全部失效。device-width 反映设备物理
        //     屏幕宽，任何 UA/视口伪装都改不了真手机的 ~390px，是钉死手机布局的最可靠信号。
        //   - 不再有「横屏例外」（2026-09-14 用户拍板删除）：曾于 2026-09-05 加过一条例外——
        //     手机/触屏平板横屏且 innerWidth≥700 时改走桌面布局（MainLayout 电脑版表格观感）。
        //     当时的理由是「宽表竖屏物理上不可读」：MudTable 默认 Breakpoint=Xs 会把手机竖屏的
        //     每条记录拆成「列名—值」竖排 N 行，只能靠横屏凑出接近桌面的宽度。
        //     ⚠️ 该理由已被同日 V135–V139 四批改动推翻（`.mh-shell` 全站手机壳 / 各列表页
        //        `Breakpoint="Breakpoint.None"` 恢复真横滚宽表 / 粘性表头 / 不冻结任何列），
        //        且例外本身有代价：a) 横屏反而丢掉全部 `.mh-shell` 收敛规则（页头不换行、
        //        MudGrid 不堆叠、宽表无粘性表头与限高滚动区）；b) 扫码流等「窄页」也被误切成
        //        桌面版，与「扫码流竖屏本就流畅」的判定矛盾；c) 旋转屏幕时因换壳而重建整棵
        //        页面子树，已查询的列表 / 填了一半的表单状态全部丢失。
        //     → 故手机/触屏设备**不再按横竖屏区分**，一律走 MobileLayout（手机壳）；横屏下
        //       纵向空间不足的问题改由 app.css 手机壳段的「横屏筛选网格每行 2 列」规则缓解。
        //     ⚠️ 已知代价（用户知情拍板接受）：判据中含 UA / `pointer:coarse` / `maxTouchPoints`，
        //        故**触屏笔记本与大平板横屏也会走移动布局**（大屏上被"手机化"）。纯鼠标桌面机
        //        不受影响（宽≥960 且无任何触屏特征 → 仍走 MainLayout）。
        const string expr =
            "(window.innerWidth<960)||" +
            "(window.matchMedia&&window.matchMedia('(max-device-width: 767px)').matches)||" +
            "/Android|iPhone|iPad|iPod|Mobile|Mobi|Windows Phone|Quark|MicroMessenger/i.test(navigator.userAgent)||" +
            "(window.matchMedia&&window.matchMedia('(pointer: coarse)').matches)||" +
            "((navigator.maxTouchPoints||0)>0&&window.innerWidth<1600)";
        try
        {
            return await JSRuntime.InvokeAsync<bool>("eval", expr);
        }
        catch
        {
            // JS 异常时保守走移动布局（MobileLayout 无常驻侧栏），避免窄屏回落桌面布局出现半屏菜单
            return true;
        }
    }

    [JSInvokable]
    public async Task OnResize(bool isMobile)
    {
        // 忽略 JS 传入的旧判定值，resize 时实时重算，避免旧版 index.html 函数把结果切回桌面布局
        var fresh = await DetectMobile();
        if (_isMobile != fresh)
        {
            _isMobile = fresh;
            await InvokeAsync(StateHasChanged);
        }
    }

    public void Dispose()
    {
        try { JSRuntime.InvokeVoidAsync("stopListening"); } catch { }
    }
}
