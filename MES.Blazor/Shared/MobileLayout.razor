@* 移动端布局 — 抽屉导航 + 紧凑 AppBar *@
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthProvider
@inject Blazored.LocalStorage.ILocalStorageService LocalStorage
@implements IDisposable

<MudThemeProvider />
<MudDialogProvider />
<MudSnackbarProvider />
<MudLayout>
    <MudAppBar Elevation="1" Style="background-color: #1a1a2e; color: #fff;">
        <AuthorizeView>
            <Authorized>
                <MudIconButton Icon="@Icons.Material.Filled.ViewList" Color="Color.Inherit" OnClick="@(() => _drawerOpen = !_drawerOpen)" />
            </Authorized>
        </AuthorizeView>
        <MudText Typo="Typo.subtitle1" Style="flex: 1; margin-left: 8px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; color: #fff;">
            MES
        </MudText>
        <AuthorizeView>
            <Authorized>
                <MudIconButton Icon="@Icons.Material.Filled.Logout" Color="Color.Inherit" Size="Size.Small" OnClick="Logout" />
            </Authorized>
            <NotAuthorized>
                <MudIconButton Icon="@Icons.Material.Filled.Login" Color="Color.Inherit" Size="Size.Small" OnClick="GoLogin" />
            </NotAuthorized>
        </AuthorizeView>
    </MudAppBar>

    @* 移动端菜单 = 纯 CSS 自绘遮罩 + 侧滑面板（不用 MudDrawer）：
       闭合时 @if 不渲染 → DOM 无此元素 → 物理上不可能残留空深色窄条；
       打开时点击汉堡 → @if 直接渲染遮罩+面板 → 100% 弹层，无 MudBlazor 挂载时序问题。 *@
    <AuthorizeView>
        <Authorized Context="mobileMenu">
    @if (_drawerOpen)
    {
        <div @onclick="CloseDrawer" style="position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.45); z-index: 1300;"></div>
        <div style="position: fixed; top: 0; left: 0; bottom: 0; width: 280px; max-width: 85vw; background: #1a1a2e; color: #ccc; overflow-y: auto; z-index: 1301;">
            <MudText Typo="Typo.h6" Style="padding: 16px 16px 12px; color: #fff; border-bottom: 1px solid #333;">
                MES 制造系统
            </MudText>

            <MudDivider Style="background: #333; margin: 4px 0;" />

            <MudExpansionPanels>
                @* 菜单树单一数据源：与桌面版共用 AppMenu.Root，见 Shared/AppMenu.cs *@
                @foreach (var menuNode in AppMenu.Root)
                {
                    <MobileMenuNode Node="menuNode" OnNavigate="CloseDrawer" />
                }
            </MudExpansionPanels>

            <div style="border-top: 1px solid #333; padding: 16px; margin-top: 8px;">
                <AuthorizeView>
                    <Authorized>
                        <MudText Typo="Typo.body2" Style="color: #999;">
                            @context.User.Identity?.Name
                        </MudText>
                        <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="Logout" Style="color: #f44336; padding: 0; margin-top: 8px;">
                            退出登录
                        </MudButton>
                    </Authorized>
                </AuthorizeView>
            </div>
        </div>
    }
        </Authorized>
    </AuthorizeView>

    <MudMainContent Style="padding-top: 64px; min-height: 100vh;">
        @* 手机端一律走本壳（含横屏）：2026-09-14 用户拍板删除 ResponsiveLayout 的
           「横屏 ≥700 切桌面版」例外 + 「请横屏」提示条机制 —— 提示条组件 LandscapeHintBanner
           与判定规则 LandscapeHintRule 已连同其单测一并删除，不再保留。
           竖屏可用性由 `.mh-shell`（见下）与「横屏筛选网格每行 2 列」规则保证。 *@

        @* 全站手机壳钩子 `.mh-shell`：除首页（自带 mh-* 体系）以外，其余页面在手机竖屏下的
           统一收敛样式全部挂在这个类上（见 wwwroot/css/app.css「全站手机壳」段）——
           全仓 160+ 页面本体零改动，避免大范围编辑。
           ⚠️ 用真实渲染出的 div 做钩子，不依赖「祖先容器 + 后代选择器」的推断链：
              2026-09-14 真机样式失效的根因正是钩子挂 `.mh-container` 在真机未命中。 *@
        <div class="mh-shell">
            @* 向页面下传 IsMobile=true：页面可在移动壳内分支渲染（如首页手机看板）。
               桌面 MainLayout 不提供该级联 → 页面默认 IsMobile=false 走桌面布局。 *@
            <CascadingValue Value="true" Name="IsMobile">
                @ChildContent
            </CascadingValue>
        </div>
    </MudMainContent>
</MudLayout>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    private bool _drawerOpen;

    private void CloseDrawer()
    {
        _drawerOpen = false;
    }

    protected override async Task OnInitializedAsync()
    {
        AuthProvider.AuthenticationStateChanged += OnAuthenticationStateChanged;
        await AuthProvider.GetAuthenticationStateAsync();
    }

    private void OnAuthenticationStateChanged(Task<AuthenticationState> task)
    {
        _ = InvokeAsync(async () =>
        {
            await task;
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        AuthProvider.AuthenticationStateChanged -= OnAuthenticationStateChanged;
    }

    private void GoLogin() => Navigation.NavigateTo("/login");

    private async Task Logout()
    {
        try
        {
            await LocalStorage.RemoveItemAsync("authToken");
            await LocalStorage.RemoveItemAsync("refreshToken");
            await LocalStorage.RemoveItemAsync("userEmail");
            await LocalStorage.RemoveItemAsync("userName");
            await LocalStorage.RemoveItemAsync("userRoles");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Logout error: {ex.Message}");
        }
        Navigation.NavigateTo("/login", forceLoad: true);
    }
}
