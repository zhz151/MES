@* 移动端布局 — 抽屉导航 + 紧凑 AppBar *@
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthProvider
@inject Blazored.LocalStorage.ILocalStorageService LocalStorage
@inject IJSRuntime JSRuntime
@implements IDisposable

<MudThemeProvider />
<MudDialogProvider />
<MudSnackbarProvider />
<MudLayout>
    <MudAppBar Elevation="1" Style="background-color: #1a1a2e; color: #fff;">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" OnClick="@(() => _drawerOpen = !_drawerOpen)" />
        <MudText Typo="Typo.subtitle1" Style="flex: 1; margin-left: 8px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; color: #fff;">
            MES
        </MudText>
        <AuthorizeView>
            <Authorized>
                <MudIconButton Icon="@Icons.Material.Filled.Logout" Color="Color.Inherit" Size="Size.Small" OnClick="Logout" />
            </Authorized>
        </AuthorizeView>
    </MudAppBar>

    <MudDrawer @bind-Open="_drawerOpen" Variant="DrawerVariant.Temporary"
               Style="background-color: #1a1a2e; color: #ccc; width: 280px;"
               ClipMode="DrawerClipMode.Always">
        <div style="overflow-y: auto; max-height: 100vh;">
            <MudText Typo="Typo.h6" Style="padding: 16px 16px 12px; color: #fff; border-bottom: 1px solid #333;">
                MES 制造执行系统
            </MudText>

            <MudDivider Style="background: #333; margin: 4px 0;" />

            <MudExpansionPanels>
                <MudExpansionPanel Style="background: transparent; color: #ccc;">
                    <TitleContent><div style="padding: 10px 16px; color: #ccc;">订单管理</div></TitleContent>
                    <ChildContent>
                        <div style="padding-left: 16px;">
                            <MudNavLink Href="/orders" Style="color: #999; padding: 8px 16px;" OnClick="CloseDrawer">订单列表</MudNavLink>
                            <MudNavLink Href="/order-demand-adjustment" Style="color: #999; padding: 8px 16px;" OnClick="CloseDrawer">订单需求调整</MudNavLink>
                            <MudNavLink Href="/customers" Style="color: #999; padding: 8px 16px;" OnClick="CloseDrawer">客户管理</MudNavLink>
                            <MudNavLink Href="/standards" Style="color: #999; padding: 8px 16px;" OnClick="CloseDrawer">产品标准</MudNavLink>
                            <MudNavLink Href="/grade-mappings" Style="color: #999; padding: 8px 16px;" OnClick="CloseDrawer">牌号对照</MudNavLink>
                        </div>
                    </ChildContent>
                </MudExpansionPanel>

                <MudExpansionPanel Style="background: transparent; color: #ccc;">
                    <TitleContent><div style="padding: 10px 16px; color: #ccc;">工单管理</div></TitleContent>
                    <ChildContent>
                        <div style="padding-left: 16px;">
                            <MudNavLink Href="/workorders" Style="color: #999; padding: 8px 16px;" OnClick="CloseDrawer">工单首页</MudNavLink>
                            <MudNavLink Href="/material-plan-overview" Style="color: #999; padding: 8px 16px;" OnClick="CloseDrawer">用料计划总览</MudNavLink>
                            <MudNavLink Href="/standard-process-cycles" Style="color: #999; padding: 8px 16px;" OnClick="CloseDrawer">标准工艺生产周期</MudNavLink>
                            <MudNavLink Href="/workorder-execution" Style="color: #999; padding: 8px 16px;" OnClick="CloseDrawer">工单执行状况</MudNavLink>
                        </div>
                    </ChildContent>
                </MudExpansionPanel>

                <MudExpansionPanel Style="background: transparent; color: #ccc;">
                    <TitleContent><div style="padding: 10px 16px; color: #ccc;">批次管理</div></TitleContent>
                    <ChildContent>
                        <div style="padding-left: 16px;">
                            <MudNavLink Href="/batches" Style="color: #999; padding: 8px 16px;" OnClick="CloseDrawer">批次首页</MudNavLink>
                            <MudNavLink Href="/production-records" Style="color: #999; padding: 8px 16px;" OnClick="CloseDrawer">生产记录</MudNavLink>
                            <MudNavLink Href="/pickling-in-records" Style="color: #999; padding: 8px 16px;" OnClick="CloseDrawer">去油酸洗</MudNavLink>
                            <MudNavLink Href="/section-outsources" Style="color: #999; padding: 8px 16px;" OnClick="CloseDrawer">工段委外</MudNavLink>
                            <MudNavLink Href="/process-card-print" Style="color: #999; padding: 8px 16px;" OnClick="CloseDrawer">工艺卡打印</MudNavLink>
                        </div>
                    </ChildContent>
                </MudExpansionPanel>

                <MudExpansionPanel Style="background: transparent; color: #ccc;">
                    <TitleContent><div style="padding: 10px 16px; color: #ccc;">质量管理</div></TitleContent>
                    <ChildContent>
                        <div style="padding-left: 16px;">
                            <MudNavLink Href="/quality/process-inspection" Style="color: #999; padding: 8px 16px;" OnClick="CloseDrawer">过程检验</MudNavLink>
                            <MudNavLink Href="/material-checks" Style="color: #999; padding: 8px 16px;" OnClick="CloseDrawer">成检到料</MudNavLink>
                            <MudNavLink Href="/quality/final-inspection" Style="color: #999; padding: 8px 16px;" OnClick="CloseDrawer">成品检验</MudNavLink>
                            <MudNavLink Href="/quality-process-tracking" Style="color: #999; padding: 8px 16px;" OnClick="CloseDrawer">成检追踪</MudNavLink>
                            <MudNavLink Href="/quality/ncr" Style="color: #999; padding: 8px 16px;" OnClick="CloseDrawer">不合格报告</MudNavLink>
                            <MudNavLink Href="/quality/furnace" Style="color: #999; padding: 8px 16px;" OnClick="CloseDrawer">炉号登记</MudNavLink>
                            <MudNavLink Href="/quality/chemical-composition" Style="color: #999; padding: 8px 16px;" OnClick="CloseDrawer">牌号化学</MudNavLink>
                            <MudNavLink Href="/quality/chemical-validate" Style="color: #999; padding: 8px 16px;" OnClick="CloseDrawer">牌号验证</MudNavLink>
                        </div>
                    </ChildContent>
                </MudExpansionPanel>

                <MudExpansionPanel Style="background: transparent; color: #ccc;">
                    <TitleContent><div style="padding: 10px 16px; color: #ccc;">设备管理</div></TitleContent>
                    <ChildContent>
                        <div style="padding-left: 16px;">
                            <MudNavLink Href="/equipment" Style="color: #999; padding: 8px 16px;" OnClick="CloseDrawer">设备台账</MudNavLink>
                            <MudNavLink Href="/repair-orders" Style="color: #999; padding: 8px 16px;" OnClick="CloseDrawer">维修工单</MudNavLink>
                            <MudNavLink Href="/maintenance-orders" Style="color: #999; padding: 8px 16px;" OnClick="CloseDrawer">保养工单</MudNavLink>
                            <MudNavLink Href="/inspection-records" Style="color: #999; padding: 8px 16px;" OnClick="CloseDrawer">点检记录</MudNavLink>
                        </div>
                    </ChildContent>
                </MudExpansionPanel>

                <MudExpansionPanel Style="background: transparent; color: #ccc;">
                    <TitleContent><div style="padding: 10px 16px; color: #ccc;">物料管理</div></TitleContent>
                    <ChildContent>
                        <div style="padding-left: 16px;">
                            <MudNavLink Href="/purchase-orders" Style="color: #999; padding: 8px 16px;" OnClick="CloseDrawer">采购订单</MudNavLink>
                            <MudNavLink Href="/subcontract-orders" Style="color: #999; padding: 8px 16px;" OnClick="CloseDrawer">圆棒穿孔</MudNavLink>
                            <MudNavLink Href="/suppliers" Style="color: #999; padding: 8px 16px;" OnClick="CloseDrawer">供应商管理</MudNavLink>
                            <MudNavLink Href="/materials" Style="color: #999; padding: 8px 16px;" OnClick="CloseDrawer">物料档案</MudNavLink>
                        </div>
                    </ChildContent>
                </MudExpansionPanel>

                <MudExpansionPanel Style="background: transparent; color: #ccc;">
                    <TitleContent><div style="padding: 10px 16px; color: #ccc;">仓库管理</div></TitleContent>
                    <ChildContent>
                        <div style="padding-left: 16px;">
                            <MudNavLink Href="/warehouse/raw" Style="color: #999; padding: 8px 16px;" OnClick="CloseDrawer">原料库</MudNavLink>
                            <MudNavLink Href="/warehouse/fg" Style="color: #999; padding: 8px 16px;" OnClick="CloseDrawer">成品库</MudNavLink>
                            <MudNavLink Href="/warehouse/defect" Style="color: #999; padding: 8px 16px;" OnClick="CloseDrawer">次品库</MudNavLink>
                            <MudNavLink Href="/warehouse/wip" Style="color: #999; padding: 8px 16px;" OnClick="CloseDrawer">在制品库</MudNavLink>
                        </div>
                    </ChildContent>
                </MudExpansionPanel>

                <MudExpansionPanel Style="background: transparent; color: #ccc;">
                    <TitleContent><div style="padding: 10px 16px; color: #ccc;">计划排程</div></TitleContent>
                    <ChildContent>
                        <div style="padding-left: 16px;">
                            <MudNavLink Href="/order-overview" Style="color: #999; padding: 8px 16px;" OnClick="CloseDrawer">订单总览</MudNavLink>
                            <MudNavLink Href="/section-production-status" Style="color: #999; padding: 8px 16px;" OnClick="CloseDrawer">工段待产量</MudNavLink>
                            <MudNavLink Href="/section-flow-analysis" Style="color: #999; padding: 8px 16px;" OnClick="CloseDrawer">工段流转分析</MudNavLink>
                            <MudNavLink Href="/raw-material-lock-plan" Style="color: #999; padding: 8px 16px;" OnClick="CloseDrawer">原锁计划</MudNavLink>
                            <MudNavLink Href="/workorder-schedules" Style="color: #999; padding: 8px 16px;" OnClick="CloseDrawer">工单计划</MudNavLink>
                            <MudNavLink Href="/cold-roll-plans" Style="color: #999; padding: 8px 16px;" OnClick="CloseDrawer">冷轧计划</MudNavLink>
                            <MudNavLink Href="/batch-plans" Style="color: #999; padding: 8px 16px;" OnClick="CloseDrawer">批次计划</MudNavLink>
                            <MudNavLink Href="/final-inspection-plan" Style="color: #999; padding: 8px 16px;" OnClick="CloseDrawer">成检计划</MudNavLink>
                        </div>
                    </ChildContent>
                </MudExpansionPanel>

                <MudExpansionPanel Style="background: transparent; color: #ccc;">
                    <TitleContent><div style="padding: 10px 16px; color: #ccc;">参数表</div></TitleContent>
                    <ChildContent>
                        <div style="padding-left: 16px;">
                            <MudNavLink Href="/standard-work-days" Style="color: #999; padding: 8px 16px;" OnClick="CloseDrawer">交期排程-标准工量天数</MudNavLink>
                            <MudNavLink Href="/standard-work-day-delivery-states" Style="color: #999; padding: 8px 16px;" OnClick="CloseDrawer">交期排程-交货状态附加天数</MudNavLink>
                            <MudNavLink Href="/daily-output-estimates" Style="color: #999; padding: 8px 16px;" OnClick="CloseDrawer">产量排程-日产能预估</MudNavLink>
                            <MudNavLink Href="/section-flow-category-settings" Style="color: #999; padding: 8px 16px;" OnClick="CloseDrawer">产量排程-日流转量配置</MudNavLink>
                            <MudNavLink Href="/config-parameters" Style="color: #999; padding: 8px 16px;" OnClick="CloseDrawer">全局-参数配置</MudNavLink>
                            <MudNavLink Href="/workstations" Style="color: #999; padding: 8px 16px;" OnClick="CloseDrawer">扫码-工位管理</MudNavLink>
                            <MudNavLink Href="/employees" Style="color: #999; padding: 8px 16px;" OnClick="CloseDrawer">扫码-员工管理</MudNavLink>
                        </div>
                    </ChildContent>
                </MudExpansionPanel>

                <MudDivider Style="background: #333; margin: 4px 0;" />

                <MudNavLink Href="/data-exchange" Style="color: #ccc; padding: 10px 16px;" OnClick="CloseDrawer">数据工具</MudNavLink>
                <MudNavLink Href="/mobile-report" Style="color: #ccc; padding: 10px 16px;" OnClick="CloseDrawer">扫码报工</MudNavLink>
                <MudNavLink Href="/equipment-scan" Style="color: #ccc; padding: 10px 16px;" OnClick="CloseDrawer">设备扫码</MudNavLink>
                <MudNavLink Href="/admin/users" Style="color: #ccc; padding: 10px 16px;" OnClick="CloseDrawer">用户管理</MudNavLink>
            </MudExpansionPanels>

            <div style="border-top: 1px solid #333; padding: 16px; margin-top: 8px;">
                <AuthorizeView>
                    <Authorized>
                        <MudText Typo="Typo.body2" Style="color: #999;">
                            @context.User.Identity?.Name
                        </MudText>
                        <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="Logout" Style="color: #f44336; padding: 0; margin-top: 8px;">
                            退出登录
                        </MudButton>
                    </Authorized>
                </AuthorizeView>
            </div>
        </div>
    </MudDrawer>

    <MudMainContent Style="padding-top: 64px; min-height: 100vh;">
        @ChildContent
    </MudMainContent>
</MudLayout>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    private bool _drawerOpen;
    private AuthenticationState? _authenticationState;

    private void CloseDrawer()
    {
        _drawerOpen = false;
    }

    protected override async Task OnInitializedAsync()
    {
        AuthProvider.AuthenticationStateChanged += OnAuthenticationStateChanged;
        _authenticationState = await AuthProvider.GetAuthenticationStateAsync();
    }

    private void OnAuthenticationStateChanged(Task<AuthenticationState> task)
    {
        _ = InvokeAsync(async () =>
        {
            _authenticationState = await task;
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        AuthProvider.AuthenticationStateChanged -= OnAuthenticationStateChanged;
    }

    private async Task Logout()
    {
        try
        {
            await LocalStorage.RemoveItemAsync("authToken");
            await LocalStorage.RemoveItemAsync("refreshToken");
            await LocalStorage.RemoveItemAsync("userEmail");
            await LocalStorage.RemoveItemAsync("userName");
            await LocalStorage.RemoveItemAsync("userRoles");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Logout error: {ex.Message}");
        }
        Navigation.NavigateTo("/login", forceLoad: true);
    }
}
