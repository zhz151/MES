@using MES.Core.DTOs
@namespace MES.Blazor.Shared

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">编辑入库明细 - 第 @(EditingIndex + 1) 行</MudText>
    </TitleContent>
    <DialogContent>
        <MudGrid>
            @foreach (var col in ColumnDefs.Where(c => c.IsApplicable))
            {
                @if (col.Key is "WorkOrderNo" or "SalesOrderNo" or "OrderItemIds" && !Data.IsLinkedToWorkOrder)
                {
                    continue;
                }
                <MudItem xs="12" md="@GetMdSize(col.Key)">
                    @RenderField(col)
                </MudItem>
            }
        </MudGrid>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Variant="Variant.Text">取消</MudButton>
        <MudButton OnClick="Save" Color="Color.Primary" Variant="Variant.Filled">确定</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private MudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public InboundRowEditData Data { get; set; } = new();
    [Parameter] public int EditingIndex { get; set; }
    [Parameter] public List<ColumnDef> ColumnDefs { get; set; } = new();

    private readonly List<(string Value, string Text)> _inboundSourceOptions = new()
    {
        ("Purchase", "外购"),
        ("ProductionInbound", "生产入库"),
        ("InspectionInbound", "检验入库"),
        ("SubcontractPiercing", "委外穿孔"),
        ("SelfProduced", "自产"),
        ("TransferIn", "移库入库"),
        ("ReturnIn", "退货入库"),
    };

    private readonly List<(string Value, string Text)> _lengthStatusOptions = new()
    {
        ("定尺", "定尺"),
        ("范围尺", "范围尺"),
        ("不定尺", "不定尺"),
    };

    public class ColumnDef
    {
        public string Key { get; set; } = "";
        public string Label { get; set; } = "";
        public string Type { get; set; } = "text";
        public bool Visible { get; set; } = true;
        public bool IsApplicable { get; set; } = true;
    }

    private int GetMdSize(string key) => key switch
    {
        "Remark" => 12,
        "IsLinkedToWorkOrder" => 12,
        _ => 4
    };

    private RenderFragment RenderField(ColumnDef col) => builder =>
    {
        switch (col.Type)
        {
            case "select":
                var options = col.Key == "LengthStatus" ? _lengthStatusOptions : _inboundSourceOptions;
                var selVal = GetStringValue(col.Key);
                builder.OpenComponent<MudSelect<string>>(0);
                builder.AddAttribute(1, "Label", col.Label);
                builder.AddAttribute(2, "Dense", true);
                builder.AddAttribute(3, "Variant", Variant.Outlined);
                builder.AddAttribute(4, "Value", selVal);
                builder.AddAttribute(5, "ValueChanged", EventCallback.Factory.Create<string?>(this, v => SetStringValue(col.Key, v)));
                builder.AddAttribute(6, "ChildContent", (RenderFragment)(b2 =>
                {
                    b2.OpenComponent<MudSelectItem<string>>(0);
                    b2.AddAttribute(1, "Value", (string?)null);
                    b2.CloseComponent();
                    foreach (var opt in options)
                    {
                        b2.OpenComponent<MudSelectItem<string>>(0);
                        b2.AddAttribute(1, "Value", opt.Value);
                        b2.AddAttribute(2, "ChildContent", (RenderFragment)(b3 => b3.AddContent(0, opt.Text)));
                        b2.CloseComponent();
                    }
                }));
                builder.CloseComponent();
                break;

            case "int":
                builder.OpenComponent<MudNumericField<int>>(0);
                builder.AddAttribute(1, "Label", col.Label);
                builder.AddAttribute(2, "Dense", true);
                builder.AddAttribute(3, "Variant", Variant.Outlined);
                builder.AddAttribute(4, "HideSpinButtons", true);
                builder.AddAttribute(5, "Value", Data.InitialQuantity);
                builder.AddAttribute(6, "ValueChanged", EventCallback.Factory.Create<int>(this, v => Data.InitialQuantity = v));
                builder.CloseComponent();
                break;

            case "decimal":
                if (col.Key is "UnitWeight" or "MinLength" or "MaxLength" or "Meters" or "ActualOuterDiameter" or "ActualWallThickness")
                {
                    builder.OpenComponent<MudNumericField<decimal?>>(0);
                    builder.AddAttribute(1, "Label", col.Label);
                    builder.AddAttribute(2, "Dense", true);
                    builder.AddAttribute(3, "Variant", Variant.Outlined);
                    builder.AddAttribute(4, "HideSpinButtons", true);
                    builder.AddAttribute(5, "Value", GetNullableDecimal(col.Key));
                    builder.AddAttribute(6, "ValueChanged", EventCallback.Factory.Create<decimal?>(this, v => SetNullableDecimal(col.Key, v)));
                    builder.CloseComponent();
                }
                else
                {
                    builder.OpenComponent<MudNumericField<decimal>>(0);
                    builder.AddAttribute(1, "Label", col.Label);
                    builder.AddAttribute(2, "Dense", true);
                    builder.AddAttribute(3, "Variant", Variant.Outlined);
                    builder.AddAttribute(4, "HideSpinButtons", true);
                    builder.AddAttribute(5, "Value", Data.InitialWeight);
                    builder.AddAttribute(6, "ValueChanged", EventCallback.Factory.Create<decimal>(this, v => Data.InitialWeight = v));
                    builder.CloseComponent();
                }
                break;

            case "bool":
                builder.OpenComponent<MudSwitch<bool>>(0);
                builder.AddAttribute(1, "Dense", true);
                builder.AddAttribute(2, "Color", Color.Primary);
                builder.AddAttribute(3, "Value", Data.IsLinkedToWorkOrder);
                builder.AddAttribute(4, "ValueChanged", EventCallback.Factory.Create<bool>(this, v =>
                {
                    Data.IsLinkedToWorkOrder = v;
                    if (!v)
                    {
                        Data.WorkOrderNo = null;
                        Data.SalesOrderNo = null;
                        Data.OrderItemIds = null;
                    }
                }));
                builder.AddAttribute(5, "ChildContent", (RenderFragment)(b2 => b2.AddContent(0, col.Label)));
                builder.CloseComponent();
                break;

            default: // text
                var txtVal = GetStringValue(col.Key);
                builder.OpenComponent<MudTextField<string>>(0);
                builder.AddAttribute(1, "Label", col.Label);
                builder.AddAttribute(2, "Dense", true);
                builder.AddAttribute(3, "Variant", Variant.Outlined);
                builder.AddAttribute(4, "Value", txtVal);
                builder.AddAttribute(5, "ValueChanged", EventCallback.Factory.Create<string?>(this, v => SetStringValue(col.Key, v)));
                builder.CloseComponent();
                break;
        }
    };

    private string? GetStringValue(string key) => key switch
    {
        "MaterialType" => Data.MaterialType,
        "InboundSource" => Data.InboundSource,
        "SourceName" => Data.SourceName,
        "InboundDateStr" => Data.InboundDateStr,
        "HeatNo" => Data.HeatNo,
        "PlantGrade" => Data.PlantGrade,
        "Specification" => Data.Specification,
        "LengthStatus" => Data.LengthStatus,
        "SurfaceCondition" => Data.SurfaceCondition,
        "LocationArea" => Data.LocationArea,
        "LocationRack" => Data.LocationRack,
        "Remark" => Data.Remark,
        "WorkOrderNo" => Data.WorkOrderNo,
        "SalesOrderNo" => Data.SalesOrderNo,
        "OrderItemIds" => Data.OrderItemIds,
        "ActualSpecification" => Data.ActualSpecification,
        "ProductionBatchNo" => Data.ProductionBatchNo,
        "DefectReason" => Data.DefectReason,
        "LiabilityType" => Data.LiabilityType,
        "OriginalSupplier" => Data.OriginalSupplier,
        "TagNo" => Data.TagNo,
        "DefectRemark" => Data.DefectRemark,
        _ => null
    };

    private void SetStringValue(string key, string? value)
    {
        switch (key)
        {
            case "MaterialType": Data.MaterialType = value; break;
            case "InboundSource": Data.InboundSource = value; break;
            case "SourceName": Data.SourceName = value; break;
            case "InboundDateStr": Data.InboundDateStr = value; break;
            case "HeatNo": Data.HeatNo = value; break;
            case "PlantGrade": Data.PlantGrade = value; break;
            case "Specification": Data.Specification = value; break;
            case "LengthStatus": Data.LengthStatus = value; break;
            case "SurfaceCondition": Data.SurfaceCondition = value; break;
            case "LocationArea": Data.LocationArea = value; break;
            case "LocationRack": Data.LocationRack = value; break;
            case "Remark": Data.Remark = value; break;
            case "WorkOrderNo": Data.WorkOrderNo = value; break;
            case "SalesOrderNo": Data.SalesOrderNo = value; break;
            case "OrderItemIds": Data.OrderItemIds = value; break;
            case "ActualSpecification": Data.ActualSpecification = value; break;
            case "ProductionBatchNo": Data.ProductionBatchNo = value; break;
            case "DefectReason": Data.DefectReason = value; break;
            case "LiabilityType": Data.LiabilityType = value; break;
            case "OriginalSupplier": Data.OriginalSupplier = value; break;
            case "TagNo": Data.TagNo = value; break;
            case "DefectRemark": Data.DefectRemark = value; break;
        }
    }

    private decimal? GetNullableDecimal(string key) => key switch
    {
        "UnitWeight" => Data.UnitWeight,
        "MinLength" => Data.MinLength,
        "MaxLength" => Data.MaxLength,
        "Meters" => Data.Meters,
        "ActualOuterDiameter" => Data.ActualOuterDiameter,
        "ActualWallThickness" => Data.ActualWallThickness,
        _ => null
    };

    private void SetNullableDecimal(string key, decimal? value)
    {
        switch (key)
        {
            case "UnitWeight": Data.UnitWeight = value; break;
            case "MinLength": Data.MinLength = value; break;
            case "MaxLength": Data.MaxLength = value; break;
            case "Meters": Data.Meters = value; break;
            case "ActualOuterDiameter": Data.ActualOuterDiameter = value; break;
            case "ActualWallThickness": Data.ActualWallThickness = value; break;
        }
    }

    private void Cancel() => MudDialog.Cancel();
    private void Save() => MudDialog.Close(DialogResult.Ok(true));

    public class InboundRowEditData
    {
        public string? MaterialType { get; set; }
        public string? InboundSource { get; set; }
        public string? SourceName { get; set; }
        public string? InboundDateStr { get; set; }
        public string? HeatNo { get; set; }
        public string? PlantGrade { get; set; }
        public string? Specification { get; set; }
        public string? LengthStatus { get; set; }
        public int InitialQuantity { get; set; } = 1;
        public decimal InitialWeight { get; set; }
        public decimal? UnitWeight { get; set; }
        public string? SurfaceCondition { get; set; }
        public string? LocationArea { get; set; }
        public string? LocationRack { get; set; }
        public string? Remark { get; set; }
        public bool IsLinkedToWorkOrder { get; set; }
        public string? WorkOrderNo { get; set; }
        public string? SalesOrderNo { get; set; }
        public string? OrderItemIds { get; set; }
        // 新增模板字段
        public decimal? MinLength { get; set; }
        public decimal? MaxLength { get; set; }
        public decimal? Meters { get; set; }
        public string? ActualSpecification { get; set; }
        public decimal? ActualOuterDiameter { get; set; }
        public decimal? ActualWallThickness { get; set; }
        public string? ProductionBatchNo { get; set; }
        public string? DefectReason { get; set; }
        public string? LiabilityType { get; set; }
        public string? OriginalSupplier { get; set; }
        public string? TagNo { get; set; }
        public string? DefectRemark { get; set; }
    }
}
