@* 检验记录照片弹窗：查看 / 补拍 / 删除（过程检验与成品检验共用，仅数据源不同）。
   复用 ScanPhotoPicker 的压缩与预览能力；既有照片删除、待上传照片上传均即时落库。 *@
@namespace MES.Blazor.Shared
@using MES.Blazor.Services
@inject ProcessInspectionService ProcessService
@inject FinalInspectionService FinalService
@inject ISnackbar Snackbar
@inject IJSRuntime JS
@implements IAsyncDisposable

<MudDialog>
    <TitleContent>
        <div class="d-flex align-center flex-wrap" Style="gap:6px;">
            <MudIcon Icon="@Icons.Material.Filled.PhotoCamera" Size="Size.Small" Color="Color.Primary" />
            <MudText Typo="Typo.h6">检验照片</MudText>
            @if (!string.IsNullOrWhiteSpace(BatchNo))
            {
                <MudText Typo="Typo.body2" Color="Color.Primary" Class="font-weight-bold">@BatchNo</MudText>
            }
        </div>
    </TitleContent>
    <DialogContent>
        @if (_isLoading)
        {
            <div class="d-flex justify-center ma-4">
                <MudProgressCircular Indeterminate Size="Size.Small" />
            </div>
        }
        else
        {
            <ScanPhotoPicker Title="检验照片" Photos="_photos" MaxCount="MaxCount"
                             Disabled="_isBusy" OnDeleteExisting="DeleteExistingAsync"
                             OnChanged="OnPhotosChanged" />
            @if (!string.IsNullOrEmpty(_warningMessage))
            {
                <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Class="mt-3">
                    @_warningMessage
                </MudAlert>
            }
        }
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@(!HasPending || _isBusy)"
                   StartIcon="@Icons.Material.Filled.CloudUpload" OnClick="UploadPendingAsync">
            上传照片@(PendingCount > 0 ? $"（{PendingCount}）" : "")
        </MudButton>
        <MudButton Variant="Variant.Text" OnClick="Close">关闭</MudButton>
    </DialogActions>
</MudDialog>
