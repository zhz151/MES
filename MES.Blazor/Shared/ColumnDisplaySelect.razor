@using MES.Blazor.Services

<div style="position:relative; display:inline-block;">
    <MudButton Variant="Variant.Text" Size="Size.Small"
               Color="Color.Primary"
               StartIcon="@Icons.Material.Filled.ViewColumn"
               OnClick="ToggleMenu">
        列显示
    </MudButton>
    @if (_menuOpen)
    {
        <MudOverlay Visible="true" OnClick="@(() => _menuOpen = false)" />
        <MudPaper Class="pa-4 column-selector-panel" Elevation="8"
                  Style="position:fixed; z-index:2000; right:16px; top:120px; min-width:260px; max-height:calc(100vh - 160px); overflow-y:auto;">
            <MudText Typo="Typo.body2" Class="font-weight-bold mb-2" Color="Color.Primary">适用字段</MudText>
            @foreach (var col in Columns.Where(c => c.IsApplicable))
            {
                <MudGrid Class="d-flex align-center" Style="flex-wrap:nowrap;">
                    <MudItem>
                        <MudIconButton Icon="@Icons.Material.Filled.KeyboardArrowUp"
                                       Size="Size.Small"
                                       Disabled="@(Columns.IndexOf(col) == 0)"
                                       OnClick="@(() => MoveColumnUp(col))" />
                    </MudItem>
                    <MudItem>
                        <MudIconButton Icon="@Icons.Material.Filled.KeyboardArrowDown"
                                       Size="Size.Small"
                                       Disabled="@(Columns.IndexOf(col) == Columns.Count - 1)"
                                       OnClick="@(() => MoveColumnDown(col))" />
                    </MudItem>
                    <MudItem>
                        <MudSwitch T="bool" Value="col.Visible"
                                   ValueChanged="@((bool v) => OnColumnToggleChanged(col, v))"
                                   Color="Color.Primary" Dense="true">
                            @col.Label
                        </MudSwitch>
                    </MudItem>
                </MudGrid>
            }
            <MudDivider Class="my-2" />
            <MudText Typo="Typo.body2" Class="font-weight-bold mb-2" Color="Color.Error">不适用字段</MudText>
            @foreach (var col in Columns.Where(c => !c.IsApplicable))
            {
                <MudGrid Class="d-flex align-center" Style="flex-wrap:nowrap;opacity:0.5;">
                    <MudItem>
                        <MudIconButton Icon="@Icons.Material.Filled.Block"
                                       Size="Size.Small"
                                       Disabled="true"
                                       Color="Color.Error" />
                    </MudItem>
                    <MudItem Style="pointer-events:none;">
                        <MudSwitch T="bool" Value="false" Disabled="true" Color="Color.Error" Dense="true">
                            @col.Label
                        </MudSwitch>
                    </MudItem>
                </MudGrid>
            }
            @if (ShowCommonFields)
            {
                <MudDivider Class="my-2" />
                <MudText Typo="Typo.body2" Class="font-weight-bold mb-2" Color="Color.Tertiary">公共字段</MudText>
                <MudText Typo="Typo.caption" Class="mb-2" Color="Color.Secondary">新增行的公共字段默认与上一行相同</MudText>
                @foreach (var col in Columns.Where(c => c.IsApplicable))
                {
                    <MudGrid Class="d-flex align-center" Style="flex-wrap:nowrap;">
                        <MudItem Style="min-width:160px;">
                            <MudSwitch T="bool" Value="col.IsCommon"
                                       ValueChanged="@((bool v) => { col.IsCommon = v; })"
                                       Color="Color.Tertiary" Dense="true">
                                @col.Label
                            </MudSwitch>
                        </MudItem>
                    </MudGrid>
                }
            }
        </MudPaper>
    }
</div>

@code {
    private bool _menuOpen;

    [Parameter]
    public List<ColumnDef> Columns { get; set; } = new();

    [Parameter]
    public bool ShowCommonFields { get; set; }

    [Parameter]
    public EventCallback<ColumnDef> OnColumnToggle { get; set; }

    [Parameter]
    public EventCallback<ColumnDef> OnMoveUp { get; set; }

    [Parameter]
    public EventCallback<ColumnDef> OnMoveDown { get; set; }

    private void ToggleMenu()
    {
        _menuOpen = !_menuOpen;
    }

    private async Task OnColumnToggleChanged(ColumnDef col, bool visible)
    {
        col.Visible = visible;
        await OnColumnToggle.InvokeAsync(col);
    }

    private async Task MoveColumnUp(ColumnDef col)
    {
        var idx = Columns.IndexOf(col);
        if (idx > 0)
        {
            Columns.RemoveAt(idx);
            Columns.Insert(idx - 1, col);
            if (OnMoveUp.HasDelegate)
                await OnMoveUp.InvokeAsync(col);
        }
    }

    private async Task MoveColumnDown(ColumnDef col)
    {
        var idx = Columns.IndexOf(col);
        if (idx < Columns.Count - 1)
        {
            Columns.RemoveAt(idx);
            Columns.Insert(idx + 1, col);
            if (OnMoveDown.HasDelegate)
                await OnMoveDown.InvokeAsync(col);
        }
    }
}
