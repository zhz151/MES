@* PWA 安装提示横幅 *@
@inject IJSRuntime JS
@inject Blazored.LocalStorage.ILocalStorageService LocalStorage

@if (_showBanner)
{
    <MudPaper Class="d-flex align-center pa-3"
              Style="position: fixed; bottom: 0; left: 0; right: 0; z-index: 9999;
                     background: #1a1a2e; color: white;">
        <MudIcon Icon="@Icons.Material.Filled.Info" Color="Color.Primary" Class="mr-2" />
        <MudText Class="flex-grow-1" Style="font-size: 0.875rem;">
            安装到桌面，获取更佳体验
        </MudText>
        <MudButton Color="Color.Primary" Size="Size.Small" OnClick="Install" Class="mr-2">
            安装
        </MudButton>
        <MudIconButton Icon="@Icons.Material.Filled.Close" Color="Color.Inherit"
                       Size="Size.Small" OnClick="Dismiss" />
    </MudPaper>
}

@code {
    private bool _showBanner;
    private const string DismissKey = "pwa_install_dismissed";

    protected override async Task OnInitializedAsync()
    {
        var dismissed = await LocalStorage.GetItemAsync<bool>(DismissKey);
        if (!dismissed)
        {
            _showBanner = await IsInstallable();
        }
    }

    private async Task<bool> IsInstallable()
    {
        try
        {
            return await JS.InvokeAsync<bool>("getPwaInstallPrompt");
        }
        catch
        {
            return false;
        }
    }

    private async Task Install()
    {
        try
        {
            var accepted = await JS.InvokeAsync<bool>("triggerPwaInstall");
            if (accepted)
            {
                _showBanner = false;
            }
        }
        catch
        {
            // 安装失败，忽略
        }
    }

    private async Task Dismiss()
    {
        _showBanner = false;
        await LocalStorage.SetItemAsync(DismissKey, true);
    }
}
