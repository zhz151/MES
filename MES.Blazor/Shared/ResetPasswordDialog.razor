@* 重置密码弹窗 *@
@namespace MES.Blazor.Shared
@using MES.Core.DTOs.Auth
@using MES.Blazor.Services
@inject UserService UserService
@inject ISnackbar Snackbar

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">@Title</MudText>
    </TitleContent>
    <DialogContent>
        <MudForm @ref="_form">
            <MudTextField @bind-Value="_newPassword"
                          Label="新密码（6 位以上，无需复杂）"
                          Variant="Variant.Outlined"
                          InputType="InputType.Password"
                          Required="true"
                          RequiredError="密码不能为空"
                          Class="mb-3" />
            <MudTextField @bind-Value="_confirmPassword"
                          Label="确认密码"
                          Variant="Variant.Outlined"
                          InputType="InputType.Password"
                          Required="true"
                          RequiredError="请确认密码"
                          Class="mb-3"
                          Validation="@(new Func<string?, string?>(v => v == _newPassword ? null : "两次输入的密码不一致"))" />

            @if (!string.IsNullOrEmpty(_errorMessage))
            {
                <MudAlert Severity="Severity.Error" Class="mt-3" Dense="true">@_errorMessage</MudAlert>
            }
            @if (!string.IsNullOrEmpty(_successMessage))
            {
                <MudAlert Severity="Severity.Success" Class="mt-3" Dense="true">@_successMessage</MudAlert>
            }
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" OnClick="Cancel"
                   Disabled="@_isSuccess">取消</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Warning"
                   OnClick="Save"
                   Disabled="@_isSubmitting"
                   StartIcon="@Icons.Material.Filled.LockReset">
            重置密码
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private MudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public string Title { get; set; } = "";
    [Parameter] public string UserId { get; set; } = "";

    private MudForm? _form;
    private string _newPassword = "";
    private string _confirmPassword = "";
    private string _errorMessage = "";
    private string _successMessage = "";
    private bool _isSubmitting;
    private bool _isSuccess;

    private void Cancel() => MudDialog.Cancel();

    private async Task Save()
    {
        if (string.IsNullOrWhiteSpace(_newPassword))
        {
            _errorMessage = "密码不能为空";
            return;
        }
        if (_newPassword.Length < 6)
        {
            _errorMessage = "密码至少 6 位";
            return;
        }
        if (_newPassword != _confirmPassword)
        {
            _errorMessage = "两次输入的密码不一致";
            return;
        }

        _isSubmitting = true;
        _errorMessage = "";

        try
        {
            var request = new ResetPasswordRequest { NewPassword = _newPassword };
            var result = await UserService.ResetPasswordAsync(UserId, request);
            if (result.Success)
            {
                _successMessage = "密码重置成功";
                _isSuccess = true;
                Snackbar.Add("密码重置成功", Severity.Success);
                StateHasChanged();
                await Task.Delay(1000);
                MudDialog.Close(DialogResult.Ok(UserId));
            }
            else
            {
                _errorMessage = result.Message ?? "重置失败";
            }
        }
        catch (Exception ex)
        {
            _errorMessage = $"重置失败: {ex.Message}";
        }
        finally
        {
            _isSubmitting = false;
            StateHasChanged();
        }
    }
}
