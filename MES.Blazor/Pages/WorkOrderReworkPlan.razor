@page "/workorders/{WorkOrderId:int}/rework-plan"
@using Microsoft.AspNetCore.Authorization
@inject NavigationManager Navigation
@attribute [Authorize(Roles = "WorkOrderStaff,WorkOrderDirector,Admin")]

<MudContainer Class="mt-4" Style="max-width:100%;">
    <MudCard>
        <MudCardContent>
            <MudText Align="Align.Center" Class="py-8" Color="Color.Secondary">
                正在跳转到工单用料计划...
            </MudText>
        </MudCardContent>
    </MudCard>
</MudContainer>

@code {
    [Parameter] public int WorkOrderId { get; set; }

    protected override void OnInitialized()
    {
        Navigation.NavigateTo($"/workorders/{WorkOrderId}/material-plan");
    }
}
