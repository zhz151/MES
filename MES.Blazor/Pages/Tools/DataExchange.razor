@page "/data-exchange"
@using MES.Blazor.Services
@using System.Security.Claims
@using Microsoft.AspNetCore.Authorization
@inject DataExchangeService DataExchangeSvc
@inject IJSRuntime JSRuntime
@inject ISnackbar Snackbar
@inject AuthenticationStateProvider AuthProvider
@inject IDialogService DialogService
@attribute [Authorize(Roles = Roles.Policies.DataToolView)]

<MudContainer MaxWidth="MaxWidth.False" Class="mt-4">
    <MudText Typo="Typo.h5" Class="font-weight-bold mb-4">
        <MudIcon Icon="@Icons.Material.Filled.SwapHoriz" Class="mr-2" Color="Color.Primary" />
        数据工具
    </MudText>

    <!-- 实体选择 -->
    <MudPaper Class="pa-4 mb-4">
        <MudText Typo="Typo.subtitle1" Class="mb-3">
            <MudIcon Icon="@Icons.Material.Filled.ListAlt" Class="mr-1" Size="Size.Small" />
            Ⅰ. 选择数据类型
        </MudText>
        <MudSelect T="string"
                   Label="选择数据类型"
                   Value="@selectedEntity"
                   ValueChanged="@OnEntityChanged"
                   Forced="true"
                   AnchorOrigin="Origin.BottomCenter"
                   Class="mb-3">
            @foreach (var entity in entities)
            {
                <MudSelectItem Value="@entity.Key">@entity.Name</MudSelectItem>
            }
        </MudSelect>
    </MudPaper>

    <!-- 数据操作（下载模板/导出/刷新） -->
    @if (!string.IsNullOrEmpty(selectedEntity))
    {
        <MudPaper Class="pa-4 mb-4">
            <MudGrid>
                <MudItem xs="12" sm="4">
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               FullWidth="true"
                               StartIcon="@Icons.Material.Filled.Download"
                               OnClick="DownloadTemplate"
                               Loading="@isLoading"
                               Disabled="@isLoading">
                        下载模板
                    </MudButton>
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Info"
                               FullWidth="true"
                               StartIcon="@Icons.Material.Filled.FileDownload"
                               OnClick="ExportData"
                               Loading="@isLoading"
                               Disabled="@isLoading">
                        导出数据
                    </MudButton>
                </MudItem>
            </MudGrid>
        </MudPaper>
    }

    <!-- 导入区域（DataToolEdit 及以上） -->
    @if (canEdit)
    {
        <MudPaper Class="pa-4 mb-4">
            <MudText Typo="Typo.subtitle1" Class="mb-3">
                <MudIcon Icon="@Icons.Material.Filled.FileUpload" Class="mr-1" Size="Size.Small" />
                Ⅱ. 导入数据（编辑及以上）
            </MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">
                本区域 DataToolEditor（编辑）/ DataToolFull（管理）/ 超级管理员 可操作，非仅限管理员。
            </MudText>

            <MudFileUpload T="IBrowserFile"
                           FilesChanged="@OnFileSelected"
                           AcceptedExtensions=".xlsx"
                           MaxFileSize="10L * 1024 * 1024">
                <ButtonTemplate Context="ctx">
                    <MudButton HtmlTag="label"
                               for="@ctx.Id"
                               Variant="Variant.Filled"
                               Color="Color.Secondary"
                               StartIcon="@Icons.Material.Filled.AttachFile">
                        选择文件 (.xlsx)
                    </MudButton>
                </ButtonTemplate>
            </MudFileUpload>

            @if (selectedFile != null)
            {
                <MudText Class="mt-2" Typo="Typo.body2">
                    已选择: @selectedFile.Name (@(selectedFile.Size.ToString("N0")) bytes)
                </MudText>

                <MudText Class="mt-3" Typo="Typo.body2" Color="Color.Secondary">
                    导入模式：覆盖（含新增）——有 ID 行按 ID 覆盖；无 ID 行若业务键命中仍会覆盖，未命中则新增。
                </MudText>
                <MudText Class="mt-1" Typo="Typo.body2" Color="Color.Error">
                    ⚠ 覆盖更新时，空白单元格将清空对应字段（可空字段置空、文本置空串）；如需保留原值，请勿清空该单元格。
                </MudText>

                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.UploadFile"
                           Class="mt-2"
                           OnClick="PreviewImport"
                           Loading="@isPreviewing"
                           Disabled="@(isPreviewing || !canPreview)">
                    上传并预览
                </MudButton>
            }

            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-3">
                支持 .xlsx 格式，表头须与模板一致。导入在事务内执行：先禁用外键约束 → 写入数据 → 校验约束 → 通过则提交，失败则回滚。
            </MudText>
        </MudPaper>
    }

    @if (canEdit)
    {
        <!-- 预览结果 -->
        @if (previewResult != null)
        {
            <MudPaper Class="pa-4 mb-4">
                <MudText Typo="Typo.subtitle1" Class="mb-3">
                    <MudIcon Icon="@Icons.Material.Filled.Assessment" Class="mr-1" Size="Size.Small" />
                    Ⅲ. 预览结果
                </MudText>

                <MudText Typo="Typo.body2" Class="mb-2">
                    共 @previewResult.TotalRows 行：
                    <MudChip Size="Size.Small" Color="Color.Success">新增 @previewResult.AddCount</MudChip>
                    <MudChip Size="Size.Small" Color="Color.Warning">覆盖 @previewResult.OverwriteCount</MudChip>
                    @if (previewResult.InvalidIdCount > 0)
                    {
                        <MudChip Size="Size.Small" Color="Color.Error">ID不存在 @previewResult.InvalidIdCount</MudChip>
                    }
                    错误 @previewResult.ErrorCount
                </MudText>

                @if (previewResult.ErrorCount > 0 || previewResult.DuplicateCount > 0)
                {
                    <MudTable Items="@previewResult.RowResults.Where(r => !r.IsValid || r.IsDuplicate).ToList()"
                              Dense="true"
                              Hover="true"
                              Elevation="0"
                              Class="auto-table mt-2">
                        <HeaderContent>
                            <MudTh>行号</MudTh>
                            <MudTh>结果</MudTh>
                            <MudTh>说明</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd>@context.RowNumber</MudTd>
                            <MudTd>
                                @if (context.IsValid && !context.IsDuplicate)
                                {
                                    <MudChip Size="Size.Small" Color="Color.Success">✅ 成功</MudChip>
                                }
                                else if (context.IsDuplicate)
                                {
                                    <MudChip Size="Size.Small" Color="Color.Warning">⚠ 重复</MudChip>
                                }
                                else
                                {
                                    <MudChip Size="Size.Small" Color="Color.Error">❌ 失败</MudChip>
                                }
                            </MudTd>
                            <MudTd>
                                @if (context.Errors.Any())
                                {
                                    @string.Join("; ", context.Errors)
                                }
                                else if (context.IsDuplicate)
                                {
                                    <span>记录已存在: @FormatRowKey(context)</span>
                                }
                            </MudTd>
                        </RowTemplate>
                    </MudTable>
                }

                <!-- 将新增的行明细（无 ID 或业务键未命中；重复上传会重复插入，导入前请确认） -->
                @if (previewResult.AddCount > 0)
                {
                    <MudExpansionPanels Class="mt-3">
                        <MudExpansionPanel Text="@($"将新增 {previewResult.AddCount} 行（无ID或业务键未命中；重复上传会重复插入，请仔细核对）")" Class="pa-3" Color="Color.Success">
                            <MudTable Items="@previewResult.RowResults.Where(r => r.RowAction == "新增" && r.IsValid).ToList()"
                                      Dense="true"
                                      Hover="true"
                                      Elevation="0"
                                      Class="auto-table">
                                <HeaderContent>
                                    <MudTh>Excel行号</MudTh>
                                    <MudTh>目标记录 ID / 业务键</MudTh>
                                    <MudTh>处理动作</MudTh>
                                    <MudTh>说明</MudTh>
                                </HeaderContent>
                                <RowTemplate>
                                    <MudTd>@context.RowNumber</MudTd>
                                    <MudTd>@FormatRowKey(context)</MudTd>
                                    <MudTd>
                                        <MudChip Size="Size.Small" Color="Color.Success">新增</MudChip>
                                    </MudTd>
                                    <MudTd>@context.ActionNote</MudTd>
                                </RowTemplate>
                            </MudTable>
                        </MudExpansionPanel>
                    </MudExpansionPanels>
                }

                <!-- 将覆盖的行明细（按 ID 或业务键精确匹配，供导入前最后确认） -->
                @if (previewResult.OverwriteCount > 0)
                {
                    <MudExpansionPanels Class="mt-3">
                        <MudExpansionPanel Text="@($"将覆盖 {previewResult.OverwriteCount} 行（命中已存在记录；更新后空白单元格将清空对应字段）")" Class="pa-3">
                            <MudTable Items="@previewResult.RowResults.Where(r => r.RowAction == "覆盖" && r.IsValid).ToList()"
                                      Dense="true"
                                      Hover="true"
                                      Elevation="0"
                                      Class="auto-table">
                                <HeaderContent>
                                    <MudTh>Excel行号</MudTh>
                                    <MudTh>目标记录 ID / 业务键</MudTh>
                                    <MudTh>处理动作</MudTh>
                                    <MudTh>说明</MudTh>
                                </HeaderContent>
                                <RowTemplate>
                                    <MudTd>@context.RowNumber</MudTd>
                                    <MudTd>@FormatRowKey(context)</MudTd>
                                    <MudTd>
                                        <MudChip Size="Size.Small" Color="Color.Warning">覆盖更新</MudChip>
                                    </MudTd>
                                    <MudTd>@context.ActionNote</MudTd>
                                </RowTemplate>
                            </MudTable>
                        </MudExpansionPanel>
                    </MudExpansionPanels>
                }

                @if (previewResult.ValidCount > 0)
                {
                    <MudText Typo="Typo.subtitle2" Class="mt-3 mb-2">
                        当前模式：覆盖（含新增）——有 ID 覆盖，无 ID 且业务键命中覆盖，业务键未命中新增
                    </MudText>

                    <MudButton Variant="Variant.Filled"
                               Color="Color.Success"
                               StartIcon="@Icons.Material.Filled.CloudUpload"
                               OnClick="ConfirmImport"
                               Loading="@isImporting"
                               Disabled="@isImporting">
                        确认导入
                    </MudButton>
                }
            </MudPaper>
        }

        <!-- 导入结果 -->
        @if (importResult != null)
        {
            <MudPaper Class="pa-4 mb-4">
                <MudText Typo="Typo.subtitle1" Class="mb-3">
                    <MudIcon Icon="@Icons.Material.Filled.DoneAll" Class="mr-1" Size="Size.Small" />
                    导入结果
                </MudText>

                @if (importResult.HasRolledBack)
                {
                    <MudText Typo="Typo.body2" Color="Color.Error" Class="mb-2">
                        导入失败，已回滚。共 @importResult.TotalRows 行，全部失败。
                    </MudText>
                }
                else
                {
                    <MudText Typo="Typo.body2" Color="Color.Success" Class="mb-2">
                        导入完成: 共 @importResult.TotalRows 行，成功 @importResult.SuccessCount 行，
                        失败 @importResult.FailedCount 行
                    </MudText>
                }

                @if (importResult.Errors.Any())
                {
                    <MudTable Items="@importResult.Errors" Dense="true" Hover="true" Elevation="0" Class="auto-table">
                        <HeaderContent>
                            <MudTh>行号</MudTh>
                            <MudTh>错误信息</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd>@context.RowNumber</MudTd>
                            <MudTd>@context.Message</MudTd>
                        </RowTemplate>
                    </MudTable>
                }
            </MudPaper>
        }

        <!-- 数据修复工具（DataToolDelete 及以上） -->
        @if (canRepair)
        {
            <MudPaper Class="pa-4 mb-4">
                <MudText Typo="Typo.subtitle1" Class="mb-3">
                    <MudIcon Icon="@Icons.Material.Filled.Build" Class="mr-1" Size="Size.Small" />
                    Ⅳ. 数据修复
                </MudText>

                <MudText Typo="Typo.body2" Class="mb-3">
                    部分系统计算字段可能因数据导入被错误覆盖。点击下方按钮可一键重新计算所有系统推导字段：
                    组内序号、工段委外状态、批次当前跟踪信息（规格/工序/工段）、采购/委外订单状态、设备日期等。
                </MudText>

                <MudButton Variant="Variant.Filled"
                           Color="Color.Warning"
                           StartIcon="@Icons.Material.Filled.AutoFixHigh"
                           OnClick="FixAllSystemFields"
                           Loading="@isFixingAll"
                           Disabled="@isFixingAll">
                    一键修复所有系统字段
                </MudButton>

                @if (fixReport != null)
                {
                    <MudAlert Severity="Severity.Success" Class="mt-3" Variant="Variant.Outlined">
                        修复完成：组内序号 @fixReport.SequenceNumbersFixed 条，
                        工段委外状态 @fixReport.OutsourceStatusFixed 条，
                        批次跟踪 @fixReport.BatchTrackingFixed 个批次，
                        设备日期 @fixReport.EquipmentFixed 台。
                    </MudAlert>
                }
            </MudPaper>
        }
    }
</MudContainer>

@code {
    private List<EntityInfo> entities = new();
    private string? selectedEntity;
    private IBrowserFile? selectedFile;
    private ImportPreviewResult? previewResult;
    private ImportResult? importResult;
    private bool isLoading;
    private bool isPreviewing;
    private bool isImporting;
    private bool isFixingAll;
    private bool isAdmin;
    private bool canEdit;
    private bool canRepair;
    private bool canPreview;
    private MES.Core.Models.DataFixReport? fixReport;

    protected override async Task OnInitializedAsync()
    {
        await LoadEntities();
        await CheckPermissions();
    }

    private async Task CheckPermissions()
    {
        var authState = await AuthProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        // 兼容 JWT 短名 "role" 和 ClaimTypes.Role 两种方式
        isAdmin = user.Claims.Any(c => c.Type == "role" && c.Value == "Admin")
               || user.IsInRole(Roles.Admin);
        // 与后端策略对齐：导入=DataToolEdit(DataToolEditor/DataToolFull/Admin)，修复=DataToolDelete(DataToolFull/Admin)
        canEdit = isAdmin || user.IsInRole(Roles.Menus.DataToolEditor) || user.IsInRole(Roles.Menus.DataToolFull);
        canRepair = isAdmin || user.IsInRole(Roles.Menus.DataToolFull);
        StateHasChanged();
    }

    private async Task LoadEntities()
    {
        isLoading = true;
        try
        {
            var result = await DataExchangeSvc.GetEntitiesAsync();
            if (result.Success && result.Data != null)
                entities = result.Data;
        }
        catch (Exception ex)
        {
            Snackbar.Add($"加载实体列表失败: {ex.Message}", Severity.Error);
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task DownloadTemplate()
    {
        if (string.IsNullOrEmpty(selectedEntity)) return;
        isLoading = true;
        try
        {
            // 在 await 前先捕获实体名，避免 await 期间切换实体导致文件名与实际数据不一致
            var entityName = GetEntityName();
            var data = await DataExchangeSvc.GetTemplateAsync(selectedEntity);
            await DownloadFileAsync(data, $"{entityName}_模板.xlsx");
            Snackbar.Add("模板下载完成", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"下载失败: {ex.Message}", Severity.Error);
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task ExportData()
    {
        if (string.IsNullOrEmpty(selectedEntity)) return;
        isLoading = true;
        try
        {
            // 在 await 前先捕获实体名，避免 await 期间切换实体导致文件名与实际数据不一致
            var entityName = GetEntityName();
            var data = await DataExchangeSvc.ExportAsync(selectedEntity);
            var fileName = $"{entityName}_{DateTime.Today:yyyyMMdd}.xlsx";
            await DownloadFileAsync(data, fileName);
            Snackbar.Add("数据导出完成", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"导出失败: {ex.Message}", Severity.Error);
        }
        finally
        {
            isLoading = false;
        }
    }

    private void OnFileSelected(IBrowserFile file)
    {
        selectedFile = file;
        UpdateCanPreview();
    }

    private void OnEntityChanged(string entity)
    {
        selectedEntity = entity;
        // 切换数据类型后清空上一次的文件/预览/导入/修复结果，避免把 A 表数据误导入 B 表
        selectedFile = null;
        previewResult = null;
        importResult = null;
        fixReport = null;
        UpdateCanPreview();
    }

    private async Task PreviewImport()
    {
        if (!canPreview)
        {
            if (string.IsNullOrEmpty(selectedEntity))
                Snackbar.Add("请先在步骤Ⅰ中选择数据类型", Severity.Warning);
            else if (selectedFile == null)
                Snackbar.Add("请先选择文件", Severity.Warning);
            return;
        }

        Snackbar.Add("正在上传并解析...", Severity.Info);

        isPreviewing = true;
        UpdateCanPreview();
        previewResult = null;
        importResult = null;

        try
        {
            byte[] fileData;
            using (var ms = new MemoryStream())
            {
                await selectedFile!.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024).CopyToAsync(ms);
                fileData = ms.ToArray();
            }

            var result = await DataExchangeSvc.PreviewAsync(selectedEntity!, fileData, selectedFile.Name);
            if (result.Success && result.Data != null)
            {
                previewResult = result.Data;
                Snackbar.Add("预览完成", Severity.Info);
            }
            else
            {
                Snackbar.Add(result.Message ?? "预览失败", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"预览失败: {ex.Message}", Severity.Error);
        }
        finally
        {
            isPreviewing = false;
            UpdateCanPreview();
        }
    }

    private async Task ConfirmImport()
    {
        if (selectedFile == null || string.IsNullOrEmpty(selectedEntity) || previewResult == null) return;

        // 覆盖导入（空白清空字段）为批量写操作，先确认影响范围
        var confirm = await DialogService.ShowAsync<ConfirmDialog>("确认导入", new DialogParameters
        {
            ["ContentText"] = $"将导入 {previewResult.ValidCount} 行到「{GetEntityName()}」：覆盖 {previewResult.OverwriteCount} 行、新增 {previewResult.AddCount} 行。\n\n覆盖更新时空白单元格将清空对应字段，非空白整体覆盖。确定执行吗？",
            ["ConfirmText"] = "确认导入",
            ["Color"] = Color.Warning
        });
        var confirmResult = await confirm.Result;
        if (confirmResult.Canceled) return;

        isImporting = true;
        importResult = null;

        try
        {
            using var ms = new MemoryStream();
            await selectedFile.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024).CopyToAsync(ms);
            var fileData = ms.ToArray();

            var result = await DataExchangeSvc.ImportAsync(selectedEntity, fileData, selectedFile.Name);
            if (result.Success && result.Data != null)
            {
                importResult = result.Data;
                var severity = result.Data.HasRolledBack ? Severity.Error : Severity.Success;
                var msg = result.Data.HasRolledBack
                    ? $"导入失败已回滚: {result.Data.RollbackReason ?? "未知错误"}"
                    : $"导入完成: 成功 {result.Data.SuccessCount}，失败 {result.Data.FailedCount}";
                Snackbar.Add(msg, severity);

                // 导入后清除预览/文件状态，防止同一文件重复导入
                previewResult = null;
                selectedFile = null;
                UpdateCanPreview();
            }
            else
            {
                Snackbar.Add(result.Message ?? "导入失败", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"导入失败: {ex.Message}", Severity.Error);
        }
        finally
        {
            isImporting = false;
        }
    }

    private string GetEntityName()
    {
        var entity = entities.FirstOrDefault(e => e.Key == selectedEntity);
        return entity?.Name ?? selectedEntity ?? "数据";
    }

    private async Task DownloadFileAsync(byte[] data, string fileName)
    {
        var base64 = Convert.ToBase64String(data);
        await JSRuntime.InvokeVoidAsync("downloadFile", base64, fileName);
    }

    private void UpdateCanPreview()
    {
        canPreview = !isPreviewing && !string.IsNullOrEmpty(selectedEntity) && selectedFile != null;
    }

    /// <summary>
    /// 格式化行键：带 ID 的行直接显示 ID 数字（去掉内部 "__ID__:" 前缀），否则原样显示业务键
    /// </summary>
    private string FormatRowKey(ImportRowResult row)
    {
        if (string.IsNullOrEmpty(row.Key)) return "-";
        const string prefix = "__ID__:";
        return row.Key.StartsWith(prefix, StringComparison.Ordinal) ? row.Key[prefix.Length..] : row.Key;
    }

    private async Task FixAllSystemFields()
    {
        // 全库批量写操作，先确认影响范围（避免误触即动全库）
        var confirm = await DialogService.ShowAsync<ConfirmDialog>("确认全字段修复", new DialogParameters
        {
            ["ContentText"] = "此操作将重新计算全库系统推导字段（组内序号/工段委外状态/批次跟踪/采购委外状态/设备日期/订单快照等），覆盖可能被错误修改的字段。\n\n确定执行吗？",
            ["ConfirmText"] = "确认修复",
            ["Color"] = Color.Warning
        });
        var confirmResult = await confirm.Result;
        if (confirmResult.Canceled) return;

        isFixingAll = true;
        fixReport = null;
        try
        {
            var result = await DataExchangeSvc.FixAllSystemFieldsAsync();
            if (result.Success && result.Data != null)
            {
                fixReport = result.Data;
                Snackbar.Add($"全字段修复完成，共 {fixReport.Total} 条", Severity.Success);
            }
            else
            {
                Snackbar.Add(result.Message ?? "修复失败", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"修复失败: {ex.Message}", Severity.Error);
        }
        finally
        {
            isFixingAll = false;
        }
    }
}
