                                             ValueChanged="@(EventCallback.Factory.Create<int?>(this, OnUnprocessedQuantityChanged))"
                                             Label="未加工支数"
                                             Variant="Variant.Outlined"
                                             HideSpinButtons="true"
                                             Style="font-size: 0.875rem; height: 44px;" />
                            <MudNumericField T="decimal?" Format="G29"
                                             Value="@_unprocessedWeight"
                                             ValueChanged="@(EventCallback.Factory.Create<decimal?>(this, OnUnprocessedWeightChanged))"
                                             Label="未加工重量(kg)"
                                             Variant="Variant.Outlined"
                                             HideSpinButtons="true"
                                             Style="font-size: 0.875rem; height: 44px;" />
