                        <MudText Typo="Typo.body2" Color="Color.Success" Class="mt-2 mb-1 font-weight-bold">合格</MudText>
                        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 8px;">
                            <MudNumericField T="int?"
                                             @bind-Value="_inspectionQualifiedQty"
                                             Label="合格支数"
                                             Variant="Variant.Outlined"
                                             HideSpinButtons="true"
                                             Style="font-size: 0.875rem; height: 44px;" />
                            <MudNumericField T="decimal?" Format="G29"
                                             @bind-Value="_inspectionQualifiedWeight"
                                             Label="合格重量(kg)"
                                             Variant="Variant.Outlined"
                                             HideSpinButtons="true"
                                             Style="font-size: 0.875rem; height: 44px;" />
                        </div>
                        <div style="display: grid; grid-template-columns: 1fr 2fr; gap: 8px;" class="mt-2">
                            <MudNumericField T="int?"
                                             @bind-Value="_inspectionConcessionQty"
