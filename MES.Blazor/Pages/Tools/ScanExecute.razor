    // ========== 摄像头扫描 ==========

    private async Task StartCamera()
    {
        try
        {
            _isCameraStarted = true;
            StateHasChanged();

            await Task.Delay(100);

            var result = await JS.InvokeAsync<ScanResult>("window.startScanner",
                "scan-video", "scan-canvas", _dotNetRef, "OnQrCodeDetected");

            if (!result.Success)
            {
                Snackbar.Add(result.Error ?? "启动摄像头失败", Severity.Error);
                _isCameraStarted = false;
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"摄像头错误：{ex.Message}", Severity.Error);
            _isCameraStarted = false;
            StateHasChanged();
        }
    }

    private async Task StopCamera()
    {
        try
        {
            await JS.InvokeVoidAsync("window.stopScanner");
        }
        catch { }
        _isCameraStarted = false;
    }

    [JSInvokable]
    public async Task OnQrCodeDetected(string data)
    {
        try
        {
            switch (_step)
            {
                case ScanStep.ScanWorkstation:
                    await ResolveWorkstationCode(data);
                    break;
                case ScanStep.ScanEmployee:
                    await ResolveEmployeeCode(data);
                    break;
                case ScanStep.ScanBatch:
                    await ResolveBatchCode(data);
                    break;
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"解析失败：{ex.Message}", Severity.Error);
            StateHasChanged();
        }
    }

    // ========== 步骤1：工位码解析 ==========

    private async Task ResolveWorkstationCode(string code)
    {
        var response = await WorkstationService.GetByCodeAsync(code);
        if (!response.Success || response.Data == null)
        {
            Snackbar.Add(response.Message ?? "未识别到工位", Severity.Warning);
            return;
        }

        _workstationContext = response.Data;
        Snackbar.Add($"已识别工位：{_workstationContext!.Name}（{GetReportTypeText(_workstationContext!.ReportType)}）", Severity.Success);
        await StopCamera();
        _manualInput = null;

        // 普通报工：直接进入扫员工码
        _step = ScanStep.ScanEmployee;
        StateHasChanged();
    }

    private async Task ResolveWorkstationManualInput()
    {
        if (string.IsNullOrWhiteSpace(_manualInput)) return;
        await ResolveWorkstationCode(_manualInput.Trim());
    }

    // ========== 步骤2：员工码解析 ==========

    private async Task ResolveEmployeeCode(string code)
    {
        var response = await EmployeeService.GetByCodeAsync(code);
        if (!response.Success || response.Data == null)
        {
            Snackbar.Add(response.Message ?? "未识别到员工", Severity.Warning);
            return;
        }

        // 检查是否已添加
        if (_operators.Any(o => o.Code == response.Data.Code))
        {
            Snackbar.Add($"员工 {response.Data.Name} 已在列表中", Severity.Normal);
            return;
        }

        _operators.Add(response.Data);
        _manualInput = null;
        Snackbar.Add($"已添加操作人：{response.Data.Name}", Severity.Success);
        StateHasChanged();
    }

    private async Task ResolveEmployeeManualInput()
    {
        if (string.IsNullOrWhiteSpace(_manualInput)) return;
        await ResolveEmployeeCode(_manualInput.Trim());
    }

