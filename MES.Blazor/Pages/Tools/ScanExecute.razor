                        {
                            <MudText Typo="Typo.caption" Color="Color.Info" Class="mt-1">
                                自动算重：@_unprocessedQuantity 支 × @GetOutsourceUnitWeight() kg/支 = @_unprocessedWeight kg（可手动修正）
                            </MudText>
                        }

                        <MudTextField @bind-Value="_recoveryRemark"
                                      Label="备注（可选）"
                                      Variant="Variant.Outlined"
                                      Style="font-size: 0.875rem; height: 44px;"
                                      Class="mt-2" />

                        @* 提交按钮 *@
                        <div class="d-flex mt-4" style="gap: 8px;">
                            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                                       FullWidth="true"
                                       OnClick="SubmitAndContinue"
                                       Disabled="@(_isSubmitting || string.IsNullOrWhiteSpace(_recoveryDate))">
                                @(_isSubmitting ? "提交中..." : "提交并继续")
                            </MudButton>
                            <MudButton Variant="Variant.Outlined" Color="Color.Secondary"
                                       OnClick="SubmitAndFinish"
                                       Disabled="@(_isSubmitting || string.IsNullOrWhiteSpace(_recoveryDate))">
                                提交并完成
                            </MudButton>
                        </div>
                        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-1" Style="text-align: center;">
                            "提交并继续"：提交后继续扫下一批次；"提交并完成"：提交后结束
                        </MudText>
                    </div>
