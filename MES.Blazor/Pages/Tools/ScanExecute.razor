    private string? _finalInspectionConcessionRemark;
    private int? _finalInspectionReworkQty;
    private int? _finalInspectionWarehouseQty;
    private int? _finalInspectionScrapQty;
    private string? _finalInspectionDefectDesc;
    private string? _finalInspectionOuterDiameterRange;
    private string? _finalInspectionWallThicknessRange;
    private string? _finalInspectionLengthAllowanceRange;
    private decimal? _finalInspectionPressure;
    private int? _finalInspectionHoldTime;
    private string? _finalInspectionRemark;
