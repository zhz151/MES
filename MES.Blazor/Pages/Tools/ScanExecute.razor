                @* ========== 委外回收表单 ========== *@
                @if (_workstationContext?.ReportType == ReportTemplateType.OutsourceRecovery && _selectedOutsourceRecord != null)
                {
                    <div class="d-flex flex-column">
                        <MudText Typo="Typo.h6" Class="mb-3 font-weight-bold">
                            <MudIcon Icon="@Icons.Material.Filled.AssignmentReturn" Color="Color.Primary" Class="mr-1" />
                            委外回收 — @_selectedOutsourceRecord.OutsourceVendor
                        </MudText>

                        @* 委外记录摘要 *@
                        <MudPaper Class="pa-3 mb-3 bg-subtle" Elevation="1">
                            <div style="display: grid; grid-template-columns: auto 1fr; gap: 3px 12px; font-size: 0.85rem;">
                                <MudText Typo="Typo.body2" Color="Color.Secondary">批次：</MudText>
                                <MudText Typo="Typo.body2">@_selectedOutsourceRecord.BatchNo</MudText>
                                <MudText Typo="Typo.body2" Color="Color.Secondary">委外单位：</MudText>
                                <MudText Typo="Typo.body2">@_selectedOutsourceRecord.OutsourceVendor</MudText>
                                <MudText Typo="Typo.body2" Color="Color.Secondary">工序：</MudText>
                                <MudText Typo="Typo.body2">@ProcessDisplayHelper.GetProcessNameText(_selectedOutsourceRecord.ProcessName) — @SectionDisplayHelper.GetSectionNameText(_selectedOutsourceRecord.SectionName)</MudText>
                                <MudText Typo="Typo.body2" Color="Color.Secondary">牌号：</MudText>
                                <MudText Typo="Typo.body2">@(_selectedOutsourceRecord.PlantGrade ?? "-")</MudText>
                                <MudText Typo="Typo.body2" Color="Color.Secondary">规格：</MudText>
                                <MudText Typo="Typo.body2">@(_selectedOutsourceRecord.ManufacturingSpec ?? "-")</MudText>
                                <MudText Typo="Typo.body2" Color="Color.Secondary">委外规格：</MudText>
                                <MudText Typo="Typo.body2">@(_selectedOutsourceRecord.OutsourceSpec ?? "-")</MudText>
                                <MudText Typo="Typo.body2" Color="Color.Secondary">发出日期：</MudText>
                                <MudText Typo="Typo.body2">@_selectedOutsourceRecord.SendOutDate.ToString("yyyy-MM-dd")</MudText>
                                <MudText Typo="Typo.body2" Color="Color.Secondary">发出重量：</MudText>
                                <MudText Typo="Typo.body2">@(_selectedOutsourceRecord.SendQuantity?.ToString() ?? "-") 支 / @(_selectedOutsourceRecord.SendWeight?.ToString("G29") ?? "-") kg</MudText>
                                <MudText Typo="Typo.body2" Color="Color.Secondary">操作人：</MudText>
                                <MudText Typo="Typo.body2">
                                    @(string.Join("、", _operators.Select(o => $"{o.Name}({o.Code})")))
                                </MudText>
                            </div>
                        </MudPaper>

                        @* 回收表单字段 *@
                        <MudTextField @bind-Value="_recoveryDate"
                                      Label="回收日期"
                                      Placeholder="yyyy-MM-dd"
                                      Variant="Variant.Outlined"
                                      Style="font-size: 0.875rem; height: 44px;" />

                        <MudText Typo="Typo.body2" Color="Color.Info" Class="mt-3 mb-1 font-weight-bold">正常回收</MudText>
                        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 8px;">
                            <MudNumericField T="int?"
                                             Value="@_recoveryQuantity"
                                             ValueChanged="@(EventCallback.Factory.Create<int?>(this, OnRecoveryQuantityChanged))"
                                             Label="回收支数"
                                             Variant="Variant.Outlined"
                                             HideSpinButtons="true"
                                             Style="font-size: 0.875rem; height: 44px;" />
                            <MudNumericField T="decimal?" Format="G29"
                                             Value="@_recoveryWeight"
                                             ValueChanged="@(EventCallback.Factory.Create<decimal?>(this, OnRecoveryWeightChanged))"
                                             Label="回收重量(kg)"
                                             Variant="Variant.Outlined"
                                             HideSpinButtons="true"
                                             Style="font-size: 0.875rem; height: 44px;" />
