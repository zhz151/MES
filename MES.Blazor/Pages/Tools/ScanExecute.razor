                        @if (_recoveryWeightAuto && GetOutsourceUnitWeight() > 0)
                        {
                            <MudText Typo="Typo.caption" Color="Color.Info" Class="mt-1">
                                自动算重：@_recoveryQuantity 支 × @GetOutsourceUnitWeight() kg/支 = @_recoveryWeight kg（可手动修正）
                            </MudText>
                        }

