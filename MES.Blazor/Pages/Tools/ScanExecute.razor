    // ========== 步骤3：批次号解析 + 工序组筛选 ==========

    private async Task ResolveBatchCode(string batchInput)
    {
        // 支持 批次号|工序组ID 格式
        var parts = batchInput.Split('|');
        var batchNo = parts[0];
        var specificGroupId = parts.Length >= 2 && int.TryParse(parts[1], out var gid) ? gid : (int?)null;

        await LoadBatchAndFilterGroups(batchNo, specificGroupId);
    }

    private async Task ResolveBatchManualInput()
    {
        if (string.IsNullOrWhiteSpace(_manualInput)) return;
        await ResolveBatchCode(_manualInput.Trim());
    }

    private async Task LoadBatchAndFilterGroups(string batchNo, int? specificGroupId = null)
    {
        var response = await ScanService.GetBatchProcessGroupsAsync(batchNo);
        if (!response.Success || response.Data == null)
        {
            Snackbar.Add(response.Message ?? "解析批次失败", Severity.Error);
            StateHasChanged();
            return;
        }

        _batchGroupResult = response.Data;
        _selectedProcessGroup = null;

        // ====== 出缸报工：加载入缸记录供选择 ======
        if (_workstationContext?.ReportType == ReportTemplateType.PicklingOutRecord)
        {
            var picklingResponse = await PicklingService.GetByBatchAsync(batchNo);
            if (picklingResponse.Success && picklingResponse.Data != null)
            {
                // 仅显示待完工的记录（Status == "Soaking"）
                _picklingInRecords = picklingResponse.Data
                    .Where(r => r.Status == PicklingStatus.Soaking)
                    .ToList();
            }

            await StopCamera();
            _manualInput = null;
            StateHasChanged();
            return;
        }

        // ====== 委外回收：加载待回收记录供选择 ======
        if (_workstationContext?.ReportType == ReportTemplateType.OutsourceRecovery)
        {
            var secName = _workstationContext?.SectionName;
            if (!string.IsNullOrEmpty(secName))
            {
                var osResponse = await SectionOutsourceService.GetPendingByBatchAsync(batchNo, secName);
                if (osResponse.Success && osResponse.Data != null)
                {
                    _pendingOutsourceRecords = osResponse.Data;
                }
            }

            await StopCamera();
            _manualInput = null;
            StateHasChanged();
            return;
        }

        // ====== 成检到料：解析后直接显示批次信息 ======
        if (_workstationContext?.ReportType == ReportTemplateType.MaterialReceiveCheck)
        {
            await StopCamera();
            _manualInput = null;
            StateHasChanged();
            return;
        }

        // ====== 成品检验：解析后加载批次详细信息，检验项目由工位绑定直击 ======
        if (_workstationContext?.ReportType == ReportTemplateType.FinalInspection)
        {
            var lookupResponse = await FinalInspectionService.LookupBatchAsync(batchNo);
            if (lookupResponse.Success)
            {
                _batchLookupResult = lookupResponse.Data;
            }

            await StopCamera();
            _manualInput = null;

            // 检验项目由工位绑定（扫工位即确定），直接进入表单
            if (!string.IsNullOrEmpty(_finalInspectionItem))
            {
                await ConfirmFinalInspection();
            }
            else
            {
                Snackbar.Add("该成品检验工位未绑定检验项目，请在工位配置中设置", Severity.Warning);
                StateHasChanged();
            }
            return;
        }

        // 按工位工段过滤工序组（仅普通报工/入缸/工段委外/过程检验）
        var sectionName = _workstationContext?.SectionName;
        if (!string.IsNullOrEmpty(sectionName))
        {
            _filteredGroups = _batchGroupResult.ProcessGroups
                .Where(g => g.SectionNames.Contains(SectionDisplayHelper.GetSectionNameText(sectionName), StringComparer.OrdinalIgnoreCase))
                .ToList();
        }
        else
        {
            _filteredGroups = _batchGroupResult.ProcessGroups.ToList();
        }

        // 如果指定了工序组ID，检查是否在过滤列表中
        if (specificGroupId.HasValue)
        {
            var matched = _filteredGroups.FirstOrDefault(g => g.Id == specificGroupId.Value);
            if (matched != null)
            {
                // 指定的工序组匹配 → 直接进入表单
                await GoToFillForm(batchNo, matched);
                return;
            }
            // 指定的工序组不匹配过滤条件 → 回退到列表选择
        }

        // 过滤后唯一 → 自动跳过选择
        if (_filteredGroups.Count == 1)
        {
            await GoToFillForm(batchNo, _filteredGroups[0]);
            return;
        }

        // 0 或 多个 → 显示列表供选择
        await StopCamera();
        _manualInput = null;
        StateHasChanged();
    }

