                        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-1" Style="text-align: center;">
                            "提交并继续"：提交后继续扫下一批次；"提交并完成"：提交后结束
                        </MudText>
                    </div>
                }

                @* ========== 成检到料表单 ========== *@
                @if (_workstationContext?.ReportType == "MaterialReceiveCheck" && _batchGroupResult != null)
                {
                    <div class="d-flex flex-column">
                        <MudText Typo="Typo.h6" Class="mb-3 font-weight-bold">
                            <MudIcon Icon="@Icons.Material.Filled.Assignment" Color="Color.Primary" Class="mr-1" />
                            成检到料
                        </MudText>

                        @* 批次摘要 *@
                        <MudPaper Class="pa-3 mb-3" Elevation="1" Style="background: #fafafa;">
                            <div style="display: grid; grid-template-columns: auto 1fr; gap: 3px 12px; font-size: 0.85rem;">
                                <MudText Typo="Typo.body2" Color="Color.Secondary">批次：</MudText>
                                <MudText Typo="Typo.body2">@_batchGroupResult.BatchNo</MudText>
                                <MudText Typo="Typo.body2" Color="Color.Secondary">牌号：</MudText>
                                <MudText Typo="Typo.body2">@_batchGroupResult.PlantGrade</MudText>
                                <MudText Typo="Typo.body2" Color="Color.Secondary">规格：</MudText>
                                <MudText Typo="Typo.body2">@_batchGroupResult.Specification</MudText>
                                <MudText Typo="Typo.body2" Color="Color.Secondary">挂牌号：</MudText>
                                <MudText Typo="Typo.body2">@(_batchGroupResult.TagNo ?? "-")</MudText>
                            </div>
                        </MudPaper>

                        @* 表单字段 *@
                        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 8px;">
                            <MudTextField @bind-Value="_materialReceiveDate"
