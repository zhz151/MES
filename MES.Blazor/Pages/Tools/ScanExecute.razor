    }

    // ========== 自动算重 ==========

    private void OnQuantityChanged(int? value)
    {
        _quantity = value;
        if (value.HasValue && _resolveResult?.UnitWeight > 0)
        {
            _weight = Math.Round(value.Value * _resolveResult.UnitWeight.Value, 2);
            _weightAutoCalculated = true;
        }
        else
        {
            _weightAutoCalculated = false;
        }
        StateHasChanged();
    }

    private void OnWeightChanged(decimal? value)
    {
        _weight = value;
        _weightAutoCalculated = false; // 用户手动改过，停止自动算重
        StateHasChanged();
    }

    // ========== 步骤4：提交 ==========

    private async Task SubmitAndContinue()
    {
        await SubmitCurrentRecord();
        if (!_isSubmitting) // 提交成功
        {
            ResetFormForNextBatch();
        }
    }

    private async Task SubmitAndFinish()
    {
        await SubmitCurrentRecord();
        if (!_isSubmitting) // 提交成功
        {
            await StopCamera();
            _step = ScanStep.Done;
            StateHasChanged();
        }
    }

    private async Task SubmitCurrentRecord()
    {
        _isSubmitting = true;
        StateHasChanged();

        try
        {
            var operatorText = _operators.Count > 0
                ? string.Join("、", _operators.Select(o => $"{o.Name}({o.Code})"))
                : null;

            // ====== 普通报工 ======
            if (_workstationContext?.ReportType == "ProductionRecord")
            {
                if (string.IsNullOrWhiteSpace(_selectedSection) || _resolveResult == null || _quantity == null)
                    return;

                var section = _resolveResult.AvailableSections
                    .FirstOrDefault(s => s.SectionName == _selectedSection);

                var request = new CreateProductionRecordRequest
                {
                    BatchNo = _resolveResult.BatchNo,
                    ProductionBatchId = 0,
                    ProcessGroupId = _resolveResult.ProcessGroupId,
                    ProcessName = _resolveResult.ProcessName,
                    ManufacturingSpec = _resolveResult.ManufacturingSpec ?? "",
                    SectionName = _selectedSection,
                    SequenceNumber = section?.SequenceNumber ?? 0,
                    ExecDate = DateTime.TryParse(_execDateText, out var execDate) ? execDate : DateTime.Today,
                    EquipmentName = _workstationContext?.EquipmentName,
                    Operator = operatorText,
                    Shift = _shift,
                    Quantity = _quantity,
                    Weight = _weight,
                    SolutionTemperature = _solutionTemperature,
                    SoakTime = _soakTime,
                    CuttingMultiple = _cuttingMultiple,
                    FinishedCutLength = _finishedCutLength,
                    PostCutQuantity = _postCutQuantity,
                    Remark = _remark,
                    DataSource = "SCAN"
                };

                var response = await ScanService.CreateProductionRecordAsync(request);
                if (response.Success)
                {
                    _submittedBatchNo = _resolveResult.BatchNo;
                    _submittedSection = _selectedSection;
                    Snackbar.Add("报工提交成功", Severity.Success);
                }
                else
                {
                    Snackbar.Add(response.Message ?? "提交失败", Severity.Error);
                }
            }
            // ====== 入缸报工 ======
            else if (_workstationContext?.ReportType == "PicklingInRecord")
            {
                if (string.IsNullOrWhiteSpace(_selectedSection) || _resolveResult == null || _quantity == null)
                    return;

                var section = _resolveResult.AvailableSections
                    .FirstOrDefault(s => s.SectionName == _selectedSection);

                var request = new CreatePicklingInRecordRequest
                {
                    BatchNo = _resolveResult.BatchNo,
                    ProcessGroupId = _resolveResult.ProcessGroupId,
                    ProcessName = _resolveResult.ProcessName,
                    ManufacturingSpec = _resolveResult.ManufacturingSpec ?? "",
                    SectionName = _selectedSection,
                    SequenceNumber = section?.SequenceNumber ?? 0,
                    InDate = DateTime.TryParse(_execDateText, out var execDate) ? execDate : DateTime.Today,
                    EquipmentName = _workstationContext?.EquipmentName,
                    Operator = operatorText,
                    Shift = _shift,
                    Quantity = _quantity,
                    Weight = _weight,
                    Remark = _remark,
                    DataSource = "SCAN"
                };

                var response = await PicklingService.CreateAsync(request);
                if (response.Success)
                {
                    _submittedBatchNo = _resolveResult.BatchNo;
                    _submittedSection = _selectedSection;
                    Snackbar.Add("入缸报工提交成功", Severity.Success);
                }
                else
                {
                    Snackbar.Add(response.Message ?? "提交失败", Severity.Error);
                }
            }
            // ====== 出缸报工 ======
            else if (_workstationContext?.ReportType == "PicklingOutRecord")
            {
                if (_selectedPicklingInRecord == null || string.IsNullOrWhiteSpace(_picklingOutCompleteDate))
                    return;

                var request = new CreatePicklingOutRecordRequest
                {
                    PicklingInRecordId = _selectedPicklingInRecord.Id,
                    CompleteDate = DateTime.TryParse(_picklingOutCompleteDate, out var compDate) ? compDate : DateTime.Today,
                    Remark = _picklingOutRemark,
                    DataSource = "SCAN"
                };

                var response = await PicklingService.CreateOutRecordAsync(request);
                if (response.Success)
                {
                    _submittedBatchNo = _selectedPicklingInRecord.BatchNo;
                    _submittedSection = _selectedPicklingInRecord.SectionName;
                    Snackbar.Add("出缸报工提交成功", Severity.Success);
                }
                else
                {
                    Snackbar.Add(response.Message ?? "提交失败", Severity.Error);
                }
            }
            // ====== 工段委外发出 ======
            else if (_workstationContext?.ReportType == "SectionOutsource")
            {
                if (_resolveResult == null || string.IsNullOrWhiteSpace(_sectionOutsourceVendor))
                    return;

                var request = new CreateSectionOutsourceRequest
                {
                    BatchNo = _resolveResult.BatchNo,
                    ProcessName = _resolveResult.ProcessName,
                    ManufacturingSpec = _resolveResult.ManufacturingSpec ?? "",
                    SectionName = _workstationContext!.SectionName,
                    SequenceNumber = _resolveResult.AvailableSections
                        .FirstOrDefault(s => s.SectionName == _workstationContext!.SectionName)?.SequenceNumber ?? 0,
                    OutsourceVendor = _sectionOutsourceVendor,
                    SendOutDate = DateTime.TryParse(_sectionOutsourceSendOutDate, out var sd) ? sd : DateTime.Today,
                    SendQuantity = _sectionOutsourceSendQuantity,
                    SendWeight = _sectionOutsourceSendWeight,
                    OutsourceSpec = _sectionOutsourceSpec,
                    ExpectedReturnDate = DateTime.TryParse(_sectionOutsourceExpectedReturnDate, out var erd) ? erd : null,
                    IsUrgent = _sectionOutsourceIsUrgent,
                    Remark = _sectionOutsourceRemark,
                    DataSource = "SCAN"
                };

                var response = await SectionOutsourceService.CreateAsync(request);
                if (response.Success)
                {
                    _submittedBatchNo = _resolveResult.BatchNo;
                    _submittedSection = _workstationContext!.SectionName;
                    Snackbar.Add("工段委外提交成功", Severity.Success);
                }
                else
                {
                    Snackbar.Add(response.Message ?? "提交失败", Severity.Error);
                }
            }
            // ====== 委外回收 ======
            else if (_workstationContext?.ReportType == "OutsourceRecovery")
            {
                if (_selectedOutsourceRecord == null || string.IsNullOrWhiteSpace(_recoveryDate))
                    return;

                var request = new CreateOutsourceRecoveryRequest
                {
                    SectionOutsourceId = _selectedOutsourceRecord.Id,
                    RecoveryDate = DateTime.TryParse(_recoveryDate, out var rd) ? rd : DateTime.Today,
                    RecoveryQuantity = _recoveryQuantity,
                    RecoveryWeight = _recoveryWeight,
                    UnprocessedQuantity = _unprocessedQuantity,
                    UnprocessedWeight = _unprocessedWeight,
                    Remark = _recoveryRemark,
                    DataSource = "SCAN"
                };

                var response = await SectionOutsourceService.CreateRecoveryAsync(request);
                if (response.Success)
                {
                    _submittedBatchNo = _selectedOutsourceRecord.BatchNo ?? "";
                    _submittedSection = _selectedOutsourceRecord.SectionName;
                    Snackbar.Add("委外回收提交成功", Severity.Success);
                }
                else
                {
                    Snackbar.Add(response.Message ?? "提交失败", Severity.Error);
                }
            }
            // ====== 过程检验 ======
            else if (_workstationContext?.ReportType == "ProcessInspection")
            {
                if (_resolveResult == null) return;

                var request = new CreateProcessInspectionRequest
                {
                    BatchNo = _resolveResult.BatchNo,
                    ProcessName = _resolveResult.ProcessName,
                    ManufacturingSpec = _resolveResult.ManufacturingSpec ?? "",
                    SectionName = _workstationContext!.SectionName,
                    SequenceNumber = _resolveResult.AvailableSections
                        .FirstOrDefault(s => s.SectionName == _workstationContext!.SectionName)?.SequenceNumber ?? 0,
                    InspectionDate = DateTime.TryParse(_inspectionDate, out var id) ? id : DateTime.Today,
                    EquipmentName = _workstationContext?.EquipmentName,
                    Inspector = string.Join("、", _operators.Select(o => $"{o.Name}({o.Code})")),
                    Shift = _shift,
                    Quantity = _inspectionQuantity,
                    Weight = _inspectionWeight,
                    InspectionItem = _inspectionItem,
                    QualifiedQuantity = _inspectionQualifiedQty,
                    QualifiedWeight = _inspectionQualifiedWeight,
                    QualifiedConcessionQuantity = _inspectionConcessionQty,
                    ConcessionRemark = _inspectionConcessionRemark,
                    DefectReworkQuantity = _inspectionReworkQty,
                    DefectWarehouseQuantity = _inspectionWarehouseQty,
                    DefectScrapQuantity = _inspectionScrapQty,
                    DefectDescription = _inspectionDefectDesc,
                    Remark = _inspectionRemark,
                    DataSource = "SCAN"
                };

                var response = await ScanService.CreateInspectionAsync(request);
                if (response.Success)
                {
                    _submittedBatchNo = _resolveResult.BatchNo;
                    _submittedSection = _workstationContext!.SectionName;
                    Snackbar.Add("过程检验提交成功", Severity.Success);
                }
                else
                {
                    Snackbar.Add(response.Message ?? "提交失败", Severity.Error);
                }
            }
            // ====== 成检到料 ======
            else if (_workstationContext?.ReportType == "MaterialReceiveCheck")
            {
                if (_batchGroupResult == null) return;

                var request = new CreateMaterialReceiveCheckRequest
                {
                    BatchNo = _batchGroupResult.BatchNo,
                    ReceiveDate = DateTime.TryParse(_materialReceiveDate, out var rd) ? rd : DateTime.Today,
                    Shift = _shift,
                    Checker = _materialChecker ?? string.Join("、", _operators.Select(o => $"{o.Name}({o.Code})")),
                    Remark = _materialRemark,
                    DataSource = "SCAN"
                };

                var response = await ProductionRecordService.CreateMaterialReceiveCheckAsync(request);
                if (response.Success)
                {
                    _submittedBatchNo = _batchGroupResult.BatchNo;
                    _submittedSection = "成检到料";
                    Snackbar.Add("成检到料提交成功", Severity.Success);
                }
                else
                {
                    Snackbar.Add(response.Message ?? "提交失败", Severity.Error);
                }
            }
            // ====== 成品检验 ======
            else if (_workstationContext?.ReportType == "FinalInspection")
            {
                if (_batchGroupResult == null || string.IsNullOrEmpty(_finalInspectionItem)) return;

                // 从中文显示名反查枚举值
                var inspectionItem = InspectionItem.PMIInspection; // 默认
                foreach (InspectionItem item in Enum.GetValues<InspectionItem>())
                {
                    if (DisplayHelper.GetInspectionItemText(item) == _finalInspectionItem)
                    {
                        inspectionItem = item;
                        break;
                    }
                }

                var request = new CreateFinalInspectionRequest
                {
                    BatchNo = _batchGroupResult.BatchNo,
                    InspectionItem = inspectionItem,
                    InspectionDate = DateTime.TryParse(_finalInspectionDate, out var fid) ? fid : DateTime.Today,
                    EquipmentName = _workstationContext?.EquipmentName,
                    Operator = string.Join("、", _operators.Select(o => $"{o.Name}({o.Code})")),
                    Shift = _shift,
                    Quantity = _finalInspectionQuantity,
                    Weight = _finalInspectionWeight,
                    QualifiedQuantity = _finalInspectionQualifiedQty,
                    QualifiedWeight = _finalInspectionQualifiedWeight,
                    QualifiedConcessionQuantity = _finalInspectionConcessionQty,
                    ConcessionRemark = _finalInspectionConcessionRemark,
                    DefectReworkQuantity = _finalInspectionReworkQty,
                    DefectWarehouseQuantity = _finalInspectionWarehouseQty,
                    DefectScrapQuantity = _finalInspectionScrapQty,
                    DefectDescription = _finalInspectionDefectDesc,
                    OuterDiameterRange = _finalInspectionOuterDiameterRange,
                    WallThicknessRange = _finalInspectionWallThicknessRange,
                    LengthAllowanceRange = _finalInspectionLengthAllowanceRange,
                    Pressure = _finalInspectionPressure,
                    HoldTime = _finalInspectionHoldTime,
                    Remark = _finalInspectionRemark,
                    DataSource = "SCAN"
                };

                var response = await FinalInspectionService.CreateAsync(request);
                if (response.Success)
                {
                    _submittedBatchNo = _batchGroupResult.BatchNo;
                    _submittedSection = $"成品检验-{_finalInspectionItem}";
                    Snackbar.Add("成品检验提交成功", Severity.Success);
                }
                else
                {
                    Snackbar.Add(response.Message ?? "提交失败", Severity.Error);
                }
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"提交失败：{ex.Message}", Severity.Error);
        }
        finally
        {
            _isSubmitting = false;
            StateHasChanged();
        }
    }

