    private async Task GoToFillForm(string batchNo, ProcessGroupOption group)
    {
        var response = await ScanService.ResolveAsync(batchNo, group.Id);
        if (!response.Success || response.Data == null)
        {
            Snackbar.Add(response.Message ?? "解析工序组失败", Severity.Error);
            StateHasChanged();
            return;
        }

        _resolveResult = response.Data;

        // 工位上下文自动匹配工段
        _selectedSection = null;
        if (_hasWorkstation && !string.IsNullOrEmpty(_workstationContext?.SectionName)
            && _resolveResult.AvailableSections.Any(s => s.SectionName == SectionDisplayHelper.GetSectionNameText(_workstationContext!.SectionName)))
        {
            _selectedSection = _workstationContext!.SectionName;
        }

        // 重置表单
        _execDateText = DateTime.Today.ToString("yyyy-MM-dd");
        _quantity = null;
        _weight = null;
        _weightAutoCalculated = false;
        _solutionTemperature = null;
        _soakTime = null;
        _cuttingMultiple = null;
        _finishedCutLength = null;
        _postCutQuantity = null;
        _remark = null;

        // 重置工段委外字段
        _sectionOutsourceVendor = null;
        _sectionOutsourceSendOutDate = DateTime.Today.ToString("yyyy-MM-dd");
        _sectionOutsourceExpectedReturnDate = null;
        _sectionOutsourceSendQuantity = null;
        _sectionOutsourceSendWeight = null;
        _sectionOutsourceSpec = null;
        _sectionOutsourceIsUrgent = false;
        _sectionOutsourceRemark = null;

        // 重置过程检验字段
        _inspectionDate = DateTime.Today.ToString("yyyy-MM-dd");
        _inspectionItem = null;
        _inspectionQuantity = null;
        _inspectionWeight = null;
        _inspectionWeightAuto = false;
        _inspectionQualifiedQty = null;
        _inspectionQualifiedWeight = null;
        _inspectionConcessionQty = null;
        _inspectionConcessionRemark = null;
        _inspectionReworkQty = null;
        _inspectionWarehouseQty = null;
        _inspectionScrapQty = null;
        _inspectionDefectDesc = null;
        _inspectionRemark = null;

        await StopCamera();
        _manualInput = null;
        _step = ScanStep.FillForm;
        StateHasChanged();
    }

