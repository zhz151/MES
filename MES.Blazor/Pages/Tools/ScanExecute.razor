                        @* 提交按钮 *@
                        <div class="d-flex mt-4" style="gap: 8px;">
                            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                                       FullWidth="true"
                                       OnClick="SubmitAndContinue"
                                       Disabled="@(_isSubmitting || string.IsNullOrWhiteSpace(_materialReceiveDate))">
                                @(_isSubmitting ? "提交中..." : "提交并继续")
                            </MudButton>
                            <MudButton Variant="Variant.Outlined" Color="Color.Secondary"
                                       OnClick="SubmitAndFinish"
                                       Disabled="@(_isSubmitting || string.IsNullOrWhiteSpace(_materialReceiveDate))">
                                提交并完成
                            </MudButton>
                        </div>
                        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-1" Style="text-align: center;">
                            "提交并继续"：提交后继续扫下一批次；"提交并完成"：提交后结束
                        </MudText>
                    </div>
                }

                @* ========== 成品检验表单 ========== *@
                @if (_workstationContext?.ReportType == ReportTemplateType.FinalInspection && _batchGroupResult != null)
                {
                    <div class="d-flex flex-column">
                        <MudText Typo="Typo.h6" Class="mb-3 font-weight-bold">
                            <MudIcon Icon="@Icons.Material.Filled.Verified" Color="Color.Primary" Class="mr-1" />
                            成品检验 — @_finalInspectionItem
                        </MudText>

                        @* 批次摘要 *@
                        <MudPaper Class="pa-3 mb-3 bg-subtle" Elevation="1">
                            <div style="display: grid; grid-template-columns: auto 1fr; gap: 3px 12px; font-size: 0.85rem;">
                                <MudText Typo="Typo.body2" Color="Color.Secondary">批次：</MudText>
                                <MudText Typo="Typo.body2">@_batchGroupResult.BatchNo</MudText>
                                <MudText Typo="Typo.body2" Color="Color.Secondary">牌号：</MudText>
                                <MudText Typo="Typo.body2">@(_batchLookupResult?.PlantGrade ?? _batchGroupResult.PlantGrade)</MudText>
                                <MudText Typo="Typo.body2" Color="Color.Secondary">规格：</MudText>
                                <MudText Typo="Typo.body2">@(_batchLookupResult?.Specification ?? _batchGroupResult.Specification)</MudText>
                                <MudText Typo="Typo.body2" Color="Color.Secondary">检验项目：</MudText>
                                <MudText Typo="Typo.body2"><MudChip Size="Size.Small" Color="Color.Primary">@_finalInspectionItem</MudChip></MudText>
                                @if (_batchLookupResult?.WorkOrderNo != null)
                                {
                                    <MudText Typo="Typo.body2" Color="Color.Secondary">工单号：</MudText>
                                    <MudText Typo="Typo.body2">@_batchLookupResult.WorkOrderNo</MudText>
                                }
                                @if (_batchLookupResult?.SalesOrderNo != null)
                                {
                                    <MudText Typo="Typo.body2" Color="Color.Secondary">订单号：</MudText>
                                    <MudText Typo="Typo.body2">@_batchLookupResult.SalesOrderNo</MudText>
                                }
                                <MudText Typo="Typo.body2" Color="Color.Secondary">操作人：</MudText>
                                <MudText Typo="Typo.body2">
                                    @(string.Join("、", _operators.Select(o => $"{o.Name}({o.Code})")))
                                </MudText>
                            </div>
                        </MudPaper>

                        @* 表单字段 *@
                        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 8px;">
                            <MudTextField @bind-Value="_finalInspectionDate"
                                          Label="检验日期"
                                          Placeholder="yyyy-MM-dd"
                                          Variant="Variant.Outlined"
                                          Style="font-size: 0.875rem; height: 44px;" />
                            <MudTextField Value="@($"班次：{DisplayHelper.GetShiftTypeText(ShiftHelper.GetShiftByTime())}（自动判定）")"
                                          Label="班次"
                                          ReadOnly="true"
                                          Variant="Variant.Outlined"
                                          Style="font-size: 0.875rem; height: 44px;" />
                        </div>

                        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 8px;" class="mt-2">
                            <MudNumericField T="int?"
                                             Value="@_finalInspectionQuantity"
                                             ValueChanged="@(EventCallback.Factory.Create<int?>(this, OnFinalInspectionQuantityChanged))"
                                             Label="检验支数"
                                             Variant="Variant.Outlined"
                                             HideSpinButtons="true"
                                             Style="font-size: 0.875rem; height: 44px;" />
                            <MudNumericField T="decimal?" Format="G29"
                                             Value="@_finalInspectionWeight"
                                             ValueChanged="@(EventCallback.Factory.Create<decimal?>(this, OnFinalInspectionWeightChanged))"
                                             Label="检验重量(kg)"
                                             Variant="Variant.Outlined"
                                             HideSpinButtons="true"
                                             Style="font-size: 0.875rem; height: 44px;" />
                        </div>
                        @if (_batchGroupResult?.UnitWeight > 0 && _finalInspectionWeightAuto)
                        {
                            <MudText Typo="Typo.caption" Color="Color.Info" Class="mt-1">
                                自动算重：@_finalInspectionQuantity 支 × @_batchGroupResult.UnitWeight kg/支 = @_finalInspectionWeight kg（可手动修正）
                            </MudText>
                        }

                        <MudText Typo="Typo.body2" Color="Color.Success" Class="mt-2 mb-1 font-weight-bold">合格</MudText>
                        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 8px;">
                            <MudNumericField T="int?"
                                             @bind-Value="_finalInspectionQualifiedQty"
                                             Label="合格支数"
                                             Variant="Variant.Outlined"
                                             HideSpinButtons="true"
                                             Style="font-size: 0.875rem; height: 44px;" />
                            <MudNumericField T="decimal?" Format="G29"
                                             @bind-Value="_finalInspectionQualifiedWeight"
                                             Label="合格重量(kg)"
                                             Variant="Variant.Outlined"
                                             HideSpinButtons="true"
                                             Style="font-size: 0.875rem; height: 44px;" />
                        </div>
                        <div style="display: grid; grid-template-columns: 1fr 2fr; gap: 8px;" class="mt-2">
                            <MudNumericField T="int?"
                                             @bind-Value="_finalInspectionConcessionQty"
                                             Label="让步放行支数"
                                             Variant="Variant.Outlined"
                                             HideSpinButtons="true"
                                             Style="font-size: 0.875rem; height: 44px;" />
                            <MudTextField @bind-Value="_finalInspectionConcessionRemark"
                                          Label="让步说明"
                                          Variant="Variant.Outlined"
                                          Style="font-size: 0.875rem; height: 44px;" />
                        </div>

                        <MudText Typo="Typo.body2" Color="Color.Error" Class="mt-2 mb-1 font-weight-bold">不合格</MudText>
                        <div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 8px;">
                            <MudNumericField T="int?"
                                             @bind-Value="_finalInspectionReworkQty"
                                             Label="返整支数"
                                             Variant="Variant.Outlined"
                                             HideSpinButtons="true"
                                             Style="font-size: 0.875rem; height: 44px;" />
                            <MudNumericField T="int?"
                                             @bind-Value="_finalInspectionWarehouseQty"
                                             Label="入库支数"
                                             Variant="Variant.Outlined"
                                             HideSpinButtons="true"
                                             Style="font-size: 0.875rem; height: 44px;" />
                            <MudNumericField T="int?"
                                             @bind-Value="_finalInspectionScrapQty"
                                             Label="报废支数"
                                             Variant="Variant.Outlined"
                                             HideSpinButtons="true"
                                             Style="font-size: 0.875rem; height: 44px;" />
                        </div>
                        <MudTextField @bind-Value="_finalInspectionDefectDesc"
                                      Label="不合格情况描述"
                                      Variant="Variant.Outlined"
                                      Style="font-size: 0.875rem; height: 44px;"
                                      Class="mt-2" />

                        @* 尺寸检验专用 *@
                        @if (_finalInspectionItem == DisplayHelper.GetInspectionItemText(InspectionItem.Dimension))
                        {
                            <MudText Typo="Typo.body2" Color="Color.Info" Class="mt-2 mb-1 font-weight-bold">尺寸偏差范围</MudText>
                            <div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 8px;">
                                <MudTextField @bind-Value="_finalInspectionOuterDiameterRange"
                                              Label="外径范围"
                                              Variant="Variant.Outlined"
                                              Style="font-size: 0.875rem; height: 44px;" />
                                <MudTextField @bind-Value="_finalInspectionWallThicknessRange"
                                              Label="壁厚范围"
                                              Variant="Variant.Outlined"
                                              Style="font-size: 0.875rem; height: 44px;" />
                                <MudTextField @bind-Value="_finalInspectionLengthAllowanceRange"
                                              Label="长度余量范围"
                                              Variant="Variant.Outlined"
                                              Style="font-size: 0.875rem; height: 44px;" />
                            </div>
                        }

                        @* 水压/水下气压专用 *@
                        @if (_finalInspectionItem == DisplayHelper.GetInspectionItemText(InspectionItem.HydrostaticPressure)
                            || _finalInspectionItem == DisplayHelper.GetInspectionItemText(InspectionItem.UnderwaterPneumatic))
                        {
                            <MudText Typo="Typo.body2" Color="Color.Info" Class="mt-2 mb-1 font-weight-bold">压力参数</MudText>
                            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 8px;">
                                <MudNumericField T="decimal?" Format="G29"
                                                 @bind-Value="_finalInspectionPressure"
                                                 Label="压力(Mpa)"
                                                 Variant="Variant.Outlined"
                                                 HideSpinButtons="true"
                                                 Style="font-size: 0.875rem; height: 44px;" />
                                <MudNumericField T="int?"
                                                 @bind-Value="_finalInspectionHoldTime"
                                                 Label="保压时间(s)"
                                                 Variant="Variant.Outlined"
                                                 HideSpinButtons="true"
                                                 Style="font-size: 0.875rem; height: 44px;" />
                            </div>
                        }

                        @* 涡流/超声波探伤核心参数 *@
                        @if (_finalInspectionItem == DisplayHelper.GetInspectionItemText(InspectionItem.EddyCurrent)
                            || _finalInspectionItem == DisplayHelper.GetInspectionItemText(InspectionItem.Ultrasonic))
                        {
                            <MudText Typo="Typo.body2" Color="Color.Info" Class="mt-2 mb-1 font-weight-bold">探伤参数</MudText>
                            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 8px;">
                                <MudTextField @bind-Value="_finalInspectionQualificationLevel"
                                              Label="资格等级"
                                              Variant="Variant.Outlined"
                                              Style="font-size: 0.875rem; height: 44px;" />
                                <MudTextField @bind-Value="_finalInspectionInspectionStandard"
                                              Label="检验标准"
                                              Variant="Variant.Outlined"
                                              Style="font-size: 0.875rem; height: 44px;" />
                                <MudTextField @bind-Value="_finalInspectionInspectionGrade"
                                              Label="验收等级"
                                              Variant="Variant.Outlined"
                                              Style="font-size: 0.875rem; height: 44px;" />
                                <MudTextField @bind-Value="_finalInspectionInstrumentModel"
                                              Label="仪器型号"
                                              Variant="Variant.Outlined"
                                              Style="font-size: 0.875rem; height: 44px;" />
                            </div>
                        }

                        <MudTextField @bind-Value="_finalInspectionRemark"
                                      Label="备注（可选）"
                                      Variant="Variant.Outlined"
                                      Style="font-size: 0.875rem; height: 44px;"
                                      Class="mt-2" />

                        @* 提交按钮 *@
                        <div class="d-flex mt-4" style="gap: 8px;">
                            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                                       FullWidth="true"
                                       OnClick="SubmitAndContinue"
                                       Disabled="@(_isSubmitting || string.IsNullOrWhiteSpace(_finalInspectionDate))">
                                @(_isSubmitting ? "提交中..." : "提交并继续")
                            </MudButton>
                            <MudButton Variant="Variant.Outlined" Color="Color.Secondary"
                                       OnClick="SubmitAndFinish"
                                       Disabled="@(_isSubmitting || string.IsNullOrWhiteSpace(_finalInspectionDate))">
                                提交并完成
                            </MudButton>
                        </div>
                        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-1" Style="text-align: center;">
                            "提交并继续"：提交后继续扫下一批次；"提交并完成"：提交后结束
                        </MudText>
                    </div>
                }
            }

            @* ============================================================
               完成页
               ============================================================ *@
            @if (_step == ScanStep.Done)
            {
                <div class="d-flex flex-column align-center pa-4">
                    <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Large" Color="Color.Success" Class="mb-2" Style="font-size: 64px;" />
                    <MudText Typo="Typo.h5" Class="mb-1">报工成功</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-1">
                        批次：@_submittedBatchNo
                    </MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
                        工段：@SectionDisplayHelper.GetSectionNameText(_submittedSection)
                    </MudText>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary"
                               OnClick="ResetToScanBatch"
                               Class="mb-2">
                        继续扫码
                    </MudButton>
                    <MudButton Variant="Variant.Text" Color="Color.Default"
                               OnClick="GoBack">
                        返回列表
                    </MudButton>
                </div>
            }
        </MudCardContent>
    </MudCard>
</MudContainer>

<style>
    .scan-group-selected {
        cursor: pointer;
        border: 2px solid #1976d2;
    }
    .scan-group-default {
        cursor: pointer;
        border: 1px solid #e0e0e0;
    }
</style>

@code {
    private enum ScanStep { ScanWorkstation, ScanEmployee, ScanBatch, FillForm, Done }

    private ScanStep _step = ScanStep.ScanWorkstation;
    private bool _isCameraStarted;
    private string? _manualInput;

    // ========== 持久上下文（跨批次保留） ==========
    private WorkstationDto? _workstationContext;
    private bool _hasWorkstation => _workstationContext != null;
    private List<EmployeeDto> _operators = new();
    private List<EmployeeDto> _allOperators = new();      // 操作人下拉候选（按工位工段过滤，进入工位时加载）
    private EmployeeDto? _operatorSearchValue;            // 操作人下拉当前选中（选中后立即加入并清空）

    // ========== 当前批次解析结果 ==========
    private ScanBatchResolveResultDto? _batchGroupResult;
    private List<ProcessGroupOption> _filteredGroups = new();
    private ProcessGroupOption? _selectedProcessGroup;
    private ScanResolveResultDto? _resolveResult;

    // ========== 表单字段 ==========
    private string? _selectedSection;
    private string _execDateText = DateTime.Today.ToString("yyyy-MM-dd");
    private int? _quantity;
    private decimal? _weight;
    private bool _weightAutoCalculated;  // 跟踪重量是否由系统自动计算
    private bool _sectionOutsourceSendWeightAuto;
    private bool _recoveryWeightAuto;
    private bool _unprocessedWeightAuto;
    private bool _inspectionWeightAuto;
