        _batchGroupResult = null;
        _filteredGroups.Clear();
        _selectedProcessGroup = null;
        _quantity = null;
        _weight = null;
        _weightAutoCalculated = false;
        _solutionTemperature = null;
        _soakTime = null;
        _cuttingMultiple = null;
        _finishedCutLength = null;
        _postCutQuantity = null;
        _remark = null;
        _execDateText = DateTime.Today.ToString("yyyy-MM-dd");
        _manualInput = null;
        ResetPicklingOutState();
        ResetSectionOutsourceState();
        ResetOutsourceRecoveryState();
        ResetProcessInspectionState();
        ResetFinalInspectionState();
        ResetMaterialReceiveCheckState();
        _step = ScanStep.ScanBatch;
        StateHasChanged();
    }

