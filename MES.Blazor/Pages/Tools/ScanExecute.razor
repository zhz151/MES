    // ========== 操作人下拉（MudAutocomplete，从该工段员工中过滤）==========

    /// <summary>按工位工段加载操作人候选（扫码添加员工不受工段限制，仅候选下拉过滤）</summary>
    private async Task ReloadOperatorsBySectionAsync(string? sectionName)
    {
        var secResp = await EmployeeService.GetBySectionAsync(sectionName);
        _allOperators = secResp.Success && secResp.Data != null ? secResp.Data : new();
        _operatorSearchValue = null;
        StateHasChanged();
    }

    /// <summary>按选中工序组收窄操作人候选：员工工序组空=通配；无命中保留工段候选（防阻断）；null=仅工段</summary>
    private void ApplyProcessGroupFilter(ProcessGroupOption? group)
    {
        if (string.IsNullOrWhiteSpace(group?.ProcessName)) return;
        var matched = _allOperators.Where(e => OperatorMatchHelper.MatchesProcessGroup(e, group.ProcessName)).ToList();
        if (matched.Count > 0) _allOperators = matched;
        StateHasChanged();
    }

    /// <summary>操作人下拉搜索：按姓名/工号从该工段员工中内存过滤</summary>
    private Task<IEnumerable<EmployeeDto>> SearchOperatorsAsync(string? keyword)
    {
        IEnumerable<EmployeeDto> result;
        if (string.IsNullOrWhiteSpace(keyword))
        {
            result = _allOperators;
        }
        else
        {
            var kw = keyword.Trim();
            result = _allOperators.Where(e =>
                (e.Name?.Contains(kw, StringComparison.OrdinalIgnoreCase) ?? false)
                || (e.Code?.Contains(kw, StringComparison.OrdinalIgnoreCase) ?? false));
        }
        return Task.FromResult(result.Take(50));
    }

    /// <summary>下拉选中操作人：去重加入列表并清空选中值</summary>
    private void AddOperatorFromSearch(EmployeeDto? emp)
    {
        if (emp == null) return;
        if (_operators.Any(o => o.Code == emp.Code))
        {
            Snackbar.Add($"员工 {emp.Name} 已在列表中", Severity.Normal);
        }
        else
        {
            _operators.Add(emp);
            Snackbar.Add($"已添加操作人：{emp.Name}", Severity.Success);
        }
        _operatorSearchValue = null;
        StateHasChanged();
    }

