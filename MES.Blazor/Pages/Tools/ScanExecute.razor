    // ========== 搜索委外单位（MudAutocomplete，支持手输新增）==========

    private async Task<IEnumerable<string>> SearchVendorsAsync(string? keyword)
    {
        var result = (await SectionOutsourceService.SearchVendorsAsync(keyword)) ?? new List<string>();
        // 输入的新单位名不在历史列表中时，作为首项呈现，便于新建委外单位（配合 CoerceValue 点选确认）
        if (!string.IsNullOrWhiteSpace(keyword)
            && !result.Any(v => string.Equals(v, keyword, StringComparison.OrdinalIgnoreCase)))
        {
            var list = result.ToList();
            list.Insert(0, keyword.Trim());
            return list;
        }
        return result;
    }

