@page "/mobile-report"
@using MES.Blazor.Helpers
@using MES.Core.Helpers
@using MES.Core.Enums
@using MES.Core.Constants
@using MES.Blazor.Services
@using MES.Core.DTOs.Batch
@using MES.Core.DTOs.Configuration
@using MES.Core.DTOs.Infrastructure
@using MES.Core.DTOs.Quality
@using Microsoft.AspNetCore.Authorization
@implements IDisposable
@inject ScanService ScanService
@inject WorkstationService WorkstationService
@inject EmployeeService EmployeeService
@inject FinalInspectionService FinalInspectionService
@inject ProcessInspectionService ProcessInspectionService
@inject MaterialReceiveCheckService ProductionRecordService
@inject PicklingService PicklingService
@inject SectionOutsourceService SectionOutsourceService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject IJSRuntime JS
@attribute [Authorize]

<MudContainer MaxWidth="MaxWidth.False" Class="mt-4">
    <MudCard>
        <MudCardHeader>
            <CardHeaderContent>
                <MudText Typo="Typo.h5" Class="font-weight-bold">
                    <MudIcon Icon="@Icons.Material.Filled.QrCodeScanner" Class="mr-2" Color="Color.Primary" />
                    扫码报工
                </MudText>
            </CardHeaderContent>
            <CardHeaderActions>
                <MudButton Variant="Variant.Text" Color="Color.Default" OnClick="GoBack">返回</MudButton>
            </CardHeaderActions>
        </MudCardHeader>

        <MudCardContent>
            @* ========== 工位上下文摘要栏（步骤2之后显示） ========== *@
            @if (_hasWorkstation && _step > ScanStep.ScanWorkstation)
            {
                <MudPaper Class="pa-3 mb-3 notice-card" Elevation="2">
                    <div class="d-flex align-center mb-1" style="gap: 12px;">
                        <MudIcon Icon="@Icons.Material.Filled.PrecisionManufacturing" Color="Color.Primary" Size="Size.Small" />
                        <MudText Typo="Typo.body2" Class="font-weight-bold" Color="Color.Primary">
                            @_workstationContext!.Name (@_workstationContext!.Code)
                        </MudText>
                        <MudChip Size="Size.Small" Color="Color.Primary">@SectionDisplayHelper.GetSectionNameText(_workstationContext!.SectionName)</MudChip>
                        <MudChip Size="Size.Small" Color="Color.Tertiary">@GetReportTypeText(_workstationContext!.ReportType)</MudChip>
                        <MudButton Variant="Variant.Text" Color="Color.Default" Size="Size.Small"
                                   OnClick="ClearWorkstation" Style="font-size: 0.75rem; margin-left: auto;">
                            更换
                        </MudButton>
                    </div>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                        设备：@_workstationContext!.EquipmentName
                    </MudText>
                </MudPaper>
            }

            @* ========== 操作人摘要栏（步骤3之后显示） ========== *@
            @if (_operators.Count > 0 && _step > ScanStep.ScanEmployee)
            {
                <MudPaper Class="pa-2 mb-3 bg-soft-gray" Elevation="1">
                    <div class="d-flex align-center" style="gap: 6px; flex-wrap: wrap;">
                        <MudIcon Icon="@Icons.Material.Filled.Person" Color="Color.Default" Size="Size.Small" />
                        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mr-1">操作人：</MudText>
                        @foreach (var op in _operators)
                        {
                            <MudChip Size="Size.Small" Color="Color.Default">@op.Name</MudChip>
                        }
                    </div>
                </MudPaper>
            }

            @* ============================================================
               步骤1：扫工位码
               ============================================================ *@
            @if (_step == ScanStep.ScanWorkstation)
            {
                <div class="d-flex flex-column align-center">
                    <MudText Typo="Typo.h6" Class="mb-3 font-weight-bold">
                        <MudIcon Icon="@Icons.Material.Filled.QrCode" Color="Color.Primary" Class="mr-1" />
                        步骤1：扫工位码
                    </MudText>

                    <MudText Typo="Typo.body2" Class="mb-3" Color="Color.Secondary" Style="text-align: center;">
                        请扫描工位上的二维码（如 D001）。<br />
                        工位确定后，报工类型和工段将自动匹配。
                    </MudText>

                    <MudButton Variant="Variant.Filled" Color="Color.Primary"
                               Size="Size.Large"
                               StartIcon="@Icons.Material.Filled.CameraAlt"
                               OnClick="StartCamera"
                               Disabled="@_isCameraStarted"
                               Class="mb-4 pa-4"
                               Style="font-size: 1.2rem; min-height: 52px;">
                        扫工位码
                    </MudButton>

                    @if (_isCameraStarted)
                    {
                        <div class="camera-overlay">
                            <video id="scan-video" class="camera-video"></video>
                            <canvas id="scan-canvas" style="display: none;"></canvas>
                            <div class="camera-footer">
                                <MudButton Variant="Variant.Filled" Color="Color.Error"
                                           Size="Size.Large"
                                           OnClick="StopCamera"
                                           FullWidth="true"
                                           StartIcon="@Icons.Material.Filled.Close">
                                    取消扫描
                                </MudButton>
                            </div>
                        </div>
                    }

                    <MudText Typo="Typo.body2" Class="mt-4 mb-1" Color="Color.Secondary">或手动输入工位编码</MudText>
                    <div style="width: 100%;" class="manual-input-container">
                        <MudTextField @bind-Value="_manualInput"
                                      Label="输入工位编码"
                                      Variant="Variant.Outlined"
                                      Class="mb-2"
                                      Style="font-size: 0.875rem; height: 44px;" />
                        <MudButton Variant="Variant.Outlined" Color="Color.Secondary"
                                   FullWidth="true"
                                   OnClick="ResolveWorkstationManualInput"
                                   Disabled="string.IsNullOrWhiteSpace(_manualInput)">
                            确认
                        </MudButton>
                    </div>
                </div>
            }

            @* ============================================================
               步骤2：扫员工码
               ============================================================ *@
            @if (_step == ScanStep.ScanEmployee)
            {
                <div class="d-flex flex-column">
                    <MudText Typo="Typo.h6" Class="mb-3 font-weight-bold">
                        <MudIcon Icon="@Icons.Material.Filled.Badge" Color="Color.Primary" Class="mr-1" />
                        步骤2：扫员工码
                    </MudText>

                    <MudText Typo="Typo.body2" Class="mb-2" Color="Color.Secondary">
                        操作人必选（可多人）。请从下方下拉选择，或扫描操作员工号二维码。
                    </MudText>

                    @* 已添加的员工列表 *@
                    @if (_operators.Count > 0)
                    {
                        <MudPaper Class="pa-2 mb-3" Elevation="1">
                            <MudText Typo="Typo.caption" Class="mb-1 font-weight-bold">已识别操作人：</MudText>
                            @foreach (var op in _operators)
                            {
                                <div class="d-flex align-center mb-1" style="gap: 8px;">
                                    <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Size="Size.Small" />
                                    <MudText Typo="Typo.body2" Class="flex-grow-1">@op.Name (@op.Code)</MudText>
                                    <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small"
                                                   Color="Color.Error"
                                                   OnClick="@(() => RemoveOperator(op))" />
                                </div>
                            }
                        </MudPaper>
                    }

                    @* 下拉选择操作人（按工位工段优先过滤，可搜索全量） *@
                    <MudAutocomplete T="EmployeeDto"
                                     Value="_operatorSearchValue"
                                     ValueChanged="@(EventCallback.Factory.Create<EmployeeDto?>(this, AddOperatorFromSearch))"
                                     SearchFunc="@SearchOperatorsAsync"
                                     ToStringFunc="@(e => e == null ? "" : $"{e.Name}（{e.Code}）")"
                                     Label="选择操作人"
                                     MinCharacters="0"
                                     Variant="Variant.Outlined"
                                     Class="mb-3"
                                     Style="font-size: 0.875rem;" />

                    @* 扫码/输入 *@
                    <div class="d-flex flex-column align-center">
                        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                                   Size="Size.Large"
                                   StartIcon="@Icons.Material.Filled.CameraAlt"
                                   OnClick="StartCamera"
                                   Disabled="@_isCameraStarted"
                                   Class="mb-3 pa-3"
                                   Style="font-size: 1rem; min-height: 44px;">
                            @(_isCameraStarted ? "扫描中..." : "扫员工码")
                        </MudButton>

                        @if (_isCameraStarted)
                        {
                            <div class="camera-overlay">
                                <video id="scan-video" class="camera-video"></video>
                                <canvas id="scan-canvas" style="display: none;"></canvas>
                                <div class="camera-footer">
                                    <MudButton Variant="Variant.Filled" Color="Color.Error"
                                               Size="Size.Large"
                                               OnClick="StopCamera"
                                               FullWidth="true"
                                               StartIcon="@Icons.Material.Filled.Close">
                                        取消扫描
                                    </MudButton>
                                </div>
                            </div>
                        }

                        <MudText Typo="Typo.body2" Class="mt-3 mb-1" Color="Color.Secondary">或手动输入工号</MudText>
                        <div style="width: 100%;" class="manual-input-container">
                            <MudTextField @bind-Value="_manualInput"
                                          Label="输入工号"
                                          Variant="Variant.Outlined"
                                          Class="mb-2"
                                          Style="font-size: 0.875rem; height: 44px;" />
                            <MudButton Variant="Variant.Outlined" Color="Color.Secondary"
                                       FullWidth="true"
                                       OnClick="ResolveEmployeeManualInput"
                                       Disabled="string.IsNullOrWhiteSpace(_manualInput)">
                                添加
                            </MudButton>
                        </div>
                    </div>

                    @* 操作按钮 *@
                    <div class="d-flex mt-4" style="gap: 8px;">
                        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                                   FullWidth="true"
                                   OnClick="GoToScanBatch"
                                   Disabled="@(_operators.Count == 0)">
                            下一步
                        </MudButton>
                    </div>
                </div>
            }

            @* ============================================================
               步骤3：扫批次 + 选工序组
               ============================================================ *@
            @if (_step == ScanStep.ScanBatch)
            {
                <div class="d-flex flex-column">
                    <MudText Typo="Typo.h6" Class="mb-3 font-weight-bold">
                        <MudIcon Icon="@Icons.Material.Filled.Inventory2" Color="Color.Primary" Class="mr-1" />
                        步骤3：扫批次号
                    </MudText>

                    @* 扫码/输入 *@
                    <div class="d-flex flex-column align-center">
                        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                                   Size="Size.Large"
                                   StartIcon="@Icons.Material.Filled.CameraAlt"
                                   OnClick="StartCamera"
                                   Disabled="@_isCameraStarted"
                                   Class="mb-3 pa-3"
                                   Style="font-size: 1rem; min-height: 44px;">
                            @(_isCameraStarted ? "扫描中..." : "扫批次条码")
                        </MudButton>

                        @if (_isCameraStarted)
                        {
                            <div class="camera-overlay">
                                <video id="scan-video" class="camera-video"></video>
                                <canvas id="scan-canvas" style="display: none;"></canvas>
                                <div class="camera-footer">
                                    <MudButton Variant="Variant.Filled" Color="Color.Error"
                                               Size="Size.Large"
                                               OnClick="StopCamera"
                                               FullWidth="true"
                                               StartIcon="@Icons.Material.Filled.Close">
                                        取消扫描
                                    </MudButton>
                                </div>
                            </div>
                        }

                        <MudText Typo="Typo.body2" Class="mt-3 mb-1" Color="Color.Secondary">或手动输入批次号</MudText>
                        <div style="width: 100%;" class="manual-input-container">
                            <MudTextField @bind-Value="_manualInput"
                                          Label="输入批次号（或 批次号|工序组ID）"
                                          Variant="Variant.Outlined"
                                          Class="mb-2"
                                          Style="font-size: 0.875rem; height: 44px;" />
                            <MudButton Variant="Variant.Outlined" Color="Color.Secondary"
                                       FullWidth="true"
                                       OnClick="ResolveBatchManualInput"
                                       Disabled="string.IsNullOrWhiteSpace(_manualInput)">
                                解析
                            </MudButton>
                        </div>
                    </div>

                    @* 批次信息（解析后显示） *@
                    @if (_batchGroupResult != null)
                    {
                        <MudPaper Class="pa-3 mt-3" Elevation="1">
                            <MudText Typo="Typo.subtitle2" Class="mb-2 font-weight-bold">批次信息</MudText>
                            <div style="display: grid; grid-template-columns: auto 1fr; gap: 4px 12px; font-size: 0.875rem;">
                                <MudText Typo="Typo.body2" Color="Color.Secondary">编号：</MudText>
                                <MudText Typo="Typo.body2">@_batchGroupResult.BatchNo</MudText>
                                <MudText Typo="Typo.body2" Color="Color.Secondary">状态：</MudText>
                                <MudText Typo="Typo.body2">@_batchGroupResult.StatusDisplay</MudText>
                                <MudText Typo="Typo.body2" Color="Color.Secondary">牌号：</MudText>
                                <MudText Typo="Typo.body2">@_batchGroupResult.PlantGrade</MudText>
                                <MudText Typo="Typo.body2" Color="Color.Secondary">规格：</MudText>
                                <MudText Typo="Typo.body2">@_batchGroupResult.Specification</MudText>
                                <MudText Typo="Typo.body2" Color="Color.Secondary">挂牌号：</MudText>
                                <MudText Typo="Typo.body2">@(_batchGroupResult.TagNo ?? "-")</MudText>
                            </div>
                        </MudPaper>

                        @* 工序组选择（普通报工 / 入缸 / 工段委外） *@
                        @if (_workstationContext!.ReportType is ReportTemplateType.ProductionRecord or ReportTemplateType.PicklingInRecord or ReportTemplateType.SectionOutsource or ReportTemplateType.ProcessInspection)
                        {
                            @if (_filteredGroups.Count > 1)
                            {
                                <MudText Typo="Typo.subtitle2" Class="mt-3 mb-2 font-weight-bold">
                                    选择工序组（包含@(SectionDisplayHelper.GetSectionNameText(_workstationContext?.SectionName))的工序组）
                                </MudText>
                                <div class="d-flex flex-column" style="gap: 6px;">
                                    @foreach (var g in _filteredGroups)
                                    {
                                        var isSelected = _selectedProcessGroup?.Id == g.Id;
                                        <MudPaper @onclick="@(() => SelectProcessGroup(g))"
                                                  Class="@GetGroupPaperClass(isSelected)"
                                                  Elevation="@(isSelected ? 4 : 1)">
                                            <div class="d-flex align-center" style="gap: 8px;">
                                                <MudIcon Icon="@(isSelected ? Icons.Material.Filled.RadioButtonChecked : Icons.Material.Filled.RadioButtonUnchecked)" Size="Size.Small" Color="Color.Primary" />
                                                <div>
                                                    <MudText Typo="Typo.body2" Class="font-weight-bold">
                                                        @g.SequenceNumber. @ProcessDisplayHelper.GetProcessNameText(g.ProcessName)
                                                    </MudText>
                                                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                                                        @(g.ManufacturingSpec ?? "-")
                                                    </MudText>
                                                </div>
                                            </div>
                                        </MudPaper>
                                    }
                                </div>

                                <div class="d-flex mt-3" style="gap: 8px;">
                                    <MudButton Variant="Variant.Filled" Color="Color.Primary"
                                               FullWidth="true"
                                               OnClick="ConfirmProcessGroup"
                                               Disabled="@(_selectedProcessGroup == null)">
                                        确认选择，进入填写
                                    </MudButton>
                                    <MudButton Variant="Variant.Text" Color="Color.Default"
                                               OnClick="ResetBatchScan">
                                        重新扫描
                                    </MudButton>
                                </div>
                            }
                            else if (_filteredGroups.Count == 0)
                            {
                                @* 没有匹配工段的工序组，显示全部供选择 *@
                                <MudText Typo="Typo.body2" Class="mt-3 mb-1" Color="Color.Warning">
                                    <MudIcon Icon="@Icons.Material.Filled.Warning" Size="Size.Small" />
                                    未找到包含"@(SectionDisplayHelper.GetSectionNameText(_workstationContext?.SectionName))"的工序组，请手动选择：
                                </MudText>
                                <div class="d-flex flex-column" style="gap: 6px;">
                                    @foreach (var g in _batchGroupResult.ProcessGroups)
                                    {
                                        var isSelected = _selectedProcessGroup?.Id == g.Id;
                                        <MudPaper @onclick="@(() => SelectProcessGroup(g))"
                                                  Class="@GetGroupPaperClass(isSelected)"
                                                  Elevation="@(isSelected ? 4 : 1)">
                                            <div class="d-flex align-center" style="gap: 8px;">
                                                <MudIcon Icon="@(isSelected ? Icons.Material.Filled.RadioButtonChecked : Icons.Material.Filled.RadioButtonUnchecked)" Size="Size.Small" Color="Color.Primary" />
                                                <div>
                                                    <MudText Typo="Typo.body2" Class="font-weight-bold">
                                                        @g.SequenceNumber. @ProcessDisplayHelper.GetProcessNameText(g.ProcessName)
                                                    </MudText>
                                                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                                                        @(g.ManufacturingSpec ?? "-") | @string.Join("、", g.SectionNames)
                                                    </MudText>
                                                </div>
                                            </div>
                                        </MudPaper>
                                    }
                                </div>

                                <div class="d-flex mt-3" style="gap: 8px;">
                                    <MudButton Variant="Variant.Filled" Color="Color.Primary"
                                               FullWidth="true"
                                               OnClick="ConfirmProcessGroup"
                                               Disabled="@(_selectedProcessGroup == null)">
                                        确认选择
                                    </MudButton>
                                    <MudButton Variant="Variant.Text" Color="Color.Default"
                                               OnClick="ResetBatchScan">
                                        重新扫描
                                    </MudButton>
                                </div>
                            }
                        }

                        @* 入缸记录选择（出缸报工） *@
                        @if (_workstationContext!.ReportType == ReportTemplateType.PicklingOutRecord)
                        {
                            @if (_picklingInRecords.Count > 0)
                            {
                                <MudText Typo="Typo.subtitle2" Class="mt-3 mb-2 font-weight-bold">
                                    选择要完工的出缸记录（仅显示待完工的入缸记录）
                                </MudText>
                                <div class="d-flex flex-column" style="gap: 6px;">
                                    @foreach (var rec in _picklingInRecords)
                                    {
                                        var isSelected = _selectedPicklingInRecord?.Id == rec.Id;
                                        <MudPaper @onclick="@(() => SelectPicklingInRecord(rec))"
                                                  Class="@GetGroupPaperClass(isSelected)"
                                                  Elevation="@(isSelected ? 4 : 1)">
                                            <div class="d-flex align-center" style="gap: 8px;">
                                                <MudIcon Icon="@(isSelected ? Icons.Material.Filled.RadioButtonChecked : Icons.Material.Filled.RadioButtonUnchecked)" Size="Size.Small" Color="Color.Primary" />
                                                <div>
                                                    <MudText Typo="Typo.body2" Class="font-weight-bold">
                                                        @ProcessDisplayHelper.GetProcessNameText(rec.ProcessName) — @SectionDisplayHelper.GetSectionNameText(rec.SectionName)
                                                    </MudText>
                                                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                                                        @(rec.ManufacturingSpec ?? "-") | 入缸：@rec.InDate.ToString("yyyy-MM-dd") | @(rec.Quantity?.ToString() ?? "-")支 | @(rec.Weight?.ToString("G29") ?? "-")kg
                                                    </MudText>
                                                </div>
                                            </div>
                                        </MudPaper>
                                    }
                                </div>

                                <div class="d-flex mt-3" style="gap: 8px;">
                                    <MudButton Variant="Variant.Filled" Color="Color.Primary"
                                               FullWidth="true"
                                               OnClick="ConfirmPicklingOut"
                                               Disabled="@(_selectedPicklingInRecord == null)">
                                        确认选择，进入出缸
                                    </MudButton>
                                    <MudButton Variant="Variant.Text" Color="Color.Default"
                                               OnClick="ResetBatchScan">
                                        重新扫描
                                    </MudButton>
                                </div>
                            }
                            else
                            {
                                <MudText Typo="Typo.body2" Class="mt-3" Color="Color.Warning">
                                    <MudIcon Icon="@Icons.Material.Filled.Info" Size="Size.Small" />
                                    该批次没有待完工的入缸记录，或批次不存在。
                                </MudText>
                                <MudButton Variant="Variant.Text" Color="Color.Default"
                                           OnClick="ResetBatchScan" Class="mt-2">
                                    重新扫描
                                </MudButton>
                            }
                        }
                    }

                    @* 成检到料：显示批次信息 *@
                    @if (_workstationContext!.ReportType == ReportTemplateType.MaterialReceiveCheck)
                    {
                        <div class="d-flex mt-3" style="gap: 8px;">
                            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                                       FullWidth="true"
                                       OnClick="ConfirmMaterialReceiveCheck">
                                确认到料，进入填写
                            </MudButton>
                            <MudButton Variant="Variant.Text" Color="Color.Default"
                                       OnClick="ResetBatchScan">
                                重新扫描
                            </MudButton>
                        </div>
                    }

                    @* 委外回收：选择待回收的委外记录 *@
                    @if (_workstationContext!.ReportType == ReportTemplateType.OutsourceRecovery)
                    {
                        @if (_pendingOutsourceRecords.Count > 0)
                        {
                            <MudText Typo="Typo.subtitle2" Class="mt-3 mb-2 font-weight-bold">
                                选择待回收的委外记录
                            </MudText>
                            <div class="d-flex flex-column" style="gap: 6px;">
                                @foreach (var rec in _pendingOutsourceRecords)
                                {
                                    var isSelected = _selectedOutsourceRecord?.Id == rec.Id;
                                    <MudPaper @onclick="@(() => SelectOutsourceRecord(rec))"
                                              Class="@GetGroupPaperClass(isSelected)"
                                              Elevation="@(isSelected ? 4 : 1)">
                                        <div class="d-flex align-center" style="gap: 8px;">
                                            <MudIcon Icon="@(isSelected ? Icons.Material.Filled.RadioButtonChecked : Icons.Material.Filled.RadioButtonUnchecked)" Size="Size.Small" Color="Color.Primary" />
                                            <div>
                                                <MudText Typo="Typo.body2" Class="font-weight-bold">
                                                    @rec.OutsourceVendor — @ProcessDisplayHelper.GetProcessNameText(rec.ProcessName) / @SectionDisplayHelper.GetSectionNameText(rec.SectionName)
                                                </MudText>
                                                <MudText Typo="Typo.caption" Color="Color.Secondary">
                                                    发出：@rec.SendOutDate.ToString("yyyy-MM-dd") | @(rec.SendQuantity?.ToString() ?? "-")支 / @(rec.SendWeight?.ToString("G29") ?? "-")kg
                                                    @if (rec.IsUrgent) { <MudChip Size="Size.Small" Color="Color.Error">紧急</MudChip> }
                                                </MudText>
                                            </div>
                                        </div>
                                    </MudPaper>
                                }
                            </div>

                            <div class="d-flex mt-3" style="gap: 8px;">
                                <MudButton Variant="Variant.Filled" Color="Color.Primary"
                                           FullWidth="true"
                                           OnClick="ConfirmOutsourceRecovery"
                                           Disabled="@(_selectedOutsourceRecord == null)">
                                    确认选择，进入回收
                                </MudButton>
                                <MudButton Variant="Variant.Text" Color="Color.Default"
                                           OnClick="ResetBatchScan">
                                    重新扫描
                                </MudButton>
                            </div>
                        }
                        else
                        {
                            <MudText Typo="Typo.body2" Class="mt-3" Color="Color.Warning">
                                <MudIcon Icon="@Icons.Material.Filled.Info" Size="Size.Small" />
                                该批次没有待回收的委外记录，或批次不存在。
                            </MudText>
                            <MudButton Variant="Variant.Text" Color="Color.Default"
                                       OnClick="ResetBatchScan" Class="mt-2">
                                重新扫描
                            </MudButton>
                        }
                    }
                </div>
            }

            @* ============================================================
               步骤4：填写表单 + 提交
               ============================================================ *@
            @if (_step == ScanStep.FillForm)
            {
                @* ========== 普通报工 / 入缸报工 ========== *@
                @if (_workstationContext?.ReportType is ReportTemplateType.ProductionRecord or ReportTemplateType.PicklingInRecord)
                {
                    <div class="d-flex flex-column">
                        <MudText Typo="Typo.h6" Class="mb-3 font-weight-bold">
                            <MudIcon Icon="@Icons.Material.Filled.EditNote" Color="Color.Primary" Class="mr-1" />
                            @(GetReportTypeText(_workstationContext!.ReportType)) — @(ProcessDisplayHelper.GetProcessNameText(_resolveResult?.ProcessName))
                        </MudText>

                        @* 批次摘要 *@
                        <MudPaper Class="pa-3 mb-3 bg-subtle" Elevation="1">
                            <div style="display: grid; grid-template-columns: auto 1fr; gap: 3px 12px; font-size: 0.85rem;">
                                <MudText Typo="Typo.body2" Color="Color.Secondary">批次：</MudText>
                                <MudText Typo="Typo.body2">@_resolveResult?.BatchNo</MudText>
                                <MudText Typo="Typo.body2" Color="Color.Secondary">工序：</MudText>
                                <MudText Typo="Typo.body2">@(ProcessDisplayHelper.GetProcessNameText(_resolveResult?.ProcessName))</MudText>
                                <MudText Typo="Typo.body2" Color="Color.Secondary">牌号：</MudText>
                                <MudText Typo="Typo.body2">@_resolveResult?.PlantGrade</MudText>
                                <MudText Typo="Typo.body2" Color="Color.Secondary">规格：</MudText>
                                <MudText Typo="Typo.body2">@_resolveResult?.ManufacturingSpec</MudText>
                                <MudText Typo="Typo.body2" Color="Color.Secondary">设备：</MudText>
                                <MudText Typo="Typo.body2">@(_workstationContext?.EquipmentName ?? "-")</MudText>
                                <MudText Typo="Typo.body2" Color="Color.Secondary">操作人：</MudText>
                                <MudText Typo="Typo.body2">
                                    @(string.Join("、", _operators.Select(o => $"{o.Name}({o.Code})")))
                                </MudText>
                                <MudText Typo="Typo.body2" Color="Color.Secondary">执行日期：</MudText>
                                <MudText Typo="Typo.body2">@_execDateText <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="ResetDate" Style="font-size:0.75rem;">修改</MudButton></MudText>
                            </div>
                        </MudPaper>

                        @* 表单字段 — 通用字段（班次按当前时刻自动判定，无需手工选择） *@
                        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 8px;">
                            <MudTextField @bind-Value="_execDateText"
                                          Label="执行日期"
                                          Placeholder="yyyy-MM-dd"
                                          Variant="Variant.Outlined"
                                          Style="font-size: 0.875rem; height: 44px;" />
                            <MudTextField Value="@($"班次：{DisplayHelper.GetShiftTypeText(ShiftHelper.GetShiftByTime())}（自动判定）")"
                                          Label="班次"
                                          ReadOnly="true"
                                          Variant="Variant.Outlined"
                                          Style="font-size: 0.875rem; height: 44px;" />
                        </div>

                        @* 加工支数 + 重量 *@
                        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 8px;" class="mt-2">
                            <MudNumericField T="int?"
                                             Value="@_quantity"
                                             ValueChanged="@(EventCallback.Factory.Create<int?>(this, v => OnQuantityChanged(v)))"
                                             Label="加工支数"
                                             Variant="Variant.Outlined"
                                             HideSpinButtons="true"
                                             Style="font-size: 0.875rem; height: 44px;" />
                            <MudNumericField T="decimal?" Format="G29"
                                             Value="@_weight"
                                             ValueChanged="@(EventCallback.Factory.Create<decimal?>(this, v => OnWeightChanged(v)))"
                                             Label="加工重量(kg)"
                                             Variant="Variant.Outlined"
                                             HideSpinButtons="true"
                                             Style="font-size: 0.875rem; height: 44px;" />
                        </div>
                        @if (_resolveResult?.UnitWeight > 0 && _weightAutoCalculated)
                        {
                            <MudText Typo="Typo.caption" Color="Color.Info" Class="mt-1">
                                自动算重：@_quantity 支 × @_resolveResult.UnitWeight kg/支 = @_weight kg（可手动修正）
                            </MudText>
                        }

                        @* ========== 固溶专用字段（仅普通报工） ========== *@
                        @if (_workstationContext!.ReportType == ReportTemplateType.ProductionRecord && _selectedSection == SectionKeys.Solution)
                        {
                            <MudText Typo="Typo.body2" Color="Color.Info" Class="mt-3 mb-1 font-weight-bold">固溶参数</MudText>
                            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 8px;">
                                <MudNumericField T="decimal?" Format="G29"
                                                 @bind-Value="_solutionTemperature"
                                                 Label="固溶温度(℃)"
                                                 Variant="Variant.Outlined"
                                                 HideSpinButtons="true"
                                                 Style="font-size: 0.875rem; height: 44px;" />
                                <MudNumericField T="int?"
                                                 @bind-Value="_soakTime"
                                                 Label="保温时间(min)"
                                                 Variant="Variant.Outlined"
                                                 HideSpinButtons="true"
                                                 Style="font-size: 0.875rem; height: 44px;" />
                            </div>
                        }

                        @* ========== 断切专用字段（仅普通报工） ========== *@
                        @if (_workstationContext!.ReportType == ReportTemplateType.ProductionRecord && _selectedSection == SectionKeys.Cut)
                        {
                            <MudText Typo="Typo.body2" Color="Color.Info" Class="mt-3 mb-1 font-weight-bold">断切参数</MudText>
                            <div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 8px;">
                                <MudNumericField T="decimal?" Format="G29"
                                                 @bind-Value="_cuttingMultiple"
                                                 Label="断切倍数"
                                                 Variant="Variant.Outlined"
                                                 HideSpinButtons="true"
                                                 Style="font-size: 0.875rem; height: 44px;" />
                                <MudNumericField T="decimal?" Format="G29"
                                                 @bind-Value="_finishedCutLength"
                                                 Label="成品长度(mm)"
                                                 Variant="Variant.Outlined"
                                                 HideSpinButtons="true"
                                                 Style="font-size: 0.875rem; height: 44px;" />
                                <MudNumericField T="int?"
                                                 @bind-Value="_postCutQuantity"
                                                 Label="切后支数"
                                                 Variant="Variant.Outlined"
                                                 HideSpinButtons="true"
                                                 Style="font-size: 0.875rem; height: 44px;" />
                            </div>
                        }

                        <MudTextField @bind-Value="_remark"
                                      Label="备注（可选）"
                                      Variant="Variant.Outlined"
                                      Style="font-size: 0.875rem; height: 44px;"
                                      Class="mt-2" />

                        @* 提交按钮 *@
                        <div class="d-flex mt-4" style="gap: 8px;">
                            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                                       FullWidth="true"
                                       OnClick="SubmitAndContinue"
                                       Disabled="@(_isSubmitting || _quantity == null)">
                                @(_isSubmitting ? "提交中..." : "提交并继续")
                            </MudButton>
                            <MudButton Variant="Variant.Outlined" Color="Color.Secondary"
                                       OnClick="SubmitAndFinish"
                                       Disabled="@(_isSubmitting || _quantity == null)">
                                提交并完成
                            </MudButton>
                        </div>
                        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-1" Style="text-align: center;">
                            "提交并继续"：提交后继续扫下一批次；"提交并完成"：提交后结束
                        </MudText>
                    </div>
                }

                @* ========== 出缸报工 ========== *@
                @if (_workstationContext?.ReportType == ReportTemplateType.PicklingOutRecord && _selectedPicklingInRecord != null)
                {
                    <div class="d-flex flex-column">
                        <MudText Typo="Typo.h6" Class="mb-3 font-weight-bold">
                            <MudIcon Icon="@Icons.Material.Filled.Output" Color="Color.Primary" Class="mr-1" />
                            出缸完工 — @ProcessDisplayHelper.GetProcessNameText(_selectedPicklingInRecord.ProcessName) / @SectionDisplayHelper.GetSectionNameText(_selectedPicklingInRecord.SectionName)
                        </MudText>

                        @* 入缸记录摘要 *@
                        <MudPaper Class="pa-3 mb-3 bg-subtle" Elevation="1">
                            <div style="display: grid; grid-template-columns: auto 1fr; gap: 3px 12px; font-size: 0.85rem;">
                                <MudText Typo="Typo.body2" Color="Color.Secondary">批次：</MudText>
                                <MudText Typo="Typo.body2">@_selectedPicklingInRecord.BatchNo</MudText>
                                <MudText Typo="Typo.body2" Color="Color.Secondary">工序：</MudText>
                                <MudText Typo="Typo.body2">@ProcessDisplayHelper.GetProcessNameText(_selectedPicklingInRecord.ProcessName) — @SectionDisplayHelper.GetSectionNameText(_selectedPicklingInRecord.SectionName)</MudText>
                                <MudText Typo="Typo.body2" Color="Color.Secondary">牌号：</MudText>
                                <MudText Typo="Typo.body2">@(_selectedPicklingInRecord.PlantGrade ?? "-")</MudText>
                                <MudText Typo="Typo.body2" Color="Color.Secondary">规格：</MudText>
                                <MudText Typo="Typo.body2">@(_selectedPicklingInRecord.ManufacturingSpec ?? "-")</MudText>
                                <MudText Typo="Typo.body2" Color="Color.Secondary">入缸日期：</MudText>
                                <MudText Typo="Typo.body2">@_selectedPicklingInRecord.InDate.ToString("yyyy-MM-dd")</MudText>
                                <MudText Typo="Typo.body2" Color="Color.Secondary">入缸数量：</MudText>
                                <MudText Typo="Typo.body2">@(_selectedPicklingInRecord.Quantity?.ToString() ?? "-") 支 / @(_selectedPicklingInRecord.Weight?.ToString("G29") ?? "-") kg</MudText>
                                <MudText Typo="Typo.body2" Color="Color.Secondary">设备：</MudText>
                                <MudText Typo="Typo.body2">@(_workstationContext?.EquipmentName ?? "-")</MudText>
                                <MudText Typo="Typo.body2" Color="Color.Secondary">操作人：</MudText>
                                <MudText Typo="Typo.body2">
                                    @(string.Join("、", _operators.Select(o => $"{o.Name}({o.Code})")))
                                </MudText>
                            </div>
                        </MudPaper>

                        @* 出缸字段 *@
                        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 8px;">
                            <MudTextField @bind-Value="_picklingOutCompleteDate"
                                          Label="完工日期"
                                          Placeholder="yyyy-MM-dd"
                                          Variant="Variant.Outlined"
                                          Style="font-size: 0.875rem; height: 44px;" />
                        </div>

                        <MudTextField @bind-Value="_picklingOutRemark"
                                      Label="备注（可选）"
                                      Variant="Variant.Outlined"
                                      Style="font-size: 0.875rem; height: 44px;"
                                      Class="mt-2" />

                        @* 提交按钮 *@
                        <div class="d-flex mt-4" style="gap: 8px;">
                            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                                       FullWidth="true"
                                       OnClick="SubmitAndContinue"
                                       Disabled="@(_isSubmitting || string.IsNullOrWhiteSpace(_picklingOutCompleteDate))">
                                @(_isSubmitting ? "提交中..." : "提交并继续")
                            </MudButton>
                            <MudButton Variant="Variant.Outlined" Color="Color.Secondary"
                                       OnClick="SubmitAndFinish"
                                       Disabled="@(_isSubmitting || string.IsNullOrWhiteSpace(_picklingOutCompleteDate))">
                                提交并完成
                            </MudButton>
                        </div>
                    </div>
                }

                @* ========== 工段委外发出表单 ========== *@
                @if (_workstationContext?.ReportType == ReportTemplateType.SectionOutsource && _resolveResult != null)
                {
                    <div class="d-flex flex-column">
                        <MudText Typo="Typo.h6" Class="mb-3 font-weight-bold">
                            <MudIcon Icon="@Icons.Material.Filled.Output" Color="Color.Primary" Class="mr-1" />
                            工段委外 — @ProcessDisplayHelper.GetProcessNameText(_resolveResult.ProcessName) / @SectionDisplayHelper.GetSectionNameText(_workstationContext!.SectionName)
                        </MudText>

                        @* 批次摘要 *@
                        <MudPaper Class="pa-3 mb-3 bg-subtle" Elevation="1">
                            <div style="display: grid; grid-template-columns: auto 1fr; gap: 3px 12px; font-size: 0.85rem;">
                                <MudText Typo="Typo.body2" Color="Color.Secondary">批次：</MudText>
                                <MudText Typo="Typo.body2">@_resolveResult.BatchNo</MudText>
                                <MudText Typo="Typo.body2" Color="Color.Secondary">工序：</MudText>
                                <MudText Typo="Typo.body2">@(ProcessDisplayHelper.GetProcessNameText(_resolveResult.ProcessName))</MudText>
                                <MudText Typo="Typo.body2" Color="Color.Secondary">工段：</MudText>
                                <MudText Typo="Typo.body2">@SectionDisplayHelper.GetSectionNameText(_workstationContext!.SectionName)</MudText>
                                <MudText Typo="Typo.body2" Color="Color.Secondary">牌号：</MudText>
                                <MudText Typo="Typo.body2">@_resolveResult.PlantGrade</MudText>
                                <MudText Typo="Typo.body2" Color="Color.Secondary">规格：</MudText>
                                <MudText Typo="Typo.body2">@_resolveResult.ManufacturingSpec</MudText>
                            </div>
                        </MudPaper>

                        @* 委外表单字段（委外单位 Autocomplete：历史 Distinct + 手输新增） *@
                        <MudAutocomplete T="string"
                                         Value="@_sectionOutsourceVendor"
                                         ValueChanged="@(EventCallback.Factory.Create<string?>(this, v => _sectionOutsourceVendor = v))"
                                         SearchFunc="@SearchVendorsAsync"
                                         MinCharacters="1"
                                         CoerceValue="true"
                                         Label="委外单位 *"
                                         Variant="Variant.Outlined"
                                         Style="font-size: 0.875rem; height: 44px;" />

                        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 8px;" class="mt-2">
                            <MudTextField @bind-Value="_sectionOutsourceSendOutDate"
                                          Label="发出日期"
                                          Placeholder="yyyy-MM-dd"
                                          Variant="Variant.Outlined"
                                          Style="font-size: 0.875rem; height: 44px;" />
                            <MudTextField @bind-Value="_sectionOutsourceExpectedReturnDate"
                                          Label="要求收回日期"
                                          Placeholder="yyyy-MM-dd"
                                          Variant="Variant.Outlined"
                                          Style="font-size: 0.875rem; height: 44px;" />
                        </div>

                        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 8px;" class="mt-2">
                            <MudNumericField T="int?"
                                             Value="@_sectionOutsourceSendQuantity"
                                             ValueChanged="@(EventCallback.Factory.Create<int?>(this, OnSectionOutsourceSendQuantityChanged))"
                                             Label="发出支数"
                                             Variant="Variant.Outlined"
                                             HideSpinButtons="true"
                                             Style="font-size: 0.875rem; height: 44px;" />
                            <MudNumericField T="decimal?" Format="G29"
                                             Value="@_sectionOutsourceSendWeight"
                                             ValueChanged="@(EventCallback.Factory.Create<decimal?>(this, OnSectionOutsourceSendWeightChanged))"
                                             Label="发出重量(kg)"
                                             Variant="Variant.Outlined"
                                             HideSpinButtons="true"
                                             Style="font-size: 0.875rem; height: 44px;" />
                        </div>
                        @if (_resolveResult?.UnitWeight > 0 && _sectionOutsourceSendWeightAuto)
                        {
                            <MudText Typo="Typo.caption" Color="Color.Info" Class="mt-1">
                                自动算重：@_sectionOutsourceSendQuantity 支 × @_resolveResult.UnitWeight kg/支 = @_sectionOutsourceSendWeight kg（可手动修正）
                            </MudText>
                        }

                        <MudTextField @bind-Value="_sectionOutsourceSpec"
                                      Label="委外规格"
                                      Variant="Variant.Outlined"
                                      Style="font-size: 0.875rem; height: 44px;"
                                      Class="mt-2" />

                        <div class="mt-2">
                            <MudCheckBox @bind-Value="_sectionOutsourceIsUrgent"
                                         Label="是否紧急"
                                         Color="Color.Primary" />
                        </div>

                        <MudTextField @bind-Value="_sectionOutsourceRemark"
                                      Label="备注（可选）"
                                      Variant="Variant.Outlined"
                                      Style="font-size: 0.875rem; height: 44px;"
                                      Class="mt-2" />

                        @* 提交按钮 *@
                        <div class="d-flex mt-4" style="gap: 8px;">
                            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                                       FullWidth="true"
                                       OnClick="SubmitAndContinue"
                                       Disabled="@(_isSubmitting || string.IsNullOrWhiteSpace(_sectionOutsourceVendor))">
                                @(_isSubmitting ? "提交中..." : "提交并继续")
                            </MudButton>
                            <MudButton Variant="Variant.Outlined" Color="Color.Secondary"
                                       OnClick="SubmitAndFinish"
                                       Disabled="@(_isSubmitting || string.IsNullOrWhiteSpace(_sectionOutsourceVendor))">
                                提交并完成
                            </MudButton>
                        </div>
                        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-1" Style="text-align: center;">
                            "提交并继续"：提交后继续扫下一批次；"提交并完成"：提交后结束
                        </MudText>
                    </div>
