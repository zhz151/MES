@page "/mobile-report"
@using MES.Blazor.Helpers
@using MES.Core.DTOs
@using MES.Core.Enums
@using MES.Blazor.Services
@using Microsoft.AspNetCore.Authorization
@implements IDisposable
@inject ScanService ScanService
@inject FinalInspectionService FinalInspectionService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject IJSRuntime JS
@attribute [Authorize(Roles = Roles.Policies.BatchRead)]

<MudContainer MaxWidth="MaxWidth.False" Class="mt-4">
    <MudCard>
        <MudCardHeader>
            <CardHeaderContent>
                <MudText Typo="Typo.h5" Class="font-weight-bold">
                    <MudIcon Icon="@Icons.Material.Filled.QrCodeScanner" Class="mr-2" Color="Color.Primary" />
                    扫码报工
                </MudText>
            </CardHeaderContent>
            <CardHeaderActions>
                <MudButton Variant="Variant.Text" Color="Color.Default" OnClick="GoBack">返回</MudButton>
            </CardHeaderActions>
        </MudCardHeader>

        <MudCardContent>
            @if (_step == ScanStep.Scan)
            {
                @* 模式选择 *@
                <div class="d-flex mb-4" style="gap: 8px; justify-content: center;">
                    <MudButton Variant="@(_mode == ScanMode.Production ? Variant.Filled : Variant.Outlined)"
                               Color="Color.Primary"
                               Size="Size.Small"
                               OnClick="@(() => { _mode = ScanMode.Production; StateHasChanged(); })"
                               Style="flex: 1; max-width: 120px; font-size: 0.875rem; height: 36px;">
                        报工
                    </MudButton>
                    <MudButton Variant="@(_mode == ScanMode.ProcessInspection ? Variant.Filled : Variant.Outlined)"
                               Color="Color.Primary"
                               Size="Size.Small"
                               OnClick="@(() => { _mode = ScanMode.ProcessInspection; StateHasChanged(); })"
                               Style="flex: 1; max-width: 120px; font-size: 0.875rem; height: 36px;">
                        过程检验
                    </MudButton>
                    <MudButton Variant="@(_mode == ScanMode.FinalInspection ? Variant.Filled : Variant.Outlined)"
                               Color="Color.Primary"
                               Size="Size.Small"
                               OnClick="@(() => { _mode = ScanMode.FinalInspection; StateHasChanged(); })"
                               Style="flex: 1; max-width: 120px; font-size: 0.875rem; height: 36px;">
                        成品检验
                    </MudButton>
                </div>

                @* 扫描步骤 *@
                <div class="d-flex flex-column align-center">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary"
                               Size="Size.Large"
                               StartIcon="@Icons.Material.Filled.CameraAlt"
                               OnClick="StartCamera"
                               Disabled="@_isCameraStarted"
                               Class="mb-4 pa-4"
                               Style="font-size: 1.1rem;">
                        @(_isCameraStarted ? "扫描中..." : "扫描二维码")
                    </MudButton>

                    @if (_isCameraStarted)
                    {
                        <div style="position: relative; width: 100%; max-width: 480px;">
                            <video id="scan-video"
                                   style="width: 100%; border: 2px solid #ccc; border-radius: 8px; background: #000;"></video>
                            <canvas id="scan-canvas" style="display: none;"></canvas>
                            <MudButton Variant="Variant.Outlined" Color="Color.Error"
                                       Size="Size.Small"
                                       OnClick="StopCamera"
                                       Class="mt-2"
                                       FullWidth="true">
                                取消扫描
                            </MudButton>
                        </div>
                    }

                    <MudText Typo="Typo.body2" Class="mt-4 mb-1" Color="Color.Secondary">或手动输入</MudText>
                    <div style="width: 100%; max-width: 480px;">
                        <MudTextField @bind-Value="_manualInput"
                                      Label="输入批次号（或 批次号|工序组ID）"
                                      Variant="Variant.Outlined"
                                      Class="mb-2"
                                      Style="font-size: 0.875rem; height: 32px;" />
                        <MudButton Variant="Variant.Outlined" Color="Color.Secondary"
                                   FullWidth="true"
                                   OnClick="ResolveManualInput"
                                   Disabled="string.IsNullOrWhiteSpace(_manualInput)">
                            解析
                        </MudButton>
                    </div>

                </div>
            }

            @if (_step == ScanStep.SelectGroup)
            {
                @* 选择工序组 *@
                <MudText Typo="Typo.h6" Class="mb-2 font-weight-bold">
                    <MudIcon Icon="@Icons.Material.Filled.Info" Color="Color.Info" Class="mr-1" />
                    批次信息
                </MudText>

                <MudTable Items="@_batchInfoItems" Dense="true" Hover="true" Elevation="0" Class="auto-table mb-4">
                    <HeaderContent>
                        <MudTh>字段</MudTh>
                        <MudTh>值</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="字段">@context.Label</MudTd>
                        <MudTd DataLabel="值">@context.Value</MudTd>
                    </RowTemplate>
                </MudTable>

                <MudText Typo="Typo.h6" Class="mb-2 font-weight-bold">选择工序组</MudText>

                <MudSelect @bind-Value="_selectedProcessGroup"
                           Label="请选择工序组"
                           Variant="Variant.Outlined"
                           Class="mb-2"
                           Style="font-size: 0.875rem; height: 32px;"
                           AnchorOrigin="Origin.BottomCenter"
                           ToStringFunc="@((ProcessGroupOption? g) => g == null ? "" : $"{g.SequenceNumber}. {g.ProcessName} ({g.ManufacturingSpec ?? "-"})")">
                    @foreach (var g in _batchGroupResult?.ProcessGroups ?? new())
                    {
                        <MudSelectItem Value="@g">
                            @g.SequenceNumber. @g.ProcessName
                            @if (!string.IsNullOrEmpty(g.ManufacturingSpec))
                            {
                                <span class="text-muted">(@g.ManufacturingSpec)</span>
                            }
                        </MudSelectItem>
                    }
                </MudSelect>

                <div class="d-flex mt-4" style="gap: 8px;">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary"
                               FullWidth="true"
                               OnClick="SelectProcessGroupAndPreview"
                               Disabled="@(_selectedProcessGroup == null)">
                        下一步
                    </MudButton>
                    <MudButton Variant="Variant.Outlined" Color="Color.Default"
                               OnClick="ResetToScan">
                        重新扫描
                    </MudButton>
                </div>
            }

            @if (_step == ScanStep.Preview)
            {
                @* 批次信息预览 + 工段选择 *@
                <MudText Typo="Typo.h6" Class="mb-2 font-weight-bold">
                    <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Class="mr-1" />
                    批次信息
                </MudText>

                <MudTable Items="@_batchInfoItems" Dense="true" Hover="true" Elevation="0" Class="auto-table mb-4">
                    <HeaderContent>
                        <MudTh>字段</MudTh>
                        <MudTh>值</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="字段">@context.Label</MudTd>
                        <MudTd DataLabel="值">@context.Value</MudTd>
                    </RowTemplate>
                </MudTable>

                <MudText Typo="Typo.h6" Class="mb-2 font-weight-bold">
                    @switch (_mode)
                    {
                        case ScanMode.FinalInspection:
                            <text>成品检验信息</text>
                            break;
                        case ScanMode.ProcessInspection:
                            <text>过程检验信息</text>
                            break;
                        default:
                            <text>报工信息</text>
                            break;
                    }
                </MudText>

                @if (!_isFinalInspection)
                {
                    <MudSelect @bind-Value="_selectedSection"
                               Label="选择工段"
                               Variant="Variant.Outlined"
                               Class="mb-2"
                               Style="font-size: 0.875rem; height: 32px;"
                               For="@(() => _selectedSection)">
                        @foreach (var sec in _resolveResult?.AvailableSections ?? new())
                        {
                            <MudSelectItem Value="@(sec.SectionName)">@sec.SectionName</MudSelectItem>
                        }
                    </MudSelect>
                }
                else
                {
                    @* 成品检验：选择检验项目 *@
                    <MudSelect @bind-Value="_finalInspectionItem"
                               Label="检验项目"
                               Variant="Variant.Outlined"
                               Class="mb-2"
                               Style="font-size: 0.875rem; height: 32px;"
                               AnchorOrigin="Origin.BottomCenter">
                        @foreach (InspectionItem item in Enum.GetValues<InspectionItem>())
                        {
                            <MudSelectItem Value="@item">@GetInspectionItemText(item)</MudSelectItem>
                        }
                    </MudSelect>
                }

                @if (_mode == ScanMode.ProcessInspection)
                {
                    @* === 过程检验表单 === *@
                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 8px;">
                        <MudTextField @bind-Value="_execDateText"
                                      Label="检验日期"
                                      Placeholder="yyyy-MM-dd"
                                      Variant="Variant.Outlined"
                                      Style="font-size: 0.875rem; height: 32px;" />
                        <MudSelect @bind-Value="_shift"
                                   Label="班次"
                                   Variant="Variant.Outlined"
                                   Style="font-size: 0.875rem; height: 32px;">
                            <MudSelectItem Value="@("白班")">白班</MudSelectItem>
                            <MudSelectItem Value="@("中班")">中班</MudSelectItem>
                            <MudSelectItem Value="@("夜班")">夜班</MudSelectItem>
                        </MudSelect>
                    </div>
                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 8px;" class="mt-2">
                        <MudTextField @bind-Value="_inspector"
                                      Label="检验员"
                                      Variant="Variant.Outlined"
                                      Style="font-size: 0.875rem; height: 32px;" />
                        <MudTextField @bind-Value="_equipmentName"
                                      Label="设备名称"
                                      Variant="Variant.Outlined"
                                      Style="font-size: 0.875rem; height: 32px;" />
                    </div>
                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 8px;" class="mt-2">
                        <MudNumericField T="int?"
                                         @bind-Value="_quantity"
                                         Label="检验数量"
                                         Variant="Variant.Outlined"
                                         HideSpinButtons="true"
                                         Style="font-size: 0.875rem; height: 32px;" />
                        <MudNumericField T="decimal?" Format="G29"
                                         @bind-Value="_weight"
                                         Label="检验重量(kg)"
                                         Variant="Variant.Outlined"
                                         HideSpinButtons="true"
                                         Style="font-size: 0.875rem; height: 32px;" />
                    </div>
                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 8px;" class="mt-2">
                        <MudTextField @bind-Value="_inspectionItem"
                                      Label="检验项目"
                                      Variant="Variant.Outlined"
                                      Style="font-size: 0.875rem; height: 32px;" />
                        <MudTextField @bind-Value="_sourceUnit"
                                      Label="来料单位"
                                      Variant="Variant.Outlined"
                                      Style="font-size: 0.875rem; height: 32px;" />
                    </div>
                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 8px;" class="mt-2">
                        <MudNumericField T="int?"
                                         @bind-Value="_qualifiedQuantity"
                                         Label="合格支数"
                                         Variant="Variant.Outlined"
                                         HideSpinButtons="true"
                                         Style="font-size: 0.875rem; height: 32px;" />
                        <MudNumericField T="decimal?" Format="G29"
                                         @bind-Value="_qualifiedWeight"
                                         Label="合格重量(kg)"
                                         Variant="Variant.Outlined"
                                         HideSpinButtons="true"
                                         Style="font-size: 0.875rem; height: 32px;" />
                    </div>
                    <div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 8px;" class="mt-2">
                        <MudNumericField T="int?"
                                         @bind-Value="_defectReworkQuantity"
                                         Label="返整支数"
                                         Variant="Variant.Outlined"
                                         HideSpinButtons="true"
                                         Style="font-size: 0.875rem; height: 32px;" />
                        <MudNumericField T="int?"
                                         @bind-Value="_defectWarehouseQuantity"
                                         Label="入库支数"
                                         Variant="Variant.Outlined"
                                         HideSpinButtons="true"
                                         Style="font-size: 0.875rem; height: 32px;" />
                        <MudNumericField T="int?"
                                         @bind-Value="_defectScrapQuantity"
                                         Label="报废支数"
                                         Variant="Variant.Outlined"
                                         HideSpinButtons="true"
                                         Style="font-size: 0.875rem; height: 32px;" />
                    </div>
                    <MudTextField @bind-Value="_defectDescription"
                                  Label="不合格情况描述"
                                  Variant="Variant.Outlined"
                                  Style="font-size: 0.875rem; height: 32px;"
                                  Class="mt-2" />
                    <MudTextField @bind-Value="_remark"
                                  Label="备注"
                                  Variant="Variant.Outlined"
                                  Style="font-size: 0.875rem; height: 32px;"
                                  Class="mt-2" />
                }
                else if (_mode == ScanMode.Production)
                {
                    @* === 报工表单 === *@
                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 8px;">
                        <MudTextField @bind-Value="_execDateText"
                                      Label="执行日期"
                                      Placeholder="yyyy-MM-dd"
                                      Variant="Variant.Outlined"
                                      Style="font-size: 0.875rem; height: 32px;" />
                        <MudSelect @bind-Value="_shift"
                                   Label="班次"
                                   Variant="Variant.Outlined"
                                   Style="font-size: 0.875rem; height: 32px;">
                            <MudSelectItem Value="@("白班")">白班</MudSelectItem>
                            <MudSelectItem Value="@("中班")">中班</MudSelectItem>
                            <MudSelectItem Value="@("夜班")">夜班</MudSelectItem>
                        </MudSelect>
                    </div>
                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 8px;" class="mt-2">
                        <MudTextField @bind-Value="_operator"
                                      Label="操作工（工号）"
                                      Variant="Variant.Outlined"
                                      Style="font-size: 0.875rem; height: 32px;" />
                        <MudTextField @bind-Value="_equipmentName"
                                      Label="设备名称"
                                      Variant="Variant.Outlined"
                                      Style="font-size: 0.875rem; height: 32px;" />
                    </div>
                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 8px;" class="mt-2">
                        <MudNumericField T="int?"
                                         @bind-Value="_quantity"
                                         Label="生产支数"
                                         Variant="Variant.Outlined"
                                         HideSpinButtons="true"
                                         Style="font-size: 0.875rem; height: 32px;" />
                        <MudNumericField T="decimal?" Format="G29"
                                         @bind-Value="_weight"
                                         Label="重量(kg)"
                                         Variant="Variant.Outlined"
                                         HideSpinButtons="true"
                                         Style="font-size: 0.875rem; height: 32px;" />
                    </div>
                    <MudTextField @bind-Value="_remark"
                                  Label="备注"
                                  Variant="Variant.Outlined"
                                  Style="font-size: 0.875rem; height: 32px;"
                                  Class="mt-2" />
                }
                else if (_mode == ScanMode.FinalInspection)
                {
                    @* === 成品检验表单 === *@
                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 8px;">
                        <MudTextField @bind-Value="_execDateText"
                                      Label="检验日期"
                                      Placeholder="yyyy-MM-dd"
                                      Variant="Variant.Outlined"
                                      Style="font-size: 0.875rem; height: 32px;" />
                        <MudSelect @bind-Value="_shift"
                                   Label="班次"
                                   Variant="Variant.Outlined"
                                   Style="font-size: 0.875rem; height: 32px;">
                            <MudSelectItem Value="@("白班")">白班</MudSelectItem>
                            <MudSelectItem Value="@("中班")">中班</MudSelectItem>
                            <MudSelectItem Value="@("夜班")">夜班</MudSelectItem>
                        </MudSelect>
                    </div>
                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 8px;" class="mt-2">
                        <MudTextField @bind-Value="_finalInspector"
                                      Label="检验员"
                                      Variant="Variant.Outlined"
                                      Style="font-size: 0.875rem; height: 32px;" />
                        <MudTextField @bind-Value="_equipmentName"
                                      Label="设备名称"
                                      Variant="Variant.Outlined"
                                      Style="font-size: 0.875rem; height: 32px;" />
                    </div>
                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 8px;" class="mt-2">
                        <MudNumericField T="int?"
                                         @bind-Value="_quantity"
                                         Label="检验支数"
                                         Variant="Variant.Outlined"
                                         HideSpinButtons="true"
                                         Style="font-size: 0.875rem; height: 32px;" />
                        <MudNumericField T="decimal?" Format="G29"
                                         @bind-Value="_weight"
                                         Label="检验重量(kg)"
                                         Variant="Variant.Outlined"
                                         HideSpinButtons="true"
                                         Style="font-size: 0.875rem; height: 32px;" />
                    </div>
                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 8px;" class="mt-2">
                        <MudNumericField T="int?"
                                         @bind-Value="_qualifiedQuantity"
                                         Label="合格支数"
                                         Variant="Variant.Outlined"
                                         HideSpinButtons="true"
                                         Style="font-size: 0.875rem; height: 32px;" />
                        <MudNumericField T="decimal?" Format="G29"
                                         @bind-Value="_qualifiedWeight"
                                         Label="合格重量(kg)"
                                         Variant="Variant.Outlined"
                                         HideSpinButtons="true"
                                         Style="font-size: 0.875rem; height: 32px;" />
                    </div>
                    <div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 8px;" class="mt-2">
                        <MudNumericField T="int?"
                                         @bind-Value="_defectReworkQuantity"
                                         Label="返整支数"
                                         Variant="Variant.Outlined"
                                         HideSpinButtons="true"
                                         Style="font-size: 0.875rem; height: 32px;" />
                        <MudNumericField T="int?"
                                         @bind-Value="_defectWarehouseQuantity"
                                         Label="入库支数"
                                         Variant="Variant.Outlined"
                                         HideSpinButtons="true"
                                         Style="font-size: 0.875rem; height: 32px;" />
                        <MudNumericField T="int?"
                                         @bind-Value="_defectScrapQuantity"
                                         Label="报废支数"
                                         Variant="Variant.Outlined"
                                         HideSpinButtons="true"
                                         Style="font-size: 0.875rem; height: 32px;" />
                    </div>
                    <MudTextField @bind-Value="_defectDescription"
                                  Label="不合格情况描述"
                                  Variant="Variant.Outlined"
                                  Style="font-size: 0.875rem; height: 32px;"
                                  Class="mt-2" />

                    @* 尺寸检验专用字段 *@
                    @if (_finalInspectionItem == InspectionItem.Dimension)
                    {
                        <MudText Typo="Typo.body2" Color="Color.Info" Class="mt-3 mb-1 font-weight-bold">尺寸检验</MudText>
                        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 8px;">
                            <MudTextField @bind-Value="_finalOuterDiameterRange"
                                          Label="外径范围"
                                          Variant="Variant.Outlined"
                                          Style="font-size: 0.875rem; height: 32px;" />
                            <MudTextField @bind-Value="_finalWallThicknessRange"
                                          Label="壁厚范围"
                                          Variant="Variant.Outlined"
                                          Style="font-size: 0.875rem; height: 32px;" />
                        </div>
                        <MudTextField @bind-Value="_finalLengthAllowanceRange"
                                      Label="长度余量范围"
                                      Variant="Variant.Outlined"
                                      Style="font-size: 0.875rem; height: 32px;"
                                      Class="mt-2" />
                    }

                    @* 水压/水下气压专用字段 *@
                    @if (_finalInspectionItem == InspectionItem.HydrostaticPressure
                        || _finalInspectionItem == InspectionItem.UnderwaterPneumatic)
                    {
                        <MudText Typo="Typo.body2" Color="Color.Info" Class="mt-3 mb-1 font-weight-bold">
                            @DisplayHelper.GetInspectionItemText(_finalInspectionItem!.Value)
                        </MudText>
                        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 8px;">
                            <MudNumericField T="decimal?" Format="G29"
                                             @bind-Value="_finalPressure"
                                             Label="压力(Mpa)"
                                             Variant="Variant.Outlined"
                                             HideSpinButtons="true"
                                             Style="font-size: 0.875rem; height: 32px;" />
                            <MudNumericField T="int?"
                                             @bind-Value="_finalHoldTime"
                                             Label="保压时间(s)"
                                             Variant="Variant.Outlined"
                                             HideSpinButtons="true"
                                             Style="font-size: 0.875rem; height: 32px;" />
                        </div>
                    }

                    <MudTextField @bind-Value="_remark"
                                  Label="备注"
                                  Variant="Variant.Outlined"
                                  Style="font-size: 0.875rem; height: 32px;"
                                  Class="mt-2" />
                }

                <div class="d-flex mt-4" style="gap: 8px;">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary"
                               FullWidth="true"
                               OnClick="@GetSubmitHandler()"
                               Disabled="@_isSubmitDisabled">
                        @(_isSubmitting ? "提交中..." : GetSubmitButtonText())
                    </MudButton>
                    <MudButton Variant="Variant.Outlined" Color="Color.Default"
                               OnClick="ResetToScan">
                        重新扫描
                    </MudButton>
                </div>
            }

            @if (_step == ScanStep.Done)
            {
                @* 提交成功 *@
                <div class="d-flex flex-column align-center pa-4">
                    <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Large" Color="Color.Success" Class="mb-2" Style="font-size: 64px;" />
                    <MudText Typo="Typo.h5" Class="mb-1">
                        @switch (_submittedMode)
                        {
                            case ScanMode.FinalInspection:
                                <text>成品检验成功</text>
                                break;
                            case ScanMode.ProcessInspection:
                                <text>过程检验成功</text>
                                break;
                            default:
                                <text>报工成功</text>
                                break;
                        }
                    </MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
                        批次：@_batchGroupResult?.BatchNo
                        @if (!string.IsNullOrEmpty(_submittedSection))
                        {
                            <text> | 工段：@_submittedSection</text>
                        }
                        @if (_submittedMode == ScanMode.FinalInspection && _finalInspectionItem != null)
                        {
                            <text> | 检验项目：@GetInspectionItemText(_finalInspectionItem.Value)</text>
                        }
                    </MudText>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary"
                               OnClick="ResetToScan">
                        继续扫码
                    </MudButton>
                </div>
            }
        </MudCardContent>
    </MudCard>
</MudContainer>

@code {
    private enum ScanStep { Scan, SelectGroup, Preview, Done }
    private enum ScanMode { Production, ProcessInspection, FinalInspection }

    private ScanStep _step = ScanStep.Scan;
    private ScanMode _mode = ScanMode.Production;
    private bool _isCameraStarted;
    private string? _manualInput;
    private ScanResolveResultDto? _resolveResult;
    private ScanBatchResolveResultDto? _batchGroupResult;
    private ProcessGroupOption? _selectedProcessGroup;
    private List<(string Label, string Value)> _batchInfoItems = new();

    // 报工字段
    private string? _selectedSection;
    private string? _execDateText = DateTime.Today.ToString("yyyy-MM-dd");
    private string? _shift = "白班";
    private string? _operator;
    private string? _equipmentName;
    private int? _quantity;
    private decimal? _weight;
    private string? _remark;
    private bool _isSubmitting;
    private string? _submittedSection;
    private ScanMode _submittedMode;

    // 检验专用字段（过程检验）
    private string? _inspector;
    private string? _inspectionItem;
    private int? _qualifiedQuantity;
    private decimal? _qualifiedWeight;
    private int? _defectReworkQuantity;
    private int? _defectWarehouseQuantity;
    private int? _defectScrapQuantity;
    private string? _defectDescription;
    private string? _sourceUnit;

    // 成品检验字段
    private InspectionItem? _finalInspectionItem;
    private string? _finalInspector;
    private string? _finalOuterDiameterRange;
    private string? _finalWallThicknessRange;
    private string? _finalLengthAllowanceRange;
    private decimal? _finalPressure;
    private int? _finalHoldTime;

    private bool _isFinalInspection => _mode == ScanMode.FinalInspection;
    private bool _isSubmitDisabled => _isSubmitting || (_isFinalInspection ? _finalInspectionItem == null : string.IsNullOrWhiteSpace(_selectedSection));

    private DotNetObjectReference<ScanExecute>? _dotNetRef;

    protected override void OnInitialized()
    {
        _dotNetRef = DotNetObjectReference.Create(this);
    }

    private void GoBack()
    {
        Navigation.NavigateTo("/batches");
    }

    public void Dispose()
    {
        _ = StopCamera();
        _dotNetRef?.Dispose();
    }

    // ========== 摄像头扫描 ==========

    private async Task StartCamera()
    {
        try
        {
            _isCameraStarted = true;
            StateHasChanged();

            // 给 DOM 渲染时间
            await Task.Delay(100);

            var result = await JS.InvokeAsync<ScanResult>("window.startScanner",
                "scan-video", "scan-canvas", _dotNetRef, "OnQrCodeDetected");

            if (!result.Success)
            {
                Snackbar.Add(result.Error ?? "启动摄像头失败", Severity.Error);
                _isCameraStarted = false;
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"摄像头错误：{ex.Message}", Severity.Error);
            _isCameraStarted = false;
            StateHasChanged();
        }
    }

    [JSInvokable]
    public async Task OnQrCodeDetected(string data)
    {
        // 支持两种格式：
        //   1. 批次号|工序组ID  （如 BATCH-001|5，直接到报工/过程检验步骤）
        //   2. 纯批次号          （如 BATCH-001，先选工序组，或成品检验直接到表单）
        try
        {
            var parts = data.Split('|');
            if (parts.Length == 1)
            {
                // 纯批次号 — 成品检验直接到表单，其他先选工序组
                if (_mode == ScanMode.FinalInspection)
                {
                    await ResolveForFinalInspection(parts[0]);
                }
                else
                {
                    await ResolveByBatchOnly(parts[0]);
                }
            }
            else if (parts.Length >= 2 && int.TryParse(parts[1], out var groupId))
            {
                await ResolveAndPreview(parts[0], groupId);
            }
            else
            {
                Snackbar.Add("无效的二维码格式", Severity.Error);
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"解析失败：{ex.Message}", Severity.Error);
            StateHasChanged();
        }
    }

    private async Task StopCamera()
    {
        try
        {
            await JS.InvokeVoidAsync("window.stopScanner");
        }
        catch { }
        _isCameraStarted = false;
    }

    // ========== 手动输入 ==========

    private async Task ResolveManualInput()
    {
        if (string.IsNullOrWhiteSpace(_manualInput)) return;

        var input = _manualInput!.Trim();
        var parts = input.Split('|');

        if (parts.Length == 1)
        {
            if (_mode == ScanMode.FinalInspection)
            {
                await ResolveForFinalInspection(parts[0]);
            }
            else
            {
                await ResolveByBatchOnly(parts[0]);
            }
        }
        else if (parts.Length >= 2 && int.TryParse(parts[1], out var groupId))
        {
            await ResolveAndPreview(parts[0], groupId);
        }
        else
        {
            Snackbar.Add("输入格式无效，请输入批次号 或 批次号|工序组ID", Severity.Error);
        }
    }

    // ========== 解析与预览 ==========

    private async Task ResolveByBatchOnly(string batchNo)
    {
        var response = await ScanService.GetBatchProcessGroupsAsync(batchNo);
        if (!response.Success)
        {
            Snackbar.Add(response.Message ?? "解析失败", Severity.Error);
            StateHasChanged();
            return;
        }

        _batchGroupResult = response.Data;
        _selectedProcessGroup = null;

        _batchInfoItems = new List<(string, string)>
        {
            ("生产编号", _batchGroupResult.BatchNo),
            ("状态", _batchGroupResult.Status),
            ("工厂牌号", _batchGroupResult.PlantGrade),
            ("规格", _batchGroupResult.Specification),
            ("挂牌号", _batchGroupResult.TagNo ?? "-"),
            ("生产类型", _batchGroupResult.ProductionType ?? "-"),
        };

        _step = ScanStep.SelectGroup;
        await StopCamera();
        StateHasChanged();
    }

    private async Task ResolveForFinalInspection(string batchNo)
    {
        var response = await ScanService.GetBatchProcessGroupsAsync(batchNo);
        if (!response.Success)
        {
            Snackbar.Add(response.Message ?? "解析失败", Severity.Error);
            StateHasChanged();
            return;
        }

        _batchGroupResult = response.Data;

        _batchInfoItems = new List<(string, string)>
        {
            ("生产编号", _batchGroupResult.BatchNo),
            ("状态", _batchGroupResult.Status),
            ("工厂牌号", _batchGroupResult.PlantGrade),
            ("规格", _batchGroupResult.Specification),
            ("挂牌号", _batchGroupResult.TagNo ?? "-"),
            ("生产类型", _batchGroupResult.ProductionType ?? "-"),
        };

        // 重置成品检验字段
        ResetFinalInspectionFields();

        _step = ScanStep.Preview;
        await StopCamera();
        StateHasChanged();
    }

    private async Task SelectProcessGroupAndPreview()
    {
        if (_selectedProcessGroup == null || _batchGroupResult == null) return;

        await ResolveAndPreview(_batchGroupResult.BatchNo, _selectedProcessGroup.Id);
    }

    private async Task ResolveAndPreview(string batchNo, int processGroupId)
    {
        var response = await ScanService.ResolveAsync(batchNo, processGroupId);
        if (!response.Success)
        {
            Snackbar.Add(response.Message ?? "解析失败", Severity.Error);
            StateHasChanged();
            return;
        }

        _resolveResult = response.Data;
        _batchInfoItems = new List<(string, string)>
        {
            ("生产编号", _resolveResult.BatchNo),
            ("状态", _resolveResult.Status),
            ("工厂牌号", _resolveResult.PlantGrade),
            ("规格", _resolveResult.Specification),
            ("挂牌号", _resolveResult.TagNo ?? "-"),
            ("生产类型", _resolveResult.ProductionType ?? "-"),
            ("工序", _resolveResult.ProcessName),
            ("制造规格", _resolveResult.ManufacturingSpec ?? "-"),
        };

        // 重置报工字段
        _selectedSection = null;
        _execDateText = DateTime.Today.ToString("yyyy-MM-dd");
        _shift = "白班";
        _operator = null;
        _equipmentName = null;
        _quantity = null;
        _weight = null;
        _remark = null;
        _inspector = null;
        _inspectionItem = null;
        _qualifiedQuantity = null;
        _qualifiedWeight = null;
        _defectReworkQuantity = null;
        _defectWarehouseQuantity = null;
        _defectScrapQuantity = null;
        _defectDescription = null;
        _sourceUnit = null;
        ResetFinalInspectionFields();

        _step = ScanStep.Preview;
        await StopCamera();
        StateHasChanged();
    }

    // ========== 辅助方法 ==========

    private static string GetInspectionItemText(InspectionItem item) => DisplayHelper.GetInspectionItemText(item);

    private Func<Task> GetSubmitHandler() => _mode switch
    {
        ScanMode.FinalInspection => SubmitFinalInspectionReport,
        ScanMode.ProcessInspection => SubmitInspectionReport,
        _ => SubmitReport
    };

    private string GetSubmitButtonText() => _mode switch
    {
        ScanMode.FinalInspection => "提交成品检验",
        ScanMode.ProcessInspection => "提交检验",
        _ => "提交报工"
    };

    private void ResetFinalInspectionFields()
    {
        _finalInspectionItem = null;
        _finalInspector = null;
        _finalOuterDiameterRange = null;
        _finalWallThicknessRange = null;
        _finalLengthAllowanceRange = null;
        _finalPressure = null;
        _finalHoldTime = null;
        _selectedSection = null;
        _execDateText = DateTime.Today.ToString("yyyy-MM-dd");
        _shift = "白班";
        _equipmentName = null;
        _quantity = null;
        _weight = null;
        _remark = null;
        _qualifiedQuantity = null;
        _qualifiedWeight = null;
        _defectReworkQuantity = null;
        _defectWarehouseQuantity = null;
        _defectScrapQuantity = null;
        _defectDescription = null;
    }

    // ========== 提交报工 ==========

    private async Task SubmitReport()
    {
        if (string.IsNullOrWhiteSpace(_selectedSection) || _resolveResult == null)
            return;

        _isSubmitting = true;
        StateHasChanged();

        try
        {
            var section = _resolveResult.AvailableSections
                .FirstOrDefault(s => s.SectionName == _selectedSection);

            var request = new CreateProductionRecordRequest
            {
                BatchNo = _resolveResult.BatchNo,
                ProductionBatchId = 0, // 服务端自动解析
                ProcessGroupId = _resolveResult.ProcessGroupId,
                ProcessName = _resolveResult.ProcessName,
                ManufacturingSpec = _resolveResult.ManufacturingSpec ?? "",
                SectionName = _selectedSection,
                SequenceNumber = section?.SequenceNumber ?? 0,
                ExecDate = DateTime.TryParse(_execDateText, out var execDate) ? execDate : DateTime.Today,
                EquipmentName = _equipmentName,
                Operator = _operator,
                Shift = _shift,
                Quantity = _quantity,
                Weight = _weight,
                Remark = _remark,
                DataSource = "SCAN"
            };

            var response = await ScanService.CreateProductionRecordAsync(request);
            if (response.Success)
            {
                _submittedMode = ScanMode.Production;
                _submittedSection = _selectedSection;
                _step = ScanStep.Done;
                Snackbar.Add("报工提交成功", Severity.Success);
            }
            else
            {
                Snackbar.Add(response.Message ?? "提交失败", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"提交失败：{ex.Message}", Severity.Error);
        }
        finally
        {
            _isSubmitting = false;
            StateHasChanged();
        }
    }

    // ========== 提交检验 ==========

    private async Task SubmitInspectionReport()
    {
        if (string.IsNullOrWhiteSpace(_selectedSection) || _resolveResult == null)
            return;

        _isSubmitting = true;
        StateHasChanged();

        try
        {
            var section = _resolveResult.AvailableSections
                .FirstOrDefault(s => s.SectionName == _selectedSection);

            var request = new CreateProcessInspectionRequest
            {
                BatchNo = _resolveResult.BatchNo,
                ProductionBatchId = 0,
                ProcessGroupId = _resolveResult.ProcessGroupId,
                ProcessName = _resolveResult.ProcessName,
                ManufacturingSpec = _resolveResult.ManufacturingSpec ?? "",
                SectionName = _selectedSection,
                SequenceNumber = section?.SequenceNumber ?? 0,
                InspectionDate = DateTime.TryParse(_execDateText, out var execDate) ? execDate : DateTime.Today,
                EquipmentName = _equipmentName,
                Inspector = _inspector,
                Shift = _shift,
                Quantity = _quantity,
                Weight = _weight,
                InspectionItem = _inspectionItem,
                QualifiedQuantity = _qualifiedQuantity,
                QualifiedWeight = _qualifiedWeight,
                DefectReworkQuantity = _defectReworkQuantity,
                DefectWarehouseQuantity = _defectWarehouseQuantity,
                DefectScrapQuantity = _defectScrapQuantity,
                DefectDescription = _defectDescription,
