                                          Style="font-size: 0.875rem; height: 44px;" />
                        </div>

                        <MudText Typo="Typo.body2" Color="Color.Error" Class="mt-2 mb-1 font-weight-bold">不合格</MudText>
                        <div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 8px;">
                            <MudNumericField T="int?"
                                             @bind-Value="_inspectionReworkQty"
                                             Label="返整支数"
                                             Variant="Variant.Outlined"
                                             HideSpinButtons="true"
                                             Style="font-size: 0.875rem; height: 44px;" />
                            <MudNumericField T="int?"
                                             @bind-Value="_inspectionWarehouseQty"
                                             Label="入库支数"
                                             Variant="Variant.Outlined"
                                             HideSpinButtons="true"
                                             Style="font-size: 0.875rem; height: 44px;" />
                            <MudNumericField T="int?"
                                             @bind-Value="_inspectionScrapQty"
                                             Label="报废支数"
                                             Variant="Variant.Outlined"
                                             HideSpinButtons="true"
                                             Style="font-size: 0.875rem; height: 44px;" />
                        </div>
                        <MudTextField @bind-Value="_inspectionDefectDesc"
                                      Label="不合格情况描述"
                                      Variant="Variant.Outlined"
                                      Style="font-size: 0.875rem; height: 44px;"
                                      Class="mt-2" />

                        <MudTextField @bind-Value="_inspectionRemark"
                                      Label="备注（可选）"
                                      Variant="Variant.Outlined"
                                      Style="font-size: 0.875rem; height: 44px;"
                                      Class="mt-2" />

                        @* 提交按钮 *@
                        <div class="d-flex mt-4" style="gap: 8px;">
                            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                                       FullWidth="true"
                                       OnClick="SubmitAndContinue"
                                       Disabled="@(_isSubmitting)">
                                @(_isSubmitting ? "提交中..." : "提交并继续")
                            </MudButton>
                            <MudButton Variant="Variant.Outlined" Color="Color.Secondary"
                                       OnClick="SubmitAndFinish"
                                       Disabled="@(_isSubmitting)">
