                            "提交并继续"：提交后继续扫下一批次；"提交并完成"：提交后结束
                        </MudText>
                    </div>
                }

                @* ========== 出缸报工 ========== *@
                @if (_workstationContext?.ReportType == "PicklingOutRecord" && _selectedPicklingInRecord != null)
                {
                    <div class="d-flex flex-column">
                        <MudText Typo="Typo.h6" Class="mb-3 font-weight-bold">
