                                <MudText Typo="Typo.body2" Color="Color.Secondary">批次：</MudText>
                                <MudText Typo="Typo.body2">@_batchGroupResult.BatchNo</MudText>
                                <MudText Typo="Typo.body2" Color="Color.Secondary">牌号：</MudText>
                                <MudText Typo="Typo.body2">@(_batchLookupResult?.PlantGrade ?? _batchGroupResult.PlantGrade)</MudText>
                                <MudText Typo="Typo.body2" Color="Color.Secondary">规格：</MudText>
                                <MudText Typo="Typo.body2">@(_batchLookupResult?.Specification ?? _batchGroupResult.Specification)</MudText>
                                <MudText Typo="Typo.body2" Color="Color.Secondary">检验项目：</MudText>
                                <MudText Typo="Typo.body2"><MudChip Size="Size.Small" Color="Color.Primary">@_finalInspectionItem</MudChip></MudText>
