                                {
                                    <MudText Typo="Typo.body2" Color="Color.Secondary">工单号：</MudText>
                                    <MudText Typo="Typo.body2">@_batchLookupResult.WorkOrderNo</MudText>
                                }
                                @if (_batchLookupResult?.SalesOrderNo != null)
                                {
                                    <MudText Typo="Typo.body2" Color="Color.Secondary">订单号：</MudText>
                                    <MudText Typo="Typo.body2">@_batchLookupResult.SalesOrderNo</MudText>
                                }
                                <MudText Typo="Typo.body2" Color="Color.Secondary">操作人：</MudText>
                                <MudText Typo="Typo.body2">
                                    @(string.Join("、", _operators.Select(o => $"{o.Name}({o.Code})")))
                                </MudText>
                            </div>
                        </MudPaper>

                        @* 表单字段 *@
                        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 8px;">
                            <MudTextField @bind-Value="_finalInspectionDate"
                                          Label="检验日期"
                                          Placeholder="yyyy-MM-dd"
                                          Variant="Variant.Outlined"
                                          Style="font-size: 0.875rem; height: 44px;" />
                            <MudSelect @bind-Value="_shift"
                                       Label="班次"
                                       Variant="Variant.Outlined"
                                       Style="font-size: 0.875rem; height: 44px;">
                                <MudSelectItem Value="@("白班")">白班</MudSelectItem>
                                <MudSelectItem Value="@("中班")">中班</MudSelectItem>
                                <MudSelectItem Value="@("夜班")">夜班</MudSelectItem>
                            </MudSelect>
