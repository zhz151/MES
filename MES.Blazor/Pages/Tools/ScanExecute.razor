    // ========== 提交成品检验 ==========

    private async Task SubmitFinalInspectionReport()
    {
        if (_batchGroupResult == null || _finalInspectionItem == null)
            return;

        _isSubmitting = true;
        StateHasChanged();

        try
        {
            var request = new CreateFinalInspectionRequest
            {
                InspectionItem = _finalInspectionItem.Value,
                InspectionDate = DateTime.TryParse(_execDateText, out var execDate) ? execDate : DateTime.Today,
                BatchNo = _batchGroupResult.BatchNo,
                MaterialName = null,  // 服务端自动填充
                TagNo = _batchGroupResult.TagNo,
                EquipmentName = _equipmentName,
                Shift = _shift,
                Operator = _finalInspector,
                Quantity = _quantity,
                Weight = _weight,
                QualifiedQuantity = _qualifiedQuantity,
                QualifiedWeight = _qualifiedWeight,
                DefectReworkQuantity = _defectReworkQuantity,
                DefectWarehouseQuantity = _defectWarehouseQuantity,
                DefectScrapQuantity = _defectScrapQuantity,
                DefectDescription = _defectDescription,
                OuterDiameterRange = _finalOuterDiameterRange,
                WallThicknessRange = _finalWallThicknessRange,
                LengthAllowanceRange = _finalLengthAllowanceRange,
                Pressure = _finalPressure,
                HoldTime = _finalHoldTime,
                Remark = _remark,
                DataSource = "SCAN"
            };

            var response = await FinalInspectionService.BatchCreateAsync(new List<CreateFinalInspectionRequest> { request });
            if (response.Success)
            {
                _submittedMode = ScanMode.FinalInspection;
                _step = ScanStep.Done;
                Snackbar.Add("成品检验提交成功", Severity.Success);
            }
            else
            {
                Snackbar.Add(response.Message ?? "提交失败", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"提交失败：{ex.Message}", Severity.Error);
        }
        finally
        {
            _isSubmitting = false;
            StateHasChanged();
        }
    }

    // ========== 重置 ==========

    private async Task ResetToScan()
    {
        _step = ScanStep.Scan;
        _resolveResult = null;
        _batchGroupResult = null;
        _selectedProcessGroup = null;
        _batchInfoItems.Clear();
        _manualInput = null;
        _selectedSection = null;
        _inspector = null;
        _inspectionItem = null;
        _qualifiedQuantity = null;
        _qualifiedWeight = null;
        _defectReworkQuantity = null;
        _defectWarehouseQuantity = null;
        _defectScrapQuantity = null;
        _defectDescription = null;
        _sourceUnit = null;
        _finalInspectionItem = null;
        _finalInspector = null;
        _finalOuterDiameterRange = null;
        _finalWallThicknessRange = null;
        _finalLengthAllowanceRange = null;
        _finalPressure = null;
        _finalHoldTime = null;
        await StopCamera();
        StateHasChanged();
    }

