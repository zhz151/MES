                                             Variant="Variant.Outlined"
                                             HideSpinButtons="true"
                                             Style="font-size: 0.875rem; height: 44px;" />
                            <MudNumericField T="decimal?" Format="G29"
                                             Value="@_weight"
                                             ValueChanged="@(EventCallback.Factory.Create<decimal?>(this, v => OnWeightChanged(v)))"
                                             Label="加工重量(kg)"
                                             Variant="Variant.Outlined"
                                             HideSpinButtons="true"
                                             Style="font-size: 0.875rem; height: 44px;" />
                        </div>
                        @if (_resolveResult?.UnitWeight > 0 && _weightAutoCalculated)
                        {
                            <MudText Typo="Typo.caption" Color="Color.Info" Class="mt-1">
                                自动算重：@_quantity 支 × @_resolveResult.UnitWeight kg/支 = @_weight kg（可手动修正）
                            </MudText>
                        }

                        @* 是否成品 *@
                        <div class="mt-2">
                            <MudCheckBox @bind-Value="_isFinished"
                                         Label="@($"是否成品（系统自动{( _resolveResult?.IsFinished == true ? "判定为是" : "判定为否")}，可手动修正）")"
                                         Color="Color.Primary" />
                        </div>

                        @* ========== 固溶专用字段（仅普通报工） ========== *@
                        @if (_workstationContext!.ReportType == "ProductionRecord" && _selectedSection == SectionDefs.Solution)
                        {
                            <MudText Typo="Typo.body2" Color="Color.Info" Class="mt-3 mb-1 font-weight-bold">固溶参数</MudText>
                            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 8px;">
                                <MudNumericField T="decimal?" Format="G29"
                                                 @bind-Value="_solutionTemperature"
                                                 Label="固溶温度(℃)"
                                                 Variant="Variant.Outlined"
                                                 HideSpinButtons="true"
                                                 Style="font-size: 0.875rem; height: 44px;" />
                                <MudNumericField T="int?"
                                                 @bind-Value="_soakTime"
                                                 Label="保温时间(min)"
                                                 Variant="Variant.Outlined"
                                                 HideSpinButtons="true"
                                                 Style="font-size: 0.875rem; height: 44px;" />
                            </div>
                        }

                        @* ========== 断切专用字段（仅普通报工） ========== *@
                        @if (_workstationContext!.ReportType == "ProductionRecord" && _selectedSection == SectionDefs.Cut)
