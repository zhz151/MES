                                          Variant="Variant.Outlined"
                                          Style="font-size: 0.875rem; height: 44px;" />
                            <MudSelect @bind-Value="_shift"
                                       Label="班次"
                                       Variant="Variant.Outlined"
                                       Style="font-size: 0.875rem; height: 44px;">
                                <MudSelectItem Value="@("白班")">白班</MudSelectItem>
                                <MudSelectItem Value="@("中班")">中班</MudSelectItem>
                                <MudSelectItem Value="@("夜班")">夜班</MudSelectItem>
                            </MudSelect>
                        </div>

                        <MudTextField @bind-Value="_materialChecker"
                                      Label="检验员"
                                      Variant="Variant.Outlined"
                                      Style="font-size: 0.875rem; height: 44px;"
                                      Class="mt-2" />

                        <MudTextField @bind-Value="_materialRemark"
                                      Label="备注（可选）"
                                      Variant="Variant.Outlined"
                                      Style="font-size: 0.875rem; height: 44px;"
                                      Class="mt-2" />

