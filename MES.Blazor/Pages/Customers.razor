@page "/customers"
@using MES.Blazor.Services
@using MES.Core.DTOs
@using MES.Core.Models
@using MES.Core.Enums
@using Microsoft.AspNetCore.Authorization
@using MES.Blazor.Shared
@inject CustomerService CustomerService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject IJSRuntime JS
@attribute [Authorize(Roles = "OrderStaff,OrderDirector,Admin")]

<div class="mt-4">
    <MudCard>
        <MudCardHeader>
            <CardHeaderContent>
                <MudText Typo="Typo.h5" Class="font-weight-bold">
                    <MudIcon Icon="@Icons.Material.Filled.Business" Class="mr-2" Color="Color.Primary" />
                    客户管理
                </MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">客户档案信息</MudText>
            </CardHeaderContent>
            <CardHeaderActions>
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Add"
                           OnClick="NavigateToCreate">
                    新建客户
                </MudButton>
            </CardHeaderActions>
        </MudCardHeader>

        <MudCardContent>
            <!-- 搜索栏 -->
            <MudGrid>
                <MudItem xs="12" md="12">
                    <MudTextField T="string"
                                  Label="模糊搜索 - 客户编码/单位/业务员/最终客户/状态"
                                  Placeholder="输入关键字..."
                                  Value="searchKeyword"
                                  ValueChanged="@OnSearchChanged"
                                  Immediate="true"
                                  DebounceInterval="500"
                                  Clearable="true"
                                  ClearButton="true"
                                  Adornment="Adornment.End"
                                  AdornmentIcon="@Icons.Material.Filled.Search" />
                </MudItem>
            </MudGrid>

            <!-- 数据表格 -->
            <MudTable @ref="table"
                      T="CustomerProfileDto"
                      ServerData="OnServerData"
                      Loading="@isLoading"
                      Dense="true"
                      Hover="true"
                      Class="mt-4"
                      Elevation="0"
                      RowsPerPageLabel="每页行数:">
                <ToolBarContent>
                    <MudButton Variant="Variant.Outlined"
                               Size="Size.Small"
                               Color="Color.Info"
                               StartIcon="@Icons.Material.Filled.Print"
                               Disabled="@(!selectedIds.Any())"
                               OnClick="PrintSelected">
                        打印选中 (@selectedIds.Count)
                    </MudButton>
                    <MudButton Variant="Variant.Text"
                               Size="Size.Small"
                               Color="Color.Info"
                               StartIcon="@Icons.Material.Filled.Print"
                               OnClick="PrintAll">
                        打印全部
                    </MudButton>
                    <MudText Typo="Typo.body2" Class="ml-auto">
                        共 @totalCount 条记录
                    </MudText>
                </ToolBarContent>
                <HeaderContent>
                    <MudTh Style="width: 40px;">
                        <MudCheckBox T="bool" @bind-Value="allSelected" Dense="true" />
                    </MudTh>
                    <MudTh>
                        <span @onclick='() => ToggleSort("customercode")' class="sortable-header">
                            客户编码
                            @if (sortColumn == "customercode")
                            {
                                <span class="sort-arrow">@GetSortIndicator("customercode")</span>
                            }
                        </span>
                    </MudTh>
                    <MudTh>
                        <span @onclick='() => ToggleSort("salesman")' class="sortable-header">
                            业务员
                            @if (sortColumn == "salesman")
                            {
                                <span class="sort-arrow">@GetSortIndicator("salesman")</span>
                            }
                        </span>
                    </MudTh>
                    <MudTh>
                        <span @onclick='() => ToggleSort("customerunit")' class="sortable-header">
                            客户单位
                            @if (sortColumn == "customerunit")
                            {
                                <span class="sort-arrow">@GetSortIndicator("customerunit")</span>
                            }
                        </span>
                    </MudTh>
                    <MudTh>
                        <span @onclick='() => ToggleSort("endcustomer")' class="sortable-header">
                            最终客户
                            @if (sortColumn == "endcustomer")
                            {
                                <span class="sort-arrow">@GetSortIndicator("endcustomer")</span>
                            }
                        </span>
                    </MudTh>
                    <MudTh>
                        <span @onclick='() => ToggleSort("status")' class="sortable-header">
                            状态
                            @if (sortColumn == "status")
                            {
                                <span class="sort-arrow">@GetSortIndicator("status")</span>
                            }
                        </span>
                    </MudTh>
                    <MudTh>操作</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd Style="width: 40px;">
                        <MudCheckBox T="bool"
                                     Value="@selectedIds.Contains(context.Id)"
                                     ValueChanged="@((v) => { if(v) selectedIds.Add(context.Id); else selectedIds.Remove(context.Id); _allSelected = customers.Any() && customers.All(i => selectedIds.Contains(i.Id)); StateHasChanged(); })"
                                     Dense="true" />
                    </MudTd>
                    <MudTd title="@context.CustomerCode">
                        <MudLink Typo="Typo.body2" OnClick="() => ViewCustomer(context.Id)">@context.CustomerCode</MudLink>
                    </MudTd>
                    <MudTd title="@context.Salesman">@context.Salesman</MudTd>
                    <MudTd title="@context.CustomerUnit">@context.CustomerUnit</MudTd>
                    <MudTd title="@context.EndCustomer">@context.EndCustomer</MudTd>
                    <MudTd>
                        <MudChip Size="Size.Small" Color="@(context.Status == CustomerStatus.Active ? Color.Success : Color.Error)">
                            @(context.Status == CustomerStatus.Active ? "启用" : "停用")
                        </MudChip>
                    </MudTd>
                    <MudTd>
                        <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                       Color="Color.Warning"
                                       Size="Size.Small"
                                       OnClick="() => EditCustomer(context.Id)" />
                        <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                       Color="Color.Error"
                                       Size="Size.Small"
                                       OnClick="() => DeleteCustomer(context)" />
                    </MudTd>
                </RowTemplate>
                <PagerContent>
                    <MudTablePager />
                </PagerContent>
            </MudTable>
        </MudCardContent>
    </MudCard>
</div>

@code {
    private MudTable<CustomerProfileDto>? table;
    private List<CustomerProfileDto> customers = new();
    private HashSet<int> selectedIds = new();
    private bool _allSelected;
    private bool allSelected
    {
        get => _allSelected;
        set
        {
            if (_allSelected == value) return;
            _allSelected = value;
            if (value)
            {
                foreach (var item in customers)
                    selectedIds.Add(item.Id);
            }
            else
            {
                selectedIds.Clear();
            }
            StateHasChanged();
        }
    }
    private bool isLoading = false;
    private string searchKeyword = string.Empty;
    private int totalCount = 0;

    private string sortColumn = "customercode";
    private bool sortDescending = false;

    private string GetSortIndicator(string column)
    {
        if (sortColumn != column) return "";
        return sortDescending ? "\u25BC" : "\u25B2";
    }

    private async Task<TableData<CustomerProfileDto>> OnServerData(TableState state)
    {
        isLoading = true;
        StateHasChanged();

        try
        {
            var queryParams = new QueryParams
            {
                PageIndex = state.Page + 1,
                PageSize = state.PageSize,
                Keyword = string.IsNullOrWhiteSpace(searchKeyword) ? null : searchKeyword,
                SortBy = sortColumn,
                IsDescending = sortDescending
            };

            var result = await CustomerService.GetPagedAsync(queryParams);

            if (result.Success && result.Data != null)
            {
                customers = result.Data.Items;
                totalCount = result.Data.TotalCount;
                return new TableData<CustomerProfileDto>
                {
                    Items = customers,
                    TotalItems = totalCount
                };
            }

            return new TableData<CustomerProfileDto>
            {
                Items = new List<CustomerProfileDto>(),
                TotalItems = 0
            };
        }
        catch (Exception ex)
        {
            Console.WriteLine($"加载失败: {ex.Message}");
            Snackbar.Add($"加载失败: {ex.Message}", Severity.Error);
            return new TableData<CustomerProfileDto>
            {
                Items = new List<CustomerProfileDto>(),
                TotalItems = 0
            };
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task ToggleSort(string column)
    {
        if (sortColumn == column)
            sortDescending = !sortDescending;
        else
        {
            sortColumn = column;
            sortDescending = false;
        }
        if (table != null)
            await table.ReloadServerData();
    }

    private async Task Search()
    {
        if (table != null)
        {
            await table.ReloadServerData();
        }
    }

    private async Task OnSearchChanged(string value)
    {
        searchKeyword = value ?? string.Empty;
        if (table != null)
            await table.ReloadServerData();
    }

    private void NavigateToCreate() => Navigation.NavigateTo("/customers/create");
    private void ViewCustomer(int id) => Navigation.NavigateTo($"/customers/{id}");
    private void EditCustomer(int id) => Navigation.NavigateTo($"/customers/{id}/edit");

    private async Task DeleteCustomer(CustomerProfileDto customer)
    {
        var dialog = DialogService.Show<ConfirmDialog>("确认", new DialogParameters
        {
            ["ContentText"] = $"确定要删除客户 \"{customer.CustomerUnit}\" 吗？\n\n删除后数据将不可恢复！",
            ["ConfirmText"] = "确认删除",
            ["Color"] = Color.Error
        });
        var dialogResult = await dialog.Result;
        if (!dialogResult.Canceled)
        {
            try
            {
                var result = await CustomerService.DeleteAsync(customer.Id);
                if (result.Success)
                {
                    Snackbar.Add("删除成功", Severity.Success);
                    await Search();
                }
                else
                {
                    Snackbar.Add(result.Message ?? "删除失败", Severity.Error);
                }
            }
            catch (Exception ex)
            {
                Snackbar.Add($"删除失败: {ex.Message}", Severity.Error);
            }
        }
    }

    // ========== 打印方法 ==========

    private async Task PrintSelected()
    {
        if (!selectedIds.Any())
        {
            Snackbar.Add("请先选择要打印的客户", Severity.Warning);
            return;
        }
        try
        {
            var ids = selectedIds.ToArray();
            var result = await CustomerService.PrintCustomerBatchAsync(ids);
            if (result.Success && result.Data != null)
                await JS.InvokeVoidAsync("openPdf", result.Data);
            else
                Snackbar.Add(result.Message ?? "打印失败", Severity.Error);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"打印失败: {ex.Message}", Severity.Error);
        }
    }

    private async Task PrintAll()
    {
        try
        {
            var result = await CustomerService.PrintCustomerAllAsync(
                string.IsNullOrWhiteSpace(searchKeyword) ? null : searchKeyword,
                sortColumn, sortDescending);
            if (result.Success && result.Data != null)
                await JS.InvokeVoidAsync("openPdf", result.Data);
            else
                Snackbar.Add(result.Message ?? "打印失败", Severity.Error);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"打印失败: {ex.Message}", Severity.Error);
        }
    }
}