@page "/suppliers"
@using MES.Blazor.Services
@using MES.Core.DTOs
@using MES.Core.Models
@using Microsoft.AspNetCore.Authorization
@using MES.Blazor.Shared
@inject SupplierService SupplierService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject IJSRuntime JS
@attribute [Authorize(Roles = "MaterialStaff,MaterialDirector,Admin")]

<div class="mt-4">
    <MudCard>
        <MudCardHeader>
            <CardHeaderContent>
                <MudText Typo="Typo.h5" Class="font-weight-bold">
                    <MudIcon Icon="@Icons.Material.Filled.Business" Class="mr-2" Color="Color.Primary" />
                    供应商管理
                </MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">供应商档案维护</MudText>
            </CardHeaderContent>
            <CardHeaderActions>
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Add"
                           OnClick="NavigateToCreate">
                    新建供应商
                </MudButton>
            </CardHeaderActions>
        </MudCardHeader>

        <MudCardContent>
            <!-- 搜索栏 -->
            <MudGrid>
                <MudItem xs="12" md="12">
                    <MudTextField T="string"
                                  Label="模糊搜索 - 供应商编码/名称/物料分类/联系人/联系电话"
                                  Placeholder="输入关键字..."
                                  Value="searchKeyword"
                                  ValueChanged="@OnSearchChanged"
                                  Immediate="true"
                                  DebounceInterval="500"
                                  Clearable="true"
                                  ClearButton="true"
                                  Adornment="Adornment.End"
                                  AdornmentIcon="@Icons.Material.Filled.Search" />
                </MudItem>
            </MudGrid>

            <!-- 数据表格 -->
            <MudTable @ref="table"
                      T="SupplierProfileDto"
                      ServerData="OnServerData"
                      Loading="@isLoading"
                      Dense="true"
                      Hover="true"
                      Class="mt-4"
                      Elevation="0"
                      RowsPerPageLabel="每页行数:">
                <ToolBarContent>
                    <MudButton Variant="Variant.Outlined"
                               Size="Size.Small"
                               Color="Color.Info"
                               StartIcon="@Icons.Material.Filled.Print"
                               Disabled="@(!selectedIds.Any())"
                               OnClick="PrintSelected">
                        打印选中 (@selectedIds.Count)
                    </MudButton>
                    <MudButton Variant="Variant.Text"
                               Size="Size.Small"
                               Color="Color.Info"
                               StartIcon="@Icons.Material.Filled.Print"
                               OnClick="PrintAll">
                        打印全部
                    </MudButton>
                    <MudText Typo="Typo.body2" Class="ml-auto">
                        共 @totalCount 条记录
                    </MudText>
                </ToolBarContent>
                <HeaderContent>
                    <MudTh Style="width: 40px;">
                        <MudCheckBox T="bool" @bind-Value="allSelected" Dense="true" />
                    </MudTh>
                    <MudTh>
                        <span @onclick='() => ToggleSort("suppliercode")' class="sortable-header">
                            供应商编码
                            @if (sortColumn == "suppliercode")
                            {
                                <span class="sort-arrow">@GetSortIndicator("suppliercode")</span>
                            }
                        </span>
                    </MudTh>
                    <MudTh>
                        <span @onclick='() => ToggleSort("suppliername")' class="sortable-header">
                            供应商名称
                            @if (sortColumn == "suppliername")
                            {
                                <span class="sort-arrow">@GetSortIndicator("suppliername")</span>
                            }
                        </span>
                    </MudTh>
                    <MudTh>
                        <span @onclick='() => ToggleSort("materialcategory")' class="sortable-header">
                            物料分类
                            @if (sortColumn == "materialcategory")
                            {
                                <span class="sort-arrow">@GetSortIndicator("materialcategory")</span>
                            }
                        </span>
                    </MudTh>
                    <MudTh>
                        <span @onclick='() => ToggleSort("contactperson")' class="sortable-header">
                            联系人
                            @if (sortColumn == "contactperson")
                            {
                                <span class="sort-arrow">@GetSortIndicator("contactperson")</span>
                            }
                        </span>
                    </MudTh>
                    <MudTh>
                        <span @onclick='() => ToggleSort("contactphone")' class="sortable-header">
                            联系电话
                            @if (sortColumn == "contactphone")
                            {
                                <span class="sort-arrow">@GetSortIndicator("contactphone")</span>
                            }
                        </span>
                    </MudTh>
                    <MudTh>
                        <span @onclick='() => ToggleSort("isactive")' class="sortable-header">
                            状态
                            @if (sortColumn == "isactive")
                            {
                                <span class="sort-arrow">@GetSortIndicator("isactive")</span>
                            }
                        </span>
                    </MudTh>
                    <MudTh>操作</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd Style="width: 40px;">
                        <MudCheckBox T="bool"
                                     Value="@selectedIds.Contains(context.Id)"
                                     ValueChanged="@((v) => { if(v) selectedIds.Add(context.Id); else selectedIds.Remove(context.Id); _allSelected = items.Any() && items.All(i => selectedIds.Contains(i.Id)); StateHasChanged(); })"
                                     Dense="true" />
                    </MudTd>
                    <MudTd title="@context.SupplierCode">
                        <MudLink Typo="Typo.body2" OnClick="() => ViewDetail(context.Id)">@context.SupplierCode</MudLink>
                    </MudTd>
                    <MudTd title="@context.SupplierName">@context.SupplierName</MudTd>
                    <MudTd title="@context.MaterialCategory">@context.MaterialCategory</MudTd>
                    <MudTd title="@context.ContactPerson">@context.ContactPerson</MudTd>
                    <MudTd>@context.ContactPhone</MudTd>
                    <MudTd>
                        <MudChip Size="Size.Small" Color="@(context.IsActive ? Color.Success : Color.Error)">
                            @(context.IsActive ? "启用" : "停用")
                        </MudChip>
                    </MudTd>
                    <MudTd>
                        <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                       Color="Color.Warning"
                                       Size="Size.Small"
                                       OnClick="() => EditDetail(context.Id)" />
                        <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                       Color="Color.Error"
                                       Size="Size.Small"
                                       OnClick="() => DeleteItem(context)" />
                    </MudTd>
                </RowTemplate>
                <PagerContent>
                    <MudTablePager />
                </PagerContent>
            </MudTable>
        </MudCardContent>
    </MudCard>
</div>

@code {
    private MudTable<SupplierProfileDto>? table;
    private List<SupplierProfileDto> items = new();
    private HashSet<int> selectedIds = new();
    private bool _allSelected;
    private bool allSelected
    {
        get => _allSelected;
        set
        {
            if (_allSelected == value) return;
            _allSelected = value;
            if (value)
            {
                foreach (var item in items)
                    selectedIds.Add(item.Id);
            }
            else
            {
                selectedIds.Clear();
            }
            StateHasChanged();
        }
    }
    private bool isLoading;
    private string searchKeyword = string.Empty;
    private int totalCount;

    private string sortColumn = "suppliercode";
    private bool sortDescending = false;

    private string GetSortIndicator(string column)
    {
        if (sortColumn != column) return "";
        return sortDescending ? "\u25BC" : "\u25B2";
    }

    private async Task<TableData<SupplierProfileDto>> OnServerData(TableState state)
    {
        isLoading = true;
        StateHasChanged();

        try
        {
            var queryParams = new QueryParams
            {
                PageIndex = state.Page + 1,
                PageSize = state.PageSize,
                Keyword = string.IsNullOrWhiteSpace(searchKeyword) ? null : searchKeyword,
                SortBy = sortColumn,
                IsDescending = sortDescending
            };

            var result = await SupplierService.GetPagedAsync(queryParams);

            if (result.Success && result.Data != null)
            {
                items = result.Data.Items;
                totalCount = result.Data.TotalCount;
                return new TableData<SupplierProfileDto>
                {
                    Items = items,
                    TotalItems = totalCount
                };
            }

            return new TableData<SupplierProfileDto>
            {
                Items = new List<SupplierProfileDto>(),
                TotalItems = 0
            };
        }
        catch (Exception ex)
        {
            Snackbar.Add($"加载失败: {ex.Message}", Severity.Error);
            return new TableData<SupplierProfileDto>
            {
                Items = new List<SupplierProfileDto>(),
                TotalItems = 0
            };
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task ToggleSort(string column)
    {
        if (sortColumn == column)
            sortDescending = !sortDescending;
        else
        {
            sortColumn = column;
            sortDescending = false;
        }
        if (table != null)
            await table.ReloadServerData();
    }

    private async Task Search()
    {
        if (table != null)
            await table.ReloadServerData();
    }

    private async Task OnSearchChanged(string value)
    {
        searchKeyword = value ?? string.Empty;
        if (table != null)
            await table.ReloadServerData();
    }

    private void NavigateToCreate() => Navigation.NavigateTo("/suppliers/create");
    private void ViewDetail(int id) => Navigation.NavigateTo($"/suppliers/{id}");
    private void EditDetail(int id) => Navigation.NavigateTo($"/suppliers/{id}/edit");

    private async Task DeleteItem(SupplierProfileDto item)
    {
        var dialog = DialogService.Show<ConfirmDialog>("确认", new DialogParameters
        {
            ["ContentText"] = $"确定要删除供应商 \"{item.SupplierName}\" 吗？\n\n删除后数据将不可恢复！",
            ["ConfirmText"] = "确认删除",
            ["Color"] = Color.Error
        });
        var dialogResult = await dialog.Result;
        if (!dialogResult.Canceled)
        {
            try
            {
                var result = await SupplierService.DeleteAsync(item.Id);
                if (result.Success)
                {
                    Snackbar.Add("删除成功", Severity.Success);
                    await Search();
                }
                else
                {
                    Snackbar.Add(result.Message ?? "删除失败", Severity.Error);
                }
            }
            catch (Exception ex)
            {
                Snackbar.Add($"删除失败: {ex.Message}", Severity.Error);
            }
        }
    }

    // ========== 打印方法 ==========

    private async Task PrintSelected()
    {
        if (!selectedIds.Any())
        {
            Snackbar.Add("请先选择要打印的供应商", Severity.Warning);
            return;
        }
        try
        {
            var ids = selectedIds.ToArray();
            var result = await SupplierService.PrintSupplierBatchAsync(ids);
            if (result.Success && result.Data != null)
                await JS.InvokeVoidAsync("openPdf", result.Data);
            else
                Snackbar.Add(result.Message ?? "打印失败", Severity.Error);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"打印失败: {ex.Message}", Severity.Error);
        }
    }

    private async Task PrintAll()
    {
        try
        {
            var result = await SupplierService.PrintSupplierAllAsync(
                string.IsNullOrWhiteSpace(searchKeyword) ? null : searchKeyword,
                sortColumn, sortDescending);
            if (result.Success && result.Data != null)
                await JS.InvokeVoidAsync("openPdf", result.Data);
            else
                Snackbar.Add(result.Message ?? "打印失败", Severity.Error);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"打印失败: {ex.Message}", Severity.Error);
        }
    }
}
