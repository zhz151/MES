    // ========== 项次操作 ==========

    private int GetNextSequence()
    {
        if (!editItemViewModels.Any()) return 1;
        var existing = editItemViewModels.Select(vm => vm.Sequence).OrderBy(x => x).ToList();
        var next = 1;
        foreach (var seq in existing)
        {
            if (seq == next) next++;
            else if (seq > next) break;
        }
        return next;
    }

    private void AddNewItem()
    {
        editItemViewModels.Add(new OrderItemViewModel
        {
            Id = null,
            Sequence = GetNextSequence(),
            DeliveryDate = DateTime.Now.AddMonths(1),
            SettlementMethod = SettlementMethod.Theoretical,
            MaterialName = MaterialName.SeamlessPipe,
            ProductionStandardId = productionStandards.FirstOrDefault()?.Id ?? 0,
            DeliveryState = DeliveryState.SolutionAnnealedAndPickled,
            StandardGrade = gradeMappings.FirstOrDefault()?.StandardGrade ?? string.Empty,
            LengthStatus = LengthStatus.Fixed,
            ProductionStandardCode = productionStandards.FirstOrDefault()?.StandardCode ?? string.Empty,
            PlantGrade = gradeMappings.FirstOrDefault()?.PlantGrade ?? string.Empty,
            Density = gradeMappings.FirstOrDefault()?.Density ?? 7.93m
        });
        StateHasChanged();
    }

    private void RemoveItem(OrderItemViewModel item)
    {
        if (editItemViewModels.Count <= 1)
        {
            Snackbar.Add("订单至少需要保留一个项次", Severity.Warning);
            return;
        }
        if (item.Id.HasValue && item.Id.Value > 0)
            itemsToDelete.Add(item.Id.Value);
        editItemViewModels.Remove(item);

        // 重新排序
        var sorted = editItemViewModels.OrderBy(x => x.Sequence).ToList();
        for (int i = 0; i < sorted.Count; i++)
            sorted[i].Sequence = i + 1;
        StateHasChanged();
    }

    private void CalculateMetersForViewModel(OrderItemViewModel item)
    {
        if (item.LengthStatus == LengthStatus.Fixed)
        {
            if (item.MaxLength.HasValue && item.MaxLength > 0 && item.Quantity.HasValue && item.Quantity > 0)
            {
                item.Meters = Math.Round(item.MaxLength.Value * item.Quantity.Value / 1000m, 2);
                StateHasChanged();
            }
            else
            {
                Snackbar.Add("请先填写最大长度和支数", Severity.Warning);
            }
        }
        else
        {
            Snackbar.Add("仅在定尺模式下支持自动计算米数", Severity.Info);
        }
    }

    private void CalculateTheoreticalWeightForViewModel(OrderItemViewModel item)
    {
        var grade = gradeMappings.FirstOrDefault(g => g.StandardGrade == item.StandardGrade);
        if (grade == null)
        {
            Snackbar.Add($"标准牌号 '{item.StandardGrade}' 不存在", Severity.Warning);
            return;
        }
        item.Density = grade.Density;
        item.PlantGrade = grade.PlantGrade;

        const decimal pi = 3.1416m;
        var effectiveWall = item.WallThickness - 0.5m * item.WallThicknessNegative + 0.5m * item.WallThicknessPositive;
        var effectiveOd = item.OuterDiameter - 0.5m * item.OuterDiameterNegative + 0.5m * item.OuterDiameterPositive;
        if (effectiveWall < 0) effectiveWall = 0;
        if (effectiveOd <= effectiveWall) effectiveOd = effectiveWall + 0.001m;

        var meters = item.Meters ?? 0m;
        var weight = grade.Density * pi * effectiveWall * (effectiveOd - effectiveWall) * meters / 1000;
        item.TheoreticalWeight = Math.Round(weight < 0 ? 0 : weight, 2);
        StateHasChanged();
    }

    // ========== 数据加载 ==========

    protected override async Task OnInitializedAsync() => await LoadData();

    private async Task LoadData()
    {
        if (Id <= 0)
        {
            Snackbar.Add("无效的订单ID", Severity.Error);
            isLoading = false;
            return;
        }
        isLoading = true;
        StateHasChanged();
        try
        {
            productionStandards = await StandardService.GetAllAsync(false);
            gradeMappings = await GradeMappingService.GetAllAsync();

            var result = await OrderService.GetByIdAsync(Id);
            if (result.Success && result.Data != null)
            {
                orderDetail = result.Data;
                editItemViewModels = orderDetail.Items.OrderBy(i => i.Sequence).Select(i => new OrderItemViewModel
                {
                    Id = i.Id,
                    Sequence = i.Sequence,
                    DeliveryDate = i.DeliveryDate,
                    DelayPenalty = i.DelayPenalty,
                    SettlementMethod = i.SettlementMethod,
                    MaterialName = i.MaterialName,
                    ProductionStandardId = productionStandards.FirstOrDefault(s => s.StandardCode == i.ProductionStandardCode)?.Id ?? 0,
                    DeliveryState = i.DeliveryState,
                    StandardGrade = i.StandardGrade,
                    OuterDiameter = i.OuterDiameter,
                    WallThickness = i.WallThickness,
                    OuterDiameterNegative = i.OuterDiameterNegative,
                    OuterDiameterPositive = i.OuterDiameterPositive,
                    WallThicknessNegative = i.WallThicknessNegative,
                    WallThicknessPositive = i.WallThicknessPositive,
                    LengthStatus = i.LengthStatus,
                    MinLength = i.MinLength,
                    MaxLength = i.MaxLength,
                    Quantity = i.Quantity,
                    Meters = i.Meters,
                    ContractWeight = i.ContractWeight,
                    TheoreticalWeight = i.TheoreticalWeight,
                    Remark = i.Remark,
                    ProductionStandardCode = i.ProductionStandardCode,
                    PlantGrade = i.PlantGrade,
                    Density = i.Density
                }).ToList();
                itemsToDelete.Clear();
            }
            else
            {
                Snackbar.Add(result.Message ?? "加载失败", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"加载失败: {ex.Message}", Severity.Error);
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private void EnterEditMode()
    {
        if (orderDetail?.Status == SalesOrderStatus.Cancelled)
        {
            Snackbar.Add("已取消的订单无法编辑", Severity.Warning);
            return;
        }
        Navigation.NavigateTo($"/orders/{Id}/edit");
    }

    // ========== 保存 ==========

    private async Task SaveAllChanges()
    {
        if (orderDetail?.Status == SalesOrderStatus.Cancelled)
        {
            Snackbar.Add("已取消的订单无法保存修改", Severity.Warning);
            return;
        }

        if (!editItemViewModels.Any())
        {
            Snackbar.Add("订单至少需要包含一个项次", Severity.Warning);
            return;
        }

        // 收集所有验证错误
        var errors = new List<string>();

        foreach (var item in editItemViewModels)
        {
            // 长度验证
            switch (item.LengthStatus)
            {
                case LengthStatus.Fixed:
                    if (!item.MinLength.HasValue || item.MinLength <= 0)
                        errors.Add($"项次 {item.Sequence}: 定尺时必须填写长度");
                    break;
                case LengthStatus.Range:
                    if (!item.MinLength.HasValue || item.MinLength <= 0 ||
                        !item.MaxLength.HasValue || item.MaxLength <= 0 ||
                        item.MaxLength <= item.MinLength)
                        errors.Add($"项次 {item.Sequence}: 范围尺时必须填写最小长度和最大长度，且最大长度必须大于最小长度");
                    break;
            }

            // 牌号验证
            if (string.IsNullOrEmpty(item.StandardGrade))
                errors.Add($"项次 {item.Sequence}: 标准牌号不能为空");
            else if (!gradeMappings.Any(g => g.StandardGrade == item.StandardGrade))
                errors.Add($"项次 {item.Sequence}: 标准牌号 '{item.StandardGrade}' 不存在");

            // 数值验证
            if (item.OuterDiameter <= 0)
                errors.Add($"项次 {item.Sequence}: 外径必须大于0");
            if (item.WallThickness <= 0)
                errors.Add($"项次 {item.Sequence}: 壁厚必须大于0");
            if (item.ContractWeight <= 0)
                errors.Add($"项次 {item.Sequence}: 合同重量必须大于0");
        }

        // 一次性显示所有错误
        if (errors.Any())
        {
            var errorMsg = string.Join("\n", errors);
            Snackbar.Add(errorMsg, Severity.Error, configure: options =>
            {
                options.VisibleStateDuration = 8000;
                options.ShowCloseIcon = true;
                options.RequireInteraction = true;
            });
            return;
        }

        isSubmitting = true;
        StateHasChanged();

        try
        {
            // 删除标记的项次
            foreach (var itemId in itemsToDelete)
            {
                var result = await OrderService.DeleteItemAsync(Id, itemId);
                if (!result.Success)
                {
                    Snackbar.Add($"删除项次失败: {result.Message}", Severity.Error);
                    return;
                }
            }

            // 保存每个项次
            foreach (var item in editItemViewModels)
            {
                var grade = gradeMappings.First(g => g.StandardGrade == item.StandardGrade);

                // 计算米数
                var meters = item.Meters ?? 0m;
                if (item.LengthStatus == LengthStatus.Fixed && item.MaxLength.HasValue && item.Quantity.HasValue)
                {
                    meters = item.MaxLength.Value * item.Quantity.Value / 1000m;
                    item.Meters = Math.Round(meters, 2);
                }

                // 计算理算重量
                const decimal pi = 3.1416m;
                var effectiveWall = item.WallThickness - 0.5m * item.WallThicknessNegative + 0.5m * item.WallThicknessPositive;
                var effectiveOd = item.OuterDiameter - 0.5m * item.OuterDiameterNegative + 0.5m * item.OuterDiameterPositive;
                if (effectiveWall < 0) effectiveWall = 0;
                if (effectiveOd <= effectiveWall) effectiveOd = effectiveWall + 0.001m;
                var weight = grade.Density * pi * effectiveWall * (effectiveOd - effectiveWall) * meters / 1000;
                item.TheoreticalWeight = Math.Round(weight < 0 ? 0 : weight, 2);

                if (item.Id.HasValue && item.Id.Value > 0)
                {
                    var result = await OrderService.UpdateItemAsync(Id, item.Id.Value, new UpdateOrderItemRequest
                    {
                        Sequence = item.Sequence,
                        DeliveryDate = item.DeliveryDate,
                        DelayPenalty = item.DelayPenalty,
                        SettlementMethod = item.SettlementMethod,
                        MaterialName = item.MaterialName,
                        ProductionStandardId = item.ProductionStandardId,
                        DeliveryState = item.DeliveryState,
                        StandardGrade = item.StandardGrade,
                        OuterDiameter = item.OuterDiameter,
                        WallThickness = item.WallThickness,
                        OuterDiameterNegative = item.OuterDiameterNegative,
                        OuterDiameterPositive = item.OuterDiameterPositive,
                        WallThicknessNegative = item.WallThicknessNegative,
                        WallThicknessPositive = item.WallThicknessPositive,
                        LengthStatus = item.LengthStatus,
                        MinLength = item.MinLength,
                        MaxLength = item.MaxLength,
                        Quantity = item.Quantity,
                        Meters = item.Meters,
                        ContractWeight = item.ContractWeight,
                        Remark = item.Remark
                    });
                    if (!result.Success)
                    {
                        Snackbar.Add($"更新项次 {item.Sequence} 失败: {result.Message}", Severity.Error);
                        return;
                    }
                }
                else
                {
                    var result = await OrderService.AddItemAsync(Id, new AddOrderItemRequest
                    {
                        Sequence = item.Sequence,
                        DeliveryDate = item.DeliveryDate,
                        DelayPenalty = item.DelayPenalty,
                        SettlementMethod = item.SettlementMethod,
                        MaterialName = item.MaterialName,
                        ProductionStandardId = item.ProductionStandardId,
                        DeliveryState = item.DeliveryState,
                        StandardGrade = item.StandardGrade,
                        OuterDiameter = item.OuterDiameter,
                        WallThickness = item.WallThickness,
                        OuterDiameterNegative = item.OuterDiameterNegative,
                        OuterDiameterPositive = item.OuterDiameterPositive,
                        WallThicknessNegative = item.WallThicknessNegative,
                        WallThicknessPositive = item.WallThicknessPositive,
                        LengthStatus = item.LengthStatus,
                        MinLength = item.MinLength,
                        MaxLength = item.MaxLength,
                        Quantity = item.Quantity,
                        Meters = item.Meters,
                        ContractWeight = item.ContractWeight,
                        Remark = item.Remark
                    });
                    if (!result.Success)
                    {
                        Snackbar.Add($"添加项次失败: {result.Message}", Severity.Error);
                        return;
                    }
                }
            }

            Snackbar.Add("保存成功", Severity.Success);
            await LoadData();
            Navigation.NavigateTo($"/orders/{Id}");
        }
        catch (Exception ex)
        {
            Snackbar.Add($"保存失败: {ex.Message}", Severity.Error);
        }
        finally
        {
            isSubmitting = false;
            StateHasChanged();
        }
    }

