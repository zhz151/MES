    private RenderFragment RenderItemActions(OrderItemViewModel item) => builder =>
    {
        if (_editItems.Count > 1)
        {
            builder.OpenComponent<MudIconButton>(0);
            builder.AddAttribute(1, "Icon", Icons.Material.Filled.Delete);
            builder.AddAttribute(2, "Color", Color.Error);
            builder.AddAttribute(3, "Size", Size.Small);
            builder.AddAttribute(4, "OnClick", EventCallback.Factory.Create<MouseEventArgs?>(this, () => RemoveItem(item)));
            builder.CloseComponent();
        }
        else
        {
            builder.OpenComponent<MudIconButton>(0);
            builder.AddAttribute(1, "Icon", Icons.Material.Filled.Delete);
            builder.AddAttribute(2, "Color", Color.Error);
            builder.AddAttribute(3, "Size", Size.Small);
            builder.AddAttribute(4, "Disabled", true);
            builder.AddAttribute(5, "Title", "订单至少需要保留一个项次");
            builder.CloseComponent();
        }
    };
