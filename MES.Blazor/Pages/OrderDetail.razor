@page "/orders/{Id:int}"
@using MES.Blazor.Helpers
@using MES.Blazor.Services
@using MES.Core.DTOs
@using MES.Core.Models
@using MES.Core.Enums
@using Microsoft.AspNetCore.Authorization
@using MES.Blazor.Shared
@inject OrderService OrderService
@inject CustomerService CustomerService
@inject ProductRequirementService RequirementService
@inject ProductionStandardService StandardService
@inject GradeMappingService GradeMappingService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject IJSRuntime JS
@inject ColumnPrefsService ColumnPrefs
@attribute [Authorize]

<MudContainer MaxWidth="MaxWidth.False" Class="mt-4">
    @if (_isLoading)
    {
        <MudProgressCircular Indeterminate Size="Size.Large" Class="d-flex justify-center ma-8" />
    }
    else if (_order == null)
    {
        <MudPaper Class="pa-4 mb-4" Elevation="0" Style="border:1px solid var(--mud-palette-lines-default); border-radius:8px;">
            @if (!string.IsNullOrEmpty(_loadErrorMessage))
            {
                <MudText Typo="Typo.body2" Color="Color.Error"><strong>加载失败：</strong>@_loadErrorMessage</MudText>
            }
            else
            {
                <MudText Typo="Typo.body2" Color="Color.Error">订单不存在</MudText>
            }
            <div class="mt-3">
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="GoBack">返回订单列表</MudButton>
            </div>
        </MudPaper>
    }
    else
    {
        <MudCard>
            <MudCardHeader>
                <CardHeaderContent>
                    <div class="d-flex align-center">
                        <MudIcon Icon="@Icons.Material.Filled.Receipt" Class="mr-2" Color="Color.Primary" Size="Size.Medium" />
                        <MudText Typo="Typo.h5" Class="font-weight-bold">订单详情</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="ml-4">订单号：@_order.OrderNumber</MudText>
                        <MudChip Size="Size.Small" Color="@GetStatusColor(_order.Status)" Class="ml-2">
                            @GetOrderStatusText(_order.Status)
                        </MudChip>
                        <MudIconButton Icon="@Icons.Material.Filled.Description"
                                       Color="Color.Info"
                                       Size="Size.Small"
                                       Class="ml-4"
                                       OnClick="NavigateToRequirements"
                                       Title="技术要求" />
                    </div>
                </CardHeaderContent>
                <CardHeaderActions>
                    <MudButton Variant="Variant.Text" OnClick="GoBack">返回</MudButton>
                    @if (!_isEditMode)
                    {
                        <MudButton Variant="Variant.Outlined" Color="Color.Info"
                                   StartIcon="@Icons.Material.Filled.Print"
                                   OnClick="PrintOrder">
                            打印
                        </MudButton>
                    }
                    @if (_isEditMode)
                    {
                        <MudButton Variant="Variant.Text" Color="Color.Default" OnClick="CancelEdit">取消</MudButton>
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAllChanges" Loading="@_isSubmitting">
                            保存修改
                        </MudButton>
                    }
                    else
                    {
                        <AuthorizeView Roles="OrderDirector,Admin">
                            <MudButton Variant="Variant.Outlined" Color="Color.Warning" OnClick="EnterEditMode">编辑</MudButton>
                        </AuthorizeView>
                    }
                </CardHeaderActions>
            </MudCardHeader>

            <MudCardContent>
                @* ====== 表1：订单基本信息 ====== *@
                <div class="d-flex align-center mb-2">
                    <MudText Typo="Typo.subtitle1" Class="font-weight-bold">
                        <MudIcon Icon="@Icons.Material.Filled.Info" Size="Size.Small" Class="mr-1" />订单基本信息
                    </MudText>
                    <ColumnDisplaySelect Columns="@_headerColumns"
                                         OnColumnToggle="@OnHeaderColumnToggle"
                                         OnMoveUp="@OnHeaderMoveUp"
                                         OnMoveDown="@OnHeaderMoveDown" />
                </div>

                <div style="overflow-x: auto;" class="mb-6">
                    <MudTable Items="@_singleItemList" Dense="true" Hover="true" Elevation="0" Class="auto-table" ReadOnly="true">
                        <HeaderContent>
                            @foreach (var col in _visibleHeaderColumns)
                            {
                                <MudTh>
                                    @col.Label
                                    @if (col.IsRequired) { <span class="required-star">*</span> }
                                </MudTh>
                            }
                        </HeaderContent>
                        <RowTemplate Context="item">
                            @foreach (var col in _visibleHeaderColumns)
                            {
                                <MudTd>@RenderHeaderCell(item, col)</MudTd>
                            }
                        </RowTemplate>
                    </MudTable>
                </div>

                @* ====== 表2：订单项次列表 ====== *@
                <div class="d-flex align-center mb-2">
                    <MudText Typo="Typo.subtitle1" Class="font-weight-bold">
                        <MudIcon Icon="@Icons.Material.Filled.ListAlt" Size="Size.Small" Class="mr-1" />订单项次列表
                    </MudText>
                    <ColumnDisplaySelect Columns="@_itemColumns"
                                         OnColumnToggle="@OnItemColumnToggle"
                                         OnMoveUp="@OnItemMoveUp"
                                         OnMoveDown="@OnItemMoveDown" />
                    @if (_isEditMode)
                    {
                        <div class="ml-auto">
                            <MudButton Variant="Variant.Outlined"
                                       Color="Color.Secondary"
                                       StartIcon="@Icons.Material.Filled.Add"
                                       OnClick="AddSimilarItem"
                                       Size="Size.Small"
                                       Class="mr-2">
                                添加同类项次
                            </MudButton>
                            <MudButton Variant="Variant.Outlined"
                                       Color="Color.Primary"
                                       StartIcon="@Icons.Material.Filled.Add"
                                       OnClick="AddNewItem"
                                       Size="Size.Small">
                                添加异类项次
                            </MudButton>
                        </div>
                    }
                </div>


                <div style="overflow-x: auto;" id="order-items-table">
                    <MudTable Items="@(_isEditMode ? _editItems : _viewItems)"
                              Dense="true"
                              Hover="true"
                              Elevation="0"
                              ReadOnly="@(!_isEditMode)"
                              RowsPerPage="10"
                              RowsPerPageLabel="每页行数:"
                              Class="auto-table">
                        <HeaderContent>
                            @foreach (var col in _visibleItemColumns)
                            {
                                <MudTh>
                                    @col.Label
                                    @if (col.IsRequired) { <span class="required-star">*</span> }
                                </MudTh>
                            }
                            @if (_isEditMode) { <MudTh>操作</MudTh> }
                        </HeaderContent>
                        <RowTemplate Context="item">
                            @foreach (var col in _visibleItemColumns)
                            {
                                <MudTd>@RenderItemCell(item, col)</MudTd>
                            }
                            @if (_isEditMode) { <MudTd>@RenderItemActions(item)</MudTd> }
                        </RowTemplate>
                        <PagerContent>
                            <MudTablePager />
                        </PagerContent>
                    </MudTable>
                </div>

                @if (_isEditMode && _editItems.Count == 0)
                {
                    <MudText Typo="Typo.body2" Color="Color.Secondary">暂无项次数据，请点击"添加项次"按钮添加。</MudText>
                }
                @if (!_isEditMode && _viewItems.Count == 0)
                {
                    <MudText Typo="Typo.body2" Color="Color.Secondary">暂无项次数据。</MudText>
                }
            </MudCardContent>
        </MudCard>
    }
</MudContainer>

@code {
    [Parameter] public int Id { get; set; }

    // ========== 状态 ==========
    private SalesOrderDetailDto? _order;
    private bool _isLoading = true;
    private bool _isEditMode;
    private bool _isSubmitting;
    private string _loadErrorMessage = string.Empty;
    private bool _isArrowNavSetup;

    // ========== 编辑模型 ==========
    private OrderHeaderEditModel _headerEditItem = new();

    private class OrderHeaderEditModel
    {
        public string OrderNumber { get; set; } = string.Empty;
        public string SignDateStr { get; set; } = string.Empty;
        public int CustomerId { get; set; }
        public string CustomerName { get; set; } = string.Empty;
        public string Salesman { get; set; } = string.Empty;
        public string? EndCustomer { get; set; }
        public string SelectedSalesman { get; set; } = string.Empty;
        public string SelectedCustomerUnit { get; set; } = string.Empty;
        public string SelectedEndCustomer { get; set; } = string.Empty;
        public SalesOrderStatus Status { get; set; }
        public byte[] RowVersion { get; set; } = Array.Empty<byte>();
    }

    /// <summary>
    /// 项次视图模型（编辑用）
    /// </summary>
    private class OrderItemViewModel
    {
        public int? Id { get; set; }
        public int Sequence { get; set; }
        public DateTime DeliveryDate { get; set; } = DateTime.Now.AddMonths(1);
        public bool DelayPenalty { get; set; }
        public SettlementMethod SettlementMethod { get; set; } = SettlementMethod.Theoretical;
        public MaterialName MaterialName { get; set; } = MaterialName.SeamlessPipe;
        public int ProductionStandardId { get; set; }
        public DeliveryState DeliveryState { get; set; } = DeliveryState.SolutionAnnealedAndPickled;
        public string StandardGrade { get; set; } = string.Empty;
        public decimal OuterDiameter { get; set; }
        public decimal WallThickness { get; set; }
        public decimal OuterDiameterNegative { get; set; }
        public decimal OuterDiameterPositive { get; set; }
        public decimal WallThicknessNegative { get; set; }
        public decimal WallThicknessPositive { get; set; }
        public LengthStatus LengthStatus { get; set; } = LengthStatus.Fixed;
        public decimal? MinLength { get; set; }
        public decimal? MaxLength { get; set; }
        public int? Quantity { get; set; }
        public decimal? Meters { get; set; }
        public decimal ContractWeight { get; set; }
        public decimal TheoreticalWeight { get; set; }
        public string? Remark { get; set; }
        public string ProductionStandardCode { get; set; } = string.Empty;
        public string PlantGrade { get; set; } = string.Empty;
        public decimal Density { get; set; }
    }

    private List<OrderItemViewModel> _viewItems = new();
    private List<OrderItemViewModel> _editItems = new();
    private List<int> _itemsToDelete = new();
    private List<CustomerProfileDto> _allCustomers = new();
    private List<ProductionStandardDto> _productionStandards = new();
    private List<StandardGradeMappingDto> _gradeMappings = new();

    // ========== 单行列表辅助（header表） ==========
    private List<SalesOrderDetailDto> _singleItemList => _order != null ? new List<SalesOrderDetailDto> { _order } : new();

    // ========== 列定义 - 订单基本信息 ==========
    private List<ColumnDef> _headerColumns = new();
    private List<ColumnDef> _visibleHeaderColumns => _headerColumns.Where(c => c.Visible).ToList();
    private const string HeaderColumnPrefsKey = "order_detail_header";

    // ========== 列定义 - 订单项次 ==========
    private List<ColumnDef> _itemColumns = new();
    private List<ColumnDef> _visibleItemColumns => _itemColumns.Where(c => c.Visible).ToList();
    private const string ItemColumnPrefsKey = "order_detail_items";

    // ========== 初始化 ==========
    protected override async Task OnInitializedAsync()
    {
        InitHeaderColumns();
        InitItemColumns();
        await Task.WhenAll(
            LoadColumnPrefsAsync(),
            LoadDataAsync()
        );
    }

    private void InitHeaderColumns()
    {
        _headerColumns = new List<ColumnDef>
        {
            new() { Key = "ordernumber", Label = "订单号", Visible = true, IsRequired = true },
            new() { Key = "signdate", Label = "签订日期", Visible = true },
            new() { Key = "salesman", Label = "业务员", Visible = true },
            new() { Key = "customer", Label = "客户名称", Visible = true },
            new() { Key = "endcustomer", Label = "最终客户", Visible = true },
            new() { Key = "status", Label = "状态", Visible = true },
        };
    }

    private void InitItemColumns()
    {
        _itemColumns = new List<ColumnDef>
        {
            new() { Key = "sequence", Label = "项次", Visible = true },
            new() { Key = "deliverydate", Label = "交货日期", Visible = true, IsRequired = true },
            new() { Key = "delaypenalty", Label = "延期罚款", Visible = true },
            new() { Key = "settlementmethod", Label = "结算方式", Visible = true },
            new() { Key = "materialname", Label = "物料名称", Visible = true },
            new() { Key = "productionstandard", Label = "产品标准", Visible = true },
            new() { Key = "deliverystate", Label = "交货状态", Visible = true },
            new() { Key = "standardgrade", Label = "标准牌号", Visible = true },
            new() { Key = "outerdiameter", Label = "外径", Visible = true },
            new() { Key = "wallthickness", Label = "壁厚", Visible = true },
            new() { Key = "outerdiameternegative", Label = "外径下差", Visible = false },
            new() { Key = "outerdiameterpositive", Label = "外径上差", Visible = false },
            new() { Key = "wallthicknessnegative", Label = "壁厚下差", Visible = false },
            new() { Key = "wallthicknesspositive", Label = "壁厚上差", Visible = false },
            new() { Key = "lengthstatus", Label = "长度状态", Visible = true },
            new() { Key = "minlength", Label = "最小长度", Visible = true },
            new() { Key = "maxlength", Label = "最大长度", Visible = true },
            new() { Key = "quantity", Label = "支数", Visible = true },
            new() { Key = "meters", Label = "米数", Visible = true },
            new() { Key = "contractweight", Label = "合同重量", Visible = true },
            new() { Key = "theoreticalweight", Label = "理算重量", Visible = true },
            new() { Key = "remark", Label = "备注", Visible = false },
        };
    }

    // ========== 列偏好持久化 ==========
    private async Task LoadColumnPrefsAsync()
    {
        var headerSaved = await ColumnPrefs.LoadAsync(HeaderColumnPrefsKey, null);
        if (headerSaved.Count > 0) ApplyColumnPrefs(_headerColumns, headerSaved);
        var itemSaved = await ColumnPrefs.LoadAsync(ItemColumnPrefsKey, null);
        if (itemSaved.Count > 0) ApplyColumnPrefs(_itemColumns, itemSaved);
    }

    private static void ApplyColumnPrefs(List<ColumnDef> target, List<ColumnDef> saved)
    {
        var savedByKey = saved.ToDictionary(s => s.Key, s => s);
        foreach (var t in target)
        {
            if (savedByKey.TryGetValue(t.Key, out var pref))
                t.Visible = pref.Visible;
        }
        var savedKeys = saved.Select(s => s.Key).ToHashSet();
        var merged = saved
            .Select(s => target.FirstOrDefault(t => t.Key == s.Key))
            .Where(t => t != null)
            .Cast<ColumnDef>()
            .Concat(target.Where(t => !savedKeys.Contains(t.Key)))
            .ToList();
        if (merged.Count == target.Count)
        {
            for (int i = 0; i < target.Count; i++) target[i] = merged[i];
        }
    }

    private async Task SaveHeaderColumnPrefs() => await ColumnPrefs.SaveAsync(HeaderColumnPrefsKey, null, _headerColumns);
    private async Task SaveItemColumnPrefs() => await ColumnPrefs.SaveAsync(ItemColumnPrefsKey, null, _itemColumns);
    private async Task OnHeaderColumnToggle(ColumnDef col) => await SaveHeaderColumnPrefs();
    private async Task OnHeaderMoveUp(ColumnDef col) => await SaveHeaderColumnPrefs();
    private async Task OnHeaderMoveDown(ColumnDef col) => await SaveHeaderColumnPrefs();
    private async Task OnItemColumnToggle(ColumnDef col) => await SaveItemColumnPrefs();
    private async Task OnItemMoveUp(ColumnDef col) => await SaveItemColumnPrefs();
    private async Task OnItemMoveDown(ColumnDef col) => await SaveItemColumnPrefs();

    // ========== 数据加载 ==========
    private async Task LoadDataAsync()
    {
        if (Id <= 0)
        {
            Snackbar.Add("无效的订单ID", Severity.Error);
            _isLoading = false;
            return;
        }
        _isLoading = true;
        StateHasChanged();
        try
        {
            var standardsTask = StandardService.GetAllAsync(false);
            var gradesTask = GradeMappingService.GetAllAsync();
            var customersTask = CustomerService.GetAllAsync();
            var orderTask = OrderService.GetByIdAsync(Id);
            await Task.WhenAll(standardsTask, gradesTask, customersTask, orderTask);

            _productionStandards = await standardsTask;
            _gradeMappings = await gradesTask;
            _allCustomers = await customersTask;
            var result = await orderTask;

            if (result.Success && result.Data != null)
            {
                _order = result.Data;
                ResetEditModels();
            }
            else
            {
                _loadErrorMessage = result.Message ?? "加载失败";
            }
        }
        catch (Exception ex)
        {
            _loadErrorMessage = $"加载失败: {ex.Message}";
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    private void ResetEditModels()
    {
        if (_order == null) return;

        _headerEditItem = new OrderHeaderEditModel
        {
            OrderNumber = _order.OrderNumber,
            SignDateStr = _order.SignDate.ToString("yyyy-MM-dd"),
            CustomerId = _order.CustomerId,
            CustomerName = _order.CustomerName,
            Salesman = _order.Salesman,
            EndCustomer = _order.EndCustomer,
            SelectedSalesman = _order.Salesman,
            SelectedCustomerUnit = _order.CustomerName,
            SelectedEndCustomer = _order.EndCustomer ?? string.Empty,
            Status = _order.Status,
            RowVersion = _order.RowVersion
        };

        _viewItems = _order.Items.OrderBy(i => i.Sequence).Select(i => new OrderItemViewModel
        {
            Id = i.Id,
            Sequence = i.Sequence,
            DeliveryDate = i.DeliveryDate,
            DelayPenalty = i.DelayPenalty,
            SettlementMethod = i.SettlementMethod,
            MaterialName = i.MaterialName,
            ProductionStandardId = _productionStandards.FirstOrDefault(s => s.StandardCode == i.ProductionStandardCode)?.Id ?? 1,
            DeliveryState = i.DeliveryState,
            StandardGrade = i.StandardGrade,
            OuterDiameter = i.OuterDiameter,
            WallThickness = i.WallThickness,
            OuterDiameterNegative = i.OuterDiameterNegative,
            OuterDiameterPositive = i.OuterDiameterPositive,
            WallThicknessNegative = i.WallThicknessNegative,
            WallThicknessPositive = i.WallThicknessPositive,
            LengthStatus = i.LengthStatus,
            MinLength = i.MinLength,
            MaxLength = i.MaxLength,
            Quantity = i.Quantity,
            Meters = i.Meters,
            ContractWeight = i.ContractWeight,
            TheoreticalWeight = i.TheoreticalWeight,
            Remark = i.Remark,
            ProductionStandardCode = i.ProductionStandardCode,
            PlantGrade = i.PlantGrade,
            Density = i.Density
        }).ToList();

        _editItems = _viewItems.Select(i => new OrderItemViewModel
        {
            Id = i.Id,
            Sequence = i.Sequence,
            DeliveryDate = i.DeliveryDate,
            DelayPenalty = i.DelayPenalty,
            SettlementMethod = i.SettlementMethod,
            MaterialName = i.MaterialName,
            ProductionStandardId = i.ProductionStandardId,
            DeliveryState = i.DeliveryState,
            StandardGrade = i.StandardGrade,
            OuterDiameter = i.OuterDiameter,
            WallThickness = i.WallThickness,
            OuterDiameterNegative = i.OuterDiameterNegative,
            OuterDiameterPositive = i.OuterDiameterPositive,
            WallThicknessNegative = i.WallThicknessNegative,
            WallThicknessPositive = i.WallThicknessPositive,
            LengthStatus = i.LengthStatus,
            MinLength = i.MinLength,
            MaxLength = i.MaxLength,
            Quantity = i.Quantity,
            Meters = i.Meters,
            ContractWeight = i.ContractWeight,
            TheoreticalWeight = i.TheoreticalWeight,
            Remark = i.Remark,
            ProductionStandardCode = i.ProductionStandardCode,
            PlantGrade = i.PlantGrade,
            Density = i.Density
        }).ToList();

        _itemsToDelete.Clear();
    }

    // ========== 枚举显示 ==========
    private Color GetStatusColor(SalesOrderStatus status) => DisplayHelper.GetSalesOrderStatusColor(status);
    private string GetOrderStatusText(SalesOrderStatus status) => DisplayHelper.GetSalesOrderStatusText(status);

    private string GetCustomerNameById(int id) =>
        _allCustomers.FirstOrDefault(c => c.Id == id)?.CustomerUnit ?? "未知客户";

    private string GetSalesmanById(int id) =>
        _allCustomers.FirstOrDefault(c => c.Id == id)?.Salesman ?? string.Empty;

    // ========== 客户级联选择计算属性 ==========

    private List<string> _salesmen => _allCustomers
        .Where(c => !string.IsNullOrEmpty(c.Salesman))
        .Select(c => c.Salesman)
        .Distinct()
        .OrderBy(s => s)
        .ToList();

    private List<CustomerProfileDto> _filteredBySalesman => string.IsNullOrEmpty(_headerEditItem.SelectedSalesman)
        ? new List<CustomerProfileDto>()
        : _allCustomers.Where(c => c.Salesman == _headerEditItem.SelectedSalesman).ToList();

    private List<string> _customerUnits => _filteredBySalesman
        .Where(c => !string.IsNullOrEmpty(c.CustomerUnit))
        .Select(c => c.CustomerUnit)
        .Distinct()
        .OrderBy(u => u)
        .ToList();

    private List<CustomerProfileDto> _matchedCustomers => string.IsNullOrEmpty(_headerEditItem.SelectedCustomerUnit)
        ? new List<CustomerProfileDto>()
        : _filteredBySalesman.Where(c => c.CustomerUnit == _headerEditItem.SelectedCustomerUnit).ToList();

    private List<string> _endCustomers => _matchedCustomers
        .Where(c => !string.IsNullOrEmpty(c.EndCustomer))
        .Select(c => c.EndCustomer!)
        .Distinct()
        .OrderBy(e => e)
        .ToList();

    private bool _isEndCustomerAuto
    {
        get
        {
            var uniqueEndCustomers = _matchedCustomers
                .Where(c => !string.IsNullOrEmpty(c.EndCustomer))
                .Select(c => c.EndCustomer)
                .Distinct()
                .ToList();
            return uniqueEndCustomers.Count == 1;
        }
    }

    // ========== 客户级联选择事件处理 ==========

    private void OnSalesmanValueChanged(string value)
    {
        _headerEditItem.SelectedSalesman = value;
        _headerEditItem.SelectedCustomerUnit = string.Empty;
        _headerEditItem.SelectedEndCustomer = string.Empty;
        _headerEditItem.CustomerName = string.Empty;
        _headerEditItem.CustomerId = 0;
    }

    private void OnCustomerUnitValueChanged(string value)
    {
        _headerEditItem.SelectedCustomerUnit = value;
        _headerEditItem.SelectedEndCustomer = string.Empty;
        _headerEditItem.CustomerId = 0;

        if (_isEndCustomerAuto)
        {
            var matched = _matchedCustomers.FirstOrDefault(c => !string.IsNullOrEmpty(c.EndCustomer));
            if (matched != null)
            {
                _headerEditItem.SelectedEndCustomer = matched.EndCustomer!;
                _headerEditItem.CustomerId = matched.Id;
                _headerEditItem.CustomerName = matched.CustomerUnit;
                _headerEditItem.Salesman = matched.Salesman;
            }
        }
    }

    private void OnEndCustomerValueChanged(string value)
    {
        _headerEditItem.SelectedEndCustomer = value;
        var matched = _matchedCustomers.FirstOrDefault(c => c.EndCustomer == value);
        if (matched != null)
        {
            _headerEditItem.CustomerId = matched.Id;
            _headerEditItem.CustomerName = matched.CustomerUnit;
            _headerEditItem.Salesman = matched.Salesman;
        }
    }

    // ========== 编辑模式 ==========
    private void EnterEditMode()
    {
        if (_order?.Status == SalesOrderStatus.Cancelled)
        {
            Snackbar.Add("已取消的订单无法编辑", Severity.Warning);
            return;
        }
        ResetEditModels();
        _isEditMode = true;
    }

    private async Task CancelEdit()
    {
        _isEditMode = false;
        ResetEditModels();
        StateHasChanged();
    }

    // ========== 项次操作 ==========
    private void AddNewItem()
    {
        _editItems.Add(new OrderItemViewModel
        {
            Id = null,
            Sequence = 0,
            DeliveryDate = default,
            DelayPenalty = false,
            SettlementMethod = default,
            MaterialName = default,
            ProductionStandardId = 0,
            DeliveryState = default,
            StandardGrade = string.Empty,
            OuterDiameter = 0,
            WallThickness = 0,
            OuterDiameterNegative = 0,
            OuterDiameterPositive = 0,
            WallThicknessNegative = 0,
            WallThicknessPositive = 0,
            LengthStatus = default,
            MinLength = null,
            MaxLength = null,
            Quantity = null,
            Meters = null,
            ContractWeight = 0,
            TheoreticalWeight = 0,
            Remark = null,
            ProductionStandardCode = string.Empty,
            PlantGrade = string.Empty,
            Density = 0
        });
        StateHasChanged();
    }

    private void AddSimilarItem()
    {
        if (!_editItems.Any())
        {
            AddNewItem();
            return;
        }
        var last = _editItems.Last();
        _editItems.Add(new OrderItemViewModel
        {
            Id = null,
            Sequence = 0,
            DeliveryDate = last.DeliveryDate,
            DelayPenalty = last.DelayPenalty,
            SettlementMethod = last.SettlementMethod,
            MaterialName = last.MaterialName,
            ProductionStandardId = last.ProductionStandardId,
            DeliveryState = last.DeliveryState,
            StandardGrade = last.StandardGrade,
            OuterDiameter = last.OuterDiameter,
            WallThickness = last.WallThickness,
