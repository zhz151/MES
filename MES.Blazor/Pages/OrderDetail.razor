    private void CalculateMetersForViewModel(OrderItemViewModel item)
    {
        if (item.LengthStatus == LengthStatus.Fixed)
        {
            if (item.MaxLength.HasValue && item.MaxLength > 0 && item.Quantity.HasValue && item.Quantity > 0)
            {
                item.Meters = Math.Round(item.MaxLength.Value * item.Quantity.Value / 1000m, 2);
                StateHasChanged();
                Snackbar.Add($"米数已自动计算为 {item.Meters} 米", Severity.Info);
            }
            else
            {
                Snackbar.Add("请先填写最大长度和支数", Severity.Warning);
            }
        }
        else
        {
            Snackbar.Add("仅在定尺模式下支持自动计算米数", Severity.Info);
        }
    }

    private void CalculateTheoreticalWeightForViewModel(OrderItemViewModel item)
    {
        var grade = _gradeMappings.FirstOrDefault(g => g.StandardGrade == item.StandardGrade);
        if (grade == null)
        {
            Snackbar.Add($"标准牌号 '{item.StandardGrade}' 不存在", Severity.Warning);
            return;
        }
        item.Density = grade.Density;
        item.PlantGrade = grade.PlantGrade;

        const decimal pi = 3.1416m;
        var effectiveWall = item.WallThickness - 0.5m * item.WallThicknessNegative + 0.5m * item.WallThicknessPositive;
        var effectiveOd = item.OuterDiameter - 0.5m * item.OuterDiameterNegative + 0.5m * item.OuterDiameterPositive;
        if (effectiveWall < 0) effectiveWall = 0;
        if (effectiveOd <= effectiveWall) effectiveOd = effectiveWall + 0.001m;

        var meters = item.Meters ?? 0m;
        var weight = grade.Density * pi * effectiveWall * (effectiveOd - effectiveWall) * meters / 1000;
        item.TheoreticalWeight = Math.Round(weight < 0 ? 0 : weight, 2);
        StateHasChanged();
        Snackbar.Add($"理算重量已计算为 {item.TheoreticalWeight} kg", Severity.Info);
    }

    // ========== 保存 ==========
    private async Task SaveAllChanges()
    {
        // 验证header
        if (string.IsNullOrWhiteSpace(_headerEditItem.OrderNumber))
        {
            Snackbar.Add("订单号不能为空", Severity.Warning);
            return;
        }
        if (!DateTime.TryParse(_headerEditItem.SignDateStr, out var signDate))
        {
            Snackbar.Add("签订日期格式无效", Severity.Warning);
            return;
        }
        if (_headerEditItem.CustomerId <= 0)
        {
            Snackbar.Add("请选择有效的客户信息（业务员→客户单位→最终客户）", Severity.Warning);
            return;
        }

        // 验证项次
        if (!_editItems.Any())
        {
            Snackbar.Add("订单至少需要包含一个项次", Severity.Warning);
            return;
        }

        var errors = new List<string>();
        var warnings = new List<string>();

        foreach (var item in _editItems)
        {
            switch (item.LengthStatus)
            {
                case LengthStatus.Fixed:
                    if (!item.MinLength.HasValue || item.MinLength <= 0)
                        errors.Add($"项次 {item.Sequence}: 定尺时必须填写长度");
                    else if (item.MaxLength == null || item.MaxLength != item.MinLength)
                        errors.Add($"项次 {item.Sequence}: 定尺模式下最小长度必须等于最大长度");
                    break;
                case LengthStatus.Range:
                    if (!item.MinLength.HasValue || item.MinLength <= 0 ||
                        !item.MaxLength.HasValue || item.MaxLength <= 0 ||
                        item.MaxLength <= item.MinLength)
                        errors.Add($"项次 {item.Sequence}: 范围尺时必须填写最小长度和最大长度，且最大长度必须大于最小长度");
                    break;
            }

            if (string.IsNullOrEmpty(item.StandardGrade))
                errors.Add($"项次 {item.Sequence}: 标准牌号不能为空");
            else if (!_gradeMappings.Any(g => g.StandardGrade == item.StandardGrade))
                errors.Add($"项次 {item.Sequence}: 标准牌号 '{item.StandardGrade}' 不存在");

            if (item.OuterDiameter <= 0)
                errors.Add($"项次 {item.Sequence}: 外径必须大于0");
            if (item.WallThickness <= 0)
                errors.Add($"项次 {item.Sequence}: 壁厚必须大于0");
            if (item.ContractWeight <= 0)
                errors.Add($"项次 {item.Sequence}: 合同重量必须大于0");

            if (item.LengthStatus == LengthStatus.Fixed && item.TheoreticalWeight <= 0)
                errors.Add($"项次 {item.Sequence}: 请先计算理算重量");
        }

        if (errors.Any())
        {
            Snackbar.Add(string.Join("；", errors), Severity.Error);
            return;
        }

        if (warnings.Any())
        {
            var warningMsg = string.Join("\n\n", warnings);
            warningMsg += "\n\n是否继续提交？";
            var dialog = DialogService.Show<ConfirmDialog>("确认", new DialogParameters
            {
                ["ContentText"] = warningMsg,
                ["ConfirmText"] = "继续提交",
                ["Color"] = Color.Warning
            });
            var dialogResult = await dialog.Result;
            if (dialogResult.Canceled) return;
        }

        _isSubmitting = true;
        StateHasChanged();

        try
        {
            // 构建批量保存请求（一次 HTTP 调用完成全部操作）
            var newItems = new List<OrderItemSaveRequest>();
            var updatedItems = new List<OrderItemSaveRequest>();

            foreach (var item in _editItems)
            {
                var saveReq = new OrderItemSaveRequest
                {
                    Id = item.Id ?? 0,
                    Sequence = item.Sequence,
                    DeliveryDate = item.DeliveryDate,
                    DelayPenalty = item.DelayPenalty,
                    SettlementMethod = item.SettlementMethod,
                    MaterialName = item.MaterialName,
                    ProductionStandardId = item.ProductionStandardId,
                    DeliveryState = item.DeliveryState,
                    StandardGrade = item.StandardGrade,
                    OuterDiameter = item.OuterDiameter,
                    WallThickness = item.WallThickness,
                    OuterDiameterNegative = item.OuterDiameterNegative,
                    OuterDiameterPositive = item.OuterDiameterPositive,
                    WallThicknessNegative = item.WallThicknessNegative,
                    WallThicknessPositive = item.WallThicknessPositive,
                    LengthStatus = item.LengthStatus,
                    MinLength = item.MinLength,
                    MaxLength = item.MaxLength,
                    Quantity = item.Quantity,
                    Meters = item.Meters,
                    ContractWeight = item.ContractWeight,
                    Remark = item.Remark
                };

                if (!item.Id.HasValue || item.Id.Value == 0)
                    newItems.Add(saveReq);
                else
                    updatedItems.Add(saveReq);
            }

            var request = new SaveAllOrderRequest
            {
                OrderNumber = _headerEditItem.OrderNumber,
                SignDate = signDate,
                CustomerId = _headerEditItem.CustomerId,
                RowVersion = _headerEditItem.RowVersion,
                NewItems = newItems,
                UpdatedItems = updatedItems,
                DeletedItemIds = _itemsToDelete
            };

            var result = await OrderService.SaveAllAsync(Id, request);
            if (!result.Success)
            {
                Snackbar.Add($"保存失败: {result.Message}", Severity.Error);
                return;
            }

            // 回填结果
            var response = result.Data;
            if (response != null)
            {
                _headerEditItem.RowVersion = response.RowVersion;

                // 回填新项次的 ID
                int newIdx = 0;
                for (int i = 0; i < _editItems.Count; i++)
                {
                    if (!_editItems[i].Id.HasValue || _editItems[i].Id.Value == 0)
                    {
                        if (response.NewItemIdMap.TryGetValue(newIdx, out var realId))
                            _editItems[i].Id = realId;
                        newIdx++;
                    }
                }
            }

            Snackbar.Add("保存成功", Severity.Success);
            _isEditMode = false;
            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"保存失败: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isSubmitting = false;
            StateHasChanged();
        }
    }

