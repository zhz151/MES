// 文件路径: MES.Blazor/Pages/OrderDetail.razor
@page "/orders/{Id:int}"
@page "/orders/{Id:int}/edit"
@using MES.Blazor.Services
@using MES.Core.DTOs
@using MES.Core.Models
@using MES.Core.Enums
@using Microsoft.AspNetCore.Authorization
@inject OrderService OrderService
@inject CustomerService CustomerService
@inject ProductRequirementService RequirementService
@inject ProductionStandardService StandardService
@inject GradeMappingService GradeMappingService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject IJSRuntime JS
@attribute [Authorize]

<div class="mt-4">
    @if (isLoading)
    {
        <MudProgressCircular Indeterminate Size="Size.Large" Class="d-flex justify-center ma-8" />
    }
    else if (orderDetail == null)
    {
        <MudAlert Severity="Severity.Error">订单不存在</MudAlert>
    }
    else
    {
        <MudCard>
            <MudCardHeader>
                <CardHeaderContent>
                    <div class="d-flex align-center">
                        <MudIcon Icon="@Icons.Material.Filled.Receipt" Class="mr-2" Color="Color.Primary" Size="Size.Medium" />
                        <MudText Typo="Typo.h5" Class="font-weight-bold">订单详情</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="ml-4">订单号：@orderDetail.OrderNumber</MudText>
                        <MudChip Size="Size.Small" Color="@GetStatusColor(orderDetail.Status)" Class="ml-2">
                            @GetOrderStatusText(orderDetail.Status)
                        </MudChip>
                        <MudIconButton Icon="@Icons.Material.Filled.Description"
                                       Color="Color.Info"
                                       Size="Size.Small"
                                       Class="ml-4"
                                       OnClick="NavigateToRequirements"
                                       Title="技术要求" />
                    </div>
                </CardHeaderContent>
                <CardHeaderActions>
                    <MudButton Variant="Variant.Text" OnClick="GoBack">返回</MudButton>

                    @if (isEditMode)
                    {
                        @if (orderDetail.Status != SalesOrderStatus.Cancelled)
                        {
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAllChanges" Disabled="@isSubmitting">
                                @if (isSubmitting) { <MudProgressCircular Size="Size.Small" Color="Color.Inherit" /> }
                                else { <span>保存修改</span> }
                            </MudButton>
                        }
                        else
                        {
                            <MudAlert Severity="Severity.Info" Class="mb-0" Style="padding: 4px 12px;">
                                已取消的订单无法编辑
                            </MudAlert>
                        }
                    }
                    else
                    {
                        @if (orderDetail.Status != SalesOrderStatus.Cancelled)
                        {
                            <AuthorizeView Roles="OrderDirector,Admin">
                                <MudButton Variant="Variant.Outlined" Color="Color.Warning" OnClick="EnterEditMode">编辑项次</MudButton>
                            </AuthorizeView>
                        }
                    }
                </CardHeaderActions>
            </MudCardHeader>

            <MudCardContent>
                @if (!isEditMode)
                {
                    <!-- 查看模式：只读表格 -->
                    <MudText Typo="Typo.subtitle1" Class="mb-3">订单项次列表</MudText>
                    <div style="overflow-x: auto;">
                        <MudTable T="OrderItemDto"
                                  Items="@(orderDetail.Items?.OrderBy(i => i.Sequence).ToList() ?? new List<OrderItemDto>())"
                                  Dense="true"
                                  Hover="true"
                                  Elevation="0"
                                  Breakpoint="Breakpoint.Sm"
                                  RowsPerPage="10"
                                  RowsPerPageLabel="每页行数:">
                            <HeaderContent>
                                <MudTh>项次</MudTh>
                                <MudTh>交货日期</MudTh>
                                <MudTh>延期违约金</MudTh>
                                <MudTh>结算方式</MudTh>
                                <MudTh>物料名称</MudTh>
                                <MudTh>产品标准</MudTh>
                                <MudTh>交货状态</MudTh>
                                <MudTh>标准牌号</MudTh>
                                <MudTh>规格</MudTh>
                                <MudTh>外径下差</MudTh>
                                <MudTh>外径上差</MudTh>
                                <MudTh>壁厚下差</MudTh>
                                <MudTh>壁厚上差</MudTh>
                                <MudTh>长度状态</MudTh>
                                <MudTh>最小长度</MudTh>
                                <MudTh>最大长度</MudTh>
                                <MudTh>支数</MudTh>
                                <MudTh>米数</MudTh>
                                <MudTh>合同重量</MudTh>
                                <MudTh>理算重量</MudTh>
                            </HeaderContent>
                            <RowTemplate>
                                <MudTd>@context.Sequence</MudTd>
                                <MudTd>@context.DeliveryDate.ToString("yyyy-MM-dd")</MudTd>
                                <MudTd>@(context.DelayPenalty ? "是" : "否")</MudTd>
                                <MudTd>@GetSettlementMethodText(context.SettlementMethod)</MudTd>
                                <MudTd>@GetMaterialNameText(context.MaterialName)</MudTd>
                                <MudTd>@context.ProductionStandardCode</MudTd>
                                <MudTd>@GetDeliveryStateText(context.DeliveryState)</MudTd>
                                <MudTd>@context.StandardGrade</MudTd>
                                <MudTd>@FormatSpecification(context.Specification)</MudTd>
                                <MudTd>@FormatDecimal(context.OuterDiameterNegative)</MudTd>
                                <MudTd>@FormatDecimal(context.OuterDiameterPositive)</MudTd>
                                <MudTd>@FormatDecimal(context.WallThicknessNegative)</MudTd>
                                <MudTd>@FormatDecimal(context.WallThicknessPositive)</MudTd>
                                <MudTd>@GetLengthStatusText(context.LengthStatus)</MudTd>
                                <MudTd>@FormatNullableDecimal(context.MinLength)</MudTd>
                                <MudTd>@FormatNullableDecimal(context.MaxLength)</MudTd>
                                <MudTd>@context.Quantity</MudTd>
                                <MudTd>@FormatNullableDecimal(context.Meters)</MudTd>
                                <MudTd>@FormatDecimal(context.ContractWeight)</MudTd>
                                <MudTd>@FormatDecimal(context.TheoreticalWeight)</MudTd>
                            </RowTemplate>
                            <PagerContent>
                                <MudTablePager />
                            </PagerContent>
                        </MudTable>
                    </div>
                }
                else
                {
                    <!-- 编辑模式：表格内联编辑 -->
                    <div class="d-flex justify-space-between align-center mb-3">
                        <MudText Typo="Typo.subtitle1">编辑订单项次</MudText>
                        <MudButton Variant="Variant.Outlined"
                                   Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.Add"
                                   OnClick="AddNewItem">
                            添加项次
                        </MudButton>
                    </div>

                    @if (orderDetail.Status == SalesOrderStatus.Cancelled)
                    {
                        <MudAlert Severity="Severity.Warning" Class="mb-3">
                            已取消的订单无法编辑项次。
                        </MudAlert>
                    }
                    else
                    {
                        <MudAlert Severity="Severity.Warning" Class="mb-3">
                            修改后请点击右上角"保存修改"按钮。删除项次请点击行尾的删除按钮。
                            <strong>注意：每个订单至少需要保留一个项次。</strong>
                        </MudAlert>
                    }

                    <div style="overflow-x: auto;">
                        <MudTable T="OrderItemViewModel"
                                  Items="@editItemViewModels"
                                  Dense="true"
                                  Hover="true"
                                  Elevation="0">
                            <HeaderContent>
                                <MudTh>项次</MudTh>
                                <MudTh>交货日期</MudTh>
                                <MudTh>延期违约金</MudTh>
                                <MudTh>结算方式</MudTh>
                                <MudTh>物料名称</MudTh>
                                <MudTh>产品标准</MudTh>
                                <MudTh>交货状态</MudTh>
                                <MudTh>标准牌号</MudTh>
                                <MudTh>外径</MudTh>
                                <MudTh>壁厚</MudTh>
                                <MudTh>外径下差</MudTh>
                                <MudTh>外径上差</MudTh>
                                <MudTh>壁厚下差</MudTh>
                                <MudTh>壁厚上差</MudTh>
                                <MudTh>长度状态</MudTh>
                                <MudTh>最小长度</MudTh>
                                <MudTh>最大长度</MudTh>
                                <MudTh>支数</MudTh>
                                <MudTh>米数</MudTh>
                                <MudTh>合同重量</MudTh>
                                <MudTh>理算重量</MudTh>
                                @if (orderDetail.Status != SalesOrderStatus.Cancelled)
                                {
                                    <MudTh>操作</MudTh>
                                }
                            </HeaderContent>
                            <RowTemplate Context="item">
                                <!-- 项次号（只读） -->
                                <MudTd>
                                    <MudText Typo="Typo.body2">@item.Sequence</MudText>
                                </MudTd>

                                <!-- 交货日期（文本输入） -->
                                <MudTd>
                                    <MudTextField T="string"
                                                  Value="@item.DeliveryDate.ToString("yyyy-MM-dd")"
                                                  ValueChanged="@((string v) => { if (DateTime.TryParse(v, out var d)) item.DeliveryDate = d; })"
                                                  Label="yyyy-MM-dd"
                                                  Dense="true"
                                                  Variant="Variant.Outlined"
                                                  Size="Size.Small"
                                                  Style="width: 120px;"
                                                  Disabled="@(orderDetail.Status == SalesOrderStatus.Cancelled)" />
                                </MudTd>

                                <!-- 延期违约金（复选框） -->
                                <MudTd>
                                    <MudCheckBox @bind-Value="item.DelayPenalty"
                                                 Dense="true"
                                                 Size="Size.Small"
                                                 Disabled="@(orderDetail.Status == SalesOrderStatus.Cancelled)" />
                                </MudTd>

                                <!-- 结算方式（下拉选择） -->
                                <MudTd>
                                    <MudSelect @bind-Value="item.SettlementMethod"
                                               Dense="true"
                                               Variant="Variant.Outlined"
                                               Size="Size.Small"
                                               Style="min-width: 90px;"
                                               Disabled="@(orderDetail.Status == SalesOrderStatus.Cancelled)">
                                        <MudSelectItem Value="SettlementMethod.Theoretical">理算</MudSelectItem>
                                        <MudSelectItem Value="SettlementMethod.Weighing">过磅</MudSelectItem>
                                        <MudSelectItem Value="SettlementMethod.WeighingNegative">过磅-负</MudSelectItem>
                                    </MudSelect>
                                </MudTd>

                                <!-- 物料名称（下拉选择） -->
                                <MudTd>
                                    <MudSelect @bind-Value="item.MaterialName"
                                               Dense="true"
                                               Variant="Variant.Outlined"
                                               Size="Size.Small"
                                               Style="min-width: 80px;"
                                               Disabled="@(orderDetail.Status == SalesOrderStatus.Cancelled)">
                                        <MudSelectItem Value="MaterialName.SeamlessPipe">无缝管</MudSelectItem>
                                        <MudSelectItem Value="MaterialName.WeldedPipe">焊管</MudSelectItem>
                                    </MudSelect>
                                </MudTd>

                                <!-- 产品标准（下拉选择） -->
                                <MudTd>
                                    <MudSelect @bind-Value="item.ProductionStandardId"
                                               Dense="true"
                                               Variant="Variant.Outlined"
                                               Size="Size.Small"
                                               Style="min-width: 100px;"
                                               Disabled="@(orderDetail.Status == SalesOrderStatus.Cancelled)">
                                        @foreach (var std in productionStandards)
                                        {
                                            <MudSelectItem Value="@std.Id">@std.StandardCode</MudSelectItem>
                                        }
                                    </MudSelect>
                                </MudTd>

                                <!-- 交货状态（下拉选择） -->
                                <MudTd>
                                    <MudSelect @bind-Value="item.DeliveryState"
                                               Dense="true"
                                               Variant="Variant.Outlined"
                                               Size="Size.Small"
                                               Style="min-width: 100px;"
                                               Disabled="@(orderDetail.Status == SalesOrderStatus.Cancelled)">
                                        <MudSelectItem Value="DeliveryState.SolutionAnnealedAndPickled">固溶酸洗</MudSelectItem>
                                        <MudSelectItem Value="DeliveryState.Bright">光亮</MudSelectItem>
                                        <MudSelectItem Value="DeliveryState.Hard">硬态</MudSelectItem>
                                    </MudSelect>
                                </MudTd>

                                <!-- 标准牌号（下拉选择） -->
                                <MudTd>
                                    <MudSelect @bind-Value="item.StandardGrade"
                                               Dense="true"
                                               Variant="Variant.Outlined"
                                               Size="Size.Small"
                                               Style="min-width: 80px;"
                                               Disabled="@(orderDetail.Status == SalesOrderStatus.Cancelled)">
                                        @foreach (var grade in gradeMappings)
                                        {
                                            <MudSelectItem Value="@grade.StandardGrade">@grade.StandardGrade</MudSelectItem>
                                        }
                                    </MudSelect>
                                </MudTd>

                                <!-- 外径（文本输入） -->
                                <MudTd>
                                    <MudTextField T="string"
                                                  Value="@FormatDecimal(item.OuterDiameter)"
                                                  ValueChanged="@((string v) => { if (decimal.TryParse(v, out var d)) item.OuterDiameter = d; })"
                                                  Dense="true"
                                                  Variant="Variant.Outlined"
                                                  Size="Size.Small"
                                                  Style="width: 80px;"
                                                  Disabled="@(orderDetail.Status == SalesOrderStatus.Cancelled)" />
                                </MudTd>

                                <!-- 壁厚（文本输入） -->
                                <MudTd>
                                    <MudTextField T="string"
                                                  Value="@FormatDecimal(item.WallThickness)"
                                                  ValueChanged="@((string v) => { if (decimal.TryParse(v, out var d)) item.WallThickness = d; })"
                                                  Dense="true"
                                                  Variant="Variant.Outlined"
                                                  Size="Size.Small"
                                                  Style="width: 80px;"
                                                  Disabled="@(orderDetail.Status == SalesOrderStatus.Cancelled)" />
                                </MudTd>

                                <!-- 外径下差（文本输入） -->
                                <MudTd>
                                    <MudTextField T="string"
                                                  Value="@FormatDecimal(item.OuterDiameterNegative)"
                                                  ValueChanged="@((string v) => { if (decimal.TryParse(v, out var d)) item.OuterDiameterNegative = d; })"
                                                  Dense="true"
                                                  Variant="Variant.Outlined"
                                                  Size="Size.Small"
                                                  Style="width: 70px;"
                                                  Disabled="@(orderDetail.Status == SalesOrderStatus.Cancelled)" />
                                </MudTd>

                                <!-- 外径上差（文本输入） -->
                                <MudTd>
                                    <MudTextField T="string"
                                                  Value="@FormatDecimal(item.OuterDiameterPositive)"
                                                  ValueChanged="@((string v) => { if (decimal.TryParse(v, out var d)) item.OuterDiameterPositive = d; })"
                                                  Dense="true"
                                                  Variant="Variant.Outlined"
                                                  Size="Size.Small"
                                                  Style="width: 70px;"
                                                  Disabled="@(orderDetail.Status == SalesOrderStatus.Cancelled)" />
                                </MudTd>

                                <!-- 壁厚下差（文本输入） -->
                                <MudTd>
                                    <MudTextField T="string"
                                                  Value="@FormatDecimal(item.WallThicknessNegative)"
                                                  ValueChanged="@((string v) => { if (decimal.TryParse(v, out var d)) item.WallThicknessNegative = d; })"
                                                  Dense="true"
                                                  Variant="Variant.Outlined"
                                                  Size="Size.Small"
                                                  Style="width: 70px;"
                                                  Disabled="@(orderDetail.Status == SalesOrderStatus.Cancelled)" />
                                </MudTd>

                                <!-- 壁厚上差（文本输入） -->
                                <MudTd>
                                    <MudTextField T="string"
                                                  Value="@FormatDecimal(item.WallThicknessPositive)"
                                                  ValueChanged="@((string v) => { if (decimal.TryParse(v, out var d)) item.WallThicknessPositive = d; })"
                                                  Dense="true"
                                                  Variant="Variant.Outlined"
                                                  Size="Size.Small"
                                                  Style="width: 70px;"
                                                  Disabled="@(orderDetail.Status == SalesOrderStatus.Cancelled)" />
                                </MudTd>

                                <!-- 长度状态（下拉选择） -->
                                <MudTd>
                                    <MudSelect @bind-Value="item.LengthStatus"
                                               Dense="true"
                                               Variant="Variant.Outlined"
                                               Size="Size.Small"
                                               Style="min-width: 80px;"
                                               Disabled="@(orderDetail.Status == SalesOrderStatus.Cancelled)">
                                        <MudSelectItem Value="LengthStatus.Fixed">定尺</MudSelectItem>
                                        <MudSelectItem Value="LengthStatus.Range">范围尺</MudSelectItem>
                                        <MudSelectItem Value="LengthStatus.NonFixed">非定尺</MudSelectItem>
                                    </MudSelect>
                                </MudTd>

                                <!-- 最小长度（文本输入） -->
                                <MudTd>
                                    <MudTextField T="string"
                                                  Value="@FormatNullableDecimal(item.MinLength)"
                                                  ValueChanged="@((string v) => { if (string.IsNullOrEmpty(v)) item.MinLength = null; else if (decimal.TryParse(v, out var d)) item.MinLength = d; })"
                                                  Dense="true"
                                                  Variant="Variant.Outlined"
                                                  Size="Size.Small"
                                                  Style="width: 90px;"
                                                  Disabled="@(orderDetail.Status == SalesOrderStatus.Cancelled)" />
                                </MudTd>

                                <!-- 最大长度（文本输入） -->
                                <MudTd>
                                    <MudTextField T="string"
                                                  Value="@FormatNullableDecimal(item.MaxLength)"
                                                  ValueChanged="@((string v) => { if (string.IsNullOrEmpty(v)) item.MaxLength = null; else if (decimal.TryParse(v, out var d)) item.MaxLength = d; })"
                                                  Dense="true"
                                                  Variant="Variant.Outlined"
                                                  Size="Size.Small"
                                                  Style="width: 90px;"
                                                  Disabled="@(orderDetail.Status == SalesOrderStatus.Cancelled)" />
                                </MudTd>

                                <!-- 支数（文本输入） -->
                                <MudTd>
                                    <MudTextField T="string"
                                                  Value="@(item.Quantity?.ToString() ?? "")"
                                                  ValueChanged="@((string v) => { if (string.IsNullOrEmpty(v)) item.Quantity = null; else if (int.TryParse(v, out var d)) item.Quantity = d; })"
                                                  Dense="true"
                                                  Variant="Variant.Outlined"
                                                  Size="Size.Small"
                                                  Style="width: 70px;"
                                                  Disabled="@(orderDetail.Status == SalesOrderStatus.Cancelled)" />
                                </MudTd>

                                <!-- 米数（文本输入 + 计算按钮） -->
                                <MudTd>
                                    <div style="display: flex; align-items: center; gap: 4px;">
                                        <MudTextField T="string"
                                                      Value="@FormatNullableDecimal(item.Meters)"
                                                      ValueChanged="@((string v) => { if (string.IsNullOrEmpty(v)) item.Meters = null; else if (decimal.TryParse(v, out var d)) item.Meters = d; })"
                                                      Dense="true"
                                                      Variant="Variant.Outlined"
                                                      Size="Size.Small"
                                                      Style="width: 90px;"
                                                      Disabled="@(orderDetail.Status == SalesOrderStatus.Cancelled)" />
                                        <MudIconButton Icon="@Icons.Material.Filled.Calculate"
                                                       Color="Color.Primary"
                                                       Size="Size.Small"
                                                       OnClick="() => CalculateMetersForViewModel(item)"
                                                       Disabled="@(orderDetail.Status == SalesOrderStatus.Cancelled)" />
                                    </div>
                                </MudTd>

                                <!-- 合同重量（文本输入） -->
                                <MudTd>
                                    <MudTextField T="string"
                                                  Value="@FormatDecimal(item.ContractWeight)"
                                                  ValueChanged="@((string v) => { if (decimal.TryParse(v, out var d)) item.ContractWeight = d; })"
                                                  Dense="true"
                                                  Variant="Variant.Outlined"
                                                  Size="Size.Small"
                                                  Style="width: 100px;"
                                                  Disabled="@(orderDetail.Status == SalesOrderStatus.Cancelled)" />
                                </MudTd>

                                <!-- 理算重量（只读 + 计算按钮） -->
                                <MudTd>
                                    <div style="display: flex; align-items: center; gap: 4px;">
                                        <MudText Typo="Typo.body2">@FormatDecimal(item.TheoreticalWeight)</MudText>
                                        <MudIconButton Icon="@Icons.Material.Filled.Calculate"
                                                       Color="Color.Primary"
                                                       Size="Size.Small"
                                                       OnClick="() => CalculateTheoreticalWeightForViewModel(item)"
                                                       Disabled="@(orderDetail.Status == SalesOrderStatus.Cancelled)" />
                                    </div>
                                </MudTd>

                                <!-- 删除操作 -->
                                @if (orderDetail.Status != SalesOrderStatus.Cancelled && editItemViewModels.Count > 1)
                                {
                                    <MudTd>
                                        <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                                       Color="Color.Error"
                                                       Size="Size.Small"
                                                       OnClick="() => RemoveItem(item)" />
                                    </MudTd>
                                }
                                else if (orderDetail.Status != SalesOrderStatus.Cancelled && editItemViewModels.Count == 1)
                                {
                                    <MudTd>
                                        <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                                       Color="Color.Error"
                                                       Size="Size.Small"
                                                       Disabled="true"
                                                       Title="订单至少需要保留一个项次" />
                                    </MudTd>
                                }
                            </RowTemplate>
                        </MudTable>
                    </div>

                    @if (editItemViewModels.Count == 0)
                    {
                        <MudAlert Severity="Severity.Info">暂无项次数据，请点击"添加项次"按钮添加。</MudAlert>
                    }
                }
            </MudCardContent>
        </MudCard>
    }
</div>

@code {
    [Parameter] public int Id { get; set; }
    private bool isEditMode => Navigation.Uri.Contains("/edit");
    private SalesOrderDetailDto? orderDetail;

    /// <summary>
    /// 编辑模式下的项次视图模型
    /// </summary>
    private class OrderItemViewModel
    {
        public int? Id { get; set; }
        public int Sequence { get; set; }
        public DateTime DeliveryDate { get; set; } = DateTime.Now.AddMonths(1);
        public bool DelayPenalty { get; set; }
        public SettlementMethod SettlementMethod { get; set; } = SettlementMethod.Theoretical;
        public MaterialName MaterialName { get; set; } = MaterialName.SeamlessPipe;
        public int ProductionStandardId { get; set; }
        public DeliveryState DeliveryState { get; set; } = DeliveryState.SolutionAnnealedAndPickled;
        public string StandardGrade { get; set; } = string.Empty;
        public decimal OuterDiameter { get; set; }
        public decimal WallThickness { get; set; }
        public decimal OuterDiameterNegative { get; set; }
        public decimal OuterDiameterPositive { get; set; }
        public decimal WallThicknessNegative { get; set; }
        public decimal WallThicknessPositive { get; set; }
        public LengthStatus LengthStatus { get; set; } = LengthStatus.Fixed;
        public decimal? MinLength { get; set; }
        public decimal? MaxLength { get; set; }
        public int? Quantity { get; set; }
        public decimal? Meters { get; set; }
        public decimal ContractWeight { get; set; }
        public decimal TheoreticalWeight { get; set; }
        public string? Remark { get; set; }

        public string ProductionStandardCode { get; set; } = string.Empty;
        public string PlantGrade { get; set; } = string.Empty;
        public decimal Density { get; set; }
    }

    private List<OrderItemViewModel> editItemViewModels = new();
    private List<int> itemsToDelete = new();
    private List<ProductionStandardDto> productionStandards = new();
    private List<StandardGradeMappingDto> gradeMappings = new();
    private bool isLoading = true;
    private bool isSubmitting;

    // ========== 格式化方法 ==========

    /// <summary>
    /// 格式化数值（去掉末尾多余的0）
    /// 例如：10.000 → 10, 19.050 → 19.05
    /// </summary>
    private string FormatDecimal(decimal value) => value.ToString("G29");

    private string FormatNullableDecimal(decimal? value) => value?.ToString("G29") ?? "";

    /// <summary>
    /// 格式化规格（去掉末尾多余的0）
    /// 例如：323.900*9.530 → 323.9*9.53
    /// </summary>
    private string FormatSpecification(string specification)
    {
        if (string.IsNullOrEmpty(specification)) return "";

        var parts = specification.Split('*');
        if (parts.Length != 2) return specification;

        var od = decimal.TryParse(parts[0], out var odValue) ? odValue.ToString("G29") : parts[0];
        var wt = decimal.TryParse(parts[1], out var wtValue) ? wtValue.ToString("G29") : parts[1];

        return $"{od}*{wt}";
    }

