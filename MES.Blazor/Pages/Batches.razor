@page "/batches"
@using MES.Blazor.Services
@using MES.Blazor.Helpers
@using MES.Core.DTOs
@using MES.Core.Models
@using MES.Core.Enums
@using Microsoft.AspNetCore.Authorization
@using MES.Blazor.Shared
@inject BatchService BatchService
@inject ProductionRecordService ProdRecordService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject IJSRuntime JS
@inject ColumnPrefsService ColumnPrefs
@attribute [Authorize(Roles = "BatchStaff,BatchDirector,Admin")]

<MudContainer MaxWidth="MaxWidth.False" Class="mt-4 pl-0">
    <!-- 工单号不匹配通知 -->
    @if (_workOrderMismatches is { Count: > 0 })
    {
        <MudAlert Severity="Severity.Warning" Variant="Variant.Filled" Class="mb-4">
            <div>
                @foreach (var mismatch in _workOrderMismatches)
                {
                    <div>批次 "@mismatch.BatchNo" 的工单号 "@mismatch.WorkOrderNo" 已不存在，需修改！</div>
                }
            </div>
        </MudAlert>
    }

    <MudCard>
        <MudCardHeader>
            <CardHeaderContent>
                <MudText Typo="Typo.h5" Class="font-weight-bold">
                    <MudIcon Icon="@Icons.Material.Filled.PrecisionManufacturing" Class="mr-2" Color="Color.Primary" />
                    生产批次
                </MudText>
            </CardHeaderContent>
            <CardHeaderActions>
                <MudButton Variant="Variant.Filled"
                           Color="Color.Info"
                           StartIcon="@Icons.Material.Filled.Sync"
                           OnClick="CheckWorkOrdersAsync"
                           Loading="@isSyncing"
                           Disabled="@isSyncing"
                           Class="ml-2">
                    即时更新
                </MudButton>
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Add"
                           OnClick="NavigateToCreate">
                    新建批次
                </MudButton>
                <MudButton Variant="Variant.Outlined"
                           Color="Color.Info"
                           StartIcon="@Icons.Material.Filled.Print"
                           OnClick='() => Navigation.NavigateTo("/process-card-print")'
                           Class="ml-2">
                    工艺卡打印
                </MudButton>
            </CardHeaderActions>
        </MudCardHeader>

        <MudCardContent>
            <!-- 搜索栏 -->
            <MudGrid>
                <MudItem xs="12" md="6">
                    <MudTextField T="string"
                                  Label="模糊搜索"
                                  Value="_searchKeyword"
                                  ValueChanged="@OnSearchChanged"
                                  Immediate="true"
                                  DebounceInterval="500"
                                  Clearable="true"
                                  ClearButton="true"
                                  Adornment="Adornment.End"
                                  AdornmentIcon="@Icons.Material.Filled.Search" />
                </MudItem>
                <MudItem xs="6" md="3">
                    <MudSelect T="string"
                               Label="状态筛选"
                               Value="filterStatus"
                               ValueChanged="@OnStatusFilterChanged"
                               Clearable="true"
                               Adornment="Adornment.End"
                               AdornmentIcon="@Icons.Material.Filled.FilterList">
                        <MudSelectItem Value="@("None")">未产</MudSelectItem>
                        <MudSelectItem Value="@("InProgress")">在产</MudSelectItem>
                        <MudSelectItem Value="@("Completed")">完成</MudSelectItem>
                    </MudSelect>
                </MudItem>
            </MudGrid>

            <!-- 数据表格 -->
            <MudTable @ref="table"
                      T="ProductionBatchListDto"
                      ServerData="OnServerData"
                      Loading="@isLoading"
                      Dense="true"
                      Hover="true"
                      Class="mt-4 auto-table"
                      Elevation="0"
                      RowsPerPageLabel="每页行数:">
                <ToolBarContent>
                    <ColumnDisplaySelect Columns="_allColumns"
                                         OnColumnToggle="OnColumnToggle"
                                         OnMoveUp="MoveColumnUp"
                                         OnMoveDown="MoveColumnDown" />
                    <MudButton Variant="Variant.Text" Size="Size.Small"
                               Color="Color.Default"
                               StartIcon="@Icons.Material.Filled.RestartAlt"
                               OnClick="ResetColumnDisplay" Class="ml-2">
                        重置
                    </MudButton>
                    <MudSpacer />
                    <MudButton Variant="Variant.Outlined"
                               Size="Size.Small"
                               Color="Color.Info"
                               StartIcon="@Icons.Material.Filled.Print"
                               Disabled="@(!selectedIds.Any())"
                               OnClick="PrintSelected">
                        打印选中 (@selectedIds.Count)
                    </MudButton>
                    <MudButton Variant="Variant.Text"
                               Size="Size.Small"
                               Color="Color.Info"
                               StartIcon="@Icons.Material.Filled.Print"
                               OnClick="PrintAll">
                        打印全部
                    </MudButton>
                    <MudText Typo="Typo.body2" Class="ml-auto">
                        共 @totalCount 条记录
                    </MudText>
                </ToolBarContent>
                <HeaderContent>
                    <MudTh Style="width: 40px;">
                        <MudCheckBox T="bool" @bind-Value="allSelected" Dense="true" />
                    </MudTh>
                    @foreach (var col in _visibleColumns)
                    {
                        <MudTh>
                            @if (!string.IsNullOrEmpty(col.SortKey))
                            {
                                <span @onclick='() => ToggleSort(col.SortKey)' class="sortable-header">
                                    @col.Label
                                </span>
                                @if (sortColumn == col.SortKey)
                                {
                                    <span class="sort-arrow">@GetSortIndicator(col.SortKey)</span>
                                }
                            }
                            else
                            {
                                <span class="th-label">@col.Label</span>
                            }
                        </MudTh>
                    }
                    <MudTh>操作</MudTh>
                </HeaderContent>
                <RowTemplate Context="item">
                    <MudTd Style="width: 40px;">
                        <MudCheckBox T="bool"
                                     Value="@selectedIds.Contains(item.Id)"
                                     ValueChanged="@((v) => { if(v) selectedIds.Add(item.Id); else selectedIds.Remove(item.Id); _allSelected = items.Any() && items.All(i => selectedIds.Contains(i.Id)); StateHasChanged(); })"
                                     Dense="true" />
                    </MudTd>
                    @foreach (var col in _visibleColumns)
                    {
                        <MudTd>@RenderCell(item, col)</MudTd>
                    }
                    <MudTd>
                        <MudIconButton Icon="@Icons.Material.Filled.Visibility"
                                       Color="Color.Info"
                                       Size="Size.Small"
                                       OnClick="@(() => ViewDetail(item.Id))"
                                       Title="查看详情" />
                        <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                       Color="Color.Warning"
                                       Size="Size.Small"
                                       OnClick="@(() => GoToEdit(item.Id))"
                                       Title="编辑" />
                        <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                       Color="Color.Error"
                                       Size="Size.Small"
                                       OnClick="@(() => DeleteItem(item))"
                                       Title="删除" />
                    </MudTd>
                </RowTemplate>
                <PagerContent>
                    <MudTablePager />
                </PagerContent>
            </MudTable>
        </MudCardContent>
    </MudCard>
</MudContainer>

@code {
    private MudTable<ProductionBatchListDto>? table;
    private List<ProductionBatchListDto> items = new();
    private HashSet<int> selectedIds = new();
    private List<BatchWorkOrderMismatchDto> _workOrderMismatches = new();
    private bool isSyncing = false;
    private bool _allSelected;
    private bool allSelected
    {
        get => _allSelected;
        set
        {
            if (_allSelected == value) return;
            _allSelected = value;
            if (value)
            {
                foreach (var item in items)
                    selectedIds.Add(item.Id);
            }
            else
            {
                selectedIds.Clear();
            }
            StateHasChanged();
        }
    }
    private bool isLoading;
    private string _searchKeyword = string.Empty;
    private string filterStatus = string.Empty;
    private int totalCount;

    private string sortColumn = "batchno";
    private bool sortDescending = true;

    // ========== 列定义 ==========

    private List<ColumnDef> _allColumns = new();
    private List<ColumnDef> _visibleColumns =>
        _allColumns.Where(c => c.IsApplicable && c.Visible).ToList();

    private static List<ColumnDef> GetAllColumnDefs() => new()
    {
        new() { Key = "BatchNo",            Label = "生产编号", SortKey = "batchno" },
        new() { Key = "TagNo",              Label = "挂牌号",   SortKey = "tagno" },
        new() { Key = "CreatedTime",        Label = "创建时间", SortKey = "createdtime" },
        new() { Key = "UpdatedTime",        Label = "最后更新时间", SortKey = "updatedtime" },
        new() { Key = "WorkOrderNo",        Label = "工单号",   SortKey = "workorderno" },
        new() { Key = "SalesOrderNo",       Label = "订单号",   SortKey = "salesorderno" },
        new() { Key = "ProductionMainNo",   Label = "主号",     SortKey = "productionmainno" },
        new() { Key = "ProductionSubNo",    Label = "次号",     SortKey = "productionsubno" },
        new() { Key = "ProductionType",     Label = "生产类型", SortKey = "productiontype" },
        new() { Key = "Status",             Label = "状态",     SortKey = "status" },
        new() { Key = "CurrentExecDate",    Label = "截止执行日", SortKey = "currentexecdate" },
        new() { Key = "CurrentGroupName",   Label = "当前工序", SortKey = "currentgroupname" },
        new() { Key = "CurrentSectionName", Label = "当前工段", SortKey = "currentsectionname" },
        new() { Key = "CurrentEquipmentName", Label = "当前设备", SortKey = "currentequipmentname" },
        new() { Key = "CurrentOutsource",   Label = "当前委外", SortKey = "currentoutsource" },
        new() { Key = "CurrentSpec",        Label = "当前规格", SortKey = "currentspec" },
        new() { Key = "NextSectionName",    Label = "下一工段", SortKey = "nextsectionname" },
        new() { Key = "CorrespondingSpec",  Label = "对应规格", SortKey = "correspondingspec" },
    };

    // ========== 列选择操作 ==========

    private async Task OnColumnToggle(ColumnDef col)
    {
        await SaveColumnPrefs();
    }

    private async Task SaveColumnPrefs()
    {
        await ColumnPrefs.SaveAsync("batches", null, _allColumns);
    }

    private async Task ResetColumnDisplay()
    {
        _allColumns = GetAllColumnDefs();
        await SaveColumnPrefs();
    }

    private async Task MoveColumnUp(ColumnDef col)
    {
        await SaveColumnPrefs();
    }

    private async Task MoveColumnDown(ColumnDef col)
    {
        await SaveColumnPrefs();
    }

    // ========== 初始化 ==========

    protected override async Task OnInitializedAsync()
    {
        _allColumns = GetAllColumnDefs();
        var saved = await ColumnPrefs.LoadAsync("batches", null);
        if (saved.Count > 0)
        {
            foreach (var s in saved)
            {
                var match = _allColumns.FirstOrDefault(c => c.Key == s.Key);
                if (match != null)
                    match.Visible = s.Visible;
            }
            var reordered = new List<ColumnDef>();
            foreach (var s in saved)
            {
                var match = _allColumns.FirstOrDefault(c => c.Key == s.Key);
                if (match != null && !reordered.Contains(match))
                    reordered.Add(match);
            }
            foreach (var c in _allColumns)
            {
                if (!reordered.Contains(c))
                    reordered.Add(c);
            }
            _allColumns = reordered;
        }

        await CheckWorkOrdersAsync();
    }

    // ========== 即时更新（工单号验证 + 执行状态刷新）==========

    private async Task CheckWorkOrdersAsync()
    {
        isSyncing = true;
        try
        {
            // 1) 工单号验证
            var verifyResult = await BatchService.VerifyWorkOrderNosAsync();
            if (verifyResult.Success && verifyResult.Data != null)
            {
                _workOrderMismatches = verifyResult.Data;
                if (_workOrderMismatches.Count > 0)
                    Snackbar.Add($"发现 {_workOrderMismatches.Count} 个批次的工单号不匹配", Severity.Warning);
                else
                    Snackbar.Add("所有批次工单号验证通过", Severity.Success);
            }

            // 2) 刷新当前分页批次的执行状态
            var currentIds = items.Select(i => i.Id).ToList();
            if (currentIds.Count > 0)
            {
                var refreshTasks = currentIds.Select(id => ProdRecordService.RefreshBatchTrackingAsync(id));
                var results = await Task.WhenAll(refreshTasks);
                var failCount = results.Count(r => !r.Success);
                if (failCount > 0)
                    Snackbar.Add($"执行状态刷新：{results.Length - failCount} 成功，{failCount} 失败", Severity.Warning);
                else
                    Snackbar.Add($"已刷新 {results.Length} 个批次的执行状态", Severity.Success);

                // 重载当前页
                if (table != null)
                    await table.ReloadServerData();
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"即时更新失败: {ex.Message}", Severity.Error);
        }
        finally
        {
            isSyncing = false;
            StateHasChanged();
        }
    }

    private string GetSortIndicator(string column)
    {
        if (sortColumn != column) return "";
        return sortDescending ? "\u25BC" : "\u25B2";
    }

    private async Task<TableData<ProductionBatchListDto>> OnServerData(TableState state)
    {
        isLoading = true;
        StateHasChanged();

        try
        {
            var queryParams = new BatchQueryParams
            {
                PageIndex = state.Page + 1,
                PageSize = state.PageSize,
                Keyword = string.IsNullOrWhiteSpace(_searchKeyword) ? null : _searchKeyword,
                Status = string.IsNullOrWhiteSpace(filterStatus) ? null : filterStatus,
                SortBy = sortColumn,
                IsDescending = sortDescending
            };

            var result = await BatchService.GetPagedAsync(queryParams);

            if (result.Success && result.Data != null)
            {
                items = result.Data.Items;
                totalCount = result.Data.TotalCount;
                return new TableData<ProductionBatchListDto>
                {
                    Items = items,
                    TotalItems = totalCount
                };
            }

            return new TableData<ProductionBatchListDto>
            {
                Items = new List<ProductionBatchListDto>(),
                TotalItems = 0
            };
        }
        catch (Exception ex)
        {
            Snackbar.Add($"加载失败: {ex.Message}", Severity.Error);
            return new TableData<ProductionBatchListDto>
            {
                Items = new List<ProductionBatchListDto>(),
                TotalItems = 0
            };
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task ToggleSort(string column)
    {
        if (sortColumn == column)
            sortDescending = !sortDescending;
        else
        {
            sortColumn = column;
            sortDescending = false;
        }
        if (table != null)
            await table.ReloadServerData();
    }

    private async Task Search()
    {
        if (table != null)
            await table.ReloadServerData();
    }

    private async Task OnSearchChanged(string value)
    {
        _searchKeyword = value ?? string.Empty;
        if (table != null)
            await table.ReloadServerData();
    }

    private async Task OnStatusFilterChanged(string value)
    {
        filterStatus = value ?? string.Empty;
        if (table != null)
            await table.ReloadServerData();
    }

    private void NavigateToCreate() => Navigation.NavigateTo("/batches/create");
    private void ViewDetail(int id) => Navigation.NavigateTo($"/batches/{id}");
    private void GoToEdit(int id) => Navigation.NavigateTo($"/batches/{id}/edit");

    private async Task DeleteItem(ProductionBatchListDto item)
    {
        var dialog = DialogService.Show<ConfirmDialog>("确认", new DialogParameters
        {
            ["ContentText"] = $"确定要删除生产批次 \"{item.BatchNo}\" 吗？\n\n删除后数据将不可恢复！",
            ["ConfirmText"] = "确认删除",
            ["Color"] = Color.Error
        });
        var dialogResult = await dialog.Result;
        if (!dialogResult.Canceled)
        {
            try
            {
                var result = await BatchService.DeleteAsync(item.Id);
                if (result.Success)
                {
                    Snackbar.Add("删除成功", Severity.Success);
                    await Search();
                }
                else
                {
                    Snackbar.Add(result.Message ?? "删除失败", Severity.Error);
                }
            }
            catch (Exception ex)
            {
                Snackbar.Add($"删除失败: {ex.Message}", Severity.Error);
            }
        }
    }

    // ========== 单元格渲染 ==========

    private RenderFragment RenderCell(ProductionBatchListDto item, ColumnDef col) => builder =>
    {
        switch (col.Key)
        {
            case "BatchNo":
                builder.OpenComponent<MudLink>(0);
                builder.AddAttribute(1, "Typo", Typo.body2);
                builder.AddAttribute(2, "OnClick", EventCallback.Factory.Create<MouseEventArgs?>(this, () => ViewDetail(item.Id)));
                builder.AddAttribute(3, "ChildContent", (RenderFragment)(b2 => b2.AddContent(0, item.BatchNo)));
                builder.CloseComponent();
                break;
            case "Status":
                builder.OpenComponent<MudChip>(0);
                builder.AddAttribute(1, "Size", Size.Small);
                builder.AddAttribute(2, "Color", DisplayHelper.GetBatchStatusColor(item.Status));
                builder.AddAttribute(3, "ChildContent", (RenderFragment)(b2 => b2.AddContent(0, DisplayHelper.GetBatchStatusText(item.Status))));
                builder.CloseComponent();
                break;
            case "CreatedTime":
                builder.AddContent(0, item.CreatedTime.LocalDateTime.ToString("yyyy-MM-dd HH:mm"));
                break;
            case "UpdatedTime":
                builder.AddContent(0, item.UpdatedTime.LocalDateTime.ToString("yyyy-MM-dd HH:mm"));
                break;
            case "CurrentExecDate":
                builder.AddContent(0, item.CurrentExecDate?.ToString("yyyy-MM-dd") ?? "");
                break;
            default:
                var val = GetColumnValue(item, col.Key);
                builder.AddContent(0, val);
                break;
        }
    };

    private static string GetColumnValue(ProductionBatchListDto item, string key) => key switch
    {
        "TagNo" => item.TagNo ?? "",
        "WorkOrderNo" => item.WorkOrderNo,
        "SalesOrderNo" => item.SalesOrderNo,
        "ProductionMainNo" => item.ProductionMainNo,
        "ProductionSubNo" => item.ProductionSubNo ?? "",
        "ProductionType" => DisplayHelper.GetProductionTypeText(item.ProductionType),
        "CurrentGroupName" => item.CurrentGroupName ?? "",
        "CurrentSectionName" => item.CurrentSectionName ?? "",
        "CurrentEquipmentName" => item.CurrentEquipmentName ?? "",
        "CurrentOutsource" => item.CurrentOutsource ?? "",
        "CurrentSpec" => item.CurrentSpec ?? "",
        "NextSectionName" => item.NextSectionName ?? "",
        "CorrespondingSpec" => item.CorrespondingSpec ?? "",
        _ => ""
    };

    // ========== 打印方法 ==========

    private async Task PrintSelected()
    {
        if (!selectedIds.Any())
        {
            Snackbar.Add("请先选择要打印的批次", Severity.Warning);
            return;
        }
        try
        {
            var ids = selectedIds.ToArray();
            var result = await BatchService.PrintBatchSelectedAsync(ids);
            if (result.Success && result.Data != null)
                await JS.InvokeVoidAsync("openPdf", result.Data);
            else
                Snackbar.Add(result.Message ?? "打印失败", Severity.Error);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"打印失败: {ex.Message}", Severity.Error);
        }
    }

    private async Task PrintAll()
    {
        try
        {
            var request = new BatchPrintAllRequest
            {
                Keyword = string.IsNullOrWhiteSpace(_searchKeyword) ? null : _searchKeyword,
                Status = string.IsNullOrWhiteSpace(filterStatus) ? null : filterStatus
            };
            var result = await BatchService.PrintBatchAllAsync(request);
            if (result.Success && result.Data != null)
                await JS.InvokeVoidAsync("openPdf", result.Data);
            else
                Snackbar.Add(result.Message ?? "打印失败", Severity.Error);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"打印失败: {ex.Message}", Severity.Error);
        }
    }
}
