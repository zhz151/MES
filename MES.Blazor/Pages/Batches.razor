@page "/batches"
@using MES.Blazor.Services
@using MES.Blazor.Helpers
@using MES.Core.DTOs
@using MES.Core.Models
@using MES.Core.Enums
@using Microsoft.AspNetCore.Authorization
@using MES.Blazor.Shared
@inject BatchService BatchService
@inject ProductionRecordService ProdRecordService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject WorkOrderService WorkOrderService
@inject OrderService OrderService
@inject IJSRuntime JS
@inject ColumnPrefsService ColumnPrefs
@attribute [Authorize(Roles = "BatchStaff,BatchDirector,Admin")]

<MudContainer MaxWidth="MaxWidth.False" Class="mt-4 pl-0">
    <!-- 工单号不匹配通知 -->
    @if (_workOrderMismatches is { Count: > 0 })
    {
        <MudAlert Severity="Severity.Warning" Variant="Variant.Filled" Class="mb-4">
            <div>
                @foreach (var mismatch in _workOrderMismatches)
                {
                    <div>批次 "@mismatch.BatchNo" 的工单号 "@mismatch.WorkOrderNo" 已不存在，需修改！</div>
                }
            </div>
        </MudAlert>
    }

    <MudCard>
        <MudCardHeader>
            <CardHeaderContent>
                <MudText Typo="Typo.h5" Class="font-weight-bold">
                    <MudIcon Icon="@Icons.Material.Filled.PrecisionManufacturing" Class="mr-2" Color="Color.Primary" />
                    生产批次
                </MudText>
            </CardHeaderContent>
            <CardHeaderActions>
                <MudButton Variant="Variant.Filled"
                           Color="Color.Info"
                           StartIcon="@Icons.Material.Filled.Sync"
                           OnClick="CheckWorkOrdersAsync"
                           Loading="@isSyncing"
                           Disabled="@isSyncing"
                           Class="ml-2">
                    即时更新
                </MudButton>
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Add"
                           OnClick="NavigateToCreate">
                    新建批次
                </MudButton>
                <MudButton Variant="Variant.Outlined"
                           Color="Color.Info"
                           StartIcon="@Icons.Material.Filled.Print"
                           OnClick='() => Navigation.NavigateTo("/process-card-print")'
                           Class="ml-2">
                    工艺卡打印
                </MudButton>
            </CardHeaderActions>
        </MudCardHeader>

        <MudCardContent>
            <!-- 搜索栏 -->
            <MudGrid>
                <MudItem xs="12" md="6">
                    <MudTextField T="string"
                                  Label="模糊搜索"
                                  Value="_searchKeyword"
                                  ValueChanged="@OnSearchChanged"
                                  Immediate="true"
                                  DebounceInterval="500"
                                  Clearable="true"
                                  ClearButton="true"
                                  Adornment="Adornment.End"
                                  AdornmentIcon="@Icons.Material.Filled.Search" />
                </MudItem>
                <MudItem xs="6" md="3">
                    <MudSelect T="string"
                               Label="有效投料疑问"
                               Value="@_validInputQuestionFilter"
                               ValueChanged="@OnValidInputQuestionFilterChanged"
                               Clearable="true"
                               Adornment="Adornment.End"
                               AdornmentIcon="@Icons.Material.Filled.FilterList">
                        <MudSelectItem Value="@("正常")">正常</MudSelectItem>
                        <MudSelectItem Value="@("疑问")">疑问</MudSelectItem>
                    </MudSelect>
                </MudItem>
            </MudGrid>

            <!-- 数据表格 -->
            <MudTable @ref="table"
                      T="ProductionBatchListDto"
                      Items="@_filteredItems"
                      Dense="true"
                      Hover="true"
                      Class="mt-4 auto-table"
                      Elevation="0"
                      RowsPerPage="10"
                      RowsPerPageLabel="每页行数:">
                <ToolBarContent>
                    <ColumnDisplaySelect Columns="_allColumns"
                                         OnColumnToggle="OnColumnToggle"
                                         OnMoveUp="MoveColumnUp"
                                         OnMoveDown="MoveColumnDown" />
                    <MudButton Variant="Variant.Text" Size="Size.Small"
                               Color="Color.Default"
                               StartIcon="@Icons.Material.Filled.RestartAlt"
                               OnClick="ResetColumnDisplay" Class="ml-2">
                        重置
                    </MudButton>
                    <MudSpacer />
                    <MudButton Variant="Variant.Outlined"
                               Size="Size.Small"
                               Color="Color.Info"
                               StartIcon="@Icons.Material.Filled.Print"
                               Disabled="@(!selectedIds.Any())"
                               OnClick="PrintSelected">
                        打印选中 (@selectedIds.Count)
                    </MudButton>
                    <MudButton Variant="Variant.Text"
                               Size="Size.Small"
                               Color="Color.Info"
                               StartIcon="@Icons.Material.Filled.Print"
                               OnClick="PrintAll">
                        打印全部
                    </MudButton>
                    <MudText Typo="Typo.body2" Class="ml-auto">
                        共 @(_filteredItems?.Count ?? 0) 条记录
                    </MudText>
                </ToolBarContent>
                <HeaderContent>
                    <MudTh Style="width: 40px;">
                        <MudCheckBox T="bool" @bind-Value="allSelected" Dense="true" />
                    </MudTh>
                    @foreach (var col in _visibleColumns)
                    {
                        <MudTh>
                            <div style="display:inline-flex; align-items:center; gap:4px;">
                                <span class="th-label">@col.Label</span>
                                @if (col.FilterType != null)
                                {
                                    @* 使用原始全量数据供筛选器计算可选值 *@
                                    <ExcelFilter T="ProductionBatchListDto"
                                                 Label="@col.Label"
                                                 FieldKey="@col.Key"
                                                 AllItems="@_allItems"
                                                 ActiveFilterValues="@(_columnFilters.GetValueOrDefault(col.Key))"
                                                 DisplaySelector="@(x => GetCellDisplayText(x, col.Key))"
                                                 RawValueSelector="@(x => GetCellRawValue(x, col.Key))"
                                                 FilterChanged="@(args => OnColumnFilterChanged(args.fieldKey, args.selectedValues))"
                                                 SortRequested="@(args => OnExcelSortRequested(args.fieldKey, args.ascending))" />
                                }
                            </div>
                        </MudTh>
                    }
                    <MudTh>操作</MudTh>
                </HeaderContent>
                <RowTemplate Context="item">
                    <MudTd Style="width: 40px;">
                        <MudCheckBox T="bool"
                                     Value="@selectedIds.Contains(item.Id)"
                                     ValueChanged="@((v) => { if(v) selectedIds.Add(item.Id); else selectedIds.Remove(item.Id); _allSelected = _filteredItems.Any() && _filteredItems.All(i => selectedIds.Contains(i.Id)); StateHasChanged(); })"
                                     Dense="true" />
                    </MudTd>
                    @foreach (var col in _visibleColumns)
                    {
                        <MudTd>@RenderCell(item, col)</MudTd>
                    }
                    <MudTd>
                        <MudIconButton Icon="@Icons.Material.Filled.Visibility"
                                       Color="Color.Info"
                                       Size="Size.Small"
                                       OnClick="@(() => ViewDetail(item.Id))"
                                       Title="查看详情" />
                        <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                       Color="Color.Warning"
                                       Size="Size.Small"
                                       OnClick="@(() => GoToEdit(item.Id))"
                                       Title="编辑" />
                        <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                       Color="Color.Error"
                                       Size="Size.Small"
                                       OnClick="@(() => DeleteItem(item))"
                                       Title="删除" />
                    </MudTd>
                </RowTemplate>
                <PagerContent>
                    <MudTablePager PageSizeOptions="new int[]{10,15,25,50,100}" />
                </PagerContent>
            </MudTable>
        </MudCardContent>
    </MudCard>
</MudContainer>

@code {
    private MudTable<ProductionBatchListDto>? table;
    private List<ProductionBatchListDto> _allItems = new();
    private List<ProductionBatchListDto>? _filteredItemsList;
    private List<ProductionBatchListDto> _filteredItems => _filteredItemsList ?? _allItems;
    private HashSet<int> selectedIds = new();
    private List<BatchWorkOrderMismatchDto> _workOrderMismatches = new();
    private bool isSyncing = false;
    private bool _allSelected;
    private bool allSelected
    {
        get => _allSelected;
        set
        {
            if (_allSelected == value) return;
            _allSelected = value;
            if (value)
            {
                foreach (var item in _filteredItems)
                    selectedIds.Add(item.Id);
            }
            else
            {
                selectedIds.Clear();
            }
            StateHasChanged();
        }
    }
    private string _searchKeyword = string.Empty;
    private string _validInputQuestionFilter = string.Empty;

    private string sortColumn = "batchno";
    private bool sortDescending = true;

    // ========== ExcelFilter 状态 ==========
    private Dictionary<string, HashSet<string>> _columnFilters = new();
    private Dictionary<string, List<ProductionBatchListDto>> _filterContexts = new();

    // ========== 列定义 ==========

    private List<ColumnDef> _allColumns = new();
    private List<ColumnDef> _visibleColumns =>
        _allColumns.Where(c => c.IsApplicable && c.Visible).ToList();

    private static List<ColumnDef> GetAllColumnDefs() => new()
    {
        new() { Key = "BatchNo",            Label = "生产编号", SortKey = "batchno", FilterType = "string" },
        new() { Key = "TagNo",              Label = "挂牌号",   SortKey = "tagno", FilterType = "string" },
        new() { Key = "CreatedTime",        Label = "创建时间", SortKey = "createdtime", FilterType = "date" },
        new() { Key = "UpdatedTime",        Label = "最后更新时间", SortKey = "updatedtime", FilterType = "date" },
        new() { Key = "WorkOrderNo",        Label = "工单号",   SortKey = "workorderno", FilterType = "string" },
        new() { Key = "SalesOrderNo",       Label = "订单号",   SortKey = "salesorderno", FilterType = "string" },
        new() { Key = "ProductionMainNo",   Label = "主号",     SortKey = "productionmainno", FilterType = "string" },
        new() { Key = "ProductionSubNo",    Label = "次号",     SortKey = "productionsubno", FilterType = "string" },
        new() { Key = "ProductionType",     Label = "生产类型", SortKey = "productiontype", FilterType = "enum",
            EnumOptions = new() { new("Normal", "正常"), new("Sample", "样品"), new("NewProduct", "新品") } },
        new() { Key = "ManufacturingItem",  Label = "制造物品", SortKey = "manufacturingitem", FilterType = "string" },
        new() { Key = "Status",             Label = "状态",     SortKey = "status", FilterType = "enum",
            EnumOptions = new() { new("None", "无"), new("InProgress", "在产"), new("Completed", "完成"), new("Suspended", "暂停"), new("Cancelled", "取消") } },
        new() { Key = "CurrentExecDate",    Label = "截止执行日", SortKey = "currentexecdate", FilterType = "date" },
        new() { Key = "CurrentGroupName",   Label = "当前工序", SortKey = "currentgroupname", FilterType = "string" },
        new() { Key = "CurrentSectionName", Label = "当前工段", SortKey = "currentsectionname", FilterType = "string" },
        new() { Key = "CurrentEquipmentName", Label = "当前设备", SortKey = "currentequipmentname", FilterType = "string" },
        new() { Key = "CurrentOutsource",   Label = "当前委外", SortKey = "currentoutsource", FilterType = "string" },
        new() { Key = "CurrentSpec",        Label = "当前规格", SortKey = "currentspec", FilterType = "string" },
        new() { Key = "NextSectionName",    Label = "下一工段", SortKey = "nextsectionname", FilterType = "string" },
        new() { Key = "CorrespondingSpec",  Label = "对应规格", SortKey = "correspondingspec", FilterType = "string" },
        new() { Key = "CurrentValidQty",    Label = "现有效原料支数", SortKey = "currentvalidqty", FilterType = "number" },
        new() { Key = "CurrentValidWeight",  Label = "现有效原料重量", SortKey = "currentvalidweight", FilterType = "number" },
        new() { Key = "ProductionRatio",    Label = "制几率",   SortKey = "productionratio", FilterType = "number" },
        new() { Key = "SignDate",           Label = "签订日期", SortKey = "signdate", FilterType = "date" },
        new() { Key = "Salesman",           Label = "业务员",   SortKey = "salesman", FilterType = "string" },
        new() { Key = "EndCustomer",        Label = "最终用户", SortKey = "endcustomer", FilterType = "string" },
        new() { Key = "DeliveryDate",       Label = "交货日期", SortKey = "deliverydate", FilterType = "date" },
        new() { Key = "DelayPenalty",       Label = "延期罚款", SortKey = "delaypenalty", FilterType = "enum",
            EnumOptions = new() { new("true", "是"), new("false", "否") } },
        new() { Key = "MaterialName",       Label = "物料名称", SortKey = "materialname", FilterType = "enum",
            EnumOptions = new() { new("Tube", "管材"), new("Pipe", "管道"), new("Bar", "棒材"), new("Fitting", "管件"), new("Wire", "线材"), new("Strip", "带材"), new("Sheet", "板材"), new("Profile", "型材"), new("Other", "其他") } },
        new() { Key = "SettlementMethod",   Label = "结算方式", SortKey = "settlementmethod", FilterType = "enum",
            EnumOptions = new() { new("MonthlyStatement", "月结"), new("PerOrder", "单结"), new("Deposit", "定金"), new("FullPayment", "全款") } },
        new() { Key = "StandardCode",       Label = "产品标准", SortKey = "standardcode", FilterType = "string" },
        new() { Key = "DeliveryState",      Label = "交货状态", SortKey = "deliverystate", FilterType = "enum",
            EnumOptions = new() { new("Raw", "原料"), new("SemiFinished", "半成品"), new("Finished", "成品") } },
        new() { Key = "PlantGrade",         Label = "钢种",     SortKey = "plantgrade", FilterType = "string" },
        new() { Key = "Specification",      Label = "规格",     SortKey = "specification", FilterType = "string" },
        new() { Key = "LengthStatus",       Label = "长度状态", SortKey = "lengthstatus", FilterType = "enum",
            EnumOptions = new() { new("FixedLength", "定尺"), new("RandomLength", "不定尺"), new("MultipleLength", "倍尺") } },
        new() { Key = "TotalQuantity",      Label = "总数量",   SortKey = "totalquantity", FilterType = "number" },
        new() { Key = "TotalMeters",        Label = "总米数",   SortKey = "totalmeters", FilterType = "number" },
        new() { Key = "TotalWeight",        Label = "总重量",   SortKey = "totalweight", FilterType = "number" },
        new() { Key = "TechnicalRequirements", Label = "技术要求", SortKey = "technicalrequirements", FilterType = "enum",
            EnumOptions = new() { new("GB150", "GB150"), new("GB9948", "GB9948"), new("ASME", "ASME"), new("Other", "其他") } },
        new() { Key = "ValidInputQuestion",   Label = "有效投料疑问", SortKey = null },
        new() { Key = "CreatedBy",          Label = "创建人",   SortKey = "createdby", FilterType = "string" },
    };

    // ========== 列选择操作 ==========

    private async Task OnColumnToggle(ColumnDef col)
    {
        await SaveColumnPrefs();
    }

    private async Task SaveColumnPrefs()
    {
        await ColumnPrefs.SaveAsync("batches", null, _allColumns);
    }

    private async Task ResetColumnDisplay()
    {
        _allColumns = GetAllColumnDefs();
        await SaveColumnPrefs();
    }

    private async Task MoveColumnUp(ColumnDef col)
    {
        await SaveColumnPrefs();
    }

    private async Task MoveColumnDown(ColumnDef col)
    {
        await SaveColumnPrefs();
    }

    // ========== 初始化 ==========

    protected override async Task OnInitializedAsync()
    {
        _allColumns = GetAllColumnDefs();
        var saved = await ColumnPrefs.LoadAsync("batches", null);
        if (saved.Count > 0)
        {
            foreach (var s in saved)
            {
                var match = _allColumns.FirstOrDefault(c => c.Key == s.Key);
                if (match != null)
                    match.Visible = s.Visible;
            }
            var reordered = new List<ColumnDef>();
            foreach (var s in saved)
            {
                var match = _allColumns.FirstOrDefault(c => c.Key == s.Key);
                if (match != null && !reordered.Contains(match))
                    reordered.Add(match);
            }
            foreach (var c in _allColumns)
            {
                if (!reordered.Contains(c))
                    reordered.Add(c);
            }
            _allColumns = reordered;
        }

        await LoadAllDataAsync();
    }

    private async Task LoadAllDataAsync()
    {
        try
        {
            _allItems = await BatchService.GetAllBatchListAsync();
            _filteredItemsList = null; // 重置以使用 _allItems 全量数据
            RefreshFilteredData();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"加载失败: {ex.Message}", Severity.Error);
        }
        finally
        {
            StateHasChanged();
        }
    }

    // ========== 即时更新（工单号验证 + 执行状态刷新）==========

    private async Task CheckWorkOrdersAsync()
    {
        isSyncing = true;
        try
        {
            // 1) 工单号验证
            var verifyResult = await BatchService.VerifyWorkOrderNosAsync();
            if (verifyResult.Success && verifyResult.Data != null)
            {
                _workOrderMismatches = verifyResult.Data;
                if (_workOrderMismatches.Count > 0)
                    Snackbar.Add($"发现 {_workOrderMismatches.Count} 个批次的工单号不匹配", Severity.Warning);
                else
                    Snackbar.Add("所有批次工单号验证通过", Severity.Success);
            }

            // 2) 刷新全量批次的执行状态
            if (_allItems.Count > 0)
            {
                var currentIds = _allItems.Select(i => i.Id).ToList();
                var refreshTasks = currentIds.Select(id => ProdRecordService.RefreshBatchTrackingAsync(id));
                var results = await Task.WhenAll(refreshTasks);
                var failCount = results.Count(r => !r.Success);
                if (failCount > 0)
                    Snackbar.Add($"执行状态刷新：{results.Length - failCount} 成功，{failCount} 失败", Severity.Warning);
                else
                    Snackbar.Add($"已刷新 {results.Length} 个批次的执行状态", Severity.Success);

                // 重新加载数据
                await LoadAllDataAsync();
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"即时更新失败: {ex.Message}", Severity.Error);
        }
        finally
        {
            isSyncing = false;
            StateHasChanged();
        }
    }

    // ========== 搜索 ==========

    private async Task OnSearchChanged(string value)
    {
        _searchKeyword = value ?? string.Empty;
        RefreshFilteredData();
    }

    private async Task OnValidInputQuestionFilterChanged(string value)
    {
        _validInputQuestionFilter = value ?? string.Empty;
        RefreshFilteredData();
    }

    // ========== ExcelFilter 回调 ==========

    private async Task OnColumnFilterChanged(string fieldKey, HashSet<string> selectedValues)
    {
        if (selectedValues.Count > 0)
            _columnFilters[fieldKey] = selectedValues;
        else
            _columnFilters.Remove(fieldKey);

        RefreshFilteredData();
        await SavePageStateAsync();
    }

    private async Task OnExcelSortRequested(string fieldKey, bool ascending)
    {
        sortColumn = fieldKey;
        sortDescending = !ascending;
        RefreshFilteredData();
        await SavePageStateAsync();
    }

    // ========== 客户端刷新 ==========

    private void RefreshFilteredData()
    {
        var query = _allItems.AsEnumerable();

        // 关键字搜索
        if (!string.IsNullOrWhiteSpace(_searchKeyword))
        {
            var kw = _searchKeyword;
            query = query.Where(x =>
                (x.BatchNo != null && x.BatchNo.Contains(kw, StringComparison.OrdinalIgnoreCase)) ||
                (x.TagNo != null && x.TagNo.Contains(kw, StringComparison.OrdinalIgnoreCase)) ||
                (x.WorkOrderNo != null && x.WorkOrderNo.Contains(kw, StringComparison.OrdinalIgnoreCase)) ||
                (x.SalesOrderNo != null && x.SalesOrderNo.Contains(kw, StringComparison.OrdinalIgnoreCase)) ||
                (x.PlantGrade != null && x.PlantGrade.Contains(kw, StringComparison.OrdinalIgnoreCase)) ||
                (x.Specification != null && x.Specification.Contains(kw, StringComparison.OrdinalIgnoreCase)) ||
                (x.Salesman != null && x.Salesman.Contains(kw, StringComparison.OrdinalIgnoreCase)) ||
                (x.EndCustomer != null && x.EndCustomer.Contains(kw, StringComparison.OrdinalIgnoreCase)) ||
                (x.ProductionMainNo != null && x.ProductionMainNo.Contains(kw, StringComparison.OrdinalIgnoreCase)) ||
                (x.ProductionSubNo != null && x.ProductionSubNo.Contains(kw, StringComparison.OrdinalIgnoreCase))
            );
        }

        // 有效投料疑问筛选
        if (!string.IsNullOrWhiteSpace(_validInputQuestionFilter))
        {
            query = query.Where(x => x.ValidInputQuestion == _validInputQuestionFilter);
        }

        // ExcelFilter 列筛选
        foreach (var cf in _columnFilters)
        {
            var fieldKey = cf.Key;
            var selected = cf.Value;
            query = query.Where(x =>
            {
                var raw = GetCellRawValue(x, fieldKey);
                return raw != null && selected.Contains(raw);
            });
        }

        // 排序
        if (!string.IsNullOrEmpty(sortColumn))
        {
            query = sortColumn switch
            {
                "batchno" => sortDescending ? query.OrderByDescending(x => x.BatchNo) : query.OrderBy(x => x.BatchNo),
                "tagno" => sortDescending ? query.OrderByDescending(x => x.TagNo) : query.OrderBy(x => x.TagNo),
                "createdtime" => sortDescending ? query.OrderByDescending(x => x.CreatedTime) : query.OrderBy(x => x.CreatedTime),
                "updatedtime" => sortDescending ? query.OrderByDescending(x => x.UpdatedTime) : query.OrderBy(x => x.UpdatedTime),
                "workorderno" => sortDescending ? query.OrderByDescending(x => x.WorkOrderNo) : query.OrderBy(x => x.WorkOrderNo),
                "salesorderno" => sortDescending ? query.OrderByDescending(x => x.SalesOrderNo) : query.OrderBy(x => x.SalesOrderNo),
                "status" => sortDescending ? query.OrderByDescending(x => x.Status) : query.OrderBy(x => x.Status),
                "plantgrade" => sortDescending ? query.OrderByDescending(x => x.PlantGrade) : query.OrderBy(x => x.PlantGrade),
                "specification" => sortDescending ? query.OrderByDescending(x => x.Specification) : query.OrderBy(x => x.Specification),
                "totalquantity" => sortDescending ? query.OrderByDescending(x => x.TotalQuantity) : query.OrderBy(x => x.TotalQuantity),
                "totalweight" => sortDescending ? query.OrderByDescending(x => x.TotalWeight) : query.OrderBy(x => x.TotalWeight),
                "totalmeters" => sortDescending ? query.OrderByDescending(x => x.TotalMeters) : query.OrderBy(x => x.TotalMeters),
                "productiontype" => sortDescending ? query.OrderByDescending(x => x.ProductionType) : query.OrderBy(x => x.ProductionType),
                "manufacturingitem" => sortDescending ? query.OrderByDescending(x => x.ManufacturingItem) : query.OrderBy(x => x.ManufacturingItem),
                "currentgroupname" => sortDescending ? query.OrderByDescending(x => x.CurrentGroupName) : query.OrderBy(x => x.CurrentGroupName),
                "currentsectionname" => sortDescending ? query.OrderByDescending(x => x.CurrentSectionName) : query.OrderBy(x => x.CurrentSectionName),
                "currentexecdate" => sortDescending ? query.OrderByDescending(x => x.CurrentExecDate) : query.OrderBy(x => x.CurrentExecDate),
                "signdate" => sortDescending ? query.OrderByDescending(x => x.SignDate) : query.OrderBy(x => x.SignDate),
                "deliverydate" => sortDescending ? query.OrderByDescending(x => x.DeliveryDate) : query.OrderBy(x => x.DeliveryDate),
                "salesman" => sortDescending ? query.OrderByDescending(x => x.Salesman ?? "") : query.OrderBy(x => x.Salesman ?? ""),
                "endcustomer" => sortDescending ? query.OrderByDescending(x => x.EndCustomer ?? "") : query.OrderBy(x => x.EndCustomer ?? ""),
                "materialname" => sortDescending ? query.OrderByDescending(x => x.MaterialName) : query.OrderBy(x => x.MaterialName),
                "deliverystate" => sortDescending ? query.OrderByDescending(x => x.DeliveryState) : query.OrderBy(x => x.DeliveryState),
                "lengthstatus" => sortDescending ? query.OrderByDescending(x => x.LengthStatus) : query.OrderBy(x => x.LengthStatus),
                _ => sortDescending ? query.OrderByDescending(x => x.BatchNo) : query.OrderBy(x => x.BatchNo)
            };
        }

        _filteredItemsList = query.ToList();
        StateHasChanged();
    }

    // ========== 单元格原始值/显示值 ==========

    private string? GetCellRawValue(ProductionBatchListDto item, string key) => key switch
    {
        "BatchNo" => item.BatchNo,
        "TagNo" => item.TagNo,
        "CreatedTime" => item.CreatedTime.LocalDateTime.ToString("yyyy-MM-dd HH:mm"),
        "UpdatedTime" => item.UpdatedTime.LocalDateTime.ToString("yyyy-MM-dd HH:mm"),
        "WorkOrderNo" => item.WorkOrderNo,
        "SalesOrderNo" => item.SalesOrderNo,
        "ProductionMainNo" => item.ProductionMainNo,
        "ProductionSubNo" => item.ProductionSubNo,
        "ProductionType" => item.ProductionType,
        "ManufacturingItem" => item.ManufacturingItem,
