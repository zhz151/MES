@page "/final-inspection-plan"
@using MES.Blazor.Services
@using MES.Blazor.Components
@using MES.Blazor.Helpers
@using MES.Blazor.Models
@using MES.Core.DTOs.Scheduling
@using Microsoft.AspNetCore.Authorization
@using System.Text.Json
@attribute [Authorize(Roles = Roles.Policies.WorkOrderRead)]
@inject FinalInspectionPlanService KanbanSvc
@inject DictValueDefinitionService DictValueDefinitionService
@inject FinalInspectionService FinalInspectionService
@inject ISnackbar Snackbar
@inject IJSRuntime JS
@inject PageStateService PageState
@inject HttpClient Http

<MudContainer MaxWidth="MaxWidth.False" Class="mt-4 pl-0">
    <div class="d-flex flex-column mb-4">
        <!-- 页面标题 + 右上角「待检批支重汇总」按钮 -->
        <div class="d-flex align-center mb-4">
            <MudText Typo="Typo.h5" Class="font-weight-bold">
                <MudIcon Icon="@Icons.Material.Filled.Assignment" Class="mr-2" Color="Color.Primary" />
                成检计划
            </MudText>
            <div style="margin-left:auto; gap: 4px;" class="d-flex align-center">
                <MudButton Variant="Variant.Outlined"
                           Size="Size.Small"
                           Color="@(_showRecentSummaryCard ? Color.Primary : Color.Default)"
                           StartIcon="@(_showRecentSummaryCard ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)"
                           OnClick="ToggleRecentSummaryCard">
                    近日成检量数据
                </MudButton>
                <MudButton Variant="Variant.Outlined"
                           Size="Size.Small"
                           Color="@(_showSummaryCard ? Color.Primary : Color.Default)"
                           StartIcon="@(_showSummaryCard ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)"
                           OnClick="ToggleSummaryCard">
                    待检批支重汇总
                </MudButton>
            </div>
        </div>

        <!-- 四档 Tab -->
        <div class="d-flex flex-wrap align-center gap-2 mb-2" style="gap: 4px;">
            @foreach (var tab in _tabs)
            {
                var isActive = (tab == "全部" && _selectedTab == null)
                    || (tab != "全部" && _selectedTab == tab);
                <MudButton Variant="@(isActive ? Variant.Filled : Variant.Outlined)"
                           Color="@(isActive ? Color.Primary : Color.Default)"
                           Size="Size.Small"
                           Class="ma-0"
                           OnClick="@(() => OnTabChanged(tab == "全部" ? null : tab))">
                    @tab
                </MudButton>
            }
        </div>

        <!-- Tab 汇总 -->
        <div class="d-flex flex-wrap align-center mb-2" style="gap: 12px; font-size: 0.85rem;">
            <MudText Typo="Typo.body2">
                <b>批次数：</b>@_tabCount
            </MudText>
            <MudText Typo="Typo.body2">
                <b>总重量(kg)：</b>@(((int)_tabTotalWeight).ToString())
            </MudText>
            <MudChip Size="Size.Small" Color="Color.Error">A+急 @_urgentAPlusCount 批 / @(((int)_urgentAPlusWeight).ToString())kg</MudChip>
            <MudChip Size="Size.Small" Color="Color.Warning">A急 @_urgentACount 批 / @(((int)_urgentAWeight).ToString())kg</MudChip>
        </div>
    </div>

    <!-- 搜索框 -->
    <MudGrid>
        <MudItem xs="12" md="6">
            <MudTextField T="string"
                          Label=""
                          Value="@_searchKeyword" ValueExpression="@(() => _searchKeyword)"
                          ValueChanged="@OnSearchChanged"
                          Immediate="true"
                          DebounceInterval="500"
                          Adornment="Adornment.End"
                          AdornmentIcon="@Icons.Material.Filled.Search" />
        </MudItem>
    </MudGrid>

    <!-- 待检批支重汇总卡片（页面右上角按钮切换显隐，懒加载） -->
    @if (_showSummaryCard)
    {
        <MudCard Class="mb-2 summary-card" Elevation="0">
            <MudCardContent>
                @if (_isLoadingSummary)
                {
                    <div class="d-flex align-center" style="gap:8px;">
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                        <span>汇总加载中...</span>
                    </div>
                }
                <div class="d-flex justify-space-between align-center mb-2">
                    <MudText Typo="Typo.subtitle2"><b>待检批支重汇总</b></MudText>
                    <MudButton Variant="Variant.Text" Size="Size.Small" Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.Print" OnClick="PrintSummaryTable">
                        打印
                    </MudButton>
                </div>
                <div id="final-inspection-plan-summary-table" style="overflow-x:auto;">
                    <table style="border-collapse: collapse; width: 100%; font-size: 0.8125rem;">
                        <thead>
                            <tr>
                                <th style="text-align:left; padding:4px 10px; background:#f5f5f5; border:1px solid #e0e0e0;">检验项</th>
                                <th style="padding:4px 10px; background:#f5f5f5; border:1px solid #e0e0e0; text-align:center;">待到料</th>
                                <th style="padding:4px 10px; background:#f5f5f5; border:1px solid #e0e0e0; text-align:center;">待检验+检验中</th>
                                <th style="padding:4px 10px; background:#f5f5f5; border:1px solid #e0e0e0; text-align:center;">汇总数据</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var r in _summaryRows)
                            {
                                <tr>
                                    <td style="padding:4px 10px; border:1px solid #e0e0e0; font-weight:600; white-space:nowrap;">@r.InspectionItemName</td>
                                    <td style="padding:4px 10px; border:1px solid #e0e0e0; text-align:center; white-space:nowrap;">@RenderSummaryCell(r.WaitingMaterialCount, r.WaitingMaterialQuantity, r.WaitingMaterialWeight)</td>
                                    <td style="padding:4px 10px; border:1px solid #e0e0e0; text-align:center; white-space:nowrap;">@RenderSummaryCell(r.WaitingInspectionCount + r.InspectingCount, r.WaitingInspectionQuantity + r.InspectingQuantity, r.WaitingInspectionWeight + r.InspectingWeight)</td>
                                    <td style="padding:4px 10px; border:1px solid #e0e0e0; text-align:center; white-space:nowrap; font-weight:600; background:#eef3fa;">@RenderSummaryCell(r.TotalCount, r.TotalQuantity, r.TotalWeight)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <MudText Typo="Typo.body2" Class="text-hint" Style="margin-top:4px; font-size:0.75rem;">
                    注：某检验项统计「要求该检验项且尚未完成该检验」的看板批次，按待到料/待检验+检验中分列；
                    已检完该检验项的批次（含「完成检验待入库」档）不计入；每格=批次数/生产支数/生产重量(kg)；
                    0 值显示 "-"；预+正式合并、按批次去重；汇总数据=两档之和。
                </MudText>
            </MudCardContent>
        </MudCard>
    }

    <!-- 近日成检量数据卡片（页面右上角按钮切换显隐，懒加载；按检验项目统计检验重量，与成品检验页口径一致） -->
    @if (_showRecentSummaryCard)
    {
        <MudCard Class="mb-2 summary-card" Elevation="0">
            <MudCardContent>
                @if (_isLoadingRecentSummary)
                {
                    <div class="d-flex align-center" style="gap:8px;">
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                        <span>近日成检量加载中...</span>
                    </div>
                }
                else
                {
                    <div class="d-flex justify-space-between align-center mb-2">
                        <MudText Typo="Typo.subtitle2"><b>近日成检量数据</b></MudText>
                        <MudButton Variant="Variant.Text" Size="Size.Small" Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.Print" OnClick="PrintRecentSummaryTable">
                            打印
                        </MudButton>
                    </div>
                    <div id="final-inspection-plan-recent-summary-table" style="overflow-x:auto;">
                        <table style="border-collapse: collapse; width: 100%; font-size: 0.8125rem;">
                            <thead>
                                <tr>
                                    <th style="text-align:left; padding:4px 10px; background:#f5f5f5; border:1px solid #e0e0e0;">检验项目</th>
                                    <th style="padding:4px 10px; background:#f5f5f5; border:1px solid #e0e0e0; text-align:center;">前6日(t)</th>
                                    <th style="padding:4px 10px; background:#f5f5f5; border:1px solid #e0e0e0; text-align:center;">前3日(t)</th>
                                    <th style="padding:4px 10px; background:#fff8e1; border:1px solid #e0e0e0; text-align:center;">今日(t)</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var r in _recentSummaryRows)
                                {
                                    var isTotal = r.InspectionItem == "合计";
                                    <tr>
                                        <td style="padding:4px 10px; border:1px solid #e0e0e0; font-weight:@(isTotal ? "700" : "600"); @(isTotal ? "background:#eef3fa;" : "")">@r.InspectionItem</td>
                                        <td style="padding:4px 10px; border:1px solid #e0e0e0; text-align:center; @(isTotal ? "background:#eef3fa;" : "")">@FormatT(r.Last7DaysWeight)</td>
                                        <td style="padding:4px 10px; border:1px solid #e0e0e0; text-align:center; @(isTotal ? "background:#eef3fa;" : "")">@FormatT(r.Last3DaysWeight)</td>
                                        <td style="padding:4px 10px; border:1px solid #e0e0e0; text-align:center; @(isTotal ? "background:#eef3fa;" : "background:#fff8e1;")">@FormatT(r.TodayWeight)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <MudText Typo="Typo.body2" Class="text-hint" Style="margin-top:4px; font-size:0.75rem;">
                        注：前6日/前3日均不含今日，今日列为实时数据（浅黄底色）；按检验项目统计检验重量（成品检验记录 Weight，预成检/正式成检合并，与成品检验页「近日成检量数据」口径一致）；合计行=各检验项目之和；0 值留空。
                    </MudText>
                }
            </MudCardContent>
        </MudCard>
    }

    <MudCard>
        <MudCardContent>
            <div id="final-inspection-plan-table">
            @{
                var _groupHeaders = GetGroupHeaders();
                var _totalTableWidth = _visibleColumns.Sum(c => int.TryParse(c.Width, out var w) ? w : 100) + 40;
            }
            <!-- 工具栏 -->
            <div class="list-toolbar">
                <div class="d-flex align-center">
                    <ColumnDisplaySelect Columns="_allColumns"
                                         OnColumnToggle="OnColumnToggle"
                                         OnMoveUp="MoveColumnUp"
                                         OnMoveDown="MoveColumnDown" />
                    <MudButton Variant="Variant.Text" Size="Size.Small"
                               Color="Color.Default"
                               StartIcon="@Icons.Material.Filled.RestartAlt"
                               OnClick="ResetColumnDisplay" Class="ml-2">
                        重置
                    </MudButton>
                    <MudIconButton Icon="@Icons.Material.Filled.Refresh"
                                   Size="Size.Small"
                                   OnClick="@LoadDataAsync"
                                   Title="刷新" Class="ml-4" />
                </div>
                <div class="d-flex align-center" style="margin-left:auto;">
                    <MudButton Variant="Variant.Filled"
                               Size="Size.Small"
                               Color="Color.Primary"
                               Class="ml-2"
                               StartIcon="@Icons.Material.Filled.Print"
                               OnClick="PrintSelected"
                               Disabled="@(_selectedItems.Count == 0)">
                        打印选中 (@_selectedItems.Count)
                    </MudButton>
                    <MudText Typo="Typo.body2" Class="ml-4">
                        共 @_totalCount 条记录
                    </MudText>
                </div>
            </div>
            <!-- 分组标题栏 -->
            <div class="col-group-header-scroll" id="fip-group-header-scroll">
                <div class="col-group-header-bar" style="width: @(_totalTableWidth)px">
                    @foreach (var gh in _groupHeaders)
                    {
                        <div class="col-group-header-item @gh.CssClass" style="width: @(gh.TotalWidth)px">
                            <span class="col-group-badge">@gh.GroupName</span>
                        </div>
                    }
                </div>
            </div>
            <MudTable @ref="table"
                      T="FinalInspectionPlanDto"
                      Items="@_filteredItems"
                      Dense="true"
                      Hover="true"
                      Class="mt-0 auto-table compact-table"
                      Elevation="0"
                      RowsPerPage="@_pageSize"
                      RowsPerPageChanged="@OnRowsPerPageChanged"
                      RowsPerPageLabel="每页行数:">
                <HeaderContent>
                    @{
                        int? _prevGk = null;
                    }
                    <MudTh Class="col-selection-th" Style="width:40px;min-width:40px;max-width:40px;padding:0 4px;">
                        <MudCheckBox T="bool"
                                     Value="@(_selectedItems.Count > 0 && _selectedItems.Count == _totalCount)"
                                     ValueChanged="@((bool v) => SelectAllItems(v))"
                                     Dense="true"
                                     TriState="false" />
                    </MudTh>
                    @foreach (var col in _visibleColumns)
                    {
                        var _isGroupStart = col.GroupKey.HasValue && col.GroupKey != _prevGk;
                        _prevGk = col.GroupKey;
                        var _headerClass = GetHeaderGroupCss(col.GroupKey, _isGroupStart);
                        <MudTh Class="@_headerClass" Style="@($"width: {col.Width}px")">
                            <div class="col-header-cell">
                                <span @onclick='() => ToggleSort(col.SortKey ?? col.Key)'
                                      style="cursor:pointer" class="th-label">
                                    @col.Label @if (sortColumn == (col.SortKey ?? col.Key))
                                    {@(sortDescending ? " ▼" : " ▲")}
                                </span>
                                @if (col.FilterType != null)
                                {
                                    <ExcelFilter T="FinalInspectionPlanDto"
                                                 Label="@col.Label"
                                                 FieldKey="@col.Key"
                                                 FilterOptions="@(_filterContextOptions.GetValueOrDefault(col.Key))"
                                                 ActiveFilterValues="@(_columnFilters.GetValueOrDefault(col.Key))"
                                                 FilterChanged="@(args => OnColumnFilterChanged(args.fieldKey, args.selectedValues))" />
                                }
                            </div>
                        </MudTh>
                    }
                </HeaderContent>

                <RowTemplate Context="item">
                    @{
                        int? _prevGk2 = null;
                    }
                    <MudTd Class="col-selection-td" Style="width:40px;min-width:40px;max-width:40px;padding:0 4px;">
                        <MudCheckBox T="bool"
                                     Value="@(_selectedItems.Contains(item))"
                                     ValueChanged="@((bool v) => ToggleSelection(item, v))"
                                     Dense="true" />
                    </MudTd>
                    @foreach (var col in _visibleColumns)
                    {
                        var _isGroupStart2 = col.GroupKey.HasValue && col.GroupKey != _prevGk2;
                        _prevGk2 = col.GroupKey;
                        var _cellClass = GetCellGroupCss(col.GroupKey, _isGroupStart2);
                        <MudTd Class="@_cellClass">@RenderCell(item, col)</MudTd>
                    }
                </RowTemplate>

                <FooterContent>
                    @{
                        int? _prevGk3 = null;
                        EnsurePageSumsComputed();
                    }
                    <MudTd Style="width:40px;min-width:40px;max-width:40px;"></MudTd>
                    @foreach (var col in _visibleColumns)
                    {
                        var _isGroupStart3 = col.GroupKey.HasValue && col.GroupKey != _prevGk3;
                        _prevGk3 = col.GroupKey;
                        var _footerClass = GetCellGroupCss(col.GroupKey, _isGroupStart3) + " col-footer-cell";
                        <MudTd Class="@_footerClass">
                            <span class="col-footer-sum">@RenderFooterCell(col)</span>
                        </MudTd>
                    }
                </FooterContent>

                <PagerContent>
                    <MudTablePager PageSizeOptions="new int[]{10,20,50,100}" />
                </PagerContent>
            </MudTable>
            </div>
        </MudCardContent>
    </MudCard>
</MudContainer>
