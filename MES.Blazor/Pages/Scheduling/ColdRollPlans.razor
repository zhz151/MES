@page "/cold-roll-plans"
@using MES.Blazor.Services
@using MES.Blazor.Helpers
@using MES.Core.Models
@using MES.Blazor.Components
@using MES.Core.DTOs.Scheduling
@using Microsoft.AspNetCore.Authorization
@using MudBlazor
@attribute [Authorize(Roles = Roles.Policies.WorkOrderRead)]

<MudContainer MaxWidth="MaxWidth.False" Class="mt-4 pl-0">
    <!-- 页面顶部工具栏 -->
    <div class="d-flex flex-column mb-4">
        <MudText Typo="Typo.h5" Class="font-weight-bold mb-4 crp-page-title">
            <MudIcon Icon="@Icons.Material.Filled.Assessment" Class="mr-2" Color="Color.Primary" />
            冷轧计划
        </MudText>

        <!-- 工段筛选 Tab -->
        <div class="d-flex flex-wrap align-center gap-2 mb-2 crp-print-hide" style="gap: 4px;">
            @foreach (var sec in _sectionTabs)
            {
                var isActive = (sec == "全部" && _selectedSection == null)
                    || (sec != "全部" && _selectedSection == sec);
                <MudButton Variant="@(isActive ? Variant.Filled : Variant.Outlined)"
                           Color="@(isActive ? Color.Primary : Color.Default)"
                           Size="Size.Small"
                           Class="ma-0"
                           OnClick="@(() => OnSectionTabChanged(sec == "全部" ? null : sec))">
                    @sec
                </MudButton>
            }
        </div>

        <!-- 明细/简化视图切换 -->
        <div class="d-flex align-center mb-2 crp-print-hide" style="gap: 12px;">
            <MudSwitch T="bool"
                       Value="@_isSimplifiedView"
                       ValueChanged="@OnSimplifiedViewChanged"
                       Label="简化视图"
                       Color="Color.Primary"
                       Size="Size.Small" />
        </div>

        <!-- 搜索栏 -->
        <MudTextField T="string"
                      Variant="Variant.Outlined"
                      Label="搜索规格/类型..."
                      Size="Size.Small"
                      ValueChanged="@OnSearchChanged"
                      Class="mb-2 crp-print-hide"
                      Style="max-width: 50%;"
                      Immediate="true"
                      DebounceInterval="500"
                      AdornmentIcon="@Icons.Material.Filled.Search"
                      AdornmentSize="Size.Small"
                      Clearable="true" />

        <!-- Tab 汇总 -->
        <div class="d-flex flex-wrap align-center mb-2 crp-print-hide" style="gap: 12px; font-size: 0.85rem;">
            <MudText Typo="Typo.body2">
                <b>规格数：</b>@_tabSpecCount
            </MudText>
            <MudText Typo="Typo.body2">
                <b>总重量(kg)：</b>@(((int)_tabTotalWeight).ToString())
            </MudText>
            <MudIconButton Icon="@Icons.Material.Filled.Print"
                           Size="Size.Small"
                           Color="Color.Primary"
                           Title="打印"
                           OnClick="@OnPrint" />
            <ColumnDisplaySelect Columns="_allColumns"
                                 OnColumnToggle="OnColumnToggle"
                                 OnMoveUp="MoveColumnUp"
                                 OnMoveDown="MoveColumnDown" />
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                       Class="ml-2" OnClick="@EnterSchedulingModeAsync">编辑排程</MudButton>
            @if (_isSchedulingMode)
            {
                <MudButton Variant="Variant.Filled" Color="Color.Success" Size="Size.Small"
                           OnClick="@SaveScheduleAsync">保存排程</MudButton>
                <MudButton Variant="Variant.Outlined" Color="Color.Error" Size="Size.Small"
                           OnClick="@CancelSchedule">取消</MudButton>
            }
            @if (_scheduleUpdatedTime.HasValue)
            {
                <MudText Typo="Typo.body2" Class="ml-4 mr-2">
                    <b>最后更新：</b>@_scheduleUpdatedTime.Value.ToString("yyyy-MM-dd HH:mm")
                </MudText>
            }
            @if (_showScheduleSummary)
            {
                <MudIconButton Icon="@Icons.Material.Filled.Close"
                               Size="Size.Small"
                               Color="Color.Error"
                               Title="关闭排程汇总"
                               OnClick="@ToggleScheduleSummaryAsync" />
            }
            else
            {
                <MudButton Variant="Variant.Outlined" Color="Color.Info" Size="Size.Small"
                           Class="ml-1" OnClick="@ToggleScheduleSummaryAsync" Disabled="@_summaryLoading">
                    @if (_summaryLoading)
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-1" />
                    }
                    排程汇总
                </MudButton>
            }
        </div>
    </div>

    <MudCard Class="crp-plan-section">
        <MudCardContent>
            @{
                var _groupHeaders = GetGroupHeaders();
                var _totalTableWidth = _visibleColumns.Sum(c => int.TryParse(c.Width, out var w) ? w : 100);
            }

            <div id="crp-list-table">
            @* 分组标题栏 *@
            <div class="col-group-header-scroll" id="crp-group-header-scroll">
                <div class="col-group-header-bar" style="width: @(_totalTableWidth)px">
                    @foreach (var gh in _groupHeaders)
                    {
                        <div class="col-group-header-item @gh.CssClass" style="width: @(gh.TotalWidth)px">
                            <span class="col-group-badge">@gh.GroupName</span>
                        </div>
                    }
                </div>
            </div>

            <MudTable @ref="table"
                      T="ColdRollPlanRowDto"
                      ServerData="@LoadDataFromServer"
                      Dense="true"
                      Hover="true"
                      Class="mt-0 auto-table compact-table"
                      Elevation="0"
                      RowsPerPage="@_pageSize"
                      RowsPerPageLabel="每页行数:">
                <HeaderContent>
                    @{
                        int? _prevGk = null;
                    }
                    @foreach (var col in _visibleColumns)
                    {
                        var _isGroupStart = col.GroupKey.HasValue && col.GroupKey != _prevGk;
                        _prevGk = col.GroupKey;
                        var _headerClass = GetHeaderGroupCss(col.GroupKey, _isGroupStart);
                        <MudTh Class="@_headerClass" Style="@($"width: {col.Width}px")">
                            <div class="col-header-cell sortable-header" @onclick="@(() => ToggleSort(col.Key))" style="cursor: pointer; user-select: none;">
                                <span class="th-label">@col.Label</span>
                                <span class="sort-indicator" style="font-size: 0.7rem; color: #666;">@GetSortIcon(col.Key)</span>
                            </div>
                            @if (col.FilterType != null)
                            {
                                <ExcelFilter T="ColdRollPlanRowDto"
                                             Label="@col.Label"
                                             FieldKey="@col.Key"
                                             FilterOptions="@(_filterContextOptions.GetValueOrDefault(col.Key))"
                                             ActiveFilterValues="@(_columnFilters.GetValueOrDefault(col.Key))"
                                             FilterChanged="@(args => OnColumnFilterChanged(args.fieldKey, args.selectedValues))" />
                            }
                        </MudTh>
                    }
                </HeaderContent>
                <RowTemplate Context="item">
                    @{
                        int? _prevGk2 = null;
                    }
                    @foreach (var col in _visibleColumns)
                    {
                        var _isGroupStart2 = col.GroupKey.HasValue && col.GroupKey != _prevGk2;
                        _prevGk2 = col.GroupKey;
                        var _cellClass = GetCellGroupCss(col.GroupKey, _isGroupStart2) + " " + GetCellExtraClass(col);
                        var _edit = GetEdit(item);
                        @if (_isSchedulingMode && col.Key == "CompletionType")
                        {
                            <MudTd Class="@_cellClass">
                                <MudSelect T="string" Value="@_edit.CompletionType"
                                           ValueChanged="@(v => OnCompletionTypeEdit(_edit, v))"
                                           ToStringFunc="GetCompletionTypeEditDisplay"
                                           Dense="true" Variant="Variant.Outlined" Class="compact-select">
                                    @foreach (var opt in DisplayHelper.GetCompletionTypeOptions())
                                    {
                                        <MudSelectItem Value="@opt.Value">@opt.Display</MudSelectItem>
                                    }
                                </MudSelect>
                            </MudTd>
                        }
                        else if (_isSchedulingMode && col.Key == "RollType")
                        {
                            <MudTd Class="@_cellClass">
                                <MudSelect T="string" Value="@_edit.RollType"
                                           ValueChanged="@(v => OnRollTypeEdit(_edit, v))"
                                           ToStringFunc="GetRollTypeEditDisplay"
                                           Dense="true" Variant="Variant.Outlined" Class="compact-select">
                                    @foreach (var opt in DisplayHelper.GetRollTypeOptions())
                                    {
                                        <MudSelectItem Value="@opt.Value">@opt.Display</MudSelectItem>
                                    }
                                </MudSelect>
                            </MudTd>
                        }
                        else if (_isSchedulingMode && col.Key == "SchedMachineNo")
                        {
                            <MudTd Class="@_cellClass">
                                <MudTextField T="string" Value="@_edit.MachineNo"
                                              ValueChanged="@(v => { _edit.MachineNo = v ?? ""; })"
                                              Dense="true" Variant="Variant.Outlined"
                                              Class="compact-input" />
                            </MudTd>
                        }
                        else
                        {
                            <MudTd Class="@_cellClass">@RenderCell(item, col)</MudTd>
                        }
                    }
                </RowTemplate>
                <FooterContent>
                    @{
                        int? _prevGk3 = null;
                    }
                    @foreach (var col in _visibleColumns)
                    {
                        var _isGroupStart3 = col.GroupKey.HasValue && col.GroupKey != _prevGk3;
                        _prevGk3 = col.GroupKey;
                        var _footerClass = GetCellGroupCss(col.GroupKey, _isGroupStart3) + " col-footer-cell";
                        <MudTd Class="@_footerClass">
                            <span class="col-footer-sum">@RenderFooterCell(col)</span>
                        </MudTd>
                    }
                </FooterContent>
                <NoRecordsContent>
                    <MudText>暂无数据</MudText>
                </NoRecordsContent>
                <PagerContent>
                    <MudTablePager PageSizeOptions="@(new int[]{10, 15, 25, 50, 100})" />
                </PagerContent>
            </MudTable>
            </div>
        </MudCardContent>
    </MudCard>

    @* 排程汇总 — 基于 G7 实时值，按(冷轧类型, 外径跨度)聚合 *@
    @if (_showScheduleSummary && _scheduleSummaryData.Any())
    {
        var _summaryGroups = _displaySummaryData
            .GroupBy(x => x.ProcessType)
            .OrderBy(g => g.Key)
            .ToList();

        <div class="mt-4 crp-summary-section">
            <div class="d-flex align-center mb-3" style="gap: 12px;">
                <MudText Typo="Typo.h6" Class="font-weight-bold">
                    <MudIcon Icon="@Icons.Material.Filled.Summarize" Class="mr-1" Color="Color.Primary" />
                    排程汇总
                </MudText>
                <div class="d-flex align-center" style="gap: 4px;">
                    <MudButton Variant="@(_summaryMaxDiff == 2 ? Variant.Filled : Variant.Outlined)"
                               Color="@(_summaryMaxDiff == 2 ? Color.Primary : Color.Default)"
                               Size="Size.Small"
                               OnClick="@(() => OnSummaryMaxDiffChanged(2))">近2天</MudButton>
                    <MudButton Variant="@(_summaryMaxDiff == 4 ? Variant.Filled : Variant.Outlined)"
                               Color="@(_summaryMaxDiff == 4 ? Color.Primary : Color.Default)"
                               Size="Size.Small"
                               OnClick="@(() => OnSummaryMaxDiffChanged(4))">近4天</MudButton>
                    <MudButton Variant="@(!_summaryMaxDiff.HasValue ? Variant.Filled : Variant.Outlined)"
                               Color="@(!_summaryMaxDiff.HasValue ? Color.Primary : Color.Default)"
                               Size="Size.Small"
                               OnClick="@(() => OnSummaryMaxDiffChanged(null))">近6天</MudButton>
                </div>
                <MudIconButton Icon="@Icons.Material.Filled.Print"
                               Size="Size.Small"
                               Color="Color.Primary"
                               Title="打印排程汇总"
                               Class="ml-2"
                               OnClick="@OnPrintSummary" />
            </div>

            @foreach (var group in _summaryGroups)
            {
                var groupItems = group.ToList();
                var grpFlowWeight = groupItems.Sum(x => x.TotalFlowWeight);

                <MudCard Class="mb-3" Style="border-left: 4px solid #1976D2;">
                    <MudCardContent Class="pa-3">
                        <MudText Typo="Typo.subtitle1" Class="font-weight-bold mb-2" Style="color: #1565C0;">
                            @ProcessDisplayHelper.GetProcessNameText(group.Key)
                            <span class="ml-4" style="font-size: 0.85rem; color: #555; font-weight: normal;">
                                批次数：<b>@groupItems.Sum(x => x.BatchCount)</b>
                                &nbsp;|&nbsp;流转总量：<b style="color:#2E7D32;">@(((int)grpFlowWeight).ToString())</b>
                            </span>
                        </MudText>

                        <table class="summary-flow-table">
                            <thead>
                                <tr>
                                    <th style="width: 140px;">外径跨度</th>
                                    <th style="width: 80px;">批次数</th>
                                    <th style="width: 110px;">流转总量</th>
                                    <th style="width: 110px;">在轧总量</th>
                                    <th style="width: 110px;">在轧(急+)</th>
                                    <th style="width: 110px;">在轧(急)</th>
                                    <th style="width: 110px;">在轧(急-)</th>
                                    <th style="width: 110px;">在轧(一般)</th>
                                    <th style="width: 110px;">待轧总量</th>
                                    <th style="width: 110px;">待轧(急+)</th>
                                    <th style="width: 110px;">待轧(急)</th>
                                    <th style="width: 110px;">待轧(急-)</th>
                                    <th style="width: 110px;">待轧(一般)</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in groupItems)
                                {
                                    <tr>
                                        <td>@item.ShortDisplay</td>
                                        <td>@item.BatchCount</td>
                                        <td>@(((int)item.TotalFlowWeight).ToString())</td>
                                        <td style="color: #1565C0; font-weight: 600;">@WeightText(item.ProdTotalWeight)</td>
                                        <td style="color: #c62828;">@WeightText(item.ProdUrgentWeight)</td>
                                        <td style="color: #E65100;">@WeightText(item.ProdUrgentSubWeight)</td>
                                        <td style="color: #c62828;">@WeightText(item.ProdOtherWeight)</td>
                                        <td>@WeightText(item.ProdRestWeight)</td>
                                        <td style="color: #1565C0; font-weight: 600;">@WeightText(item.WaitTotalWeight)</td>
                                        <td style="color: #c62828;">@WeightText(item.WaitUrgentWeight)</td>
                                        <td style="color: #E65100;">@WeightText(item.WaitUrgentSubWeight)</td>
                                        <td style="color: #c62828;">@WeightText(item.WaitOtherWeight)</td>
                                        <td>@WeightText(item.WaitRestWeight)</td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot>
                                <tr>
                                    <td><b>小计</b></td>
                                    <td><b>@groupItems.Sum(x => x.BatchCount)</b></td>
                                    <td><b>@(((int)grpFlowWeight).ToString())</b></td>
                                    <td><b style="color:#1565C0;">@WeightText(groupItems.Sum(x => x.ProdTotalWeight))</b></td>
                                    <td><b style="color:#c62828;">@WeightText(groupItems.Sum(x => x.ProdUrgentWeight))</b></td>
                                    <td><b style="color:#E65100;">@WeightText(groupItems.Sum(x => x.ProdUrgentSubWeight))</b></td>
                                    <td><b style="color:#c62828;">@WeightText(groupItems.Sum(x => x.ProdOtherWeight))</b></td>
                                    <td><b>@WeightText(groupItems.Sum(x => x.ProdRestWeight))</b></td>
                                    <td><b style="color:#1565C0;">@WeightText(groupItems.Sum(x => x.WaitTotalWeight))</b></td>
                                    <td><b style="color:#c62828;">@WeightText(groupItems.Sum(x => x.WaitUrgentWeight))</b></td>
                                    <td><b style="color:#E65100;">@WeightText(groupItems.Sum(x => x.WaitUrgentSubWeight))</b></td>
                                    <td><b style="color:#c62828;">@WeightText(groupItems.Sum(x => x.WaitOtherWeight))</b></td>
                                    <td><b>@WeightText(groupItems.Sum(x => x.WaitRestWeight))</b></td>
                                </tr>
                            </tfoot>
                        </table>
                    </MudCardContent>
                </MudCard>
            }
        </div>
    }
</MudContainer>

<style>
    @@media print {
        @@page { size: landscape; margin: 10mm; }
        .crp-print-hide { display: none !important; }
        /* 打印冷轧排程计划（默认）：隐藏排程汇总区 */
        .crp-summary-section { display: none !important; }
        /* 打印排程汇总（body.print-summary）：隐藏主计划区、仅显示汇总 */
        body.print-summary .crp-plan-section { display: none !important; }
        body.print-summary .crp-summary-section { display: block !important; }
        /* 打印排程汇总：不显示页面标题「冷轧计划」 */
        body.print-summary .crp-page-title { display: none !important; }
        .col-group-header-scroll { overflow: visible !important; }
        .mud-card { box-shadow: none !important; border: none !important; }
        .auto-table { width: 100% !important; font-size: 0.75rem !important; }
        /* 组标题与字段对齐：打印时表格按固定列宽总宽显示，不被拉伸为 100% */
        #crp-list-table .mud-table-container { overflow: visible !important; }
        #crp-list-table table.mud-table { width: auto !important; }
        #crp-list-table table { table-layout: fixed !important; }
        .mud-drawer { display: none !important; }
        .mud-appbar { display: none !important; }
        .mud-main-content { margin-left: 0 !important; }
    }
    .urgent-cell {
        background-color: #fff0f0 !important;
        font-weight: 600;
        color: #c62828;
    }
    .urgent-cell .col-footer-sum {
        color: #c62828 !important;
    }
    .compact-select {
        font-size: 0.7rem !important;
        min-height: 28px !important;
    }
    .compact-select .mud-select-input {
        font-size: 0.7rem !important;
        padding: 2px 4px !important;
    }
    .compact-input {
        font-size: 0.7rem !important;
        min-height: 28px !important;
    }
    .compact-input .mud-input-root {
        font-size: 0.7rem !important;
        padding: 2px 4px !important;
    }
    .summary-flow-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 0.85rem;
    }
    .summary-flow-table th {
        text-align: left;
        padding: 6px 8px;
        border-bottom: 2px solid #e0e0e0;
        color: #333;
        font-weight: 600;
    }
    .summary-flow-table td {
        padding: 5px 8px;
        border-bottom: 1px solid #f0f0f0;
    }
    .summary-flow-table tfoot td {
        border-top: 2px solid #1976D2;
        border-bottom: none;
        padding-top: 6px;
        background-color: #f5f9ff;
    }
    .summary-flow-table tbody tr:hover {
        background-color: #fafafa;
    }
</style>