@page "/section-production-status"
@using MES.Blazor.Services
@using MES.Core.DTOs
@using MES.Core.Models
@using MES.Blazor.Helpers
@using MES.Blazor.Models
@using MES.Blazor.Components
@using Microsoft.AspNetCore.Authorization
@using System.Text.Json
@attribute [Authorize(Roles = Roles.Policies.WorkOrderRead)]
@inject SectionProductionStatusService Service
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject IJSRuntime JS
@inject PageStateService PageState
@inject HttpClient Http

<MudContainer MaxWidth="MaxWidth.False" Class="mt-4 pl-0">
    <!-- 页面标题 -->
    <MudText Typo="Typo.h5" Class="font-weight-bold mb-4">
        <MudIcon Icon="@Icons.Material.Filled.Assessment" Class="mr-2" Color="Color.Primary" />
        工段待产量
    </MudText>

    <!-- 页面顶部工具栏 -->
    <div class="d-flex justify-space-between align-center mb-4">
        <div class="d-flex align-center">
            <ColumnDisplaySelect Columns="_allColumns"
                                 OnColumnToggle="OnColumnToggle"
                                 OnMoveUp="MoveColumnUp"
                                 OnMoveDown="MoveColumnDown" />
            <MudButton Variant="Variant.Text" Size="Size.Small"
                       Color="Color.Default"
                       StartIcon="@Icons.Material.Filled.RestartAlt"
                       OnClick="ResetColumnDisplay" Class="ml-2">
                重置
            </MudButton>
        </div>
        <div class="d-flex align-center">
            <MudButton Variant="Variant.Filled" Size="Size.Small" Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Print"
                       OnClick="PrintAll" Class="mr-4">
                打印
            </MudButton>
            <MudText Typo="Typo.body2">
                共 @_filteredItems.Count 条记录
            </MudText>
        </div>
    </div>

    <!-- 数据表格 -->
    <MudTable @ref="table" T="SectionProductionStatusDto"
              Items="@_filteredItems"
              Dense="true" Hover="true" Elevation="0" Class="auto-table"
              RowsPerPage="@_pageSize" RowsPerPageLabel="每页行数:">
        <HeaderContent>
            @foreach (var col in _visibleColumns)
            {
                <MudTh>
                    <div class="col-header-cell">
                        <span @onclick='() => ToggleSort(col.Key)' style="cursor:pointer" class="th-label">
                            @col.Label
                            @if (sortColumn == col.Key)
                            {
                                @(sortDescending ? " ▼" : " ▲")
                            }
                        </span>
                        @if (col.FilterType != null)
                        {
                            <ExcelFilter T="SectionProductionStatusDto"
                                         Label="@col.Label"
                                         FieldKey="@col.Key"
                                         FilterOptions="@(_filterContextOptions.GetValueOrDefault(col.Key))"
                                         ActiveFilterValues="@(_columnFilters.GetValueOrDefault(col.Key))"
                                         FilterChanged="@(args => OnColumnFilterChanged(args.fieldKey, args.selectedValues))" />
                        }
                    </div>
                </MudTh>
            }
        </HeaderContent>
        <RowTemplate>
            @{ var item = context; }
            @foreach (var col in _visibleColumns)
            {
                <MudTd Class="@(col.Key != "ProcessGroupName" && col.Key != "SectionName" ? "mud-table-cell--right" : "")">
                    @RenderCell(item, col)
                </MudTd>
            }
        </RowTemplate>
        <FooterContent>
            @foreach (var col in _visibleColumns)
            {
                <MudTd Class="col-footer-cell">
                    <span class="col-footer-sum">@RenderFooterCell(col)</span>
                </MudTd>
            }
        </FooterContent>
        <PagerContent>
            <MudTablePager PageSizeOptions="new int[]{10,25,50,100}" />
        </PagerContent>
    </MudTable>

    <!-- 加载遮罩 -->
    <MudOverlay Visible="@_isLoading">
        <div class="d-flex justify-center align-center" style="height: 100%;">
            <MudProgressCircular Indeterminate="true" Size="Size.Large" />
        </div>
    </MudOverlay>
</MudContainer>
