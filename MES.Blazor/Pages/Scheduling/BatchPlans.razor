@page "/batch-plans"
@using MES.Blazor.Services
@using MES.Core.Models
@using MES.Blazor.Helpers
@using MES.Blazor.Components
@using MES.Blazor.Models
@using MES.Core.DTOs.Scheduling
@using Microsoft.AspNetCore.Authorization
@using System.Text.Json
@attribute [Authorize(Roles = Roles.Policies.WorkOrderRead)]
@inject BatchPlanService BatchPlanSvc
@inject BatchPlanScheduleService BatchPlanScheduleSvc
@inject SectionFlowAnalysisService SectionFlowAnalysisSvc
@inject SectionParagraphFlowAnalysisService SectionParagraphFlowAnalysisSvc
@inject DictValueDefinitionService DictValueDefinitionService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject IJSRuntime JS
@inject PageStateService PageState
@inject ColumnPrefsService ColumnPrefs
@inject HttpClient Http

<MudContainer MaxWidth="MaxWidth.False" Class="mt-4 pl-0">
    <!-- 页面顶部工具栏 -->
    <div class="d-flex flex-column mb-4">
        <div class="d-flex justify-space-between align-center mb-4">
            <MudText Typo="Typo.h5" Class="font-weight-bold">
                <MudIcon Icon="@Icons.Material.Filled.Assignment" Class="mr-2" Color="Color.Primary" />
                批次计划
            </MudText>
            <div class="d-flex align-center" style="gap: 8px; margin-right: 24px;">
                <MudButton Variant="Variant.Outlined"
                           Color="@(_showSummaryCard ? Color.Primary : Color.Default)"
                           StartIcon="@(_showSummaryCard ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)"
                           OnClick="ToggleSummaryCard">
                    近日生产量数据
                </MudButton>
                <MudButton Variant="Variant.Outlined"
                           Color="@(_showOutsourcePendingCard ? Color.Primary : Color.Default)"
                           StartIcon="@(_showOutsourcePendingCard ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)"
                           OnClick="ToggleOutsourcePendingCard">
                    实时委外在产
                </MudButton>
                <MudButton Variant="Variant.Outlined"
                           Color="@(_showParagraphCard ? Color.Primary : Color.Default)"
                           StartIcon="@(_showParagraphCard ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)"
                           OnClick="ToggleParagraphCard">
                    段落流转分析
                </MudButton>
                <MudButton Variant="Variant.Outlined"
                           Color="@(_showFlowCard ? Color.Primary : Color.Default)"
                           StartIcon="@(_showFlowCard ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)"
                           OnClick="ToggleFlowCard">
                    工段流转分析
                </MudButton>
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           Disabled="@_isPlanning"
                           OnClick="@HandlePlanAllAsync">
                    @if (_isPlanning)
                    {
                        <MudProgressCircular Size="Size.Small" Class="mr-1" Indeterminate="true" />
                    }
                    计划安排
                </MudButton>
            </div>
        </div>

        <!-- 工段筛选 Tab -->
        <div class="d-flex flex-wrap align-center mb-2" style="gap: 4px 8px;">
            @foreach (var sec in _sectionTabs)
            {
                var isActive = (sec == "全部" && _selectedSection == null)
                    || (sec != "全部" && _selectedSection == sec);
                <MudButton Variant="@(isActive ? Variant.Filled : Variant.Outlined)"
                           Color="@(isActive ? Color.Primary : Color.Default)"
                           Size="Size.Small"
                           Class="ma-0"
                           OnClick="@(() => OnSectionTabChanged(sec == "全部" ? null : sec))">
                    @sec
                </MudButton>
            }
        </div>

        <!-- Tab 汇总 -->
        <div class="d-flex flex-wrap align-center mb-2" style="gap: 12px; font-size: 0.85rem;">
            <MudText Typo="Typo.body2">
                <b>批次数：</b>@_tabBatchCount
            </MudText>
            <MudText Typo="Typo.body2">
                <b>总重量(t)：</b>@((_tabTotalWeight / 1000m).ToString("F1"))
            </MudText>
            <MudText Typo="Typo.body2" Class="text-primary">
                <b>计划流转批次：</b>@_tabFlowBatchCount
            </MudText>
            <MudText Typo="Typo.body2" Class="text-primary">
                <b>计划流转批次重量(t)：</b>@((_tabFlowBatchWeight / 1000m).ToString("F1"))
            </MudText>
            <MudText Typo="Typo.body2" Class="text-error">
                <b>计划特急批次：</b>@_tabKeyBatchCount
            </MudText>
            <MudText Typo="Typo.body2" Class="text-error">
                <b>计划特急批重量(t)：</b>@((_tabKeyBatchWeight / 1000m).ToString("F1"))
            </MudText>
        </div>
    </div>

    <!-- 跨工段汇总卡片（仿原锁计划，工具栏「汇总」按钮切换显隐） -->
    @if (_showSummaryCard)
    {
        <MudCard Class="mb-2 summary-card" Elevation="0">
            <MudCardContent>
                @if (_isLoadingSummary)
                {
                    <div class="d-flex align-center" style="gap:8px;">
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                        <span>汇总加载中...</span>
                    </div>
                }
                <div class="d-flex justify-space-between align-center mb-2">
                    <MudText Typo="Typo.subtitle2"><b>近日生产量数据</b></MudText>
                    <MudButton Variant="Variant.Text" Size="Size.Small" Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.Print" OnClick="PrintSummaryTable">
                        打印
                    </MudButton>
                </div>
                <div id="batch-plan-summary-table" style="overflow-x:auto;">
                    <table style="border-collapse: collapse; width: 100%; font-size: 0.8125rem;">
                        <thead>
                            <tr>
                                <th style="text-align:left; padding:4px 10px; background:#f5f5f5; border:1px solid #e0e0e0;">工段</th>
                                <th style="padding:4px 10px; background:#f5f5f5; border:1px solid #e0e0e0; text-align:center;">前6日(t)</th>
                                <th style="padding:4px 10px; background:#f5f5f5; border:1px solid #e0e0e0; text-align:center;">前3日(t)</th>
                                <th style="padding:4px 10px; background:#fff8e1; border:1px solid #e0e0e0; text-align:center;">今日(t)</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var r in _summaryRows)
                            {
                                var isTotal = r.SectionName == "合计";
                                <tr>
                                    <td style="padding:4px 10px; border:1px solid #e0e0e0; font-weight:@(isTotal ? "700" : "600"); @(isTotal ? "background:#eef3fa;" : "")">@r.SectionName</td>
                                    <td style="padding:4px 10px; border:1px solid #e0e0e0; text-align:center; @(isTotal ? "background:#eef3fa;" : "")">@FormatT(r.Last7DaysWeight)</td>
                                    <td style="padding:4px 10px; border:1px solid #e0e0e0; text-align:center; @(isTotal ? "background:#eef3fa;" : "")">@FormatT(r.Last3DaysWeight)</td>
                                    <td style="padding:4px 10px; border:1px solid #e0e0e0; text-align:center; @(isTotal ? "background:#eef3fa;" : "background:#fff8e1;")">@FormatT(r.TodayWeight)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <MudText Typo="Typo.body2" Class="text-hint" Style="margin-top:4px; font-size:0.75rem;">
                    注：前6日/前3日均不含今日，今日列为实时数据（浅黄底色）；一般工段=生产记录+委外回收量，去油/酸洗=完工记录+委外回收量，荒管检/在制检=过程检验检验重量；合计行=各工段之和。
                </MudText>
            </MudCardContent>
        </MudCard>
    }

    <!-- 实时委外在产折叠卡片（按在产单位×工段二维表，实时查询） -->
    @if (_showOutsourcePendingCard)
    {
        <MudCard Class="mb-2 summary-card" Elevation="0">
            <MudCardContent>
                @if (_isLoadingOutsourcePending)
                {
                    <div class="d-flex align-center" style="gap:8px;">
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                        <span>实时委外在产加载中...</span>
                    </div>
                }
                else if (_outsourcePendingData.Sections.Count == 0)
                {
                    <MudText Typo="Typo.body2" Class="text-hint">暂无在产委外数据</MudText>
                }
                else
                {
                    <div class="d-flex justify-space-between align-center mb-2">
                        <MudText Typo="Typo.subtitle2"><b>实时委外在产</b></MudText>
                        <MudButton Variant="Variant.Text" Size="Size.Small" Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.Print" OnClick="PrintOutsourcePendingTable">
                            打印
                        </MudButton>
                    </div>
                    <div id="batch-plan-outsource-pending-table" style="overflow-x:auto;">
                        <table style="border-collapse: collapse; width: 100%; font-size: 0.8125rem;">
                            <thead>
                                <tr>
                                    <th style="text-align:left; padding:4px 10px; background:#f5f5f5; border:1px solid #e0e0e0;">在产单位</th>
                                    @foreach (var s in _outsourcePendingData.Sections)
                                    {
                                        <th style="padding:4px 10px; background:#f5f5f5; border:1px solid #e0e0e0; text-align:center;">@s (t)</th>
                                    }
                                    <th style="padding:4px 10px; background:#fff8e1; border:1px solid #e0e0e0; text-align:center;">合计(t)</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var r in _outsourcePendingData.Rows)
                                {
                                    var isTotal = r.OutsourceUnit == "合计";
                                    <tr>
                                        <td style="padding:4px 10px; border:1px solid #e0e0e0; font-weight:@(isTotal ? "700" : "600"); @(isTotal ? "background:#eef3fa;" : "")">@r.OutsourceUnit</td>
                                        @foreach (var s in _outsourcePendingData.Sections)
                                        {
                                            <td style="padding:4px 10px; border:1px solid #e0e0e0; text-align:center; @(isTotal ? "background:#eef3fa;" : "")">@FormatOutsourceCell(r.Cells.TryGetValue(s, out var c) ? c : null)</td>
                                        }
                                        <td style="padding:4px 10px; border:1px solid #e0e0e0; text-align:center; font-weight:700; @(isTotal ? "background:#eef3fa;" : "background:#fff8e1;")">@FormatOutsourceCell(r.TotalCell)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <MudText Typo="Typo.body2" Class="text-hint" Style="margin-top:4px; font-size:0.75rem;">
                        注：在产委外 = 状态在产/未产且当前委外单位非空的批次「有效投料重量」，按（在产单位, 当前工段）统计；
                        单元格格式「总量/[流转]/[*特急]」= 总量、其中批次计划实时流转（IsFlow=是）重量、其中批次计划等级急+（特急批）重量（<span style="color:#d32f2f;">*</span> 标红）；0 值留空，单位为重量(t)。
                    </MudText>
                }
            </MudCardContent>
        </MudCard>
    }

    <!-- 段落流转分析折叠查询（纯表，无可持续天数字段） -->
    @if (_showParagraphCard)
    {
        <MudCard Class="mb-2 summary-card" Elevation="0">
            <MudCardContent>
                @if (_isLoadingParagraph)
                {
                    <div class="d-flex align-center" style="gap:8px;">
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                        <span>段落流转分析加载中...</span>
                    </div>
                }
                else
                {
                    <div class="d-flex justify-space-between align-center mb-2">
                        <MudText Typo="Typo.subtitle2"><b>段落流转分析</b></MudText>
                        <MudButton Variant="Variant.Text" Size="Size.Small" Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.Print" OnClick="PrintParagraphAnalysis">
                            打印
                        </MudButton>
                    </div>
                    <MudTable T="SectionParagraphFlowAnalysisDto" Items="@_paragraphRows"
                              Dense="true" Hover="true" Elevation="0" Class="auto-table">
                        <HeaderContent>
                            <MudTh><div class="col-header-cell"><span class="th-label">生产段落</span></div></MudTh>
                            <MudTh Class="mud-table-cell--right"><div class="col-header-cell"><span class="th-label">待在产重量</span></div></MudTh>
                            <MudTh Class="mud-table-cell--center"><div class="col-header-cell"><span class="th-label">总况判定</span></div></MudTh>
                            <MudTh Class="mud-table-cell--right"><div class="col-header-cell"><span class="th-label">计划重点批流转量</span></div></MudTh>
                            <MudTh Class="mud-table-cell--center"><div class="col-header-cell"><span class="th-label">计划流转判定</span></div></MudTh>
                            <MudTh Class="mud-table-cell--right"><div class="col-header-cell"><span class="th-label">特急批重量</span></div></MudTh>
                        </HeaderContent>
                        <RowTemplate Context="item">
                            <MudTd><span class="font-weight-bold">@item.ParagraphName</span></MudTd>
                            <MudTd Class="mud-table-cell--right">@RenderInt(item.PendingTotal)</MudTd>
                            <MudTd Class="mud-table-cell--center">
                                <MudChip Size="Size.Small" Color="@GetStatusColor(item.StatusJudgment)">@(item.StatusJudgment ?? "-")</MudChip>
                            </MudTd>
                            <MudTd Class="mud-table-cell--right">@RenderInt(item.PlanFlowQuantity)</MudTd>
                            <MudTd Class="mud-table-cell--center">
                                <MudChip Size="Size.Small" Color="@GetPlanFlowJudgmentColor(item.PlanFlowJudgment)">@(item.PlanFlowJudgment ?? "-")</MudChip>
                            </MudTd>
                            <MudTd Class="mud-table-cell--right">@RenderInt(item.PlanKeyWeight)</MudTd>
                        </RowTemplate>
                        <FooterContent>
                            <MudTd Class="col-footer-cell">&nbsp;</MudTd>
                            <MudTd Class="col-footer-cell col-footer-sum">@RenderInt(_paragraphRows.Sum(x => x.PendingTotal ?? 0m))</MudTd>
                            <MudTd Class="col-footer-cell">&nbsp;</MudTd>
                            <MudTd Class="col-footer-cell col-footer-sum">@RenderInt(_paragraphRows.Sum(x => x.PlanFlowQuantity ?? 0m))</MudTd>
                            <MudTd Class="col-footer-cell">&nbsp;</MudTd>
                            <MudTd Class="col-footer-cell col-footer-sum">@RenderInt(_paragraphRows.Sum(x => x.PlanKeyWeight ?? 0m))</MudTd>
                        </FooterContent>
                    </MudTable>
                }
            </MudCardContent>
        </MudCard>
    }

    <!-- 工段流转分析折叠查询（纯表，无可持续天数字段） -->
    @if (_showFlowCard)
    {
        <MudCard Class="mb-2 summary-card" Elevation="0">
            <MudCardContent>
                @if (_isLoadingFlow)
                {
                    <div class="d-flex align-center" style="gap:8px;">
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                        <span>工段流转分析加载中...</span>
                    </div>
                }
                else
                {
                    <div class="d-flex justify-space-between align-center mb-2">
                        <MudText Typo="Typo.subtitle2"><b>工段流转分析</b></MudText>
                        <MudButton Variant="Variant.Text" Size="Size.Small" Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.Print" OnClick="PrintFlowAnalysis">
                            打印
                        </MudButton>
                    </div>
                    <MudTable T="SectionFlowAnalysisDto" Items="@_flowRows"
                              Dense="true" Hover="true" Elevation="0" Class="auto-table">
                        <HeaderContent>
                            <MudTh><div class="col-header-cell"><span class="th-label">流转类别</span></div></MudTh>
                            <MudTh Class="mud-table-cell--right"><div class="col-header-cell"><span class="th-label">待在产重量</span></div></MudTh>
                            <MudTh Class="mud-table-cell--center"><div class="col-header-cell"><span class="th-label">总况判定</span></div></MudTh>
                            <MudTh Class="mud-table-cell--right"><div class="col-header-cell"><span class="th-label">计划流转量</span></div></MudTh>
                            <MudTh Class="mud-table-cell--center"><div class="col-header-cell"><span class="th-label">计划流转判定</span></div></MudTh>
                            <MudTh Class="mud-table-cell--right"><div class="col-header-cell"><span class="th-label">特急批重量</span></div></MudTh>
                        </HeaderContent>
                        <RowTemplate Context="item">
                            <MudTd><span class="font-weight-bold">@item.CategoryName</span></MudTd>
                            <MudTd Class="mud-table-cell--right">@RenderInt(item.PendingTotal)</MudTd>
                            <MudTd Class="mud-table-cell--center">
                                <MudChip Size="Size.Small" Color="@GetStatusColor(item.StatusJudgment)">@(item.StatusJudgment ?? "-")</MudChip>
                            </MudTd>
                            <MudTd Class="mud-table-cell--right">@RenderInt(item.PlanFlowQuantity)</MudTd>
                            <MudTd Class="mud-table-cell--center">
                                <MudChip Size="Size.Small" Color="@GetPlanFlowJudgmentColor(item.PlanFlowJudgment)">@(item.PlanFlowJudgment ?? "-")</MudChip>
                            </MudTd>
                            <MudTd Class="mud-table-cell--right">@RenderInt(item.PlanKeyWeight)</MudTd>
                        </RowTemplate>
                        <FooterContent>
                            <MudTd Class="col-footer-cell">&nbsp;</MudTd>
                            <MudTd Class="col-footer-cell col-footer-sum">@RenderInt(_flowRows.Sum(x => x.PendingTotal ?? 0m))</MudTd>
                            <MudTd Class="col-footer-cell">&nbsp;</MudTd>
                            <MudTd Class="col-footer-cell col-footer-sum">@RenderInt(_flowRows.Sum(x => x.PlanFlowQuantity ?? 0m))</MudTd>
                            <MudTd Class="col-footer-cell">&nbsp;</MudTd>
                            <MudTd Class="col-footer-cell col-footer-sum">@RenderInt(_flowRows.Sum(x => x.PlanKeyWeight ?? 0m))</MudTd>
                        </FooterContent>
                    </MudTable>
                }
            </MudCardContent>
        </MudCard>
    }

    <!-- 筛选栏 -->
    <MudGrid>
        <MudItem xs="12" md="6">
            <MudTextField T="string"
                          Label=""
                          Value="@_searchKeyword" ValueExpression="@(() => _searchKeyword)"
                          ValueChanged="@OnSearchChanged"
                          Immediate="true"
                          DebounceInterval="500"
                          Adornment="Adornment.End"
                          AdornmentIcon="@Icons.Material.Filled.Search" />
        </MudItem>
    </MudGrid>

    <MudCard>
        <MudCardContent>
            <!-- 数据表格 -->
            <div id="batch-plan-list-table">
            @{
                var _groupHeaders = GetGroupHeaders();
                var _totalTableWidth = _visibleColumns.Sum(c => int.TryParse(c.Width, out var w) ? w : 100) + 40;
            }
            @* 工具栏：列显隐（左）+ 打印按钮（右）*@
            <div class="list-toolbar">
                <div class="d-flex align-center">
                    <ColumnDisplaySelect Columns="GetToggleableColumns()"
                                         OnColumnToggle="OnColumnToggle"
                                         OnMoveUp="MoveColumnUp"
                                         OnMoveDown="MoveColumnDown" />
                    <MudButton Variant="Variant.Text" Size="Size.Small"
                               Color="Color.Default"
                               StartIcon="@Icons.Material.Filled.RestartAlt"
                               OnClick="ResetColumnDisplay" Class="ml-2">
                        重置
                    </MudButton>
                </div>
                <div class="d-flex align-center" style="margin-left:auto;">
                    <MudButton Variant="Variant.Filled"
                               Size="Size.Small"
                               Color="Color.Primary"
                               Class="ml-2"
                               StartIcon="@Icons.Material.Filled.Print"
                               OnClick="PrintSelected"
                               Disabled="@(_selectedItems.Count == 0)">
                        打印选中 (@_selectedItems.Count)
                    </MudButton>
                    <MudText Typo="Typo.body2" Class="ml-4">
                        共 @_totalCount 条记录
                    </MudText>
                </div>
            </div>
            @* 分组标题栏 *@
            <div class="col-group-header-scroll" id="bp-group-header-scroll">
                <div class="col-group-header-bar" style="width: @(_totalTableWidth)px">
                    @foreach (var gh in _groupHeaders)
                    {
                        <div class="col-group-header-item @gh.CssClass" style="width: @(gh.TotalWidth)px">
                            <span class="col-group-badge">@gh.GroupName</span>
                        </div>
                    }
                </div>
            </div>
            <MudTable @ref="table"
                      T="BatchPlanDto"
                      Items="@_filteredItems"
                      Dense="true"
                      Hover="true"
                      Class="mt-0 auto-table compact-table"
                      Elevation="0"
                      RowsPerPage="@_pageSize"
                      RowsPerPageChanged="@OnRowsPerPageChanged"
                      RowsPerPageLabel="每页行数:">
                <HeaderContent>
                    @{
                        int? _prevGk = null;
                    }
                    <MudTh Class="col-selection-th" Style="width:40px;min-width:40px;max-width:40px;padding:0 4px;">
                        <MudCheckBox T="bool"
                                     Value="@(_selectedItems.Count > 0 && _selectedItems.Count == _totalCount)"
                                     ValueChanged="@((bool v) => SelectAllItems(v))"
                                     Dense="true"
                                     TriState="false" />
                    </MudTh>
                    @foreach (var col in _visibleColumns)
                    {
                        var _isGroupStart = col.GroupKey.HasValue && col.GroupKey != _prevGk;
                        _prevGk = col.GroupKey;
                        var _headerClass = GetHeaderGroupCss(col.GroupKey, _isGroupStart);
                        <MudTh Class="@_headerClass" Style="@($"width: {col.Width}px")">
                            <div class="col-header-cell">
                                <span @onclick='() => ToggleSort(col.Key)' style="cursor:pointer" class="th-label">@col.Label @if (sortColumn == col.Key) {@(sortDescending ? " ▼" : " ▲")}</span>
                                @if (col.FilterType != null)
                                {
                                    <ExcelFilter T="BatchPlanDto"
                                                 Label="@col.Label"
                                                 FieldKey="@col.Key"
                                                 FilterOptions="@(_filterContextOptions.GetValueOrDefault(col.Key))"
                                                 ActiveFilterValues="@(_columnFilters.GetValueOrDefault(col.Key))"
                                                 FilterChanged="@(args => OnColumnFilterChanged(args.fieldKey, args.selectedValues))" />
                                }
                            </div>
                        </MudTh>
                    }
                </HeaderContent>
                <RowTemplate Context="item">
                    @{
                        int? _prevGk2 = null;
                    }
                    <MudTd Class="col-selection-td" Style="width:40px;min-width:40px;max-width:40px;padding:0 4px;">
                        <MudCheckBox T="bool"
                                     Value="@(_selectedItems.Contains(item))"
                                     ValueChanged="@((bool v) => ToggleSelection(item, v))"
                                     Dense="true" />
                    </MudTd>
                    @foreach (var col in _visibleColumns)
                    {
                        var _isGroupStart2 = col.GroupKey.HasValue && col.GroupKey != _prevGk2;
                        _prevGk2 = col.GroupKey;
                        var _cellClass = GetCellGroupCss(col.GroupKey, _isGroupStart2);
                        <MudTd Class="@_cellClass">@RenderCell(item, col)</MudTd>
                    }
                </RowTemplate>
                <FooterContent>
                    @{
                        int? _prevGk3 = null;
                        EnsurePageSumsComputed();
                    }
                    <MudTd Style="width:40px;min-width:40px;max-width:40px;"></MudTd>
                    @foreach (var col in _visibleColumns)
                    {
                        var _isGroupStart3 = col.GroupKey.HasValue && col.GroupKey != _prevGk3;
                        _prevGk3 = col.GroupKey;
                        var _footerClass = GetCellGroupCss(col.GroupKey, _isGroupStart3) + " col-footer-cell";
                        <MudTd Class="@_footerClass">
                            <span class="col-footer-sum">@RenderFooterCell(col)</span>
                        </MudTd>
                    }
                </FooterContent>
                <PagerContent>
                    <MudTablePager PageSizeOptions="new int[]{10,15,25,50,100}" />
                </PagerContent>
            </MudTable>
            </div>
        </MudCardContent>
    </MudCard>
</MudContainer>
