@page "/raw-material-lock-plan"
@using MES.Blazor.Services
@using MES.Core.Models
@using MES.Blazor.Helpers
@using Microsoft.AspNetCore.Authorization
@using MES.Blazor.Components
@using MES.Blazor.Models
@using MES.Core.DTOs.Scheduling
@using System.Text.Json
@inject RawMaterialLockPlanAndExecutionService RawMaterialLockPlanService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject IJSRuntime JS
@inject PageStateService PageState
@inject ColumnPrefsService ColumnPrefs
@inject HttpClient Http
@attribute [Authorize(Roles = Roles.Policies.WorkOrderRead)]

<MudContainer MaxWidth="MaxWidth.False" Class="mt-4 pl-0">
    <!-- 页面标题 + 右上角「待投料量汇总」按钮（与其他排程计划统一） -->
    <div class="d-flex align-center mb-4">
        <MudText Typo="Typo.h5" Class="font-weight-bold">
            <MudIcon Icon="@Icons.Material.Filled.Lock" Class="mr-2" Color="Color.Warning" />
            原锁计划
        </MudText>
        <div style="margin-left:auto;">
            <MudButton Variant="Variant.Outlined"
                       Size="Size.Small"
                       Color="@(_showSummaryCard ? Color.Primary : Color.Default)"
                       StartIcon="@(_showSummaryCard ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)"
                       OnClick="ToggleSummaryCard">
                待投料量汇总
            </MudButton>
        </div>
    </div>

    <!-- 汇总数据卡片（默认折叠，工具栏「汇总」按钮切换显隐） -->
    @if (_showSummaryCard)
    {
        <MudCard Class="mb-2 summary-card" Elevation="0">
            <MudCardContent>
                <div class="d-flex justify-space-between align-center mb-2">
                    <MudText Typo="Typo.subtitle2"><b>待投料量汇总</b></MudText>
                    <MudButton Variant="Variant.Text" Size="Size.Small" Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.Print" OnClick="PrintSummaryTable">
                        打印
                    </MudButton>
                </div>
                <MudGrid>
                    <MudItem xs="12">
                        <div class="d-flex flex-wrap" style="gap: 16px; align-items: center;">
                            <MudText Typo="Typo.body2" Class="font-weight-bold text-brand" Style="min-width: 140px;">
                                <MudIcon Icon="@Icons.Material.Filled.Assignment" Size="Size.Small" Color="Color.Primary" Class="mr-1" />
                                工单总数: @_totalOrderCount 批
                            </MudText>
                            <MudDivider Vertical="true" />
                            <MudText Typo="Typo.body2" Class="text-warning-orange" Style="min-width: 120px;">
                                <MudIcon Icon="@Icons.Material.Filled.HourglassEmpty" Size="Size.Small" Color="Color.Warning" Class="mr-1" />
                                待投料: @(_pendingWeight > 0 ? $"{(_pendingWeight / 1000m).ToString("F1")}t" : "0t")
                                @if (_purchaseCount > 0)
                                {
                                    <text> + {成购：@((_purchaseWeight / 1000m).ToString("F1"))t}</text>
                                }
                            </MudText>
                        </div>
                    </MudItem>
                    <MudItem xs="12" Class="mt-2">
                        <div style="display:flex; gap:16px; flex-wrap:wrap;">
                            @* 待投料矩阵：行=原料锁定备注，列=主号计划性 *@
                            <div id="rmlp-summary-pending" style="flex:1; min-width:340px;">
                                <div style="font-weight:600; color:#E65100; margin-bottom:4px;">待投料</div>
                                <table style="border-collapse: collapse; width: 100%; font-size: 0.8125rem;">
                                    <thead>
                                        <tr>
                                            <th style="text-align:left; padding:4px 6px; background:#f5f5f5; border:1px solid #e0e0e0;">备注 \ 计划性</th>
                                            @foreach (var u in _urgencyColumns)
                                            {
                                                <th style="padding:4px 6px; background:#f5f5f5; border:1px solid #e0e0e0; text-align:center;">@UrgencyLevelKeys.KeyToChinese[u]</th>
                                            }
                                            <th style="padding:4px 10px; background:#eef3fa; border:1px solid #e0e0e0; text-align:center;">合计</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var r in RawMaterialLockRemarkKeys.All)
                                        {
                                            <tr>
                                                <td style="padding:4px 10px; border:1px solid #e0e0e0; font-weight:600;">@RawMaterialLockRemarkKeys.KeyToChinese[r]</td>
                                                @foreach (var u in _urgencyColumns)
                                                {
                                                    <td style="padding:4px 10px; border:1px solid #e0e0e0; text-align:center;">@FormatMatrixCell(GetMatrixCell(r, u))</td>
                                                }
                                                <td style="padding:4px 10px; border:1px solid #e0e0e0; text-align:center; background:#f0f7f0; font-weight:600;">@FormatMatrixCell(GetMatrixRowTotal(r))</td>
                                            </tr>
                                        }
                                        <tr>
                                            <td style="padding:4px 10px; border:1px solid #e0e0e0; font-weight:600; background:#eef3fa;">合计</td>
                                            @foreach (var u in _urgencyColumns)
                                            {
                                                <td style="padding:4px 10px; border:1px solid #e0e0e0; text-align:center; background:#eef3fa; font-weight:600;">@FormatMatrixCell(GetMatrixColumnTotal(u))</td>
                                            }
                                            <td style="padding:4px 10px; border:1px solid #e0e0e0; text-align:center; background:#e8f0e8; font-weight:700;">@FormatMatrixCell(GetMatrixGrandTotal())</td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                            @* 成购矩阵：仅当有外购成品未到时显示 *@
                            @if (_purchaseCount > 0)
                            {
                                <div id="rmlp-summary-purchase" style="flex:1; min-width:340px;">
                                    <div style="font-weight:600; color:#1565C0; margin-bottom:4px;">成购（外购成品）</div>
                                    <table style="border-collapse: collapse; width: 100%; font-size: 0.8125rem;">
                                        <thead>
                                            <tr>
                                                <th style="text-align:left; padding:4px 6px; background:#f5f5f5; border:1px solid #e0e0e0;">备注 \ 计划性</th>
                                                @foreach (var u in _urgencyColumns)
                                                {
                                                    <th style="padding:4px 6px; background:#f5f5f5; border:1px solid #e0e0e0; text-align:center;">@UrgencyLevelKeys.KeyToChinese[u]</th>
                                                }
                                                <th style="padding:4px 10px; background:#eef3fa; border:1px solid #e0e0e0; text-align:center;">合计</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var r in RawMaterialLockRemarkKeys.All)
                                            {
                                                <tr>
                                                    <td style="padding:4px 10px; border:1px solid #e0e0e0; font-weight:600;">@RawMaterialLockRemarkKeys.KeyToChinese[r]</td>
                                                    @foreach (var u in _urgencyColumns)
                                                    {
                                                        <td style="padding:4px 10px; border:1px solid #e0e0e0; text-align:center;">@FormatPurchaseCell(GetMatrixCell(r, u))</td>
                                                    }
                                                    <td style="padding:4px 10px; border:1px solid #e0e0e0; text-align:center; background:#f0f7f0; font-weight:600;">@FormatPurchaseCell(GetMatrixRowTotal(r))</td>
                                                </tr>
                                            }
                                            <tr>
                                                <td style="padding:4px 10px; border:1px solid #e0e0e0; font-weight:600; background:#eef3fa;">合计</td>
                                                @foreach (var u in _urgencyColumns)
                                                {
                                                    <td style="padding:4px 10px; border:1px solid #e0e0e0; text-align:center; background:#eef3fa; font-weight:600;">@FormatPurchaseCell(GetMatrixColumnTotal(u))</td>
                                                }
                                                <td style="padding:4px 10px; border:1px solid #e0e0e0; text-align:center; background:#e8f0e8; font-weight:700;">@FormatPurchaseCell(GetMatrixGrandTotal())</td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                            }
                        </div>
                    </MudItem>

                    @* 理论待投料截日汇总：原锁类别 × 日期桶（按理论截止投料日归桶，空→远日量） *@
                    <MudItem xs="12" Class="mt-4">
                        <div style="font-weight:600; color:#1565C0; margin-bottom:4px;">理论待投料截日</div>
                        <div id="rmlp-summary-cutoff">
                            <table style="border-collapse: collapse; width: 100%; font-size: 0.8125rem;">
                                <thead>
                                    <tr>
                                        <th style="text-align:left; padding:4px 6px; background:#f5f5f5; border:1px solid #e0e0e0;">原锁类别</th>
                                        <th style="padding:4px 6px; background:#f5f5f5; border:1px solid #e0e0e0; text-align:center;">待投料总量</th>
                                        @foreach (var b in _cutoffBuckets)
                                        {
                                            <th style="padding:4px 6px; background:#f5f5f5; border:1px solid #e0e0e0; text-align:center;">@b.Label</th>
                                        }
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var r in _cutoffSummaryRows)
                                    {
                                        var isTotal = r.Category == "合计";
                                        <tr>
                                            <td style="padding:4px 10px; border:1px solid #e0e0e0; font-weight:600; @(isTotal ? "background:#e8f0e8;" : "")">@r.Category</td>
                                            <td style="padding:4px 10px; border:1px solid #e0e0e0; text-align:center; @(isTotal ? "background:#e8f0e8;" : "")">@FormatCutoffCell(r.Total)</td>
                                            @foreach (var v in r.Buckets)
                                            {
                                                <td style="padding:4px 10px; border:1px solid #e0e0e0; text-align:center; @(isTotal ? "background:#e8f0e8;" : "")">@FormatCutoffCell(v)</td>
                                            }
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </MudItem>
                </MudGrid>
            </MudCardContent>
        </MudCard>
    }

    <MudCard>
        <MudCardContent Class="py-1">
            <!-- 筛选栏 -->
            <MudGrid>
                <MudItem xs="12" md="6">
                    <MudTextField T="string"
                                  Label="工单号/订单号/业务员/客户/牌号/规格/主号"
                                  Value="@_searchKeyword" ValueExpression="@(() => _searchKeyword)"
                                  ValueChanged="@OnSearchChanged"
                                  Immediate="true"
                                  DebounceInterval="500"
                                  Dense="true"
                                  Adornment="Adornment.End"
                                  AdornmentIcon="@Icons.Material.Filled.Search" />
                </MudItem>
            </MudGrid>

            <!-- 数据表格 -->
            <div id="raw-material-lock-plan-list-table" class="mt-1">
            @{
                var _groupHeaders = GetGroupHeaders();
                var _totalTableWidth = _visibleColumns.Sum(c => int.TryParse(c.Width, out var w) ? w : 100) + 40;
            }
            @* 工具栏：列显隐（左）+ 打印按钮（右），参考订单列表布局 *@
            <div class="list-toolbar">
                <div class="d-flex align-center">
                    <ColumnDisplaySelect Columns="_allColumns"
                                         OnColumnToggle="OnColumnToggle"
                                         OnMoveUp="MoveColumnUp"
                                         OnMoveDown="MoveColumnDown" />
                    <MudButton Variant="Variant.Text" Size="Size.Small"
                               Color="Color.Default"
                               StartIcon="@Icons.Material.Filled.RestartAlt"
                               OnClick="ResetColumnDisplay" Class="ml-2">
                        重置
                    </MudButton>
                </div>
                <div class="d-flex align-center" style="margin-left:auto;">
                    <MudButton Variant="Variant.Filled"
                               Size="Size.Small"
                               Color="Color.Primary"
                               Class="ml-2"
                               StartIcon="@Icons.Material.Filled.Print"
                               OnClick="PrintSelected"
                               Disabled="@(_selectedItems.Count == 0)">
                        打印选中 (@_selectedItems.Count)
                    </MudButton>
                    <MudText Typo="Typo.body2" Class="ml-4">
                        共 @_filteredItems.Count 条记录
                    </MudText>
                </div>
            </div>
            @* 分组标题栏（flex bar，JS 测量宽度后精确定位） *@
            <div class="col-group-header-scroll" id="rmlp-group-header-scroll">
                <div class="col-group-header-bar" style="width: @(_totalTableWidth)px">
                    @foreach (var gh in _groupHeaders)
                    {
                        <div class="col-group-header-item @gh.CssClass" style="width: @(gh.TotalWidth)px">
                            <span class="col-group-badge">@gh.GroupName</span>
                        </div>
                    }
                </div>
            </div>
            <MudTable @ref="table"
                      T="RawMaterialLockPlanAndExecutionDto"
                      Items="@_filteredItems"
                      Dense="true"
                      Hover="true"
                      Class="mt-0 auto-table compact-table"
                      Elevation="0"
                      RowsPerPage="@_pageSize"
                      RowsPerPageLabel="每页行数:">
                <HeaderContent>
                    @{
                        int? _prevGk = null;
                    }
                    <MudTh Class="col-selection-th" Style="width:40px;min-width:40px;max-width:40px;padding:0 4px;">
                        <MudCheckBox T="bool"
                                     Value="@(_selectedItems.Count > 0 && _selectedItems.Count == _filteredItems.Count)"
                                     ValueChanged="@((bool v) => SelectAllItems(v))"
                                     Dense="true"
                                     TriState="false" />
                    </MudTh>
                    @foreach (var col in _visibleColumns)
                    {
                        var _isGroupStart = col.GroupKey.HasValue && col.GroupKey != _prevGk;
                        _prevGk = col.GroupKey;
                        var _headerClass = GetHeaderGroupCss(col.GroupKey, _isGroupStart) + col.LevelCssClass + col.HighlightCssClass;
                        <MudTh Class="@_headerClass" Style="@($"width: {col.Width}px")">
                            <div class="col-header-cell">
                                <span @onclick='() => ToggleSort(col.Key)' style="cursor:pointer" class="th-label">@col.Label @if (sortColumn == col.Key) {@(sortDescending ? " ▼" : " ▲")}</span>
                                @if (col.FilterType != null)
                                {
                                    <ExcelFilter T="RawMaterialLockPlanAndExecutionDto"
                                                 Label="@col.Label"
                                                 FieldKey="@col.Key"
                                                 FilterOptions="@(_filterContextOptions.GetValueOrDefault(col.Key))"
                                                 ActiveFilterValues="@(_columnFilters.GetValueOrDefault(col.Key))"
                                                 FilterChanged="@(args => OnColumnFilterChanged(args.fieldKey, args.selectedValues))" />
                                }
                            </div>
                        </MudTh>
                    }
                </HeaderContent>
                <RowTemplate Context="item">
                    @{
                        int? _prevGk2 = null;
                    }
                    <MudTd Class="col-selection-td" Style="width:40px;min-width:40px;max-width:40px;padding:0 4px;">
                        <MudCheckBox T="bool"
                                     Value="@(_selectedItems.Contains(item))"
                                     ValueChanged="@((bool v) => ToggleSelection(item, v))"
                                     Dense="true" />
                    </MudTd>
                    @foreach (var col in _visibleColumns)
                    {
                        var _isGroupStart2 = col.GroupKey.HasValue && col.GroupKey != _prevGk2;
                        _prevGk2 = col.GroupKey;
                        var _cellClass = GetCellGroupCss(col.GroupKey, _isGroupStart2) + (col.HighlightCssClass ?? "");
                        <MudTd Class="@_cellClass">@RenderCell(item, col)</MudTd>
                    }
                </RowTemplate>
                <FooterContent>
                    <MudTd Style="width:40px;min-width:40px;max-width:40px;"></MudTd>
                    @{
                        int? _prevGk3 = null;
                        EnsurePageSumsComputed();
                    }
                    @foreach (var col in _visibleColumns)
                    {
                        var _isGroupStart3 = col.GroupKey.HasValue && col.GroupKey != _prevGk3;
                        _prevGk3 = col.GroupKey;
                        var _footerClass = GetCellGroupCss(col.GroupKey, _isGroupStart3) + " col-footer-cell";
                        <MudTd Class="@_footerClass">
                            <span class="col-footer-sum">@RenderFooterCell(col)</span>
                        </MudTd>
                    }
                </FooterContent>
                <PagerContent>
                    <MudTablePager PageSizeOptions="new int[]{10,15,25,50,100}" />
                </PagerContent>
            </MudTable>
            </div>
        </MudCardContent>
    </MudCard>
</MudContainer>
