@page "/raw-material-lock-plan"
@using MES.Blazor.Services
@using MES.Core.Models
@using MES.Blazor.Helpers
@using Microsoft.AspNetCore.Authorization
@using MES.Blazor.Components
@using MES.Blazor.Models
@using MES.Core.DTOs.Scheduling
@using System.Text.Json
@inject RawMaterialLockPlanAndExecutionService RawMaterialLockPlanService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject IJSRuntime JS
@inject PageStateService PageState
@inject ColumnPrefsService ColumnPrefs
@inject HttpClient Http
@attribute [Authorize(Roles = Roles.Policies.WorkOrderRead)]

<MudContainer MaxWidth="MaxWidth.False" Class="mt-4 pl-0">
    <!-- 页面顶部工具栏 -->
    <div class="d-flex justify-space-between align-center mb-4">
        <MudText Typo="Typo.h5" Class="font-weight-bold">
            <MudIcon Icon="@Icons.Material.Filled.Lock" Class="mr-2" Color="Color.Warning" />
            原锁计划
        </MudText>
    </div>

    <!-- 汇总数据栏 -->
    <MudPaper Class="pa-4 mb-1" Elevation="0" Style="background: #FAFBFC; border: 1px solid #E0E0E0; border-radius: 8px;">
        <MudGrid>
            <MudItem xs="12">
                <div class="d-flex flex-wrap" style="gap: 16px; align-items: center;">
                    <MudText Typo="Typo.body2" Class="font-weight-bold" Style="color: #1565C0; min-width: 140px;">
                        <MudIcon Icon="@Icons.Material.Filled.Assignment" Size="Size.Small" Color="Color.Primary" Class="mr-1" />
                        工单总数: @_totalOrderCount 批
                    </MudText>
                    <MudDivider Vertical="true" />
                    <MudText Typo="Typo.body2" Style="color: #1565C0; min-width: 120px;">
                        <MudIcon Icon="@Icons.Material.Filled.ShoppingCart" Size="Size.Small" Color="Color.Primary" Class="mr-1" />
                        成品在购: @(_outsourceWeight > 0 ? $"{(_outsourceWeight / 1000m).ToString("F1")}t" : "0t")
                    </MudText>
                    <MudDivider Vertical="true" />
                    <MudText Typo="Typo.body2" Style="color: #E65100; min-width: 120px;">
                        <MudIcon Icon="@Icons.Material.Filled.HourglassEmpty" Size="Size.Small" Color="Color.Warning" Class="mr-1" />
                        待投料: @(_pendingWeight > 0 ? $"{(_pendingWeight / 1000m).ToString("F1")}t" : "0t")
                    </MudText>
                </div>
            </MudItem>
            <MudItem xs="12" Class="mt-1">
                <div class="d-flex flex-wrap" style="gap: 12px; align-items: center;">
                    <MudChip Size="Size.Small" Color="Color.Primary">成品在购</MudChip>
                    <MudChip Size="Size.Small" Color="Color.Error" Variant="Variant.Outlined" Class="pa-1">A+急 @(_outsourceWeight_AJ > 0 ? $"{(_outsourceWeight_AJ / 1000m).ToString("F1")}t" : "0t")</MudChip>
                    <MudChip Size="Size.Small" Color="Color.Error" Variant="Variant.Outlined" Class="pa-1">A急 @(_outsourceWeight_A > 0 ? $"{(_outsourceWeight_A / 1000m).ToString("F1")}t" : "0t")</MudChip>
                    <MudChip Size="Size.Small" Color="Color.Warning" Variant="Variant.Outlined" Class="pa-1">B顺 @(_outsourceWeight_B > 0 ? $"{(_outsourceWeight_B / 1000m).ToString("F1")}t" : "0t")</MudChip>
                    <MudChip Size="Size.Small" Variant="Variant.Outlined" Class="pa-1">C缓 @(_outsourceWeight_C > 0 ? $"{(_outsourceWeight_C / 1000m).ToString("F1")}t" : "0t")</MudChip>
                    <MudChip Size="Size.Small" Variant="Variant.Outlined" Class="pa-1">D缓 @(_outsourceWeight_D > 0 ? $"{(_outsourceWeight_D / 1000m).ToString("F1")}t" : "0t")</MudChip>
                    <MudDivider Vertical="true" />
                    <MudText Typo="Typo.body2" Style="color: #1565C0;">
                        <MudIcon Icon="@Icons.Material.Filled.PlayArrow" Size="Size.Small" Color="Color.Primary" Class="mr-1" />
                        预执行(外购): @_preInputOutsourceCount 单 / @(_preInputOutsourceWeight > 0 ? $"{(_preInputOutsourceWeight / 1000m).ToString("F1")}t" : "0t")
                    </MudText>
                </div>
            </MudItem>
            <MudItem xs="12" Class="mt-1">
                <div class="d-flex flex-wrap" style="gap: 12px; align-items: center;">
                    <MudChip Size="Size.Small" Color="Color.Primary">待投料</MudChip>
                    <MudChip Size="Size.Small" Color="Color.Error" Variant="Variant.Outlined" Class="pa-1">A+急 @(_pendingWeight_AJ > 0 ? $"{(_pendingWeight_AJ / 1000m).ToString("F1")}t" : "0t")</MudChip>
                    <MudChip Size="Size.Small" Color="Color.Error" Variant="Variant.Outlined" Class="pa-1">A急 @(_pendingWeight_A > 0 ? $"{(_pendingWeight_A / 1000m).ToString("F1")}t" : "0t")</MudChip>
                    <MudChip Size="Size.Small" Color="Color.Warning" Variant="Variant.Outlined" Class="pa-1">B顺 @(_pendingWeight_B > 0 ? $"{(_pendingWeight_B / 1000m).ToString("F1")}t" : "0t")</MudChip>
                    <MudChip Size="Size.Small" Variant="Variant.Outlined" Class="pa-1">C缓 @(_pendingWeight_C > 0 ? $"{(_pendingWeight_C / 1000m).ToString("F1")}t" : "0t")</MudChip>
                    <MudChip Size="Size.Small" Variant="Variant.Outlined" Class="pa-1">D缓 @(_pendingWeight_D > 0 ? $"{(_pendingWeight_D / 1000m).ToString("F1")}t" : "0t")</MudChip>
                    <MudDivider Vertical="true" />
                    <MudText Typo="Typo.body2" Style="color: #1565C0;">
                        <MudIcon Icon="@Icons.Material.Filled.PlayArrow" Size="Size.Small" Color="Color.Primary" Class="mr-1" />
                        预执行(投料): @_preInputSelfCount 单 / @(_preInputSelfWeight > 0 ? $"{(_preInputSelfWeight / 1000m).ToString("F1")}t" : "0t")
                    </MudText>
                </div>
            </MudItem>
        </MudGrid>
    </MudPaper>

    <MudCard>
        <MudCardContent Class="py-1">
            <!-- 筛选栏 -->
            <MudGrid>
                <MudItem xs="12" md="6">
                    <MudTextField T="string"
                                  Label="工单号/订单号/业务员/客户/牌号/规格/主号"
                                  Value="@_searchKeyword"
                                  ValueChanged="@OnSearchChanged"
                                  Immediate="true"
                                  DebounceInterval="500"
                                  Clearable="true"
                                  ClearButton="true"
                                  Dense="true"
                                  Adornment="Adornment.End"
                                  AdornmentIcon="@Icons.Material.Filled.Search" />
                </MudItem>
            </MudGrid>

            <!-- 数据表格 -->
            <div id="raw-material-lock-plan-list-table" class="mt-1">
            @{
                var _groupHeaders = GetGroupHeaders();
                var _totalTableWidth = _visibleColumns.Sum(c => int.TryParse(c.Width, out var w) ? w : 100) + 40;
            }
            @* 工具栏：列显隐（左）+ 打印按钮（右），参考订单列表布局 *@
            <div class="woe-toolbar" style="min-height:28px;padding:2px 0;display:flex;align-items:center;">
                <div class="d-flex align-center">
                    <ColumnDisplaySelect Columns="_allColumns"
                                         OnColumnToggle="OnColumnToggle"
                                         OnMoveUp="MoveColumnUp"
                                         OnMoveDown="MoveColumnDown" />
                    <MudButton Variant="Variant.Text" Size="Size.Small"
                               Color="Color.Default"
                               StartIcon="@Icons.Material.Filled.RestartAlt"
                               OnClick="ResetColumnDisplay" Class="ml-2">
                        重置
                    </MudButton>
                </div>
                <div class="d-flex align-center" style="margin-left:auto;">
                    <MudButton Variant="Variant.Filled"
                               Size="Size.Small"
                               Color="Color.Primary"
                               Class="ml-2"
                               StartIcon="@Icons.Material.Filled.Print"
                               OnClick="PrintSelected"
                               Disabled="@(_selectedItems.Count == 0)">
                        打印选中 (@_selectedItems.Count)
                    </MudButton>
                    <MudText Typo="Typo.body2" Class="ml-4">
                        共 @_filteredItems.Count 条记录
                    </MudText>
                </div>
            </div>
            @* 分组标题栏（flex bar，JS 测量宽度后精确定位） *@
            <div class="col-group-header-scroll" id="rmlp-group-header-scroll">
                <div class="col-group-header-bar" style="width: @(_totalTableWidth)px">
                    @foreach (var gh in _groupHeaders)
                    {
                        <div class="col-group-header-item @gh.CssClass" style="width: @(gh.TotalWidth)px">
                            <span class="col-group-badge">@gh.GroupName</span>
                        </div>
                    }
                </div>
            </div>
            <MudTable @ref="table"
                      T="RawMaterialLockPlanAndExecutionDto"
                      Items="@_filteredItems"
                      Dense="true"
                      Hover="true"
                      Class="mt-0 auto-table compact-table"
                      Elevation="0"
                      RowsPerPage="@_pageSize"
                      RowsPerPageLabel="每页行数:">
                <HeaderContent>
                    @{
                        int? _prevGk = null;
                    }
                    <MudTh Class="col-selection-th" Style="width:40px;min-width:40px;max-width:40px;padding:0 4px;">
                        <MudCheckBox T="bool"
                                     Value="@(_selectedItems.Count > 0 && _selectedItems.Count == _filteredItems.Count)"
                                     ValueChanged="@((bool v) => SelectAllItems(v))"
                                     Dense="true"
                                     TriState="false" />
                    </MudTh>
                    @foreach (var col in _visibleColumns)
                    {
                        var _isGroupStart = col.GroupKey.HasValue && col.GroupKey != _prevGk;
                        _prevGk = col.GroupKey;
                        var _headerClass = GetHeaderGroupCss(col.GroupKey, _isGroupStart);
                        <MudTh Class="@_headerClass" Style="@($"width: {col.Width}px")">
                            <div class="col-header-cell">
                                <span @onclick='() => ToggleSort(col.Key)' style="cursor:pointer" class="th-label">@col.Label @if (sortColumn == col.Key) {@(sortDescending ? " ▼" : " ▲")}</span>
                                @if (col.FilterType != null)
                                {
                                    <ExcelFilter T="RawMaterialLockPlanAndExecutionDto"
                                                 Label="@col.Label"
                                                 FieldKey="@col.Key"
                                                 FilterOptions="@(_filterContextOptions.GetValueOrDefault(col.Key))"
                                                 ActiveFilterValues="@(_columnFilters.GetValueOrDefault(col.Key))"
                                                 FilterChanged="@(args => OnColumnFilterChanged(args.fieldKey, args.selectedValues))" />
                                }
                            </div>
                        </MudTh>
                    }
                </HeaderContent>
                <RowTemplate Context="item">
                    @{
                        int? _prevGk2 = null;
                    }
                    <MudTd Class="col-selection-td" Style="width:40px;min-width:40px;max-width:40px;padding:0 4px;">
                        <MudCheckBox T="bool"
                                     Value="@(_selectedItems.Contains(item))"
                                     ValueChanged="@((bool v) => ToggleSelection(item, v))"
                                     Dense="true" />
                    </MudTd>
                    @foreach (var col in _visibleColumns)
                    {
                        var _isGroupStart2 = col.GroupKey.HasValue && col.GroupKey != _prevGk2;
                        _prevGk2 = col.GroupKey;
                        var _cellClass = GetCellGroupCss(col.GroupKey, _isGroupStart2);
                        <MudTd Class="@_cellClass">@RenderCell(item, col)</MudTd>
                    }
                </RowTemplate>
                <FooterContent>
                    <MudTd Style="width:40px;min-width:40px;max-width:40px;"></MudTd>
                    @{
                        int? _prevGk3 = null;
                    }
                    @foreach (var col in _visibleColumns)
                    {
                        var _isGroupStart3 = col.GroupKey.HasValue && col.GroupKey != _prevGk3;
                        _prevGk3 = col.GroupKey;
                        var _footerClass = GetCellGroupCss(col.GroupKey, _isGroupStart3) + " col-footer-cell";
                        <MudTd Class="@_footerClass">
                            <span class="col-footer-sum">@RenderFooterCell(col)</span>
                        </MudTd>
                    }
                </FooterContent>
                <PagerContent>
                    <MudTablePager PageSizeOptions="new int[]{10,15,25,50,100}" />
                </PagerContent>
            </MudTable>
            </div>
        </MudCardContent>
    </MudCard>
</MudContainer>
