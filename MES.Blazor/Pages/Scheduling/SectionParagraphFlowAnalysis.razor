@page "/section-paragraph-flow-analysis"
@using MES.Blazor.Services
@using MES.Core.Models
@using MES.Blazor.Helpers
@using MES.Blazor.Models
@using MES.Blazor.Components
@using MES.Core.DTOs.Scheduling
@using Microsoft.AspNetCore.Authorization
@using System.Text.Json
@attribute [Authorize(Roles = Roles.Policies.WorkOrderRead)]
@inject SectionParagraphFlowAnalysisService Service
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject IJSRuntime JS
@inject PageStateService PageState
@inject ColumnPrefsService ColumnPrefs
@inject HttpClient Http

<MudContainer MaxWidth="MaxWidth.False" Class="mt-4 pl-0">
    <!-- 页面顶部工具栏 -->
    <div class="d-flex align-center mb-4">
        <MudText Typo="Typo.h5" Class="font-weight-bold">
            <MudIcon Icon="@Icons.Material.Filled.Analytics" Class="mr-2" Color="Color.Primary" />
            段落流转分析
        </MudText>
    </div>

    <!-- 数据表格 -->
    <MudTable @ref="table" T="SectionParagraphFlowAnalysisDto"
              Items="@_filteredItems"
              Dense="true" Hover="true" Elevation="0" Class="auto-table"
              RowsPerPage="@_pageSize" RowsPerPageLabel="每页行数:">
        <ToolBarContent>
            <ColumnDisplaySelect Columns="_allColumns"
                                 OnColumnToggle="OnColumnToggle"
                                 OnMoveUp="MoveColumnUp"
                                 OnMoveDown="MoveColumnDown" />
            <MudButton Variant="Variant.Text" Size="Size.Small"
                       Color="Color.Default"
                       StartIcon="@Icons.Material.Filled.RestartAlt"
                       OnClick="ResetColumnDisplay" Class="ml-2">
                重置
            </MudButton>
            <MudSpacer />
            <MudButton Variant="Variant.Filled" Size="Size.Small" Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Print"
                       OnClick="PrintAll" Class="mr-4">
                打印
            </MudButton>
            <MudText Typo="Typo.body2">
                共 @_filteredItems.Count 条记录
            </MudText>
        </ToolBarContent>
        <HeaderContent>
            @foreach (var col in _visibleColumns)
            {
                var colClass = col.Key switch
                {
                    "PendingTotal" or "PlanFlowQuantity" or "PlanKeyWeight" or "SustainableDays" => "mud-table-cell--right",
                    "PlanFlowJudgment" or "StatusJudgment" => "mud-table-cell--center",
                    _ => ""
                };
                <MudTh Class="@colClass">
                    <div class="col-header-cell">
                        <span @onclick='() => ToggleSort(col.Key)' style="cursor:pointer" class="th-label">
                            @col.Label
                            @if (sortColumn == col.Key)
                            {
                                @(sortDescending ? " ▼" : " ▲")
                            }
                        </span>
                        @if (col.FilterType != null)
                        {
                            <ExcelFilter T="SectionParagraphFlowAnalysisDto"
                                         Label="@col.Label"
                                         FieldKey="@col.Key"
                                         FilterOptions="@(_filterContextOptions.GetValueOrDefault(col.Key))"
                                         ActiveFilterValues="@(_columnFilters.GetValueOrDefault(col.Key))"
                                         FilterChanged="@(args => OnColumnFilterChanged(args.fieldKey, args.selectedValues))" />
                        }
                    </div>
                </MudTh>
            }
        </HeaderContent>
        <RowTemplate Context="item">
            @foreach (var col in _visibleColumns)
            {
                var cellClass = col.Key switch
                {
                    "PendingTotal" or "PlanFlowQuantity" or "PlanKeyWeight" or "SustainableDays" => "mud-table-cell--right",
                    "PlanFlowJudgment" or "StatusJudgment" => "mud-table-cell--center",
                    _ => ""
                };
                <MudTd Class="@cellClass">
                    @if (col.Key == "Paragraph")
                    {
                        <span class="font-weight-bold">@item.ParagraphName</span>
                    }
                    else if (col.Key == "PendingTotal")
                    {
                        @RenderInt(item.PendingTotal)
                    }
                    else if (col.Key == "PlanFlowQuantity")
                    {
                        @RenderInt(item.PlanFlowQuantity)
                    }
                    else if (col.Key == "PlanFlowJudgment")
                    {
                        <MudChip Size="Size.Small"
                                 Color="@GetPlanFlowJudgmentColor(item.PlanFlowJudgment)">
                            @(item.PlanFlowJudgment ?? "-")
                        </MudChip>
                    }
                    else if (col.Key == "PlanKeyWeight")
                    {
                        @RenderInt(item.PlanKeyWeight)
                    }
                    else if (col.Key == "SustainableDays")
                    {
                        @RenderDecimal(item.SustainableDays)
                    }
                    else if (col.Key == "StatusJudgment")
                    {
                        <MudChip Size="Size.Small"
                                 Color="@GetStatusColor(item.StatusJudgment)">
                            @(item.StatusJudgment ?? "-")
                        </MudChip>
                    }
                    else
                    {
                        @("")
                    }
                </MudTd>
            }
        </RowTemplate>
        <FooterContent>
            @foreach (var col in _visibleColumns)
            {
                var footerClass = col.Key switch
                {
                    "PendingTotal" or "PlanFlowQuantity" or "PlanKeyWeight" or "SustainableDays" => "col-footer-sum",
                    _ => ""
                };
                <MudTd Class="@($"col-footer-cell {footerClass}")">
                    @if (col.Key == "PendingTotal")
                    {
                        <text>合计: @RenderFooterCell(col)</text>
                    }
                    else if (col.Key == "SustainableDays" && _filteredItems.Any(x => x.SustainableDays.HasValue))
                    {
                        <text>均值: @RenderDecimal(_filteredItems.Where(x => x.SustainableDays.HasValue).Average(x => x.SustainableDays!.Value))</text>
                    }
                    else if (_summableColumnKeys.Contains(col.Key))
                    {
                        <text>合计: @RenderFooterCell(col)</text>
                    }
                    else
                    {
                        <text>&nbsp;</text>
                    }
                </MudTd>
            }
        </FooterContent>
        <PagerContent>
            <MudTablePager PageSizeOptions="new int[]{10,25,50,100}" />
        </PagerContent>
    </MudTable>

    <!-- 加载遮罩 -->
    <MudOverlay Visible="@_isLoading">
        <div class="d-flex justify-center align-center" style="height: 100%;">
            <MudProgressCircular Indeterminate="true" Size="Size.Large" />
        </div>
    </MudOverlay>
</MudContainer>
