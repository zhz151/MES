@page "/orders"
@using MES.Blazor.Services
@using MES.Core.DTOs
@using MES.Core.Models
@using MES.Core.Enums
@using Microsoft.AspNetCore.Authorization
@using MES.Blazor.Shared
@inject OrderService OrderService
@inject ProductRequirementService RequirementService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject IJSRuntime JS
@attribute [Authorize]

<div class="mt-4">
    <MudCard>
        <MudCardHeader>
            <CardHeaderContent>
                <MudText Typo="Typo.h5" Class="font-weight-bold">
                    <MudIcon Icon="@Icons.Material.Filled.Receipt" Class="mr-2" Color="Color.Primary" />
                    订单管理
                </MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">销售订单列表</MudText>
            </CardHeaderContent>
            <CardHeaderActions>
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Add"
                           OnClick="NavigateToCreate">
                    新建订单
                </MudButton>
            </CardHeaderActions>
        </MudCardHeader>

        <MudCardContent>
            <!-- 筛选栏 -->
            <MudGrid>
                <MudItem xs="12" md="6">
                    <MudTextField T="string"
                                  Label="模糊搜索 - 订单号/客户名称/业务员/最终客户/状态"
                                  Placeholder="输入关键字..."
                                  Value="searchKeyword"
                                  ValueChanged="@OnSearchChanged"
                                  Immediate="true"
                                  DebounceInterval="500"
                                  Clearable="true"
                                  ClearButton="true"
                                  Adornment="Adornment.End"
                                  AdornmentIcon="@Icons.Material.Filled.Search" />
                </MudItem>
                <MudItem xs="12" md="3">
                    <MudSelect T="string" Label="技术要求状态" Value="selectedTechStatus" ValueChanged="@OnTechStatusChanged">
                        <MudSelectItem Value="@("All")">全部</MudSelectItem>
                        <MudSelectItem Value="@("Edited")">已编辑</MudSelectItem>
                        <MudSelectItem Value="@("NotEdited")">未编辑</MudSelectItem>
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" md="3">
                    <MudSelect T="string" Label="订单状态" Value="selectedOrderStatus" ValueChanged="@OnOrderStatusChanged">
                        <MudSelectItem Value="@("All")">全部</MudSelectItem>
                        <MudSelectItem Value="@("Pending")">待处理</MudSelectItem>
                        <MudSelectItem Value="@("Confirmed")">已确认</MudSelectItem>
                    </MudSelect>
                </MudItem>
            </MudGrid>

            <!-- 数据表格 -->
            <MudTable @ref="table"
                      T="SalesOrderListDto"
                      ServerData="OnServerData"
                      Loading="@isLoading"
                      Dense="true"
                      Hover="true"
                      Class="mt-4"
                      Elevation="0"
                      RowsPerPageLabel="每页行数:">
                <ToolBarContent>
                    <MudButton Variant="Variant.Outlined"
                               Size="Size.Small"
                               Color="Color.Info"
                               StartIcon="@Icons.Material.Filled.Print"
                               Disabled="@(!selectedOrderIds.Any())"
                               OnClick="PrintSelected">
                        打印选中 (@selectedOrderIds.Count)
                    </MudButton>
                    <MudButton Variant="Variant.Text"
                               Size="Size.Small"
                               Color="Color.Info"
                               StartIcon="@Icons.Material.Filled.Print"
                               OnClick="PrintAll">
                        打印全部
                    </MudButton>
                    <MudText Typo="Typo.body2" Class="ml-auto">
                        共 @totalCount 条记录
                    </MudText>
                </ToolBarContent>
                <HeaderContent>
                    <MudTh Style="width: 40px;">
                        <MudCheckBox T="bool" @bind-Value="allSelected" Dense="true" OnValueChanged="ToggleSelectAll" />
                    </MudTh>
                    <MudTh>
                        <span @onclick='() => ToggleSort("ordernumber")' class="sortable-header">
                            订单号
                            @if (sortColumn == "ordernumber")
                            {
                                <span class="sort-arrow">@GetSortIndicator("ordernumber")</span>
                            }
                        </span>
                    </MudTh>
                    <MudTh>
                        <span @onclick='() => ToggleSort("signdate")' class="sortable-header">
                            签订日期
                            @if (sortColumn == "signdate")
                            {
                                <span class="sort-arrow">@GetSortIndicator("signdate")</span>
                            }
                        </span>
                    </MudTh>
                    <MudTh>
                        <span @onclick='() => ToggleSort("salesman")' class="sortable-header">
                            业务员
                            @if (sortColumn == "salesman")
                            {
                                <span class="sort-arrow">@GetSortIndicator("salesman")</span>
                            }
                        </span>
                    </MudTh>
                    <MudTh>
                        <span @onclick='() => ToggleSort("customername")' class="sortable-header">
                            客户名称
                            @if (sortColumn == "customername")
                            {
                                <span class="sort-arrow">@GetSortIndicator("customername")</span>
                            }
                        </span>
                    </MudTh>
                    <MudTh>
                        <span @onclick='() => ToggleSort("endcustomer")' class="sortable-header">
                            最终客户
                            @if (sortColumn == "endcustomer")
                            {
                                <span class="sort-arrow">@GetSortIndicator("endcustomer")</span>
                            }
                        </span>
                    </MudTh>
                    <MudTh>技术要求</MudTh>
                    <MudTh>
                        <span @onclick='() => ToggleSort("status")' class="sortable-header">
                            状态
                            @if (sortColumn == "status")
                            {
                                <span class="sort-arrow">@GetSortIndicator("status")</span>
                            }
                        </span>
                    </MudTh>
                    <MudTh>
                        <span @onclick='() => ToggleSort("lastchangedate")' class="sortable-header">
                            变更日期
                            @if (sortColumn == "lastchangedate")
                            {
                                <span class="sort-arrow">@GetSortIndicator("lastchangedate")</span>
                            }
                        </span>
                    </MudTh>
                    <MudTh>操作</MudTh>
                </HeaderContent>
                <RowTemplate Context="order">
                    <MudTd Style="width: 40px;">
                        <MudCheckBox T="bool"
                                     Value="@selectedOrderIds.Contains(order.Id)"
                                     ValueChanged="@((v) => { if(v) selectedOrderIds.Add(order.Id); else selectedOrderIds.Remove(order.Id); StateHasChanged(); })"
                                     Dense="true" />
                    </MudTd>
                    <MudTd title="@order.OrderNumber">
                        <MudLink Typo="Typo.body2" OnClick="() => ViewOrder(order.Id)">@order.OrderNumber</MudLink>
                    </MudTd>
                    <MudTd >@order.SignDate.ToString("yyyy-MM-dd")</MudTd>
                    <MudTd  title="@order.Salesman">@order.Salesman</MudTd>
                    <MudTd title="@order.CustomerName">@order.CustomerName</MudTd>
                    <MudTd title="@order.EndCustomer">@order.EndCustomer</MudTd>
                    <MudTd>
                        @if (order.HasTechnicalRequirement)
                        {
                            <MudChip Size="Size.Small" Color="Color.Success">已编辑</MudChip>
                        }
                        else
                        {
                            <div class="d-flex align-center">
                                <MudChip Size="Size.Small" Color="Color.Error">未编辑</MudChip>
@if (order.FirstOrderItemId.HasValue)
{
    <MudIconButton Icon="@Icons.Material.Filled.Edit"
                   Size="Size.Small"
                   Color="Color.Warning"
                   OnClick="() => EditTechnicalRequirement(order.Id, order.FirstOrderItemId.Value)" />
}
                            </div>
                        }
                    </MudTd>
                    <MudTd>
                        <MudChip Size="Size.Small" Color="@GetStatusColor(order.Status)">
                            @GetStatusText(order.Status)
                        </MudChip>
                    </MudTd>
                    <!-- 变更日期：有变更时显示日期，无变更时显示"-" -->
                    <MudTd >
                        @(order.LastChangeDate?.ToString("yyyy-MM-dd HH:mm") ?? "-")
                    </MudTd>
                    <MudTd>
                        @if (order.Status == SalesOrderStatus.Pending)
                        {
                            <AuthorizeView Roles="OrderDirector,Admin">
                                <MudIconButton Icon="@Icons.Material.Filled.CheckCircle"
                                               Color="Color.Success"
                                               Size="Size.Small"
                                               OnClick="() => ConfirmOrder(order)"
                                               Title="确认订单" />
                            </AuthorizeView>
                        }

                        <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                       Color="Color.Warning"
                                       Size="Size.Small"
                                       OnClick="() => EditOrder(order.Id)" />

                        <AuthorizeView Roles="OrderDirector,Admin">
                            <MudIconButton Icon="@Icons.Material.Filled.Cancel"
                                           Color="Color.Error"
                                           Size="Size.Small"
                                           OnClick="() => CancelOrder(order)"
                                           Title="取消订单" />
                        </AuthorizeView>
                    </MudTd>
                </RowTemplate>
                <PagerContent>
                    <MudTablePager />
                </PagerContent>
            </MudTable>
        </MudCardContent>
    </MudCard>
</div>

@code {
    private MudTable<SalesOrderListDto>? table;
    private List<SalesOrderListDto> orders = new();
    private HashSet<int> selectedOrderIds = new();
    private bool allSelected;
    private bool isLoading = false;
    private string searchKeyword = string.Empty;
    private string selectedTechStatus = "All";
    private string selectedOrderStatus = "All";
    private int totalCount = 0;

    // 排序状态
    private string sortColumn = "signdate";
    private bool sortDescending = true;

    private string GetSortIndicator(string column)
    {
        if (sortColumn != column) return "";
        return sortDescending ? "\u25BC" : "\u25B2";
    }

    private bool? GetHasTechnicalRequirement() => selectedTechStatus switch
    {
        "Edited" => true,
        "NotEdited" => false,
        _ => null
    };
    
    private List<SalesOrderStatus>? GetOrderStatuses()
    {
        return selectedOrderStatus switch
        {
            "Pending" => new List<SalesOrderStatus> { SalesOrderStatus.Pending },
            "Confirmed" => new List<SalesOrderStatus> { SalesOrderStatus.Confirmed },
            "All" => new List<SalesOrderStatus> { SalesOrderStatus.Pending, SalesOrderStatus.Confirmed },
            _ => null
        };
    }

    private async Task<TableData<SalesOrderListDto>> OnServerData(TableState state)
    {
        isLoading = true;
        StateHasChanged();

        try
        {
            var queryParams = new QueryParams
            {
                PageIndex = state.Page + 1,
                PageSize = state.PageSize,
                Keyword = string.IsNullOrWhiteSpace(searchKeyword) ? null : searchKeyword,
                SortBy = sortColumn,
                IsDescending = sortDescending
            };

            var result = await OrderService.GetPagedAsync(queryParams, GetHasTechnicalRequirement(), GetOrderStatuses());
            
            if (result.Success && result.Data != null)
            {
                orders = result.Data.Items;
                totalCount = result.Data.TotalCount;
                
                return new TableData<SalesOrderListDto>
                {
                    Items = orders,
                    TotalItems = totalCount
                };
            }
            
            return new TableData<SalesOrderListDto>
            {
                Items = new List<SalesOrderListDto>(),
                TotalItems = 0
            };
        }
        catch (Exception ex)
        {
            Console.WriteLine($"加载失败: {ex.Message}");
            Snackbar.Add($"加载失败: {ex.Message}", Severity.Error);
            return new TableData<SalesOrderListDto>
            {
                Items = new List<SalesOrderListDto>(),
                TotalItems = 0
            };
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task ToggleSort(string column)
    {
        if (sortColumn == column)
            sortDescending = !sortDescending;
        else
        {
            sortColumn = column;
            sortDescending = false;
        }
        if (table != null)
            await table.ReloadServerData();
    }

    private async Task Search()
    {
        if (table != null)
            await table.ReloadServerData();
    }

    private async Task OnSearchChanged(string value)
    {
        searchKeyword = value ?? string.Empty;
        if (table != null)
            await table.ReloadServerData();
    }

    private async Task OnTechStatusChanged(string value)
    {
        selectedTechStatus = value;
        if (table != null)
            await table.ReloadServerData();
    }

    private async Task OnOrderStatusChanged(string value)
    {
        selectedOrderStatus = value;
        if (table != null)
            await table.ReloadServerData();
    }

    private void NavigateToCreate() => Navigation.NavigateTo("/orders/create");
    private void ViewOrder(int id) => Navigation.NavigateTo($"/orders/{id}");
    private void EditOrder(int id) => Navigation.NavigateTo($"/orders/{id}/edit");
    
    private void EditTechnicalRequirement(int orderId, int itemId)
    {
        Navigation.NavigateTo($"/orders/{orderId}/requirements/edit");
    }

    private async Task ConfirmOrder(SalesOrderListDto order)
    {
        var dialog = DialogService.Show<ConfirmDialog>("确认", new DialogParameters
        {
            ["ContentText"] = $"确定要将订单 \"{order.OrderNumber}\" 确认为正式合同吗？\n\n确认后状态将变为\"已确认\"。",
            ["ConfirmText"] = "确认",
            ["Color"] = Color.Primary
        });
        var dialogResult = await dialog.Result;
        if (dialogResult.Canceled) return;

        try
        {
            var updateRequest = new UpdateSalesOrderRequest
            {
                Status = "Confirmed",
                RowVersion = order.RowVersion ?? Array.Empty<byte>()
            };

            var result = await OrderService.UpdateAsync(order.Id, updateRequest);
            
            if (result.Success)
            {
                Snackbar.Add($"订单 \"{order.OrderNumber}\" 已确认为正式合同", Severity.Success);
                await Search();
            }
            else
            {
                Snackbar.Add(result.Message ?? "确认失败", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"确认失败: {ex.Message}", Severity.Error);
        }
    }

    private async Task CancelOrder(SalesOrderListDto order)
    {
        var dialog = DialogService.Show<ConfirmDialog>("确认", new DialogParameters
        {
            ["ContentText"] = $"确定要取消订单 \"{order.OrderNumber}\" 吗？\n\n取消后订单将不可见，数据将保留但不可恢复！",
            ["ConfirmText"] = "确认取消",
            ["Color"] = Color.Error
        });
        var dialogResult = await dialog.Result;
        if (dialogResult.Canceled) return;

        try
        {
            var result = await OrderService.DeleteAsync(order.Id);
            if (result.Success)
            {
                Snackbar.Add($"订单 \"{order.OrderNumber}\" 已取消", Severity.Success);
                await Search();
            }
            else
            {
                Snackbar.Add(result.Message ?? "取消失败", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"取消失败: {ex.Message}", Severity.Error);
        }
    }

    // ========== 选择方法 ==========

    private async Task ToggleSelectAll(bool select)
    {
        allSelected = select;
        if (select)
        {
            foreach (var order in orders)
                selectedOrderIds.Add(order.Id);
        }
        else
        {
            selectedOrderIds.Clear();
        }
        await Task.CompletedTask;
    }

    // ========== 打印方法 ==========

    private async Task PrintSingleOrder(int id)
    {
        try
        {
            var result = await OrderService.PrintOrderAsync(id);
            if (result.Success && result.Data != null)
                await JS.InvokeVoidAsync("openPdf", result.Data);
            else
                Snackbar.Add(result.Message ?? "打印失败", Severity.Error);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"打印失败: {ex.Message}", Severity.Error);
        }
    }

    private async Task PrintSelected()
    {
        if (!selectedOrderIds.Any())
        {
            Snackbar.Add("请先选择要打印的订单", Severity.Warning);
            return;
        }
        try
        {
            var ids = selectedOrderIds.ToArray();
            var result = await OrderService.PrintOrderBatchAsync(ids);
            if (result.Success && result.Data != null)
                await JS.InvokeVoidAsync("openPdf", result.Data);
            else
                Snackbar.Add(result.Message ?? "打印失败", Severity.Error);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"打印失败: {ex.Message}", Severity.Error);
        }
    }

    private async Task PrintAll()
    {
        try
        {
            var techStatus = selectedTechStatus == "All" ? null : selectedTechStatus;
            var orderStatus = selectedOrderStatus == "All" ? null : selectedOrderStatus;
            var result = await OrderService.PrintOrderAllAsync(
                string.IsNullOrWhiteSpace(searchKeyword) ? null : searchKeyword,
                techStatus, orderStatus, sortColumn, sortDescending);
            if (result.Success && result.Data != null)
                await JS.InvokeVoidAsync("openPdf", result.Data);
            else
                Snackbar.Add(result.Message ?? "打印失败", Severity.Error);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"打印失败: {ex.Message}", Severity.Error);
        }
        finally
        {
            StateHasChanged();
        }
    }

    private Color GetStatusColor(SalesOrderStatus status) => status switch
    {
        SalesOrderStatus.Pending => Color.Warning,
        SalesOrderStatus.Confirmed => Color.Success,
        _ => Color.Default
    };

    private string GetStatusText(SalesOrderStatus status) => status switch
    {
        SalesOrderStatus.Pending => "待处理",
        SalesOrderStatus.Confirmed => "已确认",
        _ => status.ToString()
    };
 }