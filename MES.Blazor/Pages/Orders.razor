@page "/orders"
@using MES.Blazor.Services
@using MES.Core.DTOs
@using MES.Core.Models
@using MES.Core.Enums
@using Microsoft.AspNetCore.Authorization
@using MES.Blazor.Shared
@inject OrderService OrderService
@inject ProductRequirementService RequirementService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject IJSRuntime JS
@inject ColumnPrefsService ColumnPrefs
@attribute [Authorize]

<MudContainer MaxWidth="MaxWidth.False" Class="mt-4 pl-0">
    <MudCard>
        <MudCardHeader>
            <CardHeaderContent>
                <MudText Typo="Typo.h5" Class="font-weight-bold">
                    <MudIcon Icon="@Icons.Material.Filled.Receipt" Class="mr-2" Color="Color.Primary" />
                    订单管理
                </MudText>
            </CardHeaderContent>
            <CardHeaderActions>
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Add"
                           OnClick="NavigateToCreate">
                    新建订单
                </MudButton>
            </CardHeaderActions>
        </MudCardHeader>

        <MudCardContent>
            <!-- 筛选栏 -->
            <MudGrid>
                <MudItem xs="12" md="6">
                    <MudTextField T="string"
                                  Label="模糊搜索 - 订单号/客户名称/业务员/最终客户/延期罚款/状态"
                                  Value="@searchKeyword"
                                  ValueChanged="@OnSearchChanged"
                                  Immediate="true"
                                  DebounceInterval="500"
                                  Clearable="true"
                                  ClearButton="true"
                                  Adornment="Adornment.End"
                                  AdornmentIcon="@Icons.Material.Filled.Search" />
                </MudItem>
                <MudItem xs="12" md="3">
                    <MudSelect T="string" Label="技术要求状态" Value="selectedTechStatus" ValueChanged="@OnTechStatusChanged">
                        <MudSelectItem Value="@("All")">全部</MudSelectItem>
                        <MudSelectItem Value="@("Edited")">已编辑</MudSelectItem>
                        <MudSelectItem Value="@("NotEdited")">未编辑</MudSelectItem>
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" md="3">
                    <MudSelect T="string" Label="订单状态" Value="selectedOrderStatus" ValueChanged="@OnOrderStatusChanged">
                        <MudSelectItem Value="@("All")">全部</MudSelectItem>
                        <MudSelectItem Value="@("Pending")">待处理</MudSelectItem>
                        <MudSelectItem Value="@("Confirmed")">已确认</MudSelectItem>
                    </MudSelect>
                </MudItem>
            </MudGrid>

            <!-- 数据表格 -->
            <div id="orders-list-table">
            <MudTable @ref="table"
                      T="SalesOrderListDto"
                      ServerData="OnServerData"
                      Loading="@isLoading"
                      Dense="true"
                      Hover="true"
                      Class="mt-4 auto-table"
                      Elevation="0"
                      RowsPerPageLabel="每页行数:">
                <ToolBarContent>
                    <ColumnDisplaySelect Columns="_allColumns"
                                         OnColumnToggle="OnColumnToggle"
                                         OnMoveUp="MoveColumnUp"
                                         OnMoveDown="MoveColumnDown" />
                    <MudButton Variant="Variant.Text" Size="Size.Small"
                               Color="Color.Default"
                               StartIcon="@Icons.Material.Filled.RestartAlt"
                               OnClick="ResetColumnDisplay" Class="ml-2">
                        重置
                    </MudButton>
                    <MudSpacer />
                    <MudButton Variant="Variant.Outlined"
                               Size="Size.Small"
                               Color="Color.Info"
                               StartIcon="@Icons.Material.Filled.Print"
                               Disabled="@(!selectedOrderIds.Any())"
                               OnClick="PrintSelected">
                        打印选中 (@selectedOrderIds.Count)
                    </MudButton>
                    <MudButton Variant="Variant.Text"
                               Size="Size.Small"
                               Color="Color.Info"
                               StartIcon="@Icons.Material.Filled.Print"
                               OnClick="PrintAll">
                        打印全部
                    </MudButton>
                    <MudText Typo="Typo.body2" Class="ml-2">
                        共 @totalCount 条记录
                    </MudText>
                </ToolBarContent>
                <HeaderContent>
                    <MudTh Style="width: 40px;">
                        <MudCheckBox T="bool" @bind-Value="allSelected" Dense="true" />
                    </MudTh>
                    @foreach (var col in _visibleColumns)
                    {
                        <MudTh>
                            @if (!string.IsNullOrEmpty(col.SortKey))
                            {
                                <span @onclick='() => ToggleSort(col.SortKey)' class="sortable-header">
                                    @col.Label
                                    @if (sortColumn == col.SortKey)
                                    {
                                        <span class="sort-arrow">@GetSortIndicator(col.SortKey)</span>
                                    }
                                </span>
                            }
                            else
                            {
                                <span class="th-label">@col.Label</span>
                            }
                        </MudTh>
                    }
                    <MudTh>操作</MudTh>
                </HeaderContent>
                <RowTemplate Context="order">
                    <MudTd Style="width: 40px;">
                        <MudCheckBox T="bool"
                                     Value="@selectedOrderIds.Contains(order.Id)"
                                     ValueChanged="@((v) => { if(v) selectedOrderIds.Add(order.Id); else selectedOrderIds.Remove(order.Id); _allSelected = orders.Any() && orders.All(i => selectedOrderIds.Contains(i.Id)); StateHasChanged(); })"
                                     Dense="true" />
                    </MudTd>
                    @foreach (var col in _visibleColumns)
                    {
                        <MudTd>@RenderCell(order, col)</MudTd>
                    }
                    <MudTd>
                        @if (order.Status == SalesOrderStatus.Pending)
                        {
                            <AuthorizeView Roles="OrderDirector,Admin">
                                <MudIconButton Icon="@Icons.Material.Filled.CheckCircle"
                                               Color="Color.Success"
                                               Size="Size.Small"
                                               OnClick="() => ConfirmOrder(order)"
                                               Title="确认订单" />
                            </AuthorizeView>
                        }

                        <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                       Color="Color.Warning"
                                       Size="Size.Small"
                                       OnClick="() => EditOrder(order.Id)" />

                        <AuthorizeView Roles="OrderDirector,Admin">
                            <MudIconButton Icon="@Icons.Material.Filled.Cancel"
                                           Color="Color.Error"
                                           Size="Size.Small"
                                           OnClick="() => CancelOrder(order)"
                                           Title="取消订单" />
                        </AuthorizeView>
                    </MudTd>
                </RowTemplate>
                <PagerContent>
                    <MudTablePager />
                </PagerContent>
            </MudTable>
            </div>
        </MudCardContent>
    </MudCard>
</MudContainer>

@code {
    private MudTable<SalesOrderListDto>? table;
    private List<SalesOrderListDto> orders = new();
    private HashSet<int> selectedOrderIds = new();
    private bool _allSelected;
    private bool allSelected
    {
        get => _allSelected;
        set
        {
            if (_allSelected == value) return;
            _allSelected = value;
            if (value)
            {
                foreach (var order in orders)
                    selectedOrderIds.Add(order.Id);
            }
            else
            {
                selectedOrderIds.Clear();
            }
            StateHasChanged();
        }
    }
    private bool isLoading = false;
    private string searchKeyword = string.Empty;
    private string selectedTechStatus = "All";
    private string selectedOrderStatus = "All";
    private int totalCount = 0;
    private bool _isArrowNavSetup;

    // ========== 列选择管理 ==========
    private List<ColumnDef> _allColumns = new();
    private List<ColumnDef> _visibleColumns =>
        _allColumns.Where(c => c.Visible).ToList();

    private static List<ColumnDef> GetAllColumnDefs() => new()
    {
        new() { Key = "ordernumber",   Label = "订单号",   SortKey = "ordernumber" },
        new() { Key = "signdate",      Label = "签订日期", SortKey = "signdate" },
        new() { Key = "salesman",      Label = "业务员",   SortKey = "salesman" },
        new() { Key = "customername",  Label = "客户名称", SortKey = "customername" },
        new() { Key = "endcustomer",   Label = "最终客户", SortKey = "endcustomer" },
        new() { Key = "deliverystart", Label = "交期起始", SortKey = "deliverystart" },
        new() { Key = "deliveryend",   Label = "交期截止", SortKey = "deliveryend" },
        new() { Key = "hasdelaypenalty", Label = "延期罚款", SortKey = "hasdelaypenalty" },
        new() { Key = "totalcontractweight", Label = "订单总重量", SortKey = "totalcontractweight" },
        new() { Key = "itemcount", Label = "含项次数", SortKey = "itemcount" },
        new() { Key = "notech",        Label = "技术要求" },
        new() { Key = "status",        Label = "状态",     SortKey = "status" },
        new() { Key = "lastchangedate",Label = "变更日期", SortKey = "lastchangedate" },
    };

    private async Task OnColumnToggle(ColumnDef col)
    {
        await SaveColumnPrefs();
    }

    private async Task SaveColumnPrefs()
    {
        await ColumnPrefs.SaveAsync("orders", null, _allColumns);
    }

    private async Task ResetColumnDisplay()
    {
        _allColumns = GetAllColumnDefs();
        await SaveColumnPrefs();
    }

    private async Task MoveColumnUp(ColumnDef col)
    {
        await SaveColumnPrefs();
    }

    private async Task MoveColumnDown(ColumnDef col)
    {
        await SaveColumnPrefs();
    }

    // ========== 单元格渲染 ==========

    private RenderFragment RenderCell(SalesOrderListDto order, ColumnDef col) => builder =>
    {
        switch (col.Key)
        {
            case "ordernumber":
                builder.OpenComponent<MudLink>(0);
                builder.AddAttribute(1, "Typo", Typo.body2);
                builder.AddAttribute(2, "OnClick", EventCallback.Factory.Create<MouseEventArgs?>(this, () => ViewOrder(order.Id)));
                builder.AddAttribute(3, "ChildContent", (RenderFragment)(b2 => b2.AddContent(0, order.OrderNumber)));
                builder.CloseComponent();
                break;
            case "signdate":
                builder.AddContent(0, order.SignDate.ToString("yyyy-MM-dd"));
                break;
            case "salesman":
                builder.AddContent(0, order.Salesman);
                break;
            case "customername":
                builder.AddContent(0, order.CustomerName);
                break;
            case "endcustomer":
                builder.AddContent(0, order.EndCustomer);
                break;
            case "deliverystart":
                builder.AddContent(0, order.DeliveryStart?.ToString("yyyy-MM-dd") ?? "-");
                break;
            case "deliveryend":
                builder.AddContent(0, order.DeliveryEnd?.ToString("yyyy-MM-dd") ?? "-");
                break;
            case "hasdelaypenalty":
                builder.AddContent(0, order.HasDelayPenalty ? "是" : "否");
                break;
            case "totalcontractweight":
                builder.AddContent(0, order.TotalContractWeight.ToString("G29"));
                break;
            case "itemcount":
                builder.AddContent(0, order.ItemCount);
                break;
            case "notech":
                if (order.HasTechnicalRequirement)
                {
                    builder.OpenComponent<MudChip>(0);
                    builder.AddAttribute(1, "Size", Size.Small);
                    builder.AddAttribute(2, "Color", Color.Success);
                    builder.AddAttribute(3, "ChildContent", (RenderFragment)(b2 => b2.AddContent(0, "已编辑")));
                    builder.CloseComponent();
                }
                else
                {
                    builder.OpenComponent<MudChip>(0);
                    builder.AddAttribute(1, "Size", Size.Small);
                    builder.AddAttribute(2, "Color", Color.Error);
                    builder.AddAttribute(3, "ChildContent", (RenderFragment)(b2 => b2.AddContent(0, "未编辑")));
                    builder.CloseComponent();
                    if (order.FirstOrderItemId.HasValue)
                    {
                        builder.OpenComponent<MudIconButton>(0);
                        builder.AddAttribute(1, "Icon", Icons.Material.Filled.Edit);
                        builder.AddAttribute(2, "Size", Size.Small);
                        builder.AddAttribute(3, "Color", Color.Warning);
                        builder.AddAttribute(4, "OnClick", EventCallback.Factory.Create<MouseEventArgs?>(this, () => ViewTechnicalRequirement(order.Id)));
                        builder.CloseComponent();
                    }
                }
                break;
            case "status":
                builder.OpenComponent<MudChip>(0);
                builder.AddAttribute(1, "Size", Size.Small);
                builder.AddAttribute(2, "Color", GetStatusColor(order.Status));
                builder.AddAttribute(3, "ChildContent", (RenderFragment)(b2 => b2.AddContent(0, GetStatusText(order.Status))));
                builder.CloseComponent();
                break;
            case "lastchangedate":
                builder.AddContent(0, order.LastChangeDate?.ToString("yyyy-MM-dd HH:mm") ?? "-");
                break;
        }
    };

    // 排序状态
    private string sortColumn = "signdate";
    private bool sortDescending = true;

    // ========== 初始化 ==========

    protected override async Task OnInitializedAsync()
    {
        _allColumns = GetAllColumnDefs();
        var saved = await ColumnPrefs.LoadAsync("orders", null);
        if (saved.Count > 0)
        {
            foreach (var s in saved)
            {
                var match = _allColumns.FirstOrDefault(c => c.Key == s.Key);
                if (match != null)
                    match.Visible = s.Visible;
            }
            var reordered = new List<ColumnDef>();
            foreach (var s in saved)
            {
                var match = _allColumns.FirstOrDefault(c => c.Key == s.Key);
                if (match != null && !reordered.Contains(match))
                    reordered.Add(match);
            }
            foreach (var c in _allColumns)
            {
                if (!reordered.Contains(c))
                    reordered.Add(c);
            }
            _allColumns = reordered;
        }
    }

    private string GetSortIndicator(string column)
    {
        if (sortColumn != column) return "";
        return sortDescending ? "\u25BC" : "\u25B2";
    }

    private bool? GetHasTechnicalRequirement() => selectedTechStatus switch
    {
        "Edited" => true,
        "NotEdited" => false,
        _ => null
    };
    
    private List<SalesOrderStatus>? GetOrderStatuses()
    {
        return selectedOrderStatus switch
        {
            "Pending" => new List<SalesOrderStatus> { SalesOrderStatus.Pending },
            "Confirmed" => new List<SalesOrderStatus> { SalesOrderStatus.Confirmed },
            "All" => new List<SalesOrderStatus> { SalesOrderStatus.Pending, SalesOrderStatus.Confirmed },
            _ => null
        };
    }

    private async Task<TableData<SalesOrderListDto>> OnServerData(TableState state)
    {
        isLoading = true;
        StateHasChanged();

        try
        {
            var queryParams = new QueryParams
            {
                PageIndex = state.Page + 1,
                PageSize = state.PageSize,
                Keyword = string.IsNullOrWhiteSpace(searchKeyword) ? null : searchKeyword,
                SortBy = sortColumn,
                IsDescending = sortDescending
            };

            var result = await OrderService.GetPagedAsync(queryParams, GetHasTechnicalRequirement(), GetOrderStatuses());
            
            if (result.Success && result.Data != null)
            {
                orders = result.Data.Items;
                totalCount = result.Data.TotalCount;
                
                return new TableData<SalesOrderListDto>
                {
                    Items = orders,
                    TotalItems = totalCount
                };
            }
            
            return new TableData<SalesOrderListDto>
            {
                Items = new List<SalesOrderListDto>(),
                TotalItems = 0
            };
        }
        catch (Exception ex)
        {
            Console.WriteLine($"加载失败: {ex.Message}");
            Snackbar.Add($"加载失败: {ex.Message}", Severity.Error);
            return new TableData<SalesOrderListDto>
            {
                Items = new List<SalesOrderListDto>(),
                TotalItems = 0
            };
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task ToggleSort(string column)
    {
        if (sortColumn == column)
            sortDescending = !sortDescending;
        else
        {
            sortColumn = column;
            sortDescending = false;
        }
        if (table != null)
            await table.ReloadServerData();
    }

    private async Task Search()
    {
        if (table != null)
            await table.ReloadServerData();
    }

    private async Task OnSearchChanged(string value)
    {
        searchKeyword = value ?? string.Empty;
        if (table != null)
            await table.ReloadServerData();
    }

    private async Task OnTechStatusChanged(string value)
    {
        selectedTechStatus = value;
        if (table != null)
            await table.ReloadServerData();
    }

    private async Task OnOrderStatusChanged(string value)
    {
        selectedOrderStatus = value;
        if (table != null)
            await table.ReloadServerData();
    }

    private void NavigateToCreate() => Navigation.NavigateTo("/orders/create");
    private void ViewOrder(int id) => Navigation.NavigateTo($"/orders/{id}");
    private void EditOrder(int id) => Navigation.NavigateTo($"/orders/{id}");
    
    private void ViewTechnicalRequirement(int orderId) => Navigation.NavigateTo($"/orders/{orderId}/requirements");

    private async Task ConfirmOrder(SalesOrderListDto order)
    {
        var dialog = DialogService.Show<ConfirmDialog>("确认", new DialogParameters
        {
            ["ContentText"] = $"确定要将订单 \"{order.OrderNumber}\" 确认为正式合同吗？\n\n确认后状态将变为\"已确认\"。",
            ["ConfirmText"] = "确认",
            ["Color"] = Color.Primary
        });
        var dialogResult = await dialog.Result;
        if (dialogResult.Canceled) return;

        try
        {
            var updateRequest = new UpdateSalesOrderRequest
            {
                Status = "Confirmed",
                RowVersion = order.RowVersion ?? Array.Empty<byte>()
            };

            var result = await OrderService.UpdateAsync(order.Id, updateRequest);
            
            if (result.Success)
            {
                Snackbar.Add($"订单 \"{order.OrderNumber}\" 已确认为正式合同", Severity.Success);
                await Search();
            }
            else
            {
                Snackbar.Add(result.Message ?? "确认失败", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"确认失败: {ex.Message}", Severity.Error);
        }
    }

    private async Task CancelOrder(SalesOrderListDto order)
    {
        var dialog = DialogService.Show<ConfirmDialog>("确认", new DialogParameters
        {
            ["ContentText"] = $"确定要取消订单 \"{order.OrderNumber}\" 吗？\n\n取消后订单将不可见，数据将保留但不可恢复！",
            ["ConfirmText"] = "确认取消",
            ["Color"] = Color.Error
        });
        var dialogResult = await dialog.Result;
        if (dialogResult.Canceled) return;

        try
        {
            var result = await OrderService.DeleteAsync(order.Id);
            if (result.Success)
            {
                Snackbar.Add($"订单 \"{order.OrderNumber}\" 已取消", Severity.Success);
                await Search();
            }
            else
            {
                Snackbar.Add(result.Message ?? "取消失败", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"取消失败: {ex.Message}", Severity.Error);
        }
    }

    // ========== 打印方法 ==========

    private async Task PrintSingleOrder(int id)
    {
        try
        {
            var result = await OrderService.PrintOrderAsync(id);
            if (result.Success && result.Data != null)
                await JS.InvokeVoidAsync("openPdf", result.Data);
            else
                Snackbar.Add(result.Message ?? "打印失败", Severity.Error);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"打印失败: {ex.Message}", Severity.Error);
        }
    }

    private async Task PrintSelected()
    {
        if (!selectedOrderIds.Any())
        {
            Snackbar.Add("请先选择要打印的订单", Severity.Warning);
            return;
        }
        try
        {
            var ids = selectedOrderIds.ToArray();
            var result = await OrderService.PrintOrderBatchAsync(ids);
            if (result.Success && result.Data != null)
                await JS.InvokeVoidAsync("openPdf", result.Data);
            else
                Snackbar.Add(result.Message ?? "打印失败", Severity.Error);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"打印失败: {ex.Message}", Severity.Error);
        }
    }

    private async Task PrintAll()
    {
        try
        {
            var techStatus = selectedTechStatus == "All" ? null : selectedTechStatus;
            var orderStatus = selectedOrderStatus == "All" ? null : selectedOrderStatus;
            var result = await OrderService.PrintOrderAllAsync(
                string.IsNullOrWhiteSpace(searchKeyword) ? null : searchKeyword,
                techStatus, orderStatus, sortColumn, sortDescending);
            if (result.Success && result.Data != null)
                await JS.InvokeVoidAsync("openPdf", result.Data);
            else
                Snackbar.Add(result.Message ?? "打印失败", Severity.Error);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"打印失败: {ex.Message}", Severity.Error);
        }
        finally
        {
            StateHasChanged();
        }
    }

    private Color GetStatusColor(SalesOrderStatus status) => status switch
    {
        SalesOrderStatus.Pending => Color.Warning,
        SalesOrderStatus.Confirmed => Color.Success,
        _ => Color.Default
    };

    private string GetStatusText(SalesOrderStatus status) => status switch
    {
        SalesOrderStatus.Pending => "待处理",
        SalesOrderStatus.Confirmed => "已确认",
        _ => "未知"
    };

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_isArrowNavSetup)
        {
            _isArrowNavSetup = true;
            if (!await JS.InvokeAsync<bool>("enableTableArrowNav", "#orders-list-table"))
                _isArrowNavSetup = false;
        }
    }
 }