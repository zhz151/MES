@page "/payroll/attendance-monthly"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = Roles.Policies.SalaryView)]
@using MES.Blazor.Helpers
@using MES.Core.DTOs.Payroll
@using MES.Shared.Constants

<MudContainer MaxWidth="MaxWidth.False" Class="py-4">
    <MudPaper Class="pa-4 mb-4" Elevation="0" Outlined="true">
        <MudText Typo="Typo.body2" Class="text-medium-emphasis mb-3">
            靠工工资 = 靠工岗位当月平均小时工资 × 本人出勤 × 靠工系数；平均时薪 = 选中岗位(只计算件)当月计件总工资 ÷ 计件人员总出勤小时。
        </MudText>
        <div class="d-flex align-center flex-wrap gap-2">
            <MudText Typo="Typo.h6" Class="font-weight-bold mr-2">靠工计件月结</MudText>
            <MudButton Icon="@Icons.Material.Filled.ChevronLeft" Color="Color.Default" OnClick="PrevMonth" />
            <MudSelect T="int" Value="@_year" ValueChanged="OnYearChanged" Label="年份" Variant="Variant.Outlined" Dense="true" Style="width:110px">
                @foreach (var y in _years)
                {
                    <MudSelectItem Value="@y">@y</MudSelectItem>
                }
            </MudSelect>
            <MudSelect T="int" Value="@_month" ValueChanged="OnMonthChanged" Label="月份" Variant="Variant.Outlined" Dense="true" Style="width:100px">
                @foreach (var m in _months)
                {
                    <MudSelectItem Value="@m">@m 月</MudSelectItem>
                }
            </MudSelect>
            <MudButton Icon="@Icons.Material.Filled.ChevronRight" Color="Color.Default" OnClick="NextMonth" />
            <MudSpacer />
            @if (_canEdit)
            {
                <MudButton StartIcon="@Icons.Material.Filled.Refresh" Color="Color.Warning" Variant="Variant.Outlined"
                           Disabled="_loading || MembersCount == 0" OnClick="RecalcAsync"
                           title="仅把当前在册靠工员工重算为引擎草稿；已转出/离职员工的历史已保存快照金额保留不变。">引擎重算</MudButton>
                <MudButton StartIcon="@Icons.Material.Filled.DeleteSweep" Color="Color.Error" Variant="Variant.Outlined"
                           Disabled="_loading || MembersCount == 0" OnClick="RecalcFullAsync"
                           title="全量重算（清历史）：覆盖整月全部员工——在册靠工员工→引擎草稿；已转出/离职的历史快照员工→当月清空，保存后其当月旧记录被删除、不可找回。保留历史请用「引擎重算」。">全量重算</MudButton>
                <MudButton StartIcon="@Icons.Material.Filled.Save" Color="Color.Success" Variant="Variant.Filled"
                           Disabled="_loading || MembersCount == 0" OnClick="SaveMonthAsync">保存本月</MudButton>
            }
        </div>
    </MudPaper>

    <MudProgressLinear Visible="_loading" Color="Color.Primary" />

    @if (_hasSaved)
    {
        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mb-2">
            当前显示为 @_year 年 @_month 月已保存的靠工月结快照（金额已冻结）。重算两种：只覆盖在册员工→「引擎重算」（保留历史）；连同已转出/离职历史员工一并清空→「全量重算（清历史）」（破坏性，双重确认）。
        </MudAlert>
    }
    else if (!_loading && MembersCount > 0)
    {
        <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Class="mb-2">
            当月尚未保存：以下为引擎按现行单价自动带出的靠工月结草稿，可直接修改后点「保存本月」落库。
        </MudAlert>
    }
    @foreach (var w in _warnings)
    {
        <MudAlert Severity="Severity.Warning" Variant="Variant.Text" Class="mb-2">@w</MudAlert>
    }

    @if (MembersCount > 0)
    {
        <MudPaper Class="pa-3" Elevation="0" Outlined="true">
            <div class="d-flex align-center flex-wrap mb-1">
                <MudChip Size="Size.Small" Variant="Variant.Outlined">@MembersCount 名靠工员工</MudChip>
                <MudChip Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined" Class="ml-2">整月合计 @TotalAmount.ToString("G29") 元</MudChip>
            </div>
            <table class="auto-table">
                <thead>
                    <tr>
                        <th style="width:90px">工号</th>
                        <th style="width:110px">姓名</th>
                        <th style="width:220px">靠工岗位</th>
                        <th style="width:90px">出勤(小时)</th>
                        <th style="width:80px">靠工系数</th>
                        <th style="width:110px">平均时薪(元/时)</th>
                        <th style="width:140px">实得金额(元)</th>
                        <th>备注</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var m in Rows)
                    {
                        var mEmpId = m.EmployeeId;
                        var posText = FormatPositions(m.AttendancePositions);
                        var hasPos = HasPositions(m.AttendancePositions);
                        var coeffText = m.AttendanceCoefficient.HasValue ? m.AttendanceCoefficient.Value.ToString("G29") : "1.0";
                        var attText = m.AttendanceHours.HasValue ? m.AttendanceHours.Value.ToString("G29") : "—";
                        var avgText = m.AvgHourlyWage.HasValue ? m.AvgHourlyWage.Value.ToString("0.00") : "—";
                        <tr>
                            <td>@m.EmployeeCode</td>
                            <td>@m.EmployeeName</td>
                            <td>@(string.IsNullOrEmpty(posText) ? "—" : posText)</td>
                            <td>@attText</td>
                            <td>@coeffText</td>
                            <td>@avgText</td>
                            <td>
                                <input class="amount-cell-input" type="text" inputmode="decimal" maxlength="14"
                                       disabled="@(!_canEdit)"
                                       value="@GetAmountText(mEmpId)"
                                       @onchange="(ChangeEventArgs e) => OnAmountChanged(mEmpId, e)" />
                            </td>
                            <td class="text-medium-emphasis">
                                @if (!m.EngineCovered)
                                {
                                    <MudText Typo="Typo.body2" Class="text-medium-emphasis">历史快照(仅回溯)</MudText>
                                }
                                else if (!hasPos)
                                {
                                    <MudText Typo="Typo.body2" Class="error-text">未设靠工岗位</MudText>
                                }
                                else if (!m.AvgHourlyWage.HasValue)
                                {
                                    <MudText Typo="Typo.body2" Class="error-text">当月无计件参照</MudText>
                                }
                                else if (!m.AttendanceHours.HasValue)
                                {
                                    <MudText Typo="Typo.body2" Class="text-medium-emphasis">本月无出勤(得0)</MudText>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr>
                        <td colspan="6">整月合计(元)</td>
                        <td>@TotalAmount.ToString("G29")</td>
                        <td></td>
                    </tr>
                </tfoot>
            </table>
        </MudPaper>
    }

    @if (MembersCount == 0 && !_loading)
    {
        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mt-2">当月没有在册靠工计件员工（需在员工管理配置 工资结算模式=靠工计件，并设置靠工岗位/靠工系数）。</MudAlert>
    }
</MudContainer>
