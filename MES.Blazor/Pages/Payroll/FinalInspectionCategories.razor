@page "/payroll/final-inspection-categories"
@using MES.Blazor.Components
@using MES.Blazor.Services
@using MES.Blazor.Shared
@using MES.Core.DTOs.Payroll
@using MES.Core.Models
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = Roles.Policies.SalaryView)]

<MudContainer MaxWidth="MaxWidth.False" Class="mt-4 pl-0">
    <MudCard>
        <MudCardHeader>
            <CardHeaderContent>
                <MudText Typo="Typo.h5" Class="font-weight-bold">
                    <MudIcon Icon="@Icons.Material.Filled.Category" Class="mr-2" Color="Color.Primary" />
                    成检计件类别（基准价 × 维档系数）
                </MudText>
            </CardHeaderContent>
            <CardHeaderActions>
                <MudText Typo="Typo.body2" Color="Color.Default" Class="mr-2">类别 = 成检项目 × 规格维档；单价 = 基准价 × 命中维档系数连乘；同成检项目同时仅一条启用类别</MudText>
                <MudButton Variant="Variant.Outlined"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Download"
                           OnClick="ExportAll">
                    导出全量
                </MudButton>
                <AuthorizeView Roles="@Roles.Policies.SalaryEdit">
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Secondary"
                               StartIcon="@Icons.Material.Filled.PlaylistAdd"
                               OnClick='() => OpenImportDialog("category")'>
                        导入类别
                    </MudButton>
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Tertiary"
                               StartIcon="@Icons.Material.Filled.PlaylistAddCheck"
                               OnClick='() => OpenImportDialog("tier")'>
                        导入维档
                    </MudButton>
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.Add"
                               OnClick="AddNew">
                        新增类别
                    </MudButton>
                </AuthorizeView>
            </CardHeaderActions>
        </MudCardHeader>

        <MudCardContent>
            <!-- 搜索 + 筛选栏 -->
            <MudGrid>
                <MudItem xs="12" md="4">
                    <MudTextField T="string"
                                  Label="模糊搜索 - 成检项目/备注"
                                  Value="_searchKeyword"
                                  ValueExpression="@(() => _searchKeyword)"
                                  ValueChanged="@OnSearchChanged"
                                  Immediate="true"
                                  DebounceInterval="500"
                                  Adornment="Adornment.End"
                                  AdornmentIcon="@Icons.Material.Filled.Search" />
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudSelect T="string"
                               Label="成检项目筛选"
                               Value="_itemFilter"
                               ValueChanged="@OnItemFilterChanged"
                               Clearable="true"
                               AdornmentIcon="@Icons.Material.Filled.FilterList">
                        @foreach (var opt in _itemOptions)
                        {
                            <MudSelectItem Value="@opt.Key" Text="@opt.Name">@opt.Name</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudSelect T="string"
                               Label="启停筛选"
                               Value="_activeFilter"
                               ValueChanged="@OnActiveFilterChanged"
                               Clearable="true"
                               AdornmentIcon="@Icons.Material.Filled.FilterList">
                        <MudSelectItem Value="@("true")">启用</MudSelectItem>
                        <MudSelectItem Value="@("false")">停用</MudSelectItem>
                    </MudSelect>
                </MudItem>
            </MudGrid>

            <!-- 模拟测算区（按成检记录点选计价，2026-09-04） -->
            <MudExpansionPanels MultiExpansion="false" Class="mt-3">
                <MudExpansionPanel OnExpandedChanged="OnTrialExpandedChanged">
                    <TitleContent>
                        <div class="d-flex align-center">
                            <MudIcon Icon="@Icons.Material.Filled.Calculate" Class="mr-2" Color="Color.Primary" Size="Size.Small" />
                            <MudText Typo="Typo.subtitle1">模拟测算（按成检记录点选计价）</MudText>
                        </div>
                    </TitleContent>
                    <ChildContent>
                        <MudGrid Class="pt-3">
                            <MudItem xs="12" md="4">
                                <MudSelect T="string"
                                           Label="成检项目筛选"
                                           Value="_trialItemFilter"
                                           ValueChanged="@OnTrialItemFilterChanged"
                                           Clearable="true"
                                           AdornmentIcon="@Icons.Material.Filled.FilterList">
                                    @foreach (var opt in _itemOptions)
                                    {
                                        <MudSelectItem Value="@opt.Key" Text="@opt.Name">@opt.Name</MudSelectItem>
                                    }
                                </MudSelect>
                            </MudItem>
                            <MudItem xs="12" md="8">
                                <MudTextField T="string"
                                              Label="关键字 - 生产编号/设备/操作人"
                                              Value="_trialKeyword"
                                              ValueExpression="@(() => _trialKeyword)"
                                              ValueChanged="@OnTrialKeywordChanged"
                                              Immediate="true"
                                              DebounceInterval="500"
                                              Adornment="Adornment.End"
                                              AdornmentIcon="@Icons.Material.Filled.Search" />
                            </MudItem>
                        </MudGrid>

                        <MudText Typo="Typo.caption" Class="mt-3 mb-1">
                            选中一条真实成检记录点「试算」→ 按现行启用类别给出结算单价与整行计件额（与当月结算同口径、未按写名人头均分）
                        </MudText>

                        <MudTable @ref="_trialTable"
                                  T="FinalInspectionPriceTrialRecordDto"
                                  ServerData="@LoadTrialRecords"
                                  Dense="true"
                                  Hover="true"
                                  Class="auto-table"
                                  Elevation="0"
                                  RowsPerPage="10"
                                  RowsPerPageLabel="每页行数:">
                            <ToolBarContent>
                                <MudText Typo="Typo.body2" Class="ml-auto">
                                    共 @_trialTotalCount 条成检记录
                                </MudText>
                            </ToolBarContent>
                            <HeaderContent>
                                <MudTh>检验日期</MudTh>
                                <MudTh>检验项目</MudTh>
                                <MudTh>生产编号</MudTh>
                                <MudTh>规格</MudTh>
                                <MudTh>长度状态·定尺长</MudTh>
                                <MudTh>检验支数</MudTh>
                                <MudTh>重量(kg)</MudTh>
                                <MudTh>设备</MudTh>
                                <MudTh>操作人</MudTh>
                                <MudTh Style="width: 90px;">操作</MudTh>
                            </HeaderContent>
                            <RowTemplate Context="rec">
                                <MudTd>@rec.InspectionDate.ToString("yyyy-MM-dd")</MudTd>
                                <MudTd><b>@rec.ItemKeyChinese</b></MudTd>
                                <MudTd>@rec.BatchNo</MudTd>
                                <MudTd>@rec.Specification</MudTd>
                                <MudTd>
                                    @rec.LengthStatusChinese
                                    @if (!string.IsNullOrWhiteSpace(rec.FixedLength))
                                    {
                                        @("·")@rec.FixedLength
                                    }
                                </MudTd>
                                <MudTd>@rec.Quantity</MudTd>
                                <MudTd>@rec.Weight</MudTd>
                                <MudTd>@rec.EquipmentName</MudTd>
                                <MudTd>@rec.Operator</MudTd>
                                <MudTd>
                                    <MudIconButton Icon="@Icons.Material.Filled.Calculate"
                                                   Title="按此记录试算"
                                                   Color="Color.Primary"
                                                   Size="Size.Small"
                                                   Disabled="@_pricingLoading"
                                                   OnClick="() => PriceRecordAsync(rec)" />
                                </MudTd>
                            </RowTemplate>
                            <PagerContent>
                                <MudTablePager PageSizeOptions="new int[]{10,20,50}" />
                            </PagerContent>
                        </MudTable>

                        @if (_pricingLoading)
                        {
                            <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="mt-3" />
                        }
                        else if (_pricingError != null)
                        {
                            <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="mt-3">
                                <MudText Typo="Typo.body2">@_pricingError</MudText>
                            </MudAlert>
                        }
                        else if (_pricingDone)
                        {
                            @if (_selectedRecord != null)
                            {
                                <MudText Typo="Typo.caption" Class="mt-3">
                                    记录：@_selectedRecord.ItemKeyChinese ｜ @_selectedRecord.BatchNo ｜ 规格 @_selectedRecord.Specification
                                    ｜ 支数 @(_selectedRecord.Quantity?.ToString() ?? "-") ｜ 重量 @(_selectedRecord.Weight?.ToString() ?? "-")kg
                                </MudText>
                            }
                            @if (_matchResult == null)
                            {
                                <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mt-2">
                                    <MudText Typo="Typo.body2">该记录未定价（该成检项目无启用类别或记录值未命中任何档）</MudText>
                                </MudAlert>
                            }
                            else
                            {
                                <MudAlert Severity="Severity.Success" Variant="Variant.Outlined" Class="mt-2">
                                    <MudText Typo="Typo.body2">
                                        命中类别（Id=@_matchResult.CategoryId）：@_matchResult.ItemKeyChinese
                                    </MudText>
                                    <MudText Typo="Typo.body2" Class="mt-1">
                                        基准价 <b>@_matchResult.BasePrice.ToString("G29")</b> × 总系数 <b>@_matchResult.TotalRatio.ToString("G29")</b> = 结算单价
                                        <b>@_matchResult.UnitPrice.ToString("G29") @_matchResult.UnitChinese</b>
                                    </MudText>
                                    @if (_matchResult.SimulatedAmount is { } simAmt)
                                    {
                                        <MudText Typo="Typo.subtitle2" Class="mt-2" Style="color: #2e7d32;">
                                            整行计件额（与月结口径一致、未按写名人头均分）：<b>@simAmt.ToString("G29") 元</b>
                                        </MudText>
                                    }
                                    else
                                    {
                                        <MudText Typo="Typo.caption" Class="mt-1">
                                            @TrialSimulatedAmountHint(_matchResult.Unit)
                                        </MudText>
                                    }
                                    @if (_matchResult.Hits.Count > 0)
                                    {
                                        <div class="d-flex flex-wrap align-center mt-2" style="gap: 4px;">
                                            <MudText Typo="Typo.caption" Class="mr-1">命中档:</MudText>
                                            @foreach (var hit in _matchResult.Hits)
                                            {
                                                <MudChip Variant="Variant.Outlined" Size="Size.Small">@hit.DimensionKeyChinese：@hit.RangeText ×@hit.Ratio.ToString("G29")</MudChip>
                                            }
                                        </div>
                                    }
                                </MudAlert>
                            }
                        }
                    </ChildContent>
                </MudExpansionPanel>
            </MudExpansionPanels>

            <!-- 数据表格 -->
            <div id="final-inspection-category-list-table">
                <MudTable @ref="table"
                          T="PieceRateFinalInspectionCategoryListItemDto"
                          ServerData="@LoadDataFromServer"
                          Dense="true"
                          Hover="true"
                          Class="mt-4 auto-table"
                          Elevation="0"
                          RowsPerPage="@_pageSize"
                          RowsPerPageLabel="每页行数:">
                    <ToolBarContent>
                        <ColumnDisplaySelect Columns="_allColumns"
                                             OnColumnToggle="OnColumnToggle"
                                             OnMoveUp="MoveColumnUp"
                                             OnMoveDown="MoveColumnDown" />
                        <MudButton Variant="Variant.Text" Size="Size.Small"
                                   Color="Color.Default"
                                   StartIcon="@Icons.Material.Filled.RestartAlt"
                                   OnClick="ResetColumnDisplay" Class="ml-2">
                            重置
                        </MudButton>
                        <MudSpacer />
                        <MudText Typo="Typo.body2" Class="ml-auto">
                            共 @_totalCount 条记录
                        </MudText>
                    </ToolBarContent>
                    <HeaderContent>
                        @foreach (var col in _visibleColumns)
                        {
                            <MudTh>
                                <span @onclick='() => ToggleSort(col.Key)' style="cursor:pointer" class="th-label">@col.Label@if (col.IsRequired) {<span class="required-star">*</span>} @if (sortColumn == col.Key) {@(sortDescending ? " ▼" : " ▲")}</span>
                            </MudTh>
                        }
                        <MudTh Style="width: 150px;">操作</MudTh>
                    </HeaderContent>
                    <RowTemplate Context="item">
                        @foreach (var col in _visibleColumns)
                        {
                            <MudTd>
                                @if (col.Key == "ItemKeyChinese")
                                {
                                    <b>@item.ItemKeyChinese</b>
                                }
                                else if (col.Key == "BasePrice")
                                {
                                    @item.BasePrice.ToString("G29")
                                }
                                else if (col.Key == "Unit")
                                {
                                    @item.UnitChinese
                                }
                                else if (col.Key == "TierCount")
                                {
                                    @item.TierCount
                                }
                                else if (col.Key == "IsActive")
                                {
                                    @(item.IsActive ? "是" : "否")
                                }
                                else if (col.Key == "Remark")
                                {
                                    @item.Remark
                                }
                                else if (col.Key == "UpdatedTime")
                                {
                                    @item.UpdatedTime.ToString("yyyy-MM-dd HH:mm")
                                }
                                else if (col.Key == "CreatedTime")
                                {
                                    @item.CreatedTime.ToString("yyyy-MM-dd HH:mm")
                                }
                                else
                                {
                                    @("")
                                }
                            </MudTd>
                        }
                        <MudTd Style="white-space: nowrap; width: 150px;">
                            <AuthorizeView Roles="@Roles.Policies.SalaryEdit">
                                <MudIconButton Icon="@Icons.Material.Filled.Edit" Title="编辑定义/维档" Color="Color.Info" Size="Size.Small" OnClick="() => EditItem(item)" />
                            </AuthorizeView>
                            <AuthorizeView Roles="@Roles.Policies.SalaryDelete">
                                <MudIconButton Icon="@Icons.Material.Filled.Delete" Title="删除" Color="Color.Error" Size="Size.Small" OnClick="() => DeleteItem(item)" />
                            </AuthorizeView>
                        </MudTd>
                    </RowTemplate>
                    <PagerContent>
                        <MudTablePager PageSizeOptions="new int[]{10,15,25,50,100}" />
                    </PagerContent>
                </MudTable>
            </div>
        </MudCardContent>
    </MudCard>
</MudContainer>
