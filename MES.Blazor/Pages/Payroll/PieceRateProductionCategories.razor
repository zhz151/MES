@page "/payroll/piece-rate-categories"
@using MES.Blazor.Components
@using MES.Blazor.Services
@using MES.Blazor.Helpers
@using MES.Blazor.Shared
@using MES.Core.Models
@using MES.Core.DTOs.Payroll
@using MES.Shared.Constants
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = Roles.Policies.SalaryView)]

<MudContainer MaxWidth="MaxWidth.False" Class="mt-4 pl-0">
    <MudCard>
        <MudCardHeader>
            <CardHeaderContent>
                <MudText Typo="Typo.h5" Class="font-weight-bold">
                    <MudIcon Icon="@Icons.Material.Filled.Category" Class="mr-2" Color="Color.Primary" />
                    生产计件类别（基准价 × 维档系数）
                </MudText>
            </CardHeaderContent>
            <CardHeaderActions>
                <MudText Typo="Typo.body2" Color="Color.Default" Class="mr-2">单价 = 类别基准价 × 命中维档系数连乘；工段×工序×产类×阶段同覆盖仅允许一个启用类别</MudText>
                <MudButton Variant="Variant.Outlined"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Download"
                           OnClick="ExportAll">
                    导出全量
                </MudButton>
                <AuthorizeView Roles="@Roles.Policies.SalaryEdit">
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Secondary"
                               StartIcon="@Icons.Material.Filled.PlaylistAdd"
                               OnClick='() => OpenImportDialog("category")'>
                        导入类别
                    </MudButton>
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Tertiary"
                               StartIcon="@Icons.Material.Filled.PlaylistAddCheck"
                               OnClick='() => OpenImportDialog("tier")'>
                        导入维档
                    </MudButton>
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.Add"
                               OnClick="AddNew">
                        新增类别
                    </MudButton>
                </AuthorizeView>
            </CardHeaderActions>
        </MudCardHeader>

        <MudCardContent>
            <!-- 搜索 + 筛选栏 -->
            <MudGrid>
                <MudItem xs="12" md="4">
                    <MudTextField T="string"
                                  Label="模糊搜索 - 自动组合名/工段/备注"
                                  Value="_searchKeyword"
                                  ValueExpression="@(() => _searchKeyword)"
                                  ValueChanged="@OnSearchChanged"
                                  Immediate="true"
                                  DebounceInterval="500"
                                  Adornment="Adornment.End"
                                  AdornmentIcon="@Icons.Material.Filled.Search" />
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudSelect T="string"
                               Label="工段筛选"
                               Value="_sectionFilter"
                               ValueChanged="@OnSectionFilterChanged"
                               Clearable="true"
                               AdornmentIcon="@Icons.Material.Filled.FilterList">
                        @foreach (var opt in _sectionOptions)
                        {
                            <MudSelectItem Value="@opt.Key" Text="@opt.Name">@opt.Name</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudSelect T="string"
                               Label="启停筛选"
                               Value="_activeFilter"
                               ValueChanged="@OnActiveFilterChanged"
                               Clearable="true"
                               AdornmentIcon="@Icons.Material.Filled.FilterList">
                        <MudSelectItem Value="@("true")">启用</MudSelectItem>
                        <MudSelectItem Value="@("false")">停用</MudSelectItem>
                    </MudSelect>
                </MudItem>
            </MudGrid>

            <!-- 数据表格 -->
            <div id="piece-rate-category-list-table">
            <MudTable @ref="table"
                      T="PieceRateProductionCategoryListItemDto"
                      ServerData="@LoadDataFromServer"
                      Dense="true"
                      Hover="true"
                      Class="mt-4 auto-table"
                      Elevation="0"
                      RowsPerPage="@_pageSize"
                      RowsPerPageLabel="每页行数:">
                <ToolBarContent>
                    <ColumnDisplaySelect Columns="_allColumns"
                                         OnColumnToggle="OnColumnToggle"
                                         OnMoveUp="MoveColumnUp"
                                         OnMoveDown="MoveColumnDown" />
                    <MudButton Variant="Variant.Text" Size="Size.Small"
                               Color="Color.Default"
                               StartIcon="@Icons.Material.Filled.RestartAlt"
                               OnClick="ResetColumnDisplay" Class="ml-2">
                        重置
                    </MudButton>
                    <MudSpacer />
                    <MudText Typo="Typo.body2" Class="ml-auto">
                        共 @_totalCount 条记录
                    </MudText>
                </ToolBarContent>
                <HeaderContent>
                    @foreach (var col in _visibleColumns)
                    {
                        <MudTh>
                            <span @onclick='() => ToggleSort(col.Key)' style="cursor:pointer" class="th-label">@col.Label@if (col.IsRequired) {<span class="required-star">*</span>} @if (sortColumn == col.Key) {@(sortDescending ? " ▼" : " ▲")}</span>
                        </MudTh>
                    }
                    <MudTh Style="width: 150px;">操作</MudTh>
                </HeaderContent>
                <RowTemplate Context="item">
                    @foreach (var col in _visibleColumns)
                    {
                        <MudTd>
                        @if (col.Key == "DisplayName")
                        {
                            <b>@item.DisplayName</b>
                        }
                        else if (col.Key == "SectionKey")
                        {
                            @item.SectionKeyChinese
                        }
                        else if (col.Key == "BasePrice")
                        {
                            @item.BasePrice.ToString("G29")
                        }
                        else if (col.Key == "Unit")
                        {
                            @item.UnitChinese
                        }
                        else if (col.Key == "TierCount")
                        {
                            @item.TierCount
                        }
                        else if (col.Key == "IsActive")
                        {
                            @(item.IsActive ? "是" : "否")
                        }
                        else if (col.Key == "Remark")
                        {
                            @item.Remark
                        }
                        else if (col.Key == "UpdatedTime")
                        {
                            @item.UpdatedTime.ToString("yyyy-MM-dd HH:mm")
                        }
                        else if (col.Key == "CreatedTime")
                        {
                            @item.CreatedTime.ToString("yyyy-MM-dd HH:mm")
                        }
                        else
                        {
                            @("")
                        }
                        </MudTd>
                    }
                    <MudTd Style="white-space: nowrap; width: 150px;">
                        <AuthorizeView Roles="@Roles.Policies.SalaryEdit">
                            <MudIconButton Icon="@Icons.Material.Filled.Edit" Title="编辑定义/维档" Color="Color.Info" Size="Size.Small" OnClick="() => EditItem(item)" />
                        </AuthorizeView>
                        <AuthorizeView Roles="@Roles.Policies.SalaryDelete">
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Title="删除" Color="Color.Error" Size="Size.Small" OnClick="() => DeleteItem(item)" />
                        </AuthorizeView>
                    </MudTd>
                </RowTemplate>
                <PagerContent>
                    <MudTablePager PageSizeOptions="new int[]{10,15,25,50,100}" />
                </PagerContent>
            </MudTable>
            </div>
        </MudCardContent>
    </MudCard>
</MudContainer>
