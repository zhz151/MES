@page "/maintenance-orders"
@using MES.Blazor.Services
@using MES.Blazor.Helpers
@using MES.Core.DTOs
@using MES.Core.Models
@using Microsoft.AspNetCore.Authorization
@using MES.Blazor.Shared
@using MES.Blazor.Components
@inject MaintenanceOrderService MaintenanceOrderService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject IJSRuntime JS
@inject ColumnPrefsService ColumnPrefs
@attribute [Authorize(Roles = "EquipmentStaff,EquipmentDirector,Admin")]

<MudContainer MaxWidth="MaxWidth.False" Class="mt-4 pl-0">
    <MudCard>
        <MudCardHeader>
            <CardHeaderContent>
                <MudText Typo="Typo.h5" Class="font-weight-bold">
                    <MudIcon Icon="@Icons.Material.Filled.MiscellaneousServices" Class="mr-2" Color="Color.Primary" />
                    保养工单
                </MudText>
            </CardHeaderContent>
            <CardHeaderActions>
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Add"
                           OnClick="NavigateToCreate">
                    新建保养
                </MudButton>
            </CardHeaderActions>
        </MudCardHeader>

        <MudCardContent>
            <!-- 搜索栏 -->
            <MudGrid>
                <MudItem xs="12" md="4">
                    <MudTextField T="string"
                                  Label="模糊搜索 - 工单号/设备/执行人"
                                  Value="_searchKeyword"
                                  ValueChanged="@OnSearchChanged"
                                  Immediate="true"
                                  DebounceInterval="500"
                                  Clearable="true"
                                  ClearButton="true"
                                  Adornment="Adornment.End"
                                  AdornmentIcon="@Icons.Material.Filled.Search" />
                </MudItem>
            </MudGrid>

            <!-- 数据表格 -->
            <div id="maintenance-orders-list-table">
            <MudTable @ref="table"
                      T="MaintenanceOrderListDto"
                      Items="@_filteredItems"
                      Dense="true"
                      Hover="true"
                      Class="mt-4 auto-table"
                      Elevation="0"
                      RowsPerPage="10"
                      RowsPerPageLabel="每页行数:">
                <ToolBarContent>
                    <ColumnDisplaySelect Columns="_allColumns"
                                         OnColumnToggle="OnColumnToggle"
                                         OnMoveUp="MoveColumnUp"
                                         OnMoveDown="MoveColumnDown" />
                    <MudButton Variant="Variant.Text" Size="Size.Small"
                               Color="Color.Default"
                               StartIcon="@Icons.Material.Filled.RestartAlt"
                               OnClick="ResetColumnDisplay" Class="ml-2">
                        重置
                    </MudButton>
                    <MudSpacer />
                    <MudButton Variant="Variant.Outlined"
                               Size="Size.Small"
                               Color="Color.Info"
                               StartIcon="@Icons.Material.Filled.Print"
                               Disabled="@(!selectedIds.Any())"
                               OnClick="PrintSelected">
                        打印选中 (@selectedIds.Count)
                    </MudButton>
                    <MudButton Variant="Variant.Text"
                               Size="Size.Small"
                               Color="Color.Info"
                               StartIcon="@Icons.Material.Filled.Print"
                               OnClick="PrintAll">
                        打印全部
                    </MudButton>
                    <MudText Typo="Typo.body2" Class="ml-auto">
                        共 @(_filteredItems?.Count ?? 0) 条记录
                    </MudText>
                </ToolBarContent>
                <HeaderContent>
                    <MudTh Style="width: 40px;">
                        <MudCheckBox T="bool" @bind-Value="allSelected" Dense="true" />
                    </MudTh>
                    @foreach (var col in _visibleColumns)
                    {
                        <MudTh>
                            <div style="display:inline-flex; align-items:center; gap:4px;">
                                <span class="th-label">@col.Label</span>
                                @if (col.FilterType != null)
                                {
                                    <ExcelFilter T="MaintenanceOrderListDto"
                                                 Label="@col.Label"
                                                 FieldKey="@col.Key"
                                                 AllItems="@_allItems"
                                                 ActiveFilterValues="@(_columnFilters.GetValueOrDefault(col.Key))"
                                                 DisplaySelector="@(x => GetCellDisplayText(x, col.Key))"
                                                 RawValueSelector="@(x => GetCellRawValue(x, col.Key))"
                                                 FilterChanged="@(args => OnColumnFilterChanged(args.fieldKey, args.selectedValues))"
                                                 SortRequested="@(args => OnExcelSortRequested(args.fieldKey, args.ascending))" />
                                }
                            </div>
                        </MudTh>
                    }
                    <MudTh Style="width: 110px;">操作</MudTh>
                </HeaderContent>
                <RowTemplate Context="item">
                    <MudTd Style="width: 40px;">
                        @if (!_editingIds.Contains(item.Id))
                        {
                            <MudCheckBox T="bool"
                                         Value="@selectedIds.Contains(item.Id)"
                                         ValueChanged="@((v) => { if(v) selectedIds.Add(item.Id); else selectedIds.Remove(item.Id); _allSelected = _filteredItems.Any() && _filteredItems.All(i => selectedIds.Contains(i.Id)); StateHasChanged(); })"
                                         Dense="true" />
                        }
                    </MudTd>
                    @foreach (var col in _visibleColumns)
                    {
                        <MudTd>@RenderCell(item, col)</MudTd>
                    }
                    <MudTd>
                        @if (_editingIds.Contains(item.Id))
                        {
                            <MudIconButton Icon="@Icons.Material.Filled.Save" Color="Color.Primary" Size="Size.Small" Title="保存" OnClick="() => SaveEdit(item.Id)" />
                            <MudIconButton Icon="@Icons.Material.Filled.Cancel" Color="Color.Default" Size="Size.Small" Title="取消" OnClick="() => CancelEdit(item.Id)" />
                        }
                        else
                        {
                            <AuthorizeView Roles="EquipmentDirector,Admin">
                                <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Info" Size="Size.Small" Title="编辑" OnClick="() => StartEdit(item)" />
                            </AuthorizeView>
                            <AuthorizeView Roles="EquipmentDirector,Admin">
                                <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" Title="删除" OnClick="() => DeleteItem(item)" />
                            </AuthorizeView>
                        }
                    </MudTd>
                </RowTemplate>
                <PagerContent>
                    <MudTablePager PageSizeOptions="new int[]{10,15,25,50,100}" />
                </PagerContent>
            </MudTable>
            </div>
        </MudCardContent>
    </MudCard>
</MudContainer>

@code {
    private MudTable<MaintenanceOrderListDto>? table;
    private List<MaintenanceOrderListDto> _allItems = new();
    private List<MaintenanceOrderListDto>? _filteredItemsList;
    private List<MaintenanceOrderListDto> _filteredItems => _filteredItemsList ?? _allItems;
    private bool _isArrowNavSetup;
    private string _searchKeyword = string.Empty;

    private string sortColumn = "id";
    private bool sortDescending = true;

    // ========== ExcelFilter 状态 ==========
    private Dictionary<string, HashSet<string>> _columnFilters = new();
    private Dictionary<string, List<MaintenanceOrderListDto>> _filterContexts = new();

    // ========== 多选打印 ==========
    private HashSet<int> selectedIds = new();
    private bool _allSelected;
    private bool allSelected
    {
        get => _allSelected;
        set
        {
            if (_allSelected == value) return;
            _allSelected = value;
            if (value)
            {
                foreach (var item in _filteredItems)
                    selectedIds.Add(item.Id);
            }
            else
            {
                selectedIds.Clear();
            }
            StateHasChanged();
        }
    }

    // ========== 内联编辑 ==========
    private HashSet<int> _editingIds = new();
    private Dictionary<int, MaintenanceEditCache> _editCache = new();

    private class MaintenanceEditCache
    {
        public string? ActualDateText { get; set; }
        public string? Executor { get; set; }
        public string? ExecutionSummaryText { get; set; }
        public string? Remark { get; set; }
    }

    // ========== 列定义 ==========

    private List<ColumnDef> _allColumns = new();
    private List<ColumnDef> _visibleColumns =>
        _allColumns.Where(c => c.IsApplicable && c.Visible).ToList();

    private static List<ColumnDef> GetAllColumnDefs() => new()
    {
        new() { Key = "MaintOrderNo",  Label = "保养单号",   SortKey = "maintorderno", FilterType = "string" },
        new() { Key = "EquipmentName", Label = "设备名称",   SortKey = "equipmentname", FilterType = "string" },
        new() { Key = "EquipmentCode", Label = "设备编号",   SortKey = "equipmentcode", FilterType = "string" },
        new() { Key = "Location",       Label = "所在区域",   SortKey = "location", FilterType = "string" },
        new() { Key = "ActualDate",    Label = "实际日期",   SortKey = "actualdate", FilterType = "date" },
        new() { Key = "Executor",      Label = "执行人",     SortKey = "executor", FilterType = "string" },
        new() { Key = "ExecutionSummary", Label = "执行简述", SortKey = "executionsummary", FilterType = "string" },
        new() { Key = "Remark",        Label = "备注", SortKey = "remark", FilterType = "string" },
    };

    // ========== 列选择操作 ==========

    private async Task OnColumnToggle(ColumnDef col) => await SaveColumnPrefs();
    private async Task MoveColumnUp(ColumnDef col) => await SaveColumnPrefs();
    private async Task MoveColumnDown(ColumnDef col) => await SaveColumnPrefs();

    private async Task SaveColumnPrefs()
    {
        await ColumnPrefs.SaveAsync("maintenance-orders", null, _allColumns);
    }

    private async Task ResetColumnDisplay()
    {
        _allColumns = GetAllColumnDefs();
        await SaveColumnPrefs();
    }

    // ========== 初始化 ==========

    protected override async Task OnInitializedAsync()
    {
        _allColumns = GetAllColumnDefs();
        var saved = await ColumnPrefs.LoadAsync("maintenance-orders", null);
        if (saved.Count > 0)
        {
            foreach (var s in saved)
            {
                var match = _allColumns.FirstOrDefault(c => c.Key == s.Key);
                if (match != null)
                    match.Visible = s.Visible;
            }
            var reordered = new List<ColumnDef>();
            foreach (var s in saved)
            {
                var match = _allColumns.FirstOrDefault(c => c.Key == s.Key);
                if (match != null && !reordered.Contains(match))
                    reordered.Add(match);
            }
            foreach (var c in _allColumns)
            {
                if (!reordered.Contains(c))
                    reordered.Add(c);
            }
            _allColumns = reordered;
        }

        await LoadAllDataAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_isArrowNavSetup)
        {
            _isArrowNavSetup = true;
            if (!await JS.InvokeAsync<bool>("enableTableArrowNav", "#maintenance-orders-list-table"))
                _isArrowNavSetup = false;
        }
    }

    private async Task LoadAllDataAsync()
    {
        try
        {
            var result = await MaintenanceOrderService.GetAllListAsync();
            if (result.Success && result.Data != null)
            {
                _allItems = result.Data;
            }
            else
            {
                Snackbar.Add(result.Message ?? "加载失败", Severity.Error);
            }
            _filteredItemsList = null;
            RefreshFilteredData();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"加载失败: {ex.Message}", Severity.Error);
        }
        finally
        {
            StateHasChanged();
        }
    }

    // ========== 搜索 ==========

    private async Task OnSearchChanged(string value)
    {
        _searchKeyword = value ?? string.Empty;
        RefreshFilteredData();
    }

    // ========== ExcelFilter 回调 ==========

    private async Task OnColumnFilterChanged(string fieldKey, HashSet<string> selectedValues)
    {
        if (selectedValues.Count > 0)
            _columnFilters[fieldKey] = selectedValues;
        else
            _columnFilters.Remove(fieldKey);

        RefreshFilteredData();
        await SavePageStateAsync();
    }

    private async Task OnExcelSortRequested(string fieldKey, bool ascending)
    {
        sortColumn = fieldKey;
        sortDescending = !ascending;
        RefreshFilteredData();
        await SavePageStateAsync();
    }

    // ========== 客户端刷新 ==========

    private void RefreshFilteredData()
    {
        var query = _allItems.AsEnumerable();

        // 关键字搜索
        if (!string.IsNullOrWhiteSpace(_searchKeyword))
        {
            var kw = _searchKeyword;
            query = query.Where(x =>
                (x.MaintOrderNo != null && x.MaintOrderNo.Contains(kw, StringComparison.OrdinalIgnoreCase)) ||
                (x.EquipmentName != null && x.EquipmentName.Contains(kw, StringComparison.OrdinalIgnoreCase)) ||
                (x.Executor != null && x.Executor.Contains(kw, StringComparison.OrdinalIgnoreCase))
            );
        }

        // ExcelFilter 列筛选
        foreach (var cf in _columnFilters)
        {
            var fieldKey = cf.Key;
            var selected = cf.Value;
            query = query.Where(x =>
            {
                var raw = GetCellRawValue(x, fieldKey);
                return raw != null && selected.Contains(raw);
            });
        }

        // 排序
        if (!string.IsNullOrEmpty(sortColumn))
        {
            query = sortColumn switch
            {
                "maintorderno" => sortDescending ? query.OrderByDescending(x => x.MaintOrderNo) : query.OrderBy(x => x.MaintOrderNo),
                "equipmentname" => sortDescending ? query.OrderByDescending(x => x.EquipmentName) : query.OrderBy(x => x.EquipmentName),
                "equipmentcode" => sortDescending ? query.OrderByDescending(x => x.EquipmentCode) : query.OrderBy(x => x.EquipmentCode),
                "location" => sortDescending ? query.OrderByDescending(x => x.Location) : query.OrderBy(x => x.Location),
                "actualdate" => sortDescending ? query.OrderByDescending(x => x.ActualDate) : query.OrderBy(x => x.ActualDate),
                "executor" => sortDescending ? query.OrderByDescending(x => x.Executor) : query.OrderBy(x => x.Executor),
                "executionsummary" => sortDescending ? query.OrderByDescending(x => x.ExecutionSummary) : query.OrderBy(x => x.ExecutionSummary),
                "remark" => sortDescending ? query.OrderByDescending(x => x.Remark) : query.OrderBy(x => x.Remark),
                _ => sortDescending ? query.OrderByDescending(x => x.Id) : query.OrderBy(x => x.Id)
            };
        }

        _filteredItemsList = query.ToList();
        StateHasChanged();
    }

    // ========== 单元格原始值/显示值 ==========

    private string? GetCellRawValue(MaintenanceOrderListDto item, string key) => key switch
    {
        "MaintOrderNo" => item.MaintOrderNo,
        "EquipmentName" => item.EquipmentName,
        "EquipmentCode" => item.EquipmentCode,
        "Location" => item.Location,
        "ActualDate" => item.ActualDate?.ToString("yyyy-MM-dd"),
        "Executor" => item.Executor,
        "ExecutionSummary" => item.ExecutionSummary,
        "Remark" => item.Remark,
        _ => null
    };

    private string? GetCellDisplayText(MaintenanceOrderListDto item, string key) => key switch
    {
        _ => GetCellRawValue(item, key) ?? ""
    };

    // ========== 持久化 ==========

    private async Task SavePageStateAsync()
    {
        await Task.CompletedTask;
    }

    private void NavigateToCreate() => Navigation.NavigateTo("/maintenance-orders/create");

    // ========== 内联编辑 ==========

    private void StartEdit(MaintenanceOrderListDto item)
    {
        _editingIds.Add(item.Id);
        _editCache[item.Id] = new MaintenanceEditCache
        {
            ActualDateText = item.ActualDate?.ToString("yyyy-MM-dd"),
            Executor = item.Executor,
            ExecutionSummaryText = item.ExecutionSummary ?? "",
            Remark = item.Remark
        };
    }

    private void CancelEdit(int id)
    {
        _editingIds.Remove(id);
        _editCache.Remove(id);
    }

    private async Task SaveEdit(int id)
    {
        if (!_editCache.TryGetValue(id, out var cache)) return;

        var errors = new List<string>();

        DateTime? actualDate = null;
        if (!string.IsNullOrWhiteSpace(cache.ActualDateText))
        {
            if (DateTime.TryParse(cache.ActualDateText, out var parsedActual))
                actualDate = parsedActual;
            else
                errors.Add("实际日期格式无效");
        }

        if (errors.Any())
        {
            Snackbar.Add(string.Join("；", errors), Severity.Error);
            return;
        }

        try
        {
            var request = new UpdateMaintenanceRequest
            {
                ActualDate = actualDate,
                Executor = cache.Executor,
                ExecutionSummary = cache.ExecutionSummaryText,
                Remark = cache.Remark
            };

            var result = await MaintenanceOrderService.UpdateAsync(id, request);
            if (result.Success)
            {
                Snackbar.Add("保存成功", Severity.Success);
                _editingIds.Remove(id);
                _editCache.Remove(id);
                await LoadAllDataAsync();
            }
            else
            {
                Snackbar.Add(result.Message ?? "保存失败", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"保存失败: {ex.Message}", Severity.Error);
        }
    }

    // ========== 删除 ==========

    private async Task DeleteItem(MaintenanceOrderListDto item)
    {
        var dialog = DialogService.Show<ConfirmDialog>("确认", new DialogParameters
        {
            ["ContentText"] = $"确定要删除保养工单 \"{item.MaintOrderNo}\" 吗？\n\n删除后数据将不可恢复！",
            ["ConfirmText"] = "确认删除",
            ["Color"] = Color.Error
        });
        var dialogResult = await dialog.Result;
        if (!dialogResult.Canceled)
        {
            try
            {
                var result = await MaintenanceOrderService.DeleteAsync(item.Id);
                if (result.Success)
                {
                    Snackbar.Add("删除成功", Severity.Success);
                    await LoadAllDataAsync();
                }
                else
                {
                    Snackbar.Add(result.Message ?? "删除失败", Severity.Error);
                }
            }
            catch (Exception ex)
            {
                Snackbar.Add($"删除失败: {ex.Message}", Severity.Error);
            }
        }
    }

    // ========== 打印方法 ==========

    private List<PrintColumnDef> GetPrintColumnDefs()
    {
        return _visibleColumns.Select(c => new PrintColumnDef
        {
            Key = c.Key,
            Label = c.Label
        }).ToList();
    }

    private async Task PrintSelected()
    {
        if (!selectedIds.Any())
        {
            Snackbar.Add("请先选择要打印的保养工单", Severity.Warning);
            return;
        }
        try
        {
            var ids = selectedIds.ToArray();
            var columns = GetPrintColumnDefs();
            var result = await MaintenanceOrderService.PrintBatchAsync(ids, columns);
            if (result.Success && result.Data != null)
                await JS.InvokeVoidAsync("openPdf", result.Data);
            else
                Snackbar.Add(result.Message ?? "打印失败", Severity.Error);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"打印失败: {ex.Message}", Severity.Error);
        }
    }

    private async Task PrintAll()
    {
        try
        {
            var columns = GetPrintColumnDefs();
            var query = new MaintenanceOrderQueryParams
            {
                Keyword = string.IsNullOrWhiteSpace(_searchKeyword) ? null : _searchKeyword,
                SortBy = sortColumn,
                IsDescending = sortDescending
            };
            var result = await MaintenanceOrderService.PrintAllAsync(query, columns);
            if (result.Success && result.Data != null)
                await JS.InvokeVoidAsync("openPdf", result.Data);
            else
                Snackbar.Add(result.Message ?? "打印失败", Severity.Error);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"打印失败: {ex.Message}", Severity.Error);
        }
    }

    // ========== 单元格渲染 ==========

    private RenderFragment RenderCell(MaintenanceOrderListDto item, ColumnDef col) => builder =>
    {
        if (_editingIds.Contains(item.Id) && _editCache.TryGetValue(item.Id, out var cache))
        {
            // 系统/只读字段在编辑模式下仍然只读显示
            if (col.Key is "MaintOrderNo" or "EquipmentName" or "EquipmentCode" or "Location")
            {
                RenderReadonlyCell(item, col)(builder);
                return;
            }
            RenderEditCell(cache, col)(builder);
            return;
        }

        switch (col.Key)
        {
            case "MaintOrderNo":
                builder.AddContent(0, item.MaintOrderNo);
                break;
            case "EquipmentName":
                builder.AddContent(0, item.EquipmentName);
                break;
            case "EquipmentCode":
                builder.AddContent(0, item.EquipmentCode);
                break;
            case "Location":
                builder.AddContent(0, item.Location);
                break;
            case "ActualDate":
                builder.AddContent(0, item.ActualDate?.ToString("yyyy-MM-dd"));
                break;
            case "Executor":
                builder.AddContent(0, item.Executor);
                break;
            case "ExecutionSummary":
                builder.AddContent(0, item.ExecutionSummary);
                break;
            case "Remark":
                builder.AddContent(0, item.Remark);
                break;
            default:
                builder.AddContent(0, "");
                break;
        }
    };

    private RenderFragment RenderReadonlyCell(MaintenanceOrderListDto item, ColumnDef col) => builder =>
    {
        switch (col.Key)
        {
            case "MaintOrderNo":
                builder.AddContent(0, item.MaintOrderNo);
                break;
            case "EquipmentName":
                builder.AddContent(0, item.EquipmentName);
                break;
            case "EquipmentCode":
                builder.AddContent(0, item.EquipmentCode);
                break;
            case "Location":
                builder.AddContent(0, item.Location);
                break;
            default:
                builder.AddContent(0, "");
                break;
        }
    };

    private RenderFragment RenderEditCell(MaintenanceEditCache cache, ColumnDef col) => builder =>
    {
        switch (col.Key)
        {
            case "ActualDate":
                builder.OpenComponent<MudTextField<string>>(0);
                builder.AddAttribute(1, "Dense", true);
                builder.AddAttribute(2, "Variant", Variant.Outlined);
                builder.AddAttribute(3, "Size", Size.Small);
                builder.AddAttribute(4, "Value", cache.ActualDateText);
                builder.AddAttribute(5, "ValueChanged", EventCallback.Factory.Create<string?>(this, v => cache.ActualDateText = v));
                builder.AddAttribute(6, "Placeholder", "yyyy-MM-dd");
                builder.CloseComponent();
                break;
            case "Executor":
                builder.OpenComponent<MudTextField<string>>(0);
                builder.AddAttribute(1, "Dense", true);
                builder.AddAttribute(2, "Variant", Variant.Outlined);
                builder.AddAttribute(3, "Size", Size.Small);
                builder.AddAttribute(4, "Value", cache.Executor);
                builder.AddAttribute(5, "ValueChanged", EventCallback.Factory.Create<string?>(this, v => cache.Executor = v));
                builder.CloseComponent();
                break;
            case "ExecutionSummary":
                builder.OpenComponent<MudTextField<string>>(0);
                builder.AddAttribute(1, "Dense", true);
                builder.AddAttribute(2, "Variant", Variant.Outlined);
                builder.AddAttribute(3, "Size", Size.Small);
                builder.AddAttribute(4, "Value", cache.ExecutionSummaryText);
                builder.AddAttribute(5, "ValueChanged", EventCallback.Factory.Create<string?>(this, v => cache.ExecutionSummaryText = v));
                builder.CloseComponent();
                break;
            case "Remark":
                builder.OpenComponent<MudTextField<string>>(0);
                builder.AddAttribute(1, "Dense", true);
                builder.AddAttribute(2, "Variant", Variant.Outlined);
                builder.AddAttribute(3, "Size", Size.Small);
                builder.AddAttribute(4, "Value", cache.Remark);
                builder.AddAttribute(5, "ValueChanged", EventCallback.Factory.Create<string?>(this, v => cache.Remark = v));
                builder.CloseComponent();
                break;
        }
    };
}
