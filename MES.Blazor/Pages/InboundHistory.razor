    // ========== 客户端刷新 ==========

    private void RefreshFilteredData()
    {
        ClearEditState();

        var query = _allItems.AsEnumerable();

        // 关键字搜索
        if (!string.IsNullOrWhiteSpace(_searchKeyword))
        {
            var kw = _searchKeyword;
            query = query.Where(x =>
                (x.BatchNo != null && x.BatchNo.Contains(kw, StringComparison.OrdinalIgnoreCase)) ||
                (x.MaterialType != null && x.MaterialType.Contains(kw, StringComparison.OrdinalIgnoreCase)) ||
                (x.PlantGrade != null && x.PlantGrade.Contains(kw, StringComparison.OrdinalIgnoreCase)) ||
                (x.Specification != null && x.Specification.Contains(kw, StringComparison.OrdinalIgnoreCase)) ||
                (x.HeatNo != null && x.HeatNo.Contains(kw, StringComparison.OrdinalIgnoreCase)) ||
                (x.SourceName != null && x.SourceName.Contains(kw, StringComparison.OrdinalIgnoreCase)) ||
                (x.WorkOrderNo != null && x.WorkOrderNo.Contains(kw, StringComparison.OrdinalIgnoreCase)) ||
                (x.SalesOrderNo != null && x.SalesOrderNo.Contains(kw, StringComparison.OrdinalIgnoreCase))
            );
        }

        // ExcelFilter 列筛选
        foreach (var cf in _columnFilters)
        {
            var fieldKey = cf.Key;
            var selected = cf.Value;
            query = query.Where(x =>
            {
                var raw = GetCellRawValue(x, fieldKey);
                return raw != null && selected.Contains(raw);
            });
        }

        // 排序 - 复用 WarehouseInventory 的排序逻辑
        if (!string.IsNullOrEmpty(sortColumn))
        {
            query = sortColumn switch
            {
                "batchno" => sortDescending ? query.OrderByDescending(x => x.BatchNo) : query.OrderBy(x => x.BatchNo),
                "inbounddate" => sortDescending ? query.OrderByDescending(x => x.InboundDate) : query.OrderBy(x => x.InboundDate),
                "inboundsource" => sortDescending ? query.OrderByDescending(x => x.InboundSource) : query.OrderBy(x => x.InboundSource),
                "sourceorderno" => sortDescending ? query.OrderByDescending(x => x.SourceOrderNo ?? "") : query.OrderBy(x => x.SourceOrderNo ?? ""),
                "materialtype" => sortDescending ? query.OrderByDescending(x => x.MaterialType) : query.OrderBy(x => x.MaterialType),
                "sourcename" => sortDescending ? query.OrderByDescending(x => x.SourceName ?? "") : query.OrderBy(x => x.SourceName ?? ""),
                "surfacecondition" => sortDescending ? query.OrderByDescending(x => x.SurfaceCondition ?? "") : query.OrderBy(x => x.SurfaceCondition ?? ""),
                "locationarea" => sortDescending ? query.OrderByDescending(x => x.LocationArea ?? "") : query.OrderBy(x => x.LocationArea ?? ""),
                "locationrack" => sortDescending ? query.OrderByDescending(x => x.LocationRack ?? "") : query.OrderBy(x => x.LocationRack ?? ""),
                "heatno" => sortDescending ? query.OrderByDescending(x => x.HeatNo ?? "") : query.OrderBy(x => x.HeatNo ?? ""),
                "plantgrade" => sortDescending ? query.OrderByDescending(x => x.PlantGrade) : query.OrderBy(x => x.PlantGrade),
                "specification" => sortDescending ? query.OrderByDescending(x => x.Specification) : query.OrderBy(x => x.Specification),
                "lengthstatus" => sortDescending ? query.OrderByDescending(x => x.LengthStatus ?? "") : query.OrderBy(x => x.LengthStatus ?? ""),
                "minlength" => sortDescending ? query.OrderByDescending(x => x.MinLength) : query.OrderBy(x => x.MinLength),
                "maxlength" => sortDescending ? query.OrderByDescending(x => x.MaxLength) : query.OrderBy(x => x.MaxLength),
                "initialquantity" => sortDescending ? query.OrderByDescending(x => x.InitialQuantity) : query.OrderBy(x => x.InitialQuantity),
                "initialweight" => sortDescending ? query.OrderByDescending(x => x.InitialWeight) : query.OrderBy(x => x.InitialWeight),
                "unitweight" => sortDescending ? query.OrderByDescending(x => x.UnitWeight) : query.OrderBy(x => x.UnitWeight),
                "meters" => sortDescending ? query.OrderByDescending(x => x.Meters) : query.OrderBy(x => x.Meters),
                "remark" => sortDescending ? query.OrderByDescending(x => x.Remark ?? "") : query.OrderBy(x => x.Remark ?? ""),
                "islinkedtoworkorder" => sortDescending ? query.OrderByDescending(x => x.IsLinkedToWorkOrder) : query.OrderBy(x => x.IsLinkedToWorkOrder),
                "workorderno" => sortDescending ? query.OrderByDescending(x => x.WorkOrderNo ?? "") : query.OrderBy(x => x.WorkOrderNo ?? ""),
                "salesorderno" => sortDescending ? query.OrderByDescending(x => x.SalesOrderNo ?? "") : query.OrderBy(x => x.SalesOrderNo ?? ""),
                "orderitemids" => sortDescending ? query.OrderByDescending(x => x.OrderItemIds ?? "") : query.OrderBy(x => x.OrderItemIds ?? ""),
                "productionbatchno" => sortDescending ? query.OrderByDescending(x => x.ProductionBatchNo ?? "") : query.OrderBy(x => x.ProductionBatchNo ?? ""),
