@page "/workorders/generate"
@using MES.Blazor.Helpers
@using MES.Blazor.Services
@using MES.Core.DTOs
@using MES.Core.Enums
@using Microsoft.AspNetCore.Authorization
@inject WorkOrderService WorkOrderService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject IJSRuntime JS
@attribute [Authorize(Roles = Roles.Policies.WorkOrderRead)]

<MudContainer MaxWidth="MaxWidth.False" Class="mt-4" id="workorder-generate-table">
    @if (isLoading)
    {
        <MudProgressCircular Indeterminate Size="Size.Large" Class="d-flex justify-center ma-8" />
    }
    else
    {
        <MudCard>
            <MudCardHeader>
                <CardHeaderContent>
                    <MudText Typo="Typo.h5" Class="font-weight-bold">
                        <MudIcon Icon="@Icons.Material.Filled.Add" Class="mr-2" Color="Color.Primary" />
                        生成工单
                    </MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">订单号：@salesOrderNo</MudText>
                    @if (workOrderStatus == WorkOrderStatus.Pending.ToString())
                    {
                        <MudChip Size="Size.Small" Color="Color.Warning" Class="ml-2">待修正</MudChip>
                    }
                    else if (generateMode == WorkOrderGenerateMode.Regenerate)
                    {
                        <MudChip Size="Size.Small" Color="Color.Success" Class="ml-2">重新生成（删除重建）</MudChip>
                    }
                    else if (generateMode == WorkOrderGenerateMode.Update)
                    {
                        <MudChip Size="Size.Small" Color="Color.Info" Class="ml-2">更新修改（保留原工单号）</MudChip>
                    }
                    else if (workOrderStatus == WorkOrderStatus.NotGenerated.ToString())
                    {
                        <MudChip Size="Size.Small" Color="Color.Default" Class="ml-2">首次生成</MudChip>
                    }
                </CardHeaderContent>
                <CardHeaderActions>
                    <MudButton Variant="Variant.Text" OnClick="GoBack">返回</MudButton>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SubmitWorkOrders" Disabled="@isSubmitting">
                        @if (isSubmitting)
                        {
                            <MudProgressCircular Size="Size.Small" Color="Color.Inherit" />
                        }
                        else
                        {
                            <span>生成工单</span>
                        }
                    </MudButton>
                </CardHeaderActions>
            </MudCardHeader>

            <MudCardContent>
                @if (hasError)
                {
                    <MudPaper Class="pa-4 mb-4" Elevation="0" Style="border:1px solid var(--mud-palette-lines-default); border-radius:8px;">
                        <MudText Typo="Typo.body2" Color="Color.Error"><strong>加载失败：</strong>@errorMessage</MudText>
                        <div class="mt-3">
                            <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="GoBack">返回工单列表</MudButton>
                        </div>
                    </MudPaper>
                }
                else if (orderItems == null || !orderItems.Any())
                {
                }
                else
                {
                    <!-- 模式切换（仅已有工单时显示） -->
                    @if (hasExistingWorkOrders)
                    {
                        <MudPaper Class="pa-3 mb-3 d-flex align-center" Elevation="0" Style="background-color: #f5f5f5; border-radius: 8px;">
                            <MudText Typo="Typo.body2" Class="mr-4"><strong>生成模式：</strong></MudText>
                            <MudButton Variant="@(generateMode == WorkOrderGenerateMode.Regenerate ? Variant.Filled : Variant.Outlined)"
                                       Color="Color.Success"
                                       Class="mr-2"
                                       OnClick="() => SetMode(WorkOrderGenerateMode.Regenerate)"
                                       Size="Size.Small">
                                @*<MudIcon Icon="@Icons.Material.Filled.Refresh" Size="Size.Small" Class="mr-1" />*@
                                重新生成
                            </MudButton>
                            <MudButton Variant="@(generateMode == WorkOrderGenerateMode.Update ? Variant.Filled : Variant.Outlined)"
                                       Color="Color.Info"
                                       Class="mr-2"
                                       OnClick="() => SetMode(WorkOrderGenerateMode.Update)"
                                       Size="Size.Small">
                                @*<MudIcon Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Class="mr-1" />*@
                                更新修改
                            </MudButton>
                            <MudTooltip Text="重新生成：删除所有原工单后全新创建（工单号重新分配）；更新修改：保留原工单号/主号/次号，仅增删项次">
                                <MudIcon Icon="@Icons.Material.Filled.Info" Size="Size.Small" Color="Color.Secondary" Class="ml-2" />
                            </MudTooltip>
                        </MudPaper>
                    }


                    <!-- 项次统计信息 -->
                    <MudText Typo="Typo.body2" Color="Color.Info" Class="mb-3">
                        <strong>项次统计：</strong> 共 @orderItems.Count 个项次
                        （原有项次 @_existingItemCount 个，新增项次 @_newItemCount 个）
                    </MudText>

                    <!-- 表格区域：固定高度400px，表头固定，关闭分页 -->
                    <div style="max-height: 400px; overflow-y: auto; border-radius: 4px;">
                        <MudTable T="OrderItemForWorkOrderDto"
                                  Items="@orderItems"
                                  Dense="true"
                                  Hover="true"
                                  Elevation="0"
                                  Class="auto-table"
                                  RowsPerPage="0"
                                  SortLabel="点击表头排序">
                            <HeaderContent>
                                <MudTh SortBy="item => item.Sequence">项次</MudTh>
                                <MudTh SortBy="item => item.MaterialName">物料名称</MudTh>
                                <MudTh SortBy="item => item.DeliveryDate">交货日期</MudTh>
                                <MudTh SortBy="item => item.DeliveryState">交货状态</MudTh>
                                <MudTh SortBy="item => item.PlantGrade">工厂牌号</MudTh>
                                <MudTh SortBy="item => item.Specification">规格</MudTh>
                                <MudTh SortBy="item => item.LengthStatus">长度状态</MudTh>
                                <MudTh SortBy="item => item.MinLength">最小长度</MudTh>
                                <MudTh SortBy="item => item.MaxLength">最大长度</MudTh>
                                <MudTh SortBy="item => item.Quantity">支数</MudTh>
                                <MudTh SortBy="item => item.Meters">米数</MudTh>
                                <MudTh SortBy="item => item.ContractWeight">合同重量</MudTh>
                                <MudTh>主号</MudTh>
                                <MudTh>次号</MudTh>
                                @if (generateMode == WorkOrderGenerateMode.Update)
                                {
                                    <MudTh>状态</MudTh>
                                }
                            </HeaderContent>
                            <RowTemplate Context="item">
                                <MudTd>@item.Sequence</MudTd>
                                <MudTd>@DisplayHelper.GetMaterialNameText(item.MaterialName)</MudTd>
                                <MudTd>@item.DeliveryDate.ToString("yyyy-MM-dd")</MudTd>
                                <MudTd>@DisplayHelper.GetDeliveryStateText(item.DeliveryState)</MudTd>
                                <MudTd>@item.PlantGrade</MudTd>
                                <MudTd>@DisplayHelper.FormatSpecification(item.Specification)</MudTd>
                                <MudTd>@DisplayHelper.GetLengthStatusText(item.LengthStatus)</MudTd>
                                <MudTd>@DisplayHelper.FormatNullableDecimal(item.MinLength)</MudTd>
                                <MudTd>@DisplayHelper.FormatNullableDecimal(item.MaxLength)</MudTd>
                                <MudTd>@item.Quantity</MudTd>
                                <MudTd>@DisplayHelper.FormatNullableDecimal(item.Meters)</MudTd>
                                <MudTd>@DisplayHelper.FormatDecimal(item.ContractWeight)</MudTd>
                                <MudTd>
                                    <MudTextField T="string"
                                                  @bind-Value="item.SuggestedMainNo"
                                                  Dense="true"
                                                  Variant="Variant.Outlined"
                                                  Size="Size.Small"
                                                  Style="width: 80px;"
                                                  Class="@GetMainNoFieldClass(item)" />
                                </MudTd>
                                <MudTd>
                                    <MudTextField T="string"
                                                  @bind-Value="subNoMap[item.Id]"
                                                  Dense="true"
                                                  Variant="Variant.Outlined"
                                                  Size="Size.Small"
                                                  Style="width: 80px;"
                                                  />
                                </MudTd>
                                @if (generateMode == WorkOrderGenerateMode.Update)
                                {
                                    <MudTd>
                                        @if (string.IsNullOrEmpty(item.OriginalMainNo))
                                        {
                                            <MudChip Size="Size.Small" Color="Color.Warning">新增</MudChip>
                                        }
                                        else
                                        {
                                            <MudChip Size="Size.Small" Color="Color.Success">原项次</MudChip>
                                        }
                                    </MudTd>
                                }
                            </RowTemplate>
                        </MudTable>
                    </div>
                }
            </MudCardContent>
        </MudCard>
    }
</MudContainer>

@code {
    [Parameter]
    [SupplyParameterFromQuery]
    public string? salesOrderNo { get; set; }

    [Parameter]
    [SupplyParameterFromQuery]
    public string? status { get; set; }

    [Parameter]
    [SupplyParameterFromQuery]
    public bool? regenerate { get; set; }

    [Parameter]
    [SupplyParameterFromQuery]
    public bool? update { get; set; }

    private string workOrderStatus => status ?? "NotGenerated";

    private WorkOrderGenerateMode generateMode = WorkOrderGenerateMode.FirstTime;
    private List<OrderItemForWorkOrderDto>? orderItems;
    private Dictionary<int, string> subNoMap = new();
    private bool isLoading = true;
    private bool isSubmitting;
    private bool hasError = false;
    private string errorMessage = string.Empty;
    private bool hasExistingWorkOrders = false;
    private int _existingItemCount;
    private int _newItemCount;

    protected override async Task OnInitializedAsync()
    {
        if (regenerate == true)
            generateMode = WorkOrderGenerateMode.Regenerate;
        else if (update == true)
            generateMode = WorkOrderGenerateMode.Update;

        await LoadData();
    }

    private bool _isArrowNavSetup;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_isArrowNavSetup)
        {
            _isArrowNavSetup = true;
            if (!await JS.InvokeAsync<bool>("enableTableArrowNav", "#workorder-generate-table"))
                _isArrowNavSetup = false;
        }
    }

    private void SetMode(WorkOrderGenerateMode mode)
    {
        if (generateMode == mode) return;
        generateMode = mode;
        ApplyModeDefaults();
    }

    private void ApplyModeDefaults()
    {
        if (orderItems == null) return;

        foreach (var item in orderItems)
        {
            if (generateMode == WorkOrderGenerateMode.Update)
            {
                // 更新修改模式：原项次保留原主号/次号，新增项次清空
                if (!string.IsNullOrEmpty(item.OriginalMainNo))
                {
                    item.SuggestedMainNo = item.OriginalMainNo;
                    if (!string.IsNullOrEmpty(item.OriginalSubNo))
                        subNoMap[item.Id] = item.OriginalSubNo;
                    else if (subNoMap.ContainsKey(item.Id) && !string.IsNullOrEmpty(subNoMap[item.Id]))
                        subNoMap[item.Id] = string.Empty;
                }
                else
                {
                    item.SuggestedMainNo = string.Empty;
                    subNoMap[item.Id] = string.Empty;
                }
            }
            else
            {
                // 重新生成/首次生成模式：预填原主号/次号
                if (!string.IsNullOrEmpty(item.OriginalMainNo))
                {
                    item.SuggestedMainNo = item.OriginalMainNo;
                    if (!string.IsNullOrEmpty(item.OriginalSubNo))
                        subNoMap[item.Id] = item.OriginalSubNo;
                }
            }
        }
    }

    private string GetMainNoFieldClass(OrderItemForWorkOrderDto item)
    {
        // 更新修改模式下，原有项次的主号只读显示
        if (generateMode == WorkOrderGenerateMode.Update && !string.IsNullOrEmpty(item.OriginalMainNo))
            return "readonly-field";
        return string.Empty;
    }

    private async Task LoadData()
    {
        if (string.IsNullOrEmpty(salesOrderNo))
        {
            hasError = true;
            errorMessage = "订单号不能为空，请从工单列表页面重新进入。";
            isLoading = false;
            return;
        }

        isLoading = true;
        StateHasChanged();

        try
        {
            var result = await WorkOrderService.GetOrderItemsForWorkOrderAsync(salesOrderNo);
            if (result.Success && result.Data != null && result.Data.Any())
            {
                orderItems = result.Data;

                // 检查是否有现有工单（基于是否有 OriginalMainNo）
                _existingItemCount = orderItems.Count(i => !string.IsNullOrEmpty(i.OriginalMainNo));
                _newItemCount = orderItems.Count - _existingItemCount;
                hasExistingWorkOrders = _existingItemCount > 0;

                // 如果没有原始工单，强制使用首次生成模式
                if (!hasExistingWorkOrders)
                    generateMode = WorkOrderGenerateMode.FirstTime;

                foreach (var item in orderItems)
                {
                    subNoMap[item.Id] = string.Empty;

                    if (generateMode == WorkOrderGenerateMode.FirstTime && !string.IsNullOrEmpty(item.OriginalMainNo))
                    {
                        // 首次生成但已有数据（待修正全新生成）— 清空预填
                        item.SuggestedMainNo = string.Empty;
                    }
                }

                ApplyModeDefaults();
            }
            else
            {
                hasError = true;
                errorMessage = result.Message ?? "获取订单项次失败";
            }
        }
        catch (Exception ex)
        {
            hasError = true;
            errorMessage = $"加载失败: {ex.Message}";
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private string GetMergeKey(OrderItemForWorkOrderDto item)
    {
        return $"{item.DeliveryDate:yyyy-MM-dd}|{item.DelayPenalty}|{item.MaterialName}|{item.SettlementMethod}|" +
               $"{item.StandardCode}|{item.DeliveryState}|{item.PlantGrade}|{item.Specification}|" +
               $"{item.OuterDiameterNegative}|{item.OuterDiameterPositive}|{item.WallThicknessNegative}|" +
               $"{item.WallThicknessPositive}|{item.LengthStatus}";
    }

    private static string GetMainNoPrefix(MaterialName materialName, LengthStatus lengthStatus)
    {
        if (materialName == MaterialName.WeldedPipe)
            return "H";
        return lengthStatus switch
        {
            LengthStatus.Fixed => "D",
            LengthStatus.Range => "F",
            LengthStatus.NonFixed => "L",
            _ => "D"
        };
    }

    private async Task SubmitWorkOrders()
    {
        if (orderItems == null || !orderItems.Any())
        {
            Snackbar.Add("没有可生成的工单项次", Severity.Warning);
            return;
        }

        var errors = new List<string>();

        // 验证次号（先验证，后分组）
        foreach (var item in orderItems)
        {
            var lengthStatus = item.LengthStatus;
            var subNo = subNoMap.GetValueOrDefault(item.Id);
            if (lengthStatus == LengthStatus.Fixed && string.IsNullOrEmpty(subNo))
            {
                errors.Add($"项次 {item.Sequence} 为定尺模式，次号不能为空（格式：C+两位数字）");
            }
            else if (lengthStatus == LengthStatus.Fixed && !string.IsNullOrEmpty(subNo) && !System.Text.RegularExpressions.Regex.IsMatch(subNo, @"^C\d{2}$"))
            {
                errors.Add($"项次 {item.Sequence} 的次号格式错误，应为 C+两位数字（如 C01）");
            }
            else if (lengthStatus != LengthStatus.Fixed && !string.IsNullOrEmpty(subNo))
            {
                errors.Add($"项次 {item.Sequence} 为{DisplayHelper.GetLengthStatusText(lengthStatus)}模式，不需要填写次号");
            }
        }

        if (errors.Any())
        {
            Snackbar.Add(string.Join("；", errors), Severity.Error);
            return;
        }

        // 验证主号前缀（可编辑项次）
        foreach (var item in orderItems)
        {
            var mainNo = item.SuggestedMainNo;
            if (string.IsNullOrEmpty(mainNo)) continue; // 主号为空由后续验证处理

            // Update 模式下已有原始主号的项次为只读，不验证前缀（历史数据可能已不符合规则）
            if (generateMode == WorkOrderGenerateMode.Update && !string.IsNullOrEmpty(item.OriginalMainNo))
                continue;

            var expectedPrefix = GetMainNoPrefix(item.MaterialName, item.LengthStatus);
            if (!mainNo.StartsWith(expectedPrefix))
            {
                var prefixDesc = expectedPrefix switch
                {
                    "H" => "焊管",
                    "D" => "定尺",
                    "F" => "范围尺",
                    "L" => "非定尺",
                    _ => expectedPrefix
                };
                errors.Add($"项次 {item.Sequence} 的主号 \"{mainNo}\" 首字母应为 \"{expectedPrefix}\"（{DisplayHelper.GetMaterialNameText(item.MaterialName)}/{DisplayHelper.GetLengthStatusText(item.LengthStatus)} → {prefixDesc}）");
            }
        }

        if (errors.Any())
        {
            Snackbar.Add(string.Join("；", errors), Severity.Error);
            return;
        }

        // 按主号+次号分组
        var groups = new Dictionary<(string mainNo, string subNo), List<OrderItemForWorkOrderDto>>();
        foreach (var item in orderItems)
        {
            var mainNo = item.SuggestedMainNo;
            if (string.IsNullOrEmpty(mainNo))
            {
                errors.Add($"项次 {item.Sequence} 的主号不能为空");
                continue;
            }
            var subNo = subNoMap.GetValueOrDefault(item.Id) ?? "";
            var key = (mainNo, subNo);
            if (!groups.ContainsKey(key))
                groups[key] = new List<OrderItemForWorkOrderDto>();
            groups[key].Add(item);
        }

        if (errors.Any())
        {
            Snackbar.Add(string.Join("；", errors), Severity.Error);
            return;
        }

        // 验证每个分组内的合并字段一致性
        foreach (var group in groups)
        {
            var (mainNo, subNo) = group.Key;
            var itemsInGroup = group.Value;
            if (itemsInGroup.Count <= 1) continue;

            var baseMergeKey = GetMergeKey(itemsInGroup.First());
            var inconsistentItems = new List<int>();
            foreach (var item in itemsInGroup.Skip(1))
            {
                if (GetMergeKey(item) != baseMergeKey)
                    inconsistentItems.Add(item.Sequence);
            }
            if (inconsistentItems.Any())
            {
                var subDesc = string.IsNullOrEmpty(subNo) ? "" : $"/次号{subNo}";
                errors.Add($"主号 {mainNo}{subDesc} 下的项次 {string.Join(",", inconsistentItems)} 与组内其他项次规格参数不一致，不能合并到同一工单");
            }
        }

        if (errors.Any())
        {
            Snackbar.Add(string.Join("；", errors), Severity.Error);
            return;
        }

        var workOrderGroups = new List<WorkOrderItemGroup>();
        foreach (var group in groups)
        {
            var (mainNo, subNo) = group.Key;
            workOrderGroups.Add(new WorkOrderItemGroup
            {
                ProductionMainNo = mainNo,
                ProductionSubNo = string.IsNullOrEmpty(subNo) ? null : subNo,
                OrderItemIds = group.Value.Select(x => x.Sequence).Distinct().ToList()
            });
        }

        // 验证工单号是否重复（不同分组生成了相同工单号）
        var workOrderNoSet = new HashSet<string>();
        var duplicateNos = new List<string>();
        foreach (var g in workOrderGroups)
        {
            var subPart = string.IsNullOrEmpty(g.ProductionSubNo) ? "" : $"-{g.ProductionSubNo}";
            var woNo = $"{salesOrderNo}-{g.ProductionMainNo}{subPart}";
            if (!workOrderNoSet.Add(woNo))
                duplicateNos.Add(woNo);
        }
        if (duplicateNos.Any())
        {
            errors.Add($"工单号重复，无法生成：{string.Join("，", duplicateNos)}");
            Snackbar.Add(string.Join("；", errors), Severity.Error);
            return;
        }

        // Regenerate 模式：提交前确认（将物理删除现有工单及关联用料计划）
        if (generateMode == WorkOrderGenerateMode.Regenerate)
        {
            var confirm = await DialogService.ShowMessageBox(
                "确认重新生成",
                "重新生成将物理删除该订单所有现有工单及关联的用料计划（荒管采购/成品采购/库存使用/圆棒穿孔），确定继续？",
                yesText: "确定重新生成",
                cancelText: "取消");
            if (confirm != true)
                return;
        }

        var request = new CreateWorkOrderRequest
        {
            SalesOrderNo = salesOrderNo!,
            WorkOrders = workOrderGroups,
            GenerateMode = generateMode
        };

        isSubmitting = true;
        StateHasChanged();

        try
        {
            var result = await WorkOrderService.GenerateWorkOrdersAsync(request);
            if (result.Success && result.Data != null && result.Data.Any())
            {
                var modifiedCount = result.Data.Count(d => d.IsModified);
                var totalCount = result.Data.Count;
                Snackbar.Add($"成功处理 {totalCount} 个工单（修改 {modifiedCount} 个）", Severity.Success);
                Navigation.NavigateTo("/workorders");
            }
            else
            {
                Snackbar.Add(result.Message ?? "生成工单失败", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"生成失败: {ex.Message}", Severity.Error);
        }
        finally
        {
            isSubmitting = false;
            StateHasChanged();
        }
    }

    private void GoBack() => Navigation.NavigateTo("/workorders");
}
