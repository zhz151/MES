@page "/workorders/{WorkOrderId:int}/finish-plan/create"
@page "/workorders/{WorkOrderId:int}/finish-plan/edit/{PlanId:int}"
@using MES.Blazor.Services
@using MES.Core.DTOs
@using MES.Blazor.Shared
@using MES.Blazor.Helpers
@using Microsoft.AspNetCore.Authorization
@inject MaterialPlanService MaterialPlanService
@inject WorkOrderService WorkOrderService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject IJSRuntime JS
@attribute [Authorize(Roles = Roles.Policies.WorkOrderRead)]

<style>
    .finish-create-table table {
        table-layout: fixed;
    }
    .finish-create-table table th,
    .finish-create-table table td {
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }
</style>

<MudContainer MaxWidth="MaxWidth.False" Class="mt-4">
    <MudCard>
        <MudCardHeader>
            <CardHeaderContent>
                <div class="d-flex align-center">
                    <MudIcon Icon="@Icons.Material.Filled.Checklist" Class="mr-2" Color="Color.Primary" Size="Size.Medium" />
                    <MudText Typo="Typo.h5" Class="font-weight-bold">@(IsEditMode ? "编辑" : "新增")成品采购计划</MudText>
                </div>
            </CardHeaderContent>
            <CardHeaderActions>
                <MudButton Variant="Variant.Text" OnClick="GoBack">返回上一级</MudButton>
            </CardHeaderActions>
        </MudCardHeader>

        <MudCardContent>
            <div id="finish-plan-create-table">
            @if (isLoadingWorkOrder)
            {
                <MudProgressCircular Indeterminate Size="Size.Large" Class="d-flex justify-center ma-8" />
            }
            else if (workOrder != null)
            {
                <WorkOrderInfoCard WorkOrder="workOrder" />

                <!-- ===== 工具栏 ===== -->
                <div class="d-flex align-center mb-3 mt-4">
                    @if (!IsEditMode)
                    {
                        <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small"
                                   StartIcon="@Icons.Material.Filled.Add"
                                   OnClick="AddRow">
                            新增行
                        </MudButton>
                    }
                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="ml-3">
                        共 @rows.Count 条
                    </MudText>
                </div>

                <!-- ===== 表格输入 ===== -->
                @if (rows.Any())
                {
                    <div Style="border:1px solid var(--mud-palette-lines-default); border-radius:8px;" Class="mb-3">
                        <MudTable Items="@rows" Class="finish-create-table auto-table" Dense="true" Hover="true" Striped="true" Elevation="0" RowsPerPage="10" RowsPerPageLabel="每页行数:">
                            <HeaderContent>
                                <MudTh Style="width:120px;">成品类型<span class="required-star">*</span></MudTh>
                                <MudTh Style="width:120px;">工厂牌号<span class="required-star">*</span></MudTh>
                                <MudTh Style="width:120px;">规格<span class="required-star">*</span></MudTh>
                                <MudTh Style="width:120px;">外径公差</MudTh>
                                <MudTh Style="width:120px;">壁厚公差</MudTh>
                                <MudTh Style="width:120px;">长度状态</MudTh>
                                <MudTh Style="width:170px;">长度(mm)</MudTh>
                                <MudTh Style="width:120px;">交货状态</MudTh>
                                <MudTh Style="width:80px;">需用支数</MudTh>
                                <MudTh Style="width:80px;">需用重量<span class="required-star">*</span></MudTh>
                                <MudTh Style="width:80px;">投料倍率</MudTh>
                                <MudTh Style="width:120px;">要求到货日<span class="required-star">*</span></MudTh>
                                <MudTh Style="width:120px;">备注</MudTh>
                                <MudTh Style="width:60px;">操作</MudTh>
                            </HeaderContent>
                            <RowTemplate Context="item">
                                <MudTd>
                                    <MudSelect Dense="true" T="string"
                                               Value="@item.ProductType"
                                               ValueChanged="@((string v) => { item.ProductType = v; })"
                                               Size="Size.Small"
                                               Variant="Variant.Outlined"
                                               Class="my-n2" Style="width:115px;">
                                        <MudSelectItem Value="@("Order")">订单成品</MudSelectItem>
                                        <MudSelectItem Value="@("Critical")">临界成品</MudSelectItem>
                                    </MudSelect>
                                </MudTd>
                                <MudTd>
                                    <MudTextField Dense="true" T="string"
                                                  Value="@item.PlantGrade"
                                                  ValueChanged="@((string v) => { item.PlantGrade = v; })"
                                                  Size="Size.Small"
                                                  Variant="Variant.Outlined"
                                                  Class="my-n2" Style="width:115px;" />
                                </MudTd>
                                <MudTd>
                                    <MudTextField Dense="true" T="string"
                                                  Value="@item.Specification"
                                                  ValueChanged="@((string v) => { item.Specification = v; })"
                                                  Size="Size.Small"
                                                  Variant="Variant.Outlined"
                                                  Class="my-n2" Style="width:115px;" />
                                </MudTd>
                                <MudTd>
                                    <MudTextField Dense="true" T="string"
                                                  Value="@item.OdToleranceStr"
                                                  ValueChanged="@((string v) => { item.OdToleranceStr = v; })"
                                                  Size="Size.Small"
                                                  Variant="Variant.Outlined"
                                                  Class="my-n2" Style="width:115px;" />
                                </MudTd>
                                <MudTd>
                                    <MudTextField Dense="true" T="string"
                                                  Value="@item.WtToleranceStr"
                                                  ValueChanged="@((string v) => { item.WtToleranceStr = v; })"
                                                  Size="Size.Small"
                                                  Variant="Variant.Outlined"
                                                  Class="my-n2" Style="width:115px;" />
                                </MudTd>
                                <MudTd>
                                    <MudSelect Dense="true" T="string"
                                               Value="@item.LengthStatus"
                                               ValueChanged="@((string v) => { item.LengthStatus = v; })"
                                               Size="Size.Small"
                                               Variant="Variant.Outlined"
                                               Class="my-n2" Style="width:115px;">
                                        <MudSelectItem Value="@("Fixed")">定尺</MudSelectItem>
                                        <MudSelectItem Value="@("Range")">范围</MudSelectItem>
                                        <MudSelectItem Value="@("NonFixed")">非定尺</MudSelectItem>
                                    </MudSelect>
                                </MudTd>
                                <MudTd>
                                    <div class="d-flex" Style="gap:2px;">
                                        <MudNumericField Dense="true" HideSpinButtons="true" T="decimal?" Format="G29"
                                                         Value="@item.MinLength"
                                                         ValueChanged="@((decimal? v) => { item.MinLength = v; })"
                                                         Size="Size.Small"
                                                         Variant="Variant.Outlined"
                                                         Class="my-n2" Style="width:72px;" />
                                        <MudText Typo="Typo.body2" Class="my-n2 align-self-center">~</MudText>
                                        <MudNumericField Dense="true" HideSpinButtons="true" T="decimal?" Format="G29"
                                                         Value="@item.MaxLength"
                                                         ValueChanged="@((decimal? v) => { item.MaxLength = v; })"
                                                         Size="Size.Small"
                                                         Variant="Variant.Outlined"
                                                         Class="my-n2" Style="width:72px;" />
                                    </div>
                                </MudTd>
                                <MudTd>
                                    <MudSelect Dense="true" T="string"
                                               Value="@item.DeliveryState"
                                               ValueChanged="@((string v) => { item.DeliveryState = v; })"
                                               Size="Size.Small"
                                               Variant="Variant.Outlined"
                                               Class="my-n2" Style="width:115px;">
                                        <MudSelectItem Value="@("SolutionAnnealedAndPickled")">固溶酸洗</MudSelectItem>
                                        <MudSelectItem Value="@("Bright")">光亮</MudSelectItem>
                                        <MudSelectItem Value="@("Hard")">硬态</MudSelectItem>
                                    </MudSelect>
                                </MudTd>
                                <MudTd>
                                    <MudNumericField Dense="true" HideSpinButtons="true" T="int?"
                                                     Value="@item.RequiredPiece"
                                                     ValueChanged="@((int? v) => { item.RequiredPiece = v; })"
                                                     Size="Size.Small"
                                                     Variant="Variant.Outlined"
                                                     Min="0"
                                                     Class="my-n2" Style="width:75px;" />
                                </MudTd>
                                <MudTd>
                                    <MudNumericField Dense="true" HideSpinButtons="true" T="decimal" Format="G29"
                                                     Value="@item.RequiredWeight"
                                                     ValueChanged="@((decimal v) => { item.RequiredWeight = v; })"
                                                     Size="Size.Small"
                                                     Variant="Variant.Outlined"
                                                     Min="0"
                                                     Class="my-n2" Style="width:75px;" />
                                </MudTd>
                                <MudTd>
                                    <MudNumericField Dense="true" HideSpinButtons="true" T="int?"
                                                     Value="@item.InputMultiple"
                                                     ValueChanged="@((int? v) => { item.InputMultiple = v; })"
                                                     Size="Size.Small"
                                                     Variant="Variant.Outlined"
                                                     Min="1"
                                                     Class="my-n2" Style="width:75px;" />
                                </MudTd>
                                <MudTd>
                                    <MudTextField Dense="true" T="string"
                                                  Value="@item.RequiredDateStr"
                                                  ValueChanged="@((string v) => { item.RequiredDateStr = v; })"
                                                  Size="Size.Small"
                                                  Variant="Variant.Outlined"
                                                  Placeholder="yyyy-MM-dd"
                                                  Class="my-n2" Style="width:115px;" />
                                </MudTd>
                                <MudTd>
                                    <MudTextField Dense="true" T="string"
                                                  Value="@item.Remark"
                                                  ValueChanged="@((string v) => { item.Remark = v; })"
                                                  Size="Size.Small"
                                                  Variant="Variant.Outlined"
                                                  Class="my-n2" Style="width:115px;" />
                                </MudTd>
                                <MudTd>
                                    <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                                   Size="Size.Small"
                                                   Color="Color.Error"
                                                   OnClick="() => RemoveRow(item)"
                                                   Title="删除此行" />
                                </MudTd>
                            </RowTemplate>
                        </MudTable>
                    </div>

                    @if (!string.IsNullOrEmpty(validationMessage))
                    {
                        <MudText Typo="Typo.body2" Color="Color.Warning" Class="mb-2">@validationMessage</MudText>
                    }

                    <div class="d-flex justify-end mt-2">
                        <MudButton Variant="Variant.Text" OnClick="GoBack" Class="mr-2">取消</MudButton>
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Save" Loading="@isSaving">
                            保存
                        </MudButton>
                    </div>
                }
            }
            </div>
        </MudCardContent>
    </MudCard>
</MudContainer>

@code {
    [Parameter] public int WorkOrderId { get; set; }
    [Parameter] public int PlanId { get; set; }

    private bool IsEditMode => PlanId > 0;

    private WorkOrderDetailDto? workOrder;
    private bool isLoadingWorkOrder = true;
    private bool isSaving = false;
    private bool _isArrowNavSetup;
    private string validationMessage = string.Empty;

    private PurchaseFinishedPlanDto? existingPlan;
    private List<FinishPlanRow> rows = new();

    private class FinishPlanRow
    {
        public string ProductType { get; set; } = "Order";
        public string PlantGrade { get; set; } = string.Empty;
        public string Specification { get; set; } = string.Empty;
        public string OdToleranceStr { get; set; } = string.Empty;
        public string WtToleranceStr { get; set; } = string.Empty;
        public string LengthStatus { get; set; } = "Fixed";
        public decimal? MinLength { get; set; }
        public decimal? MaxLength { get; set; }
        public string DeliveryState { get; set; } = "SolutionAnnealedAndPickled";
        public int? RequiredPiece { get; set; }
        public decimal RequiredWeight { get; set; }
        public int? InputMultiple { get; set; }
        public string RequiredDateStr { get; set; } = string.Empty;
        public string? Remark { get; set; }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadWorkOrder();

        if (IsEditMode)
        {
            await LoadExistingPlan();
        }
    }

    private async Task LoadWorkOrder()
    {
        isLoadingWorkOrder = true;
        try
        {
            var woResult = await WorkOrderService.GetByIdAsync(WorkOrderId);
            if (woResult.Success && woResult.Data != null)
            {
                workOrder = woResult.Data;
                AddRowWithWorkOrderDefaults();
            }
            else
            {
                Snackbar.Add("工单不存在", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"加载工单失败: {ex.Message}", Severity.Error);
        }
        finally
        {
            isLoadingWorkOrder = false;
        }
    }

    private void AddRowWithWorkOrderDefaults()
    {
        if (workOrder == null) return;
        var row = new FinishPlanRow
        {
            PlantGrade = workOrder.PlantGrade ?? string.Empty,
            Specification = workOrder.Specification ?? string.Empty,
            OdToleranceStr = $"-{workOrder.OuterDiameterNegative:G29}/+{workOrder.OuterDiameterPositive:G29}",
            WtToleranceStr = $"-{workOrder.WallThicknessNegative:G29}/+{workOrder.WallThicknessPositive:G29}",
            LengthStatus = workOrder.LengthStatus.ToString(),
            MinLength = workOrder.MinLength,
            MaxLength = workOrder.MaxLength,
            DeliveryState = workOrder.DeliveryState.ToString(),
        };
        rows.Add(row);
    }

    private async Task LoadExistingPlan()
    {
        try
        {
            var result = await MaterialPlanService.GetFinishedPlanByIdAsync(PlanId);
            if (result.Success && result.Data != null)
            {
                existingPlan = result.Data;
                rows.Clear();

                // 公差格式转换
                var odStr = $"-{existingPlan.OuterDiameterNegative:G29}/+{existingPlan.OuterDiameterPositive:G29}";
                var wtStr = $"-{existingPlan.WallThicknessNegative:G29}/+{existingPlan.WallThicknessPositive:G29}";

                rows.Add(new FinishPlanRow
                {
                    ProductType = existingPlan.ProductType,
                    PlantGrade = existingPlan.PlantGrade,
                    Specification = existingPlan.Specification,
                    OdToleranceStr = odStr,
                    WtToleranceStr = wtStr,
                    LengthStatus = existingPlan.LengthStatus.ToString(),
                    MinLength = existingPlan.MinLength,
                    MaxLength = existingPlan.MaxLength,
                    DeliveryState = existingPlan.DeliveryState.ToString(),
                    RequiredPiece = existingPlan.RequiredPiece,
                    RequiredWeight = existingPlan.RequiredWeight,
                    InputMultiple = existingPlan.InputMultiple,
                    RequiredDateStr = existingPlan.RequiredDate?.ToString("yyyy-MM-dd") ?? string.Empty,
                    Remark = existingPlan.Remark,
                });
            }
            else
            {
                Snackbar.Add("成品采购计划不存在", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"加载成品采购计划失败: {ex.Message}", Severity.Error);
        }
    }

    private void AddRow()
    {
        if (workOrder == null) return;
        AddRowWithWorkOrderDefaults();
    }

    private void RemoveRow(FinishPlanRow item)
    {
        if (rows.Count <= 1) return;
        rows.Remove(item);
    }

    private async Task Save()
    {
        validationMessage = string.Empty;

        var errors = new List<string>();

        for (int i = 0; i < rows.Count; i++)
        {
            var row = rows[i];
            var rowErrors = new List<string>();

            if (string.IsNullOrWhiteSpace(row.ProductType))
                rowErrors.Add("成品类型不能为空");
            if (string.IsNullOrWhiteSpace(row.PlantGrade))
                rowErrors.Add("工厂牌号不能为空");
            if (string.IsNullOrWhiteSpace(row.Specification))
                rowErrors.Add("规格不能为空");
            if (row.RequiredWeight <= 0)
                rowErrors.Add("需用重量必须大于0");
            if (string.IsNullOrWhiteSpace(row.RequiredDateStr))
                rowErrors.Add("要求到货日不能为空");

            if (rowErrors.Any())
                errors.Add($"第{i + 1}行：{string.Join("；", rowErrors)}");
        }

        if (errors.Any())
        {
            validationMessage = string.Join("\n", errors);
            return;
        }

        isSaving = true;
        try
        {
            if (IsEditMode)
            {
                // 编辑模式：更新单个计划
                var row = rows.First();
                decimal odNeg = 0, odPos = 0, wtNeg = 0, wtPos = 0;
                ParseTolerance(row.OdToleranceStr, out odNeg, out odPos);
                ParseTolerance(row.WtToleranceStr, out wtNeg, out wtPos);

                DateTime? requiredDate = null;
                if (!string.IsNullOrWhiteSpace(row.RequiredDateStr) && DateTime.TryParse(row.RequiredDateStr, out var parsedDate))
                    requiredDate = parsedDate;

                var request = new CreatePurchaseFinishedPlanRequest
                {
                    WorkOrderId = WorkOrderId,
                    PlanDate = DateTime.Today,
                    ProductType = row.ProductType,
                    RequiredPiece = row.RequiredPiece,
                    RequiredWeight = row.RequiredWeight,
                    InputMultiple = row.InputMultiple,
                    RequiredDate = requiredDate,
                    Remark = row.Remark,
                    PlantGrade = row.PlantGrade,
                    Specification = row.Specification,
                    OuterDiameterNegative = odNeg,
                    OuterDiameterPositive = odPos,
                    WallThicknessNegative = wtNeg,
                    WallThicknessPositive = wtPos,
                    LengthStatus = row.LengthStatus,
                    MinLength = row.MinLength,
                    MaxLength = row.MaxLength,
                    DeliveryState = row.DeliveryState,
                };

                var updateResult = await MaterialPlanService.UpdateFinishedPlanAsync(PlanId, request);
                if (updateResult.Success)
                {
                    Snackbar.Add("更新成功", Severity.Success);
                    GoBack();
                }
                else
                {
                    errors.Add(updateResult.Message ?? "更新失败");
                }
            }
            else
            {
                // 新建模式：批量创建
                var requests = new List<CreatePurchaseFinishedPlanRequest>();
                foreach (var row in rows)
                {
                    decimal odNeg2 = 0, odPos2 = 0, wtNeg2 = 0, wtPos2 = 0;
                    ParseTolerance(row.OdToleranceStr, out odNeg2, out odPos2);
                    ParseTolerance(row.WtToleranceStr, out wtNeg2, out wtPos2);

                    DateTime? requiredDate = null;
                    if (!string.IsNullOrWhiteSpace(row.RequiredDateStr) && DateTime.TryParse(row.RequiredDateStr, out var parsedDate))
                        requiredDate = parsedDate;

                    requests.Add(new CreatePurchaseFinishedPlanRequest
                    {
                        WorkOrderId = WorkOrderId,
                        PlanDate = DateTime.Today,
                        ProductType = row.ProductType,
                        RequiredPiece = row.RequiredPiece,
                        RequiredWeight = row.RequiredWeight,
                        InputMultiple = row.InputMultiple,
                        RequiredDate = requiredDate,
                        Remark = row.Remark,
                        PlantGrade = row.PlantGrade,
                        Specification = row.Specification,
                        OuterDiameterNegative = odNeg2,
                        OuterDiameterPositive = odPos2,
                        WallThicknessNegative = wtNeg2,
                        WallThicknessPositive = wtPos2,
                        LengthStatus = row.LengthStatus,
                        MinLength = row.MinLength,
                        MaxLength = row.MaxLength,
                        DeliveryState = row.DeliveryState,
                    });
                }

                var result = await MaterialPlanService.CreateFinishedPlanBatchAsync(requests);
                if (result.Success)
                {
                    var count = result.Data?.Count ?? 0;
                    Snackbar.Add($"成功创建 {count} 条成品采购计划", Severity.Success);
                    GoBack();
                }
                else
                {
                    errors.Add(result.Message ?? "批量创建失败");
                }
            }

            if (errors.Any())
            {
                validationMessage = string.Join("\n", errors);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"保存失败: {ex.Message}", Severity.Error);
        }
        finally
        {
            isSaving = false;
        }
    }

    private static void ParseTolerance(string? str, out decimal neg, out decimal pos)
    {
        neg = 0; pos = 0;
        if (string.IsNullOrWhiteSpace(str)) return;
        // 格式: "-0.5/+0.5" 或 "-0.5/+0.5mm"
        var parts = str.Split('/', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        if (parts.Length == 2)
        {
            decimal.TryParse(parts[0].TrimStart('-'), out neg);
            decimal.TryParse(parts[1].TrimStart('+').Replace("mm", "").Trim(), out pos);
        }
    }

    private void GoBack()
    {
        Navigation.NavigateTo($"/workorders/{WorkOrderId}/material-plan");
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_isArrowNavSetup)
        {
            _isArrowNavSetup = true;
            if (!await JS.InvokeAsync<bool>("enableTableArrowNav", "#finish-plan-create-table"))
                _isArrowNavSetup = false;
        }
    }
}
