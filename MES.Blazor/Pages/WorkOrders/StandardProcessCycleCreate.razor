@page "/standard-process-cycles/create"
@using MES.Blazor.Services
@using MES.Core.DTOs
@using Microsoft.AspNetCore.Authorization
@inject StandardProcessCycleService StandardProcessCycleService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject IJSRuntime JS
@attribute [Authorize(Roles = Roles.Policies.WorkOrderWrite)]

<MudContainer MaxWidth="MaxWidth.False" Class="mt-4">
    <MudCard>
        <MudCardHeader>
            <CardHeaderContent>
                <MudText Typo="Typo.h5" Class="font-weight-bold">
                    <MudIcon Icon="@Icons.Material.Filled.Add" Class="mr-2" Color="Color.Primary" />
                    新建标准工艺生产周期
                </MudText>
            </CardHeaderContent>
            <CardHeaderActions>
                <MudButton Variant="Variant.Text" OnClick="GoBack">返回</MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAll" Loading="@isSubmitting">
                    保存
                </MudButton>
            </CardHeaderActions>
        </MudCardHeader>

        <MudCardContent>
            <div class="d-flex justify-space-between align-center mb-3">
                <MudText Typo="Typo.subtitle1">标准工艺生产周期列表</MudText>
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="AddRow">添加</MudButton>
            </div>

            <div id="standard-process-cycles-create-table">
            @if (rows.Count == 0)
            {
            }
            else
            {
                <div style="overflow-x: auto;">
                    <MudTable T="StandardProcessCycleRow" Items="@rows" Dense="true" Hover="true" Elevation="0" Class="auto-table">
                        <HeaderContent>
                            <MudTh Style="width: 50px;">行号</MudTh>
                            <MudTh Style="width: 120px;">工厂牌号<span class="required-star">*</span></MudTh>
                            <MudTh Style="width: 80px;">原料类型<span class="required-star">*</span></MudTh>
                            <MudTh Style="width: 130px;">原料规格<span class="required-star">*</span></MudTh>
                            <MudTh Style="width: 130px;">成品规格<span class="required-star">*</span></MudTh>
                            <MudTh Style="width: 120px;">交货状态<span class="required-star">*</span></MudTh>
                            <MudTh Style="width: 100px;">周期(天)<span class="required-star">*</span></MudTh>
                            <MudTh Style="width: 60px;">操作</MudTh>
                        </HeaderContent>
                        <RowTemplate Context="row">
                            <MudTd>
                                <MudText Typo="Typo.body2">@row.Sequence</MudText>
                            </MudTd>
                            <MudTd>
                                <MudTextField T="string"
                                              @bind-Value="row.PlantGrade"
                                              Dense="true"
                                              Variant="Variant.Outlined"
                                              Size="Size.Small" />
                            </MudTd>
                            <MudTd>
                                <MudTextField T="string"
                                              @bind-Value="row.RawMaterialType"
                                              Dense="true"
                                              Variant="Variant.Outlined"
                                              Size="Size.Small" />
                            </MudTd>
                            <MudTd>
                                <MudTextField T="string"
                                              @bind-Value="row.RawSpec"
                                              Dense="true"
                                              Variant="Variant.Outlined"
                                              Size="Size.Small" />
                            </MudTd>
                            <MudTd>
                                <MudTextField T="string"
                                              @bind-Value="row.ProductSpec"
                                              Dense="true"
                                              Variant="Variant.Outlined"
                                              Size="Size.Small" />
                            </MudTd>
                            <MudTd>
                                <MudTextField T="string"
                                              @bind-Value="row.DeliveryState"
                                              Dense="true"
                                              Variant="Variant.Outlined"
                                              Size="Size.Small" />
                            </MudTd>
                            <MudTd>
                                <MudNumericField T="int"
                                                 @bind-Value="row.StandardCycleDays"
                                                 Min="1"
                                                 Max="365"
                                                 Dense="true"
                                                 Variant="Variant.Outlined"
                                                 Size="Size.Small"
                                                 Style="width: 90px;"
                                                 HideSpinButtons="true" />
                            </MudTd>
                            <MudTd>
                                @if (rows.Count > 1)
                                {
                                    <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                                   Color="Color.Error"
                                                   Size="Size.Small"
                                                   OnClick="() => RemoveRow(row)" />
                                }
                            </MudTd>
                        </RowTemplate>
                    </MudTable>
                </div>
            }
            </div>
        </MudCardContent>
    </MudCard>
</MudContainer>

@code {
    private List<StandardProcessCycleRow> rows = new();
    private bool isSubmitting;
    private bool _isArrowNavSetup;

    private class StandardProcessCycleRow
    {
        public int Sequence { get; set; }
        public string PlantGrade { get; set; } = string.Empty;
        public string RawMaterialType { get; set; } = string.Empty;
        public string RawSpec { get; set; } = string.Empty;
        public string ProductSpec { get; set; } = string.Empty;
        public string DeliveryState { get; set; } = string.Empty;
        public int StandardCycleDays { get; set; }
    }

    protected override void OnInitialized()
    {
        AddRow();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_isArrowNavSetup)
        {
            _isArrowNavSetup = true;
            if (!await JS.InvokeAsync<bool>("enableTableArrowNav", "#standard-process-cycles-create-table"))
                _isArrowNavSetup = false;
        }
    }

    private void AddRow()
    {
        rows.Add(new StandardProcessCycleRow { Sequence = rows.Count + 1 });
    }

    private void RemoveRow(StandardProcessCycleRow row)
    {
        if (rows.Count <= 1) { Snackbar.Add("至少保留一条记录", Severity.Warning); return; }
        rows.Remove(row);
        for (int i = 0; i < rows.Count; i++) rows[i].Sequence = i + 1;
    }

    private async Task SaveAll()
    {
        var errors = new List<string>();
        for (int i = 0; i < rows.Count; i++)
        {
            var r = rows[i];
            var seq = i + 1;
            if (string.IsNullOrWhiteSpace(r.PlantGrade)) errors.Add($"行{seq}: 工厂牌号不能为空");
            if (string.IsNullOrWhiteSpace(r.RawMaterialType)) errors.Add($"行{seq}: 原料类型不能为空");
            if (string.IsNullOrWhiteSpace(r.RawSpec)) errors.Add($"行{seq}: 原料规格不能为空");
            if (string.IsNullOrWhiteSpace(r.ProductSpec)) errors.Add($"行{seq}: 成品规格不能为空");
            if (string.IsNullOrWhiteSpace(r.DeliveryState)) errors.Add($"行{seq}: 交货状态不能为空");
            if (r.StandardCycleDays <= 0) errors.Add($"行{seq}: 周期天数必须大于0");
        }
        if (errors.Any()) { Snackbar.Add(string.Join("；", errors), Severity.Warning); return; }

        isSubmitting = true; StateHasChanged();
        var successCount = 0;
        var failCount = 0;
        var failMessages = new List<string>();

        for (int i = 0; i < rows.Count; i++)
        {
            var r = rows[i];
            var request = new CreateStandardProcessCycleRequest
            {
                PlantGrade = r.PlantGrade,
                RawMaterialType = r.RawMaterialType,
                RawSpec = r.RawSpec,
                ProductSpec = r.ProductSpec,
                DeliveryState = r.DeliveryState,
                StandardCycleDays = r.StandardCycleDays
            };

            try
            {
                var result = await StandardProcessCycleService.CreateAsync(request);
                if (result.Success) successCount++;
                else { failCount++; failMessages.Add($"行{i + 1}: {result.Message}"); }
            }
            catch (Exception ex) { failCount++; failMessages.Add($"行{i + 1}: {ex.Message}"); }
        }

        isSubmitting = false; StateHasChanged();

        if (failCount == 0)
        {
            Snackbar.Add($"成功创建 {successCount} 条记录", Severity.Success);
            Navigation.NavigateTo("/standard-process-cycles");
        }
        else
        {
            Snackbar.Add($"成功 {successCount} 条，失败 {failCount} 条：{string.Join("；", failMessages)}", Severity.Error);
        }
    }

    private void GoBack() => Navigation.NavigateTo("/standard-process-cycles");
}
