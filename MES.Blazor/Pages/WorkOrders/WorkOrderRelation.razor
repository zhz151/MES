@page "/workorders/relation"
@using MES.Blazor.Helpers
@using MES.Blazor.Services
@using MES.Core.Enums
@using MES.Core.DTOs.Order
@using Microsoft.AspNetCore.Authorization
@inject WorkOrderService WorkOrderService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

@attribute [Authorize(Roles = Roles.Policies.WorkOrderView)]

<MudContainer MaxWidth="MaxWidth.False" Class="mt-4">
    @if (isLoading)
    {
        <MudProgressCircular Indeterminate Size="Size.Large" Class="d-flex justify-center ma-8" />
    }
    else if (hasError)
    {
        <MudPaper Class="pa-4 mb-4" Elevation="0" Style="border:1px solid var(--mud-palette-lines-default); border-radius:8px;">
            <MudText Typo="Typo.body2" Color="Color.Error"><strong>加载失败：</strong>@errorMessage</MudText>
            <div class="mt-3">
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="GoBack">返回工单列表</MudButton>
            </div>
        </MudPaper>
    }
    else if (relation == null)
    {
        <MudText Typo="Typo.body2" Color="Color.Error">未找到订单信息</MudText>
    }
    else
    {
        <MudCard>
            <MudCardHeader>
                <CardHeaderContent>
                    <MudText Typo="Typo.h5" Class="font-weight-bold">
                        <MudIcon Icon="@Icons.Material.Filled.Link" Class="mr-2" Color="Color.Primary" />
                        工单项次追溯
                    </MudText>
                </CardHeaderContent>
                <CardHeaderActions>
                    <MudButton Variant="Variant.Text" OnClick="GoBack">返回</MudButton>
                </CardHeaderActions>
            </MudCardHeader>

            <MudCardContent>
                <!-- 订单基本信息卡片（一行显示） -->
                <MudPaper Class="pa-4 mb-4 d-flex flex-wrap gap-4 align-center bg-soft-gray" Elevation="0">
                    <MudText Typo="Typo.body2"><strong>订单号：</strong>@relation.OrderNumber</MudText>
                    <MudText Typo="Typo.body2"><strong>签订日期：</strong>@relation.SignDate.ToString("yyyy-MM-dd")</MudText>
                    <MudText Typo="Typo.body2"><strong>业务员：</strong>@relation.Salesman</MudText>
                    <MudText Typo="Typo.body2"><strong>客户名称：</strong>@relation.CustomerName</MudText>
                    @if (!string.IsNullOrEmpty(relation.EndCustomer))
                    {
                        <MudText Typo="Typo.body2"><strong>最终用户：</strong>@relation.EndCustomer</MudText>
                    }
                </MudPaper>

                @if (!relation.WorkOrders.Any())
                {
                    <MudText Typo="Typo.body2" Color="Color.Secondary">该订单下没有工单。</MudText>
                }
                else
                {
                    <MudExpansionPanels>
                        @foreach (var workOrder in relation.WorkOrders)
                        {
                            <MudExpansionPanel Class="mb-4" Style="border-left: 4px solid var(--mud-palette-primary);">
                                <TitleContent>
                                    <div class="d-flex align-center" style="width: 100%;">
                                        <div style="flex: 1;">
                                            <MudText Typo="Typo.subtitle1">
                                                <MudLink Typo="Typo.subtitle1" Color="Color.Primary"
                                                         Underline="Underline.Always"
                                                         OnClick="() => NavigateToWorkOrder(workOrder.WorkOrderId)">
                                                    工单号：@workOrder.WorkOrderNo
                                                </MudLink>
                                            </MudText>
                                            <MudText Typo="Typo.body2" Color="Color.Secondary">
                                                主号：@workOrder.ProductionMainNo | 次号：@(workOrder.ProductionSubNo ?? "-")
                                            </MudText>
                                        </div>
                                        <MudChip Size="Size.Small" Color="@DisplayHelper.GetWorkOrderStatusColor((WorkOrderStatus)workOrder.Status)"
                                                  Class="ml-2">
                                            @workOrder.StatusText
                                        </MudChip>
                                    </div>
                                </TitleContent>
                                <ChildContent>
                                    <!-- 块1：通用数据（列表模式） -->
                                    <MudText Typo="Typo.subtitle2" Class="mb-2" Color="Color.Primary">通用信息</MudText>
                                    <MudPaper Class="pa-3 mb-4 bg-subtle" Elevation="0">
                                        @* 横向列表模式：字段水平排列 *@
                                        <div class="d-flex flex-wrap" style="gap: 0.5rem 2rem;">
                                            <MudText Typo="Typo.body2"><strong>钢管制造：</strong>@DisplayHelper.GetPipeManufacturingTypeText(Enum.Parse<PipeManufacturingType>(workOrder.MaterialName))</MudText>
                                            <MudText Typo="Typo.body2"><strong>标准牌号：</strong>@workOrder.StandardGrade</MudText>
                                            <MudText Typo="Typo.body2"><strong>工厂牌号：</strong>@workOrder.PlantGrade</MudText>
                                            <MudText Typo="Typo.body2"><strong>规格：</strong>@DisplayHelper.FormatSpecification(workOrder.Specification)</MudText>
                                            <MudText Typo="Typo.body2"><strong>外径公差：</strong>@DisplayHelper.FormatTolerance(workOrder.OuterDiameterNegative, workOrder.OuterDiameterPositive)</MudText>
                                            <MudText Typo="Typo.body2"><strong>壁厚公差：</strong>@DisplayHelper.FormatTolerance(workOrder.WallThicknessNegative, workOrder.WallThicknessPositive)</MudText>
                                            <MudText Typo="Typo.body2"><strong>交货日期：</strong>@workOrder.DeliveryDate.ToString("yyyy-MM-dd")</MudText>
                                            <MudText Typo="Typo.body2"><strong>交货状态：</strong>@DisplayHelper.GetDeliveryStateText(workOrder.DeliveryState)</MudText>
                                            <MudText Typo="Typo.body2"><strong>长度状态：</strong>@DisplayHelper.GetLengthStatusText(workOrder.LengthStatus)</MudText>
                                            <MudText Typo="Typo.body2"><strong>总支数：</strong>@workOrder.TotalQuantity 支</MudText>
                                            <MudText Typo="Typo.body2"><strong>总重量：</strong>@DisplayHelper.FormatDecimal(workOrder.TotalWeight) kg</MudText>
                                        </div>
                                    </MudPaper>

                                    <!-- 块2：原始订单项次（表格模式，仅展示非通用数据） -->
                                    <MudText Typo="Typo.subtitle2" Class="mb-2" Color="Color.Primary">包含的原始订单项次</MudText>

                                    @if (!workOrder.OrderItems.Any())
                                    {
                                        <MudText Typo="Typo.body2" Color="Color.Secondary">无项次明细</MudText>
                                    }
                                    else
                                    {
                                        <MudTable T="OrderItemBriefDto" Items="@workOrder.OrderItems" Dense="true" Hover="true" Elevation="0" Class="auto-table">
                                            <HeaderContent>
                                                <MudTh>项次号</MudTh>
                                                <MudTh>最小长度(mm)</MudTh>
                                                <MudTh>最大长度(mm)</MudTh>
                                                <MudTh>支数</MudTh>
                                                <MudTh>米数</MudTh>
                                                <MudTh>合同重量(kg)</MudTh>
                                                <MudTh>理算重量(kg)</MudTh>
                                            </HeaderContent>
                                            <RowTemplate>
                                                <MudTd>@context.Sequence</MudTd>
                                                <MudTd>@DisplayHelper.FormatNullableDecimal(context.MinLength)</MudTd>
                                                <MudTd>@DisplayHelper.FormatNullableDecimal(context.MaxLength)</MudTd>
                                                <MudTd>@context.Quantity</MudTd>
                                                <MudTd>@DisplayHelper.FormatNullableDecimal(context.Meters)</MudTd>
                                                <MudTd>@DisplayHelper.FormatDecimal(context.ContractWeight)</MudTd>
                                                <MudTd>@DisplayHelper.FormatDecimal(context.TheoreticalWeight)</MudTd>
                                            </RowTemplate>
                                        </MudTable>
                                    }
                                </ChildContent>
                            </MudExpansionPanel>
                        }
                    </MudExpansionPanels>
                }
            </MudCardContent>
        </MudCard>
    }
</MudContainer>

@code {
    [Parameter]
    [SupplyParameterFromQuery]
    public string? salesOrderNo { get; set; }

    private OrderWorkOrderRelationDto? relation;
    private bool isLoading = true;
    private bool hasError = false;
    private string errorMessage = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        // 从 NavigationManager 解析查询参数
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        if (!string.IsNullOrEmpty(uri.Query))
        {
            var query = System.Web.HttpUtility.ParseQueryString(uri.Query);
            if (string.IsNullOrEmpty(salesOrderNo))
                salesOrderNo = query["salesOrderNo"] ?? salesOrderNo;
        }

        await LoadData();
    }

    private async Task LoadData()
    {
        if (string.IsNullOrEmpty(salesOrderNo))
        {
            hasError = true;
            errorMessage = "订单号不能为空，请从工单列表页面重新进入。";
            isLoading = false;
            return;
        }

        isLoading = true;
        StateHasChanged();

        try
        {
            var result = await WorkOrderService.GetOrderWorkOrderRelationAsync(salesOrderNo);
            if (result.Success && result.Data != null)
            {
                relation = result.Data;
            }
            else
            {
                hasError = true;
                errorMessage = result.Message ?? "获取数据失败";
            }
        }
        catch (Exception ex)
        {
            hasError = true;
            errorMessage = $"加载失败: {ex.Message}";
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private void NavigateToWorkOrder(int workOrderId)
    {
        Navigation.NavigateTo($"/workorders/{workOrderId}");
    }

    private void GoBack()
    {
        Navigation.NavigateTo("/workorders");
    }
}
