@page "/workorders"
@using MES.Blazor.Helpers
@using MES.Blazor.Services
@using MES.Core.DTOs
@using MES.Core.Enums
@using MES.Core.Models
@using Microsoft.AspNetCore.Authorization
@using MES.Blazor.Shared
@using MES.Blazor.Components
@using MES.Blazor.Models
@using System.Text.Json
@inject WorkOrderService WorkOrderService
@inject NotificationService NotificationService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject AuthenticationStateProvider AuthProvider
@inject IDialogService DialogService
@inject IJSRuntime JS
@inject ColumnPrefsService ColumnPrefs
@inject PageStateService PageState
@attribute [Authorize(Roles = Roles.Policies.WorkOrderRead)]

<MudContainer MaxWidth="MaxWidth.False" Class="mt-4 pl-0">
    <!-- 页面顶部工具栏（铃铛图标和刷新） -->
    <div class="d-flex justify-space-between align-center mb-4">
        <MudText Typo="Typo.h5" Class="font-weight-bold">
            <MudIcon Icon="@Icons.Material.Filled.Assignment" Class="mr-2" Color="Color.Primary" />
            工单管理
        </MudText>
        <div class="d-flex align-center">
        </div>
    </div>

    <!-- 订单变更通知提醒 -->
    @if (_orderChangeNotices is { Count: > 0 })
    {
        <MudAlert Severity="Severity.Warning" Variant="Variant.Filled" Class="mb-4">
            <div class="d-flex justify-space-between align-center">
                <div>
                    @foreach (var notice in _orderChangeNotices)
                    {
                        <div>@notice.Content</div>
                    }
                </div>
                <MudButton Variant="Variant.Text" Size="Size.Small" Color="Color.Inherit" OnClick="DismissOrderChangeNotices">全部忽略</MudButton>
            </div>
        </MudAlert>
    }

    <!-- 订单删除通知提醒 -->
    @if (_orderDeletedNotices is { Count: > 0 })
    {
        <MudAlert Severity="Severity.Warning" Variant="Variant.Filled" Class="mb-4">
            <div class="d-flex justify-space-between align-center">
                <div>
                    @foreach (var notice in _orderDeletedNotices)
                    {
                        <div>@notice.Content</div>
                    }
                </div>
                <MudButton Variant="Variant.Text" Size="Size.Small" Color="Color.Inherit" OnClick="DismissOrderDeletedNotices">全部忽略</MudButton>
            </div>
        </MudAlert>
    }

    <!-- 订单已取消-工单待删除区域 -->
    @if (cancelledOrders.Any())
    {
        <MudCard Class="mb-4" Style="border-left: 4px solid var(--mud-palette-error);">
            <MudCardHeader>
                <CardHeaderContent>
                    <MudText Typo="Typo.subtitle1" Color="Color.Error">
                        <MudIcon Icon="@Icons.Material.Filled.Warning" Class="mr-2" Size="Size.Small" />
                        订单已取消-工单待删除
                    </MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">
                        以下订单已取消，但关联的工单尚未删除，请点击订单号进行软删除
                    </MudText>
                </CardHeaderContent>
            </MudCardHeader>
            <MudCardContent>
                <MudGrid>
                    @foreach (var item in cancelledOrders)
                    {
                        <MudItem xs="12" md="6" lg="4">
                            <MudPaper Class="pa-3 d-flex justify-space-between align-center" Elevation="0" Style="background-color: #fff3f3;">
                                <div>
                                    <MudText Typo="Typo.body2">
                                        <strong>订单号：</strong>
                                        <MudLink Typo="Typo.body2" Color="Color.Error" Underline="Underline.Always"
                                                 OnClick="() => SoftDeleteWorkOrder(item.WorkOrderId, item.OrderNumber)">
                                            @item.OrderNumber
                                        </MudLink>
                                    </MudText>
                                    <MudText Typo="Typo.body2">签订日期：@item.SignDate.ToString("yyyy-MM-dd")</MudText>
                                    <MudText Typo="Typo.body2">业务员：@item.Salesman</MudText>
                                    <MudText Typo="Typo.body2">客户名称：@item.CustomerName</MudText>
                                </div>
                                <MudChip Size="Size.Small" Color="Color.Error">待删除</MudChip>
                            </MudPaper>
                        </MudItem>
                    }
                </MudGrid>
            </MudCardContent>
        </MudCard>
    }

    <!-- 待生成工单区域 -->
    @if (_pendingOrders is { Count: > 0 })
    {
        <MudCard Class="mb-4" Style="border-left: 4px solid var(--mud-palette-info);">
            <MudCardHeader>
                <CardHeaderContent>
                    <MudText Typo="Typo.subtitle1" Color="Color.Info">
                        <MudIcon Icon="@Icons.Material.Filled.AddCircleOutline" Class="mr-2" Size="Size.Small" />
                        待生成工单
                    </MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">
                        以下订单已确认但尚未生成工单，请点击"生成工单"进行处理
                    </MudText>
                </CardHeaderContent>
            </MudCardHeader>
            <MudCardContent>
                <MudGrid>
                    @foreach (var item in _pendingOrders)
                    {
                        <MudItem xs="12" md="6" lg="4">
                            <MudPaper Class="pa-3 d-flex justify-space-between align-center" Elevation="0" Style="background-color: #f0f7ff;">
                                <div>
                                    <MudText Typo="Typo.body2">
                                        <strong>订单号：</strong>@item.SalesOrderNo
                                    </MudText>
                                    <MudText Typo="Typo.body2">签订日期：@item.SignDate.ToString("yyyy-MM-dd")</MudText>
                                    <MudText Typo="Typo.body2">业务员：@item.Salesman</MudText>
                                    <MudText Typo="Typo.body2">最终客户：@item.EndCustomer</MudText>
                                </div>
                                <MudButton Variant="Variant.Outlined" Size="Size.Small" Color="Color.Info"
                                           StartIcon="@Icons.Material.Filled.Add"
                                           OnClick="() => NavigateToGenerate(item.SalesOrderNo, nameof(WorkOrderStatus.NotGenerated))">
                                    生成工单
                                </MudButton>
                            </MudPaper>
                        </MudItem>
                    }
                </MudGrid>
            </MudCardContent>
        </MudCard>
    }

    <MudCard>
        <MudCardContent>
            <!-- 筛选栏 -->
            <MudGrid>
                <MudItem xs="12" md="6">
                    <MudTextField T="string"
                                  Label="模糊搜索 - 工单号/订单号/业务员/牌号/规格"
                                  Value="@_searchKeyword"
                                  ValueChanged="@OnSearchChanged"
                                  Immediate="true"
                                  DebounceInterval="500"
                                  Clearable="true"
                                  ClearButton="true"
                                  Adornment="Adornment.End"
                                  AdornmentIcon="@Icons.Material.Filled.Search" />
                </MudItem>
            </MudGrid>

            <!-- 数据表格 -->
            <div id="workorders-list-table">
            <MudTable @ref="table"
                      T="WorkOrderListItemDto"
                      ServerData="@LoadDataFromServer"
                      Dense="true"
                      Hover="true"
                      Class="mt-4 auto-table compact-table"
                      Elevation="0"
                      RowsPerPage="@_pageSize"
                      RowsPerPageLabel="每页行数:">
                <ToolBarContent>
                    <ColumnDisplaySelect Columns="_allColumns"
                                         OnColumnToggle="OnColumnToggle"
                                         OnMoveUp="MoveColumnUp"
                                         OnMoveDown="MoveColumnDown" />
                    <MudButton Variant="Variant.Text" Size="Size.Small"
                               Color="Color.Default"
                               StartIcon="@Icons.Material.Filled.RestartAlt"
                               OnClick="ResetColumnDisplay" Class="ml-2">
                        重置
                    </MudButton>
                    <MudSpacer />
                    <MudButton Variant="Variant.Outlined"
                               Size="Size.Small"
                               Color="Color.Info"
                               StartIcon="@Icons.Material.Filled.Print"
                               Disabled="@(!selectedSalesOrderNos.Any())"
                               OnClick="PrintSelected">
                        打印选中 (@selectedSalesOrderNos.Count)
                    </MudButton>
                    <MudButton Variant="Variant.Text"
                               Size="Size.Small"
                               Color="Color.Info"
                               StartIcon="@Icons.Material.Filled.Print"
                               OnClick="PrintAll">
                        打印全部
                    </MudButton>
                    <MudText Typo="Typo.body2" Class="ml-2">
                        共 @_totalCount 条记录
                    </MudText>
                </ToolBarContent>
                <HeaderContent>
                    <MudTh Style="width: 40px;">
                        <MudCheckBox T="bool" @bind-Value="_allSelected" Dense="true" />
                    </MudTh>
                    @foreach (var col in _visibleColumns)
                    {
                        <MudTh Style="@($"width:{col.Width}px")">
                            <div style="display:inline-flex; align-items:center; gap:4px;">
                                <span @onclick='() => ToggleSort(col.Key)' style="cursor:pointer" class="th-label">@col.Label @if (sortColumn == col.Key) {@(sortDescending ? " ▼" : " ▲")}</span>
                                @if (col.FilterType != null)
                                {
                                    <ExcelFilter T="WorkOrderListItemDto"
                                                 Label="@col.Label"
                                                 FieldKey="@col.Key"
                                                 FilterOptions="@(_filterContextOptions.GetValueOrDefault(col.Key))"
                                                 ActiveFilterValues="@(_columnFilters.GetValueOrDefault(col.Key))"
                                                 FilterChanged="@(args => OnColumnFilterChanged(args.fieldKey, args.selectedValues))" />

                                }
                            </div>
                        </MudTh>
                    }
                    <MudTh>操作</MudTh>
                </HeaderContent>
                <RowTemplate Context="item">
                    <MudTd Style="width: 40px;">
                        <MudCheckBox T="bool"
                                     Value="@selectedSalesOrderNos.Contains(item.SalesOrderNo)"
                                     ValueChanged="@((v) => { if(v) selectedSalesOrderNos.Add(item.SalesOrderNo); else selectedSalesOrderNos.Remove(item.SalesOrderNo); _allSelected = _pageItems.Any() && _pageItems.All(i => selectedSalesOrderNos.Contains(i.SalesOrderNo)); StateHasChanged(); })"
                                     Dense="true" />
                    </MudTd>
                    @foreach (var col in _visibleColumns)
                    {
                        <MudTd>@RenderCell(item, col)</MudTd>
                    }
                    <MudTd>
@if (item.Status == WorkOrderStatus.NotGenerated)
{
    <MudIconButton Icon="@Icons.Material.Filled.Add"
                   Color="Color.Primary"
                   Size="Size.Small"
                   Title="生成工单"
                   OnClick="() => NavigateToGenerate(item.SalesOrderNo, item.Status.ToString())" />
}
else if (item.Status == WorkOrderStatus.Confirmed)
{
    <div class="d-flex flex-nowrap" style="gap: 2px;">
        <MudIconButton Icon="@Icons.Material.Filled.Refresh"
                       Color="Color.Warning"
                       Size="Size.Small"
                       Title="重新生成"
                       OnClick="() => NavigateToRegenerate(item.SalesOrderNo, item.Status.ToString())" />
        <MudIconButton Icon="@Icons.Material.Filled.Edit"
                       Color="Color.Info"
                       Size="Size.Small"
                       Title="更新修改"
                       OnClick="() => NavigateToUpdate(item.SalesOrderNo, item.Status.ToString())" />
        @if (_isAdmin)
        {
            <MudIconButton Icon="@Icons.Material.Filled.Delete"
                           Color="Color.Error"
                           Size="Size.Small"
                           Title="删除"
                           OnClick="() => DeleteWorkOrder(item.Id, item.WorkOrderNo)" />
        }
    </div>
}
else if (item.Status == WorkOrderStatus.Pending)
{
    <div class="d-flex flex-nowrap" style="gap: 2px;">
        <MudIconButton Icon="@Icons.Material.Filled.Refresh"
                       Color="Color.Primary"
                       Size="Size.Small"
                       Title="重新生成"
                       OnClick="() => NavigateToRegenerate(item.SalesOrderNo, item.Status.ToString())" />
        <MudIconButton Icon="@Icons.Material.Filled.Edit"
                       Color="Color.Info"
                       Size="Size.Small"
                       Title="更新修改"
                       OnClick="() => NavigateToUpdate(item.SalesOrderNo, item.Status.ToString())" />
        @if (_isAdmin)
        {
            <MudIconButton Icon="@Icons.Material.Filled.Delete"
                           Color="Color.Error"
                           Size="Size.Small"
                           Title="删除"
                           OnClick="() => DeleteWorkOrder(item.Id, item.WorkOrderNo)" />
        }
    </div>
}
                    </MudTd>
                </RowTemplate>
                <FooterContent>
                    <MudTd Class="col-footer-cell"></MudTd>
                    @foreach (var col in _visibleColumns)
                    {
                        <MudTd Class="col-footer-cell"><span class="col-footer-sum">@RenderFooterCell(col)</span></MudTd>
                    }
                    <MudTd Class="col-footer-cell"></MudTd>
                </FooterContent>
                <PagerContent>
                    <MudTablePager PageSizeOptions="new int[]{10,15,25,50,100}" />
                </PagerContent>
            </MudTable>
            </div>
        </MudCardContent>
    </MudCard>
</MudContainer>
