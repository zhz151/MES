    private void NavigateToCreate(int tabType)
    {
        var path = tabType switch
        {
            1 => $"/workorders/{WorkOrderId}/material-plan/create",
            2 => $"/workorders/{WorkOrderId}/finish-plan/create",
            3 => $"/workorders/{WorkOrderId}/inventory-plan/create",
            4 => $"/workorders/{WorkOrderId}/rework-plan/create",
            5 => $"/workorders/{WorkOrderId}/piercing-plan/create",
            _ => $"/workorders/{WorkOrderId}/material-plan/create"
        };
        Navigation.NavigateTo(path);
    }

    private void NavigateToPrev()
    {
        if (!hasPrevWorkOrder || currentWorkOrderIndex <= 0) return;
        var prevId = siblingWorkOrders[currentWorkOrderIndex - 1].Id;
        Navigation.NavigateTo($"/workorders/{prevId}/material-plan");
    }

    private void NavigateToNext()
    {
        if (!hasNextWorkOrder || currentWorkOrderIndex < 0) return;
        var nextId = siblingWorkOrders[currentWorkOrderIndex + 1].Id;
        Navigation.NavigateTo($"/workorders/{nextId}/material-plan");
    }

    private void GoBack() => Navigation.NavigateTo("/material-plan-overview");

    // ===== 格式化辅助方法 =====

    private static string GetRawMaterialTypeText(string type) => DisplayHelper.GetRawMaterialTypeText(type);

    private static string GetProductTypeText(string type) => DisplayHelper.GetProductInspectionTypeText(type);

    private static string FormatTolerance(decimal neg, decimal pos)
    {
        if (neg == 0 && pos == 0) return "-";
        return $"-{neg:G29}/+{pos:G29}";
    }

    private static string FormatLengthRange(decimal? min, decimal? max)
    {
        if (min == null && max == null) return "-";
        if (min == null) return $"≤{max:G29}";
        if (max == null) return $"≥{min:G29}";
        return $"{min:G29}~{max:G29}";
    }

    private static string FormatLocation(string? area, string? rack)
    {
        if (string.IsNullOrEmpty(area) && string.IsNullOrEmpty(rack)) return "-";
        if (string.IsNullOrEmpty(area)) return rack ?? "-";
        if (string.IsNullOrEmpty(rack)) return area ?? "-";
        return $"{area}/{rack}";
    }

    private Color GetPlanStatusColor(int planStatus)
    {
        return planStatus switch
        {
            0 => Color.Info,
            1 => Color.Success,
            2 => Color.Default,
            _ => Color.Default
        };
    }

    private static Color GetStatusColor(MaterialPlanStatus status)
    {
        return status switch
        {
            MaterialPlanStatus.NotPlanned => Color.Default,
            MaterialPlanStatus.Partial => Color.Warning,
            MaterialPlanStatus.TheoreticalSatisfied => Color.Info,
            MaterialPlanStatus.Satisfied => Color.Success,
            MaterialPlanStatus.Excess => Color.Error,
            _ => Color.Default
        };
    }

    private static string GetStatusText(MaterialPlanStatus status)
    {
        return status switch
        {
            MaterialPlanStatus.NotPlanned => "未计划",
            MaterialPlanStatus.Partial => "部分",
            MaterialPlanStatus.TheoreticalSatisfied => "理论满足",
            MaterialPlanStatus.Satisfied => "满足",
            MaterialPlanStatus.Excess => "超量",
            _ => "未知"
        };
    }

