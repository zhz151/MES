@page "/workorders/{WorkOrderId:int}/material-plan"
@using MES.Blazor.Services
@using MES.Core.DTOs
@using MES.Core.Enums
@using MES.Blazor.Shared
@using MES.Blazor.Helpers
@using Microsoft.AspNetCore.Authorization
@inject MaterialPlanService MaterialPlanService
@inject WorkOrderService WorkOrderService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject IJSRuntime JS
@attribute [Authorize(Roles = "WorkOrderStaff,WorkOrderDirector,Admin")]

<MudContainer MaxWidth="MaxWidth.False" Class="mt-4">
    <MudCard>
        <MudCardHeader>
            <CardHeaderContent>
                <div class="d-flex align-center">
                    <MudIcon Icon="@Icons.Material.Filled.Assignment" Class="mr-2" Color="Color.Primary" Size="Size.Medium" />
                    <MudText Typo="Typo.h5" Class="font-weight-bold">工单用料计划</MudText>
                    @if (workOrder != null)
                    {
                        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="ml-4">工单号：@workOrder.WorkOrderNo</MudText>
                    }
                </div>
            </CardHeaderContent>
            <CardHeaderActions>
                <MudIconButton Icon="@Icons.Material.Filled.ChevronLeft"
                               Size="Size.Small"
                               Disabled="@(!hasPrevWorkOrder)"
                               OnClick="NavigateToPrev"
                               Title="上一个工单" />
                @if (siblingWorkOrders.Any())
                {
                    <MudText Typo="Typo.body2" Class="mx-1">@(currentWorkOrderIndex + 1)/@siblingWorkOrders.Count</MudText>
                }
                <MudIconButton Icon="@Icons.Material.Filled.ChevronRight"
                               Size="Size.Small"
                               Disabled="@(!hasNextWorkOrder)"
                               OnClick="NavigateToNext"
                               Title="下一个工单" />
                <MudButton Variant="Variant.Text" OnClick="GoBack">返回用料计划总览</MudButton>
            </CardHeaderActions>
        </MudCardHeader>

        <MudCardContent>
            @if (isLoading)
            {
                <MudProgressCircular Indeterminate Size="Size.Large" Class="d-flex justify-center ma-8" />
            }
            else
            {
                <!-- 工单信息 -->
                <WorkOrderInfoCard WorkOrder="workOrder" />

                <!-- 占比率概览 -->
                <div class="d-flex justify-start mb-2">
                    <MudChip Size="Size.Small" Color="Color.Primary" Class="mr-1">穿:@GetPiercingPct()</MudChip>
                    <MudChip Size="Size.Small" Color="Color.Primary" Class="mr-1">荒:@GetSemiPct()</MudChip>
                    <MudChip Size="Size.Small" Color="Color.Primary" Class="mr-1">成:@GetFinishPct()</MudChip>
                    <MudChip Size="Size.Small" Color="Color.Primary" Class="mr-1">库:@GetInvPct()</MudChip>
                    <MudChip Size="Size.Small" Color="Color.Primary">改:@GetReworkPct()</MudChip>
                </div>

                <!-- Tab页 -->
                <MudTabs Position="Position.Top" Class="mt-4">
                    <!-- Tab 1: 圆棒穿孔计划 -->
                    <MudTabPanel Text="圆棒穿孔计划" Icon="@Icons.Material.Filled.Handyman">
                        <MudPaper Class="pa-3 mb-4 d-flex justify-start" Elevation="0" Style="border:1px solid var(--mud-palette-lines-default); border-radius:8px;">
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                                       StartIcon="@Icons.Material.Filled.Add"
                                       OnClick="() => NavigateToCreate(5)">
                                新增计划
                            </MudButton>
                        </MudPaper>

                        <MudTable Items="@piercingPlans" Dense="true" Hover="true" Elevation="0" Striped="true" Class="auto-table"
                                  Style="border:1px solid var(--mud-palette-lines-default); border-radius:8px;">
                            <HeaderContent>
                                <MudTh>计划日期</MudTh>
                                <MudTh>原料类型</MudTh>
                                <MudTh>工厂牌号</MudTh>
                                <MudTh>圆棒规格</MudTh>
                                <MudTh>穿孔规格</MudTh>
                                <MudTh>需求单重(kg/支)</MudTh>
                                <MudTh>需求支数</MudTh>
                                <MudTh>需求重量(kg)</MudTh>
                                <MudTh>投料倍率</MudTh>
                                <MudTh>要求到货日</MudTh>
                                <MudTh>备注</MudTh>
                                <MudTh>操作</MudTh>
                            </HeaderContent>
                            <RowTemplate Context="plan">
                                <MudTd>@plan.PlanDate.ToString("yyyy-MM-dd")</MudTd>
                                <MudTd>@GetRawMaterialTypeText(plan.RawMaterialType)</MudTd>
                                <MudTd>@plan.PlantGrade</MudTd>
                                <MudTd>@plan.RoundBarSpec</MudTd>
                                <MudTd>@plan.PiercingSpec</MudTd>
                                <MudTd>@(plan.RequiredUnitWeight?.ToString("G29") ?? "-")</MudTd>
                                <MudTd>@(plan.RequiredPieces?.ToString() ?? "-")</MudTd>
                                <MudTd>@plan.RequiredWeight.ToString("G29")</MudTd>
                                <MudTd>@(plan.InputMultiple.ToString())</MudTd>
                                <MudTd>@plan.RequiredDate.ToString("yyyy-MM-dd")</MudTd>
                                <MudTd>@(plan.Remark ?? "-")</MudTd>
                                <MudTd>
                                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                                                   Color="Color.Warning" OnClick="() => EditPiercingPlan(plan.Id)"
                                                   Title="编辑" />
                                    <MudIconButton Icon="@Icons.Material.Filled.Print" Size="Size.Small"
                                                   Color="Color.Info" OnClick="() => PrintPiercingPlan(plan.Id)"
                                                   Title="打印采购申请单" />
                                    <MudIconButton Icon="@Icons.Material.Filled.Cancel" Size="Size.Small"
                                                   Color="Color.Error" OnClick="() => DeletePiercingPlan(plan.Id)"
                                                   Title="取消" />
                                </MudTd>
                            </RowTemplate>
                            <NoRecordsContent>
                            </NoRecordsContent>
                        </MudTable>
                    </MudTabPanel>

                    <!-- Tab 2: 荒管采购计划 -->
                    <MudTabPanel Text="荒管采购计划" Icon="@Icons.Material.Filled.Inventory2">
                        <MudPaper Class="pa-3 mb-4 d-flex justify-start" Elevation="0" Style="border:1px solid var(--mud-palette-lines-default); border-radius:8px;">
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                                       StartIcon="@Icons.Material.Filled.Add"
                                       OnClick="() => NavigateToCreate(1)">
                                新增计划
                            </MudButton>
                        </MudPaper>

                        <MudTable Items="@semiPlans" Dense="true" Hover="true" Elevation="0" Striped="true" Class="auto-table"
                                  Style="border:1px solid var(--mud-palette-lines-default); border-radius:8px;">
                            <HeaderContent>
                                <MudTh>计划日期</MudTh>
                                <MudTh>原料类型</MudTh>
                                <MudTh>工厂牌号</MudTh>
                                <MudTh>原料规格</MudTh>
                                <MudTh>需求单重(kg/支)</MudTh>
                                <MudTh>需求支数</MudTh>
                                <MudTh>需求重量(kg)</MudTh>
                                <MudTh>投料倍率</MudTh>
                                <MudTh>要求到货日</MudTh>
                                <MudTh>备注</MudTh>
                                <MudTh>操作</MudTh>
                            </HeaderContent>
                            <RowTemplate Context="plan">
                                <MudTd>@plan.PlanDate.ToString("yyyy-MM-dd")</MudTd>
                                <MudTd>@GetRawMaterialTypeText(plan.RawMaterialType)</MudTd>
                                <MudTd>@plan.PlantGrade</MudTd>
                                <MudTd>@plan.RawMaterialSpec</MudTd>
                                <MudTd>@(plan.RequiredUnitWeight?.ToString("G29") ?? "-")</MudTd>
                                <MudTd>@(plan.RequiredPieces?.ToString() ?? "-")</MudTd>
                                <MudTd>@plan.RequiredWeight.ToString("G29")</MudTd>
                                <MudTd>@(plan.InputMultiple.ToString())</MudTd>
                                <MudTd>@plan.RequiredDate.ToString("yyyy-MM-dd")</MudTd>
                                <MudTd>@(plan.Remark ?? "-")</MudTd>
                                <MudTd>
                                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                                                   Color="Color.Warning" OnClick="() => EditSemiPlan(plan.Id)"
                                                   Title="编辑" />
                                    <MudIconButton Icon="@Icons.Material.Filled.Print" Size="Size.Small"
                                                   Color="Color.Info" OnClick="() => PrintSemiPlan(plan.Id)"
                                                   Title="打印采购申请单" />
                                    <MudIconButton Icon="@Icons.Material.Filled.Cancel" Size="Size.Small"
                                                   Color="Color.Error" OnClick="() => DeleteSemiPlan(plan.Id)"
                                                   Title="取消" />
                                </MudTd>
                            </RowTemplate>
                            <NoRecordsContent>
                            </NoRecordsContent>
                        </MudTable>
                    </MudTabPanel>

                    <!-- Tab 3: 成品采购计划 -->
                    <MudTabPanel Text="成品采购计划" Icon="@Icons.Material.Filled.Checklist">
                        <MudPaper Class="pa-3 mb-4 d-flex justify-start" Elevation="0" Style="border:1px solid var(--mud-palette-lines-default); border-radius:8px;">
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                                       StartIcon="@Icons.Material.Filled.Add"
                                       OnClick="() => NavigateToCreate(2)">
                                新增计划
                            </MudButton>
                        </MudPaper>

                        <MudTable Items="@finishPlans" Dense="true" Hover="true" Elevation="0" Striped="true" Class="auto-table"
                                  Style="border:1px solid var(--mud-palette-lines-default); border-radius:8px;">
                            <HeaderContent>
                                <MudTh>计划日期</MudTh>
                                <MudTh>成品类型</MudTh>
                                <MudTh>工厂牌号</MudTh>
                                <MudTh>规格</MudTh>
                                <MudTh>外径公差</MudTh>
                                <MudTh>壁厚公差</MudTh>
                                <MudTh>长度状态</MudTh>
                                <MudTh>长度(mm)</MudTh>
                                <MudTh>交货状态</MudTh>
                                <MudTh>需用支数</MudTh>
                                <MudTh>需用重量(kg)</MudTh>
                                <MudTh>投料倍率</MudTh>
                                <MudTh>要求到货日</MudTh>
                                <MudTh>备注</MudTh>
                                <MudTh>操作</MudTh>
                            </HeaderContent>
                            <RowTemplate Context="plan">
                                <MudTd>@plan.PlanDate.ToString("yyyy-MM-dd")</MudTd>
                                <MudTd>@GetProductTypeText(plan.ProductType)</MudTd>
                                <MudTd>@plan.PlantGrade</MudTd>
                                <MudTd>@plan.Specification</MudTd>
                                <MudTd>@FormatTolerance(plan.OuterDiameterNegative, plan.OuterDiameterPositive)</MudTd>
                                <MudTd>@FormatTolerance(plan.WallThicknessNegative, plan.WallThicknessPositive)</MudTd>
                                <MudTd>@DisplayHelper.GetLengthStatusText(plan.LengthStatus)</MudTd>
                                <MudTd>@FormatLengthRange(plan.MinLength, plan.MaxLength)</MudTd>
                                <MudTd>@DisplayHelper.GetDeliveryStateText(plan.DeliveryState)</MudTd>
                                <MudTd>@(plan.RequiredPiece?.ToString() ?? "-")</MudTd>
                                <MudTd>@plan.RequiredWeight.ToString("G29")</MudTd>
                                <MudTd>@(plan.InputMultiple?.ToString() ?? "-")</MudTd>
                                <MudTd>@(plan.RequiredDate?.ToString("yyyy-MM-dd") ?? "-")</MudTd>
                                <MudTd>@(plan.Remark ?? "-")</MudTd>
                                <MudTd>
                                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                                                   Color="Color.Warning" OnClick="() => EditFinishedPlan(plan.Id)"
                                                   Title="编辑" />
                                    <MudIconButton Icon="@Icons.Material.Filled.Print" Size="Size.Small"
                                                   Color="Color.Info" OnClick="() => PrintFinishedPlan(plan.Id)"
                                                   Title="打印采购申请单" />
                                    <MudIconButton Icon="@Icons.Material.Filled.Cancel" Size="Size.Small"
                                                   Color="Color.Error" OnClick="() => DeleteFinishedPlan(plan.Id)"
                                                   Title="取消" />
                                </MudTd>
                            </RowTemplate>
                            <NoRecordsContent>
                            </NoRecordsContent>
                        </MudTable>
                    </MudTabPanel>

                    <!-- Tab 4: 库存使用计划 -->
                    <MudTabPanel Text="库存使用计划" Icon="@Icons.Material.Filled.Warehouse">
                        <MudPaper Class="pa-3 mb-4 d-flex justify-start" Elevation="0" Style="border:1px solid var(--mud-palette-lines-default); border-radius:8px;">
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                                       StartIcon="@Icons.Material.Filled.Add"
                                       OnClick="() => NavigateToCreate(3)">
                                新增计划
                            </MudButton>
                        </MudPaper>

                        <MudTable Items="@inventoryPlans" Dense="true" Hover="true" Elevation="0" Striped="true" Class="auto-table"
                                  Style="border:1px solid var(--mud-palette-lines-default); border-radius:8px;">
                            <HeaderContent>
                                <MudTh>计划日期</MudTh>
                                <MudTh>批次号</MudTh>
                                <MudTh>物料名称</MudTh>
                                <MudTh>工厂牌号</MudTh>
                                <MudTh>规格</MudTh>
                                <MudTh>使用模式</MudTh>
                                <MudTh>出库支数</MudTh>
                                <MudTh>出库重量(kg)</MudTh>
                                <MudTh>放置框架</MudTh>
                                <MudTh>操作</MudTh>
                            </HeaderContent>
                            <RowTemplate Context="plan">
                                <MudTd>@plan.PlanDate.ToString("yyyy-MM-dd")</MudTd>
                                <MudTd>@plan.BatchNo</MudTd>
                                <MudTd>@plan.MaterialType</MudTd>
                                <MudTd>@plan.PlantGrade</MudTd>
                                <MudTd>@plan.Specification</MudTd>
                                <MudTd>@(plan.UsageMode == "All" ? "全部" : "部分")</MudTd>
                                <MudTd>
                                    @if (plan.UsageMode == "All")
                                    {
                                        <span>全部(@(plan.UsedQuantity?.ToString() ?? "0")支)</span>
                                    }
                                    else
                                    {
                                        <span>@(plan.UsedQuantity?.ToString() ?? "-")支</span>
                                    }
                                </MudTd>
                                <MudTd>@plan.UsedWeight.ToString("G29")</MudTd>
                                <MudTd>@FormatLocation(plan.LocationArea, plan.LocationRack)</MudTd>
                                <MudTd>
                                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                                                   Color="Color.Warning" OnClick="() => EditInventoryPlan(plan.Id)"
                                                   Title="编辑" />
                                    <MudIconButton Icon="@Icons.Material.Filled.Print" Size="Size.Small"
                                                   Color="Color.Info" OnClick="() => PrintInventoryPlan(plan.Id)"
                                                   Title="打印" />
                                    <MudIconButton Icon="@Icons.Material.Filled.Cancel" Size="Size.Small"
                                                   Color="Color.Error" OnClick="() => DeleteInventoryPlan(plan.Id)"
                                                   Title="取消" />
                                </MudTd>
                            </RowTemplate>
                            <NoRecordsContent>
                            </NoRecordsContent>
                        </MudTable>
                    </MudTabPanel>

                    <!-- Tab 5: 库料改制计划 -->
                    <MudTabPanel Text="库料改制计划" Icon="@Icons.Material.Filled.Construction">
                        <MudPaper Class="pa-3 mb-4 d-flex justify-start" Elevation="0" Style="border:1px solid var(--mud-palette-lines-default); border-radius:8px;">
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                                       StartIcon="@Icons.Material.Filled.Add"
                                       OnClick="() => NavigateToCreate(4)">
                                新增计划
                            </MudButton>
                        </MudPaper>

                        <MudTable Items="@reworkPlans" Dense="true" Hover="true" Elevation="0" Striped="true" Class="auto-table"
                                  Style="border:1px solid var(--mud-palette-lines-default); border-radius:8px;">
                            <HeaderContent>
                                <MudTh>计划日期</MudTh>
                                <MudTh>批次号</MudTh>
                                <MudTh>物料名称</MudTh>
                                <MudTh>工厂牌号</MudTh>
                                <MudTh>规格</MudTh>
                                <MudTh>使用模式</MudTh>
                                <MudTh>出库支数</MudTh>
                                <MudTh>出库重量(kg)</MudTh>
                                <MudTh>放置框架</MudTh>
                                <MudTh>改制类型</MudTh>
                                <MudTh>操作</MudTh>
                            </HeaderContent>
                            <RowTemplate Context="plan">
                                <MudTd>@plan.PlanDate.ToString("yyyy-MM-dd")</MudTd>
                                <MudTd>@plan.BatchNo</MudTd>
                                <MudTd>@plan.MaterialType</MudTd>
                                <MudTd>@plan.PlantGrade</MudTd>
                                <MudTd>@plan.Specification</MudTd>
                                <MudTd>@(plan.UsageMode == "All" ? "全部" : "部分")</MudTd>
                                <MudTd>
                                    @if (plan.UsageMode == "All")
                                    {
                                        <span>全部(@(plan.UsedQuantity?.ToString() ?? "0")支)</span>
                                    }
                                    else
                                    {
                                        <span>@(plan.UsedQuantity?.ToString() ?? "-")支</span>
                                    }
                                </MudTd>
                                <MudTd>@plan.UsedWeight.ToString("G29")</MudTd>
                                <MudTd>@FormatLocation(plan.LocationArea, plan.LocationRack)</MudTd>
                                <MudTd>@plan.ReworkTypeText</MudTd>
                                <MudTd>
                                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                                                   Color="Color.Warning" OnClick="() => EditReworkPlan(plan.Id)"
                                                   Title="编辑" />
                                    <MudIconButton Icon="@Icons.Material.Filled.Print" Size="Size.Small"
                                                   Color="Color.Info" OnClick="() => PrintReworkPlan(plan.Id)"
                                                   Title="打印" />
                                    <MudIconButton Icon="@Icons.Material.Filled.Cancel" Size="Size.Small"
                                                   Color="Color.Error" OnClick="() => DeleteReworkPlan(plan.Id)"
                                                   Title="取消" />
                                </MudTd>
                            </RowTemplate>
                            <NoRecordsContent>
                            </NoRecordsContent>
                        </MudTable>
                    </MudTabPanel>
                </MudTabs>
            }
        </MudCardContent>
    </MudCard>
</MudContainer>

@code {
    [Parameter] public int WorkOrderId { get; set; }

    private WorkOrderDetailDto? workOrder;
    private List<WorkOrderListDto> siblingWorkOrders = new();
    private int currentWorkOrderIndex = -1;
    private bool isLoading = true;
    private bool hasPrevWorkOrder => currentWorkOrderIndex > 0;
    private bool hasNextWorkOrder => currentWorkOrderIndex >= 0 && currentWorkOrderIndex < siblingWorkOrders.Count - 1;
    private int previousWorkOrderId;

    // 原料采购计划
    private List<PurchaseSemiPlanDto> semiPlans = new();
    private WorkOrderMaterialPlanDto? semiSummary;

    // 成品采购计划
    private List<PurchaseFinishedPlanDto> finishPlans = new();
    private WorkOrderMaterialPlanDto? finishSummary;

    // 库存使用计划
    private List<InventoryPlanDto> inventoryPlans = new();
    private WorkOrderMaterialPlanDto? invSummary;

    // 库料改制计划
    private List<InventoryPlanDto> reworkPlans = new();
    private WorkOrderMaterialPlanDto? reworkSummary;

    // 圆棒穿孔计划
    private List<RoundBarPiercingPlanDto> piercingPlans = new();
    private WorkOrderMaterialPlanDto? piercingSummary;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (previousWorkOrderId != 0 && previousWorkOrderId != WorkOrderId)
        {
            await LoadData();
        }
        previousWorkOrderId = WorkOrderId;
    }

    private async Task LoadData()
    {
        isLoading = true;
        try
        {
            var woResult = await WorkOrderService.GetByIdAsync(WorkOrderId);
            if (woResult.Success && woResult.Data != null)
            {
                workOrder = woResult.Data;
                await LoadSiblingWorkOrders();
            }

            // 加载5种计划
            var tasks = new Task[]
            {
                LoadSemiPlansAsync(),
                LoadFinishPlansAsync(),
                LoadInventoryPlansAsync(),
                LoadReworkPlansAsync(),
                LoadPiercingPlansAsync()
            };
            await Task.WhenAll(tasks);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"加载失败: {ex.Message}", Severity.Error);
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task LoadSiblingWorkOrders()
    {
        if (workOrder == null || string.IsNullOrEmpty(workOrder.SalesOrderNo)) return;
        try
        {
            var result = await WorkOrderService.GetBySalesOrderNoAsync(workOrder.SalesOrderNo);
            if (result.Success && result.Data != null)
            {
                siblingWorkOrders = result.Data
                    .OrderBy(wo => wo.ProductionMainNo)
                    .ThenBy(wo => wo.ProductionSubNo)
                    .ToList();
                currentWorkOrderIndex = siblingWorkOrders.FindIndex(wo => wo.Id == WorkOrderId);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"加载同订单工单列表失败: {ex.Message}");
        }
    }

    // ===== 原料采购计划 =====

    private async Task LoadSemiPlansAsync()
    {
        var listResult = await MaterialPlanService.GetSemiPlansAsync(WorkOrderId);
        if (listResult.Success && listResult.Data != null)
            semiPlans = listResult.Data;

        var summaryResult = await MaterialPlanService.GetSummaryAsync(WorkOrderId);
        if (summaryResult.Success && summaryResult.Data != null)
            semiSummary = summaryResult.Data;
    }

    private async Task DeleteSemiPlan(int id)
    {
        var dialog = await DialogService.ShowAsync<ConfirmDialog>("确认删除", new DialogParameters
        {
            ["ContentText"] = "确定要删除该荒管采购计划吗？\n\n删除后数据将不可恢复！",
            ["ConfirmText"] = "确认删除",
            ["Color"] = Color.Error
        });
        var dialogResult = await dialog.Result;
        if (dialogResult.Canceled) return;

        try
        {
            var result = await MaterialPlanService.DeleteSemiPlanAsync(id);
            if (result.Success)
            {
                Snackbar.Add("删除成功", Severity.Success);
                await LoadSemiPlansAsync();
            }
            else
            {
                Snackbar.Add(result.Message ?? "删除失败", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"删除失败: {ex.Message}", Severity.Error);
        }
    }

    private async Task PrintSemiPlan(int planId)
    {
        try
        {
            var result = await MaterialPlanService.PrintSemiPlanAsync(planId);
            if (result.Success && !string.IsNullOrEmpty(result.Data))
                await JS.InvokeVoidAsync("openPdf", result.Data);
            else
                Snackbar.Add(result.Message ?? "打印生成失败", Severity.Error);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"打印失败: {ex.Message}", Severity.Error);
        }
    }

