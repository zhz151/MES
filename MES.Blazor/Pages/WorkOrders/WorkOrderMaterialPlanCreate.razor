@page "/workorders/{WorkOrderId:int}/material-plan/create"
@page "/workorders/{WorkOrderId:int}/material-plan/edit/{PlanId:int}"
@using MES.Blazor.Services
@using MES.Core.Enums
@using MES.Blazor.Shared
@using MES.Core.Constants
@using MES.Blazor.Helpers
@using MES.Blazor.Models
@using MES.Core.DTOs.Batch
@using MES.Core.DTOs.Materials
@using MES.Core.DTOs.WorkOrder
@using Microsoft.AspNetCore.Authorization
@inject MaterialPlanService MaterialPlanService
@inject MaterialPlanProcessGroupService ProcessGroupService
@inject WorkOrderService WorkOrderService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject IJSRuntime JS
@attribute [Authorize(Roles = Roles.Policies.WorkOrderRead)]

<MudContainer MaxWidth="MaxWidth.False" Class="mt-4">
    <MudCard>
        <MudCardHeader>
            <CardHeaderContent>
                <div class="d-flex align-center">
                    <MudIcon Icon="@Icons.Material.Filled.Inventory2" Class="mr-2" Color="Color.Primary" Size="Size.Medium" />
                    <MudText Typo="Typo.h5" Class="font-weight-bold">@(IsEditMode ? "编辑" : "新增")荒管采购计划</MudText>
                </div>
            </CardHeaderContent>
            <CardHeaderActions>
                <MudButton Variant="Variant.Text" OnClick="GoBack">返回上一级</MudButton>
            </CardHeaderActions>
        </MudCardHeader>

        <MudCardContent>
            <div id="material-plan-create-table">
            @if (isLoadingWorkOrder)
            {
                <MudProgressCircular Indeterminate Size="Size.Large" Class="d-flex justify-center ma-8" />
            }
            else if (workOrder != null)
            {
                <WorkOrderInfoCard WorkOrder="workOrder" />

                <!-- ===== 一、测算参数与结果 ===== -->
                <MudText Typo="Typo.subtitle2" Color="Color.Primary" Class="mb-2 mt-2">
                    <MudIcon Icon="@Icons.Material.Filled.Calculate" Size="Size.Small" Class="mr-1" />测算参数与结果
                </MudText>

                <div Style="border:1px solid var(--mud-palette-lines-default); border-radius:8px;" Class="mb-3">
                    <MudTable Items="@calcRows" Class="auto-table" Dense="true" Hover="true" Elevation="0" Style="table-layout:fixed;">
                        <HeaderContent>
                            <MudTh Style="width:110px;">调整成品壁厚(mm)</MudTh>
                            <MudTh Style="width:70px;">成材率(%)</MudTh>
                            <MudTh Style="width:70px;">正品率(%)</MudTh>
                            <MudTh Style="width:70px;">每支产成</MudTh>
                            <MudTh Style="width:60px;">操作</MudTh>
                            <MudTh Style="width:80px;">密度(g/cm³)</MudTh>
                            <MudTh Style="width:90px;">单米重量(kg/m)</MudTh>
                            <MudTh Style="width:90px;">成品单重(kg/支)</MudTh>
                            <MudTh Style="width:90px;">原料单重(kg/支)</MudTh>
                            <MudTh Style="width:70px;">原料支数</MudTh>
                            <MudTh Style="width:90px;">原料重量(kg)</MudTh>
                        </HeaderContent>
                        <RowTemplate Context="item">
                            <MudTd>
                                <MudNumericField Dense="true" HideSpinButtons="true" T="decimal" Format="G29"
                                                 Value="@item.AdjustedWallThickness"
                                                 ValueChanged="@((decimal v) => { item.AdjustedWallThickness = v; })"
                                                 Size="Size.Small"
                                                 Variant="Variant.Outlined"
                                                 Min="0"
                                                 Class="my-n2" Style="width:80px;" />
                            </MudTd>
                            <MudTd>
                                <MudNumericField Dense="true" HideSpinButtons="true" T="decimal" Format="G29"
                                                 Value="@item.YieldRate"
                                                 ValueChanged="@((decimal v) => { item.YieldRate = v; })"
                                                 Size="Size.Small"
                                                 Variant="Variant.Outlined"
                                                 Min="0" Max="100"
                                                 Class="my-n2" Style="width:60px;" />
                            </MudTd>
                            <MudTd>
                                <MudNumericField Dense="true" HideSpinButtons="true" T="decimal" Format="G29"
                                                 Value="@item.QualifiedRate"
                                                 ValueChanged="@((decimal v) => { item.QualifiedRate = v; })"
                                                 Size="Size.Small"
                                                 Variant="Variant.Outlined"
                                                 Min="0" Max="100"
                                                 Class="my-n2" Style="width:60px;" />
                            </MudTd>
                            <MudTd>
                                <MudNumericField Dense="true" HideSpinButtons="true" T="int"
                                                 Value="@item.InputMultiple"
                                                 ValueChanged="@((int v) => { item.InputMultiple = v; })"
                                                 Size="Size.Small"
                                                 Variant="Variant.Outlined"
                                                 Min="1"
                                                 Class="my-n2" Style="width:60px;" />
                            </MudTd>
                            <MudTd>
                                <MudButton Variant="Variant.Outlined" Color="Color.Info" Size="Size.Small"
                                           OnClick="Calculate" Class="my-n2">
                                    测算
                                </MudButton>
                            </MudTd>
                            @if (calcResult != null)
                            {
                                <MudTd>@calcResult.Density.ToString("G29")</MudTd>
                                <MudTd>@calcResult.UnitWeightPerMeter.ToString("G29")</MudTd>
                                <MudTd>@(calcResult.UnitWeight?.ToString("G29") ?? "-")</MudTd>
                                <MudTd>@(calcResult.RawUnitWeight?.ToString("G29") ?? "-")</MudTd>
                                <MudTd>@(calcResult.RequiredPieces?.ToString() ?? "-")</MudTd>
                                <MudTd>@(calcResult.RequiredWeight?.ToString("G29") ?? "-")</MudTd>
                            }
                            else
                            {
                                <MudTd>-</MudTd>
                                <MudTd>-</MudTd>
                                <MudTd>-</MudTd>
                                <MudTd>-</MudTd>
                                <MudTd>-</MudTd>
                                <MudTd>-</MudTd>
                            }
                        </RowTemplate>
                    </MudTable>
                </div>

                <!-- ===== 二、原料信息 ===== -->
                <MudText Typo="Typo.subtitle2" Color="Color.Primary" Class="mb-2 mt-2">
                    <MudIcon Icon="@Icons.Material.Filled.Inventory2" Size="Size.Small" Class="mr-1" />原料信息
                </MudText>

                <div Style="border:1px solid var(--mud-palette-lines-default); border-radius:8px;" Class="mb-3">
                    <MudTable Items="@materialRows" Class="auto-table" Dense="true" Hover="true" Striped="true" Elevation="0" Style="table-layout:fixed;">
                        <HeaderContent>
                            <MudTh Style="width:110px;">原料类型</MudTh>
                            <MudTh Style="width:90px;">工厂牌号<span class="required-star">*</span></MudTh>
                            <MudTh Style="width:100px;">原料规格<span class="required-star">*</span></MudTh>
                            <MudTh Style="width:90px;">需求单重(kg/支)</MudTh>
                            <MudTh Style="width:80px;">需求支数</MudTh>
                            <MudTh Style="width:150px;">需求重量(kg)</MudTh>
                            <MudTh Style="width:150px;">要求到货日期</MudTh>
                            <MudTh Style="width:600px;">备注</MudTh>
                        </HeaderContent>
                        <RowTemplate Context="item">
                            <MudTd>
                                <MudSelect Dense="true" T="MaterialType"
                                           Value="@item.RawMaterialType"
                                           ValueChanged="@((MaterialType v) => { item.RawMaterialType = v; })"
                                           Size="Size.Small"
                                           Variant="Variant.Outlined"
                                           Class="my-n2" Style="width:110px;">
                                    @foreach (var val in new[] { MaterialType.RoughTube, MaterialType.SemiFinished })
                                    {
                                        <MudSelectItem Value="@(val)">@DisplayHelper.GetMaterialTypeText(val)</MudSelectItem>
                                    }
                                </MudSelect>
                            </MudTd>
                            <MudTd>
                                <MudTextField Dense="true" T="string"
                                              Value="@item.PlantGrade"
                                              ValueChanged="@((string v) => { item.PlantGrade = v; })"
                                              Size="Size.Small"
                                              Variant="Variant.Outlined"
                                              Class="my-n2" Style="width:80px;" />
                            </MudTd>
                            <MudTd>
                                <MudTextField Dense="true" T="string"
                                              Value="@item.RawMaterialSpec"
                                              ValueChanged="@((string v) => { item.RawMaterialSpec = v; })"
                                              Size="Size.Small"
                                              Variant="Variant.Outlined"
                                              Class="my-n2" Style="width:90px;" />
                            </MudTd>
                            <MudTd>
                                <MudNumericField Dense="true" HideSpinButtons="true" T="decimal?" Format="G29"
                                                 Value="@item.RequiredUnitWeight"
                                                 ValueChanged="@((decimal? v) => { item.RequiredUnitWeight = v; })"
                                                 Size="Size.Small"
                                                 Variant="Variant.Outlined"
                                                 Min="0"
                                                 Class="my-n2" Style="width:80px;" />
                            </MudTd>
                            <MudTd>
                                <MudNumericField Dense="true" HideSpinButtons="true" T="int?"
                                                 Value="@item.RequiredPieces"
                                                 ValueChanged="@((int? v) => { item.RequiredPieces = v; })"
                                                 Size="Size.Small"
                                                 Variant="Variant.Outlined"
                                                 Min="0"
                                                 Disabled="@(!isNonFixedLength)"
                                                 Class="my-n2" Style="width:70px;" />
                            </MudTd>
                            <MudTd>
                                <MudNumericField Dense="true" HideSpinButtons="true" T="decimal?" Format="G29"
                                                 Value="@item.RequiredWeight"
                                                 ValueChanged="@((decimal? v) => { item.RequiredWeight = v; })"
                                                 Size="Size.Small"
                                                 Variant="Variant.Outlined"
                                                 Min="0"
                                                 Class="my-n2" Style="width:150px;" />
                            </MudTd>
                            <MudTd>
                                <MudTextField Dense="true" T="string"
                                              Value="@item.RequiredDateStr"
                                              ValueChanged="@((string v) => { item.RequiredDateStr = v; })"
                                              Size="Size.Small"
                                              Variant="Variant.Outlined"
                                              Class="my-n2" Style="width:150px;" />
                            </MudTd>
                            <MudTd>
                                <MudTextField Dense="true" T="string"
                                              Value="@item.Remark"
                                              ValueChanged="@((string v) => { item.Remark = v; })"
                                              Size="Size.Small"
                                              Variant="Variant.Outlined"
                                              Class="my-n2" Style="width:100%;" />
                            </MudTd>
                        </RowTemplate>
                    </MudTable>
                </div>

                <!-- ===== 三、工序组 ===== -->
                <MudText Typo="Typo.subtitle2" Color="Color.Primary" Class="mb-2 mt-2">
                    <MudIcon Icon="@Icons.Material.Filled.AccountTree" Size="Size.Small" Class="mr-1" />工序组
                </MudText>

                <div class="d-flex flex-wrap align-center" style="gap:8px; margin-bottom:12px; justify-content:flex-end;">
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.Add" OnClick="AddProcessGroupRow">新增工序</MudButton>
                    <ColumnDisplaySelect Columns="pgCols" ShowCommonFields="false"
                                       OnColumnToggle="OnPgColumnToggle"
                                       OnMoveUp="OnPgColumnMove"
                                       OnMoveDown="OnPgColumnMove" />
                    <MudButton Variant="Variant.Text" Size="Size.Small" Color="Color.Default"
                               StartIcon="@Icons.Material.Filled.RestartAlt" OnClick="ResetPgColumns" Class="ml-2">
                        重置
                    </MudButton>
                </div>

                <div class="table-container" style="overflow-x:auto; margin-bottom:12px;">
                    <MudTable Items="@pgItems" Dense="true" Hover="true" Elevation="0" Striped="true"
                              Class="auto-table compact-table" Style="border:1px solid var(--mud-palette-lines-default); border-radius:8px; width:max-content;">
                        <HeaderContent>
                            <MudTh Style="width:45px;">#</MudTh>
                            <MudTh Style="width:120px;">工序名称<span class="required-star">*</span></MudTh>
                            @if (GetPgCol("ManufacturingSpec").Visible) { <MudTh Style="width:100px;">制造规格<span class="required-star">*</span></MudTh> }
                            @if (GetPgCol("OuterDiameterTolerance").Visible) { <MudTh Style="width:80px;">外径公差</MudTh> }
                            @if (GetPgCol("WallThicknessTolerance").Visible) { <MudTh Style="width:80px;">壁厚公差</MudTh> }
                            @if (GetPgCol("ManufacturingLength").Visible) { <MudTh Style="width:80px;">制造长度</MudTh> }
                            @if (GetPgCol("CuttingTreatment").Visible) { <MudTh Style="width:80px;">断切处理</MudTh> }
                            @if (GetPgCol("ManufacturingMultiple").Visible) { <MudTh Style="width:80px;">制成倍数</MudTh> }
                            @if (GetPgCol("Remark").Visible) { <MudTh Style="width:120px;">备注</MudTh> }
                            @if (GetPgCol("ColdRollDraw").Visible) { <MudTh Style="width:80px;">冷轧拔</MudTh> }
                            @if (GetPgCol("OilPipeCut").Visible) { <MudTh Style="width:80px;">油管断</MudTh> }
                            @if (GetPgCol("Degrease").Visible) { <MudTh Style="width:60px;">去油</MudTh> }
                            @if (GetPgCol("EmulsionWash").Visible) { <MudTh Style="width:80px;">乳液浸洗</MudTh> }
                            @if (GetPgCol("UltrasonicWash").Visible) { <MudTh Style="width:80px;">超声浸洗</MudTh> }
                            @if (GetPgCol("ClothPolish").Visible) { <MudTh Style="width:60px;">打布</MudTh> }
                            @if (GetPgCol("BrightAnnealing").Visible) { <MudTh Style="width:60px;">光亮退火</MudTh> }
                            @if (GetPgCol("Solution").Visible) { <MudTh Style="width:60px;">固溶</MudTh> }
                            @if (GetPgCol("Straighten").Visible) { <MudTh Style="width:60px;">矫直</MudTh> }
                            @if (GetPgCol("Cut").Visible) { <MudTh Style="width:60px;">断切</MudTh> }
                            @if (GetPgCol("ThicknessMeasure").Visible) { <MudTh Style="width:60px;">测厚</MudTh> }
                            @if (GetPgCol("Pickle").Visible) { <MudTh Style="width:60px;">酸洗</MudTh> }
                            @if (GetPgCol("OuterPolish").Visible) { <MudTh Style="width:60px;">外抛光</MudTh> }
                            @if (GetPgCol("InnerPolish").Visible) { <MudTh Style="width:60px;">内抛</MudTh> }
                            @if (GetPgCol("InnerGrinding").Visible) { <MudTh Style="width:60px;">内磨</MudTh> }
                            @if (GetPgCol("OuterSpotGrinding").Visible) { <MudTh Style="width:60px;">外修磨</MudTh> }
                            @if (GetPgCol("SandBlasting").Visible) { <MudTh Style="width:60px;">喷砂</MudTh> }
                            @if (GetPgCol("ShotBlasting").Visible) { <MudTh Style="width:60px;">喷丸</MudTh> }
                            @if (GetPgCol("Inspection").Visible) { <MudTh Style="width:60px;">检验</MudTh> }
                            @if (GetPgCol("WeldingHead").Visible) { <MudTh Style="width:60px;">焊头</MudTh> }
                            @if (GetPgCol("Welding").Visible) { <MudTh Style="width:60px;">打头</MudTh> }
                            @if (GetPgCol("Lubrication").Visible) { <MudTh Style="width:60px;">润滑</MudTh> }
                            @if (GetPgCol("Packing").Visible) { <MudTh Style="width:60px;">包装</MudTh> }
                            @if (GetPgCol("Warehouse").Visible) { <MudTh Style="width:60px;">入库</MudTh> }
                            @if (GetPgCol("Extra1").Visible) { <MudTh Style="width:60px;">备用1</MudTh> }
                            @if (GetPgCol("Extra2").Visible) { <MudTh Style="width:60px;">备用2</MudTh> }
                            <MudTh Style="width:60px;">操作</MudTh>
                        </HeaderContent>
                        <RowTemplate Context="pg">
                            <MudTd Style="width:45px;">@(pgItems.IndexOf(pg) + 1)</MudTd>
                            <MudTd Style="width:120px;">
                                <MudSelect T="string" Value="@pg.ProcessName"
                                           ValueChanged="@((string v) => { pg.ProcessName = v; ApplyProcessGroupDefaults(pg); })"
                                           Dense="true" Variant="Variant.Outlined" Size="Size.Small">
                                    @foreach (var pn in ProcessNames.All)
                                    {
                                        <MudSelectItem Value="@pn" />
                                    }
                                </MudSelect>
                            </MudTd>
                            @if (GetPgCol("ManufacturingSpec").Visible) { <MudTd><MudTextField T="string" @bind-Value="pg.ManufacturingSpec" Dense="true" Variant="Variant.Outlined" Size="Size.Small" /></MudTd> }
                            @if (GetPgCol("OuterDiameterTolerance").Visible) { <MudTd><MudTextField T="string" @bind-Value="pg.OuterDiameterTolerance" Dense="true" Variant="Variant.Outlined" Size="Size.Small" /></MudTd> }
                            @if (GetPgCol("WallThicknessTolerance").Visible) { <MudTd><MudTextField T="string" @bind-Value="pg.WallThicknessTolerance" Dense="true" Variant="Variant.Outlined" Size="Size.Small" /></MudTd> }
                            @if (GetPgCol("ManufacturingLength").Visible) { <MudTd><MudTextField T="string" @bind-Value="pg.ManufacturingLength" Dense="true" Variant="Variant.Outlined" Size="Size.Small" /></MudTd> }
                            @if (GetPgCol("CuttingTreatment").Visible) { <MudTd><MudTextField T="string" @bind-Value="pg.CuttingTreatment" Dense="true" Variant="Variant.Outlined" Size="Size.Small" /></MudTd> }
                            @if (GetPgCol("ManufacturingMultiple").Visible) { <MudTd><MudNumericField T="int" @bind-Value="pg.ManufacturingMultiple" Dense="true" Variant="Variant.Outlined" Size="Size.Small" HideSpinButtons="true" Min="1" /></MudTd> }
                            @if (GetPgCol("Remark").Visible) { <MudTd><MudTextField T="string" @bind-Value="pg.Remark" Dense="true" Variant="Variant.Outlined" Size="Size.Small" /></MudTd> }
                            @if (GetPgCol("ColdRollDraw").Visible) { <MudTd><MudNumericField T="int?" @bind-Value="pg.ColdRollDraw" Dense="true" Variant="Variant.Outlined" Size="Size.Small" HideSpinButtons="true" /></MudTd> }
                            @if (GetPgCol("OilPipeCut").Visible) { <MudTd><MudNumericField T="int?" @bind-Value="pg.OilPipeCut" Dense="true" Variant="Variant.Outlined" Size="Size.Small" HideSpinButtons="true" /></MudTd> }
                            @if (GetPgCol("Degrease").Visible) { <MudTd><MudNumericField T="int?" @bind-Value="pg.Degrease" Dense="true" Variant="Variant.Outlined" Size="Size.Small" HideSpinButtons="true" /></MudTd> }
                            @if (GetPgCol("EmulsionWash").Visible) { <MudTd><MudNumericField T="int?" @bind-Value="pg.EmulsionWash" Dense="true" Variant="Variant.Outlined" Size="Size.Small" HideSpinButtons="true" /></MudTd> }
                            @if (GetPgCol("UltrasonicWash").Visible) { <MudTd><MudNumericField T="int?" @bind-Value="pg.UltrasonicWash" Dense="true" Variant="Variant.Outlined" Size="Size.Small" HideSpinButtons="true" /></MudTd> }
                            @if (GetPgCol("ClothPolish").Visible) { <MudTd><MudNumericField T="int?" @bind-Value="pg.ClothPolish" Dense="true" Variant="Variant.Outlined" Size="Size.Small" HideSpinButtons="true" /></MudTd> }
                            @if (GetPgCol("BrightAnnealing").Visible) { <MudTd><MudNumericField T="int?" @bind-Value="pg.BrightAnnealing" Dense="true" Variant="Variant.Outlined" Size="Size.Small" HideSpinButtons="true" /></MudTd> }
                            @if (GetPgCol("Solution").Visible) { <MudTd><MudNumericField T="int?" @bind-Value="pg.Solution" Dense="true" Variant="Variant.Outlined" Size="Size.Small" HideSpinButtons="true" /></MudTd> }
                            @if (GetPgCol("Straighten").Visible) { <MudTd><MudNumericField T="int?" @bind-Value="pg.Straighten" Dense="true" Variant="Variant.Outlined" Size="Size.Small" HideSpinButtons="true" /></MudTd> }
                            @if (GetPgCol("Cut").Visible) { <MudTd><MudNumericField T="int?" @bind-Value="pg.Cut" Dense="true" Variant="Variant.Outlined" Size="Size.Small" HideSpinButtons="true" /></MudTd> }
                            @if (GetPgCol("ThicknessMeasure").Visible) { <MudTd><MudNumericField T="int?" @bind-Value="pg.ThicknessMeasure" Dense="true" Variant="Variant.Outlined" Size="Size.Small" HideSpinButtons="true" /></MudTd> }
                            @if (GetPgCol("Pickle").Visible) { <MudTd><MudNumericField T="int?" @bind-Value="pg.Pickle" Dense="true" Variant="Variant.Outlined" Size="Size.Small" HideSpinButtons="true" /></MudTd> }
                            @if (GetPgCol("OuterPolish").Visible) { <MudTd><MudNumericField T="int?" @bind-Value="pg.OuterPolish" Dense="true" Variant="Variant.Outlined" Size="Size.Small" HideSpinButtons="true" /></MudTd> }
                            @if (GetPgCol("InnerPolish").Visible) { <MudTd><MudNumericField T="int?" @bind-Value="pg.InnerPolish" Dense="true" Variant="Variant.Outlined" Size="Size.Small" HideSpinButtons="true" /></MudTd> }
                            @if (GetPgCol("InnerGrinding").Visible) { <MudTd><MudNumericField T="int?" @bind-Value="pg.InnerGrinding" Dense="true" Variant="Variant.Outlined" Size="Size.Small" HideSpinButtons="true" /></MudTd> }
                            @if (GetPgCol("OuterSpotGrinding").Visible) { <MudTd><MudNumericField T="int?" @bind-Value="pg.OuterSpotGrinding" Dense="true" Variant="Variant.Outlined" Size="Size.Small" HideSpinButtons="true" /></MudTd> }
                            @if (GetPgCol("SandBlasting").Visible) { <MudTd><MudNumericField T="int?" @bind-Value="pg.SandBlasting" Dense="true" Variant="Variant.Outlined" Size="Size.Small" HideSpinButtons="true" /></MudTd> }
                            @if (GetPgCol("ShotBlasting").Visible) { <MudTd><MudNumericField T="int?" @bind-Value="pg.ShotBlasting" Dense="true" Variant="Variant.Outlined" Size="Size.Small" HideSpinButtons="true" /></MudTd> }
                            @if (GetPgCol("Inspection").Visible) { <MudTd><MudNumericField T="int?" @bind-Value="pg.Inspection" Dense="true" Variant="Variant.Outlined" Size="Size.Small" HideSpinButtons="true" /></MudTd> }
                            @if (GetPgCol("WeldingHead").Visible) { <MudTd><MudNumericField T="int?" @bind-Value="pg.WeldingHead" Dense="true" Variant="Variant.Outlined" Size="Size.Small" HideSpinButtons="true" /></MudTd> }
                            @if (GetPgCol("Welding").Visible) { <MudTd><MudNumericField T="int?" @bind-Value="pg.Welding" Dense="true" Variant="Variant.Outlined" Size="Size.Small" HideSpinButtons="true" /></MudTd> }
                            @if (GetPgCol("Lubrication").Visible) { <MudTd><MudNumericField T="int?" @bind-Value="pg.Lubrication" Dense="true" Variant="Variant.Outlined" Size="Size.Small" HideSpinButtons="true" /></MudTd> }
                            @if (GetPgCol("Packing").Visible) { <MudTd><MudNumericField T="int?" @bind-Value="pg.Packing" Dense="true" Variant="Variant.Outlined" Size="Size.Small" HideSpinButtons="true" /></MudTd> }
                            @if (GetPgCol("Warehouse").Visible) { <MudTd><MudNumericField T="int?" @bind-Value="pg.Warehouse" Dense="true" Variant="Variant.Outlined" Size="Size.Small" HideSpinButtons="true" /></MudTd> }
                            @if (GetPgCol("Extra1").Visible) { <MudTd><MudNumericField T="int?" @bind-Value="pg.Extra1" Dense="true" Variant="Variant.Outlined" Size="Size.Small" HideSpinButtons="true" /></MudTd> }
                            @if (GetPgCol("Extra2").Visible) { <MudTd><MudNumericField T="int?" @bind-Value="pg.Extra2" Dense="true" Variant="Variant.Outlined" Size="Size.Small" HideSpinButtons="true" /></MudTd> }
                            <MudTd><MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" Title="删除" OnClick="@(() => DeleteProcessGroupRow(pg))" /></MudTd>
                        </RowTemplate>
                        <NoRecordsContent>
                            <MudText Class="pa-4 text-center" Color="Color.Secondary">暂无工序组，可点击"新增工序"添加</MudText>
                        </NoRecordsContent>
                    </MudTable>
                </div>

                <!-- ===== 验证消息 ===== -->
                @if (!string.IsNullOrEmpty(validationMessage))
                {
                    <MudText Typo="Typo.body2" Color="Color.Warning" Class="mb-2 mt-2">@validationMessage</MudText>
                }

                <!-- ===== 操作按钮 ===== -->
                <div class="d-flex justify-end mt-2">
                    <MudButton Variant="Variant.Text" OnClick="GoBack" Class="mr-2">取消</MudButton>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Save" Loading="@isSaving">
                        保存
                    </MudButton>
                </div>
            }
            </div>
        </MudCardContent>
    </MudCard>
</MudContainer>

@code {
    [Parameter] public int WorkOrderId { get; set; }
    [Parameter] public int PlanId { get; set; }

    private bool IsEditMode => PlanId > 0;

    private WorkOrderDetailDto? workOrder;
    private bool isLoadingWorkOrder = true;
    private bool isSaving = false;
    private string validationMessage = string.Empty;
    private MaterialCalculateResult? calcResult;
    private bool isNonFixedLength = false;
    private PurchaseSemiPlanDto? existingPlan;

    // 工序组
    private List<SavePlanProcessGroupItem> pgItems = new();
    private List<ColumnDef> pgCols = GetProcessGroupDefaultColumns();
    private static List<ColumnDef> GetProcessGroupDefaultColumns() => new()
    {
        new() { Key = "ManufacturingSpec", Label = "制造规格", Visible = true },
        new() { Key = "OuterDiameterTolerance", Label = "外径公差", Visible = true },
        new() { Key = "WallThicknessTolerance", Label = "壁厚公差", Visible = true },
        new() { Key = "ManufacturingLength", Label = "制造长度", Visible = true },
        new() { Key = "CuttingTreatment", Label = "断切处理", Visible = true },
        new() { Key = "ManufacturingMultiple", Label = "制成倍数", Visible = true },
        new() { Key = "Remark", Label = "备注", Visible = true },
        new() { Key = "ColdRollDraw", Label = "冷轧拔", Visible = true },
        new() { Key = "OilPipeCut", Label = "油管断", Visible = true },
        new() { Key = "Degrease", Label = "去油", Visible = true },
        new() { Key = "EmulsionWash", Label = "乳液浸洗", Visible = true },
        new() { Key = "UltrasonicWash", Label = "超声浸洗", Visible = true },
        new() { Key = "ClothPolish", Label = "打布", Visible = true },
        new() { Key = "BrightAnnealing", Label = "光亮退火", Visible = true },
        new() { Key = "Solution", Label = "固溶", Visible = true },
        new() { Key = "Straighten", Label = "矫直", Visible = true },
        new() { Key = "Cut", Label = "断切", Visible = true },
        new() { Key = "ThicknessMeasure", Label = "测厚", Visible = true },
        new() { Key = "Pickle", Label = "酸洗", Visible = true },
        new() { Key = "OuterPolish", Label = "外抛光", Visible = true },
        new() { Key = "InnerPolish", Label = "内抛", Visible = true },
        new() { Key = "InnerGrinding", Label = "内磨", Visible = true },
        new() { Key = "OuterSpotGrinding", Label = "外修磨", Visible = true },
        new() { Key = "SandBlasting", Label = "喷砂", Visible = true },
        new() { Key = "ShotBlasting", Label = "喷丸", Visible = true },
        new() { Key = "Inspection", Label = "检验", Visible = true },
        new() { Key = "WeldingHead", Label = "焊头", Visible = true },
        new() { Key = "Welding", Label = "打头", Visible = true },
        new() { Key = "Lubrication", Label = "润滑", Visible = true },
        new() { Key = "Packing", Label = "包装", Visible = true },
        new() { Key = "Warehouse", Label = "仓库", Visible = true },
        new() { Key = "Extra1", Label = "备用1", Visible = false },
        new() { Key = "Extra2", Label = "备用2", Visible = false },
    };
    private ColumnDef GetPgCol(string key) => pgCols.First(c => c.Key == key);

    // 测算参数（单行）
    private List<CalcParamRow> calcRows = new();

    private class CalcParamRow
    {
        public decimal AdjustedWallThickness { get; set; }
        public decimal YieldRate { get; set; }
        public decimal QualifiedRate { get; set; }
        public int InputMultiple { get; set; } = 1;
    }

    // 原料信息（单行）
    private List<MaterialRow> materialRows = new();

    private class MaterialRow
    {
        public MaterialType RawMaterialType { get; set; } = MaterialType.RoughTube;
        public string PlantGrade { get; set; } = string.Empty;
        public string? RawMaterialSpec { get; set; }
        public decimal? RequiredUnitWeight { get; set; }
        public int? RequiredPieces { get; set; }
        public decimal? RequiredWeight { get; set; }
        public string RequiredDateStr { get; set; } = DateTime.Today.ToString("yyyy-MM-dd");
        public string? Remark { get; set; }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadWorkOrder();
        if (IsEditMode)
            await LoadExistingPlan();
    }

    private async Task LoadWorkOrder()
    {
        isLoadingWorkOrder = true;
        try
        {
            var woResult = await WorkOrderService.GetByIdAsync(WorkOrderId);
            if (woResult.Success && woResult.Data != null)
            {
                workOrder = woResult.Data;
                isNonFixedLength = workOrder.LengthStatus != LengthStatus.Fixed;

                calcRows.Add(new CalcParamRow());
                materialRows.Add(new MaterialRow
                {
                    PlantGrade = workOrder.PlantGrade ?? string.Empty
                });
            }
            else
            {
                Snackbar.Add("工单不存在", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"加载工单失败: {ex.Message}", Severity.Error);
        }
        finally
        {
            isLoadingWorkOrder = false;
        }
    }

    // ===== 测算 =====
    private async Task Calculate()
    {
        validationMessage = string.Empty;

        var row = calcRows.FirstOrDefault();
        if (row == null) return;

        if (row.AdjustedWallThickness <= 0)
        {
            validationMessage = "请输入调整成品壁厚";
            return;
        }
        if (row.YieldRate <= 0)
        {
            validationMessage = "请输入成材率";
            return;
        }
        if (row.QualifiedRate <= 0)
        {
            validationMessage = "请输入正品率";
            return;
        }

        try
        {
            var request = new MaterialCalculateRequest
            {
                WorkOrderId = WorkOrderId,
                AdjustedWallThickness = row.AdjustedWallThickness,
                YieldRate = row.YieldRate,
                InputMultiple = row.InputMultiple,
                QualifiedRate = row.QualifiedRate
            };

            var result = await MaterialPlanService.CalculateAsync(request);
            if (result.Success && result.Data != null)
            {
                calcResult = result.Data;
                Snackbar.Add("测算完成", Severity.Success);

                var firstMaterial = materialRows.FirstOrDefault();
                if (firstMaterial != null)
                {
                    firstMaterial.RequiredUnitWeight = result.Data.RawUnitWeight;
                    firstMaterial.RequiredWeight = result.Data.RequiredWeight;
                    if (!isNonFixedLength)
                    {
                        firstMaterial.RequiredPieces = result.Data.RequiredPieces;
                    }
                }
            }
            else
            {
                Snackbar.Add(result.Message ?? "测算失败", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"测算失败: {ex.Message}", Severity.Error);
        }
    }

    // ===== 保存 =====
    private async Task Save()
    {
        validationMessage = string.Empty;

        var calcRow = calcRows.FirstOrDefault();
        if (calcRow == null)
        {
            validationMessage = "测算参数不存在";
            return;
        }

        var errors = new List<string>();

        if (calcRow.AdjustedWallThickness <= 0)
            errors.Add("请输入调整成品壁厚");
        if (calcRow.YieldRate <= 0)
            errors.Add("请输入成材率");
        if (calcRow.QualifiedRate <= 0)
            errors.Add("请输入正品率");
        if (calcRow.InputMultiple < 1)
            errors.Add("原料每支产成数不能小于1");

        // 验证原料信息
        var material = materialRows.FirstOrDefault();
        if (material == null)
        {
            errors.Add("原料信息不存在");
        }
        else
        {
            // 原料类型由 MudSelect 确保始终有值，无需验证
            if (string.IsNullOrWhiteSpace(material.RawMaterialSpec))
                errors.Add("请输入原料规格");
            if (string.IsNullOrWhiteSpace(material.RequiredDateStr) || !DateTime.TryParse(material.RequiredDateStr, out _))
                errors.Add("请填写要求到货日期");
            if (material.RequiredWeight == null || material.RequiredWeight <= 0)
                errors.Add("请填写需求重量");
            if (!isNonFixedLength && (material.RequiredPieces == null || material.RequiredPieces <= 0))
                errors.Add("定尺工单需求支数为必填");
        }

        // 验证工序组
        if (pgItems.Count > 0)
        {
            for (int i = 0; i < pgItems.Count; i++)
            {
                var pg = pgItems[i];
                var rowNum = i + 1;

                if (string.IsNullOrWhiteSpace(pg.ProcessName))
                    errors.Add($"工序组第{rowNum}行：工序名称不能为空");

                if (string.IsNullOrWhiteSpace(pg.ManufacturingSpec))
                    errors.Add($"工序组第{rowNum}行：制造规格不能为空");

                if (pg.ProcessName.Contains("冷轧") || pg.ProcessName == "冷拔")
                {
                    if (pg.ColdRollDraw == null)
                        errors.Add($"工序组第{rowNum}行：工序\"{pg.ProcessName}\"的冷轧拔不能为空");
                }

                if (pg.ProcessName == "荒管处理" || pg.ProcessName == "在制修检")
                {
                    if (pg.ColdRollDraw != null)
                        errors.Add($"工序组第{rowNum}行：工序\"{pg.ProcessName}\"的冷轧拔必须为空");
                }
            }
        }

        if (errors.Any())
        {
            validationMessage = string.Join("\n", errors);
            return;
        }

        var planDate = DateTime.Today;

        DateTime.TryParse(material!.RequiredDateStr, out var requiredDate);

        isSaving = true;
        try
        {
            var request = new CreatePurchaseSemiPlanRequest
            {
                WorkOrderId = WorkOrderId,
                PlanDate = planDate,
                AdjustedWallThickness = calcRow.AdjustedWallThickness,
                YieldRate = calcRow.YieldRate,
                InputMultiple = calcRow.InputMultiple,
                QualifiedRate = calcRow.QualifiedRate,
                RawMaterialType = material!.RawMaterialType,
                PlantGrade = material.PlantGrade,
                RawMaterialSpec = material.RawMaterialSpec ?? string.Empty,
                RequiredUnitWeight = material.RequiredUnitWeight,
                RequiredPieces = material.RequiredPieces,
                RequiredWeight = material.RequiredWeight ?? 0,
                RequiredDate = requiredDate,
                Remark = material.Remark,
                ProcessGroups = pgItems
            };

            if (IsEditMode)
            {
                var result = await MaterialPlanService.UpdateSemiPlanAsync(PlanId, request);
                if (result.Success)
                {
                    Snackbar.Add("保存成功", Severity.Success);
                    GoBack();
                }
                else
                {
                    Snackbar.Add(result.Message ?? "保存失败", Severity.Error);
                }
            }
            else
            {
                var result = await MaterialPlanService.CreateSemiPlanAsync(request);
                if (result.Success)
                {
                    Snackbar.Add("创建成功", Severity.Success);
                    GoBack();
                }
                else
                {
                    Snackbar.Add(result.Message ?? "创建失败", Severity.Error);
                }
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"保存失败: {ex.Message}", Severity.Error);
        }
        finally
        {
            isSaving = false;
        }
    }

    // ===== 编辑模式：加载已有计划数据 =====
    private async Task LoadExistingPlan()
    {
        try
        {
            var planResult = await MaterialPlanService.GetSemiPlanByIdAsync(PlanId);
            if (!planResult.Success || planResult.Data == null)
            {
                Snackbar.Add("计划不存在", Severity.Error);
                GoBack();
                return;
            }

            existingPlan = planResult.Data;
            var plan = planResult.Data;

            // 填充测算参数
            calcRows.Clear();
            calcRows.Add(new CalcParamRow
            {
                AdjustedWallThickness = plan.AdjustedWallThickness,
                YieldRate = plan.YieldRate,
                InputMultiple = plan.InputMultiple,
                QualifiedRate = plan.QualifiedRate
            });

            // 如果已有测算结果则恢复显示
            if (plan.Density > 0)
            {
                calcResult = new MaterialCalculateResult
                {
                    Density = plan.Density ?? 0,
                    UnitWeightPerMeter = plan.UnitWeight ?? 0,
                    UnitWeight = plan.UnitWeight,
                    RawUnitWeight = plan.RawUnitWeight,
                    RequiredPieces = plan.RequiredPieces,
                    RequiredWeight = plan.RequiredWeight
                };
            }

            // 填充原料信息
            materialRows.Clear();
            materialRows.Add(new MaterialRow
            {
                RawMaterialType = plan.RawMaterialType,
                PlantGrade = plan.PlantGrade ?? string.Empty,
                RawMaterialSpec = plan.RawMaterialSpec,
                RequiredUnitWeight = plan.RequiredUnitWeight,
                RequiredPieces = plan.RequiredPieces,
                RequiredWeight = plan.RequiredWeight,
                RequiredDateStr = plan.RequiredDate.ToString("yyyy-MM-dd"),
                Remark = plan.Remark
            });

            // 加载工序组
            var pgResult = await ProcessGroupService.GetByPlanAsync(1, PlanId);
            if (pgResult.Success && pgResult.Data != null)
            {
                pgItems = pgResult.Data.Select(p => new SavePlanProcessGroupItem
                {
                    Id = p.Id,
                    SequenceNumber = p.SequenceNumber,
                    ProcessName = p.ProcessName,
                    ManufacturingSpec = p.ManufacturingSpec,
                    OuterDiameterTolerance = p.OuterDiameterTolerance,
                    WallThicknessTolerance = p.WallThicknessTolerance,
                    ManufacturingLength = p.ManufacturingLength,
                    CuttingTreatment = p.CuttingTreatment,
                    ManufacturingMultiple = p.ManufacturingMultiple,
                    Remark = p.Remark,
                    ColdRollDraw = p.ColdRollDraw,
                    OilPipeCut = p.OilPipeCut,
                    Degrease = p.Degrease,
                    EmulsionWash = p.EmulsionWash,
                    UltrasonicWash = p.UltrasonicWash,
                    ClothPolish = p.ClothPolish,
                    BrightAnnealing = p.BrightAnnealing,
                    Solution = p.Solution,
                    Straighten = p.Straighten,
                    Cut = p.Cut,
                    ThicknessMeasure = p.ThicknessMeasure,
                    Pickle = p.Pickle,
                    OuterPolish = p.OuterPolish,
                    InnerPolish = p.InnerPolish,
                    InnerGrinding = p.InnerGrinding,
                    OuterSpotGrinding = p.OuterSpotGrinding,
                    SandBlasting = p.SandBlasting,
                    ShotBlasting = p.ShotBlasting,
                    Inspection = p.Inspection,
                    WeldingHead = p.WeldingHead,
                    Welding = p.Welding,
                    Lubrication = p.Lubrication,
                    Packing = p.Packing,
                    Warehouse = p.Warehouse,
                    Extra1 = p.Extra1,
                    Extra2 = p.Extra2
                }).ToList();
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"加载计划数据失败: {ex.Message}", Severity.Error);
        }
    }

    private void GoBack()
    {
        Navigation.NavigateTo($"/workorders/{WorkOrderId}/material-plan");
    }

    // ===== 工序组操作 =====

    private void AddProcessGroupRow()
    {
        pgItems.Add(new SavePlanProcessGroupItem
        {
            ProcessName = "荒管处理",
            ManufacturingMultiple = 1
        });
        // 默认填充当前新增行的工段值
        ApplyProcessGroupDefaults(pgItems.Last());
    }

    private static void ApplyProcessGroupDefaults(SavePlanProcessGroupItem pg)
    {
        // 清空所有工段
        pg.ColdRollDraw = null;
        pg.OilPipeCut = null;
        pg.Degrease = null;
        pg.EmulsionWash = null;
        pg.UltrasonicWash = null;
        pg.ClothPolish = null;
        pg.BrightAnnealing = null;
        pg.Solution = null;
        pg.Straighten = null;
        pg.Cut = null;
        pg.ThicknessMeasure = null;
        pg.Pickle = null;
        pg.OuterPolish = null;
        pg.InnerPolish = null;
        pg.InnerGrinding = null;
        pg.OuterSpotGrinding = null;
        pg.SandBlasting = null;
        pg.ShotBlasting = null;
        pg.Inspection = null;
        pg.WeldingHead = null;
        pg.Welding = null;
        pg.Lubrication = null;
        pg.Packing = null;
        pg.Warehouse = null;
        pg.Extra1 = null;
        pg.Extra2 = null;

        // 根据工序名称填充默认值
        switch (pg.ProcessName)
        {
            case "荒管处理":
                pg.Straighten = 1;
                pg.Cut = 1;
                pg.Pickle = 1;
                pg.OuterPolish = 1;
                pg.OuterSpotGrinding = 1;
                pg.Inspection = 1;
                break;
            case "冷拔":
                pg.ColdRollDraw = 1;
                pg.Solution = 1;
                pg.Straighten = 1;
                pg.Cut = 1;
                pg.Pickle = 1;
                pg.Inspection = 1;
                break;
            case "60冷轧":
            case "50冷轧":
            case "30冷轧":
            case "20冷轧":
            case "三辊冷轧":
                pg.ColdRollDraw = 1;
                pg.OilPipeCut = 1;
                pg.Degrease = 1;
                pg.Solution = 1;
                pg.Straighten = 1;
                pg.Cut = 1;
                pg.Pickle = 1;
                pg.Inspection = 1;
                break;
            case "在制修检":
                pg.Solution = 1;
                pg.Straighten = 1;
                pg.Cut = 1;
                pg.Pickle = 1;
                pg.Inspection = 1;
                break;
        }
    }

    private void DeleteProcessGroupRow(SavePlanProcessGroupItem pg)
    {
        pgItems.Remove(pg);
    }

    private async Task OnPgColumnToggle(ColumnDef col)
    {
        // 列显隐仅在当前会话有效，无持久化
        await Task.CompletedTask;
    }

    private async Task OnPgColumnMove(ColumnDef col)
    {
        await Task.CompletedTask;
    }

    private void ResetPgColumns()
    {
        pgCols = GetProcessGroupDefaultColumns();
    }

    private bool _isArrowNavSetup;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_isArrowNavSetup)
        {
            _isArrowNavSetup = true;
            if (!await JS.InvokeAsync<bool>("enableTableArrowNav", "#material-plan-create-table"))
                _isArrowNavSetup = false;
        }
    }
}
