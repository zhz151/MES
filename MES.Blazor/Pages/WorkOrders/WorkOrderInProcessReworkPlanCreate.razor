@page "/workorders/{WorkOrderId:int}/in-process-rework-plan/create"
@using MES.Blazor.Services
@using MES.Core.Models
@using MES.Core.Enums
@using MES.Blazor.Shared
@using MES.Core.Constants
@using MES.Blazor.Helpers
@using MES.Blazor.Models
@using MES.Core.DTOs.WorkOrder
@using Microsoft.AspNetCore.Authorization
@inject MaterialPlanService MaterialPlanService
@inject StandardWorkDayService StandardWorkDayService
@inject ProcessDefinitionService ProcessDefinitionService
@inject WorkOrderService WorkOrderService
@inject ColumnPrefsService ColumnPrefs
@inject NavigationManager Navigation
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject IJSRuntime JS
@attribute [Authorize(Roles = Roles.Policies.WorkOrderEdit)]

<style>
    .inprocess-table table {
        table-layout: fixed;
    }
    .inprocess-table table th,
    .inprocess-table table td {
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }
</style>

<MudContainer MaxWidth="MaxWidth.False" Class="mt-4">
    <MudCard>
        <MudCardHeader>
            <CardHeaderContent>
                <div class="d-flex align-center">
                    <MudIcon Icon="@Icons.Material.Filled.Autorenew" Class="mr-2" Color="Color.Primary" Size="Size.Medium" />
                    <MudText Typo="Typo.h5" Class="font-weight-bold">新增在产改制</MudText>
                </div>
            </CardHeaderContent>
            <CardHeaderActions>
                <MudButton Variant="Variant.Text" OnClick="GoBack">返回上一级</MudButton>
            </CardHeaderActions>
        </MudCardHeader>

        <MudCardContent>
            <div id="inprocess-rework-plan-create-table">
            @if (isLoadingWorkOrder)
            {
                <MudProgressCircular Indeterminate Size="Size.Large" Class="d-flex justify-center ma-8" />
            }
            else if (workOrder != null)
            {
                <!-- ===== 工单信息 ===== -->
                <WorkOrderInfoCard WorkOrder="workOrder" />

                <!-- ===== 基本信息 ===== -->
                <MudGrid Class="mt-2 mb-4">
                    <MudItem xs="12" md="2">
                        <MudText Typo="Typo.body2" Class="mb-1">计划日期</MudText>
                        <MudTextField T="string" @bind-Value="_planDate" Placeholder="yyyy-MM-dd"
                                      Variant="Variant.Outlined" Dense="true" Size="Size.Small" />
                    </MudItem>
                    <MudItem xs="12" md="2">
                        <MudText Typo="Typo.body2" Class="mb-1">要求到位日期</MudText>
                        <MudTextField T="string" @bind-Value="_requiredDate" Placeholder="yyyy-MM-dd"
                                      Variant="Variant.Outlined" Dense="true" Size="Size.Small" />
                    </MudItem>
                    <MudItem xs="12" md="4">
                        <MudText Typo="Typo.body2" Class="mb-1">备注</MudText>
                        <MudTextField T="string" @bind-Value="_remark"
                                      Variant="Variant.Outlined" Dense="true" Size="Size.Small" />
                    </MudItem>
                </MudGrid>

                <!-- ===== 二、工序组（内联编辑） ===== -->
                <MudText Typo="Typo.subtitle2" Color="Color.Primary" Class="mb-2 mt-2">
                    <MudIcon Icon="@Icons.Material.Filled.AccountTree" Size="Size.Small" Class="mr-1" />工序组
                </MudText>

                <div class="d-flex flex-wrap align-center" style="gap:8px; margin-bottom:12px; justify-content:flex-end;">
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.Add" OnClick="AddProcessGroupRow">新增工序</MudButton>
                    <ColumnDisplaySelect Columns="pgCols" ShowCommonFields="false"
                                       OnColumnToggle="OnPgColumnToggle"
                                       OnMoveUp="OnPgColumnMove"
                                       OnMoveDown="OnPgColumnMove" />
                    <MudButton Variant="Variant.Text" Size="Size.Small" Color="Color.Default"
                               StartIcon="@Icons.Material.Filled.RestartAlt" OnClick="ResetPgColumns" Class="ml-2">
                        重置
                    </MudButton>
                </div>

                <div class="table-container" style="overflow-x:auto; margin-bottom:12px;">
                    <MudTable Items="@_pendingProcessGroups" Dense="true" Hover="true" Elevation="0" Striped="true"
                              Class="auto-table compact-table" Style="border:1px solid var(--mud-palette-lines-default); border-radius:8px; width:max-content;">
                        <HeaderContent>
                            <MudTh Style="width:45px;">#</MudTh>
                            @if (GetPgCol("ProcessName").Visible) { <MudTh Style="width:120px;">工序名称<span class="required-star">*</span></MudTh> }
                            @if (GetPgCol("ManufacturingSpec").Visible) { <MudTh Style="width:100px;">制造规格<span class="required-star">*</span></MudTh> }
                            @if (GetPgCol("OuterDiameterTolerance").Visible) { <MudTh Style="width:80px;">外径公差</MudTh> }
                            @if (GetPgCol("WallThicknessTolerance").Visible) { <MudTh Style="width:80px;">壁厚公差</MudTh> }
                            @if (GetPgCol("ManufacturingLength").Visible) { <MudTh Style="width:80px;">制造长度</MudTh> }
                            @if (GetPgCol("CuttingTreatment").Visible) { <MudTh Style="width:80px;">断切处理</MudTh> }
                            @if (GetPgCol("Remark").Visible) { <MudTh Style="width:120px;">备注</MudTh> }
                            @foreach (var sc in _sectionCols)
                            {
                                if (GetPgCol(sc.SectionKey).Visible)
                                {
                                    <MudTh Style="width:60px;">@SectionDisplayHelper.GetSectionNameText(sc.SectionKey)</MudTh>
                                }
                            }
                            <MudTh Style="width:60px;">操作</MudTh>
                        </HeaderContent>
                        <RowTemplate Context="pg">
                            <MudTd Style="width:45px;">@(_pendingProcessGroups.IndexOf(pg) + 1)</MudTd>
                            @if (GetPgCol("ProcessName").Visible)
                            {
                                <MudTd Style="width:120px;">
                                    <MudSelect T="string" Value="@pg.ProcessName"
                                               ValueChanged="@((string v) => { pg.ProcessName = v; ApplyProcessGroupDefaults(pg); })"
                                               Dense="true" Variant="Variant.Outlined" Size="Size.Small"
                                               ToStringFunc="@((string v) => ProcessDisplayHelper.GetProcessNameText(v))">
                                        @foreach (var opt in _processOptions)
                                        {
                                            <MudSelectItem Value="@opt.ProcessKey">@ProcessDisplayHelper.GetProcessNameText(opt.ProcessName)</MudSelectItem>
                                        }
                                    </MudSelect>
                                </MudTd>
                            }
                            @if (GetPgCol("ManufacturingSpec").Visible) { <MudTd><MudTextField T="string" @bind-Value="pg.ManufacturingSpec" Dense="true" Variant="Variant.Outlined" Size="Size.Small" /></MudTd> }
                            @if (GetPgCol("OuterDiameterTolerance").Visible) { <MudTd><MudTextField T="string" @bind-Value="pg.OuterDiameterTolerance" Dense="true" Variant="Variant.Outlined" Size="Size.Small" /></MudTd> }
                            @if (GetPgCol("WallThicknessTolerance").Visible) { <MudTd><MudTextField T="string" @bind-Value="pg.WallThicknessTolerance" Dense="true" Variant="Variant.Outlined" Size="Size.Small" /></MudTd> }
                            @if (GetPgCol("ManufacturingLength").Visible) { <MudTd><MudTextField T="string" @bind-Value="pg.ManufacturingLength" Dense="true" Variant="Variant.Outlined" Size="Size.Small" /></MudTd> }
                            @if (GetPgCol("CuttingTreatment").Visible) { <MudTd><MudTextField T="string" @bind-Value="pg.CuttingTreatment" Dense="true" Variant="Variant.Outlined" Size="Size.Small" /></MudTd> }
                            @if (GetPgCol("Remark").Visible) { <MudTd><MudTextField T="string" @bind-Value="pg.Remark" Dense="true" Variant="Variant.Outlined" Size="Size.Small" /></MudTd> }
                            @foreach (var sc in _sectionCols)
                            {
                                if (GetPgCol(sc.SectionKey).Visible)
                                {
                                    <MudTd>
                                        <MudNumericField T="int?" Value="@GetSectionValue(pg, sc.SectionKey)"
                                                         ValueChanged="@((int? v) => SetSectionValue(pg, sc.SectionKey, v))"
                                                         Dense="true" Variant="Variant.Outlined" Size="Size.Small" HideSpinButtons="true" />
                                    </MudTd>
                                }
                            }
                            <MudTd><MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" Title="删除" OnClick="@(() => DeleteProcessGroupRow(pg))" /></MudTd>
                        </RowTemplate>
                        <NoRecordsContent>
                            <MudText Class="pa-4 text-center" Color="Color.Secondary">暂无工序组，可点击"新增工序"添加</MudText>
                        </NoRecordsContent>
                    </MudTable>
                </div>

                <!-- ===== 三、展示可用在产批次按钮 ===== -->
                <div class="d-flex align-center mb-3">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.Search"
                               OnClick="LoadAvailableBatches"
                               Disabled="isLoadingInventory">
                        @(isLoadingInventory ? "加载中..." : "展示可用在产批次")
                    </MudButton>
                    @if (errorMessage != null)
                    {
                        <MudText Typo="Typo.body2" Color="Color.Warning" Class="ml-3">
                            @errorMessage
                        </MudText>
                    }
                </div>

                <!-- ===== 可用在产批次列表 ===== -->
                @if (availableBatches.Any())
                {
                    <MudText Typo="Typo.subtitle2" Color="Color.Primary" Class="mb-2">
                        <MudIcon Icon="@Icons.Material.Filled.Inventory" Size="Size.Small" Class="mr-1" />可用在产批次列表
                    </MudText>

                    <div class="d-flex align-center mb-2 flex-wrap" Style="gap:8px;">
                        <MudText Typo="Typo.body2" Color="Color.Primary">（已选 @SelectedBatchCount 项）</MudText>
                        <span class="flex-grow-1"></span>
                        <MudButton Variant="Variant.Text" OnClick="GoBack" Size="Size.Small">取消</MudButton>
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                                   OnClick="SavePlan" Disabled="@(SelectedBatchCount == 0)" Loading="@isSaving">
                            保存
                        </MudButton>
                    </div>

                    <div Style="border:1px solid var(--mud-palette-lines-default); border-radius:8px;" Class="mb-3">
                        <MudTable Items="@availableBatches" Class="inprocess-table auto-table" Dense="true" Hover="true" Striped="true" Elevation="0" RowsPerPage="5" RowsPerPageLabel="每页行数:">
                            <HeaderContent>
                                <MudTh Style="width:32px;">选择</MudTh>
                                <MudTh Style="width:60px;">计划日期</MudTh>
                                <MudTh Style="width:55px;">生产编号</MudTh>
                                <MudTh Style="width:40px;">挂牌号</MudTh>
                                <MudTh Style="width:50px;">工厂牌号</MudTh>
                                <MudTh Style="width:50px;">当前工序</MudTh>
                                <MudTh Style="width:50px;">当前工段</MudTh>
                                <MudTh Style="width:55px;">当前规格</MudTh>
                                <MudTh Style="width:50px;">下个工序</MudTh>
                                <MudTh Style="width:50px;">下个工段</MudTh>
                                <MudTh Style="width:55px;">下个规格</MudTh>
                                <MudTh Style="width:40px;">长度状态</MudTh>
                                <MudTh Style="width:50px;">可用支数</MudTh>
                                <MudTh Style="width:55px;">可用重量(kg)</MudTh>
                                <MudTh Style="width:60px;">已预留</MudTh>
                                <MudTh Style="width:55px; background-color: rgba(255, 152, 0, 0.08);">投料制成倍</MudTh>
                                <MudTh Style="width:55px; background-color: rgba(255, 152, 0, 0.08);">使用支数</MudTh>
                                <MudTh Style="width:55px; background-color: rgba(255, 152, 0, 0.08);">使用重量(kg)</MudTh>
                            </HeaderContent>
                            <RowTemplate>
                                <MudTd>
                                    <MudCheckBox Value="@GetSelection(context.Id)"
                                                 ValueChanged="@((bool v) => OnSelectionChanged(context.Id, v))"
                                                 Color="Color.Primary" />
                                </MudTd>
                                <MudTd DataLabel="计划日期">@DateTime.Today.ToString("yyyy-MM-dd")</MudTd>
                                <MudTd DataLabel="生产编号">@context.BatchNo</MudTd>
                                <MudTd DataLabel="挂牌号">@(context.TagNo ?? "-")</MudTd>
                                <MudTd DataLabel="工厂牌号">@context.PlantGrade</MudTd>
                                <MudTd DataLabel="当前工序">@(ProcessDisplayHelper.GetProcessNameText(context.CurrentGroupName ?? "-"))</MudTd>
                                <MudTd DataLabel="当前工段">@(string.IsNullOrEmpty(context.CurrentSectionName) ? "-" : SectionDisplayHelper.GetSectionNameText(context.CurrentSectionName))</MudTd>
                                <MudTd DataLabel="当前规格">@(context.CurrentSpec ?? "-")</MudTd>
                                <MudTd DataLabel="下个工序">@(ProcessDisplayHelper.GetProcessNameText(context.NextProcess ?? "-"))</MudTd>
                                <MudTd DataLabel="下个工段">@(string.IsNullOrEmpty(context.NextSectionName) ? "-" : SectionDisplayHelper.GetSectionNameText(context.NextSectionName))</MudTd>
                                <MudTd DataLabel="下个规格">@(context.CorrespondingSpec ?? "-")</MudTd>
                                <MudTd DataLabel="长度状态">@DisplayHelper.GetLengthStatusText(context.LengthStatus)</MudTd>
                                <MudTd DataLabel="可用支数">
                                    @GetNetValidQty(context)
                                    @if (context.ReservedQuantity > 0)
                                    {
                                        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-inline">（已预留@(context.ReservedQuantity)）</MudText>
                                    }
                                </MudTd>
                                <MudTd DataLabel="可用重量">@GetNetValidWeight(context).ToString("G29")</MudTd>
                                <MudTd DataLabel="已预留">@($"{context.ReservedQuantity}支 / {context.ReservedWeight.ToString("G29")}kg")</MudTd>
                                <MudTd DataLabel="投料制成倍" Style="background-color: rgba(255, 152, 0, 0.08);">
                                    @if (GetSelection(context.Id))
                                    {
                                        <MudNumericField Dense="true" HideSpinButtons="true" Value="@GetInputMultiple(context.Id)"
                                                         ValueChanged="@((int v) => OnInputMultipleChanged(context.Id, v))"
                                                         Size="Size.Small"
                                                         Variant="Variant.Outlined"
                                                         Min="1" Max="99"
                                                         Class="my-n2" Style="width:60px;" Format="G29" />
                                    }
                                    else
                                    {
                                        <span>@GetInputMultiple(context.Id)</span>
                                    }
                                </MudTd>
                                <MudTd DataLabel="使用支数" Style="background-color: rgba(255, 152, 0, 0.08);">
                                    @if (GetSelection(context.Id))
                                    {
                                        <MudNumericField T="int?" HideSpinButtons="true" Value="@GetUsedQuantity(context.Id)"
                                                         ValueChanged="@(v => OnUsedQuantityChanged(context.Id, v))"
                                                         Size="Size.Small"
                                                         Variant="Variant.Outlined"
                                                         Min="1" Max="@GetNetValidQty(context)"
                                                         Class="my-n2" Style="width:48px;" />
                                    }
                                    else
                                    {
                                        <span>@(GetUsedQuantity(context.Id)?.ToString() ?? "-")</span>
                                    }
                                </MudTd>
                                <MudTd DataLabel="使用重量" Style="background-color: rgba(255, 152, 0, 0.08);">
                                    @if (GetSelection(context.Id))
                                    {
                                        <MudNumericField T="decimal" HideSpinButtons="true" Value="@GetUsedWeight(context.Id)" Format="G29"
                                                         ValueChanged="@(v => OnUsedWeightChanged(context.Id, v))"
                                                         Size="Size.Small"
                                                         Variant="Variant.Outlined"
                                                         Min="0" Max="@GetNetValidWeight(context)"
                                                         Class="my-n2" Style="width:55px;" />
                                    }
                                    else
                                    {
                                        <span>@GetUsedWeight(context.Id).ToString("G29")</span>
                                    }
                                </MudTd>
                            </RowTemplate>
                        </MudTable>
                    </div>
                }
            }
            </div>
        </MudCardContent>
    </MudCard>
</MudContainer>

@code {
    [Parameter] public int WorkOrderId { get; set; }

    private WorkOrderDetailDto? workOrder;
    private List<AvailableInProcessBatchDto> availableBatches = new();
    private bool isLoadingWorkOrder = true;
    private bool isLoadingInventory = false;
    private bool isSaving = false;
    private string? errorMessage;
    private bool _isArrowNavSetup;

    // 基本信息
    private string _planDate = DateTime.Today.ToString("yyyy-MM-dd");
    private string _requiredDate = "";
    private string _remark = "";

    // 选择数据（多选）
    private Dictionary<int, bool> _selections = new();
    private Dictionary<int, int> _inputMultiples = new();
    private Dictionary<int, int?> _usedQuantities = new();
    private Dictionary<int, decimal> _usedWeights = new();
    private int SelectedBatchCount => _selections.Count(s => s.Value);

    // 工序组
    private List<SavePlanProcessGroupItem> _pendingProcessGroups = new();
    private const string PgColPrefsKey = "wo_inprocess_rework_plan_create_pg";
    private List<ColumnDef> pgCols = new();

    private async Task InitProcessGroupColumnsAsync()
    {
        await LoadSectionColsAsync();
        _processOptions = await ProcessOptionsHelper.LoadAsync(ProcessDefinitionService);

        pgCols = new List<ColumnDef>
        {
            new() { Key = "ProcessName", Label = "工序名称", Visible = true },
            new() { Key = "ManufacturingSpec", Label = "制造规格", Visible = true },
            new() { Key = "OuterDiameterTolerance", Label = "外径公差", Visible = true },
            new() { Key = "WallThicknessTolerance", Label = "壁厚公差", Visible = true },
            new() { Key = "ManufacturingLength", Label = "制造长度", Visible = true },
            new() { Key = "CuttingTreatment", Label = "断切处理", Visible = true },
            new() { Key = "Remark", Label = "备注", Visible = false },
        };

        // 工段列（从参数表加载启用工段，按 DisplayOrder 排序；失败降级为预置 26 工段）
        foreach (var sc in _sectionCols)
        {
            pgCols.Add(new ColumnDef { Key = sc.SectionKey, Label = SectionDisplayHelper.GetSectionNameText(sc.SectionKey), Visible = true });
        }

        var saved = await ColumnPrefs.LoadAsync(PgColPrefsKey, null);
        if (saved.Count > 0)
        {
            foreach (var savedCol in saved)
            {
                var match = pgCols.FirstOrDefault(c => c.Key == savedCol.Key);
                if (match != null) match.Visible = savedCol.Visible;
            }
            var ordered = new List<ColumnDef>();
            foreach (var savedCol in saved)
            {
                var match = pgCols.FirstOrDefault(c => c.Key == savedCol.Key);
                if (match != null) ordered.Add(match);
            }
            foreach (var col in pgCols)
            {
                if (!ordered.Contains(col)) ordered.Add(col);
            }
            pgCols = ordered;
        }
    }

    private ColumnDef GetPgCol(string key) =>
        pgCols.FirstOrDefault(c => c.Key == key) ?? new ColumnDef { Key = key, Label = key, Visible = true };

    // 工段列（从参数表加载启用工段，按 DisplayOrder 排序；失败降级为预置 26 工段）
    private List<SectionInfoDto> _sectionCols = new();
    private List<ProcessInfoDto> _processOptions = new();

    private async Task LoadSectionColsAsync()
    {
        var r = await StandardWorkDayService.GetEnabledSectionsAsync();
        if (r.Success && r.Data != null)
        {
            _sectionCols = r.Data;
        }
        else
        {
            _sectionCols = SectionDefs.PropertyNames
                .Select((k, i) => new SectionInfoDto
                {
                    SectionKey = k,
                    SectionName = SectionDefs.PropertyToName[k],
                    DisplayOrder = i + 1,
                    IsEnabled = true
                })
                .ToList();
        }
    }

    // 工段列值读写（SectionKey → SavePlanProcessGroupItem 属性）
    private static int? GetSectionValue(SavePlanProcessGroupItem pg, string key) => key switch
    {
        "ColdRollDraw" => pg.ColdRollDraw,
        "OilPipeCut" => pg.OilPipeCut,
        "Degrease" => pg.Degrease,
        "EmulsionWash" => pg.EmulsionWash,
        "UltrasonicWash" => pg.UltrasonicWash,
        "ClothPolish" => pg.ClothPolish,
        "BrightAnnealing" => pg.BrightAnnealing,
        "Solution" => pg.Solution,
        "Straighten" => pg.Straighten,
        "Cut" => pg.Cut,
        "ThicknessMeasure" => pg.ThicknessMeasure,
        "Pickle" => pg.Pickle,
        "OuterPolish" => pg.OuterPolish,
        "InnerPolish" => pg.InnerPolish,
        "InnerGrinding" => pg.InnerGrinding,
        "OuterSpotGrinding" => pg.OuterSpotGrinding,
        "SandBlasting" => pg.SandBlasting,
        "ShotBlasting" => pg.ShotBlasting,
        "Inspection" => pg.Inspection,
        "WeldingHead" => pg.WeldingHead,
        "Welding" => pg.Welding,
        "Lubrication" => pg.Lubrication,
        "Packing" => pg.Packing,
        "Warehouse" => pg.Warehouse,
        "Extra1" => pg.Extra1,
        "Extra2" => pg.Extra2,
        _ => null
    };

    private static void SetSectionValue(SavePlanProcessGroupItem pg, string key, int? v)
    {
        switch (key)
        {
            case "ColdRollDraw": pg.ColdRollDraw = v; break;
            case "OilPipeCut": pg.OilPipeCut = v; break;
            case "Degrease": pg.Degrease = v; break;
            case "EmulsionWash": pg.EmulsionWash = v; break;
            case "UltrasonicWash": pg.UltrasonicWash = v; break;
            case "ClothPolish": pg.ClothPolish = v; break;
            case "BrightAnnealing": pg.BrightAnnealing = v; break;
            case "Solution": pg.Solution = v; break;
            case "Straighten": pg.Straighten = v; break;
            case "Cut": pg.Cut = v; break;
            case "ThicknessMeasure": pg.ThicknessMeasure = v; break;
            case "Pickle": pg.Pickle = v; break;
            case "OuterPolish": pg.OuterPolish = v; break;
            case "InnerPolish": pg.InnerPolish = v; break;
            case "InnerGrinding": pg.InnerGrinding = v; break;
            case "OuterSpotGrinding": pg.OuterSpotGrinding = v; break;
            case "SandBlasting": pg.SandBlasting = v; break;
            case "ShotBlasting": pg.ShotBlasting = v; break;
            case "Inspection": pg.Inspection = v; break;
            case "WeldingHead": pg.WeldingHead = v; break;
            case "Welding": pg.Welding = v; break;
            case "Lubrication": pg.Lubrication = v; break;
            case "Packing": pg.Packing = v; break;
            case "Warehouse": pg.Warehouse = v; break;
            case "Extra1": pg.Extra1 = v; break;
            case "Extra2": pg.Extra2 = v; break;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await InitProcessGroupColumnsAsync();
        try
        {
            var result = await WorkOrderService.GetByIdAsync(WorkOrderId);
            workOrder = result.Success ? result.Data : null;
        }
        catch (Exception ex)
        {
            Snackbar.Add($"加载工单失败: {ex.Message}", Severity.Error);
        }
        finally
        {
            isLoadingWorkOrder = false;
        }
    }

    // ===== 工序组内联操作 =====

    private void AddProcessGroupRow()
    {
        _pendingProcessGroups.Add(new SavePlanProcessGroupItem
        {
            ProcessName = ProcessKeys.RoughTubeProcessing
        });
        ApplyProcessGroupDefaults(_pendingProcessGroups.Last());
    }

    private void DeleteProcessGroupRow(SavePlanProcessGroupItem pg)
    {
        _pendingProcessGroups.Remove(pg);
    }

    private void ApplyProcessGroupDefaults(SavePlanProcessGroupItem pg)
    {
        // 清空所有工段
        foreach (var key in SectionDefs.PropertyNames)
            SetSectionValue(pg, key, null);

        // 配置驱动：从工序配置表（ProcessDefinitions.DefaultSections）读取默认工段，新增工序/改默认工段无需改代码
        var opt = _processOptions.FirstOrDefault(o => string.Equals(o.ProcessKey, pg.ProcessName, StringComparison.OrdinalIgnoreCase));
        if (opt?.DefaultSections is { Count: > 0 })
        {
            foreach (var key in opt.DefaultSections)
                SetSectionValue(pg, key, 1);
        }
    }

    private async Task OnPgColumnToggle(ColumnDef col) =>
        await ColumnPrefs.SaveAsync(PgColPrefsKey, null, pgCols);

    private async Task OnPgColumnMove(ColumnDef col) =>
        await ColumnPrefs.SaveAsync(PgColPrefsKey, null, pgCols);

    private async Task ResetPgColumns()
    {
        foreach (var col in pgCols) col.Visible = true;
        await ColumnPrefs.SaveAsync(PgColPrefsKey, null, pgCols);
        Snackbar.Add("已重置工序组列显示", Severity.Normal);
    }

    private async Task LoadAvailableBatches()
    {
        isLoadingInventory = true;
        errorMessage = null;
        StateHasChanged();

        try
        {
            var result = await MaterialPlanService.GetAvailableInProcessBatchesAsync(WorkOrderId);
            if (result.Success)
            {
                availableBatches = (result.Data ?? new()).ToList();
                InitSelections();
                if (availableBatches.Count == 0)
                {
                    errorMessage = "未找到符合条件的在产批次";
                }
            }
            else
            {
                errorMessage = result.Message ?? "查询可用在产批次失败";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"加载失败: {ex.Message}";
        }
        finally
        {
            isLoadingInventory = false;
            StateHasChanged();
        }
    }

    private void InitSelections()
    {
        _selections.Clear();
        _inputMultiples.Clear();
        _usedQuantities.Clear();
        _usedWeights.Clear();
        foreach (var batch in availableBatches)
        {
            _selections[batch.Id] = false;
            _inputMultiples[batch.Id] = 1;
            _usedQuantities[batch.Id] = GetNetValidQty(batch);
            _usedWeights[batch.Id] = GetNetValidWeight(batch);
        }
    }

    private bool GetSelection(int batchId) => _selections.GetValueOrDefault(batchId, false);
    private int GetInputMultiple(int batchId) => _inputMultiples.GetValueOrDefault(batchId, 1);
    private int? GetUsedQuantity(int batchId) => _usedQuantities.GetValueOrDefault(batchId);
    private decimal GetUsedWeight(int batchId) => _usedWeights.GetValueOrDefault(batchId);

    // 净可用 = 有效量 − 其他未取消计划已预留（跨工单可部分预留共享）
    private static int GetNetValidQty(AvailableInProcessBatchDto b) => Math.Max(0, (b.CurrentValidQty ?? 0) - b.ReservedQuantity);
    private static decimal GetNetValidWeight(AvailableInProcessBatchDto b) => Math.Max(0m, (b.CurrentValidWeight ?? 0m) - b.ReservedWeight);

    private void OnSelectionChanged(int batchId, bool value)
    {
        if (_selections.ContainsKey(batchId))
            _selections[batchId] = value;
    }

    private void OnInputMultipleChanged(int batchId, int value)
    {
        if (_inputMultiples.ContainsKey(batchId))
            _inputMultiples[batchId] = value;
    }

    private void OnUsedQuantityChanged(int batchId, int? value)
    {
        if (_usedQuantities.ContainsKey(batchId))
            _usedQuantities[batchId] = value;
    }

    private void OnUsedWeightChanged(int batchId, decimal value)
    {
        if (_usedWeights.ContainsKey(batchId))
            _usedWeights[batchId] = value;
    }

    private void GoBack() => Navigation.NavigateTo($"/workorders/{WorkOrderId}/material-plan");

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_isArrowNavSetup)
        {
            _isArrowNavSetup = true;
            if (!await JS.InvokeAsync<bool>("enableTableArrowNav", "#inprocess-rework-plan-create-table"))
                _isArrowNavSetup = false;
        }
    }

    private async Task SavePlan()
    {
        var selectedIds = _selections.Where(s => s.Value).Select(s => s.Key).ToList();
        if (selectedIds.Count == 0)
        {
            Snackbar.Add("请至少选择一个在产批次", Severity.Warning);
            return;
        }

        // 在产改制必须填写工序组（无工序组不可提交，工量需工序组内算）
        if (_pendingProcessGroups.Count == 0)
        {
            Snackbar.Add("请先添加工序组", Severity.Warning);
            return;
        }

        // 前端验证
        var errors = new List<string>();

        if (string.IsNullOrWhiteSpace(_planDate) || !DateTime.TryParse(_planDate, out _))
            errors.Add("计划日期格式无效，请使用 yyyy-MM-dd 格式");

        foreach (var batchId in selectedIds)
        {
            var batch = availableBatches.FirstOrDefault(b => b.Id == batchId);
            if (batch == null) continue;

            var qty = _usedQuantities.GetValueOrDefault(batchId);
            var wt = _usedWeights.GetValueOrDefault(batchId);

            if (qty == null || qty <= 0)
                errors.Add($"批次 {batch.BatchNo}：使用支数必须大于0");
            if (wt <= 0)
                errors.Add($"批次 {batch.BatchNo}：使用重量必须大于0");
            var availQty = GetNetValidQty(batch);
            var availWt = GetNetValidWeight(batch);
            if (qty > availQty)
                errors.Add($"批次 {batch.BatchNo}：使用支数({qty})超过可用支数({availQty})");
            if (wt > availWt)
                errors.Add($"批次 {batch.BatchNo}：使用重量({wt})超过可用重量({availWt.ToString("G29")})");
        }

        if (errors.Any())
        {
            foreach (var err in errors)
                Snackbar.Add(err, Severity.Warning);
            return;
        }

        isSaving = true;
        StateHasChanged();

        try
        {
            var successCount = 0;
            foreach (var batchId in selectedIds)
            {
                var batch = availableBatches.FirstOrDefault(b => b.Id == batchId);
                if (batch == null) continue;

                DateTime planDate = DateTime.Today;
                if (!string.IsNullOrWhiteSpace(_planDate) && DateTime.TryParse(_planDate, out var parsedPlanDate))
                    planDate = parsedPlanDate;

                DateTime? requiredDate = null;
                if (!string.IsNullOrWhiteSpace(_requiredDate) && DateTime.TryParse(_requiredDate, out var parsedReqDate))
                    requiredDate = parsedReqDate;

                var request = new CreateInProcessReworkPlanRequest
                {
                    WorkOrderId = WorkOrderId,
                    PlanDate = planDate,
                    ProductionBatchId = batchId,
                    InputMultiple = _inputMultiples.GetValueOrDefault(batchId, 1),
                    UsedQuantity = _usedQuantities.GetValueOrDefault(batchId),
                    UsedWeight = _usedWeights.GetValueOrDefault(batchId),
                    RequiredDate = requiredDate,
                    Remark = string.IsNullOrWhiteSpace(_remark) ? null : _remark,
                    // 工序组随创建请求内算工量
                    ProcessGroups = _pendingProcessGroups
                };

                var result = await MaterialPlanService.CreateInProcessReworkPlanAsync(request);

                if (result.Success)
                {
                    successCount++;
                }
                else
                {
                    Snackbar.Add($"批次 {batch.BatchNo} 保存失败: {result.Message}", Severity.Error);
                }
            }

            if (successCount > 0)
            {
                Snackbar.Add($"成功保存 {successCount} 条在产改制计划", Severity.Success);
                GoBack();
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"保存失败: {ex.Message}", Severity.Error);
        }
        finally
        {
            isSaving = false;
            StateHasChanged();
        }
    }
}
