@page "/workorders/{WorkOrderId:int}/in-process-rework-plan/create"
@page "/workorders/{WorkOrderId:int}/in-process-rework-plan/edit/{PlanId:int}"
@using MES.Blazor.Services
@using MES.Core.Models
@using MES.Core.Enums
@using MES.Blazor.Shared
@using MES.Core.Constants
@using MES.Blazor.Helpers
@using MES.Blazor.Models
@using MES.Core.DTOs.WorkOrder
@using Microsoft.AspNetCore.Authorization
@inject MaterialPlanService MaterialPlanService
@inject MaterialPlanProcessGroupService ProcessGroupService
@inject WorkOrderService WorkOrderService
@inject NavigationManager Navigation
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject IJSRuntime JS
@attribute [Authorize(Roles = Roles.Policies.WorkOrderRead)]

<style>
    .inprocess-table table {
        table-layout: fixed;
    }
    .inprocess-table table th,
    .inprocess-table table td {
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }
</style>

<MudContainer MaxWidth="MaxWidth.False" Class="mt-4">
    <MudCard>
        <MudCardHeader>
            <CardHeaderContent>
                <div class="d-flex align-center">
                    <MudIcon Icon="@Icons.Material.Filled.Autorenew" Class="mr-2" Color="Color.Primary" Size="Size.Medium" />
                    <MudText Typo="Typo.h5" Class="font-weight-bold">@(IsEditMode ? "编辑" : "新增")在产改制</MudText>
                </div>
            </CardHeaderContent>
            <CardHeaderActions>
                <MudButton Variant="Variant.Text" OnClick="GoBack">返回上一级</MudButton>
            </CardHeaderActions>
        </MudCardHeader>

        <MudCardContent>
            <div id="inprocess-rework-plan-create-table">
            @if (isLoadingWorkOrder)
            {
                <MudProgressCircular Indeterminate Size="Size.Large" Class="d-flex justify-center ma-8" />
            }
            else if (workOrder != null)
            {
                <!-- ===== 工单信息 ===== -->
                <WorkOrderInfoCard WorkOrder="workOrder" />

                <!-- ===== 基本信息 ===== -->
                <MudGrid Class="mt-2 mb-4">
                    <MudItem xs="12" md="2">
                        <MudText Typo="Typo.body2" Class="mb-1">计划日期</MudText>
                        <MudTextField T="string" @bind-Value="_planDate" Placeholder="yyyy-MM-dd"
                                      Variant="Variant.Outlined" Dense="true" Size="Size.Small" />
                    </MudItem>
                    <MudItem xs="12" md="2">
                        <MudText Typo="Typo.body2" Class="mb-1">要求到位日期</MudText>
                        <MudTextField T="string" @bind-Value="_requiredDate" Placeholder="yyyy-MM-dd"
                                      Variant="Variant.Outlined" Dense="true" Size="Size.Small" />
                    </MudItem>
                    <MudItem xs="12" md="4">
                        <MudText Typo="Typo.body2" Class="mb-1">备注</MudText>
                        <MudTextField T="string" @bind-Value="_remark"
                                      Variant="Variant.Outlined" Dense="true" Size="Size.Small" />
                    </MudItem>
                </MudGrid>

                <!-- ===== 二、工序组（内联编辑） ===== -->
                <MudText Typo="Typo.subtitle2" Color="Color.Primary" Class="mb-2 mt-2">
                    <MudIcon Icon="@Icons.Material.Filled.AccountTree" Size="Size.Small" Class="mr-1" />工序组
                </MudText>

                <div class="d-flex flex-wrap align-center" style="gap:8px; margin-bottom:12px; justify-content:flex-end;">
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.Add" OnClick="AddProcessGroupRow">新增工序</MudButton>
                    <ColumnDisplaySelect Columns="pgCols" ShowCommonFields="false"
                                       OnColumnToggle="OnPgColumnToggle"
                                       OnMoveUp="OnPgColumnMove"
                                       OnMoveDown="OnPgColumnMove" />
                    <MudButton Variant="Variant.Text" Size="Size.Small" Color="Color.Default"
                               StartIcon="@Icons.Material.Filled.RestartAlt" OnClick="ResetPgColumns" Class="ml-2">
                        重置
                    </MudButton>
                </div>

                <div class="table-container" style="overflow-x:auto; margin-bottom:12px;">
                    <MudTable Items="@_pendingProcessGroups" Dense="true" Hover="true" Elevation="0" Striped="true"
                              Class="auto-table compact-table" Style="border:1px solid var(--mud-palette-lines-default); border-radius:8px; width:max-content;">
                        <HeaderContent>
                            <MudTh Style="width:45px;">#</MudTh>
                            <MudTh Style="width:120px;">工序名称<span class="required-star">*</span></MudTh>
                            @if (GetPgCol("ManufacturingSpec").Visible) { <MudTh Style="width:100px;">制造规格<span class="required-star">*</span></MudTh> }
                            @if (GetPgCol("OuterDiameterTolerance").Visible) { <MudTh Style="width:80px;">外径公差</MudTh> }
                            @if (GetPgCol("WallThicknessTolerance").Visible) { <MudTh Style="width:80px;">壁厚公差</MudTh> }
                            @if (GetPgCol("ManufacturingLength").Visible) { <MudTh Style="width:80px;">制造长度</MudTh> }
                            @if (GetPgCol("CuttingTreatment").Visible) { <MudTh Style="width:80px;">断切处理</MudTh> }
                            @if (GetPgCol("ManufacturingMultiple").Visible) { <MudTh Style="width:80px;">制成倍数</MudTh> }
                            @if (GetPgCol("Remark").Visible) { <MudTh Style="width:120px;">备注</MudTh> }
                            @if (GetPgCol("ColdRollDraw").Visible) { <MudTh Style="width:80px;">冷轧拔</MudTh> }
                            @if (GetPgCol("OilPipeCut").Visible) { <MudTh Style="width:80px;">油管断</MudTh> }
                            @if (GetPgCol("Degrease").Visible) { <MudTh Style="width:60px;">去油</MudTh> }
                            @if (GetPgCol("Solution").Visible) { <MudTh Style="width:60px;">固溶</MudTh> }
                            @if (GetPgCol("Straighten").Visible) { <MudTh Style="width:60px;">矫直</MudTh> }
                            @if (GetPgCol("Cut").Visible) { <MudTh Style="width:60px;">断切</MudTh> }
                            @if (GetPgCol("ThicknessMeasure").Visible) { <MudTh Style="width:60px;">测厚</MudTh> }
                            @if (GetPgCol("Pickle").Visible) { <MudTh Style="width:60px;">酸洗</MudTh> }
                            @if (GetPgCol("OuterPolish").Visible) { <MudTh Style="width:60px;">外抛光</MudTh> }
                            @if (GetPgCol("InnerGrinding").Visible) { <MudTh Style="width:60px;">内磨</MudTh> }
                            @if (GetPgCol("OuterSpotGrinding").Visible) { <MudTh Style="width:60px;">外修磨</MudTh> }
                            @if (GetPgCol("Inspection").Visible) { <MudTh Style="width:60px;">检验</MudTh> }
                            @if (GetPgCol("WeldingHead").Visible) { <MudTh Style="width:60px;">焊头</MudTh> }
                            @if (GetPgCol("Lubrication").Visible) { <MudTh Style="width:60px;">润滑</MudTh> }
                            @if (GetPgCol("Warehouse").Visible) { <MudTh Style="width:60px;">入库</MudTh> }
                            <MudTh Style="width:60px;">操作</MudTh>
                        </HeaderContent>
                        <RowTemplate Context="pg">
                            <MudTd Style="width:45px;">@(_pendingProcessGroups.IndexOf(pg) + 1)</MudTd>
                            <MudTd Style="width:120px;">
                                <MudSelect T="string" Value="@pg.ProcessName"
                                           ValueChanged="@((string v) => { pg.ProcessName = v; ApplyProcessGroupDefaults(pg); })"
                                           Dense="true" Variant="Variant.Outlined" Size="Size.Small">
                                    @foreach (var pn in ProcessNames.All)
                                    {
                                        <MudSelectItem Value="@pn" />
                                    }
                                </MudSelect>
                            </MudTd>
                            @if (GetPgCol("ManufacturingSpec").Visible) { <MudTd><MudTextField T="string" @bind-Value="pg.ManufacturingSpec" Dense="true" Variant="Variant.Outlined" Size="Size.Small" /></MudTd> }
                            @if (GetPgCol("OuterDiameterTolerance").Visible) { <MudTd><MudTextField T="string" @bind-Value="pg.OuterDiameterTolerance" Dense="true" Variant="Variant.Outlined" Size="Size.Small" /></MudTd> }
                            @if (GetPgCol("WallThicknessTolerance").Visible) { <MudTd><MudTextField T="string" @bind-Value="pg.WallThicknessTolerance" Dense="true" Variant="Variant.Outlined" Size="Size.Small" /></MudTd> }
                            @if (GetPgCol("ManufacturingLength").Visible) { <MudTd><MudTextField T="string" @bind-Value="pg.ManufacturingLength" Dense="true" Variant="Variant.Outlined" Size="Size.Small" /></MudTd> }
                            @if (GetPgCol("CuttingTreatment").Visible) { <MudTd><MudTextField T="string" @bind-Value="pg.CuttingTreatment" Dense="true" Variant="Variant.Outlined" Size="Size.Small" /></MudTd> }
                            @if (GetPgCol("ManufacturingMultiple").Visible) { <MudTd><MudNumericField T="int" @bind-Value="pg.ManufacturingMultiple" Dense="true" Variant="Variant.Outlined" Size="Size.Small" HideSpinButtons="true" Min="1" /></MudTd> }
                            @if (GetPgCol("Remark").Visible) { <MudTd><MudTextField T="string" @bind-Value="pg.Remark" Dense="true" Variant="Variant.Outlined" Size="Size.Small" /></MudTd> }
                            @if (GetPgCol("ColdRollDraw").Visible) { <MudTd><MudNumericField T="int?" @bind-Value="pg.ColdRollDraw" Dense="true" Variant="Variant.Outlined" Size="Size.Small" HideSpinButtons="true" /></MudTd> }
                            @if (GetPgCol("OilPipeCut").Visible) { <MudTd><MudNumericField T="int?" @bind-Value="pg.OilPipeCut" Dense="true" Variant="Variant.Outlined" Size="Size.Small" HideSpinButtons="true" /></MudTd> }
                            @if (GetPgCol("Degrease").Visible) { <MudTd><MudNumericField T="int?" @bind-Value="pg.Degrease" Dense="true" Variant="Variant.Outlined" Size="Size.Small" HideSpinButtons="true" /></MudTd> }
                            @if (GetPgCol("Solution").Visible) { <MudTd><MudNumericField T="int?" @bind-Value="pg.Solution" Dense="true" Variant="Variant.Outlined" Size="Size.Small" HideSpinButtons="true" /></MudTd> }
                            @if (GetPgCol("Straighten").Visible) { <MudTd><MudNumericField T="int?" @bind-Value="pg.Straighten" Dense="true" Variant="Variant.Outlined" Size="Size.Small" HideSpinButtons="true" /></MudTd> }
                            @if (GetPgCol("Cut").Visible) { <MudTd><MudNumericField T="int?" @bind-Value="pg.Cut" Dense="true" Variant="Variant.Outlined" Size="Size.Small" HideSpinButtons="true" /></MudTd> }
                            @if (GetPgCol("ThicknessMeasure").Visible) { <MudTd><MudNumericField T="int?" @bind-Value="pg.ThicknessMeasure" Dense="true" Variant="Variant.Outlined" Size="Size.Small" HideSpinButtons="true" /></MudTd> }
                            @if (GetPgCol("Pickle").Visible) { <MudTd><MudNumericField T="int?" @bind-Value="pg.Pickle" Dense="true" Variant="Variant.Outlined" Size="Size.Small" HideSpinButtons="true" /></MudTd> }
                            @if (GetPgCol("OuterPolish").Visible) { <MudTd><MudNumericField T="int?" @bind-Value="pg.OuterPolish" Dense="true" Variant="Variant.Outlined" Size="Size.Small" HideSpinButtons="true" /></MudTd> }
                            @if (GetPgCol("InnerGrinding").Visible) { <MudTd><MudNumericField T="int?" @bind-Value="pg.InnerGrinding" Dense="true" Variant="Variant.Outlined" Size="Size.Small" HideSpinButtons="true" /></MudTd> }
                            @if (GetPgCol("OuterSpotGrinding").Visible) { <MudTd><MudNumericField T="int?" @bind-Value="pg.OuterSpotGrinding" Dense="true" Variant="Variant.Outlined" Size="Size.Small" HideSpinButtons="true" /></MudTd> }
                            @if (GetPgCol("Inspection").Visible) { <MudTd><MudNumericField T="int?" @bind-Value="pg.Inspection" Dense="true" Variant="Variant.Outlined" Size="Size.Small" HideSpinButtons="true" /></MudTd> }
                            @if (GetPgCol("WeldingHead").Visible) { <MudTd><MudNumericField T="int?" @bind-Value="pg.WeldingHead" Dense="true" Variant="Variant.Outlined" Size="Size.Small" HideSpinButtons="true" /></MudTd> }
                            @if (GetPgCol("Lubrication").Visible) { <MudTd><MudNumericField T="int?" @bind-Value="pg.Lubrication" Dense="true" Variant="Variant.Outlined" Size="Size.Small" HideSpinButtons="true" /></MudTd> }
                            @if (GetPgCol("Warehouse").Visible) { <MudTd><MudNumericField T="int?" @bind-Value="pg.Warehouse" Dense="true" Variant="Variant.Outlined" Size="Size.Small" HideSpinButtons="true" /></MudTd> }
                            <MudTd><MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" Title="删除" OnClick="@(() => DeleteProcessGroupRow(pg))" /></MudTd>
                        </RowTemplate>
                        <NoRecordsContent>
                            <MudText Class="pa-4 text-center" Color="Color.Secondary">暂无工序组，可点击"新增工序"添加</MudText>
                        </NoRecordsContent>
                    </MudTable>
                </div>

                <!-- ===== 三、展示可用在产批次按钮 ===== -->
                <div class="d-flex align-center mb-3">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.Search"
                               OnClick="LoadAvailableBatches"
                               Disabled="isLoadingInventory">
                        @(isLoadingInventory ? "加载中..." : "展示可用在产批次")
                    </MudButton>
                    @if (errorMessage != null)
                    {
                        <MudText Typo="Typo.body2" Color="Color.Warning" Class="ml-3">
                            @errorMessage
                        </MudText>
                    }
                </div>

                <!-- ===== 可用在产批次列表 ===== -->
                @if (availableBatches.Any())
                {
                    <MudText Typo="Typo.subtitle2" Color="Color.Primary" Class="mb-2">
                        <MudIcon Icon="@Icons.Material.Filled.Inventory" Size="Size.Small" Class="mr-1" />可用在产批次列表
                    </MudText>

                    <div class="d-flex align-center mb-2 flex-wrap" Style="gap:8px;">
                        <MudText Typo="Typo.body2" Color="Color.Primary">（已选 @SelectedBatchCount 项）</MudText>
                        <span class="flex-grow-1"></span>
                        <MudButton Variant="Variant.Text" OnClick="GoBack" Size="Size.Small">取消</MudButton>
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                                   OnClick="SavePlan" Disabled="@(SelectedBatchCount == 0)" Loading="@isSaving">
                            保存
                        </MudButton>
                    </div>

                    <div Style="border:1px solid var(--mud-palette-lines-default); border-radius:8px;" Class="mb-3">
                        <MudTable Items="@availableBatches" Class="inprocess-table auto-table" Dense="true" Hover="true" Striped="true" Elevation="0" RowsPerPage="5" RowsPerPageLabel="每页行数:">
                            <HeaderContent>
                                <MudTh Style="width:32px;">选择</MudTh>
                                <MudTh Style="width:60px;">计划日期</MudTh>
                                <MudTh Style="width:55px;">生产编号</MudTh>
                                <MudTh Style="width:40px;">挂牌号</MudTh>
                                <MudTh Style="width:50px;">工厂牌号</MudTh>
                                <MudTh Style="width:50px;">当前工序</MudTh>
                                <MudTh Style="width:50px;">当前工段</MudTh>
                                <MudTh Style="width:55px;">当前规格</MudTh>
                                <MudTh Style="width:40px;">长度状态</MudTh>
                                <MudTh Style="width:50px;">可用支数</MudTh>
                                <MudTh Style="width:55px;">可用重量(kg)</MudTh>
                                <MudTh Style="width:55px; background-color: rgba(255, 152, 0, 0.08);">投料制成倍</MudTh>
                                <MudTh Style="width:55px; background-color: rgba(255, 152, 0, 0.08);">使用支数</MudTh>
                                <MudTh Style="width:55px; background-color: rgba(255, 152, 0, 0.08);">使用重量(kg)</MudTh>
                            </HeaderContent>
                            <RowTemplate>
                                <MudTd>
                                    <MudCheckBox Value="@GetSelection(context.Id)"
                                                 ValueChanged="@((bool v) => OnSelectionChanged(context.Id, v))"
                                                 Color="Color.Primary" />
                                </MudTd>
                                <MudTd DataLabel="计划日期">@DateTime.Today.ToString("yyyy-MM-dd")</MudTd>
                                <MudTd DataLabel="生产编号">@context.BatchNo</MudTd>
                                <MudTd DataLabel="挂牌号">@(context.TagNo ?? "-")</MudTd>
                                <MudTd DataLabel="工厂牌号">@context.PlantGrade</MudTd>
                                <MudTd DataLabel="当前工序">@(context.CurrentGroupName ?? "-")</MudTd>
                                <MudTd DataLabel="当前工段">@(context.CurrentSectionName ?? "-")</MudTd>
                                <MudTd DataLabel="当前规格">@(context.CurrentSpec ?? "-")</MudTd>
                                <MudTd DataLabel="长度状态">@DisplayHelper.GetLengthStatusText(context.LengthStatus)</MudTd>
                                <MudTd DataLabel="可用支数">@(context.CurrentValidQty?.ToString() ?? "-")</MudTd>
                                <MudTd DataLabel="可用重量">@(context.CurrentValidWeight?.ToString("G29") ?? "-")</MudTd>
                                <MudTd DataLabel="投料制成倍" Style="background-color: rgba(255, 152, 0, 0.08);">
                                    @if (GetSelection(context.Id))
                                    {
                                        <MudNumericField Dense="true" HideSpinButtons="true" Value="@GetInputMultiple(context.Id)"
                                                         ValueChanged="@((int v) => OnInputMultipleChanged(context.Id, v))"
                                                         Size="Size.Small"
                                                         Variant="Variant.Outlined"
                                                         Min="1" Max="99"
                                                         Class="my-n2" Style="width:60px;" />
                                    }
                                    else
                                    {
                                        <span>@GetInputMultiple(context.Id)</span>
                                    }
                                </MudTd>
                                <MudTd DataLabel="使用支数" Style="background-color: rgba(255, 152, 0, 0.08);">
                                    @if (GetSelection(context.Id))
                                    {
                                        <MudNumericField T="int?" HideSpinButtons="true" Value="@GetUsedQuantity(context.Id)"
                                                         ValueChanged="@(v => OnUsedQuantityChanged(context.Id, v))"
                                                         Size="Size.Small"
                                                         Variant="Variant.Outlined"
                                                         Min="1" Max="@context.CurrentValidQty"
                                                         Class="my-n2" Style="width:48px;" />
                                    }
                                    else
                                    {
                                        <span>@(GetUsedQuantity(context.Id)?.ToString() ?? "-")</span>
                                    }
                                </MudTd>
                                <MudTd DataLabel="使用重量" Style="background-color: rgba(255, 152, 0, 0.08);">
                                    @if (GetSelection(context.Id))
                                    {
                                        <MudNumericField T="decimal" HideSpinButtons="true" Value="@GetUsedWeight(context.Id)" Format="G29"
                                                         ValueChanged="@(v => OnUsedWeightChanged(context.Id, v))"
                                                         Size="Size.Small"
                                                         Variant="Variant.Outlined"
                                                         Min="0"
                                                         Class="my-n2" Style="width:55px;" />
                                    }
                                    else
                                    {
                                        <span>@GetUsedWeight(context.Id).ToString("G29")</span>
                                    }
                                </MudTd>
                            </RowTemplate>
                        </MudTable>
                    </div>
                }
            }
            </div>
        </MudCardContent>
    </MudCard>
</MudContainer>

@code {
    [Parameter] public int WorkOrderId { get; set; }
    [Parameter] public int PlanId { get; set; }

    private bool IsEditMode => PlanId > 0;

    private WorkOrderDetailDto? workOrder;
    private InProcessReworkPlanDto? existingPlan;
    private List<AvailableInProcessBatchDto> availableBatches = new();
    private bool isLoadingWorkOrder = true;
    private bool isLoadingInventory = false;
    private bool isSaving = false;
    private string? errorMessage;
    private bool _isArrowNavSetup;

    // 基本信息
    private string _planDate = DateTime.Today.ToString("yyyy-MM-dd");
    private string _requiredDate = "";
    private string _remark = "";

    // 选择数据（多选）
    private Dictionary<int, bool> _selections = new();
    private Dictionary<int, int> _inputMultiples = new();
    private Dictionary<int, int?> _usedQuantities = new();
    private Dictionary<int, decimal> _usedWeights = new();
    private int SelectedBatchCount => _selections.Count(s => s.Value);

    // 工序组
    private List<SavePlanProcessGroupItem> _pendingProcessGroups = new();
    private List<ColumnDef> pgCols = GetProcessGroupDefaultColumns();
    private static List<ColumnDef> GetProcessGroupDefaultColumns() => new()
    {
        new() { Key = "ManufacturingSpec", Label = "制造规格", Visible = true },
        new() { Key = "OuterDiameterTolerance", Label = "外径公差", Visible = true },
        new() { Key = "WallThicknessTolerance", Label = "壁厚公差", Visible = true },
        new() { Key = "ManufacturingLength", Label = "制造长度", Visible = true },
        new() { Key = "CuttingTreatment", Label = "断切处理", Visible = true },
        new() { Key = "ManufacturingMultiple", Label = "制成倍数", Visible = true },
        new() { Key = "Remark", Label = "备注", Visible = false },
        new() { Key = "ColdRollDraw", Label = "冷轧拔", Visible = true },
        new() { Key = "OilPipeCut", Label = "油管断", Visible = true },
        new() { Key = "Degrease", Label = "去油", Visible = true },
        new() { Key = "Solution", Label = "固溶", Visible = true },
        new() { Key = "Straighten", Label = "矫直", Visible = true },
        new() { Key = "Cut", Label = "断切", Visible = true },
        new() { Key = "ThicknessMeasure", Label = "测厚", Visible = true },
        new() { Key = "Pickle", Label = "酸洗", Visible = true },
        new() { Key = "OuterPolish", Label = "外抛光", Visible = true },
        new() { Key = "InnerGrinding", Label = "内磨", Visible = true },
        new() { Key = "OuterSpotGrinding", Label = "外修磨", Visible = true },
        new() { Key = "Inspection", Label = "检验", Visible = true },
        new() { Key = "WeldingHead", Label = "焊头", Visible = true },
        new() { Key = "Lubrication", Label = "润滑", Visible = true },
        new() { Key = "Warehouse", Label = "仓库", Visible = true },
    };
    private ColumnDef GetPgCol(string key) => pgCols.First(c => c.Key == key);

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var result = await WorkOrderService.GetByIdAsync(WorkOrderId);
            workOrder = result.Success ? result.Data : null;

            if (IsEditMode)
            {
                await LoadExistingPlan();
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"加载工单失败: {ex.Message}", Severity.Error);
        }
        finally
        {
            isLoadingWorkOrder = false;
        }
    }

    private async Task LoadExistingPlan()
    {
        try
        {
            var planResult = await MaterialPlanService.GetInProcessReworkPlanByIdAsync(PlanId);
            if (!planResult.Success || planResult.Data == null)
            {
                Snackbar.Add("在产改制计划不存在", Severity.Error);
                GoBack();
                return;
            }

            existingPlan = planResult.Data;
            var plan = planResult.Data;

            // 回填基本信息
            _planDate = plan.PlanDate.ToString("yyyy-MM-dd");
            _requiredDate = plan.RequiredDate?.ToString("yyyy-MM-dd") ?? "";
            _remark = plan.Remark ?? "";

            // 加载可用在产批次（排除自身）
            await LoadAvailableBatches();

            // 自动选中匹配批次
            var matchBatch = availableBatches.FirstOrDefault(b => b.Id == plan.ProductionBatchId);
            if (matchBatch != null && _selections.ContainsKey(matchBatch.Id))
            {
                _selections[matchBatch.Id] = true;
                _inputMultiples[matchBatch.Id] = plan.InputMultiple;
                _usedQuantities[matchBatch.Id] = plan.UsedQuantity;
                _usedWeights[matchBatch.Id] = plan.UsedWeight;
                StateHasChanged();
            }

            // 加载已有的工序组
            var pgResult = await ProcessGroupService.GetByPlanAsync(6, PlanId);
            if (pgResult.Success && pgResult.Data != null)
            {
                _pendingProcessGroups = pgResult.Data.Select(p => new SavePlanProcessGroupItem
                {
                    Id = p.Id,
                    SequenceNumber = p.SequenceNumber,
                    ProcessName = p.ProcessName,
                    ManufacturingSpec = p.ManufacturingSpec,
                    OuterDiameterTolerance = p.OuterDiameterTolerance,
                    WallThicknessTolerance = p.WallThicknessTolerance,
                    ManufacturingLength = p.ManufacturingLength,
                    CuttingTreatment = p.CuttingTreatment,
                    ManufacturingMultiple = p.ManufacturingMultiple,
                    Remark = p.Remark,
                    ColdRollDraw = p.ColdRollDraw,
                    OilPipeCut = p.OilPipeCut,
                    Degrease = p.Degrease,
                    Solution = p.Solution,
                    Straighten = p.Straighten,
                    Cut = p.Cut,
                    ThicknessMeasure = p.ThicknessMeasure,
                    Pickle = p.Pickle,
                    OuterPolish = p.OuterPolish,
                    InnerGrinding = p.InnerGrinding,
                    OuterSpotGrinding = p.OuterSpotGrinding,
                    Inspection = p.Inspection,
                    WeldingHead = p.WeldingHead,
                    Lubrication = p.Lubrication,
                    Warehouse = p.Warehouse
                }).ToList();
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"加载在产改制计划失败: {ex.Message}", Severity.Error);
        }
    }

    // ===== 工序组内联操作 =====

    private void AddProcessGroupRow()
    {
        _pendingProcessGroups.Add(new SavePlanProcessGroupItem
        {
            ProcessName = "荒管处理",
            ManufacturingMultiple = 1
        });
        ApplyProcessGroupDefaults(_pendingProcessGroups.Last());
    }

    private void DeleteProcessGroupRow(SavePlanProcessGroupItem pg)
    {
        _pendingProcessGroups.Remove(pg);
    }

    private static void ApplyProcessGroupDefaults(SavePlanProcessGroupItem pg)
    {
        pg.ColdRollDraw = null;
        pg.OilPipeCut = null;
        pg.Degrease = null;
        pg.Solution = null;
        pg.Straighten = null;
        pg.Cut = null;
        pg.ThicknessMeasure = null;
        pg.Pickle = null;
        pg.OuterPolish = null;
        pg.InnerGrinding = null;
        pg.OuterSpotGrinding = null;
        pg.Inspection = null;
        pg.WeldingHead = null;
        pg.Lubrication = null;
        pg.Warehouse = null;

        switch (pg.ProcessName)
        {
            case "荒管处理":
                pg.Straighten = 1;
                pg.Cut = 1;
                pg.Pickle = 1;
                pg.OuterPolish = 1;
                pg.OuterSpotGrinding = 1;
                pg.Inspection = 1;
                break;
            case "在制修检":
                pg.Solution = 1;
                pg.Straighten = 1;
                pg.Cut = 1;
                pg.Pickle = 1;
                pg.Inspection = 1;
                break;
            case "60冷轧":
            case "50冷轧":
            case "30冷轧":
            case "20冷轧":
            case "三辊冷轧":
                pg.ColdRollDraw = 1;
                pg.OilPipeCut = 1;
                pg.Degrease = 1;
                pg.Solution = 1;
                pg.Straighten = 1;
                pg.Cut = 1;
                pg.Pickle = 1;
                pg.Inspection = 1;
                break;
            case "冷拔":
                pg.ColdRollDraw = 1;
                pg.Solution = 1;
                pg.Straighten = 1;
                pg.Cut = 1;
                pg.Pickle = 1;
                pg.Inspection = 1;
                break;
        }
    }

    private async Task OnPgColumnToggle(ColumnDef col) => await Task.CompletedTask;
    private async Task OnPgColumnMove(ColumnDef col) => await Task.CompletedTask;
    private void ResetPgColumns() => pgCols = GetProcessGroupDefaultColumns();

    private async Task<string?> SaveProcessGroupsForPlan(int planId)
    {
        if (_pendingProcessGroups.Count == 0) return null;
        var result = await ProcessGroupService.SaveAsync(6, planId, _pendingProcessGroups);
        return result.Success ? null : (result.Message ?? "保存工序组失败");
    }

    private async Task LoadAvailableBatches()
    {
        isLoadingInventory = true;
        errorMessage = null;
        StateHasChanged();

        try
        {
            const ReworkType reworkType = ReworkType.ManualSelect;
            var result = await MaterialPlanService.GetAvailableInProcessBatchesAsync(WorkOrderId, reworkType, IsEditMode ? PlanId : null);
            if (result.Success)
            {
                availableBatches = (result.Data ?? new()).ToList();
                InitSelections();
                if (availableBatches.Count == 0)
                {
                    errorMessage = "未找到符合条件的在产批次";
                }
            }
            else
            {
                errorMessage = result.Message ?? "查询可用在产批次失败";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"加载失败: {ex.Message}";
        }
        finally
        {
            isLoadingInventory = false;
            StateHasChanged();
        }
    }

    private void InitSelections()
    {
        _selections.Clear();
        _inputMultiples.Clear();
        _usedQuantities.Clear();
        _usedWeights.Clear();
        foreach (var batch in availableBatches)
        {
            _selections[batch.Id] = false;
            _inputMultiples[batch.Id] = 1;
            _usedQuantities[batch.Id] = batch.CurrentValidQty;
            _usedWeights[batch.Id] = batch.CurrentValidWeight ?? 0;
        }
    }

    private bool GetSelection(int batchId) => _selections.GetValueOrDefault(batchId, false);
    private int GetInputMultiple(int batchId) => _inputMultiples.GetValueOrDefault(batchId, 1);
    private int? GetUsedQuantity(int batchId) => _usedQuantities.GetValueOrDefault(batchId);
    private decimal GetUsedWeight(int batchId) => _usedWeights.GetValueOrDefault(batchId);

    private void OnSelectionChanged(int batchId, bool value)
    {
        if (_selections.ContainsKey(batchId))
            _selections[batchId] = value;
    }

    private void OnInputMultipleChanged(int batchId, int value)
    {
        if (_inputMultiples.ContainsKey(batchId))
            _inputMultiples[batchId] = value;
    }

    private void OnUsedQuantityChanged(int batchId, int? value)
    {
        if (_usedQuantities.ContainsKey(batchId))
            _usedQuantities[batchId] = value;
    }

    private void OnUsedWeightChanged(int batchId, decimal value)
    {
        if (_usedWeights.ContainsKey(batchId))
            _usedWeights[batchId] = value;
    }

