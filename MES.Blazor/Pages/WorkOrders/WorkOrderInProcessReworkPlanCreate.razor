    private async Task SavePlan()
    {
        var selectedIds = _selections.Where(s => s.Value).Select(s => s.Key).ToList();
        if (selectedIds.Count == 0)
        {
            Snackbar.Add("请至少选择一个在产批次", Severity.Warning);
            return;
        }

        // 前端验证
        var errors = new List<string>();

        if (string.IsNullOrWhiteSpace(_planDate) || !DateTime.TryParse(_planDate, out _))
            errors.Add("计划日期格式无效，请使用 yyyy-MM-dd 格式");

        foreach (var batchId in selectedIds)
        {
            var batch = availableBatches.FirstOrDefault(b => b.Id == batchId);
            if (batch == null) continue;

            var qty = _usedQuantities.GetValueOrDefault(batchId);
            var wt = _usedWeights.GetValueOrDefault(batchId);

            if (qty == null || qty <= 0)
                errors.Add($"批次 {batch.BatchNo}：使用支数必须大于0");
            if (wt <= 0)
                errors.Add($"批次 {batch.BatchNo}：使用重量必须大于0");
            if (qty > batch.CurrentValidQty)
                errors.Add($"批次 {batch.BatchNo}：使用支数({qty})超过有效支数({batch.CurrentValidQty})");
            if (wt > batch.CurrentValidWeight)
                errors.Add($"批次 {batch.BatchNo}：使用重量({wt})超过有效重量({batch.CurrentValidWeight})");
        }

        if (errors.Any())
        {
            foreach (var err in errors)
                Snackbar.Add(err, Severity.Warning);
            return;
        }

        isSaving = true;
        StateHasChanged();

        try
        {
            var successCount = 0;
            foreach (var batchId in selectedIds)
            {
                var batch = availableBatches.FirstOrDefault(b => b.Id == batchId);
                if (batch == null) continue;

                DateTime planDate = DateTime.Today;
                if (!string.IsNullOrWhiteSpace(_planDate) && DateTime.TryParse(_planDate, out var parsedPlanDate))
                    planDate = parsedPlanDate;

                DateTime? requiredDate = null;
                if (!string.IsNullOrWhiteSpace(_requiredDate) && DateTime.TryParse(_requiredDate, out var parsedReqDate))
                    requiredDate = parsedReqDate;

                var request = new CreateInProcessReworkPlanRequest
                {
                    WorkOrderId = WorkOrderId,
                    PlanDate = planDate,
                    ProductionBatchId = batchId,
                    InputMultiple = _inputMultiples.GetValueOrDefault(batchId, 1),
                    UsedQuantity = _usedQuantities.GetValueOrDefault(batchId),
                    UsedWeight = _usedWeights.GetValueOrDefault(batchId),
                    RequiredDate = requiredDate,
                    Remark = string.IsNullOrWhiteSpace(_remark) ? null : _remark,
                    ReworkType = ReworkType.ManualSelect
                };

                ApiResponse<InProcessReworkPlanDto> result;
                if (IsEditMode && existingPlan != null && batchId == existingPlan.ProductionBatchId)
                {
                    result = await MaterialPlanService.UpdateInProcessReworkPlanAsync(PlanId, request);
                }
                else
                {
                    result = await MaterialPlanService.CreateInProcessReworkPlanAsync(request);
                }

                if (result.Success)
                {
                    var planId = result.Data?.Id ?? 0;
                    if (planId > 0)
                    {
                        var pgErr = await SaveProcessGroupsForPlan(planId);
                        if (pgErr != null)
                            Snackbar.Add($"批次 {batch.BatchNo} 计划已保存，但工序组保存失败: {pgErr}", Severity.Warning);
                    }
                    successCount++;
                }
                else
                {
                    Snackbar.Add($"批次 {batch.BatchNo} 保存失败: {result.Message}", Severity.Error);
                }
            }

            if (successCount > 0)
            {
                Snackbar.Add($"成功保存 {successCount} 条在产改制计划", Severity.Success);
                GoBack();
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"保存失败: {ex.Message}", Severity.Error);
        }
        finally
        {
            isSaving = false;
            StateHasChanged();
        }
    }
