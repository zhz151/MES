    private async Task SavePlans()
    {
        var selectedIds = selectedBatchIds.ToList();
        if (selectedIds.Count == 0)
        {
            Snackbar.Add("请至少选择一个库存批次", Severity.Warning);
            return;
        }

        // 前端验证
        var errors = new List<string>();
        foreach (var batchId in selectedIds)
        {
            var batch = availableBatches.FirstOrDefault(b => b.Id == batchId);
            if (batch == null) continue;

            var mode = usageModes.GetValueOrDefault(batchId, "All");
            if (mode == "Partial")
            {
                var qty = usedQuantities.GetValueOrDefault(batchId);
                var wt = usedWeights.GetValueOrDefault(batchId);
                if (qty == null || qty <= 0)
                    errors.Add($"批次 {batch.BatchNo}：部分使用模式下出库支数必须大于0");
                if (wt == null || wt <= 0)
                    errors.Add($"批次 {batch.BatchNo}：部分使用模式下出库重量必须大于0");
                if (qty > batch.RemainingQuantity)
                    errors.Add($"批次 {batch.BatchNo}：出库支数({qty})超过剩余支数({batch.RemainingQuantity})");
                if (wt > batch.RemainingWeight)
                    errors.Add($"批次 {batch.BatchNo}：出库重量({wt})超过剩余重量({batch.RemainingWeight})");
            }
        }

        if (errors.Any())
        {
            foreach (var err in errors)
                Snackbar.Add(err, Severity.Warning);
            return;
        }

        isSaving = true;
        StateHasChanged();

        try
        {
            if (IsEditMode && existingPlan != null)
            {
                // 编辑模式：更新单个改制计划
                var batchId = selectedIds.FirstOrDefault();
                if (batchId == 0)
                {
                    Snackbar.Add("未选择库存批次", Severity.Warning);
                    return;
                }

                var batch = availableBatches.FirstOrDefault(b => b.Id == batchId);
                var reworkType = GetReworkType();
                var mode = usageModes.GetValueOrDefault(batchId, "All");

                var request = new CreateInventoryPlanRequest
                {
                    WorkOrderId = WorkOrderId,
                    PlanDate = DateTime.Today,
                    InventoryBatchNo = batch?.BatchNo ?? existingPlan.InventoryBatchNo,
                    MaterialType = batch?.MaterialType ?? existingPlan.MaterialType,
                    InputMultiple = inputMultiples.GetValueOrDefault(batchId, 1),
                    UsageMode = mode,
                    RequiredDate = null,
                    Remark = null,
                    ReworkType = reworkType.ToString(),
                    UsedQuantity = mode == "Partial" ? usedQuantities.GetValueOrDefault(batchId) : null,
                    UsedWeight = mode == "Partial" ? usedWeights.GetValueOrDefault(batchId) ?? 0 : 0,
                };

                var updateResult = await MaterialPlanService.UpdateInventoryPlanAsync(PlanId, request);
                if (updateResult.Success)
                {
                    // 保存工序组
                    var pgErr = await SaveProcessGroupsForPlan(PlanId);
                    if (pgErr != null)
                    {
                        Snackbar.Add($"计划已更新，但工序组保存失败: {pgErr}", Severity.Warning);
                    }
                    else
                    {
                        Snackbar.Add("更新成功", Severity.Success);
                        GoBack();
                    }
                }
                else
                {
                    errors.Add(updateResult.Message ?? "更新失败");
                }
            }
            else
            {
                // 新建模式：批量创建
                var reworkType = GetReworkType();
                var requests = new List<CreateInventoryPlanRequest>();
                foreach (var batchId in selectedIds)
                {
                    var batch = availableBatches.FirstOrDefault(b => b.Id == batchId);
                    if (batch == null) continue;

                    var mode = usageModes.GetValueOrDefault(batchId, "All");

                    requests.Add(new CreateInventoryPlanRequest
                    {
                        WorkOrderId = WorkOrderId,
                        PlanDate = DateTime.Today,
                        InventoryBatchNo = batch.BatchNo,
                        MaterialType = batch.MaterialType,
                        InputMultiple = inputMultiples.GetValueOrDefault(batchId, 1),
                        UsageMode = mode,
                        RequiredDate = null,
                        Remark = null,
                        ReworkType = reworkType.ToString(),
                        UsedQuantity = mode == "Partial" ? usedQuantities.GetValueOrDefault(batchId) : null,
                        UsedWeight = mode == "Partial" ? usedWeights.GetValueOrDefault(batchId) ?? 0 : 0,
                    });
                }

                var result = await MaterialPlanService.CreateInventoryPlanBatchAsync(requests);
                if (result.Success)
                {
                    var createdPlans = result.Data ?? new();
                    // 为每个新创建的计划保存工序组
                    bool allPgOk = true;
                    if (_pendingProcessGroups.Count > 0)
                    {
                        foreach (var plan in createdPlans)
                        {
                            var pgErr = await SaveProcessGroupsForPlan(plan.Id);
                            if (pgErr != null)
                            {
                                errors.Add($"计划 #{plan.Id} 工序组保存失败: {pgErr}");
                                allPgOk = false;
                            }
                        }
                    }
                    if (allPgOk)
                        Snackbar.Add($"成功创建 {createdPlans.Count} 条改制计划", Severity.Success);
                    else
                        Snackbar.Add($"计划已创建，但部分工序组保存失败，请编辑重新保存", Severity.Warning);
                    GoBack();
                }
                else
                {
                    errors.Add(result.Message ?? "批量创建失败");
                }
            }

            if (errors.Any())
            {
                foreach (var err in errors)
                    Snackbar.Add(err, Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"保存失败: {ex.Message}", Severity.Error);
        }
        finally
        {
            isSaving = false;
            StateHasChanged();
        }
    }
