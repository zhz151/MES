    private void AddProcessGroupRow()
    {
        _pendingProcessGroups.Add(new SavePlanProcessGroupItem
        {
            ProcessName = "荒管处理",
            ManufacturingMultiple = 1
        });
        ApplyProcessGroupDefaults(_pendingProcessGroups.Last());
    }

    private void DeleteProcessGroupRow(SavePlanProcessGroupItem pg)
    {
        _pendingProcessGroups.Remove(pg);
    }

    private static void ApplyProcessGroupDefaults(SavePlanProcessGroupItem pg)
    {
        pg.ColdRollDraw = null;
        pg.OilPipeCut = null;
        pg.Degrease = null;
        pg.Solution = null;
        pg.Straighten = null;
        pg.Cut = null;
        pg.ThicknessMeasure = null;
        pg.Pickle = null;
        pg.OuterPolish = null;
        pg.InnerGrinding = null;
        pg.OuterSpotGrinding = null;
        pg.Inspection = null;
        pg.WeldingHead = null;
        pg.Lubrication = null;
        pg.Warehouse = null;

        switch (pg.ProcessName)
        {
            case "荒管处理":
                pg.Straighten = 1;
                pg.Cut = 1;
                pg.Pickle = 1;
                pg.OuterPolish = 1;
                pg.OuterSpotGrinding = 1;
                pg.Inspection = 1;
                break;
            case "在制修检":
                pg.Solution = 1;
                pg.Straighten = 1;
                pg.Cut = 1;
                pg.Pickle = 1;
                pg.Inspection = 1;
                break;
            case "60冷轧":
            case "50冷轧":
            case "30冷轧":
            case "20冷轧":
            case "三辊冷轧":
                pg.ColdRollDraw = 1;
                pg.OilPipeCut = 1;
                pg.Degrease = 1;
                pg.Solution = 1;
                pg.Straighten = 1;
                pg.Cut = 1;
                pg.Pickle = 1;
                pg.Inspection = 1;
                break;
            case "冷拔":
                pg.ColdRollDraw = 1;
                pg.Solution = 1;
                pg.Straighten = 1;
                pg.Cut = 1;
                pg.Pickle = 1;
                pg.Inspection = 1;
                break;
        }
    }

