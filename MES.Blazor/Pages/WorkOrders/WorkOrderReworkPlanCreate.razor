    private async Task<string?> SaveProcessGroupsForPlan(int planId)
    {
        if (_pendingProcessGroups.Count == 0) return null;
        var result = await ProcessGroupService.SaveAsync(3, planId, _pendingProcessGroups);
        return result.Success ? null : (result.Message ?? "保存工序组失败");
    }

    private async Task LoadAvailableInventory(int? excludePlanId = null)
    {
        isLoadingInventory = true;
        errorMessage = null;
        StateHasChanged();

        try
        {
            var reworkType = GetReworkType();
            var result = await MaterialPlanService.GetAvailableReworkInventoryAsync(WorkOrderId, reworkType, excludePlanId);
            if (result.Success)
            {
                availableBatches = (result.Data ?? new()).ToList();
                ResetSelections();

                if (availableBatches.Count == 0)
                {
                    errorMessage = "未找到符合条件的可用库存";
                }
            }
            else
            {
                errorMessage = result.Message ?? "查询可用库存失败";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"加载失败: {ex.Message}";
        }
        finally
        {
            isLoadingInventory = false;
            StateHasChanged();
        }
    }

    private void ResetSelections()
    {
        selections.Clear();
        inputMultiples.Clear();
        usageModes.Clear();
        usedQuantities.Clear();
        usedWeights.Clear();

        foreach (var batch in availableBatches)
        {
            selections[batch.Id] = false;
            inputMultiples[batch.Id] = 1;
            usageModes[batch.Id] = "All";
            usedQuantities[batch.Id] = null;
            usedWeights[batch.Id] = null;
        }
    }

    private bool GetSelection(int batchId) => selections.GetValueOrDefault(batchId, false);
    private int GetInputMultiple(int batchId) => inputMultiples.GetValueOrDefault(batchId, 1);
    private string GetUsageMode(int batchId) => usageModes.GetValueOrDefault(batchId, "All");
    private int? GetUsedQuantity(int batchId) => usedQuantities.GetValueOrDefault(batchId);
    private decimal? GetUsedWeight(int batchId) => usedWeights.GetValueOrDefault(batchId);
    private void OnSelectionChanged(int batchId, bool value)
    {
        if (selections.ContainsKey(batchId))
            selections[batchId] = value;
    }

    private void OnInputMultipleChanged(int batchId, int value)
    {
        if (inputMultiples.ContainsKey(batchId))
            inputMultiples[batchId] = value;
    }

    private void OnUsageModeChanged(int batchId, string value)
    {
        if (usageModes.ContainsKey(batchId))
            usageModes[batchId] = value;
    }

    private void OnUsedQuantityChanged(int batchId, int? value)
    {
        if (usedQuantities.ContainsKey(batchId))
            usedQuantities[batchId] = value;
    }

    private void OnUsedWeightChanged(int batchId, decimal? value)
    {
        if (usedWeights.ContainsKey(batchId))
            usedWeights[batchId] = value;
        var mode = usageModes.GetValueOrDefault(batchId, "All");
        if (mode == "Partial" && !usedQuantities.ContainsKey(batchId))
        {
            usedQuantities[batchId] = 0;
        }
    }

