    private HashSet<int> selectedBatchIds => selections.Where(s => s.Value).Select(s => s.Key).ToHashSet();

    protected override async Task OnInitializedAsync()
    {
        await InitProcessGroupColumnsAsync();
        try
        {
            var result = await WorkOrderService.GetByIdAsync(WorkOrderId);
            workOrder = result.Success ? result.Data : null;

            if (IsEditMode)
            {
                await LoadExistingPlan();
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"加载工单失败: {ex.Message}", Severity.Error);
        }
        finally
        {
            isLoadingWorkOrder = false;
        }
    }

    private ReworkType GetReworkType()
    {
        return activeTab switch
        {
            0 => ReworkType.EmptyDrawing,
            1 => ReworkType.FewerPass,
            2 => ReworkType.ManualSelect,
            _ => ReworkType.EmptyDrawing
        };
    }

    private async Task LoadExistingPlan()
    {
        try
        {
            var planResult = await MaterialPlanService.GetInventoryPlanByIdAsync(PlanId);
            if (!planResult.Success || planResult.Data == null)
            {
                Snackbar.Add("改制计划不存在", Severity.Error);
                GoBack();
                return;
            }

            existingPlan = planResult.Data;
            var plan = planResult.Data;

            // 设置改制类型Tab
            activeTab = plan.ReworkType switch
            {
                ReworkType.EmptyDrawing => 0,
                ReworkType.FewerPass => 1,
                ReworkType.ManualSelect => 2,
                _ => 0
            };

            // 加载可用库存（排除自身）
            await LoadAvailableInventory(excludePlanId: PlanId);

            // 自动选中匹配批次
            var matchBatch = availableBatches.FirstOrDefault(b => b.BatchNo == plan.InventoryBatchNo);
            if (matchBatch != null)
            {
                var batchId = matchBatch.Id;
                selections[batchId] = true;
                inputMultiples[batchId] = plan.InputMultiple;
                usageModes[batchId] = plan.UsageMode;
                usedQuantities[batchId] = plan.UsedQuantity;
                usedWeights[batchId] = plan.UsedWeight;
                StateHasChanged();
            }

            // 加载已有的工序组
            var pgResult = await ProcessGroupService.GetByPlanAsync(3, PlanId);
            if (pgResult.Success && pgResult.Data != null)
            {
                _pendingProcessGroups = pgResult.Data.Select(p => new SavePlanProcessGroupItem
                {
                    Id = p.Id,
                    SequenceNumber = p.SequenceNumber,
                    ProcessName = p.ProcessName,
                    ManufacturingSpec = p.ManufacturingSpec,
                    OuterDiameterTolerance = p.OuterDiameterTolerance,
                    WallThicknessTolerance = p.WallThicknessTolerance,
                    ManufacturingLength = p.ManufacturingLength,
                    CuttingTreatment = p.CuttingTreatment,
                    Remark = p.Remark,
                    ColdRollDraw = p.ColdRollDraw,
                    OilPipeCut = p.OilPipeCut,
                    Degrease = p.Degrease,
                    EmulsionWash = p.EmulsionWash,
                    UltrasonicWash = p.UltrasonicWash,
                    ClothPolish = p.ClothPolish,
                    BrightAnnealing = p.BrightAnnealing,
                    Solution = p.Solution,
                    Straighten = p.Straighten,
                    Cut = p.Cut,
                    ThicknessMeasure = p.ThicknessMeasure,
                    Pickle = p.Pickle,
                    OuterPolish = p.OuterPolish,
                    InnerPolish = p.InnerPolish,
                    InnerGrinding = p.InnerGrinding,
                    OuterSpotGrinding = p.OuterSpotGrinding,
                    SandBlasting = p.SandBlasting,
                    ShotBlasting = p.ShotBlasting,
                    Inspection = p.Inspection,
                    WeldingHead = p.WeldingHead,
                    Welding = p.Welding,
                    Lubrication = p.Lubrication,
                    Packing = p.Packing,
                    Warehouse = p.Warehouse,
                    Extra1 = p.Extra1,
                    Extra2 = p.Extra2
                }).ToList();
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"加载改制计划失败: {ex.Message}", Severity.Error);
        }
    }

    // ===== 工序组内联操作 =====

    private void AddProcessGroupRow()
    {
        _pendingProcessGroups.Add(new SavePlanProcessGroupItem
        {
            ProcessName = ProcessKeys.RoughTubeProcessing
        });
        ApplyProcessGroupDefaults(_pendingProcessGroups.Last());
    }

    private void DeleteProcessGroupRow(SavePlanProcessGroupItem pg)
    {
        _pendingProcessGroups.Remove(pg);
    }

    private void ApplyProcessGroupDefaults(SavePlanProcessGroupItem pg)
    {
        // 清空所有工段
        foreach (var key in SectionDefs.PropertyNames)
            SetSectionValue(pg, key, null);

        // 配置驱动：从工序配置表（ProcessDefinitions.DefaultSections）读取默认工段，新增工序/改默认工段无需改代码
        var opt = _processOptions.FirstOrDefault(o => string.Equals(o.ProcessKey, pg.ProcessName, StringComparison.OrdinalIgnoreCase));
        if (opt?.DefaultSections is { Count: > 0 })
        {
            foreach (var key in opt.DefaultSections)
                SetSectionValue(pg, key, 1);
        }
    }

