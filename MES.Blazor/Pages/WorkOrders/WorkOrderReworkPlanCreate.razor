@page "/workorders/{WorkOrderId:int}/rework-plan/create"
@page "/workorders/{WorkOrderId:int}/rework-plan/edit/{PlanId:int}"
@using MES.Blazor.Services
@using MES.Core.Enums
@using MES.Blazor.Shared
@using MES.Core.Constants
@using MES.Blazor.Helpers
@using MES.Blazor.Models
@using MES.Core.DTOs.WorkOrder
@using Microsoft.AspNetCore.Authorization
@inject MaterialPlanService MaterialPlanService
@inject MaterialPlanProcessGroupService ProcessGroupService
@inject StandardWorkDayService StandardWorkDayService
@inject ProcessDefinitionService ProcessDefinitionService
@inject WorkOrderService WorkOrderService
@inject ColumnPrefsService ColumnPrefs
@inject NavigationManager Navigation
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject IJSRuntime JS
@attribute [Authorize(Roles = Roles.Policies.WorkOrderEdit)]

<style>
    .rework-inventory-table table {
        table-layout: fixed;
    }
    .rework-inventory-table table th,
    .rework-inventory-table table td {
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }
</style>

<MudContainer MaxWidth="MaxWidth.False" Class="mt-4">
    <MudCard>
        <MudCardHeader>
            <CardHeaderContent>
                <div class="d-flex align-center">
                    <MudIcon Icon="@Icons.Material.Filled.Construction" Class="mr-2" Color="Color.Primary" Size="Size.Medium" />
                    <MudText Typo="Typo.h5" Class="font-weight-bold">@(IsEditMode ? "编辑" : "新增")库料生产改制</MudText>
                </div>
            </CardHeaderContent>
            <CardHeaderActions>
                <MudButton Variant="Variant.Text" OnClick="GoBack">返回上一级</MudButton>
            </CardHeaderActions>
        </MudCardHeader>

        <MudCardContent>
            <div id="rework-plan-create-table">
            @if (isLoadingWorkOrder)
            {
                <MudProgressCircular Indeterminate Size="Size.Large" Class="d-flex justify-center ma-8" />
            }
            else if (workOrder != null)
            {
                <!-- ===== 工单信息 ===== -->
                <WorkOrderInfoCard WorkOrder="workOrder" />

                @if (IsEditMode && existingPlan?.IsOutbound == true)
                {
                    <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-3">
                        该计划批次（@existingPlan.BatchNo）已生产领用出库，不可编辑或取消。如需调整请先删除出库记录。
                    </MudAlert>
                }

                <!-- ===== 二、工序组（内联编辑） ===== -->
                <MudText Typo="Typo.subtitle2" Color="Color.Primary" Class="mb-2 mt-2">
                    <MudIcon Icon="@Icons.Material.Filled.AccountTree" Size="Size.Small" Class="mr-1" />工序组
                </MudText>

                <div class="d-flex flex-wrap align-center" style="gap:8px; margin-bottom:12px; justify-content:flex-end;">
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.Add" OnClick="AddProcessGroupRow">新增工序</MudButton>
                    <ColumnDisplaySelect Columns="pgCols" ShowCommonFields="false"
                                       OnColumnToggle="OnPgColumnToggle"
                                       OnMoveUp="OnPgColumnMove"
                                       OnMoveDown="OnPgColumnMove" />
                    <MudButton Variant="Variant.Text" Size="Size.Small" Color="Color.Default"
                               StartIcon="@Icons.Material.Filled.RestartAlt" OnClick="ResetPgColumns" Class="ml-2">
                        重置
                    </MudButton>
                </div>

                <div class="table-container" style="overflow-x:auto; margin-bottom:12px;">
                    <MudTable Items="@_pendingProcessGroups" Dense="true" Hover="true" Elevation="0" Striped="true"
                              Class="auto-table compact-table" Style="border:1px solid var(--mud-palette-lines-default); border-radius:8px; width:max-content;">
                        <HeaderContent>
                            <MudTh Style="width:45px;">#</MudTh>
                            @if (GetPgCol("ProcessName").Visible) { <MudTh Style="width:120px;">工序名称<span class="required-star">*</span></MudTh> }
                            @if (GetPgCol("ManufacturingSpec").Visible) { <MudTh Style="width:100px;">制造规格<span class="required-star">*</span></MudTh> }
                            @if (GetPgCol("OuterDiameterTolerance").Visible) { <MudTh Style="width:80px;">外径公差</MudTh> }
                            @if (GetPgCol("WallThicknessTolerance").Visible) { <MudTh Style="width:80px;">壁厚公差</MudTh> }
                            @if (GetPgCol("ManufacturingLength").Visible) { <MudTh Style="width:80px;">制造长度</MudTh> }
                            @if (GetPgCol("CuttingTreatment").Visible) { <MudTh Style="width:80px;">断切处理</MudTh> }
                            @if (GetPgCol("Remark").Visible) { <MudTh Style="width:120px;">备注</MudTh> }
                            @foreach (var sc in _sectionCols)
                            {
                                if (GetPgCol(sc.SectionKey).Visible)
                                {
                                    <MudTh Style="width:60px;">@SectionDisplayHelper.GetSectionNameText(sc.SectionKey)</MudTh>
                                }
                            }
                            <MudTh Style="width:60px;">操作</MudTh>
                        </HeaderContent>
                        <RowTemplate Context="pg">
                            <MudTd Style="width:45px;">@(_pendingProcessGroups.IndexOf(pg) + 1)</MudTd>
                            @if (GetPgCol("ProcessName").Visible)
                            {
                                <MudTd Style="width:120px;">
                                    <MudSelect T="string" Value="@pg.ProcessName"
                                               ValueChanged="@((string v) => { pg.ProcessName = v; ApplyProcessGroupDefaults(pg); })"
                                               Dense="true" Variant="Variant.Outlined" Size="Size.Small"
                                               ToStringFunc="@((string v) => ProcessDisplayHelper.GetProcessNameText(v))">
                                        @foreach (var opt in _processOptions)
                                        {
                                            <MudSelectItem Value="@opt.ProcessKey">@opt.ProcessName</MudSelectItem>
                                        }
                                    </MudSelect>
                                </MudTd>
                            }
                            @if (GetPgCol("ManufacturingSpec").Visible) { <MudTd><MudTextField T="string" @bind-Value="pg.ManufacturingSpec" Dense="true" Variant="Variant.Outlined" Size="Size.Small" /></MudTd> }
                            @if (GetPgCol("OuterDiameterTolerance").Visible) { <MudTd><MudTextField T="string" @bind-Value="pg.OuterDiameterTolerance" Dense="true" Variant="Variant.Outlined" Size="Size.Small" /></MudTd> }
                            @if (GetPgCol("WallThicknessTolerance").Visible) { <MudTd><MudTextField T="string" @bind-Value="pg.WallThicknessTolerance" Dense="true" Variant="Variant.Outlined" Size="Size.Small" /></MudTd> }
                            @if (GetPgCol("ManufacturingLength").Visible) { <MudTd><MudTextField T="string" @bind-Value="pg.ManufacturingLength" Dense="true" Variant="Variant.Outlined" Size="Size.Small" /></MudTd> }
                            @if (GetPgCol("CuttingTreatment").Visible) { <MudTd><MudTextField T="string" @bind-Value="pg.CuttingTreatment" Dense="true" Variant="Variant.Outlined" Size="Size.Small" /></MudTd> }
                            @if (GetPgCol("Remark").Visible) { <MudTd><MudTextField T="string" @bind-Value="pg.Remark" Dense="true" Variant="Variant.Outlined" Size="Size.Small" /></MudTd> }
                            @foreach (var sc in _sectionCols)
                            {
                                if (GetPgCol(sc.SectionKey).Visible)
                                {
                                    <MudTd>
                                        <MudNumericField T="int?"
                                                         Value="@GetSectionValue(pg, sc.SectionKey)"
                                                         ValueChanged="@((int? v) => SetSectionValue(pg, sc.SectionKey, v))"
                                                         Dense="true" Variant="Variant.Outlined" Size="Size.Small" HideSpinButtons="true" />
                                    </MudTd>
                                }
                            }
                            <MudTd><MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" Title="删除" OnClick="@(() => DeleteProcessGroupRow(pg))" /></MudTd>
                        </RowTemplate>
                        <NoRecordsContent>
                            <MudText Class="pa-4 text-center" Color="Color.Secondary">暂无工序组，可点击"新增工序"添加</MudText>
                        </NoRecordsContent>
                    </MudTable>
                </div>

                <!-- ===== 三、改制类型切换 ===== -->
                <MudTabs @bind-ActivePanelIndex="activeTab" Class="mb-3" Elevation="0" Outlined="true" Centered="true">
                    <MudTabPanel Text="空拉改制" />
                    <MudTabPanel Text="少道次改制" />
                    <MudTabPanel Text="人工选择改制" />
                </MudTabs>

                <!-- ===== 展示可用库存按钮 ===== -->
                <div class="d-flex align-center mb-3">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.Search"
                               OnClick="() => LoadAvailableInventory()"
                               Disabled="isLoadingInventory">
                        @(isLoadingInventory ? "加载中..." : "展示可用库存")
                    </MudButton>
                    @if (errorMessage != null)
                    {
                        <MudText Typo="Typo.body2" Color="Color.Warning" Class="ml-3">
                            @errorMessage
                        </MudText>
                    }
                </div>

                <!-- ===== 可用库存列表 ===== -->
                @if (availableBatches.Any())
                {
                    <MudText Typo="Typo.subtitle2" Color="Color.Primary" Class="mb-2">
                        <MudIcon Icon="@Icons.Material.Filled.Inventory" Size="Size.Small" Class="mr-1" />可用库存列表
                        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="ml-2" Style="display:inline;">
                            （已选 @selectedBatchIds.Count 项）
                        </MudText>
                    </MudText>

                    <!-- 操作按钮 -->
                    <div class="d-flex align-center mb-2 flex-wrap" Style="gap:8px;">
                        <MudButton Variant="Variant.Outlined" Color="Color.Info"
                                   Size="Size.Small"
                                   OnClick="ToggleShowSelected"
                                   StartIcon="@(showSelectedOnly ? Icons.Material.Filled.List : Icons.Material.Filled.FilterAlt)">
                            @(showSelectedOnly ? "显示全部" : "选定")
                        </MudButton>
                        <span class="flex-grow-1"></span>
                        <MudButton Variant="Variant.Text" OnClick="GoBack" Size="Size.Small">取消</MudButton>
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                                   OnClick="SavePlans"
                                   Disabled="selectedBatchIds.Count == 0 || (IsEditMode && existingPlan?.IsOutbound == true)"
                                   Loading="@isSaving">
                            保存
                        </MudButton>
                    </div>

                    <div Style="border:1px solid var(--mud-palette-lines-default); border-radius:8px;" Class="mb-3">
                        <MudTable Items="@filteredBatches" Class="rework-inventory-table auto-table" Dense="true" Hover="true" Striped="true" Elevation="0" RowsPerPage="5" RowsPerPageLabel="每页行数:">
                            <HeaderContent>
                                <MudTh Style="width:32px;">选择</MudTh>
                                <MudTh Style="width:48px;">
                                    <span @onclick="() => SortBy(nameof(AvailableInventoryBatchDto.MaterialType))" Style="cursor:pointer;">
                                        @SortIcon("MaterialType") 物料类型
                                    </span>
                                </MudTh>
                                <MudTh Style="width:50px;">
                                    <span @onclick="() => SortBy(nameof(AvailableInventoryBatchDto.PlantGrade))" Style="cursor:pointer;">
                                        @SortIcon("PlantGrade") 工厂牌号
                                    </span>
                                </MudTh>
                                <MudTh Style="width:55px;">
                                    <span @onclick="() => SortBy(nameof(AvailableInventoryBatchDto.Specification))" Style="cursor:pointer;">
                                        @SortIcon("Specification") 名义规格
                                    </span>
                                </MudTh>
                                <MudTh Style="width:40px;">
                                    <span @onclick="() => SortBy(nameof(AvailableInventoryBatchDto.LengthStatus))" Style="cursor:pointer;">
                                        @SortIcon("LengthStatus") 长度状态
                                    </span>
                                </MudTh>
                                <MudTh Style="width:35px;">
                                    <span @onclick="() => SortBy(nameof(AvailableInventoryBatchDto.MinLength))" Style="cursor:pointer;">
                                        @SortIcon("MinLength") 最小长度
                                    </span>
                                </MudTh>
                                <MudTh Style="width:35px;">
                                    <span @onclick="() => SortBy(nameof(AvailableInventoryBatchDto.MaxLength))" Style="cursor:pointer;">
                                        @SortIcon("MaxLength") 最大长度
                                    </span>
                                </MudTh>
                                <MudTh Style="width:45px;">
                                    <span @onclick="() => SortBy(nameof(AvailableInventoryBatchDto.RemainingQuantity))" Style="cursor:pointer;">
                                        @SortIcon("RemainingQuantity") 可用支数
                                    </span>
                                </MudTh>
                                <MudTh Style="width:45px;">
                                    <span @onclick="() => SortBy(nameof(AvailableInventoryBatchDto.RemainingWeight))" Style="cursor:pointer;">
                                        @SortIcon("RemainingWeight") 可用重量
                                    </span>
                                </MudTh>
                                <MudTh Style="width:45px;">
                                    <span @onclick="() => SortBy(nameof(AvailableInventoryBatchDto.UnitWeight))" Style="cursor:pointer;">
                                        @SortIcon("UnitWeight") 理论单支重
                                    </span>
                                </MudTh>
                                <MudTh Style="width:40px;">
                                    <span @onclick="() => SortBy(nameof(AvailableInventoryBatchDto.ManufacturingStatus))" Style="cursor:pointer;">
                                        @SortIcon("ManufacturingStatus") 制造状态
                                    </span>
                                </MudTh>
                                <MudTh Style="width:48px;">
                                    <span @onclick="() => SortBy(nameof(AvailableInventoryBatchDto.LocationArea))" Style="cursor:pointer;">
                                        @SortIcon("LocationArea") 放置框架
                                    </span>
                                </MudTh>
                                <MudTh Style="width:48px; background-color: rgba(255, 152, 0, 0.08);">投料制成倍</MudTh>
                                <MudTh Style="width:48px; background-color: rgba(255, 152, 0, 0.08);">使用模式</MudTh>
                                <MudTh Style="width:48px; background-color: rgba(255, 152, 0, 0.08);">出库支数</MudTh>
                                <MudTh Style="width:48px; background-color: rgba(255, 152, 0, 0.08);">出库重量</MudTh>
                            </HeaderContent>
                            <RowTemplate>
                                <MudTd>
                                    <MudCheckBox Value="@GetSelection(context.Id)"
                                                 ValueChanged="@((bool v) => OnSelectionChanged(context.Id, v))"
                                                 Color="Color.Primary" />
                                </MudTd>
                                <MudTd DataLabel="物料类型">@DisplayHelper.GetMaterialTypeText(context.MaterialType)</MudTd>
                                <MudTd DataLabel="工厂牌号">@context.PlantGrade</MudTd>
                                <MudTd DataLabel="名义规格">@context.Specification</MudTd>
                                <MudTd DataLabel="长度状态">@DisplayHelper.GetLengthStatusText(context.LengthStatus?.ToString())</MudTd>
                                <MudTd DataLabel="最小长度">@DisplayHelper.FormatNullableDecimal(context.MinLength)</MudTd>
                                <MudTd DataLabel="最大长度">@DisplayHelper.FormatNullableDecimal(context.MaxLength)</MudTd>
                                <MudTd DataLabel="可用支数">
                                    @(context.RemainingQuantity - context.ReservedQuantity)
                                    @if (context.ReservedQuantity > 0)
                                    {
                                        <MudText Typo="Typo.caption" Color="Color.Warning" Style="display:inline;">（已预留@(context.ReservedQuantity)）</MudText>
                                    }
                                </MudTd>
                                <MudTd DataLabel="可用重量">@((context.RemainingWeight - context.ReservedWeight).ToString("G29"))</MudTd>
                                <MudTd DataLabel="理论单支重">@DisplayHelper.FormatNullableDecimal(context.UnitWeight)</MudTd>
                                <MudTd DataLabel="制造状态">@DisplayHelper.GetDeliveryStateText(context.ManufacturingStatus)</MudTd>
                                <MudTd DataLabel="放置框架">@GetLocation(context)</MudTd>
                                <MudTd DataLabel="投料制成倍" Style="background-color: rgba(255, 152, 0, 0.08);">
                                    @if (GetSelection(context.Id))
                                    {
                                        <MudNumericField HideSpinButtons="true" Value="@GetInputMultiple(context.Id)"
                                                         ValueChanged="@((int v) => OnInputMultipleChanged(context.Id, v))"
                                                         Size="Size.Small"
                                                         Variant="Variant.Outlined"
                                                         Min="1" Max="99"
                                                         Class="my-n2" Style="width:42px;" Format="G29" />
                                    }
                                </MudTd>
                                <MudTd DataLabel="使用模式" Style="background-color: rgba(255, 152, 0, 0.08);">
                                    @if (GetSelection(context.Id))
                                    {
                                        <MudSelect Value="@GetUsageMode(context.Id)"
                                                   ValueChanged="@((string v) => OnUsageModeChanged(context.Id, v))"
                                                   Size="Size.Small"
                                                   Variant="Variant.Outlined"
                                                   Class="my-n2" Style="width:52px;">
                                            <MudSelectItem Value="@("All")" Disabled="@(context.ReservedQuantity > 0)">全部</MudSelectItem>
                                            <MudSelectItem Value="@("Partial")">部分</MudSelectItem>
                                        </MudSelect>
                                    }
                                </MudTd>
                                <MudTd DataLabel="出库支数" Style="background-color: rgba(255, 152, 0, 0.08);">
                                    @if (GetSelection(context.Id) && GetUsageMode(context.Id) == "Partial")
                                    {
                                        <MudNumericField HideSpinButtons="true" Value="@GetUsedQuantity(context.Id)"
                                                         ValueChanged="@((int? v) => OnUsedQuantityChanged(context.Id, v))"
                                                         Size="Size.Small"
                                                         Variant="Variant.Outlined"
                                                         Min="1" Max="@(context.RemainingQuantity - context.ReservedQuantity)"
                                                         Class="my-n2" Style="width:42px;" Format="G29" />
                                    }
                                    else if (GetSelection(context.Id))
                                    {
                                        <MudText Typo="Typo.body2">全部</MudText>
                                    }
                                </MudTd>
                                <MudTd DataLabel="出库重量" Style="background-color: rgba(255, 152, 0, 0.08);">
                                    @if (GetSelection(context.Id) && GetUsageMode(context.Id) == "Partial")
                                    {
                                        <MudNumericField HideSpinButtons="true" Value="@GetUsedWeight(context.Id)" Format="G29"
                                                         ValueChanged="@((decimal? v) => OnUsedWeightChanged(context.Id, v))"
                                                         Size="Size.Small"
                                                         Variant="Variant.Outlined"
                                                         Min="0"
                                                         Class="my-n2" Style="width:48px;" />
                                    }
                                    else if (GetSelection(context.Id))
                                    {
                                        <MudText Typo="Typo.body2">@context.RemainingWeight.ToString("G29")</MudText>
                                    }
                                </MudTd>
                            </RowTemplate>
                        </MudTable>
                    </div>

                }
            }
            </div>
        </MudCardContent>
    </MudCard>
</MudContainer>

@code {
    [Parameter] public int WorkOrderId { get; set; }
    [Parameter] public int PlanId { get; set; }

    private bool IsEditMode => PlanId > 0;

    private WorkOrderDetailDto? workOrder;
    private InventoryPlanDto? existingPlan;
    private List<AvailableInventoryBatchDto> availableBatches = new();
    private bool isLoadingWorkOrder = true;
    private bool isLoadingInventory = false;
    private bool isSaving = false;
    private string? errorMessage;
    private int activeTab;
    private bool showSelectedOnly = false;

    // 排序状态
    private string sortColumn = "Specification";
    private bool sortDescending = true;

    private bool _isArrowNavSetup;

    private List<AvailableInventoryBatchDto> filteredBatches
    {
        get
        {
            var query = availableBatches.AsEnumerable();
            if (showSelectedOnly)
                query = query.Where(b => GetSelection(b.Id));

            // 排序
            query = sortColumn switch
            {
                nameof(AvailableInventoryBatchDto.MaterialType) => SortQuery(query, b => b.MaterialType),
                nameof(AvailableInventoryBatchDto.PlantGrade) => SortQuery(query, b => b.PlantGrade),
                nameof(AvailableInventoryBatchDto.Specification) => SortQuery(query, b => b.Specification),
                nameof(AvailableInventoryBatchDto.LengthStatus) => SortQuery(query, b => b.LengthStatus),
                nameof(AvailableInventoryBatchDto.MinLength) => SortQuery(query, b => b.MinLength),
                nameof(AvailableInventoryBatchDto.MaxLength) => SortQuery(query, b => b.MaxLength),
                nameof(AvailableInventoryBatchDto.RemainingQuantity) => SortQuery(query, b => b.RemainingQuantity),
                nameof(AvailableInventoryBatchDto.RemainingWeight) => SortQuery(query, b => b.RemainingWeight),
                nameof(AvailableInventoryBatchDto.UnitWeight) => SortQuery(query, b => b.UnitWeight),
                nameof(AvailableInventoryBatchDto.ManufacturingStatus) => SortQuery(query, b => b.ManufacturingStatus),
                nameof(AvailableInventoryBatchDto.LocationArea) => SortQuery(query, b => b.LocationArea),
                _ => SortQuery(query, b => b.Specification)
            };

            return query.ToList();
        }
    }

    private IOrderedEnumerable<AvailableInventoryBatchDto> SortQuery<T>(IEnumerable<AvailableInventoryBatchDto> query, Func<AvailableInventoryBatchDto, T> keySelector)
    {
        return sortDescending
            ? query.OrderByDescending(keySelector)
            : query.OrderBy(keySelector);
    }

    private void SortBy(string column)
    {
        if (sortColumn == column)
            sortDescending = !sortDescending;
        else
        {
            sortColumn = column;
            sortDescending = false;
        }
    }

    private string SortIcon(string column)
    {
        if (sortColumn != column) return "";
        return sortDescending ? " ▼" : " ▲";
    }

    // 选择数据：batchId -> selected
    private Dictionary<int, bool> selections = new();
    private Dictionary<int, int> inputMultiples = new();
    private Dictionary<int, string> usageModes = new();
    private Dictionary<int, int?> usedQuantities = new();
    private Dictionary<int, decimal?> usedWeights = new();

    // 工序组（页面级，编辑/创建共用）
    private List<SavePlanProcessGroupItem> _pendingProcessGroups = new();
    private const string PgColPrefsKey = "wo_rework_plan_create_pg";
    private List<ColumnDef> pgCols = new();

    private async Task InitProcessGroupColumnsAsync()
    {
        await LoadSectionColsAsync();
        _processOptions = await ProcessOptionsHelper.LoadAsync(ProcessDefinitionService);

        pgCols = new List<ColumnDef>
        {
            new() { Key = "ProcessName", Label = "工序名称", Visible = true },
            new() { Key = "ManufacturingSpec", Label = "制造规格", Visible = true },
            new() { Key = "OuterDiameterTolerance", Label = "外径公差", Visible = true },
            new() { Key = "WallThicknessTolerance", Label = "壁厚公差", Visible = true },
            new() { Key = "ManufacturingLength", Label = "制造长度", Visible = true },
            new() { Key = "CuttingTreatment", Label = "断切处理", Visible = true },
            new() { Key = "Remark", Label = "备注", Visible = false },
        };

        // 工段列（从参数表加载启用工段，按 DisplayOrder 排序；失败降级为预置 26 工段）
        foreach (var sc in _sectionCols)
        {
            pgCols.Add(new ColumnDef { Key = sc.SectionKey, Label = SectionDisplayHelper.GetSectionNameText(sc.SectionKey), Visible = true });
        }

        var saved = await ColumnPrefs.LoadAsync(PgColPrefsKey, null);
        if (saved.Count > 0)
        {
            foreach (var savedCol in saved)
            {
                var match = pgCols.FirstOrDefault(c => c.Key == savedCol.Key);
                if (match != null) match.Visible = savedCol.Visible;
            }
            var ordered = new List<ColumnDef>();
            foreach (var savedCol in saved)
            {
                var match = pgCols.FirstOrDefault(c => c.Key == savedCol.Key);
                if (match != null) ordered.Add(match);
            }
            foreach (var col in pgCols)
            {
                if (!ordered.Contains(col)) ordered.Add(col);
            }
            pgCols = ordered;
        }
    }

    private ColumnDef GetPgCol(string key) =>
        pgCols.FirstOrDefault(c => c.Key == key) ?? new ColumnDef { Key = key, Label = key, Visible = true };

    // 工段列（从参数表加载启用工段，按 DisplayOrder 排序；失败降级为预置 26 工段）
    private List<SectionInfoDto> _sectionCols = new();
    private List<ProcessInfoDto> _processOptions = new();

    private async Task LoadSectionColsAsync()
    {
        var r = await StandardWorkDayService.GetEnabledSectionsAsync();
        if (r.Success && r.Data != null)
        {
            _sectionCols = r.Data;
        }
        else
        {
            _sectionCols = SectionDefs.PropertyNames
