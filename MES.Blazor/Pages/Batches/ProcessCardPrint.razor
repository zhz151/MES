        new() { BlockKey = "ProcessGroup", Key = "OuterDiameterTolerance", Label = "外径公差", Visible = true },
        new() { BlockKey = "ProcessGroup", Key = "WallThicknessTolerance", Label = "壁厚公差", Visible = true },
        new() { BlockKey = "ProcessGroup", Key = "ManufacturingLength", Label = "制造长度", Visible = true },
        new() { BlockKey = "ProcessGroup", Key = "CuttingTreatment", Label = "断切处理", Visible = false },
        new() { BlockKey = "ProcessGroup", Key = "ManufacturingMultiple", Label = "制成倍数", Visible = false },
        new() { BlockKey = "ProcessGroup", Key = "Remark", Label = "备注", Visible = false },
        new() { BlockKey = "ProcessGroup", Key = "ColdRollDraw", Label = "冷轧拔", Visible = false },
        new() { BlockKey = "ProcessGroup", Key = "OilPipeCut", Label = "油管断", Visible = false },
        new() { BlockKey = "ProcessGroup", Key = "Degrease", Label = "去油", Visible = false },
        new() { BlockKey = "ProcessGroup", Key = "Solution", Label = "固溶", Visible = false },
        new() { BlockKey = "ProcessGroup", Key = "Straighten", Label = "矫直", Visible = false },
        new() { BlockKey = "ProcessGroup", Key = "Cut", Label = "断切", Visible = false },
