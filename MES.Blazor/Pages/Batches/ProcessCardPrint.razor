        new() { BlockKey = "Warehouse", Key = "SourceBatchNo", Label = "来源库存批次号", Visible = true },
        new() { BlockKey = "Warehouse", Key = "SourceMaterialType", Label = "原料类型", Visible = true },
        new() { BlockKey = "Warehouse", Key = "InboundSource", Label = "入库来源", Visible = true },
