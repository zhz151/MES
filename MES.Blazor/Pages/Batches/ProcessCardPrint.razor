    private List<SectionInfoDto> _sectionCols = new();

    private async Task LoadSectionColsAsync()
    {
        var r = await StandardWorkDayService.GetEnabledSectionsAsync();
        if (r.Success && r.Data != null)
        {
            _sectionCols = r.Data;
        }
        else
        {
            _sectionCols = SectionDefs.PropertyNames
                .Select((k, i) => new SectionInfoDto
                {
                    SectionKey = k,
                    SectionName = SectionDefs.PropertyToName[k],
                    DisplayOrder = i + 1,
                    IsEnabled = true
                })
                .ToList();
        }
    }

    // ========== 初始化 ==========

    protected override async Task OnInitializedAsync()
    {
        await LoadSectionColsAsync();

        // 加载批次列表列偏好
        _allColumns = GetAllColumnDefs();
        var savedList = await ColumnPrefs.LoadAsync("process_card_print_list", null);
        if (savedList.Count > 0)
        {
            foreach (var s in savedList)
            {
                var match = _allColumns.FirstOrDefault(c => c.Key == s.Key);
                if (match != null)
                    match.Visible = s.Visible;
            }
            var reordered = new List<ColumnDef>();
            foreach (var s in savedList)
            {
                var match = _allColumns.FirstOrDefault(c => c.Key == s.Key);
                if (match != null && !reordered.Contains(match))
                    reordered.Add(match);
            }
            foreach (var c in _allColumns)
            {
                if (!reordered.Contains(c))
                    reordered.Add(c);
            }
            _allColumns = reordered;
        }

        // 加载格式设置（数据库全局配置优先，失败/无配置回退默认 4 维布局）
        allColumns = await LoadFormatColumnsAsync();

        // 加载打印版式配置（字体/字号，数据库全局优先，失败/无配置回退默认）
        await LoadStyleItemsAsync();

        // 恢复排序/筛选状态
        var savedState = await PageState.LoadAsync("processcardprint");
        if (savedState != null)
        {
            sortColumn = savedState.SortBy ?? "batchno";
            sortDescending = savedState.IsDescending;
            _searchKeyword = savedState.Keyword ?? string.Empty;
            if (savedState.Extras?.ContainsKey("columnFilters") == true)
            {
                try
                {
                    var raw = savedState.Extras["columnFilters"];
                    var dict = JsonSerializer.Deserialize<Dictionary<string, List<string>>>(raw);
                    if (dict != null)
                        _columnFilters = dict.ToDictionary(kv => kv.Key, kv => new HashSet<string>(kv.Value));
                }
                catch { }
            }
        }

        // 状态恢复后重新加载表格数据（首次渲染时 ServerData 可能已用默认值加载）
        if (savedState != null && table != null)
            await table.ReloadServerData();

        // 加载筛选上下文（ExcelFilter 下拉选项），完成后由表格触发首次数据加载
        await LoadFilterContextsAsync();
    }

    // ========== 格式设置（数据库全局配置） ==========

    /// <summary>格式设置面板区块分组（固定区块顺序）</summary>
    private List<IGrouping<string, ProcessCardColumnDef>> FormatBlocks =>
        allColumns.GroupBy(c => c.BlockKey).OrderBy(g => BlockOrder(g.Key)).ToList();

    /// <summary>固定区块顺序：BatchInfo→Quality→Warehouse→WorkOrder→ProcessGroup</summary>
    private static int BlockOrder(string blockKey) => blockKey switch
    {
        "BatchInfo" => 1,
        "Quality" => 2,
        "Warehouse" => 3,
        "WorkOrder" => 4,
        "ProcessGroup" => 5,
        _ => 99
    };

    /// <summary>从数据库加载格式设置：DB 配置覆盖默认列，未配置字段保留默认并兜底权重，按区块顺序+行+列排序</summary>
    private async Task<List<ProcessCardColumnDef>> LoadFormatColumnsAsync()
    {
        var defaults = GetDefaultColumns();
        List<ProcessCardColumnDefinitionDto>? db;
        try { db = await ProcessCardColDefService.GetAllAsync(); }
        catch { db = null; }

        if (db is not { Count: > 0 })
        {
            return defaults
                .OrderBy(c => BlockOrder(c.BlockKey))
                .ThenBy(c => c.BlockKey == "ProcessGroup" ? 1 : c.RowIndex)
                .ThenBy(c => c.ColumnIndex)
                .ToList();
        }

        var dbMap = db.ToDictionary(x => $"{x.BlockKey}|{x.FieldKey}", StringComparer.OrdinalIgnoreCase);
        var result = new List<ProcessCardColumnDef>();
        foreach (var def in defaults)
        {
            if (dbMap.TryGetValue($"{def.BlockKey}|{def.Key}", out var cfg))
            {
                def.Label = cfg.Label;
                def.Visible = cfg.Visible;
                def.RowIndex = cfg.RowIndex;
                def.ColumnIndex = cfg.ColumnIndex;
                def.ColumnWeight = cfg.ColumnWeight;
            }
            else if (def.ColumnWeight <= 0)
            {
                def.ColumnWeight = ProcessCardLayoutDefaults.GetDefaultWeight(def.BlockKey, def.Key);
            }
            result.Add(def);
        }
        // 追加数据库存在但默认列表缺失的字段（极端情况）
        var known = result.Select(r => $"{r.BlockKey}|{r.Key}").ToHashSet(StringComparer.OrdinalIgnoreCase);
        foreach (var cfg in db.Where(c => !known.Contains($"{c.BlockKey}|{c.FieldKey}")))
        {
            result.Add(new ProcessCardColumnDef
            {
                BlockKey = cfg.BlockKey,
                Key = cfg.FieldKey,
                Label = cfg.Label,
                Visible = cfg.Visible,
                RowIndex = cfg.RowIndex,
                ColumnIndex = cfg.ColumnIndex,
                ColumnWeight = cfg.ColumnWeight
            });
        }
        return result
            .OrderBy(c => BlockOrder(c.BlockKey))
            .ThenBy(c => c.BlockKey == "ProcessGroup" ? 1 : c.RowIndex)
            .ThenBy(c => c.ColumnIndex)
            .ToList();
    }

    private void ToggleColumn(bool v, ProcessCardColumnDef col)
    {
        col.Visible = v;
    }

    /// <summary>区块内上移/下移列顺序（交换 ColumnIndex 后归一化连续）</summary>
    private void MoveFormatColumn(ProcessCardColumnDef col, int delta)
    {
        var blockItems = allColumns.Where(c => c.BlockKey == col.BlockKey).OrderBy(c => c.ColumnIndex).ThenBy(c => c.Key).ToList();
        var idx = blockItems.FindIndex(c => ReferenceEquals(c, col));
        var target = idx + delta;
        if (idx < 0 || target < 0 || target >= blockItems.Count) return;

        (col.ColumnIndex, blockItems[target].ColumnIndex) = (blockItems[target].ColumnIndex, col.ColumnIndex);
        var reordered = allColumns.Where(c => c.BlockKey == col.BlockKey).OrderBy(c => c.ColumnIndex).ToList();
        for (int i = 0; i < reordered.Count; i++)
            reordered[i].ColumnIndex = i + 1;
    }

    /// <summary>保存格式设置到数据库（全局生效）</summary>
    private async Task SaveFormatSettings()
    {
        var items = allColumns.Select(c => new ProcessCardColumnDefinitionDto
        {
            BlockKey = c.BlockKey,
            FieldKey = c.Key,
            Label = c.Label,
            Visible = c.Visible,
            RowIndex = c.RowIndex,
            ColumnIndex = c.ColumnIndex,
            ColumnWeight = c.ColumnWeight
        }).ToList();
        var r = await ProcessCardColDefService.SaveAllAsync(items);
        if (r.Success)
            Snackbar.Add($"格式设置已保存（写入 {r.Data} 行）", Severity.Success);
        else
            Snackbar.Add($"保存失败: {r.Message}", Severity.Error);
    }

    private async Task ResetColumnDefaults()
    {
        allColumns = GetDefaultColumns();
        await SaveFormatSettings();
        Snackbar.Add("已恢复默认格式设置", Severity.Normal);
    }

