        new() { BlockKey = "Warehouse", Key = "InputWeight", Label = "领料重量(kg)", Visible = true },
        new() { BlockKey = "Warehouse", Key = "CurrentValidQty", Label = "有效原料支数", Visible = true },
        new() { BlockKey = "Warehouse", Key = "CurrentValidWeight", Label = "有效原料重量(kg)", Visible = true },

        // === 工单信息 ===
        new() { BlockKey = "WorkOrder", Key = "WorkOrderNo", Label = "工单号", Visible = true },
        new() { BlockKey = "WorkOrder", Key = "SalesOrderNo", Label = "源订单号", Visible = true },
        new() { BlockKey = "WorkOrder", Key = "ProductionMainNo", Label = "主号", Visible = true },
        new() { BlockKey = "WorkOrder", Key = "ProductionSubNo", Label = "次号", Visible = false },
        new() { BlockKey = "WorkOrder", Key = "OrderItemIds", Label = "项次ID", Visible = false },
        new() { BlockKey = "WorkOrder", Key = "SignDate", Label = "签订日期", Visible = true },
        new() { BlockKey = "WorkOrder", Key = "Salesman", Label = "业务员", Visible = true },
