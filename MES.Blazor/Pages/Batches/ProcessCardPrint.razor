        new() { BlockKey = "WorkOrder", Key = "TotalWeight", Label = "总重量(kg)", Visible = true },
        new() { BlockKey = "WorkOrder", Key = "TotalItemCount", Label = "总项次数", Visible = false },
        new() { BlockKey = "WorkOrder", Key = "ItemDetails", Label = "明细", Visible = false },
