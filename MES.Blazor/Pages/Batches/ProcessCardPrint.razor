        new() { BlockKey = "BatchInfo", Key = "CreatedTime", Label = "创建时间", Visible = false },

        // === 质量要求 ===
        new() { BlockKey = "Quality", Key = "SolutionParams", Label = "固溶参数", Visible = true },
