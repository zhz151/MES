@page "/process-card-print"
@using MES.Core.Models
@using MES.Blazor.Services
@using MES.Blazor.Helpers
@using MES.Core.DTOs.Batch
@using MES.Core.DTOs.Configuration
@using MES.Core.Constants
@using Microsoft.AspNetCore.Authorization
@using System.Text.Json
@inject BatchService BatchService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject ColumnPrefsService ColumnPrefs
@inject IJSRuntime JS
@inject PageStateService PageState
@inject HttpClient Http
@inject StandardWorkDayService StandardWorkDayService
@inject ProcessCardColumnDefinitionService ProcessCardColDefService
@inject ProcessCardStyleDefinitionService ProcessCardStyleDefService
@attribute [Authorize(Roles = Roles.Policies.BatchRead)]

<MudContainer MaxWidth="MaxWidth.False" Class="mt-4 pl-0">
    <!-- 页眉 -->
    <MudCard Class="mb-4 compact-card">
        <MudCardHeader>
            <CardHeaderContent>
                <MudText Typo="Typo.h5" Class="font-weight-bold">
                    <MudIcon Icon="@Icons.Material.Filled.Print" Class="mr-2" Color="Color.Primary" />
                    工艺流转卡打印
                </MudText>
            </CardHeaderContent>
            <CardHeaderActions>
                <MudButton Variant="Variant.Text" Color="Color.Default"
                           StartIcon="@Icons.Material.Filled.ArrowBack"
                           OnClick='() => Navigation.NavigateTo("/batches")'>
                    返回批次列表
                </MudButton>
            </CardHeaderActions>
        </MudCardHeader>
    </MudCard>

    <!-- 格式设置面板 -->
    <MudCard Class="mb-4 compact-card">
        <MudCardHeader>
            <CardHeaderContent>
                <div class="d-flex align-center">
                    <MudIcon Icon="@Icons.Material.Filled.Settings" Class="mr-1" Color="Color.Warning" />
                    <MudText Typo="Typo.h6" Class="font-weight-bold">格式设置</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="ml-2">调整字段的启用、所属行、列顺序与列宽权重，保存后全局生效</MudText>
                </div>
            </CardHeaderContent>
            <CardHeaderActions>
                <MudButton Variant="Variant.Outlined" Size="Size.Small"
                           StartIcon="@(showSettings ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)"
                           OnClick="() => showSettings = !showSettings">
                    @(showSettings ? "收起" : "展开")
                </MudButton>
            </CardHeaderActions>
        </MudCardHeader>
        @if (showSettings)
        {
            <MudCardContent>
                <MudTabs>
                    <MudTabPanel Text="字段布局">
                        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-2">
                            启用=是否打印该字段；行=所属行（区块内 1 起，工序组无行概念）；权重=列宽相对比例；上/下箭头调整列顺序。
                        </MudText>
                        @foreach (var blockGroup in FormatBlocks)
                        {
                            <MudText Typo="Typo.subtitle2" Class="font-weight-bold mb-1 mt-2" Style="color:#37474F;">
                                <MudIcon Icon="@GetBlockIcon(blockGroup.Key)" Class="mr-1" Size="Size.Small" />
                                @GetBlockTitle(blockGroup.Key)
                                <MudText Typo="Typo.caption" Color="Color.Secondary" Inline="true">（@(blockGroup.Count()) 个字段）</MudText>
                            </MudText>
                            <div class="d-flex flex-wrap" style="gap: 6px 12px; padding-left: 12px;">
                                @foreach (var col in blockGroup.OrderBy(c => c.ColumnIndex))
                                {
                                    <div class="d-flex align-center" style="min-width: 300px; border:1px solid #eee; border-radius:6px; padding:4px 8px;">
                                        <MudSwitch Value="col.Visible"
                                                   ValueChanged="@((bool v) => col.Visible = v)"
                                                   Color="Color.Primary" Dense="true" Size="Size.Small" />
                                        <MudText Typo="Typo.body2" Class="mr-1" Style="min-width:80px;">@col.Label</MudText>
                                        @if (col.BlockKey != "ProcessGroup")
                                        {
                                            <MudTextField T="int" Value="col.RowIndex"
                                                          ValueChanged="@((int v) => col.RowIndex = Math.Max(1, v))"
                                                          Label="行" Dense="true" Variant="Variant.Outlined"
                                                          Style="width:56px; margin-right:6px;" />
                                        }
                                        <MudTextField T="int" Value="col.ColumnWeight"
                                                      ValueChanged="@((int v) => col.ColumnWeight = Math.Max(1, v))"
                                                      Label="权重" Dense="true" Variant="Variant.Outlined"
                                                      Style="width:64px; margin-right:6px;" />
                                        <MudIconButton Icon="@Icons.Material.Filled.ArrowUpward" Size="Size.Small"
                                                       Title="上移" OnClick="() => MoveFormatColumn(col, -1)" />
                                        <MudIconButton Icon="@Icons.Material.Filled.ArrowDownward" Size="Size.Small"
                                                       Title="下移" OnClick="() => MoveFormatColumn(col, 1)" />
                                    </div>
                                }
                            </div>
                        }
                        <div class="mt-3">
                            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                                       StartIcon="@Icons.Material.Filled.Save" OnClick="SaveFormatSettings">
                                保存格式设置
                            </MudButton>
                            <MudButton Variant="Variant.Text" Color="Color.Warning"
                                       StartIcon="@Icons.Material.Filled.Refresh" OnClick="ResetColumnDefaults" Class="ml-2">
                                恢复默认
                            </MudButton>
                        </div>
                    </MudTabPanel>
                    <MudTabPanel Text="打印版式">
                        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-2">
                            调整工艺卡打印的字样与字体，保存后全局生效；字号非法时自动回退默认。
                        </MudText>
                        <div class="d-flex flex-wrap" style="gap: 6px 12px; padding-left: 12px;">
                            @foreach (var item in styleItems)
                            {
                                <div class="d-flex align-center" style="min-width: 300px; border:1px solid #eee; border-radius:6px; padding:4px 8px;">
                                    <MudText Typo="Typo.body2" Class="mr-1" Style="min-width:100px;">@item.DisplayName</MudText>
                                    <MudTextField T="string" Value="item.Value"
                                                  ValueChanged="@((string v) => item.Value = v)"
                                                  Label="值" Dense="true" Variant="Variant.Outlined"
                                                  Style="width:150px; margin-right:6px;" />
                                    @if (!string.IsNullOrEmpty(item.Remark))
                                    {
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">@item.Remark</MudText>
                                    }
                                </div>
                            }
                        </div>
                        <div class="mt-3">
                            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                                       StartIcon="@Icons.Material.Filled.Save" OnClick="SaveStyleSettings">
                                保存版式设置
                            </MudButton>
                            <MudButton Variant="Variant.Text" Color="Color.Warning"
                                       StartIcon="@Icons.Material.Filled.Refresh" OnClick="ResetStyleDefaults" Class="ml-2">
                                恢复默认
                            </MudButton>
                        </div>
                    </MudTabPanel>
                </MudTabs>
            </MudCardContent>
        }
    </MudCard>

    <!-- 批次列表 -->
    <MudCard Class="compact-card">
        <MudCardHeader>
            <CardHeaderContent>
                <MudText Typo="Typo.h6" Class="font-weight-bold">
                    <MudIcon Icon="@Icons.Material.Filled.List" Class="mr-1" Color="Color.Primary" />
                    选择批次
                </MudText>
            </CardHeaderContent>
        </MudCardHeader>
        <MudCardContent>
            <!-- 搜索栏 -->
            <MudGrid>
                <MudItem xs="12" md="6">
                    <MudTextField T="string"
                                  Label="模糊搜索 - 生产编号/挂牌号/工单号/订单号/主号/次号"
                                  Value="_searchKeyword"
                                  ValueChanged="@OnSearchChanged"
                                  Immediate="true"
                                  DebounceInterval="500"
                                  Clearable="true"
                                  ClearButton="true"
                                  Adornment="Adornment.End"
                                  AdornmentIcon="@Icons.Material.Filled.Search" />
                </MudItem>
            </MudGrid>

            <!-- 数据表格 -->
            <div id="process-card-print-list-table">
            @{
                var _groupHeaders = GetGroupHeaders();
                var _totalTableWidth = _visibleColumns.Sum(c => int.TryParse(c.Width, out var w) ? w : 100) + 40 + 90;
            }
            @* 工具栏 *@
            <div class="woe-toolbar" style="min-height:28px;padding:2px 0;display:flex;align-items:center;">
                <div class="d-flex align-center">
                    <ColumnDisplaySelect Columns="_allColumns"
                                         OnColumnToggle="OnColumnToggle"
                                         OnMoveUp="MoveColumnUp"
                                         OnMoveDown="MoveColumnDown" />
                    <MudButton Variant="Variant.Text" Size="Size.Small"
                               Color="Color.Default"
                               StartIcon="@Icons.Material.Filled.RestartAlt"
                               OnClick="ResetColumnDisplay" Class="ml-2">
                        重置
                    </MudButton>
                </div>
                <div class="d-flex align-center" style="margin-left:auto;">
                    <MudButton Variant="Variant.Outlined" Size="Size.Small" Color="Color.Info"
                               StartIcon="@Icons.Material.Filled.Print"
                               Disabled="@(!selectedIds.Any())"
                               OnClick="PrintSelected">
                        打印选中 (@selectedIds.Count)
                    </MudButton>
                    <MudButton Variant="Variant.Text" Size="Size.Small" Color="Color.Info"
                               StartIcon="@Icons.Material.Filled.Print"
                               OnClick="PrintAll">
                        打印全部
                    </MudButton>
                    <MudText Typo="Typo.body2" Class="ml-2">
                        共 @_totalCount 条记录
                    </MudText>
                </div>
            </div>
            @* 分组标题栏 *@
            <div class="col-group-header-scroll">
                <div class="col-group-header-bar" style="width: @(_totalTableWidth)px">
                    @foreach (var gh in _groupHeaders)
                    {
                        <div class="col-group-header-item @gh.CssClass" style="width: @(gh.TotalWidth)px">
                            <span class="col-group-badge">@gh.GroupName</span>
                        </div>
                    }
                </div>
            </div>
            <MudTable @ref="table"
                      T="ProductionBatchListDto"
                      ServerData="LoadDataFromServer"
                      Dense="true"
                      Hover="true"
                      Class="mt-0 auto-table compact-table"
                      Elevation="0"
                      RowsPerPage="@_pageSize"
                      RowsPerPageLabel="每页行数:"
                      TotalItems="_totalCount">
                <HeaderContent>
                    @{
                        int? _prevGk = null;
                    }
                    <MudTh Class="col-selection-th" Style="width:40px;padding:0 4px;">
                        <MudCheckBox T="bool" @bind-Value="allSelected" Dense="true" />
                    </MudTh>
                    @foreach (var col in _visibleColumns)
                    {
                        var _isGroupStart = col.GroupKey.HasValue && col.GroupKey != _prevGk;
                        _prevGk = col.GroupKey;
                        var _headerClass = GetHeaderGroupCss(col.GroupKey, _isGroupStart);
                        <MudTh Class="@_headerClass" Style="@($"width:{col.Width}px")">
                            <div style="display:inline-flex; align-items:center; gap:4px;">
                                <span @onclick='() => ToggleSort(col.Key)' style="cursor:pointer">
                                    @col.Label
                                    @if (sortColumn == col.Key)
                                    {
                                        @(sortDescending ? " ▼" : " ▲")
                                    }
                                </span>
                                @if (col.FilterType != null)
                                {
                                    <ExcelFilter T="ProductionBatchListDto"
                                                 Label="@col.Label"
                                                 FieldKey="@col.Key"
                                                 FilterOptions="@(_filterContextOptions.GetValueOrDefault(col.Key))"
                                                 ActiveFilterValues="@(_columnFilters.GetValueOrDefault(col.Key))"
                                                 FilterChanged="@(args => OnColumnFilterChanged(args.fieldKey, args.selectedValues))" />
                                }
                            </div>
                        </MudTh>
                    }
                    <MudTh Style="width: 90px;">操作</MudTh>
                </HeaderContent>
                <RowTemplate Context="item">
                    @{
                        int? _prevGk2 = null;
                    }
                    <MudTd Class="col-selection-td" Style="width:40px;padding:0 4px;">
                        <MudCheckBox T="bool"
                                     Value="@selectedIds.Contains(item.Id)"
                                     ValueChanged="@((v) => { if(v) selectedIds.Add(item.Id); else selectedIds.Remove(item.Id); StateHasChanged(); })"
                                     Dense="true" />
                    </MudTd>
                    @foreach (var col in _visibleColumns)
                    {
                        var _isGroupStart2 = col.GroupKey.HasValue && col.GroupKey != _prevGk2;
                        _prevGk2 = col.GroupKey;
                        var _cellClass = GetCellGroupCss(col.GroupKey, _isGroupStart2);
                        <MudTd Class="@_cellClass">@RenderCell(item, col)</MudTd>
                    }
                    <MudTd>
                        <MudIconButton Icon="@Icons.Material.Filled.Visibility"
                                       Color="Color.Info"
                                       Size="Size.Small"
                                       OnClick="() => NavigateToBatch(item.Id)" />
                    </MudTd>
                </RowTemplate>
                <PagerContent>
                    <MudTablePager PageSizeOptions="new int[]{10,15,25,50,100}" />
                </PagerContent>
            </MudTable>
            </div>
        </MudCardContent>
    </MudCard>
</MudContainer>

@code {
    private MudTable<ProductionBatchListDto>? table;
    private List<ProductionBatchListDto> _pageItems = new();
    private int _totalCount;
    private int _pageSize = 10;
    private HashSet<int> selectedIds = new();
    private bool _allSelected;
    private bool allSelected
    {
        get => _allSelected;
        set
        {
            if (_allSelected == value) return;
            _allSelected = value;
            if (value)
            {
                foreach (var item in _pageItems)
                    selectedIds.Add(item.Id);
            }
            else
            {
                selectedIds.Clear();
            }
            StateHasChanged();
        }
    }
    private int _currentPage = 1;
    private string _searchKeyword = string.Empty;

    private string sortColumn = "batchno";
    private bool sortDescending = true;
    private bool showSettings = false;

    // ========== ExcelFilter 状态 ==========
    private Dictionary<string, HashSet<string>> _columnFilters = new();
    private Dictionary<string, List<ExcelFilterOption>> _filterContextOptions = new();

    // ========== 批次列表列定义（同首页） ==========

    private List<ColumnDef> _allColumns = new();
    private List<ColumnDef> _visibleColumns =>
        _allColumns.Where(c => c.IsApplicable && c.Visible).ToList();

    private static List<ColumnDef> GetAllColumnDefs() => new()
    {
        // ===== Group 1: 批次基本信息 =====
        new() { Key = "BatchNo",            Label = "生产编号", SortKey = "batchno", FilterType = "string", Width = "120", GroupKey = 1, GroupName = "批次基本信息" },
        new() { Key = "TagNo",              Label = "挂牌号",   SortKey = "tagno", FilterType = "string", Width = "120", GroupKey = 1, GroupName = "批次基本信息" },
        new() { Key = "Status",             Label = "状态",     SortKey = "status", FilterType = "enum", Width = "120", GroupKey = 1, GroupName = "批次基本信息",
            EnumOptions = DisplayHelper.GetEnumFilterOptions<BatchStatus>() },
        new() { Key = "ProductionType",     Label = "生产类型", SortKey = "productiontype", FilterType = "enum", Width = "120", GroupKey = 1, GroupName = "批次基本信息",
            EnumOptions = DisplayHelper.GetEnumFilterOptions<ProductionType>() },
        new() { Key = "ManufacturingItem",  Label = "制造物品", SortKey = "manufacturingitem", FilterType = "enum", Width = "120", GroupKey = 1, GroupName = "批次基本信息",
            EnumOptions = new() { new("OrderFinished", "订单成品"), new("Finished", "备料成品"),
                new("Surplus", "余库料"), new("SpecialDeliveryStatus", "订成-非交付态") } },
        new() { Key = "CreatedTime",        Label = "创建时间", SortKey = "createdtime", FilterType = "date", Width = "120", GroupKey = 1, GroupName = "批次基本信息" },

        // ===== Group 2: 工单信息 =====
        new() { Key = "WorkOrderNo",        Label = "工单号",   SortKey = "workorderno", FilterType = "string", Width = "120", GroupKey = 2, GroupName = "工单信息" },
        new() { Key = "SalesOrderNo",       Label = "订单号",   SortKey = "salesorderno", FilterType = "string", Width = "120", GroupKey = 2, GroupName = "工单信息" },
        new() { Key = "ProductionMainNo",   Label = "主号",     SortKey = "productionmainno", FilterType = "string", Width = "120", GroupKey = 2, GroupName = "工单信息" },
        new() { Key = "ProductionSubNo",    Label = "次号",     SortKey = "productionsubno", FilterType = "string", Width = "120", GroupKey = 2, GroupName = "工单信息" },

        // ===== Group 3: 生产执行 =====
        new() { Key = "CurrentExecDate",    Label = "截止执行日", SortKey = "currentexecdate", FilterType = "date", Width = "120", GroupKey = 3, GroupName = "生产执行" },
        new() { Key = "CurrentGroupName",   Label = "当前工序", SortKey = "currentgroupname", FilterType = "string", Width = "120", GroupKey = 3, GroupName = "生产执行" },
        new() { Key = "CurrentSectionName", Label = "当前工段", SortKey = "currentsectionname", FilterType = "string", Width = "120", GroupKey = 3, GroupName = "生产执行" },
        new() { Key = "CurrentEquipmentName", Label = "当前设备", SortKey = "currentequipmentname", FilterType = "string", Width = "120", GroupKey = 3, GroupName = "生产执行" },
        new() { Key = "CurrentOutsource",   Label = "当前委外", SortKey = "currentoutsource", FilterType = "string", Width = "120", GroupKey = 3, GroupName = "生产执行" },
        new() { Key = "CurrentSpec",        Label = "当前规格", SortKey = "currentspec", FilterType = "string", Width = "120", GroupKey = 3, GroupName = "生产执行" },
        new() { Key = "NextSectionName",    Label = "下一工段", SortKey = "nextsectionname", FilterType = "string", Width = "120", GroupKey = 3, GroupName = "生产执行" },
        new() { Key = "CorrespondingSpec",  Label = "对应规格", SortKey = "correspondingspec", FilterType = "string", Width = "120", GroupKey = 3, GroupName = "生产执行" },
        new() { Key = "NextProcess",        Label = "下一工序", SortKey = "nextprocess", FilterType = "string", Width = "120", GroupKey = 3, GroupName = "生产执行" },
    };

    // ========== 列选择操作 ==========

    private async Task OnColumnToggle(ColumnDef col)
    {
        await SaveColumnPrefs();
    }

    private async Task SaveColumnPrefs()
    {
        await ColumnPrefs.SaveAsync("process_card_print_list", null, _allColumns);
    }

    private async Task ResetColumnDisplay()
    {
        _allColumns = GetAllColumnDefs();
        await SaveColumnPrefs();
    }

    private async Task MoveColumnUp(ColumnDef col)
    {
        await SaveColumnPrefs();
    }

    private async Task MoveColumnDown(ColumnDef col)
    {
        await SaveColumnPrefs();
    }

    // ========== 格式设置列定义 ==========

    private List<ProcessCardColumnDef> allColumns = new();

    private List<ProcessCardColumnDef> GetDefaultColumns()
    {
        // 各字段 4 维默认值（RowIndex/ColumnIndex/ColumnWeight）与种子迁移 SeedProcessCardColumnDefinition 保持一致：
        // 数据库有配置行时后端读库为准；无配置行（如新启用工段）时前端兜底用本默认值。
        var cols = new List<ProcessCardColumnDef>
        {
        // === 批次基本信息 行1（9 列全启用）===
        new() { BlockKey = "BatchInfo", Key = "BatchNo", Label = "生产编号", Visible = true, RowIndex = 1, ColumnIndex = 1, ColumnWeight = 4 },
        new() { BlockKey = "BatchInfo", Key = "TagNo", Label = "挂牌号", Visible = true, RowIndex = 1, ColumnIndex = 2, ColumnWeight = 3 },
        new() { BlockKey = "BatchInfo", Key = "ProductionType", Label = "生产类型", Visible = true, RowIndex = 1, ColumnIndex = 3, ColumnWeight = 4 },
        new() { BlockKey = "BatchInfo", Key = "ManufacturingItem", Label = "制造物品", Visible = true, RowIndex = 1, ColumnIndex = 4, ColumnWeight = 4 },
        new() { BlockKey = "BatchInfo", Key = "ManufacturingStatus", Label = "制造状态", Visible = true, RowIndex = 1, ColumnIndex = 5, ColumnWeight = 4 },
        new() { BlockKey = "BatchInfo", Key = "ProductionRatio", Label = "制成倍数", Visible = true, RowIndex = 1, ColumnIndex = 6, ColumnWeight = 3 },
        new() { BlockKey = "BatchInfo", Key = "Remark", Label = "备注", Visible = true, RowIndex = 1, ColumnIndex = 7, ColumnWeight = 8 },
        new() { BlockKey = "BatchInfo", Key = "CreatedBy", Label = "创建人", Visible = true, RowIndex = 1, ColumnIndex = 8, ColumnWeight = 4 },
        new() { BlockKey = "BatchInfo", Key = "CreatedTime", Label = "创建时间", Visible = true, RowIndex = 1, ColumnIndex = 9, ColumnWeight = 4 },
        // 批次基本信息 行2（11 列全隐藏）
        new() { BlockKey = "BatchInfo", Key = "Status", Label = "状态", Visible = false, RowIndex = 2, ColumnIndex = 10, ColumnWeight = 3 },
        new() { BlockKey = "BatchInfo", Key = "CurrentExecDate", Label = "截止执行日", Visible = false, RowIndex = 2, ColumnIndex = 11, ColumnWeight = 4 },
        new() { BlockKey = "BatchInfo", Key = "CurrentGroupName", Label = "当前工序", Visible = false, RowIndex = 2, ColumnIndex = 12, ColumnWeight = 4 },
        new() { BlockKey = "BatchInfo", Key = "CurrentSectionName", Label = "当前工段", Visible = false, RowIndex = 2, ColumnIndex = 13, ColumnWeight = 4 },
        new() { BlockKey = "BatchInfo", Key = "CurrentEquipmentName", Label = "当前设备", Visible = false, RowIndex = 2, ColumnIndex = 14, ColumnWeight = 4 },
        new() { BlockKey = "BatchInfo", Key = "CurrentOutsource", Label = "当前委外", Visible = false, RowIndex = 2, ColumnIndex = 15, ColumnWeight = 4 },
        new() { BlockKey = "BatchInfo", Key = "CurrentSpec", Label = "当前规格", Visible = false, RowIndex = 2, ColumnIndex = 16, ColumnWeight = 4 },
        new() { BlockKey = "BatchInfo", Key = "NextProcess", Label = "下一工序", Visible = false, RowIndex = 2, ColumnIndex = 17, ColumnWeight = 4 },
        new() { BlockKey = "BatchInfo", Key = "NextSectionName", Label = "下一工段", Visible = false, RowIndex = 2, ColumnIndex = 18, ColumnWeight = 4 },
        new() { BlockKey = "BatchInfo", Key = "CorrespondingSpec", Label = "对应规格", Visible = false, RowIndex = 2, ColumnIndex = 19, ColumnWeight = 4 },
        new() { BlockKey = "BatchInfo", Key = "IsForceCompleted", Label = "强制完成", Visible = false, RowIndex = 2, ColumnIndex = 20, ColumnWeight = 3 },

        // === 质量要求 ===
        new() { BlockKey = "Quality", Key = "SolutionParams", Label = "固溶参数", Visible = true, RowIndex = 1, ColumnIndex = 1, ColumnWeight = 2 },
        new() { BlockKey = "Quality", Key = "QualityRemark", Label = "质量备注", Visible = true, RowIndex = 1, ColumnIndex = 2, ColumnWeight = 10 },

        // === 投料信息 ===
        new() { BlockKey = "Warehouse", Key = "SourceBatchNo", Label = "仓库批", Visible = true, RowIndex = 1, ColumnIndex = 1, ColumnWeight = 3 },
        new() { BlockKey = "Warehouse", Key = "SourceMaterialType", Label = "原料类型", Visible = true, RowIndex = 1, ColumnIndex = 2, ColumnWeight = 3 },
        new() { BlockKey = "Warehouse", Key = "SourceName", Label = "来料单位", Visible = true, RowIndex = 1, ColumnIndex = 3, ColumnWeight = 6 },
        new() { BlockKey = "Warehouse", Key = "SourceHeatNo", Label = "炉号", Visible = true, RowIndex = 1, ColumnIndex = 4, ColumnWeight = 5 },
        new() { BlockKey = "Warehouse", Key = "SourcePlantGrade", Label = "工厂牌号", Visible = true, RowIndex = 1, ColumnIndex = 5, ColumnWeight = 4 },
        new() { BlockKey = "Warehouse", Key = "SourceSpecification", Label = "名义规格", Visible = true, RowIndex = 1, ColumnIndex = 6, ColumnWeight = 4 },
        new() { BlockKey = "Warehouse", Key = "SourceLengthStatus", Label = "长度状态", Visible = true, RowIndex = 1, ColumnIndex = 7, ColumnWeight = 4 },
        new() { BlockKey = "Warehouse", Key = "SourceUnitWeight", Label = "单支重(kg)", Visible = true, RowIndex = 1, ColumnIndex = 8, ColumnWeight = 3 },
