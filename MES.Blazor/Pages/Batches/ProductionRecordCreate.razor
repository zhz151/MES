@page "/production-records/create"
@using MES.Blazor.Services
@using Microsoft.AspNetCore.Authorization
@using MES.Blazor.Shared
@using MES.Core.Constants
@using MES.Core.Enums
@using MES.Core.Helpers
@using MES.Core.DTOs.Batch
@inject ProductionRecordService ProdRecordService
@inject BatchService BatchService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject IJSRuntime JS
@inject ColumnPrefsService ColumnPrefs
@attribute [Authorize(Roles = Roles.Policies.BatchRead)]

<MudContainer MaxWidth="MaxWidth.False" Class="mt-4">
    <style>
        .edit-table td.mud-table-cell,
        .edit-table th.mud-table-cell {
            padding: 1px 4px !important;
        }
        .edit-table .mud-input-input-control {
            margin-top: 0;
        }
        .edit-table .mud-input {
            font-size: 13px;
            width: 100%;
            min-width: 0;
        }
        .edit-table th.mud-table-cell {
            white-space: nowrap;
        }
        .table-scroll {
            max-height: calc(100vh - 310px);
            overflow: hidden;
        }
        .table-scroll .mud-table-container {
            overflow-x: auto !important;
        }
    </style>

    <MudCard>
        <MudCardHeader>
            <CardHeaderContent>
                <MudText Typo="Typo.h5" Class="font-weight-bold">
                    <MudIcon Icon="@Icons.Material.Filled.AddCircleOutline" Class="mr-2" Color="Color.Primary" />
                    新建生产记录
                </MudText>
            </CardHeaderContent>
            <CardHeaderActions>
                <MudButton Variant="Variant.Text" Color="Color.Default" OnClick="GoBack">返回</MudButton>
            </CardHeaderActions>
        </MudCardHeader>

        <MudCardContent>
            <div id="production-record-create-table">
                @if (_rows.Any())
                {
                    <div class="d-flex align-center mb-2">
                        <ColumnDisplaySelect Columns="_allColumns"
                                             OnColumnToggle="OnColumnToggle"
                                             OnMoveUp="MoveColumnUp"
                                             OnMoveDown="MoveColumnDown" />
                        <MudButton Variant="Variant.Text" Size="Size.Small"
                                   Color="Color.Default"
                                   StartIcon="@Icons.Material.Filled.RestartAlt"
                                   OnClick="ResetColumnDisplay" Class="ml-2">
                            重置
                        </MudButton>
                        <MudSpacer />
                        <MudText Typo="Typo.body2">共 @_rows.Count 行</MudText>
                        <MudButton Variant="Variant.Text" Size="Size.Small"
                                   Color="Color.Default"
                                   StartIcon="@Icons.Material.Filled.AddCircleOutline"
                                   OnClick="AddRow" Class="ml-2">
                            添加行
                        </MudButton>
                    </div>
                    <div class="table-scroll" id="production-record-table-wrapper">
                        @* 分组标题栏 *@
                        <div class="col-group-header-scroll">
                            <div class="col-group-header-bar" style="width: @(_totalTableWidth)px">
                                @foreach (var gh in _groupHeaders)
                                {
                                    <div class="col-group-header-item @gh.CssClass" style="width: @(gh.TotalWidth)px">
                                        <span class="col-group-badge">@gh.GroupName</span>
                                    </div>
                                }
                                <div class="col-group-header-item" style="width:80px;flex:none;"></div>
                            </div>
                        </div>
                        <MudTable Items="@_rows" Dense="true" Hover="true" Elevation="0" Striped="true"
                                  Class="edit-table auto-table" SortMode="SortMode.None" FixedHeader="true">
                            <HeaderContent>
                                @{
                                    int? _prevGk = null;
                                }
                                @foreach (var col in _visibleColumns)
                                {
                                    var _isGroupStart = col.GroupKey.HasValue && col.GroupKey != _prevGk;
                                    _prevGk = col.GroupKey;
                                    var _headerClass = col.GroupKey.HasValue ? GetHeaderGroupCss(col.GroupKey.Value, _isGroupStart) : "";
                                    <MudTh Class="@_headerClass" Style="@($"width:{GetColWidth(col.Key)}px")">
                                        @col.Label
                                        @if (col.IsRequired)
                                        {
                                            <span class="required-star">*</span>
                                        }
                                    </MudTh>
                                }
                                <MudTh Style="width:80px;">操作</MudTh>
                            </HeaderContent>
                            <RowTemplate Context="r">
                                @{
                                    int? _prevGk2 = null;
                                }
                                @foreach (var col in _visibleColumns)
                                {
                                    var _isGroupStart2 = col.GroupKey.HasValue && col.GroupKey != _prevGk2;
                                    _prevGk2 = col.GroupKey;
                                    var _cellClass = col.GroupKey.HasValue ? GetCellGroupCss(col.GroupKey.Value, _isGroupStart2) : "";
                                    <MudTd Class="@_cellClass" Style="@($"width:{GetColWidth(col.Key)}px")">
                                        @RenderCell(r, col)
                                    </MudTd>
                                }
                                <MudTd Style="white-space:nowrap;">
                                    @if (_rows.IndexOf(r) > 0)
                                    {
                                        <MudIconButton Icon="@Icons.Material.Filled.ContentCopy"
                                                       Color="Color.Info" Size="Size.Small"
                                                       Title="与上行相同"
                                                       OnClick="() => CopyFromAbove(r, _rows.IndexOf(r))" />
                                    }
                                    <MudIconButton Icon="@Icons.Material.Filled.RemoveCircleOutline"
                                                   Color="Color.Error" Size="Size.Small"
                                                   Title="删除"
                                                   OnClick="() => RemoveRow(r)"
                                                   Disabled="@(_rows.Count <= 1)" />
                                </MudTd>
                            </RowTemplate>
                            <FooterContent>
                                @{
                                    int? _prevGk3 = null;
                                }
                                @foreach (var col in _visibleColumns)
                                {
                                    var _isGroupStart3 = col.GroupKey.HasValue && col.GroupKey != _prevGk3;
                                    _prevGk3 = col.GroupKey;
                                    var _footerClass = col.GroupKey.HasValue ? GetCellGroupCss(col.GroupKey.Value, _isGroupStart3) : "";
                                    <MudTd Class="@_footerClass" Style="@($"width:{GetColWidth(col.Key)}px")"></MudTd>
                                }
                                <MudTd>
                                    <MudIconButton Icon="@Icons.Material.Filled.AddCircleOutline"
                                                   Color="Color.Primary" Size="Size.Small"
                                                   OnClick="AddRow" />
                                </MudTd>
                            </FooterContent>
                        </MudTable>
                    </div>
                }
            </div>

            @if (!string.IsNullOrEmpty(_errorMessage))
            {
                <MudText Typo="Typo.body2" Color="Color.Error" Class="mt-4">@_errorMessage</MudText>
            }

            @if (_rows.Any())
            {
                <MudGrid Class="mt-4">
                    <MudItem xs="12" Class="d-flex justify-end">
                        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.CloudUpload"
                                   OnClick="Submit" Loading="@_isSubmitting"
                                   Size="Size.Large">
                            确认提交 (@_rows.Count 条)
                        </MudButton>
                    </MudItem>
                </MudGrid>
            }
        </MudCardContent>
    </MudCard>
</MudContainer>

@code {
    private List<EditRow> _rows = new();
    private bool _isSubmitting;
    private bool _isArrowNavSetup;
    private string _errorMessage = string.Empty;

    // ========== 列定义 ==========

    private List<ColumnDef> _allColumns = new();
    private List<ColumnDef> _visibleColumns =>
        _allColumns.Where(c => c.IsApplicable && c.Visible).ToList();

    private static List<ColumnDef> GetAllColumnDefs() => new()
    {
        // ========== 组1：执行信息 ==========
        new() { Key = "ExecDate",          Label = "执行日期", IsRequired = true, GroupKey = 1, GroupName = "执行信息" },
        new() { Key = "BatchNo",           Label = "生产编号", IsRequired = true, GroupKey = 1, GroupName = "执行信息" },
        new() { Key = "ProcessName",       Label = "工序名称", IsRequired = true, GroupKey = 1, GroupName = "执行信息" },
        new() { Key = "SectionName",       Label = "工段名称", IsRequired = true, GroupKey = 1, GroupName = "执行信息" },

        // ========== 组2：可填充（由生产编号/工序自动回填） ==========
        new() { Key = "TagNo",             Label = "挂牌号",                   GroupKey = 2, GroupName = "可填充" },
        new() { Key = "PlantGrade",        Label = "工厂牌号", IsRequired = true, GroupKey = 2, GroupName = "可填充" },
        new() { Key = "ManufacturingSpec", Label = "制造规格", IsRequired = true, GroupKey = 2, GroupName = "可填充" },

        // ========== 组3：人员设备 ==========
        new() { Key = "Shift",             Label = "班次",                     GroupKey = 3, GroupName = "人员设备" },
        new() { Key = "Operator",          Label = "操作工",                   GroupKey = 3, GroupName = "人员设备" },
        new() { Key = "EquipmentName",     Label = "设备名称",                 GroupKey = 3, GroupName = "人员设备" },

        // ========== 组4：加工计量 ==========
        new() { Key = "Quantity",          Label = "加工支数",                 GroupKey = 4, GroupName = "加工计量" },
        new() { Key = "Weight",            Label = "加工重量",                 GroupKey = 4, GroupName = "加工计量" },
        new() { Key = "Remark",            Label = "备注",                     GroupKey = 4, GroupName = "加工计量" },

        // ========== 组5：断切特有 ==========
        new() { Key = "FaceCutCount",      Label = "平头数",                   GroupKey = 5, GroupName = "断切特有" },
        new() { Key = "CuttingMultiple",   Label = "断切倍数",                 GroupKey = 5, GroupName = "断切特有" },
        new() { Key = "FinishedCutLength", Label = "成品长度",                 GroupKey = 5, GroupName = "断切特有" },
        new() { Key = "PostCutQuantity",   Label = "切后支数",                 GroupKey = 5, GroupName = "断切特有" },

        // ========== 组6：固溶特有 ==========
        new() { Key = "SolutionTemperature", Label = "固溶温度(℃)",           GroupKey = 6, GroupName = "固溶特有" },
        new() { Key = "SoakTime",           Label = "保温时间(min)",            GroupKey = 6, GroupName = "固溶特有" },
    };

    private async Task OnColumnToggle(ColumnDef col)
    {
        await SaveColumnPrefs();
    }

    private async Task SaveColumnPrefs()
    {
        await ColumnPrefs.SaveAsync("production-records-create", null, _allColumns);
    }

    private async Task ResetColumnDisplay()
    {
        _allColumns = GetAllColumnDefs();
        await SaveColumnPrefs();
    }

    private async Task MoveColumnUp(ColumnDef col)
    {
        await SaveColumnPrefs();
    }

    private async Task MoveColumnDown(ColumnDef col)
    {
        await SaveColumnPrefs();
    }

    private class EditRow
    {
        public string ExecDate { get; set; } = DateTime.Today.ToString("yyyy-MM-dd");          // → Entity.ExecDate
        public string BatchNo { get; set; } = string.Empty;                                     // → Entity.ProductionBatchId
        public string ProcessName { get; set; } = string.Empty;                                 // → Entity.ProcessName + 联合解析 ProcessGroupId
        public string? ManufacturingSpec { get; set; }                                          // → Entity.ManufacturingSpec + 联合解析 ProcessGroupId
        public string SectionName { get; set; } = string.Empty;                                 // → Entity.SectionName（与ProcessGroupId联合解析SequenceNumber）
        public string? EquipmentName { get; set; }                                              // → Entity.EquipmentName
        public string? Operator { get; set; }                                                   // → Entity.Operator
        public string? Shift { get; set; }                                                      // → Entity.Shift
        public int? Quantity { get; set; }                                                      // → Entity.Quantity
        public decimal? Weight { get; set; }                                                    // → Entity.Weight
        public decimal? SolutionTemperature { get; set; }                                        // → Entity.SolutionTemperature
        public int? SoakTime { get; set; }                                                       // → Entity.SoakTime
        public int? FaceCutCount { get; set; }                                                   // → Entity.FaceCutCount
        public decimal? CuttingMultiple { get; set; }                                           // → Entity.CuttingMultiple
        public decimal? FinishedCutLength { get; set; }                                         // → Entity.FinishedCutLength
        public int? PostCutQuantity { get; set; }                                               // → Entity.PostCutQuantity
        public string? TagNo { get; set; }                                                      // → Entity.TagNo（来自批次信息）
        public string? PlantGrade { get; set; }                                                 // → Entity.PlantGrade（来自批次信息）
        public string? Remark { get; set; }                                                     // → Entity.Remark
    }

    // ========== 分组标题栏 ==========

    private int _totalTableWidth =>
        _visibleColumns.Sum(c => GetColWidth(c.Key)) + 80; // +80px 操作列

    private List<GroupHeaderInfo> _groupHeaders => GetGroupHeaders();

    private class GroupHeaderInfo
    {
        public int GroupKey { get; init; }
        public string GroupName { get; init; } = "";
        public int TotalWidth { get; init; }
        public int ColumnCount { get; init; }
        public string CssClass { get; init; } = "";
    }

    private List<GroupHeaderInfo> GetGroupHeaders()
    {
        var result = new List<GroupHeaderInfo>();
        int? lastKey = null; int totalWidth = 0;
        var groupKey = 0; var groupName = ""; var count = 0;
        foreach (var col in _visibleColumns)
        {
            var gk = col.GroupKey ?? 0;
            if (gk != lastKey && lastKey.HasValue)
            {
                result.Add(new GroupHeaderInfo { GroupKey = groupKey, GroupName = groupName, TotalWidth = totalWidth, ColumnCount = count, CssClass = GetHeaderGroupCss(groupKey, true) });
                totalWidth = 0; count = 0;
            }
            groupKey = gk; groupName = col.GroupName ?? "";
            totalWidth += GetColWidth(col.Key);
            count++; lastKey = gk;
        }
        if (count > 0)
            result.Add(new GroupHeaderInfo { GroupKey = groupKey, GroupName = groupName, TotalWidth = totalWidth, ColumnCount = count, CssClass = GetHeaderGroupCss(groupKey, true) });
        return result;
    }

    private static string GetHeaderGroupCss(int groupKey, bool isGroupStart) =>
        groupKey switch { 1 => "col-g1", 2 => "col-g2", 3 => "col-g3", 4 => "col-g4", 5 => "col-g5", 6 => "col-g6", _ => "" };

    private static string GetCellGroupCss(int? groupKey, bool isGroupStart) =>
        groupKey switch { 1 => "col-g1-cell", 2 => "col-g2-cell", 3 => "col-g3-cell", 4 => "col-g4-cell", 5 => "col-g5-cell", 6 => "col-g6-cell", _ => "" };

    private static int GetColWidth(string key) => key switch
    {
        "ExecDate" => 140,
        "BatchNo" => 150,
        "ProcessName" => 170,
        "SectionName" => 140,
        "TagNo" => 130,
        "PlantGrade" => 130,
        "ManufacturingSpec" => 170,
        "Shift" => 80,
        "Operator" => 100,
        "EquipmentName" => 120,
        "Quantity" => 100,
        "Weight" => 120,
        "Remark" => 150,
        "FaceCutCount" => 80,
        "CuttingMultiple" => 100,
        "FinishedCutLength" => 100,
        "PostCutQuantity" => 100,
        "SolutionTemperature" => 120,
        "SoakTime" => 120,
        _ => 130
    };

    // ========== 下拉选项 ==========

    private static readonly string[] _allSectionOptions = SectionDefs.All
        .Where(s => s != SectionDefs.Degrease && s != SectionDefs.Pickle
                 && s != SectionDefs.Inspection && s != SectionDefs.Warehouse)
        .ToArray();

    private static readonly List<(string Value, string Text)> _shiftOptions =
        Enum.GetValues<ShiftType>().Select(v => (v.ToString(), EnumHelper.GetDisplayName(v))).ToList();

    protected override async Task OnInitializedAsync()
    {
        _allColumns = GetAllColumnDefs();
        var saved = await ColumnPrefs.LoadAsync("production-records-create", null);
        if (saved.Count > 0)
        {
            foreach (var s in saved)
            {
                var match = _allColumns.FirstOrDefault(c => c.Key == s.Key);
                if (match != null)
                    match.Visible = s.Visible;
            }
            var reordered = new List<ColumnDef>();
            foreach (var s in saved)
            {
                var match = _allColumns.FirstOrDefault(c => c.Key == s.Key);
                if (match != null && !reordered.Contains(match))
                    reordered.Add(match);
            }
            foreach (var c in _allColumns)
            {
                if (!reordered.Contains(c))
                    reordered.Add(c);
            }
            _allColumns = reordered;
        }

        if (!_rows.Any())
        {
            _rows.Add(new EditRow());
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        try
        {
            await JS.InvokeVoidAsync("initGroupHeaders", "#production-record-table-wrapper");
        }
        catch { }
        if (!_isArrowNavSetup)
        {
            _isArrowNavSetup = true;
            if (!await JS.InvokeAsync<bool>("enableTableArrowNav", "#production-record-table-wrapper"))
                _isArrowNavSetup = false;
        }
    }

    private void AddRow()
    {
        var newRow = new EditRow();
        if (_rows.Any())
        {
            var source = _rows[^1];
            newRow.ExecDate = source.ExecDate;
            newRow.BatchNo = source.BatchNo;
            newRow.ProcessName = source.ProcessName;
            newRow.SectionName = source.SectionName;
            newRow.TagNo = source.TagNo;
            newRow.PlantGrade = source.PlantGrade;
            newRow.ManufacturingSpec = source.ManufacturingSpec;
            newRow.Shift = source.Shift;
            newRow.Operator = source.Operator;
            newRow.EquipmentName = source.EquipmentName;
        }
        _rows.Add(newRow);
    }

    private void RemoveRow(EditRow row)
    {
        if (_rows.Count <= 1) return;
        _rows.Remove(row);
    }

    private void CopyFromAbove(EditRow row, int index)
    {
        if (index <= 0) return;
        var source = _rows[index - 1];
        row.BatchNo = source.BatchNo;
        row.ProcessName = source.ProcessName;
        row.SectionName = source.SectionName;
        row.TagNo = source.TagNo;
        row.PlantGrade = source.PlantGrade;
        row.ManufacturingSpec = source.ManufacturingSpec;
        row.Shift = source.Shift;
        row.Operator = source.Operator;
        row.EquipmentName = source.EquipmentName;
    }

    private async Task Submit()
    {
        _errorMessage = string.Empty;

        var errors = new List<string>();
        for (int i = 0; i < _rows.Count; i++)
        {
            var r = _rows[i];
            if (string.IsNullOrWhiteSpace(r.BatchNo))
                errors.Add($"第{i + 1}行：批次号不能为空");
            if (string.IsNullOrWhiteSpace(r.ProcessName))
                errors.Add($"第{i + 1}行：工序名称不能为空");
            if (string.IsNullOrWhiteSpace(r.SectionName))
                errors.Add($"第{i + 1}行：工段名称不能为空");
            if (string.IsNullOrWhiteSpace(r.ManufacturingSpec))
                errors.Add($"第{i + 1}行：制造规格不能为空");
            if (string.IsNullOrWhiteSpace(r.PlantGrade))
                errors.Add($"第{i + 1}行：工厂牌号不能为空");
            if (!DateTime.TryParse(r.ExecDate, out _))
                errors.Add($"第{i + 1}行：执行日期格式无效（请用 yyyy-MM-dd）");
        }

        if (errors.Any())
        {
            Snackbar.Add(string.Join("；", errors), Severity.Error);
            return;
        }

        _isSubmitting = true;
        StateHasChanged();

        try
        {
            var requests = _rows.Select(r => new CreateProductionRecordRequest
            {
                BatchNo = r.BatchNo,
                ProcessName = r.ProcessName,
                ManufacturingSpec = r.ManufacturingSpec ?? "",
                SectionName = r.SectionName,
                ExecDate = DateTime.Parse(r.ExecDate),
                EquipmentName = r.EquipmentName,
                Operator = r.Operator,
                Shift = string.IsNullOrEmpty(r.Shift) ? null : Enum.Parse<ShiftType>(r.Shift),
                Quantity = r.Quantity,
                Weight = r.Weight,
                SolutionTemperature = r.SolutionTemperature,
                SoakTime = r.SoakTime,
                FaceCutCount = r.FaceCutCount,
                CuttingMultiple = r.CuttingMultiple,
                FinishedCutLength = r.FinishedCutLength,
                PostCutQuantity = r.PostCutQuantity,
                TagNo = r.TagNo,
                PlantGrade = r.PlantGrade,
                Remark = r.Remark,
                DataSource = "MANUAL",
            }).ToList();

            var result = await ProdRecordService.BatchCreateProductionRecordsAsync(requests);

            if (result.Success && result.Data != null)
            {
                Snackbar.Add($"批量创建生产记录成功，共{result.Data.Count}条", Severity.Success);
                Navigation.NavigateTo("/production-records");
            }
            else
            {
                _errorMessage = result.Message ?? "批量创建失败";
            }
        }
        catch (Exception ex)
        {
            _errorMessage = $"网络错误: {ex.Message}";
        }
        finally
        {
            _isSubmitting = false;
            StateHasChanged();
        }
    }

    private void GoBack()
    {
        Navigation.NavigateTo("/production-records");
    }

    // ========== 自动填充 ==========

    /// <summary>生产编号变更 → 自动填充挂牌号+工厂牌号；如已选工序名称，联动填充制造规格，匹配不到则清空</summary>
    private async Task OnBatchNoChangedAsync(EditRow row)
    {
        if (string.IsNullOrWhiteSpace(row.BatchNo))
            return;

        var result = await BatchService.GetByBatchNoAsync(row.BatchNo);
        if (!result.Success || result.Data == null)
        {
            row.TagNo = null;
            row.PlantGrade = null;
            row.ManufacturingSpec = null;
            StateHasChanged();
            return;
        }

        var batch = result.Data;
        row.TagNo = batch.TagNo;
        row.PlantGrade = batch.PlantGrade;

        // 如已选工序名称，尝试匹配制造规格
        if (!string.IsNullOrWhiteSpace(row.ProcessName))
        {
            var pg = batch.ProcessGroups?.FirstOrDefault(p => p.ProcessName == row.ProcessName);
            row.ManufacturingSpec = pg?.ManufacturingSpec;
        }

        StateHasChanged();
    }

    /// <summary>工序名称变更 → 自动填充制造规格，匹配不到则清空</summary>
    private async Task OnProcessNameChangedAsync(EditRow row)
    {
        if (string.IsNullOrWhiteSpace(row.ProcessName))
        {
            row.ManufacturingSpec = null;
            StateHasChanged();
            return;
        }

        if (string.IsNullOrWhiteSpace(row.BatchNo))
            return;

        var result = await BatchService.GetByBatchNoAsync(row.BatchNo);
        if (!result.Success || result.Data == null)
        {
            row.ManufacturingSpec = null;
            StateHasChanged();
            return;
        }

        var batch = result.Data;
        var pg = batch.ProcessGroups?.FirstOrDefault(p => p.ProcessName == row.ProcessName);
        row.ManufacturingSpec = pg?.ManufacturingSpec;

        StateHasChanged();
    }

    // ========== 单元格渲染 ==========

    private RenderFragment RenderCell(EditRow r, ColumnDef col) => builder =>
    {
        switch (col.Key)
        {
            case "ExecDate":
                builder.OpenComponent<MudTextField<string>>(0);
                builder.AddAttribute(1, "Dense", true);
                builder.AddAttribute(2, "Variant", Variant.Outlined);
                builder.AddAttribute(3, "Size", Size.Small);
                builder.AddAttribute(5, "Value",r.ExecDate);
                builder.AddAttribute(5, "ValueChanged", EventCallback.Factory.Create<string>(this, v => r.ExecDate = v));
                builder.AddAttribute(6, "Placeholder", "yyyy-MM-dd");
                builder.CloseComponent();
                break;
            case "BatchNo":
                builder.OpenComponent<MudTextField<string>>(0);
                builder.AddAttribute(1, "Dense", true);
                builder.AddAttribute(2, "Variant", Variant.Outlined);
                builder.AddAttribute(3, "Size", Size.Small);
                builder.AddAttribute(5, "Value",r.BatchNo);
                builder.AddAttribute(5, "ValueChanged", EventCallback.Factory.Create<string>(this, async v => { r.BatchNo = v; await OnBatchNoChangedAsync(r); }));
                builder.CloseComponent();
                break;
            case "ProcessName":
                builder.OpenComponent<MudSelect<string>>(0);
                builder.AddAttribute(1, "Dense", true);
                builder.AddAttribute(2, "Variant", Variant.Outlined);
                builder.AddAttribute(3, "Size", Size.Small);
                builder.AddAttribute(5, "Value", r.ProcessName);
                builder.AddAttribute(6, "ValueChanged", EventCallback.Factory.Create<string>(this, async v => { r.ProcessName = v ?? ""; await OnProcessNameChangedAsync(r); }));
                builder.AddAttribute(7, "ChildContent", (RenderFragment)(b =>
                {
                    foreach (var pn in ProcessNames.All)
                    {
                        b.OpenComponent<MudSelectItem<string>>(0);
                        b.AddAttribute(1, "Value", pn);
