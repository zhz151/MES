@page "/batches"
@using MES.Blazor.Services
@using MES.Blazor.Helpers
@using MES.Core.Models
@using MES.Core.Enums
@using Microsoft.AspNetCore.Authorization
@using MES.Blazor.Shared
@using MES.Core.DTOs.Batch
@inject BatchService BatchService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject WorkOrderService WorkOrderService
@inject OrderService OrderService
@inject IJSRuntime JS
@inject ColumnPrefsService ColumnPrefs
@inject PageStateService PageState
@inject MaterialPlanService MaterialPlanService
@inject HttpClient Http
@inject NotificationService NotificationService
@attribute [Authorize(Roles = Roles.Policies.BatchRead)]

<MudContainer MaxWidth="MaxWidth.False" Class="mt-4 pl-0">
    <!-- 工单号不匹配通知 -->
    @if (_workOrderMismatches is { Count: > 0 })
    {
        <MudAlert Severity="Severity.Warning" Variant="Variant.Filled" Class="mb-4">
            <div>
                @foreach (var mismatch in _workOrderMismatches)
                {
                    <div>批次 "@mismatch.BatchNo" 的工单号 "@mismatch.WorkOrderNo" 已不存在，需修改！</div>
                }
            </div>
        </MudAlert>
    }

    <!-- 工单内容变更通知 -->
    @if (_workOrderChangedNotices is { Count: > 0 })
    {
        <MudAlert Severity="Severity.Info" Variant="Variant.Filled" Class="mb-4">
            <div>
                @foreach (var notice in _workOrderChangedNotices)
                {
                    <div>@notice.Title — @notice.Content</div>
                }
            </div>
            <MudButton Variant="Variant.Text" Color="Color.Inherit" Class="mt-2" OnClick="DismissWorkOrderChangedNotices">
                已知晓，不再提醒
            </MudButton>
        </MudAlert>
    }

    <!-- 在产改制计划通知 -->
    @if (_pendingInProcessReworkPlans is { Count: > 0 })
    {
        <MudAlert Severity="Severity.Info" Variant="Variant.Filled" Class="mb-4">
            <div>
                @foreach (var plan in _pendingInProcessReworkPlans)
                {
                    <div>生产编号 "@plan.BatchNo"用料计划，（@plan.PlanType，@plan.WorkOrderNo，需改制 @(plan.RequiredQuantity?.ToString() ?? "-")支 + @plan.RequiredWeight.ToString("G29")kg），请执行！</div>
                }
            </div>
        </MudAlert>
    }

    <!-- 投料分配异常通知（重量校验+工单存活性） -->
    @if (_pendingInMainWorkOrderPlans is { Count: > 0 })
    {
        <MudAlert Severity="Severity.Warning" Variant="Variant.Filled" Class="mb-4">
            <div>
                @foreach (var plan in _pendingInMainWorkOrderPlans)
                {
                    <div>生产编号 "@plan.BatchNo"用料计划，（@plan.PlanType，@plan.WorkOrderNo，需分配 @(plan.RequiredQuantity?.ToString() ?? "-")支 + @plan.RequiredWeight.ToString("G29")kg），请执行！</div>
                }
            </div>
        </MudAlert>
    }

    <!-- 缺陷率预警通知 -->
    @if (_defectRateAlerts is { Count: > 0 })
    {
        <MudAlert Severity="Severity.Warning" Variant="Variant.Filled" Class="mb-4">
            <div>
                @foreach (var alert in _defectRateAlerts)
                {
                    <div>批次 "@alert.BatchNo"（工单 @alert.WorkOrderNo）过程检验缺陷率达 @(alert.DefectRate)%（超阈值 3%），建议调整有效投料量！</div>
                }
            </div>
        </MudAlert>
    }

    <MudCard>
        <MudCardHeader>
            <CardHeaderContent>
                <MudText Typo="Typo.h5" Class="font-weight-bold">
                    <MudIcon Icon="@Icons.Material.Filled.PrecisionManufacturing" Class="mr-2" Color="Color.Primary" />
                    生产批次
                </MudText>
            </CardHeaderContent>
            <CardHeaderActions>
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Add"
                           OnClick="NavigateToCreate">
                    新建批次
                </MudButton>
                <MudButton Variant="Variant.Outlined"
                           Color="Color.Info"
                           StartIcon="@Icons.Material.Filled.Print"
                           OnClick='() => Navigation.NavigateTo("/process-card-print")'
                           Class="ml-2">
                    工艺卡打印
                </MudButton>
            </CardHeaderActions>
        </MudCardHeader>

        <MudCardContent>
            <!-- 搜索栏 -->
            <MudGrid>
                <MudItem xs="12" md="6">
                    <MudTextField T="string"
                                  Label="模糊搜索 - 批次号/工单号/销售单号/挂牌号/规格"
                                  Value="_searchKeyword"
                                  ValueChanged="@OnSearchChanged"
                                  Immediate="true"
                                  DebounceInterval="500"
                                  Clearable="true"
                                  ClearButton="true"
                                  Adornment="Adornment.End"
                                  AdornmentIcon="@Icons.Material.Filled.Search" />
                </MudItem>
                <MudItem xs="12" md="3">
                    <MudTextField T="string"
                                  Value="_dateFrom"
                                  ValueChanged="OnDateFromChanged"
                                  Placeholder="yyyy-MM-dd"
                                  Label="登记日期从"
                                  Immediate="true"
                                  DebounceInterval="500"
                                  Clearable="true"
                                  ClearButton="true" />
                </MudItem>
                <MudItem xs="12" md="3">
                    <MudTextField T="string"
                                  Value="_dateTo"
                                  ValueChanged="OnDateToChanged"
                                  Placeholder="yyyy-MM-dd"
                                  Label="登记日期至"
                                  Immediate="true"
                                  DebounceInterval="500"
                                  Clearable="true"
                                  ClearButton="true" />
                </MudItem>
            </MudGrid>

            <!-- 数据表格 -->
            <div id="batches-list-table">
            @{
                var _groupHeaders = GetGroupHeaders();
                var _totalTableWidth = _visibleColumns.Sum(c => int.TryParse(c.Width, out var w) ? w : 100) + 40 + 90;
            }
            @* 工具栏 *@
            <div class="woe-toolbar" style="min-height:28px;padding:2px 0;display:flex;align-items:center;">
                <div class="d-flex align-center">
                    <ColumnDisplaySelect Columns="_allColumns"
                                         OnColumnToggle="OnColumnToggle"
                                         OnMoveUp="MoveColumnUp"
                                         OnMoveDown="MoveColumnDown" />
                    <MudButton Variant="Variant.Text" Size="Size.Small"
                               Color="Color.Default"
                               StartIcon="@Icons.Material.Filled.RestartAlt"
                               OnClick="ResetColumnDisplay" Class="ml-2">
                        重置
                    </MudButton>
                </div>
                <div class="d-flex align-center" style="margin-left:auto;">
                    <MudButton Variant="Variant.Outlined" Size="Size.Small" Color="Color.Info"
                               StartIcon="@Icons.Material.Filled.Print"
                               Disabled="@(!selectedIds.Any())"
                               OnClick="PrintSelected">
                        打印选中 (@selectedIds.Count)
                    </MudButton>
                    <MudButton Variant="Variant.Text" Size="Size.Small" Color="Color.Info"
                               StartIcon="@Icons.Material.Filled.Print"
                               OnClick="PrintAll">
                        打印全部
                    </MudButton>
                    <MudText Typo="Typo.body2" Class="ml-2">
                        共 @_totalCount 条记录
                    </MudText>
                </div>
            </div>
            @* 分组标题栏 — 紧邻表头上方 *@
            <div class="col-group-header-scroll">
                <div class="col-group-header-bar" style="width: @(_totalTableWidth)px">
                    @foreach (var gh in _groupHeaders)
                    {
                        <div class="col-group-header-item @gh.CssClass" style="width: @(gh.TotalWidth)px">
                            <span class="col-group-badge">@gh.GroupName</span>
                        </div>
                    }
                </div>
            </div>
            <MudTable @ref="table"
                      T="ProductionBatchListDto"
                      ServerData="@LoadDataFromServer"
                      Dense="true"
                      Hover="true"
                      Class="mt-0 auto-table compact-table"
                      Elevation="0"
                      RowsPerPage="@_pageSize"
                      RowsPerPageLabel="每页行数:">
                <HeaderContent>
                    @{
                        int? _prevGk = null;
                    }
                    <MudTh Class="col-selection-th" Style="width:40px;padding:0 4px;">
                        <MudCheckBox T="bool" @bind-Value="allSelected" Dense="true" />
                    </MudTh>
                    @foreach (var col in _visibleColumns)
                    {
                        var _isGroupStart = col.GroupKey.HasValue && col.GroupKey != _prevGk;
                        _prevGk = col.GroupKey;
                        var _headerClass = GetHeaderGroupCss(col.GroupKey, _isGroupStart);
                        <MudTh Class="@_headerClass" Style="@($"width:{col.Width}px")">
                            <div style="display:inline-flex; align-items:center; gap:4px;">
                                <span @onclick='() => ToggleSort(col.Key)' style="cursor:pointer">@col.Label @if (sortColumn == col.Key) {@(sortDescending ? " ▼" : " ▲")}</span>
                                @if (col.FilterType != null)
                                {
                                    @* 使用原始全量数据供筛选器计算可选值 *@
                                    <ExcelFilter T="ProductionBatchListDto"
                                                 Label="@col.Label"
                                                 FieldKey="@col.Key"
                                                 FilterOptions="@(_filterContextOptions.GetValueOrDefault(col.Key))"
                                                 ActiveFilterValues="@(_columnFilters.GetValueOrDefault(col.Key))"
                                                 FilterChanged="@(args => OnColumnFilterChanged(args.fieldKey, args.selectedValues))" />

                                }
                            </div>
                        </MudTh>
                    }
                    <MudTh Style="width: 90px;">操作</MudTh>
                </HeaderContent>
                <RowTemplate Context="item">
                    @{
                        int? _prevGk2 = null;
                    }
                    <MudTd Class="col-selection-td" Style="width:40px;padding:0 4px;">
                        <MudCheckBox T="bool"
                                     Value="@selectedIds.Contains(item.Id)"
                                     ValueChanged="@((v) => { if(v) selectedIds.Add(item.Id); else selectedIds.Remove(item.Id); StateHasChanged(); })"
                                     Dense="true" />
                    </MudTd>
                    @foreach (var col in _visibleColumns)
                    {
                        var _isGroupStart2 = col.GroupKey.HasValue && col.GroupKey != _prevGk2;
                        _prevGk2 = col.GroupKey;
                        var _cellClass = GetCellGroupCss(col.GroupKey, _isGroupStart2);
                        <MudTd Class="@_cellClass">@RenderCell(item, col)</MudTd>
                    }
                    <MudTd>
                        <MudIconButton Icon="@Icons.Material.Filled.Visibility"
                                       Color="Color.Info"
                                       Size="Size.Small"
                                       OnClick="@(() => ViewDetail(item.Id))"
                                       Title="查看详情" />
                        <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                       Color="Color.Warning"
                                       Size="Size.Small"
                                       OnClick="@(() => GoToEdit(item.Id))"
                                       Title="编辑" />
                        <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                       Color="Color.Error"
                                       Size="Size.Small"
                                       OnClick="@(() => DeleteItem(item))"
                                       Title="删除" />
                    </MudTd>
                </RowTemplate>
                <FooterContent>
                    @{
                        int? _prevGk3 = null;
                    }
                    <MudTd Class="col-selection-td col-footer-cell" Style="width:40px;padding:0 4px;"></MudTd>
                    @foreach (var col in _visibleColumns)
                    {
                        var _isGroupStart3 = col.GroupKey.HasValue && col.GroupKey != _prevGk3;
                        _prevGk3 = col.GroupKey;
                        var _footerClass = GetCellGroupCss(col.GroupKey, _isGroupStart3) + " col-footer-cell";
                        <MudTd Class="@_footerClass"><span class="col-footer-sum">@RenderFooterCell(col)</span></MudTd>
                    }
                    <MudTd Class="col-footer-cell"></MudTd>
                </FooterContent>
                <PagerContent>
                    <MudTablePager PageSizeOptions="new int[]{10,15,25,50,100}" />
                </PagerContent>
            </MudTable>
            </div>
        </MudCardContent>
    </MudCard>
</MudContainer>

