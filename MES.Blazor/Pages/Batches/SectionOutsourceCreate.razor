@page "/section-outsources/create"
@using MES.Blazor.Services
@using Microsoft.AspNetCore.Authorization
@using MES.Blazor.Helpers
@using MES.Blazor.Shared
@using MES.Core.Constants
@using MES.Core.Enums
@using MES.Core.Helpers
@using MES.Core.DTOs.Batch
@inject SectionOutsourceService SectionOutsourceService
@inject BatchService BatchService
@inject OutsourceVendorService OutsourceVendorService
@inject StandardWorkDayService StandardWorkDayService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject IJSRuntime JS
@inject ColumnPrefsService ColumnPrefs
@attribute [Authorize(Roles = Roles.Policies.BatchEdit)]

<MudContainer MaxWidth="MaxWidth.False" Class="mt-4">
    <style>
        .edit-table td.mud-table-cell,
        .edit-table th.mud-table-cell {
            padding: 1px 4px !important;
        }
        .edit-table .mud-input-input-control {
            margin-top: 0;
        }
        .edit-table .mud-input {
            font-size: 13px;
            width: 100%;
            min-width: 0;
        }
        .edit-table th.mud-table-cell {
            white-space: nowrap;
        }
        .table-scroll {
            max-height: calc(100vh - 310px);
            overflow: hidden;
        }
        .table-scroll .mud-table-container {
            overflow-x: auto !important;
        }
    </style>

    <MudCard>
        <MudCardHeader>
            <CardHeaderContent>
                <MudText Typo="Typo.h5" Class="font-weight-bold">
                    <MudIcon Icon="@Icons.Material.Filled.AddCircleOutline" Class="mr-2" Color="Color.Warning" />
                    新建委外发出
                </MudText>
            </CardHeaderContent>
            <CardHeaderActions>
                <MudButton Variant="Variant.Text" Color="Color.Default" OnClick="GoBack">返回工段委外</MudButton>
            </CardHeaderActions>
        </MudCardHeader>

        <MudCardContent>
            <div id="section-outsource-create-table">
                @if (_rows.Any())
                {
                    <div class="d-flex align-center mb-2">
                        <ColumnDisplaySelect Columns="_allColumns"
                                             OnColumnToggle="OnColumnToggle"
                                             OnMoveUp="MoveColumnUp"
                                             OnMoveDown="MoveColumnDown" />
                        <MudButton Variant="Variant.Text" Size="Size.Small"
                                   Color="Color.Default"
                                   StartIcon="@Icons.Material.Filled.RestartAlt"
                                   OnClick="ResetColumnDisplay" Class="ml-2">
                            重置
                        </MudButton>
                        <MudSpacer />
                        <MudText Typo="Typo.body2">共 @_rows.Count 行</MudText>
                        <MudButton Variant="Variant.Text" Size="Size.Small"
                                   Color="Color.Default"
                                   StartIcon="@Icons.Material.Filled.AddCircleOutline"
                                   OnClick="AddRow" Class="ml-2">
                            添加行
                        </MudButton>
                    </div>
                    <div class="table-scroll" id="section-outsource-table-wrapper">
                        @* 分组标题栏 *@
                        <div class="col-group-header-scroll">
                            <div class="col-group-header-bar" style="width: @(_totalTableWidth)px">
                                @foreach (var gh in _groupHeaders)
                                {
                                    <div class="col-group-header-item @gh.CssClass" style="width: @(gh.TotalWidth)px">
                                        <span class="col-group-badge">@gh.GroupName</span>
                                    </div>
                                }
                                <div class="col-group-header-item" style="width:80px;flex:none;"></div>
                            </div>
                        </div>
                        <MudTable Items="@_rows" Dense="true" Hover="true" Elevation="0" Striped="true"
                                  Class="edit-table auto-table" SortMode="SortMode.None" FixedHeader="true">
                            <HeaderContent>
                                @{
                                    int? _prevGk = null;
                                }
                                @foreach (var col in _visibleColumns)
                                {
                                    var _isGroupStart = col.GroupKey.HasValue && col.GroupKey != _prevGk;
                                    _prevGk = col.GroupKey;
                                    var _headerClass = col.GroupKey.HasValue ? GetHeaderGroupCss(col.GroupKey.Value, _isGroupStart) : "";
                                    <MudTh Class="@_headerClass" Style="@($"width:{GetColWidth(col.Key)}px")">
                                        @col.Label
                                        @if (col.IsRequired)
                                        {
                                            <span class="required-star">*</span>
                                        }
                                    </MudTh>
                                }
                                <MudTh Style="width:80px;">操作</MudTh>
                            </HeaderContent>
                            <RowTemplate Context="r">
                                @{
                                    int? _prevGk2 = null;
                                }
                                @foreach (var col in _visibleColumns)
                                {
                                    var _isGroupStart2 = col.GroupKey.HasValue && col.GroupKey != _prevGk2;
                                    _prevGk2 = col.GroupKey;
                                    var _cellClass = col.GroupKey.HasValue ? GetCellGroupCss(col.GroupKey.Value, _isGroupStart2) : "";
                                    <MudTd Class="@_cellClass" Style="@($"width:{GetColWidth(col.Key)}px")">
                                        @RenderCell(r, col)
                                    </MudTd>
                                }
                                <MudTd Style="white-space:nowrap;">
                                    @if (_rows.IndexOf(r) > 0)
                                    {
                                        <MudIconButton Icon="@Icons.Material.Filled.ContentCopy"
                                                       Color="Color.Info" Size="Size.Small"
                                                       Title="与上行相同"
                                                       OnClick="() => CopyFromAbove(r, _rows.IndexOf(r))" />
                                    }
                                    <MudIconButton Icon="@Icons.Material.Filled.RemoveCircleOutline"
                                                   Color="Color.Error" Size="Size.Small"
                                                   Title="删除"
                                                   OnClick="() => RemoveRow(r)"
                                                   Disabled="@(_rows.Count <= 1)" />
                                </MudTd>
                            </RowTemplate>
                            <FooterContent>
                                @{
                                    int? _prevGk3 = null;
                                }
                                @foreach (var col in _visibleColumns)
                                {
                                    var _isGroupStart3 = col.GroupKey.HasValue && col.GroupKey != _prevGk3;
                                    _prevGk3 = col.GroupKey;
                                    var _footerClass = col.GroupKey.HasValue ? GetCellGroupCss(col.GroupKey.Value, _isGroupStart3) : "";
                                    <MudTd Class="@_footerClass" Style="@($"width:{GetColWidth(col.Key)}px")"></MudTd>
                                }
                                <MudTd>
                                    <MudIconButton Icon="@Icons.Material.Filled.AddCircleOutline"
                                                   Color="Color.Warning" Size="Size.Small"
                                                   OnClick="AddRow" />
                                </MudTd>
                            </FooterContent>
                        </MudTable>
                    </div>
                }
            </div>

            @if (!string.IsNullOrEmpty(_errorMessage))
            {
                <MudText Typo="Typo.body2" Color="Color.Error" Class="mt-4">@_errorMessage</MudText>
            }

            @if (_rows.Any())
            {
                <MudGrid Class="mt-4">
                    <MudItem xs="12" Class="d-flex justify-end">
                        <MudButton Variant="Variant.Filled" Color="Color.Warning"
                                   StartIcon="@Icons.Material.Filled.CloudUpload"
                                   OnClick="Submit" Loading="@_isSubmitting"
                                   Size="Size.Large">
                            确认提交 (@_rows.Count 条)
                        </MudButton>
                    </MudItem>
                </MudGrid>
            }
        </MudCardContent>
    </MudCard>
</MudContainer>

@code {
    private List<EditRow> _rows = new();
    private bool _isSubmitting;
    private bool _isArrowNavSetup;
    private string _errorMessage = string.Empty;

    // 工段下拉选项（Key 存储值 + 中文显示文本；从参数表加载启用工段，失败降级为预置 26 工段）
    private List<(string Key, string Text)> _sectionOptions = new();

    // 启用中的委外单位档案全量（active，小表）：委外单位/厂内判定由档案驱动，按行工段过滤
    private List<OutsourceVendorProfileDto> _activeVendors = new();

    // ========== 列定义 ==========

    private List<ColumnDef> _allColumns = new();
    private List<ColumnDef> _visibleColumns =>
        _allColumns.Where(c => c.IsApplicable && c.Visible).ToList();

    private int _totalTableWidth =>
        _visibleColumns.Sum(c => GetColWidth(c.Key)) + 80; // +80px 操作列

    private List<GroupHeaderInfo> _groupHeaders => GetGroupHeaders();

    private class GroupHeaderInfo
    {
        public int GroupKey { get; init; }
        public string GroupName { get; init; } = "";
        public int TotalWidth { get; init; }
        public int ColumnCount { get; init; }
        public string CssClass { get; init; } = "";
    }

    private static int GetColWidth(string key) => key switch
    {
        "SendOutDate" => 140,
        "BatchNo" => 150,
        "ProcessName" => 170,
        "SectionName" => 120,
        "IsInternal" => 70,
        "TagNo" => 130,
        "PlantGrade" => 130,
        "OutsourceSpec" => 140,
        "ManufacturingSpec" => 170,
        "SendQuantity" => 110,
        "SendWeight" => 120,
        "PricingUnit" => 110,
        "UnitPrice" => 120,
        "TotalAmount" => 130,
        "OutsourceVendor" => 150,
        "ExpectedReturnDate" => 140,
        "IsUrgent" => 80,
        "Remark" => 150,
        _ => 130
    };

    private static List<ColumnDef> GetAllColumnDefs() => new()
    {
        // G1：发出信息
        new() { Key = "SendOutDate",       Label = "发出日期", IsRequired = true, GroupKey = 1, GroupName = "发出信息" },
        new() { Key = "BatchNo",           Label = "生产编号", IsRequired = true, GroupKey = 1, GroupName = "发出信息" },
        new() { Key = "ProcessName",       Label = "工序名称", IsRequired = true, GroupKey = 1, GroupName = "发出信息" },
        new() { Key = "SectionName",       Label = "工段名称", IsRequired = true, GroupKey = 1, GroupName = "发出信息" },
        // G2：可填充
        new() { Key = "TagNo",             Label = "挂牌号",                   GroupKey = 2, GroupName = "可填充" },
        new() { Key = "PlantGrade",        Label = "工厂牌号",                 GroupKey = 2, GroupName = "可填充" },
        new() { Key = "OutsourceSpec",     Label = "委外规格",                 GroupKey = 2, GroupName = "可填充" },
        new() { Key = "ManufacturingSpec", Label = "制造规格", IsRequired = true, GroupKey = 2, GroupName = "可填充" },
        // G3：发出计量
        new() { Key = "SendQuantity",      Label = "发出支数",                 GroupKey = 3, GroupName = "发出计量" },
        new() { Key = "SendWeight",        Label = "发出重量",                 GroupKey = 3, GroupName = "发出计量" },
        // G3.5：计价（随发出计量一起，厂内无价禁用）
        new() { Key = "PricingUnit",       Label = "计价单位",                 GroupKey = 3, GroupName = "发出计量" },
        new() { Key = "UnitPrice",         Label = "单价(元)",                 GroupKey = 3, GroupName = "发出计量" },
        new() { Key = "TotalAmount",       Label = "总价(元)",                 GroupKey = 3, GroupName = "发出计量" },
        // G4：其他
        new() { Key = "OutsourceVendor",   Label = "委外单位", IsRequired = true, GroupKey = 4, GroupName = "其他" },
        new() { Key = "IsInternal",        Label = "厂内",                     GroupKey = 4, GroupName = "其他" },
        new() { Key = "ExpectedReturnDate",Label = "要求收回日期",             GroupKey = 4, GroupName = "其他" },
        new() { Key = "IsUrgent",          Label = "紧急",                     GroupKey = 4, GroupName = "其他" },
        new() { Key = "Remark",            Label = "备注",                     GroupKey = 4, GroupName = "其他" },
    };

    private List<GroupHeaderInfo> GetGroupHeaders()
    {
        var result = new List<GroupHeaderInfo>();
        int? lastKey = null; int totalWidth = 0;
        var groupKey = 0; var groupName = ""; var count = 0;
        foreach (var col in _visibleColumns)
        {
            var gk = col.GroupKey ?? 0;
            if (gk != lastKey && lastKey.HasValue)
            {
                result.Add(new GroupHeaderInfo { GroupKey = groupKey, GroupName = groupName, TotalWidth = totalWidth, ColumnCount = count, CssClass = GetHeaderGroupCss(groupKey, true) });
                totalWidth = 0; count = 0;
            }
            groupKey = gk; groupName = col.GroupName ?? "";
            totalWidth += GetColWidth(col.Key);
            count++; lastKey = gk;
        }
        if (count > 0)
            result.Add(new GroupHeaderInfo { GroupKey = groupKey, GroupName = groupName, TotalWidth = totalWidth, ColumnCount = count, CssClass = GetHeaderGroupCss(groupKey, true) });
        return result;
    }

    private static string GetHeaderGroupCss(int groupKey, bool isGroupStart) =>
        groupKey switch { 1 => "col-g1", 2 => "col-g2", 3 => "col-g3", 4 => "col-g4", _ => "" };

    private static string GetCellGroupCss(int? groupKey, bool isGroupStart) =>
        groupKey switch { 1 => "col-g1-cell", 2 => "col-g2-cell", 3 => "col-g3-cell", 4 => "col-g4-cell", _ => "" };

    private async Task OnColumnToggle(ColumnDef col)
    {
        await SaveColumnPrefs();
    }

    private async Task SaveColumnPrefs()
    {
        await ColumnPrefs.SaveAsync("section-outsource-create", null, _allColumns);
    }

    private async Task ResetColumnDisplay()
    {
        _allColumns = GetAllColumnDefs();
        await SaveColumnPrefs();
    }

    private async Task MoveColumnUp(ColumnDef col)
    {
        await SaveColumnPrefs();
    }

    private async Task MoveColumnDown(ColumnDef col)
    {
        await SaveColumnPrefs();
    }

    private class EditRow
    {
        public string BatchNo { get; set; } = string.Empty;
        public int? ProcessGroupId { get; set; }                                                // 选中的批次工序组 Id（工序组粒度下拉绑定，消除同名工序组规格歧义）
        public string ProcessName { get; set; } = string.Empty;
        public string? ManufacturingSpec { get; set; }
        public string SectionName { get; set; } = string.Empty;
        // 厂内（虚拟发外）：仅限冷轧拔工段，无需回收，状态=略；由委外单位档案(本厂车间 IsWorkshop)派生，无手动开关
        public bool IsInternal { get; set; }
        public string OutsourceVendor { get; set; } = string.Empty;
        public OutsourceVendorProfileDto? VendorProfile { get; set; }
        // ========== 计价三字段（厂内无价，均 null） ==========
        public PricingUnit? PricingUnit { get; set; }
        public decimal? UnitPrice { get; set; }
        public decimal? TotalAmount { get; set; }
        /// <summary>总价是否被手动改过（手填优先，后续重量/单价变更不再自动覆盖）</summary>
        public bool TotalAmountTouched { get; set; }
        public string? SendOutDateText { get; set; } = DateTime.Today.ToString("yyyy-MM-dd");
        public DateTime? SendOutDate => DateTime.TryParse(SendOutDateText, out var d) ? d : null;
        public int? SendQuantity { get; set; }
        public decimal? SendWeight { get; set; }
        public string? TagNo { get; set; }
        public string? PlantGrade { get; set; }
        public string? OutsourceSpec { get; set; }
        public string? ExpectedReturnDateText { get; set; }
        public DateTime? ExpectedReturnDate => DateTime.TryParse(ExpectedReturnDateText, out var d) ? d : null;
        public bool IsUrgent { get; set; }
        public string? Remark { get; set; }
    }

    // 加载启用工段下拉（从参数表，失败降级为预置 26 工段）
    private async Task LoadSectionOptionsAsync()
    {
        var r = await StandardWorkDayService.GetEnabledSectionsAsync();
        if (r.Success && r.Data != null)
            _sectionOptions = r.Data.Select(x => (x.SectionKey, SectionDisplayHelper.GetSectionNameText(x.SectionKey))).ToList();
        else
            _sectionOptions = SectionKeys.All.Select(k => (k, SectionDisplayHelper.GetSectionNameText(k))).ToList();
    }

    // ========== 批次工序组（工序组粒度下拉，消除同名工序组规格歧义） ==========
    // 批次详情缓存（BatchNo → 批次），工序组下拉选项与联动共用，避免重复请求
    private readonly Dictionary<string, ProductionBatchDetailDto> _batchCache = new(StringComparer.OrdinalIgnoreCase);

    private ProductionBatchDetailDto? GetRowBatch(EditRow r)
        => !string.IsNullOrWhiteSpace(r.BatchNo) && _batchCache.TryGetValue(r.BatchNo, out var b) ? b : null;

    private List<ProcessGroupDto> GetRowProcessGroups(EditRow r)
        => GetRowBatch(r)?.ProcessGroups ?? new List<ProcessGroupDto>();

    private ProcessGroupDto? FindRowProcessGroup(EditRow r, int? pgId)
        => pgId.HasValue ? GetRowProcessGroups(r).FirstOrDefault(p => p.Id == pgId.Value) : null;

    // 工序组下拉显示：工序名（制造规格），同名工序组用规格区分
    private string GetProcessGroupDisplayText(EditRow r, int? pgId)
    {
        var pg = FindRowProcessGroup(r, pgId);
        if (pg == null) return "";
        return $"{ProcessDisplayHelper.GetProcessNameText(pg.ProcessName)}（{pg.ManufacturingSpec ?? ""}）";
    }

    /// <summary>批次变更后重解析工序组：已选工序组仍有效则保持；否则按工序名称唯一匹配自动绑定，同名多规格/无匹配则清空让用户下拉重选</summary>
    private void ResolveProcessGroupAfterBatchChange(EditRow row, List<ProcessGroupDto>? pgs)
    {
        var list = pgs ?? new List<ProcessGroupDto>();
        if (row.ProcessGroupId.HasValue && list.Any(p => p.Id == row.ProcessGroupId.Value))
            return;
        var sameName = list.Where(p => p.ProcessName == row.ProcessName).ToList();
        if (sameName.Count == 1)
        {
            row.ProcessGroupId = sameName[0].Id;
            row.ManufacturingSpec = sameName[0].ManufacturingSpec;
        }
        else
        {
            row.ProcessGroupId = null;
            row.ManufacturingSpec = null;
        }
    }

    /// <summary>选中批次工序组 → 填充工序名称/制造规格 + 委外规格</summary>
    private void OnProcessGroupSelected(EditRow row, int? pgId)
    {
        var pg = FindRowProcessGroup(row, pgId);
        if (pg == null)
        {
            row.ProcessGroupId = null;
            row.ProcessName = "";
            row.ManufacturingSpec = null;
            row.OutsourceSpec = null;
            StateHasChanged();
            return;
        }
        row.ProcessGroupId = pg.Id;
        row.ProcessName = pg.ProcessName;
        row.ManufacturingSpec = pg.ManufacturingSpec;
        FillOutsourceSpec(row, GetRowProcessGroups(row), pg);
        StateHasChanged();
    }

    private string GetSectionDisplayText(string key)
    {
        if (string.IsNullOrEmpty(key)) return key ?? "";
        foreach (var o in _sectionOptions)
            if (string.Equals(o.Key, key, StringComparison.OrdinalIgnoreCase)) return o.Text;
        return key;
    }

    protected override async Task OnInitializedAsync()
    {
        var vendorResult = await OutsourceVendorService.GetActiveAsync();
        if (vendorResult.Success && vendorResult.Data != null)
            _activeVendors = vendorResult.Data;

        await LoadSectionOptionsAsync();
        _allColumns = GetAllColumnDefs();
        var saved = await ColumnPrefs.LoadAsync("section-outsource-create", null);
        if (saved.Count > 0)
        {
            foreach (var s in saved)
            {
                var match = _allColumns.FirstOrDefault(c => c.Key == s.Key);
                if (match != null)
                    match.Visible = s.Visible;
            }
            var reordered = new List<ColumnDef>();
            foreach (var s in saved)
            {
                var match = _allColumns.FirstOrDefault(c => c.Key == s.Key);
                if (match != null && !reordered.Contains(match))
                    reordered.Add(match);
            }
            foreach (var c in _allColumns)
            {
                if (!reordered.Contains(c))
                    reordered.Add(c);
            }
            _allColumns = reordered;
        }

        if (!_rows.Any())
            _rows.Add(new EditRow());
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        try
        {
            await JS.InvokeVoidAsync("initGroupHeaders", "#section-outsource-table-wrapper");
        }
        catch { }

        if (!_isArrowNavSetup)
        {
            _isArrowNavSetup = true;
            if (!await JS.InvokeAsync<bool>("enableTableArrowNav", "#section-outsource-table-wrapper"))
                _isArrowNavSetup = false;
        }
    }

    private void AddRow()
    {
        var newRow = new EditRow();
        if (_rows.Any())
        {
            var source = _rows[^1];
            newRow.BatchNo = source.BatchNo;
            newRow.ProcessGroupId = source.ProcessGroupId;
            newRow.ProcessName = source.ProcessName;
            newRow.ManufacturingSpec = source.ManufacturingSpec;
            newRow.SectionName = source.SectionName;
            newRow.SendOutDateText = source.SendOutDateText;
            newRow.TagNo = source.TagNo;
            newRow.PlantGrade = source.PlantGrade;
            newRow.OutsourceSpec = source.OutsourceSpec;
            newRow.ExpectedReturnDateText = source.ExpectedReturnDateText;
            newRow.IsUrgent = source.IsUrgent;
            newRow.OutsourceVendor = source.OutsourceVendor;
            newRow.VendorProfile = source.VendorProfile;
            newRow.IsInternal = source.IsInternal;
        }
        if (newRow.VendorProfile == null) newRow.IsInternal = false;
        else if (newRow.VendorProfile.IsWorkshop) ClearPricing(newRow);
        else ApplyPricingDefaults(newRow);
        _rows.Add(newRow);
    }

    private void RemoveRow(EditRow row)
    {
        if (_rows.Count <= 1) return;
        _rows.Remove(row);
    }

    /// <summary>
    /// 下行复制上行（发出支数+发出重量+备注 不复制）
    /// </summary>
    private void CopyFromAbove(EditRow row, int index)
    {
        if (index <= 0) return;
        var source = _rows[index - 1];
        row.BatchNo = source.BatchNo;
        row.ProcessGroupId = source.ProcessGroupId;
        row.ProcessName = source.ProcessName;
        row.ManufacturingSpec = source.ManufacturingSpec;
        row.SectionName = source.SectionName;
        row.SendOutDateText = source.SendOutDateText;
        row.TagNo = source.TagNo;
        row.PlantGrade = source.PlantGrade;
        row.OutsourceSpec = source.OutsourceSpec;
        row.ExpectedReturnDateText = source.ExpectedReturnDateText;
        row.IsUrgent = source.IsUrgent;
        row.OutsourceVendor = source.OutsourceVendor;
        row.VendorProfile = source.VendorProfile;
        row.IsInternal = source.IsInternal;
        if (row.VendorProfile == null) row.IsInternal = false;
        else if (row.VendorProfile.IsWorkshop) ClearPricing(row);
        else ApplyPricingDefaults(row);
        StateHasChanged();
    }

    // ========== 委外单位档案下拉 + 计价联动 ==========

    /// <summary>当前行可选档案候选（启用中 + 工段匹配），供 MudAutocomplete SearchFunc 使用</summary>
    private List<OutsourceVendorProfileDto> GetVendorCandidates(EditRow r)
        => _activeVendors
            .Where(p => p.IsActive
                        && (string.IsNullOrWhiteSpace(r.SectionName) // 行工段未定时列出全部启用档案，先选单位再带出工段
                            || string.Equals(p.SectionName, r.SectionName, StringComparison.OrdinalIgnoreCase)))
            .ToList();

    /// <summary>选择委外单位档案：本厂车间(IsWorkshop)→厂内；厂内仅限冷轧拔，自动锁定工段为冷轧拔</summary>
    private async Task OnVendorSelectedAsync(EditRow r, OutsourceVendorProfileDto? p)
    {
        if (p != null)
        {
            // 委外单位×委外工段 档案绑定：行工段未定/与档案不符时，一律同步为档案工段后联动重填委外规格
            if (!string.Equals(p.SectionName, r.SectionName, StringComparison.OrdinalIgnoreCase))
            {
                r.SectionName = p.SectionName;
                await ApplyAutoFillAsync(r); // 工段变更后重填委外规格/制造规格（冷轧拔取上个工序组、其它取本工序组）
            }
        }
        r.VendorProfile = p;
        r.OutsourceVendor = p?.VendorName ?? "";
        r.IsInternal = p?.IsWorkshop == true;
        if (r.IsInternal) ClearPricing(r);
        else ApplyPricingDefaults(r);
        StateHasChanged();
    }

    /// <summary>工段变更：校验已选委外单位档案是否仍命中新工段，不命中则清空让用户重选；刷新计价默认</summary>
    private async Task OnSectionChangedAsync(EditRow r, string section)
    {
        r.SectionName = section ?? "";
        if (r.VendorProfile != null
            && !string.Equals(r.VendorProfile.SectionName, r.SectionName, StringComparison.OrdinalIgnoreCase))
        {
            r.VendorProfile = null;
            r.OutsourceVendor = "";
            r.IsInternal = false;
            ClearPricing(r);
        }
        await ApplyAutoFillAsync(r);
        if (!r.IsInternal) ApplyPricingDefaults(r);
        StateHasChanged();
    }

    /// <summary>厂内（本厂车间）：无价，三价格字段清空</summary>
    private static void ClearPricing(EditRow r)
    {
        r.PricingUnit = null;
        r.UnitPrice = null;
        r.TotalAmount = null;
        r.TotalAmountTouched = false;
    }

    /// <summary>厂外计价默认：计价单位空→元/Kg；单价空→按工段默认（冷轧拔1.4/其他0.8）；未手改总价则按取量自动算</summary>
    private void ApplyPricingDefaults(EditRow r)
    {
        if (r.IsInternal) { ClearPricing(r); return; }
        r.PricingUnit ??= MaterialPricingDefaults.DefaultPricingUnit;
        if (r.UnitPrice == null && !string.IsNullOrWhiteSpace(r.SectionName))
            r.UnitPrice = MaterialPricingDefaults.DefaultSectionOutsourceUnitPrice(r.SectionName);
        RecomputeTotal(r);
    }

    /// <summary>按计价单位自动算总价：PerKg→重量、PerPiece→支数、PerMeter→无米数不入自动（留空手填）</summary>
    private static void RecomputeTotal(EditRow r)
    {
        if (r.IsInternal) { ClearPricing(r); return; }
        if (r.TotalAmountTouched) return;
        decimal? qty = r.PricingUnit switch
        {
            PricingUnit.PerKg => r.SendWeight,
            PricingUnit.PerPiece => r.SendQuantity,
            _ => null
        };
        if (r.UnitPrice.HasValue && qty.HasValue && qty > 0)
            r.TotalAmount = decimal.Round(r.UnitPrice.Value * qty.Value, 2, MidpointRounding.AwayFromZero);
        else
            r.TotalAmount = null;
    }

    // ========== 自动填充 ==========

    /// <summary>
    /// 统一自动填充：BatchNo/ProcessName/ManufacturingSpec/SectionName 任一变更时触发
    /// </summary>
    private async Task ApplyAutoFillAsync(EditRow row)
    {
        if (string.IsNullOrWhiteSpace(row.BatchNo))
            return;

        var result = await BatchService.GetByBatchNoAsync(row.BatchNo);
        if (!result.Success || result.Data == null)
            return;

        var batch = result.Data;
        _batchCache[batch.BatchNo] = batch;

        // 填充批次级冗余字段
        row.TagNo = batch.TagNo;
        row.PlantGrade = batch.PlantGrade;

        // 查找匹配的工序组（优先按已选工序组 Id，其次按工序名称，再次按制造规格反查）
        ProcessGroupDto? currentPg = FindRowProcessGroup(row, row.ProcessGroupId);
        if (currentPg == null && !string.IsNullOrWhiteSpace(row.ProcessName))
            currentPg = batch.ProcessGroups?.FirstOrDefault(p => p.ProcessName == row.ProcessName);
        currentPg ??= batch.ProcessGroups?.FirstOrDefault(p => p.ManufacturingSpec == row.ManufacturingSpec);

        if (currentPg == null)
        {
            row.ProcessGroupId = null;
            StateHasChanged();
            return;
        }

        // 从工序组填充（同步选中工序组 Id，消除同名工序组规格歧义）
        row.ProcessGroupId = currentPg.Id;
        row.ProcessName = currentPg.ProcessName;
        row.ManufacturingSpec = currentPg.ManufacturingSpec;

        // 按工段名称决定委外规格
        FillOutsourceSpec(row, batch.ProcessGroups, currentPg);

        StateHasChanged();
    }

    /// <summary>
    /// 按工段名称决定委外规格：
    /// 冷轧拔 → 上个工序组的制造规格；其他 → 等于本工序制造规格
    /// </summary>
    private static void FillOutsourceSpec(EditRow row, List<ProcessGroupDto>? processGroups, ProcessGroupDto currentPg)
    {
        if (string.IsNullOrWhiteSpace(row.SectionName))
            return;

        if (row.SectionName == SectionKeys.ColdRollDraw)
        {
            var prevPg = processGroups?
                .Where(p => p.SequenceNumber < currentPg.SequenceNumber)
                .OrderByDescending(p => p.SequenceNumber)
                .FirstOrDefault();
            row.OutsourceSpec = prevPg?.ManufacturingSpec;
        }
        else
        {
            row.OutsourceSpec = currentPg.ManufacturingSpec;
        }
    }

