            case "TagNo":
                builder.OpenComponent<MudTextField<string>>(0);
                builder.AddAttribute(1, "Dense", true);
                builder.AddAttribute(2, "Variant", Variant.Outlined);
                builder.AddAttribute(3, "Size", Size.Small);
                builder.AddAttribute(4, "Value", r.TagNo);
                builder.AddAttribute(5, "ValueChanged", EventCallback.Factory.Create<string?>(this, v => r.TagNo = v));
                builder.CloseComponent();
                break;
            case "PlantGrade":
                builder.OpenComponent<MudTextField<string>>(0);
                builder.AddAttribute(1, "Dense", true);
                builder.AddAttribute(2, "Variant", Variant.Outlined);
                builder.AddAttribute(3, "Size", Size.Small);
                builder.AddAttribute(4, "Value", r.PlantGrade);
                builder.AddAttribute(5, "ValueChanged", EventCallback.Factory.Create<string?>(this, v => r.PlantGrade = v));
                builder.CloseComponent();
                break;
            case "OutsourceSpec":
                builder.OpenComponent<MudTextField<string>>(0);
                builder.AddAttribute(1, "Dense", true);
                builder.AddAttribute(2, "Variant", Variant.Outlined);
                builder.AddAttribute(3, "Size", Size.Small);
                builder.AddAttribute(4, "Value", r.OutsourceSpec);
                builder.AddAttribute(5, "ValueChanged", EventCallback.Factory.Create<string?>(this, v => r.OutsourceSpec = v));
                builder.CloseComponent();
                break;
            case "ExpectedReturnDate":
                builder.OpenComponent<MudTextField<string>>(0);
                builder.AddAttribute(1, "Dense", true);
                builder.AddAttribute(2, "Variant", Variant.Outlined);
                builder.AddAttribute(3, "Size", Size.Small);
                builder.AddAttribute(4, "Value", r.ExpectedReturnDateText);
                builder.AddAttribute(5, "ValueChanged", EventCallback.Factory.Create<string?>(this, v => r.ExpectedReturnDateText = v));
                builder.AddAttribute(6, "Placeholder", "yyyy-MM-dd");
                builder.CloseComponent();
                break;
            case "IsUrgent":
                builder.OpenComponent<MudCheckBox<bool>>(0);
                builder.AddAttribute(1, "Color", Color.Warning);
                builder.AddAttribute(3, "Value", r.IsUrgent);
                builder.AddAttribute(4, "ValueChanged", EventCallback.Factory.Create<bool>(this, v => r.IsUrgent = v));
                builder.CloseComponent();
                break;
            case "Remark":
                builder.OpenComponent<MudTextField<string>>(0);
                builder.AddAttribute(1, "Dense", true);
                builder.AddAttribute(2, "Variant", Variant.Outlined);
                builder.AddAttribute(3, "Size", Size.Small);
                builder.AddAttribute(4, "Value", r.Remark);
                builder.AddAttribute(5, "ValueChanged", EventCallback.Factory.Create<string?>(this, v => r.Remark = v));
                builder.CloseComponent();
                break;
            default:
                builder.AddContent(0, "");
                break;
        }
    };

    // ========== 提交 ==========

    private async Task Submit()
    {
        _errorMessage = string.Empty;

        var errors = new List<string>();
        for (int i = 0; i < _rows.Count; i++)
        {
            var r = _rows[i];
            if (string.IsNullOrWhiteSpace(r.BatchNo))
                errors.Add($"第{i + 1}行：批次号不能为空");
            if (string.IsNullOrWhiteSpace(r.ProcessName))
                errors.Add($"第{i + 1}行：工序名称不能为空");
            if (string.IsNullOrWhiteSpace(r.SectionName))
                errors.Add($"第{i + 1}行：工段名称不能为空");
            if (string.IsNullOrWhiteSpace(r.OutsourceVendor))
                errors.Add($"第{i + 1}行：委外单位不能为空");
            if (string.IsNullOrWhiteSpace(r.ManufacturingSpec))
                errors.Add($"第{i + 1}行：制造规格不能为空");
        }

        if (errors.Any())
        {
            Snackbar.Add(string.Join("；", errors), Severity.Error);
            return;
        }

        _isSubmitting = true;
        StateHasChanged();

        try
        {
            var requests = _rows.Select(r => new CreateSectionOutsourceRequest
            {
                BatchNo = r.BatchNo.Trim(),
                ProcessName = r.ProcessName.Trim(),
                ManufacturingSpec = r.ManufacturingSpec?.Trim() ?? "",
                SectionName = r.SectionName.Trim(),
                OutsourceVendor = r.OutsourceVendor.Trim(),
                SendOutDate = r.SendOutDate ?? DateTime.Today,
                SendQuantity = r.SendQuantity,
                SendWeight = r.SendWeight,
                TagNo = r.TagNo?.Trim(),
                PlantGrade = r.PlantGrade?.Trim(),
                OutsourceSpec = r.OutsourceSpec?.Trim(),
                ExpectedReturnDate = r.ExpectedReturnDate,
                IsUrgent = r.IsUrgent,
                Remark = r.Remark?.Trim(),
                DataSource = "MANUAL"
            }).ToList();

            var result = await SectionOutsourceService.BatchCreateAsync(requests);

            if (result.Success && result.Data != null)
            {
                Snackbar.Add($"成功创建 {result.Data.Count} 条委外发出记录", Severity.Success);
                Navigation.NavigateTo("/section-outsources");
            }
            else
            {
                _errorMessage = result.Message ?? "批量创建失败";
            }
        }
        catch (Exception ex)
        {
            _errorMessage = $"网络错误: {ex.Message}";
        }
        finally
        {
            _isSubmitting = false;
            StateHasChanged();
        }
    }

    private void GoBack()
    {
        Navigation.NavigateTo("/section-outsources");
    }

    // ========== 搜索委外单位（MudAutocomplete）==========

    private async Task<IEnumerable<string>> SearchVendorsAsync(string? keyword)
    {
        var result = await SectionOutsourceService.SearchVendorsAsync(keyword);
        return result ?? new List<string>();
    }
