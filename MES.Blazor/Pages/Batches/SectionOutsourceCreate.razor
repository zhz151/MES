@page "/section-outsources/create"
@using MES.Core.DTOs
@using MES.Blazor.Services
@using Microsoft.AspNetCore.Authorization
@using MES.Blazor.Shared
@inject SectionOutsourceService SectionOutsourceService
@inject BatchService BatchService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject IJSRuntime JS
@inject ColumnPrefsService ColumnPrefs
@attribute [Authorize(Roles = "BatchDirector,Admin")]

<MudContainer MaxWidth="MaxWidth.False" Class="mt-4">
    <style>
        .edit-table td.mud-table-cell,
        .edit-table th.mud-table-cell {
            padding: 1px 4px !important;
        }
        .edit-table .mud-input-input-control {
            margin-top: 0;
        }
        .edit-table .mud-input {
            font-size: 13px;
            width: 100%;
            min-width: 0;
        }
        .edit-table th.mud-table-cell {
            white-space: nowrap;
        }
        .table-scroll {
            max-height: calc(100vh - 280px);
            overflow-y: auto;
            overflow-x: auto;
        }
    </style>

    <MudCard>
        <MudCardHeader>
            <CardHeaderContent>
                <MudText Typo="Typo.h5" Class="font-weight-bold">
                    <MudIcon Icon="@Icons.Material.Filled.AddCircleOutline" Class="mr-2" Color="Color.Warning" />
                    新建委外发出
                </MudText>
            </CardHeaderContent>
            <CardHeaderActions>
                <MudButton Variant="Variant.Text" Color="Color.Default" OnClick="GoBack">返回工段委外</MudButton>
            </CardHeaderActions>
        </MudCardHeader>

        <MudCardContent>
            <div id="section-outsource-create-table">
                @if (_rows.Any())
                {
                    <div class="d-flex align-center mb-2">
                        <ColumnDisplaySelect Columns="_allColumns"
                                             OnColumnToggle="OnColumnToggle"
                                             OnMoveUp="MoveColumnUp"
                                             OnMoveDown="MoveColumnDown" />
                        <MudButton Variant="Variant.Text" Size="Size.Small"
                                   Color="Color.Default"
                                   StartIcon="@Icons.Material.Filled.RestartAlt"
                                   OnClick="ResetColumnDisplay" Class="ml-2">
                            重置
                        </MudButton>
                        <MudSpacer />
                        <MudText Typo="Typo.body2">共 @_rows.Count 行</MudText>
                        <MudButton Variant="Variant.Text" Size="Size.Small"
                                   Color="Color.Default"
                                   StartIcon="@Icons.Material.Filled.AddCircleOutline"
                                   OnClick="AddRow" Class="ml-2">
                            添加行
                        </MudButton>
                    </div>
                    <div class="table-scroll">
                        <MudTable Items="@_rows" Dense="true" Hover="true" Elevation="0" Striped="true"
                                  Class="edit-table auto-table" SortMode="SortMode.None" FixedHeader="true">
                            <HeaderContent>
                                @foreach (var col in _visibleColumns)
                                {
                                    <MudTh>
                                        @col.Label
                                        @if (col.IsRequired)
                                        {
                                            <span class="required-star">*</span>
                                        }
                                    </MudTh>
                                }
                                <MudTh Style="width:60px;">操作</MudTh>
                            </HeaderContent>
                            <RowTemplate Context="r">
                                @foreach (var col in _visibleColumns)
                                {
                                    <MudTd>@RenderCell(r, col)</MudTd>
                                }
                                <MudTd>
                                    <MudIconButton Icon="@Icons.Material.Filled.RemoveCircleOutline"
                                                   Color="Color.Error" Size="Size.Small"
                                                   Title="删除"
                                                   OnClick="() => RemoveRow(r)"
                                                   Disabled="@(_rows.Count <= 1)" />
                                </MudTd>
                            </RowTemplate>
                            <FooterContent>
                                <MudTd colspan="@(_visibleColumns.Count + 1)">
                                    <MudIconButton Icon="@Icons.Material.Filled.AddCircleOutline"
                                                   Color="Color.Warning" Size="Size.Small"
                                                   OnClick="AddRow" />
                                </MudTd>
                            </FooterContent>
                        </MudTable>
                    </div>
                }
            </div>

            @if (!string.IsNullOrEmpty(_errorMessage))
            {
                <MudText Typo="Typo.body2" Color="Color.Error" Class="mt-4">@_errorMessage</MudText>
            }

            @if (_rows.Any())
            {
                <MudGrid Class="mt-4">
                    <MudItem xs="12" Class="d-flex justify-end">
                        <MudButton Variant="Variant.Filled" Color="Color.Warning"
                                   StartIcon="@Icons.Material.Filled.CloudUpload"
                                   OnClick="Submit" Loading="@_isSubmitting"
                                   Size="Size.Large">
                            确认提交 (@_rows.Count 条)
                        </MudButton>
                    </MudItem>
                </MudGrid>
            }
        </MudCardContent>
    </MudCard>
</MudContainer>

@code {
    private List<EditRow> _rows = new();
    private bool _isSubmitting;
    private bool _isArrowNavSetup;
    private string _errorMessage = string.Empty;

    // ========== 列定义 ==========

    private List<ColumnDef> _allColumns = new();
    private List<ColumnDef> _visibleColumns =>
        _allColumns.Where(c => c.IsApplicable && c.Visible).ToList();

    private static List<ColumnDef> GetAllColumnDefs() => new()
    {
        new() { Key = "BatchNo",           Label = "批次号", IsRequired = true },                 // → Entity.ProductionBatchId（通过批次号解析关联批次）
        new() { Key = "ProcessName",       Label = "工序名称", IsRequired = true },               // → Entity.ProcessName + 联合解析 ProcessGroupId
        new() { Key = "ManufacturingSpec", Label = "制造规格", IsRequired = true },               // → Entity.ManufacturingSpec + 联合解析 ProcessGroupId
        new() { Key = "SectionName",       Label = "工段名称", IsRequired = true },               // → Entity.SectionName（与ProcessGroupId联合解析SequenceNumber）
        new() { Key = "OutsourceVendor",   Label = "委外单位", IsRequired = true },               // → Entity.OutsourceVendor
        new() { Key = "SendOutDate",       Label = "发出日期", IsRequired = true },               // → Entity.SendOutDate
        new() { Key = "SendQuantity",      Label = "发出支数" },                 // → Entity.SendQuantity
        new() { Key = "SendWeight",        Label = "发出重量" },                 // → Entity.SendWeight
        new() { Key = "TagNo",             Label = "挂牌号" },                   // → Entity.TagNo（来自批次信息）
        new() { Key = "PlantGrade",        Label = "工厂牌号" },                 // → Entity.PlantGrade（来自批次信息）
        new() { Key = "OutsourceSpec",     Label = "委外规格" },                 // → Entity.OutsourceSpec
        new() { Key = "ExpectedReturnDate",Label = "要求收回日期" },             // → Entity.ExpectedReturnDate
        new() { Key = "IsUrgent",          Label = "紧急" },                     // → Entity.IsUrgent
        new() { Key = "Remark",            Label = "备注" },                     // → Entity.Remark
    };

    private async Task OnColumnToggle(ColumnDef col)
    {
        await SaveColumnPrefs();
    }

    private async Task SaveColumnPrefs()
    {
        await ColumnPrefs.SaveAsync("section-outsource-create", null, _allColumns);
    }

    private async Task ResetColumnDisplay()
    {
        _allColumns = GetAllColumnDefs();
        await SaveColumnPrefs();
    }

    private async Task MoveColumnUp(ColumnDef col)
    {
        await SaveColumnPrefs();
    }

    private async Task MoveColumnDown(ColumnDef col)
    {
        await SaveColumnPrefs();
    }

    private class EditRow
    {
        public string BatchNo { get; set; } = string.Empty;                                     // → Entity.ProductionBatchId
        public string ProcessName { get; set; } = string.Empty;                                 // → Entity.ProcessName + 联合解析 ProcessGroupId
        public string? ManufacturingSpec { get; set; }                                          // → Entity.ManufacturingSpec + 联合解析 ProcessGroupId
        public string SectionName { get; set; } = string.Empty;                                 // → Entity.SectionName（与ProcessGroupId联合解析SequenceNumber）
        public string OutsourceVendor { get; set; } = string.Empty;                             // → Entity.OutsourceVendor
        public string? SendOutDateText { get; set; } = DateTime.Today.ToString("yyyy-MM-dd");   // → Entity.SendOutDate（字符串表示）
        public DateTime? SendOutDate => DateTime.TryParse(SendOutDateText, out var d) ? d : null;
        public int? SendQuantity { get; set; }                                                  // → Entity.SendQuantity
        public decimal? SendWeight { get; set; }                                                // → Entity.SendWeight
        public string? TagNo { get; set; }                                                      // → Entity.TagNo（来自批次信息）
        public string? PlantGrade { get; set; }                                                 // → Entity.PlantGrade（来自批次信息）
        public string? OutsourceSpec { get; set; }                                              // → Entity.OutsourceSpec
        public string? ExpectedReturnDateText { get; set; }                                     // → Entity.ExpectedReturnDate（字符串表示）
        public DateTime? ExpectedReturnDate => DateTime.TryParse(ExpectedReturnDateText, out var d) ? d : null;
        public bool IsUrgent { get; set; }                                                      // → Entity.IsUrgent
        public string? Remark { get; set; }                                                     // → Entity.Remark
    }

    protected override async Task OnInitializedAsync()
    {
        _allColumns = GetAllColumnDefs();
        var saved = await ColumnPrefs.LoadAsync("section-outsource-create", null);
        if (saved.Count > 0)
        {
            foreach (var s in saved)
            {
                var match = _allColumns.FirstOrDefault(c => c.Key == s.Key);
                if (match != null)
                    match.Visible = s.Visible;
            }
            var reordered = new List<ColumnDef>();
            foreach (var s in saved)
            {
                var match = _allColumns.FirstOrDefault(c => c.Key == s.Key);
                if (match != null && !reordered.Contains(match))
                    reordered.Add(match);
            }
            foreach (var c in _allColumns)
            {
                if (!reordered.Contains(c))
                    reordered.Add(c);
            }
            _allColumns = reordered;
        }

        if (!_rows.Any())
            _rows.Add(new EditRow());
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_isArrowNavSetup)
        {
            _isArrowNavSetup = true;
            if (!await JS.InvokeAsync<bool>("enableTableArrowNav", "#section-outsource-create-table"))
                _isArrowNavSetup = false;
        }
    }

    private void AddRow()
    {
        _rows.Add(new EditRow());
    }

    private void RemoveRow(EditRow row)
    {
        if (_rows.Count <= 1) return;
        _rows.Remove(row);
    }

    private async Task Submit()
    {
        _errorMessage = string.Empty;

        var errors = new List<string>();
        for (int i = 0; i < _rows.Count; i++)
        {
            var r = _rows[i];
            if (string.IsNullOrWhiteSpace(r.BatchNo))
                errors.Add($"第{i + 1}行：批次号不能为空");
            if (string.IsNullOrWhiteSpace(r.ProcessName))
                errors.Add($"第{i + 1}行：工序名称不能为空");
            if (string.IsNullOrWhiteSpace(r.SectionName))
                errors.Add($"第{i + 1}行：工段名称不能为空");
            if (string.IsNullOrWhiteSpace(r.OutsourceVendor))
                errors.Add($"第{i + 1}行：委外单位不能为空");
            if (string.IsNullOrWhiteSpace(r.ManufacturingSpec))
                errors.Add($"第{i + 1}行：制造规格不能为空");
        }

        if (errors.Any())
        {
            Snackbar.Add(string.Join("；", errors), Severity.Error);
            return;
        }

        _isSubmitting = true;
        StateHasChanged();

        try
        {
            var requests = _rows.Select(r => new CreateSectionOutsourceRequest
            {
                BatchNo = r.BatchNo.Trim(),
                ProcessName = r.ProcessName.Trim(),
                ManufacturingSpec = r.ManufacturingSpec?.Trim(),
                SectionName = r.SectionName.Trim(),
                OutsourceVendor = r.OutsourceVendor.Trim(),
                SendOutDate = r.SendOutDate ?? DateTime.Today,
                SendQuantity = r.SendQuantity,
                SendWeight = r.SendWeight,
                TagNo = r.TagNo?.Trim(),
                PlantGrade = r.PlantGrade?.Trim(),
                OutsourceSpec = r.OutsourceSpec?.Trim(),
                ExpectedReturnDate = r.ExpectedReturnDate,
                IsUrgent = r.IsUrgent,
                Remark = r.Remark?.Trim(),
                DataSource = "MANUAL"
            }).ToList();

            var result = await SectionOutsourceService.BatchCreateAsync(requests);

            if (result.Success && result.Data != null)
            {
                Snackbar.Add($"成功创建 {result.Data.Count} 条委外发出记录", Severity.Success);
                Navigation.NavigateTo("/section-outsources");
            }
            else
            {
                _errorMessage = result.Message ?? "批量创建失败";
            }
        }
        catch (Exception ex)
        {
            _errorMessage = $"网络错误: {ex.Message}";
        }
        finally
        {
            _isSubmitting = false;
            StateHasChanged();
        }
    }

    private void GoBack()
    {
        Navigation.NavigateTo("/section-outsources");
    }

    // ========== 自动填充（批次号+制造规格 → 挂牌号/工序名称/工厂牌号） ==========

    private async Task OnAutoFillAsync(EditRow row)
    {
        if (string.IsNullOrWhiteSpace(row.BatchNo) || string.IsNullOrWhiteSpace(row.ManufacturingSpec))
            return;

        var result = await BatchService.GetByBatchNoAsync(row.BatchNo);
        if (!result.Success || result.Data == null)
            return;

        var batch = result.Data;
        row.TagNo = batch.TagNo;
        row.PlantGrade = batch.PlantGrade;

        var pg = batch.ProcessGroups?.FirstOrDefault(p => p.ManufacturingSpec == row.ManufacturingSpec);
        if (pg != null)
            row.ProcessName = pg.ProcessName;

        StateHasChanged();
    }

    // ========== 单元格渲染 ==========

    private RenderFragment RenderCell(EditRow r, ColumnDef col) => builder =>
    {
        switch (col.Key)
        {
            case "BatchNo":
                builder.OpenComponent<MudTextField<string>>(0);
                builder.AddAttribute(1, "Dense", true);
                builder.AddAttribute(2, "Variant", Variant.Outlined);
                builder.AddAttribute(3, "Size", Size.Small);
                builder.AddAttribute(4, "Value", r.BatchNo);
                builder.AddAttribute(4, "ValueChanged", EventCallback.Factory.Create<string>(this, async v => { r.BatchNo = v ?? ""; await OnAutoFillAsync(r); }));
                builder.CloseComponent();
                break;
            case "ProcessName":
                builder.OpenComponent<MudTextField<string>>(0);
                builder.AddAttribute(1, "Dense", true);
                builder.AddAttribute(2, "Variant", Variant.Outlined);
                builder.AddAttribute(3, "Size", Size.Small);
                builder.AddAttribute(4, "Value", r.ProcessName);
                builder.AddAttribute(4, "ValueChanged", EventCallback.Factory.Create<string>(this, v => r.ProcessName = v ?? ""));
                builder.CloseComponent();
                break;
            case "ManufacturingSpec":
                builder.OpenComponent<MudTextField<string>>(0);
                builder.AddAttribute(1, "Dense", true);
                builder.AddAttribute(2, "Variant", Variant.Outlined);
                builder.AddAttribute(3, "Size", Size.Small);
                builder.AddAttribute(4, "Value", r.ManufacturingSpec);
                builder.AddAttribute(4, "ValueChanged", EventCallback.Factory.Create<string?>(this, async v => { r.ManufacturingSpec = v; await OnAutoFillAsync(r); }));
                builder.CloseComponent();
                break;
            case "SectionName":
                builder.OpenComponent<MudTextField<string>>(0);
                builder.AddAttribute(1, "Dense", true);
                builder.AddAttribute(2, "Variant", Variant.Outlined);
                builder.AddAttribute(3, "Size", Size.Small);
                builder.AddAttribute(4, "Value", r.SectionName);
                builder.AddAttribute(4, "ValueChanged", EventCallback.Factory.Create<string>(this, v => r.SectionName = v ?? ""));
                builder.CloseComponent();
                break;
            case "OutsourceVendor":
                builder.OpenComponent<MudTextField<string>>(0);
                builder.AddAttribute(1, "Dense", true);
                builder.AddAttribute(2, "Variant", Variant.Outlined);
                builder.AddAttribute(3, "Size", Size.Small);
                builder.AddAttribute(4, "Value", r.OutsourceVendor);
                builder.AddAttribute(4, "ValueChanged", EventCallback.Factory.Create<string>(this, v => r.OutsourceVendor = v ?? ""));
                builder.CloseComponent();
                break;
            case "SendOutDate":
                builder.OpenComponent<MudTextField<string>>(0);
                builder.AddAttribute(1, "Dense", true);
                builder.AddAttribute(2, "Variant", Variant.Outlined);
                builder.AddAttribute(3, "Size", Size.Small);
                builder.AddAttribute(4, "Value", r.SendOutDateText);
                builder.AddAttribute(5, "ValueChanged", EventCallback.Factory.Create<string?>(this, v => r.SendOutDateText = v));
                builder.AddAttribute(6, "Placeholder", "yyyy-MM-dd");
                builder.CloseComponent();
                break;
            case "SendQuantity":
                builder.OpenComponent<MudNumericField<int?>>(0);
                builder.AddAttribute(1, "Dense", true);
                builder.AddAttribute(2, "Variant", Variant.Outlined);
                builder.AddAttribute(3, "Size", Size.Small);
                builder.AddAttribute(4, "HideSpinButtons", true);
                builder.AddAttribute(5, "Value", r.SendQuantity);
                builder.AddAttribute(6, "ValueChanged", EventCallback.Factory.Create<int?>(this, v => r.SendQuantity = v));
                builder.AddAttribute(7, "Clearable", true);
                builder.CloseComponent();
                break;
            case "SendWeight":
                builder.OpenComponent<MudNumericField<decimal?>>(0);
                builder.AddAttribute(1, "Dense", true);
                builder.AddAttribute(2, "Variant", Variant.Outlined);
                builder.AddAttribute(3, "Size", Size.Small);
                builder.AddAttribute(4, "HideSpinButtons", true);
                builder.AddAttribute(5, "Format", "G29");
                builder.AddAttribute(6, "Value", r.SendWeight);
                builder.AddAttribute(7, "ValueChanged", EventCallback.Factory.Create<decimal?>(this, v => r.SendWeight = v));
                builder.AddAttribute(8, "Clearable", true);
                builder.CloseComponent();
                break;
            case "TagNo":
                builder.OpenComponent<MudTextField<string>>(0);
                builder.AddAttribute(1, "Dense", true);
                builder.AddAttribute(2, "Variant", Variant.Outlined);
                builder.AddAttribute(3, "Size", Size.Small);
                builder.AddAttribute(4, "Value", r.TagNo);
                builder.AddAttribute(5, "ValueChanged", EventCallback.Factory.Create<string?>(this, v => r.TagNo = v));
                builder.CloseComponent();
                break;
            case "PlantGrade":
                builder.OpenComponent<MudTextField<string>>(0);
                builder.AddAttribute(1, "Dense", true);
                builder.AddAttribute(2, "Variant", Variant.Outlined);
                builder.AddAttribute(3, "Size", Size.Small);
                builder.AddAttribute(4, "Value", r.PlantGrade);
                builder.AddAttribute(5, "ValueChanged", EventCallback.Factory.Create<string?>(this, v => r.PlantGrade = v));
                builder.CloseComponent();
                break;
            case "OutsourceSpec":
                builder.OpenComponent<MudTextField<string>>(0);
                builder.AddAttribute(1, "Dense", true);
                builder.AddAttribute(2, "Variant", Variant.Outlined);
                builder.AddAttribute(3, "Size", Size.Small);
                builder.AddAttribute(4, "Value", r.OutsourceSpec);
                builder.AddAttribute(5, "ValueChanged", EventCallback.Factory.Create<string?>(this, v => r.OutsourceSpec = v));
                builder.CloseComponent();
                break;
            case "ExpectedReturnDate":
                builder.OpenComponent<MudTextField<string>>(0);
                builder.AddAttribute(1, "Dense", true);
                builder.AddAttribute(2, "Variant", Variant.Outlined);
                builder.AddAttribute(3, "Size", Size.Small);
                builder.AddAttribute(4, "Value", r.ExpectedReturnDateText);
                builder.AddAttribute(5, "ValueChanged", EventCallback.Factory.Create<string?>(this, v => r.ExpectedReturnDateText = v));
                builder.AddAttribute(6, "Placeholder", "yyyy-MM-dd");
                builder.CloseComponent();
                break;
            case "IsUrgent":
                builder.OpenComponent<MudCheckBox<bool>>(0);
                builder.AddAttribute(1, "Color", Color.Warning);
                builder.AddAttribute(3, "Value", r.IsUrgent);
                builder.AddAttribute(4, "ValueChanged", EventCallback.Factory.Create<bool>(this, v => r.IsUrgent = v));
                builder.CloseComponent();
                break;
            case "Remark":
                builder.OpenComponent<MudTextField<string>>(0);
                builder.AddAttribute(1, "Dense", true);
                builder.AddAttribute(2, "Variant", Variant.Outlined);
                builder.AddAttribute(3, "Size", Size.Small);
                builder.AddAttribute(4, "Value", r.Remark);
                builder.AddAttribute(5, "ValueChanged", EventCallback.Factory.Create<string?>(this, v => r.Remark = v));
                builder.CloseComponent();
                break;
            default:
                builder.AddContent(0, "");
                break;
        }
    };
}
