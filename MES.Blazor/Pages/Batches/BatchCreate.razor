                Snackbar.Add($"未找到批次 {_copyBatchNo} 的工序组数据", Severity.Warning);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"调取失败: {ex.Message}", Severity.Error);
        }
        finally
        {
            _copyBatchLoading = false;
            StateHasChanged();
        }
    }

