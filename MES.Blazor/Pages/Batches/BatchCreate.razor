    private async Task ConfirmWorkOrder()
    {
        if (string.IsNullOrWhiteSpace(request.WorkOrderNo))
        {
            // 工单号为空：默认"非工单"，工厂牌号从仓库继承，物料名称默认"SeamlessPipe"
            request.WorkOrderNo = WorkOrderNoSentinel.NotWorkOrder;
            request.PlantGrade = request.SourcePlantGrade;
            request.MaterialName = PipeManufacturingType.SeamlessPipe;

            // 保留以下字段不变：规格、外径公差、壁厚公差、长度状态、最小/最大长度
            var savedSpec = request.Specification;
            var savedOdNeg = request.OuterDiameterNegative;
            var savedOdPos = request.OuterDiameterPositive;
            var savedWtNeg = request.WallThicknessNegative;
            var savedWtPos = request.WallThicknessPositive;
            var savedLenStatus = request.LengthStatus;
            var savedMinLen = request.MinLength;
            var savedMaxLen = request.MaxLength;

            ClearWorkOrderFields();

            request.Specification = savedSpec;
            request.OuterDiameterNegative = savedOdNeg;
            request.OuterDiameterPositive = savedOdPos;
            request.WallThicknessNegative = savedWtNeg;
            request.WallThicknessPositive = savedWtPos;
            request.LengthStatus = savedLenStatus;
            request.MinLength = savedMinLen;
            request.MaxLength = savedMaxLen;

            // 交货状态默认"固溶酸洗"
            request.DeliveryState = DeliveryState.SolutionAnnealedAndPickled;
            // 制造物品默认"备料成品"
            request.ManufacturingItem = MaterialType.Finished;
            SyncManufacturingItem();

            Snackbar.Add("工单号为空，已设置默认值（可手工修改）", Severity.Info);
            return;
        }

        if (request.WorkOrderNo == WorkOrderNoSentinel.NotWorkOrder)
        {
            // 无对应工单的库存生产：清空工单字段
            request.PlantGrade = request.SourcePlantGrade;
            request.MaterialName = PipeManufacturingType.SeamlessPipe;
            ClearWorkOrderFields();
            request.ProductionRatio = 0;
            SyncManufacturingItem();
            Snackbar.Add("已标记为「非工单」生产，工单字段已清空（可手工修改）", Severity.Info);
            return;
        }

        workOrderLoading = true;
        StateHasChanged();

        try
        {
            var result = await WorkOrderService.GetByWorkOrderNoAsync(request.WorkOrderNo);
            if (result.Success && result.Data != null)
            {
                var wo = result.Data;
                request.SalesOrderNo = wo.SalesOrderNo;
                request.ProductionMainNo = wo.ProductionMainNo;
                request.ProductionSubNo = wo.ProductionSubNo;
                request.OrderItemIds = wo.OrderItemIds;
                request.SignDate = wo.SignDate;
                request.Salesman = wo.Salesman;
                request.EndCustomer = wo.EndCustomer;
                request.DeliveryDate = wo.DeliveryDate;
                request.DelayPenalty = wo.DelayPenalty;
                request.MaterialName = wo.PipeManufacturingType;
                request.SettlementMethod = wo.SettlementMethod;
                request.StandardCode = wo.StandardCode;
                request.DeliveryState = wo.DeliveryState;
                request.PlantGrade = wo.PlantGrade;
                request.Specification = wo.Specification;
                request.OuterDiameterNegative = wo.OuterDiameterNegative;
                request.OuterDiameterPositive = wo.OuterDiameterPositive;
                request.WallThicknessNegative = wo.WallThicknessNegative;
                request.WallThicknessPositive = wo.WallThicknessPositive;
                request.LengthStatus = wo.LengthStatus;
                request.MinLength = wo.MinLength;
                request.MaxLength = wo.MaxLength;
                request.TotalQuantity = wo.TotalQuantity;
                request.TotalMeters = wo.TotalMeters;
                request.TotalWeight = wo.TotalWeight;
                request.TotalItemCount = wo.TotalItemCount;
                request.ItemDetails = wo.ItemDetails;
                request.TechnicalRequirements = string.IsNullOrEmpty(wo.TechnicalRequirements) ? null : Enum.Parse<RequirementType>(wo.TechnicalRequirements);

                // 质量备注：从工单关联订单项次的技术要求「其他要求」带出（订单号 + 项次序号，OrderItemIds 存的是 Sequence）
                if (!string.IsNullOrWhiteSpace(wo.SalesOrderNo) && !string.IsNullOrWhiteSpace(wo.OrderItemIds))
                {
                    var qualityResult = await RequirementService.GetQualityRemarkByOrderItemIdsAsync(wo.SalesOrderNo, wo.OrderItemIds);
                    if (qualityResult.Success)
                        request.QualityRemark = qualityResult.Data;
                }

                // 计算制成倍数
                RecalcProductionRatio();
                SyncManufacturingItem();

                Snackbar.Add($"已从工单 {request.WorkOrderNo} 填充工单字段", Severity.Success);

                await AutoFillSolutionParamsAsync(wo.PlantGrade);
            }
            else
            {
                Snackbar.Add($"未找到工单: {result.Message}", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"获取工单信息失败: {ex.Message}", Severity.Error);
        }
        finally
        {
            workOrderLoading = false;
            StateHasChanged();
        }
    }

