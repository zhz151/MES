@page "/batches/create"
@using MES.Core.Enums
@using MES.Blazor.Services
@using MES.Blazor.Helpers
@using MES.Blazor.Shared
@using MES.Core.Constants
@using MES.Core.DTOs.Batch
@using Microsoft.AspNetCore.Authorization
@inject BatchService BatchService
@inject ProductRequirementService RequirementService
@inject WorkOrderService WorkOrderService
@inject GradeMappingService GradeMappingService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject ColumnPrefsService ColumnPrefs
@inject IDialogService DialogService
@inject StandardWorkDayService StandardWorkDayService
@inject ProcessDefinitionService ProcessDefinitionService
@attribute [Authorize(Roles = Roles.Policies.BatchEdit)]

<MudContainer MaxWidth="MaxWidth.False" Class="mt-4" id="batch-create-table">
    <MudCard Class="mb-4 compact-card">
        <MudCardHeader>
            <CardHeaderContent>
                <MudText Typo="Typo.h5" Class="font-weight-bold">
                    <MudIcon Icon="@Icons.Material.Filled.Add" Class="mr-2" Color="Color.Primary" />
                    新建生产批次
                </MudText>
            </CardHeaderContent>
            <CardHeaderActions>
                <MudButton Variant="Variant.Text" Color="Color.Default" StartIcon="@Icons.Material.Filled.ArrowBack" OnClick="GoBack" Class="mr-2">返回批次列表</MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Submit" Loading="@_isSubmitting" StartIcon="@Icons.Material.Filled.Save">
                    保存批次
                </MudButton>
            </CardHeaderActions>
        </MudCardHeader>
    </MudCard>

    <!-- ==================== Block A: 仓库信息 ==================== -->
    <MudCard Class="mb-4 compact-card">
        <MudCardHeader>
            <CardHeaderContent>
                <div class="d-flex align-center">
                    <MudIcon Icon="@Icons.Material.Filled.Warehouse" Class="mr-1" Color="Color.Primary" />
                    <MudText Typo="Typo.h6" Class="font-weight-bold">投料信息</MudText>
                </div>
            </CardHeaderContent>
            <CardHeaderActions>
                <MudSwitch @bind-Value="_noSourceMode" Color="Color.Warning" Dense="true"
                           Label="非仓库模式" Class="mr-2" />
                <MudButton Variant="Variant.Text" Size="Size.Small" Color="Color.Info"
                           StartIcon="@(showAvailablePanel ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                           OnClick="ToggleAvailablePanel"
                           Disabled="@_noSourceMode">
                    @(showAvailablePanel ? "隐藏可用批次" : "显示可用批次")
                </MudButton>
            </CardHeaderActions>
        </MudCardHeader>
        <MudCardContent>
            @if (_noSourceMode)
            {
                <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mb-3">
                    非仓库模式：无需选择库存批次，请手动填写原料信息
                </MudAlert>
                <div style="overflow-x:auto;">
                    <MudSimpleTable Dense="true" Class="auto-table compact-table" Style="min-width:2000px;">
                        <thead>
                            <tr>
                                <th>原料类型</th>
                                <th>来料单位</th>
                                <th>炉号</th>
                                <th>工厂牌号</th>
                                <th>规格</th>
                                <th>长度状态</th>
                                <th>单支重(kg)</th>
                                <th>领料支数</th>
                                <th>领料重量(kg)</th>
                                <th>投料类型</th>
                                <th>源生产编号</th>
                                <th>原料备注</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>
                                    <MudSelect T="MaterialType?" @bind-Value="_noSourceMaterialType" Dense="true" Variant="Variant.Outlined" Size="Size.Small" FullWidth="true">
                                        <MudSelectItem Value="@((MaterialType?)null)">请选择</MudSelectItem>
                                        @foreach (var opt in DisplayHelper.GetEnumOptions<MaterialType>())
                                        {
                                            <MudSelectItem Value="@((MaterialType?)Enum.Parse<MaterialType>(opt.Value))">@opt.Display</MudSelectItem>
                                        }
                                    </MudSelect>
                                </td>
                                <td>
                                    <MudTextField T="string" @bind-Value="_noSourceName" Dense="true" Variant="Variant.Outlined" Size="Size.Small" FullWidth="true" />
                                </td>
                                <td>
                                    <MudTextField T="string" @bind-Value="_noSourceHeatNo" Dense="true" Variant="Variant.Outlined" Size="Size.Small" FullWidth="true" />
                                </td>
                                <td>
                                    <MudTextField T="string" @bind-Value="_noSourcePlantGrade" Dense="true" Variant="Variant.Outlined" Size="Size.Small" FullWidth="true" />
                                </td>
                                <td>
                                    <MudTextField T="string" @bind-Value="_noSourceSpecification" Dense="true" Variant="Variant.Outlined" Size="Size.Small" FullWidth="true" />
                                </td>
                                <td>
                                    <MudSelect T="LengthStatus?" @bind-Value="_noSourceLengthStatus" Dense="true" Variant="Variant.Outlined" Size="Size.Small" FullWidth="true">
                                        <MudSelectItem Value="@((LengthStatus?)null)">请选择</MudSelectItem>
                                        @foreach (var opt in DisplayHelper.GetEnumOptions<LengthStatus>())
                                        {
                                            <MudSelectItem Value="@((LengthStatus?)Enum.Parse<LengthStatus>(opt.Value))">@opt.Display</MudSelectItem>
                                        }
                                    </MudSelect>
                                </td>
                                <td>
                                    <MudNumericField T="decimal?" @bind-Value="_noSourceUnitWeight" Dense="true" Variant="Variant.Outlined" Size="Size.Small" Format="G29" HideSpinButtons="true" FullWidth="true" />
                                </td>
                                <td>
                                    <MudNumericField T="int" @bind-Value="_noSourceInputQty" Dense="true" Variant="Variant.Outlined" Size="Size.Small" HideSpinButtons="true" FullWidth="true" Min="0" />
                                </td>
                                <td>
                                    <MudNumericField T="decimal" @bind-Value="_noSourceInputWeight" Dense="true" Variant="Variant.Outlined" Size="Size.Small" Format="G29" HideSpinButtons="true" FullWidth="true" Min="0" />
                                </td>
                                <td>
                                    <MudSelect T="BatchInputType" @bind-Value="_noSourceInputType" Dense="true" Variant="Variant.Outlined" Size="Size.Small" FullWidth="true">
                                        @foreach (var opt in DisplayHelper.GetEnumOptions<BatchInputType>())
                                        {
                                            <MudSelectItem Value="@(Enum.Parse<BatchInputType>(opt.Value))">@opt.Display</MudSelectItem>
                                        }
                                    </MudSelect>
                                </td>
                                <td>
                                    <MudTextField T="string" @bind-Value="_noSourceProductionNo" Dense="true" Variant="Variant.Outlined" Size="Size.Small" FullWidth="true" />
                                </td>
                                <td>
                                    <MudTextField T="string" @bind-Value="_noSourceRemark" Dense="true" Variant="Variant.Outlined" Size="Size.Small" FullWidth="true" />
                                </td>
                            </tr>
                        </tbody>
                    </MudSimpleTable>
                </div>
            }
            else
            {
                @if (showAvailablePanel)
            {
                <MudPaper Class="pa-3 mb-4 form-card" Elevation="1">
                    <MudText Typo="Typo.subtitle2" Class="mb-2">
                        <MudIcon Icon="@Icons.Material.Filled.Inventory" Class="mr-1" Size="Size.Small" />
                        可用库存批次
                    </MudText>
                    <MudGrid>
                        <MudItem xs="12" md="6">
                            <MudTextField T="string" @bind-Value="searchText" Label="筛选" Dense="true" Variant="Variant.Outlined" Size="Size.Small" Immediate="true" DebounceInterval="500" />
                        </MudItem>
                    </MudGrid>
                    @if (availableBatchesLoading)
                    {
                        <MudProgressCircular Indeterminate Size="Size.Small" Class="my-2" />
                    }
                    else if (availableBatches.Count == 0)
                    {
                    }
                    else
                    {
                        <div style="overflow-x:auto; max-height:250px; overflow-y:auto;">
                            <MudTable T="AvailableBatchDto" Items="@sortedAvailableBatches" RowsPerPage="5" RowsPerPageLabel="每页行数:" Dense="true" Hover="true" Elevation="0" Class="auto-table" Style="cursor:pointer;">
                                <HeaderContent>
                                    <MudTh Style="width:100px;">
                                        <span Class="sortable-header" @onclick="@(() => ToggleSort("BatchNo"))">
                                            批次号
                                            @if (sortColumn == "BatchNo") { <span Class="sort-arrow">@(sortAscending ? "▲" : "▼")</span> }
                                        </span>
                                    </MudTh>
                                    <MudTh Style="width:80px;">
                                        <span Class="sortable-header" @onclick="@(() => ToggleSort("MaterialType"))">
                                            原料类型
                                            @if (sortColumn == "MaterialType") { <span Class="sort-arrow">@(sortAscending ? "▲" : "▼")</span> }
                                        </span>
                                    </MudTh>
                                    <MudTh Style="width:80px;">
                                        <span Class="sortable-header" @onclick="@(() => ToggleSort("InboundSource"))">
                                            入库来源
                                            @if (sortColumn == "InboundSource") { <span Class="sort-arrow">@(sortAscending ? "▲" : "▼")</span> }
                                        </span>
                                    </MudTh>
                                    <MudTh Style="width:100px;">
                                        <span Class="sortable-header" @onclick="@(() => ToggleSort("SourceName"))">
                                            来料单位
                                            @if (sortColumn == "SourceName") { <span Class="sort-arrow">@(sortAscending ? "▲" : "▼")</span> }
                                        </span>
                                    </MudTh>
                                    <MudTh Style="width:80px;">
                                        <span Class="sortable-header" @onclick="@(() => ToggleSort("InboundDate"))">
                                            入库日期
                                            @if (sortColumn == "InboundDate") { <span Class="sort-arrow">@(sortAscending ? "▲" : "▼")</span> }
                                        </span>
                                    </MudTh>
                                    <MudTh Style="width:80px;">
                                        <span Class="sortable-header" @onclick="@(() => ToggleSort("HeatNo"))">
                                            炉号
                                            @if (sortColumn == "HeatNo") { <span Class="sort-arrow">@(sortAscending ? "▲" : "▼")</span> }
                                        </span>
                                    </MudTh>
                                    <MudTh Style="width:80px;">
                                        <span Class="sortable-header" @onclick="@(() => ToggleSort("PlantGrade"))">
                                            工厂牌号
                                            @if (sortColumn == "PlantGrade") { <span Class="sort-arrow">@(sortAscending ? "▲" : "▼")</span> }
                                        </span>
                                    </MudTh>
                                    <MudTh Style="width:80px;">
                                        <span Class="sortable-header" @onclick="@(() => ToggleSort("Specification"))">
                                            名义规格
                                            @if (sortColumn == "Specification") { <span Class="sort-arrow">@(sortAscending ? "▲" : "▼")</span> }
                                        </span>
                                    </MudTh>
                                    <MudTh Style="width:60px;">
                                        <span Class="sortable-header" @onclick="@(() => ToggleSort("LengthStatus"))">
                                            长度状态
                                            @if (sortColumn == "LengthStatus") { <span Class="sort-arrow">@(sortAscending ? "▲" : "▼")</span> }
                                        </span>
                                    </MudTh>
                                    <MudTh Style="width:60px;" Class="text-right">
                                        <span Class="sortable-header" @onclick="@(() => ToggleSort("UnitWeight"))">
                                            单支重
                                            @if (sortColumn == "UnitWeight") { <span Class="sort-arrow">@(sortAscending ? "▲" : "▼")</span> }
                                        </span>
                                    </MudTh>
                                    <MudTh Style="width:100px;">
                                        <span Class="sortable-header" @onclick="@(() => ToggleSort("WorkOrderNo"))">
                                            关联工单号
                                            @if (sortColumn == "WorkOrderNo") { <span Class="sort-arrow">@(sortAscending ? "▲" : "▼")</span> }
                                        </span>
                                    </MudTh>
                                    <MudTh Style="width:90px;">
                                        <span Class="sortable-header" @onclick="@(() => ToggleSort("OutboundDate"))">
                                            出库日期
                                            @if (sortColumn == "OutboundDate") { <span Class="sort-arrow">@(sortAscending ? "▲" : "▼")</span> }
                                        </span>
                                    </MudTh>
                                    <MudTh Style="width:60px;" Class="text-right">
                                        <span Class="sortable-header" @onclick="@(() => ToggleSort("OutboundQuantity"))">
                                            支数
                                            @if (sortColumn == "OutboundQuantity") { <span Class="sort-arrow">@(sortAscending ? "▲" : "▼")</span> }
                                        </span>
                                    </MudTh>
                                    <MudTh Style="width:80px;" Class="text-right">
                                        <span Class="sortable-header" @onclick="@(() => ToggleSort("OutboundWeight"))">
                                            重量(kg)
                                            @if (sortColumn == "OutboundWeight") { <span Class="sort-arrow">@(sortAscending ? "▲" : "▼")</span> }
                                        </span>
                                    </MudTh>
                                    <MudTh Style="width:100px;">
                                        <span Class="sortable-header" @onclick="@(() => ToggleSort("OutboundRemark"))">
                                            出库备注
                                            @if (sortColumn == "OutboundRemark") { <span Class="sort-arrow">@(sortAscending ? "▲" : "▼")</span> }
                                        </span>
                                    </MudTh>
                                    <MudTh Style="width:60px;">操作</MudTh>
                                </HeaderContent>
                                <RowTemplate Context="batch">
                                    <MudTd><b>@batch.BatchNo</b></MudTd>
                                    <MudTd>@DisplayHelper.GetMaterialTypeText(batch.MaterialType)</MudTd>
                                    <MudTd>@DisplayHelper.GetInboundSourceText(batch.InboundSource?.ToString())</MudTd>
                                    <MudTd>@batch.SourceName</MudTd>
                                    <MudTd>@batch.InboundDate?.ToString("yyyy-MM-dd")</MudTd>
                                    <MudTd>@batch.HeatNo</MudTd>
                                    <MudTd>@batch.PlantGrade</MudTd>
                                    <MudTd>@batch.Specification</MudTd>
                                    <MudTd>@DisplayHelper.GetLengthStatusText(batch.LengthStatus?.ToString())</MudTd>
                                    <MudTd Class="text-right">@batch.UnitWeight?.ToString("G29")</MudTd>
                                    <MudTd>@batch.WorkOrderNo</MudTd>
                                    <MudTd>@batch.OutboundDate?.ToString("yyyy-MM-dd")</MudTd>
                                    <MudTd Class="text-right">@batch.OutboundQuantity</MudTd>
                                    <MudTd Class="text-right">@batch.OutboundWeight?.ToString("G29")</MudTd>
                                    <MudTd Class="table-cell-clamp-1">@(batch.OutboundRemark ?? "-")</MudTd>
                                    <MudTd><MudIconButton Icon="@Icons.Material.Filled.AddCircle" Color="Color.Primary" Size="Size.Small" Title="添加" OnClick="@(() => AddSourceItem(batch))" /></MudTd>
                                </RowTemplate>
                                <PagerContent>
                                    <MudTablePager RowsPerPageLabel="每页行数:" />
                                </PagerContent>
                            </MudTable>
                        </div>
                    }
                </MudPaper>
            }

            <!-- 已选来源批次 -->
            @if (_selectedSources.Count == 0)
            {
                <MudText Typo="Typo.body2" Color="Color.Info" Class="mt-2">请从上方可用库存批次中选择来源</MudText>
            }
            else
            {
                <div style="overflow-x:auto;">
                    <MudTable T="SelectedSourceItem" Items="@_selectedSources" Dense="true" Hover="true" Elevation="0" Class="auto-table compact-table">
                        <HeaderContent>
                            <MudTh Style="width:140px;">来源库存批次号</MudTh>
                            <MudTh Style="width:100px;">原料类型</MudTh>
                            <MudTh Style="width:140px;">入库来源</MudTh>
                            <MudTh Style="width:120px;">来料单位</MudTh>
                            <MudTh Style="width:120px;">入库日期</MudTh>
                            <MudTh Style="width:100px;">炉号</MudTh>
                            <MudTh Style="width:120px;">工厂牌号</MudTh>
                            <MudTh Style="width:140px;">名义规格</MudTh>
                            <MudTh Style="width:100px;">长度状态</MudTh>
                            <MudTh Style="width:100px;">单支重(kg)</MudTh>
                            <MudTh Style="width:90px;">领料支数</MudTh>
                            <MudTh Style="width:110px;">领料重量(kg)</MudTh>
                            <MudTh Style="width:120px;">仓库名称</MudTh>
                            <MudTh Style="width:140px;">来源工单号</MudTh>
                            <MudTh Style="width:60px;">操作</MudTh>
                        </HeaderContent>
                        <RowTemplate Context="item">
                            <MudTd><b>@item.BatchNo</b></MudTd>
                            <MudTd>@DisplayHelper.GetMaterialTypeText(item.MaterialType)</MudTd>
                            <MudTd>@DisplayHelper.GetInboundSourceText(item.InboundSource?.ToString())</MudTd>
                            <MudTd>@item.SourceName</MudTd>
                            <MudTd>@item.InboundDate?.ToString("yyyy-MM-dd")</MudTd>
                            <MudTd>@item.HeatNo</MudTd>
                            <MudTd>@item.PlantGrade</MudTd>
                            <MudTd>@item.Specification</MudTd>
                            <MudTd>@DisplayHelper.GetLengthStatusText(item.LengthStatus)</MudTd>
                            <MudTd Class="text-right">@item.UnitWeight?.ToString("G29")</MudTd>
                            <MudTd><MudNumericField T="int" @bind-Value="item.InputQuantity" Dense="true" Variant="Variant.Outlined" Size="Size.Small" HideSpinButtons="true" FullWidth="true" Min="0" @bind-Value:after="() => SyncRequestFromSources()" /></MudTd>
                            <MudTd><MudNumericField T="decimal" @bind-Value="item.InputWeight" Dense="true" Variant="Variant.Outlined" Size="Size.Small" Format="G29" HideSpinButtons="true" FullWidth="true" Min="0" @bind-Value:after="() => SyncRequestFromSources()" /></MudTd>
                            <MudTd>@item.WarehouseName</MudTd>
                            <MudTd>@item.WorkOrderNo</MudTd>
                            <MudTd><MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" Title="删除" OnClick="@(() => RemoveSourceItem(item))" /></MudTd>
                        </RowTemplate>
                    </MudTable>
                    <div class="d-flex justify-end mt-2" Style="gap:16px;">
                        <MudText Typo="Typo.body2">
                            合计：领料支数 <strong>@_totalInputQty</strong>，
                            领料重量 <strong>@_totalInputWeight.ToString("G29")</strong> kg
                        </MudText>
                    </div>
                </div>
            }
            }
        </MudCardContent>
    </MudCard>

    <!-- ==================== Block B: 工单字段信息 ==================== -->
    <MudCard Class="mb-4 compact-card">
        <MudCardHeader>
            <CardHeaderContent>
                <div class="d-flex align-center">
                    <MudIcon Icon="@Icons.Material.Filled.Assignment" Class="mr-1" Color="Color.Primary" />
                    <MudText Typo="Typo.h6" Class="font-weight-bold">工单字段信息</MudText>
                    <span Class="ml-3 text-caption text-hint">（@visibleFieldCount 字段可见/共29字段）</span>
                </div>
            </CardHeaderContent>
            <CardHeaderActions>
                <ColumnDisplaySelect Columns="workOrderCols" ShowCommonFields="false"
                                   OnColumnToggle="OnWorkOrderColumnToggle"
                                   OnMoveUp="OnWorkOrderColumnMove"
                                   OnMoveDown="OnWorkOrderColumnMove" />
                <MudButton Variant="Variant.Text" Size="Size.Small" Color="Color.Warning"
                           StartIcon="@Icons.Material.Filled.Refresh" OnClick="ResetWorkOrderColumns">重置</MudButton>
            </CardHeaderActions>
        </MudCardHeader>
        <MudCardContent>
            <div style="display:flex; align-items:center; gap:8px; margin-bottom:4px; flex-wrap:wrap;">
                <div style="display:flex; align-items:center; gap:8px; flex:1; max-width:400px;">
                    <MudTextField T="string" @bind-Value="request.WorkOrderNo"
                                  Dense="true" Variant="Variant.Outlined" Size="Size.Small" Style="flex:1;" />
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small"
                               OnClick="ConfirmWorkOrder" Disabled="@workOrderLoading">
                        @if (workOrderLoading)
                        {
                            <MudProgressCircular Size="Size.Small" Indeterminate Color="Color.Inherit" />
                        }
                        else
                        {
                            <span>确认</span>
                        }
                    </MudButton>
                </div>
            </div>

            @if (visibleFieldCount > 0)
            {
                <div style="overflow-x:auto;">
                    <MudSimpleTable Dense="true" Class="auto-table compact-table" Style="width:4200px;">
                        <thead>
                            <tr>
                                @if (GetCol("SalesOrderNo").Visible) { <th style="width:140px;">源订单号</th> }
                                @if (GetCol("ProductionMainNo").Visible) { <th style="width:100px;">主号</th> }
                                @if (GetCol("ProductionSubNo").Visible) { <th style="width:100px;">次号</th> }
                                @if (GetCol("MaterialName").Visible) { <th style="width:140px;">钢管制造</th> }
                                @if (GetCol("DeliveryState").Visible) { <th style="width:200px;">交货状态</th> }
                                @if (GetCol("PlantGrade").Visible) { <th style="width:120px;">工厂牌号</th> }
                                @if (GetCol("Specification").Visible) { <th style="width:160px;">规格</th> }
                                @if (GetCol("LengthStatus").Visible) { <th style="width:100px;">长度状态</th> }
                                @if (GetCol("SettlementMethod").Visible) { <th style="width:140px;">结算方式</th> }
                                @if (GetCol("StandardCode").Visible) { <th style="width:140px;">产品标准编码</th> }
                                @if (GetCol("TotalQuantity").Visible) { <th style="width:100px;">总支数</th> }
                                @if (GetCol("TotalWeight").Visible) { <th style="width:120px;">总重量(kg)</th> }
                                @if (GetCol("OuterDiameterNegative").Visible) { <th style="width:110px;">外径负公差</th> }
                                @if (GetCol("OuterDiameterPositive").Visible) { <th style="width:110px;">外径正公差</th> }
                                @if (GetCol("WallThicknessNegative").Visible) { <th style="width:110px;">壁厚负公差</th> }
                                @if (GetCol("WallThicknessPositive").Visible) { <th style="width:110px;">壁厚正公差</th> }
                                @if (GetCol("MinLength").Visible) { <th style="width:110px;">最小长度(mm)</th> }
                                @if (GetCol("MaxLength").Visible) { <th style="width:110px;">最大长度(mm)</th> }
                                @if (GetCol("TechnicalRequirements").Visible) { <th style="width:120px;">技术要求</th> }
                                @if (GetCol("SignDate").Visible) { <th style="width:120px;">签订日期</th> }
                                @if (GetCol("DeliveryDate").Visible) { <th style="width:120px;">交货日期</th> }
                                @if (GetCol("Salesman").Visible) { <th style="width:100px;">业务员</th> }
                                @if (GetCol("EndCustomer").Visible) { <th style="width:120px;">最终用户</th> }
                                @if (GetCol("DelayPenalty").Visible) { <th style="width:80px;">延期罚款</th> }
                                @if (GetCol("TotalMeters").Visible) { <th style="width:100px;">总米数</th> }
                                @if (GetCol("TotalItemCount").Visible) { <th style="width:100px;">总项次数</th> }
                                @if (GetCol("OrderItemIds").Visible) { <th style="width:120px;">项次ID列表</th> }
                                @if (GetCol("ItemDetails").Visible) { <th style="width:250px;">明细</th> }
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                @if (GetCol("SalesOrderNo").Visible) { <td><MudTextField T="string" @bind-Value="request.SalesOrderNo" Dense="true" Variant="Variant.Outlined" Size="Size.Small" FullWidth="true" /></td> }
                                @if (GetCol("ProductionMainNo").Visible) { <td><MudTextField T="string" @bind-Value="request.ProductionMainNo" Dense="true" Variant="Variant.Outlined" Size="Size.Small" FullWidth="true" /></td> }
                                @if (GetCol("ProductionSubNo").Visible) { <td><MudTextField T="string" @bind-Value="request.ProductionSubNo" Dense="true" Variant="Variant.Outlined" Size="Size.Small" FullWidth="true" /></td> }
                                @if (GetCol("MaterialName").Visible)
                                {
                                    <td>
