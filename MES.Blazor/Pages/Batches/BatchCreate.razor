                            }
                            <MudTd><MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" Title="删除" OnClick="@(() => DeleteProcessGroupRow(pg))" /></MudTd>
                        </RowTemplate>
                    </MudTable>
                </div>
            }
        </MudCardContent>
    </MudCard>
</MudContainer>

@code {
    [Inject] private IJSRuntime JS { get; set; } = null!;

    private CreateProductionBatchRequest request = new()
    {
        WorkOrderNo = "",
        ProductionType = ProductionType.RoughTube,
        ManufacturingItem = MaterialType.OrderFinished,
        ManufacturingStatus = DeliveryState.SolutionAnnealedAndPickled,
        ProcessGroups = new List<CreateProcessGroupRequest>()
    };
    private bool _isSubmitting;
    private bool workOrderLoading;
    private string batchNoDisplay = "加载中...";

    private List<AvailableBatchDto> availableBatches = new();
    private bool availableBatchesLoading;
    private bool showAvailablePanel;
    private string searchText = "";

    private string sortColumn = "BatchNo";
    private bool sortAscending = true;

    private List<AvailableBatchDto> sortedAvailableBatches
    {
        get
        {
            var filtered = string.IsNullOrWhiteSpace(searchText)
                ? availableBatches
                : availableBatches.Where(b =>
                    (b.BatchNo?.Contains(searchText, StringComparison.OrdinalIgnoreCase) ?? false) ||
                    (b.MaterialType?.ToString()?.Contains(searchText, StringComparison.OrdinalIgnoreCase) ?? false) ||
                    (b.InboundSource?.ToString()?.Contains(searchText, StringComparison.OrdinalIgnoreCase) ?? false) ||
                    (b.SourceName?.Contains(searchText, StringComparison.OrdinalIgnoreCase) ?? false) ||
                    (b.InboundDate?.ToString("yyyy-MM-dd")?.Contains(searchText, StringComparison.OrdinalIgnoreCase) ?? false) ||
                    (b.HeatNo?.Contains(searchText, StringComparison.OrdinalIgnoreCase) ?? false) ||
                    (b.OutboundQuantity?.ToString()?.Contains(searchText, StringComparison.OrdinalIgnoreCase) ?? false) ||
                    (b.OutboundWeight?.ToString("G29")?.Contains(searchText, StringComparison.OrdinalIgnoreCase) ?? false) ||
                    (b.WorkOrderNo?.Contains(searchText, StringComparison.OrdinalIgnoreCase) ?? false) ||
                    (b.OutboundDate?.ToString("yyyy-MM-dd")?.Contains(searchText, StringComparison.OrdinalIgnoreCase) ?? false) ||
                    (b.OutboundRemark?.Contains(searchText, StringComparison.OrdinalIgnoreCase) ?? false) ||
                    (b.PlantGrade?.Contains(searchText, StringComparison.OrdinalIgnoreCase) ?? false) ||
                    (b.Specification?.Contains(searchText, StringComparison.OrdinalIgnoreCase) ?? false) ||
                    (b.LengthStatus?.ToString()?.Contains(searchText, StringComparison.OrdinalIgnoreCase) ?? false) ||
                    (b.UnitWeight?.ToString("G29")?.Contains(searchText, StringComparison.OrdinalIgnoreCase) ?? false))
                .ToList();

            var sorted = sortColumn switch
            {
                "BatchNo" => filtered.OrderBy(b => b.BatchNo),
                "MaterialType" => filtered.OrderBy(b => b.MaterialType),
                "InboundSource" => filtered.OrderBy(b => b.InboundSource),
                "SourceName" => filtered.OrderBy(b => b.SourceName),
                "InboundDate" => filtered.OrderBy(b => b.InboundDate),
                "HeatNo" => filtered.OrderBy(b => b.HeatNo),
                "OutboundQuantity" => filtered.OrderBy(b => b.OutboundQuantity),
                "OutboundWeight" => filtered.OrderBy(b => b.OutboundWeight),
                "OutboundDate" => filtered.OrderBy(b => b.OutboundDate),
                "OutboundRemark" => filtered.OrderBy(b => b.OutboundRemark),
                "WorkOrderNo" => filtered.OrderBy(b => b.WorkOrderNo),
                "PlantGrade" => filtered.OrderBy(b => b.PlantGrade),
                "Specification" => filtered.OrderBy(b => b.Specification),
                "LengthStatus" => filtered.OrderBy(b => b.LengthStatus),
                "UnitWeight" => filtered.OrderBy(b => b.UnitWeight),
                _ => filtered.OrderBy(b => b.BatchNo)
            };
            return sortAscending ? sorted.ToList() : sorted.Reverse().ToList();
        }
    }

    private void ToggleSort(string column)
    {
        if (sortColumn == column)
            sortAscending = !sortAscending;
        else
        {
            sortColumn = column;
            sortAscending = true;
        }
    }

    private string? warehouseName;
    private string? sourceWorkOrderNo;

    // ========== 合并投料 - 已选来源批次 ==========

    public class SelectedSourceItem
    {
        public int InventoryBatchId { get; set; }
        public long? OutboundRecordId { get; set; }
        public string BatchNo { get; set; } = null!;
        public MaterialType MaterialType { get; set; }
        public InboundSource? InboundSource { get; set; }
        public string? SourceName { get; set; }
        public DateTime? InboundDate { get; set; }
        public string? HeatNo { get; set; }
        public string? PlantGrade { get; set; }
        public string? Specification { get; set; }
        public string? LengthStatus { get; set; }
        public decimal? UnitWeight { get; set; }
        public string? WarehouseName { get; set; }
        public string? WorkOrderNo { get; set; }
        public int InputQuantity { get; set; }
        public decimal InputWeight { get; set; }
    }

    private List<SelectedSourceItem> _selectedSources = new();
    private bool _noSourceMode;

    // ========== 非仓库模式 - 单行投料 ==========

    private MaterialType? _noSourceMaterialType;
    private string? _noSourceName;
    private string? _noSourceHeatNo;
    private string? _noSourcePlantGrade;
    private string? _noSourceSpecification;
    private LengthStatus? _noSourceLengthStatus;
    private decimal? _noSourceUnitWeight;
    private int _noSourceInputQty;
    private decimal _noSourceInputWeight;
    private BatchInputType _noSourceInputType = BatchInputType.SplitFromNumber;
    private string? _noSourceProductionNo;
    private string? _noSourceRemark;

    private int _totalInputQty => _selectedSources.Sum(s => s.InputQuantity);
    private decimal _totalInputWeight => _selectedSources.Sum(s => s.InputWeight);

    private void AddSourceItem(AvailableBatchDto batch)
    {
        if (_selectedSources.Any(s => s.BatchNo == batch.BatchNo))
        {
            Snackbar.Add($"批次 {batch.BatchNo} 已添加", Severity.Warning);
            return;
        }

        bool wasEmpty = _selectedSources.Count == 0;

        _selectedSources.Add(new SelectedSourceItem
        {
            InventoryBatchId = batch.Id,
            OutboundRecordId = batch.OutboundRecordId,
            BatchNo = batch.BatchNo,
            MaterialType = batch.MaterialType ?? default,
            InboundSource = batch.InboundSource,
            SourceName = batch.SourceName,
            InboundDate = batch.InboundDate,
            HeatNo = batch.HeatNo,
            PlantGrade = batch.PlantGrade,
            Specification = batch.Specification,
            LengthStatus = batch.LengthStatus?.ToString() ?? nameof(LengthStatus.NonFixed),
            UnitWeight = batch.UnitWeight,
            WarehouseName = batch.WarehouseName,
            WorkOrderNo = batch.WorkOrderNo,
            InputQuantity = batch.OutboundQuantity ?? 0,
            InputWeight = batch.OutboundWeight ?? 0
        });

        SyncRequestFromSources();

        if (wasEmpty)
        {
            // 自动填充第一个源的仓库概要信息
            FillRequestFromFirstSource();

            // 如果第一个源有工单号且当前工单号为空，自动填充
            if (!string.IsNullOrWhiteSpace(batch.WorkOrderNo) && string.IsNullOrWhiteSpace(request.WorkOrderNo))
            {
                request.WorkOrderNo = batch.WorkOrderNo;
                Snackbar.Add($"已自动填充工单号 {batch.WorkOrderNo}，正在加载工单字段...", Severity.Info);
                _ = ConfirmWorkOrder();
            }
            else
            {
                RecalcProductionRatio();
            }
        }

        Snackbar.Add($"已添加批次 {batch.BatchNo}", Severity.Success);
    }

