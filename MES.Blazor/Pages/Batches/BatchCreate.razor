    // ========== 提交 ==========

    private async Task Submit()
    {
        var errors = new List<string>();

        // ========== 统一必填（两路径共用） ==========

        // 生产类型必填
        if (request.ProductionType == null)
            errors.Add("生产类型不能为空");
        // 制造物品必填
        if (request.ManufacturingItem == null)
            errors.Add("制造物品不能为空");

        // 工单规格必填
        if (string.IsNullOrWhiteSpace(request.PlantGrade))
            errors.Add("工厂牌号不能为空");
        if (string.IsNullOrWhiteSpace(request.Specification))
            errors.Add("规格不能为空");
        if (request.DeliveryState == null)
            errors.Add("交货状态不能为空");
        if (request.MaterialName == null)
            errors.Add("钢管制造不能为空");
        if (request.LengthStatus == null)
            errors.Add("长度状态不能为空");
        // 非工单不校验总重量/总支数
        if (request.WorkOrderNo != WorkOrderNoSentinel.NotWorkOrder)
        {
            if (request.TotalWeight == null || request.TotalWeight <= 0)
                errors.Add("总重量必须大于0");
            if (request.LengthStatus == LengthStatus.Fixed && (request.TotalQuantity == null || request.TotalQuantity <= 0))
                errors.Add("总支数（定尺时必须大于0）");
        }
        // 制成倍数必须大于0
        if (request.ProductionRatio <= 0)
            errors.Add("制成倍数必须大于0");

        // 合并投料来源必填（非仓库模式跳过）
        if (!_noSourceMode)
        {
            if (_selectedSources.Count == 0)
                errors.Add("请至少选择一个库存批次作为来源");
            if (_selectedSources.Count > 0 && string.IsNullOrWhiteSpace(_selectedSources[0].PlantGrade))
                errors.Add("来源批次工厂牌号不能为空");
            if (_selectedSources.Count > 0 && string.IsNullOrWhiteSpace(_selectedSources[0].Specification))
                errors.Add("来源批次规格不能为空");
            if (_totalInputWeight <= 0)
                errors.Add("领料重量必须大于0");
            if (_totalInputQty <= 0)
                errors.Add("领料支数必须大于0");
        }

        // 非仓库模式：单行验证
        if (_noSourceMode)
        {
            if (_noSourceMaterialType == null)
                errors.Add("非仓库模式：原料类型不能为空");
            if (_noSourceInputQty <= 0)
                errors.Add("非仓库模式：领料支数必须大于0");
            if (_noSourceInputWeight <= 0)
                errors.Add("非仓库模式：领料重量必须大于0");
            if (_noSourceInputType == BatchInputType.SplitFromNumber && string.IsNullOrWhiteSpace(_noSourceProductionNo))
                errors.Add("非仓库模式：投料类型为「编号拆分」时，源生产编号不能为空");
        }

        // ========== 有工单路径额外验证 ==========
        if (request.WorkOrderNo != WorkOrderNoSentinel.NotWorkOrder)
        {
            if (_selectedSources.Count > 0)
            {
                var firstLenStatus = _selectedSources[0].LengthStatus;
                if (string.IsNullOrWhiteSpace(firstLenStatus))
                    errors.Add("来源长度状态不能为空");
            }
            if (request.SettlementMethod == null)
                errors.Add("结算方式不能为空");
            if (string.IsNullOrWhiteSpace(request.StandardCode))
                errors.Add("产品标准编码不能为空");
            if (request.TechnicalRequirements == null)
                errors.Add("技术要求不能为空");
        }

        // 工厂牌号验证（高代低）
        if (_selectedSources.Count > 0 && !GradeSubstitutes.IsSubstitutable(request.PlantGrade, _selectedSources[0].PlantGrade))
            errors.Add("仓库工厂牌号与工单工厂牌号不一致，且不可替代（仅允许高代低）");

        // 工序组验证
        if (request.ProcessGroups != null)
        {
            for (int i = 0; i < request.ProcessGroups.Count; i++)
            {
                var pg = request.ProcessGroups[i];
                if (string.IsNullOrWhiteSpace(pg.ProcessName))
                    errors.Add($"工序组第{i + 1}行：工序名称不能为空");
            }
            ValidateProcessGroupValues(request.ProcessGroups, errors);

            // 最大工序序号的制造规格必须等于工单成品规格
            if (request.WorkOrderNo != WorkOrderNoSentinel.NotWorkOrder)
            {
                var lastPg = request.ProcessGroups.LastOrDefault();
                if (lastPg != null && !string.IsNullOrWhiteSpace(lastPg.ManufacturingSpec)
                    && !string.Equals(lastPg.ManufacturingSpec, request.Specification, StringComparison.OrdinalIgnoreCase))
                    errors.Add("最大工序序号的制造规格「" + lastPg.ManufacturingSpec + "」必须等于工单成品规格「" + request.Specification + "」");
            }
        }

        // ========== 制造状态与制造物品业务规则 ==========
        if (request.ManufacturingItem == MaterialType.SpecialDeliveryStatus)
        {
            if (request.ManufacturingStatus == request.DeliveryState)
                errors.Add("制造物品为「订成-非交付态」时，制造状态不能等于交货状态");
        }
        else if (request.ManufacturingStatus != request.DeliveryState)
        {
            errors.Add("制造物品不为「订成-非交付态」时，制造状态必须等于交货状态");
        }

        if (errors.Any())
        {
            Snackbar.Add(string.Join("；", errors), Severity.Warning);
            return;
        }

        // 填充合并投料来源（仓库模式用）
        if (!_noSourceMode)
        {
            request.SourceItems = _selectedSources.Select(s => new SourceBatchItemRequest
            {
                InventoryBatchId = s.InventoryBatchId,
                OutboundRecordId = s.OutboundRecordId,
                InputQuantity = s.InputQuantity,
                InputWeight = s.InputWeight
            }).ToList();
        }
        else if (_noSourceMode)
        {
            // 非仓库模式：从表单填充投料字段
            request.SourceMaterialType = _noSourceMaterialType;
            request.SourceName = _noSourceName;
            request.SourceHeatNo = _noSourceHeatNo;
            request.SourcePlantGrade = _noSourcePlantGrade;
            request.SourceSpecification = _noSourceSpecification;
            request.SourceLengthStatus = _noSourceLengthStatus;
            request.SourceUnitWeight = _noSourceUnitWeight;
            request.InputQuantity = _noSourceInputQty;
            request.InputWeight = _noSourceInputWeight;
            request.InputType = _noSourceInputType;
            request.SourceProductionNo = _noSourceProductionNo;
            request.SourceRemark = _noSourceRemark;
            // 默认有效值等于领料值
            request.CurrentValidQty = _noSourceInputQty;
            request.CurrentValidWeight = (int)_noSourceInputWeight;
        }

        // ========== 理论单支重验证（警告，可继续保存） ==========
        if (request.WorkOrderNo != WorkOrderNoSentinel.NotWorkOrder
            && request.LengthStatus == LengthStatus.Fixed)
        {
            var effectiveWeight = request.CurrentValidWeight ?? request.InputWeight ?? 0;
            var effectiveQty = request.CurrentValidQty ?? request.InputQuantity ?? 0;
            if (effectiveWeight > 500
                && (request.TotalWeight ?? 0) > 0 && (request.TotalQuantity ?? 0) > 0
                && effectiveQty > 0 && request.ProductionRatio > 0)
            {
                var woUnitWeight = request.TotalWeight!.Value / (decimal)request.TotalQuantity!.Value;
                var theoUnitWeight = ComputeTheoreticalUnitWeight();

                if (theoUnitWeight.HasValue
                    && (woUnitWeight > theoUnitWeight.Value * 1.10m || woUnitWeight < theoUnitWeight.Value * 0.90m))
                {
                    var dialog = await DialogService.ShowAsync<ConfirmDialog>("投料单重存疑", new DialogParameters
                    {
                        ["Title"] = "投料单重存疑",
                        ["ContentText"] = $"工单单支重（{woUnitWeight:G29}kg）与理论单支重（{theoUnitWeight:G29}kg）偏差超过10%，请确认投料数据是否正确。",
                        ["ConfirmText"] = "仍然保存"
                    });
                    var result = await dialog.Result;
                    if (result.Canceled) return;
                }
            }
        }

        _isSubmitting = true;
        try
        {
            var result = await BatchService.CreateAsync(request);
            if (result.Success)
            {
                Snackbar.Add($"创建成功，生产编号: {result.Data?.BatchNo}", Severity.Success);
                // 重置表单，保留筛选
                ResetForm();
                await LoadAvailableBatchesAsync();
                await LoadNextBatchNoAsync();
            }
            else
            {
                Snackbar.Add(result.Message ?? "创建失败", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"创建失败: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isSubmitting = false;
        }
    }

