    private async Task CopyProcessGroupsByBatchNo()
    {
        if (string.IsNullOrWhiteSpace(_copyBatchNo))
        {
            Snackbar.Add("请输入批次号", Severity.Warning);
            return;
        }

        if (request.ProcessGroups != null && request.ProcessGroups.Count > 0)
        {
            var dialog = await DialogService.ShowAsync<ConfirmDialog>("确认覆盖", new DialogParameters
            {
                ["Title"] = "确认覆盖",
                ["ContentText"] = "当前已有工序组数据，调取后将覆盖现有数据，是否继续？",
                ["ConfirmText"] = "确认覆盖"
            });
            var result = await dialog.Result;
            if (result.Canceled) return;
        }

        _copyBatchLoading = true;
        StateHasChanged();

        try
        {
            var apiResult = await BatchService.GetProcessGroupsByBatchNoAsync(_copyBatchNo.Trim());
            if (apiResult.Success && apiResult.Data != null && apiResult.Data.Count > 0)
            {
                request.ProcessGroups = apiResult.Data;
                Snackbar.Add($"已从批次 {_copyBatchNo} 复制 {apiResult.Data.Count} 条工序组数据", Severity.Success);
            }
            else
