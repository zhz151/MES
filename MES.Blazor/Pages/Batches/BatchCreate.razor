    /// <summary>
    /// 计算制成倍数：LengthStatus = "Fixed"(定尺)时 = floor(投料单重 / 工单单重)
    /// </summary>
    private void RecalcProductionRatio()
    {
        if (request.LengthStatus != LengthStatus.Fixed)
        {
            request.ProductionRatio = 0;
            return;
        }

        if (request.InputWeight == null || request.InputQuantity == null || request.InputQuantity <= 0)
            return;

        if (request.TotalWeight == null || request.TotalQuantity == null || request.TotalQuantity <= 0)
            return;

        var unitInputWeight = request.InputWeight.Value / (decimal)request.InputQuantity.Value;
        var unitWorkWeight = request.TotalWeight.Value / (decimal)request.TotalQuantity.Value;

        if (unitWorkWeight <= 0)
            return;

        request.ProductionRatio = (int)Math.Floor(unitInputWeight / unitWorkWeight);
    }

    private async Task AutoFillSolutionParamsAsync(string plantGrade)
    {
        try
        {
            var mappings = await GradeMappingService.GetAllAsync();
            var match = mappings.FirstOrDefault(m =>
                m.PlantGrade.Equals(plantGrade, StringComparison.OrdinalIgnoreCase) &&
                !string.IsNullOrWhiteSpace(m.HeatTreatment));

            if (match != null)
            {
                request.SolutionParams = match.HeatTreatment;
                Snackbar.Add($"已根据牌号对照自动填充固溶参数: {match.HeatTreatment}", Severity.Info);
            }
        }
        catch
        {
        }
    }

