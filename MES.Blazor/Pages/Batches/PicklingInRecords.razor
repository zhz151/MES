@page "/pickling-in-records"
@using MES.Blazor.Services
@using MES.Core.DTOs
@using MES.Core.Models
@using MES.Blazor.Helpers
@using Microsoft.AspNetCore.Authorization
@using MES.Blazor.Shared
@using Microsoft.AspNetCore.Components.Rendering
@using MES.Blazor.Models
@using System.Text.Json
@inject PicklingService PicklingService
@inject ProductionRecordService ProductionRecordService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject IJSRuntime JS
@inject ColumnPrefsService ColumnPrefs
@inject PageStateService PageState
@attribute [Authorize(Roles = Roles.Policies.BatchRead)]

<MudContainer MaxWidth="MaxWidth.False" Class="mt-4 pl-0">
    <MudCard>
        <MudCardHeader>
            <CardHeaderContent>
                <MudText Typo="Typo.h5" Class="font-weight-bold">
                    <MudIcon Icon="@Icons.Material.Filled.CleaningServices" Class="mr-2" Color="Color.Warning" />
                    去油/酸洗入缸记录
                </MudText>
            </CardHeaderContent>
            <CardHeaderActions>
                <MudButton Variant="Variant.Filled"
                           Color="Color.Warning"
                           StartIcon="@Icons.Material.Filled.Add"
                           OnClick="NavigateToCreate">
                    入缸报工
                </MudButton>
                <MudButton Variant="Variant.Text"
                           Color="Color.Success"
                           StartIcon="@Icons.Material.Filled.CheckCircle"
                           OnClick='() => Navigation.NavigateTo("/pickling-out-records")'>
                    完工记录
                </MudButton>
            </CardHeaderActions>
        </MudCardHeader>

        <MudCardContent>
            <!-- 搜索栏 -->
            <MudGrid>
                <MudItem xs="12" md="6">
                    <MudTextField T="string"
                                  Label="模糊搜索 - 批次号/工序/工段/制造规格/挂牌号/工厂牌号/备注"
                                  Value="_searchKeyword"
                                  ValueChanged="@OnSearchChanged"
                                  Immediate="true"
                                  DebounceInterval="500"
                                  Clearable="true"
                                  ClearButton="true"
                                  Adornment="Adornment.End"
                                  AdornmentIcon="@Icons.Material.Filled.Search" />
                </MudItem>
            </MudGrid>

            <!-- 数据表格 -->
            <div id="pickling-in-records-list-table">
            <MudTable @ref="table"
                      T="PicklingInRecordDto"
                      ServerData="@LoadDataFromServer"
                      Dense="true"
                      Hover="true"
                      Class="mt-4 auto-table compact-table"
                      Elevation="0"
                      RowsPerPage="@_pageSize"
                      RowsPerPageLabel="每页行数:">
                <ToolBarContent>
                    <ColumnDisplaySelect Columns="_allColumns"
                                         OnColumnToggle="OnColumnToggle"
                                         OnMoveUp="MoveColumnUp"
                                         OnMoveDown="MoveColumnDown" />
                    <MudButton Variant="Variant.Text" Size="Size.Small"
                               OnClick="ResetColumnDisplay">重置列</MudButton>
                    <MudText Class="ml-2" Typo="Typo.body2">共 @_totalCount 条记录</MudText>
                </ToolBarContent>

                <HeaderContent>
                    @foreach (var col in _visibleColumns)
                    {
                        <MudTh Style="@($"width:{col.Width}px")">
                            <div style="display:inline-flex; align-items:center; gap:4px;">
                                <span @onclick='() => ToggleSort(col.Key)' style="cursor:pointer">
                                    @col.Label
                                    @if (sortColumn == col.Key)
                                    {
                                        @(sortDescending ? " ▼" : " ▲")
                                    }
                                </span>
                                @if (col.FilterType != null)
                                {
                                    <ExcelFilter T="PicklingInRecordDto"
                                                 Label="@col.Label"
                                                 FieldKey="@col.Key"
                                                 FilterOptions="@(_filterContextOptions.GetValueOrDefault(col.Key))"
                                                 ActiveFilterValues="@(_columnFilters.GetValueOrDefault(col.Key))"
                                                 FilterChanged="@(args => OnColumnFilterChanged(args.fieldKey, args.selectedValues))" />
                                }
                            </div>
                        </MudTh>
                    }
                    <MudTh>操作</MudTh>
                </HeaderContent>

                <RowTemplate Context="item">
                    @foreach (var col in _visibleColumns)
                    {
                        <MudTd>@RenderCell(item, col)</MudTd>
                    }
                    <MudTd DataLabel="操作">
                        @if (item.Status == "Soaking")
                        {
                            <MudIconButton Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Small"
                                           Color="Color.Success"
                                           OnClick="() => OpenCompleteDialog(item)"
                                           Title="完工" />
                        }
                        @if (_editingIds.Contains(item.Id))
                        {
                            <MudIconButton Icon="@Icons.Material.Filled.Save" Size="Size.Small"
                                           Color="Color.Primary"
                                           OnClick="() => SaveEdit(item)"
                                           Title="保存" />
                            <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small"
                                           Color="Color.Default"
                                           OnClick="() => CancelEdit(item)"
                                           Title="取消" />
                        }
                        else
                        {
                            <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                                           Color="Color.Primary"
                                           OnClick="() => StartEdit(item)"
                                           Title="编辑" />
                        }
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small"
                                       Color="Color.Error"
                                       OnClick="() => ConfirmDelete(item)"
                                       Title="删除" />
                    </MudTd>
                </RowTemplate>

                <FooterContent>
                    @if (_visibleColumns.Any(c => _summableColumnKeys.Contains(c.Key)))
                    {
                        @foreach (var col in _visibleColumns)
                        {
                            <MudTd Class="col-footer-cell">
                                @if (_summableColumnKeys.Contains(col.Key))
                                {
                                    <span class="col-footer-sum">@RenderFooterCell(col)</span>
                                }
                            </MudTd>
                        }
                        <MudTd Class="col-footer-cell"></MudTd>
                    }
                </FooterContent>

                <PagerContent>
                    <MudTablePager PageSizeOptions="@(new int[]{10, 20, 50, 100})" />
                </PagerContent>
            </MudTable>
            </div>
        </MudCardContent>
    </MudCard>
</MudContainer>
