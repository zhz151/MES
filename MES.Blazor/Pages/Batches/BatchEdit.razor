@page "/batches/{Id:int}/edit"
@using MES.Blazor.Helpers
@using MES.Core.Enums
@using MES.Blazor.Services
@using MES.Blazor.Shared
@using MES.Core.Constants
@using MES.Core.DTOs.Batch
@using Microsoft.AspNetCore.Authorization
@inject BatchService BatchService
@inject WorkOrderService WorkOrderService
@inject GradeMappingService GradeMappingService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject ColumnPrefsService ColumnPrefs
@inject IJSRuntime JS
@inject StandardWorkDayService StandardWorkDayService
@inject ProcessDefinitionService ProcessDefinitionService
@attribute [Authorize(Roles = Roles.Policies.BatchEdit)]

<MudContainer MaxWidth="MaxWidth.False" Class="mt-4" id="batch-edit-form">
    @if (isLoading)
    {
        <MudProgressCircular Indeterminate Size="Size.Large" Class="d-flex justify-center ma-8" />
    }
    else if (originalBatch == null)
    {
        <MudText Typo="Typo.body2" Color="Color.Error">批次不存在</MudText>
    }
    else
    {
        <MudCard Class="mb-4 compact-card">
            <MudCardHeader>
                <CardHeaderContent>
                    <MudText Typo="Typo.h5" Class="font-weight-bold">
                        <MudIcon Icon="@Icons.Material.Filled.Edit" Class="mr-2" Color="Color.Warning" />
                        编辑生产批次
                    </MudText>
                </CardHeaderContent>
                <CardHeaderActions>
                    <MudButton Variant="Variant.Text" Color="Color.Default" StartIcon="@Icons.Material.Filled.ArrowBack" OnClick="GoBack" Class="mr-2">返回批次列表</MudButton>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAsync" Loading="@_isSubmitting" StartIcon="@Icons.Material.Filled.Save">
                        保存批次
                    </MudButton>
                </CardHeaderActions>
            </MudCardHeader>
        </MudCard>

        <!-- ==================== Block A: 投料信息 ==================== -->
        <MudCard Class="mb-4 compact-card">
            <MudCardHeader>
                <CardHeaderContent>
                    <div class="d-flex align-center">
                        <MudIcon Icon="@Icons.Material.Filled.Warehouse" Class="mr-1" Color="Color.Primary" />
                        <MudText Typo="Typo.h6" Class="font-weight-bold">投料信息</MudText>
                    </div>
                </CardHeaderContent>
                <CardHeaderActions>
                    <MudButton Variant="Variant.Outlined" Color="Color.Info" Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.Refresh"
                               OnClick="FillFromWarehouse"
                               Disabled="@(_selectedSources.Count == 0)">
                        按仓库批填充
                    </MudButton>
                </CardHeaderActions>
            </MudCardHeader>
            <MudCardContent>
                <!-- 投料字段列表（13字段，单行） -->
                <div style="overflow-x:auto;">
                    <MudSimpleTable Dense="true" Class="auto-table compact-table" Style="min-width:2200px;">
                        <thead>
                            <tr>
                                <th>来源批次号</th>
                                <th>原料类型</th>
                                <th>来料单位</th>
                                <th>炉号</th>
                                <th>工厂牌号</th>
                                <th>规格</th>
                                <th>长度状态</th>
                                <th>单支重(kg)</th>
                                <th>领料支数</th>
                                <th>领料重量(kg)</th>
                                <th>投料类型</th>
                                <th>源生产编号</th>
                                <th>原料备注</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>
                                    <MudText Typo="Typo.body2">@request.SourceBatchNo</MudText>
                                </td>
                                <td>
                                    <MudSelect T="MaterialType?" @bind-Value="formSourceMaterialType" Dense="true" Variant="Variant.Outlined" Size="Size.Small" FullWidth="true">
                                        <MudSelectItem Value="@((MaterialType?)null)">请选择</MudSelectItem>
                                        @foreach (var opt in DisplayHelper.GetEnumOptions<MaterialType>())
                                        {
                                            <MudSelectItem Value="@((MaterialType?)Enum.Parse<MaterialType>(opt.Value))">@opt.Display</MudSelectItem>
                                        }
                                    </MudSelect>
                                </td>
                                <td>
                                    <MudTextField T="string" @bind-Value="request.SourceName" Dense="true" Variant="Variant.Outlined" Size="Size.Small" FullWidth="true" />
                                </td>
                                <td>
                                    <MudTextField T="string" @bind-Value="request.SourceHeatNo" Dense="true" Variant="Variant.Outlined" Size="Size.Small" FullWidth="true" />
                                </td>
                                <td>
                                    <MudTextField T="string" @bind-Value="request.SourcePlantGrade" Dense="true" Variant="Variant.Outlined" Size="Size.Small" FullWidth="true" />
                                </td>
                                <td>
                                    <MudTextField T="string" @bind-Value="request.SourceSpecification" Dense="true" Variant="Variant.Outlined" Size="Size.Small" FullWidth="true" />
                                </td>
                                <td>
                                    <MudSelect T="string" @bind-Value="formSourceLengthStatus" Dense="true" Variant="Variant.Outlined" Size="Size.Small" FullWidth="true">
                                        <MudSelectItem Value="@("")">请选择</MudSelectItem>
                                        @foreach (var opt in DisplayHelper.GetEnumOptions<LengthStatus>())
                                        {
                                            <MudSelectItem Value="@opt.Value">@opt.Display</MudSelectItem>
                                        }
                                    </MudSelect>
                                </td>
                                <td>
                                    <MudNumericField T="decimal?" @bind-Value="request.SourceUnitWeight" Dense="true" Variant="Variant.Outlined" Size="Size.Small" Format="G29" HideSpinButtons="true" FullWidth="true" />
                                </td>
                                <td>
                                    <MudNumericField T="int?" @bind-Value="request.InputQuantity" Dense="true" Variant="Variant.Outlined" Size="Size.Small" HideSpinButtons="true" FullWidth="true" Min="0" />
                                </td>
                                <td>
                                    <MudNumericField T="decimal?" @bind-Value="request.InputWeight" Dense="true" Variant="Variant.Outlined" Size="Size.Small" Format="G29" HideSpinButtons="true" FullWidth="true" Min="0" />
                                </td>
                                <td>
                                    @if (_hasSourceBatchNo)
                                    {
                                        <MudText Typo="Typo.body2">@DisplayHelper.GetInputTypeText(request.InputType ?? BatchInputType.Warehouse)</MudText>
                                    }
                                    else
                                    {
                                        <MudSelect T="BatchInputType" @bind-Value="formInputType" Dense="true" Variant="Variant.Outlined" Size="Size.Small" FullWidth="true">
                                            @foreach (var opt in DisplayHelper.GetEnumOptions<BatchInputType>())
                                            {
                                                <MudSelectItem Value="@(Enum.Parse<BatchInputType>(opt.Value))">@opt.Display</MudSelectItem>
                                            }
                                        </MudSelect>
                                    }
                                </td>
                                <td>
                                    <MudTextField T="string" @bind-Value="request.SourceProductionNo" Dense="true" Variant="Variant.Outlined" Size="Size.Small" FullWidth="true" />
                                </td>
                                <td>
                                    <MudTextField T="string" @bind-Value="request.SourceRemark" Dense="true" Variant="Variant.Outlined" Size="Size.Small" FullWidth="true" />
                                </td>
                            </tr>
                        </tbody>
                    </MudSimpleTable>
                </div>

                <!-- 子表：来源库存批次 -->
                @if (_selectedSources.Count > 0)
                {
                    <MudText Typo="Typo.subtitle2" Class="mt-4 mb-2">
                        <MudIcon Icon="@Icons.Material.Filled.Inventory" Class="mr-1" Size="Size.Small" />
                        来源库存批次
                    </MudText>
                    <div style="overflow-x:auto;">
                        <MudTable T="SelectedSourceItem" Items="@_selectedSources" Dense="true" Hover="true" Elevation="0" Class="auto-table compact-table">
                            <HeaderContent>
                                <MudTh Style="width:140px;">来源库存批次号</MudTh>
                                <MudTh Style="width:100px;">原料类型</MudTh>
                                <MudTh Style="width:100px;">入库来源</MudTh>
                                <MudTh Style="width:100px;">来料单位</MudTh>
                                <MudTh Style="width:90px;">入库日期</MudTh>
                                <MudTh Style="width:90px;">炉号</MudTh>
                                <MudTh Style="width:100px;">工厂牌号</MudTh>
                                <MudTh Style="width:120px;">名义规格</MudTh>
                                <MudTh Style="width:80px;">长度状态</MudTh>
                                <MudTh Style="width:80px;">单支重(kg)</MudTh>
                                <MudTh Style="width:80px;">领料支数</MudTh>
                                <MudTh Style="width:90px;">领料重量(kg)</MudTh>
                                <MudTh Style="width:100px;">仓库名称</MudTh>
                                <MudTh Style="width:100px;">来源工单号</MudTh>
                                <MudTh Style="width:100px;">操作</MudTh>
                            </HeaderContent>
                            <RowTemplate Context="item">
                                <MudTd><b>@item.BatchNo</b></MudTd>
                                <MudTd>@DisplayHelper.GetMaterialTypeText(item.MaterialType)</MudTd>
                                <MudTd>@DisplayHelper.GetInboundSourceText(item.InboundSource?.ToString())</MudTd>
                                <MudTd>@item.SourceName</MudTd>
                                <MudTd>@item.InboundDate?.ToString("yyyy-MM-dd")</MudTd>
                                <MudTd>@item.HeatNo</MudTd>
                                <MudTd>@item.PlantGrade</MudTd>
                                <MudTd>@item.Specification</MudTd>
                                <MudTd>@DisplayHelper.GetLengthStatusText(item.LengthStatus)</MudTd>
                                <MudTd Class="text-right">@item.UnitWeight?.ToString("G29")</MudTd>
                                <MudTd Class="text-right">@item.InputQuantity</MudTd>
                                <MudTd Class="text-right">@item.InputWeight.ToString("G29")</MudTd>
                                <MudTd>@item.WarehouseName</MudTd>
                                <MudTd>@item.WorkOrderNo</MudTd>
                                <MudTd>
                                    <MudIconButton Icon="@Icons.Material.Filled.Refresh" Color="Color.Info" Size="Size.Small" Title="按来源库存批次填充" OnClick="@(() => FillFromSourceItem(item))" />
                                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" Title="删除" OnClick="@(() => RemoveSourceItem(item))" />
                                </MudTd>
                            </RowTemplate>
                        </MudTable>
                        <div class="d-flex justify-end mt-2" Style="gap:16px;">
                            <MudText Typo="Typo.body2">
                                合计：领料支数 <strong>@_totalInputQty</strong>，
                                领料重量 <strong>@_totalInputWeight.ToString("G29")</strong> kg
                            </MudText>
                        </div>
                    </div>
                }
                else
                {
                    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mt-2">
                        暂无来源库存批次。如无仓库来源，可直接在上方字段中手工填写投料信息。
                    </MudAlert>
                }
            </MudCardContent>
        </MudCard>

        <!-- ==================== Block B: 工单字段信息 ==================== -->
        <MudCard Class="mb-4 compact-card">
            <MudCardHeader>
                <CardHeaderContent>
                    <div class="d-flex align-center">
                        <MudIcon Icon="@Icons.Material.Filled.Assignment" Class="mr-1" Color="Color.Primary" />
                        <MudText Typo="Typo.h6" Class="font-weight-bold">工单字段信息</MudText>
                        <span Class="ml-3 text-caption text-hint">（@visibleFieldCount 字段可见/共29字段）</span>
                    </div>
                </CardHeaderContent>
                <CardHeaderActions>
                    <ColumnDisplaySelect Columns="workOrderCols" ShowCommonFields="false"
                                       OnColumnToggle="OnWorkOrderColumnToggle"
                                       OnMoveUp="OnWorkOrderColumnMove"
                                       OnMoveDown="OnWorkOrderColumnMove" />
                    <MudButton Variant="Variant.Text" Size="Size.Small" Color="Color.Warning"
                               StartIcon="@Icons.Material.Filled.Refresh" OnClick="ResetWorkOrderColumns">重置</MudButton>
                </CardHeaderActions>
            </MudCardHeader>
            <MudCardContent>
                <div style="display:flex; align-items:center; gap:8px; margin-bottom:4px; flex-wrap:wrap;">
                    <div style="display:flex; align-items:center; gap:8px; flex:1; max-width:400px;">
                        <MudTextField T="string" @bind-Value="request.WorkOrderNo"
                                      Dense="true" Variant="Variant.Outlined" Size="Size.Small" Style="flex:1;" />
                        <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small"
                                   OnClick="ConfirmWorkOrder" Disabled="@workOrderLoading">
                            @if (workOrderLoading)
                            {
                                <MudProgressCircular Size="Size.Small" Indeterminate Color="Color.Inherit" />
                            }
                            else
                            {
                                <span>确认</span>
                            }
                        </MudButton>
                    </div>
                </div>

                @if (visibleFieldCount > 0)
                {
                    <div style="overflow-x:auto;">
                        <MudSimpleTable Dense="true" Class="auto-table compact-table" Style="width:4200px;">
                            <thead>
                                <tr>
                                    @if (GetCol("SalesOrderNo").Visible) { <th style="width:140px;">源订单号</th> }
                                    @if (GetCol("ProductionMainNo").Visible) { <th style="width:100px;">主号</th> }
                                    @if (GetCol("ProductionSubNo").Visible) { <th style="width:100px;">次号</th> }
                                    @if (GetCol("MaterialName").Visible) { <th style="width:140px;">钢管制造</th> }
                                    @if (GetCol("DeliveryState").Visible) { <th style="width:200px;">交货状态</th> }
                                    @if (GetCol("PlantGrade").Visible) { <th style="width:120px;">工厂牌号</th> }
                                    @if (GetCol("Specification").Visible) { <th style="width:160px;">规格</th> }
                                    @if (GetCol("LengthStatus").Visible) { <th style="width:100px;">长度状态</th> }
                                    @if (GetCol("SettlementMethod").Visible) { <th style="width:140px;">结算方式</th> }
                                    @if (GetCol("StandardCode").Visible) { <th style="width:140px;">产品标准编码</th> }
                                    @if (GetCol("TotalQuantity").Visible) { <th style="width:100px;">总支数</th> }
                                    @if (GetCol("TotalWeight").Visible) { <th style="width:120px;">总重量(kg)</th> }
                                    @if (GetCol("OuterDiameterNegative").Visible) { <th style="width:110px;">外径负公差</th> }
                                    @if (GetCol("OuterDiameterPositive").Visible) { <th style="width:110px;">外径正公差</th> }
                                    @if (GetCol("WallThicknessNegative").Visible) { <th style="width:110px;">壁厚负公差</th> }
                                    @if (GetCol("WallThicknessPositive").Visible) { <th style="width:110px;">壁厚正公差</th> }
                                    @if (GetCol("MinLength").Visible) { <th style="width:110px;">最小长度(mm)</th> }
                                    @if (GetCol("MaxLength").Visible) { <th style="width:110px;">最大长度(mm)</th> }
                                    @if (GetCol("TechnicalRequirements").Visible) { <th style="width:120px;">技术要求</th> }
                                    @if (GetCol("SignDate").Visible) { <th style="width:120px;">签订日期</th> }
                                    @if (GetCol("DeliveryDate").Visible) { <th style="width:120px;">交货日期</th> }
                                    @if (GetCol("Salesman").Visible) { <th style="width:100px;">业务员</th> }
                                    @if (GetCol("EndCustomer").Visible) { <th style="width:120px;">最终用户</th> }
                                    @if (GetCol("DelayPenalty").Visible) { <th style="width:80px;">延期罚款</th> }
                                    @if (GetCol("TotalMeters").Visible) { <th style="width:100px;">总米数</th> }
                                    @if (GetCol("TotalItemCount").Visible) { <th style="width:100px;">总项次数</th> }
                                    @if (GetCol("OrderItemIds").Visible) { <th style="width:120px;">项次ID列表</th> }
                                    @if (GetCol("ItemDetails").Visible) { <th style="width:250px;">明细</th> }
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    @if (GetCol("SalesOrderNo").Visible) { <td><MudTextField T="string" @bind-Value="request.SalesOrderNo" Dense="true" Variant="Variant.Outlined" Size="Size.Small" FullWidth="true" /></td> }
                                    @if (GetCol("ProductionMainNo").Visible) { <td><MudTextField T="string" @bind-Value="request.ProductionMainNo" Dense="true" Variant="Variant.Outlined" Size="Size.Small" FullWidth="true" /></td> }
                                    @if (GetCol("ProductionSubNo").Visible) { <td><MudTextField T="string" @bind-Value="request.ProductionSubNo" Dense="true" Variant="Variant.Outlined" Size="Size.Small" FullWidth="true" /></td> }
                                    @if (GetCol("MaterialName").Visible)
                                    {
                                        <td>
                                            <MudSelect T="PipeManufacturingType?" @bind-Value="formMaterialName" Dense="true" Variant="Variant.Outlined" Size="Size.Small" FullWidth="true">
                                                <MudSelectItem Value="@((PipeManufacturingType?)null)">请选择</MudSelectItem>
                                                @foreach (var opt in DisplayHelper.GetEnumOptions<PipeManufacturingType>())
                                                {
                                                    <MudSelectItem Value="@((PipeManufacturingType?)Enum.Parse<PipeManufacturingType>(opt.Value))">@opt.Display</MudSelectItem>
                                                }
                                            </MudSelect>
                                        </td>
                                    }
                                    @if (GetCol("DeliveryState").Visible)
                                    {
                                        <td>
                                            <MudSelect T="DeliveryState?" @bind-Value="formDeliveryState" Dense="true" Variant="Variant.Outlined" Size="Size.Small" FullWidth="true">
                                                <MudSelectItem Value="@((DeliveryState?)null)">请选择</MudSelectItem>
                                                @foreach (var opt in DisplayHelper.GetEnumOptions<DeliveryState>())
                                                {
                                                    <MudSelectItem Value="@((DeliveryState?)Enum.Parse<DeliveryState>(opt.Value))">@opt.Display</MudSelectItem>
                                                }
                                            </MudSelect>
                                        </td>
                                    }
                                    @if (GetCol("PlantGrade").Visible) { <td><MudTextField T="string" @bind-Value="request.PlantGrade" Dense="true" Variant="Variant.Outlined" Size="Size.Small" FullWidth="true" /></td> }
                                    @if (GetCol("Specification").Visible) { <td><MudTextField T="string" @bind-Value="request.Specification" Dense="true" Variant="Variant.Outlined" Size="Size.Small" FullWidth="true" /></td> }
                                    @if (GetCol("LengthStatus").Visible)
                                    {
                                        <td>
                                            <MudSelect T="LengthStatus?" @bind-Value="formLengthStatus" Dense="true" Variant="Variant.Outlined" Size="Size.Small" FullWidth="true">
                                                <MudSelectItem Value="@((LengthStatus?)null)">请选择</MudSelectItem>
                                                @foreach (var opt in DisplayHelper.GetEnumOptions<LengthStatus>())
                                                {
                                                    <MudSelectItem Value="@((LengthStatus?)Enum.Parse<LengthStatus>(opt.Value))">@opt.Display</MudSelectItem>
                                                }
                                            </MudSelect>
                                        </td>
                                    }
                                    @if (GetCol("SettlementMethod").Visible)
                                    {
                                        <td>
                                            <MudSelect T="SettlementMethod?" @bind-Value="formSettlementMethod" Dense="true" Variant="Variant.Outlined" Size="Size.Small" FullWidth="true">
                                                <MudSelectItem Value="@((SettlementMethod?)null)">请选择</MudSelectItem>
                                                @foreach (var opt in DisplayHelper.GetEnumOptions<SettlementMethod>())
                                                {
                                                    <MudSelectItem Value="@((SettlementMethod?)Enum.Parse<SettlementMethod>(opt.Value))">@opt.Display</MudSelectItem>
                                                }
                                            </MudSelect>
                                        </td>
                                    }
                                    @if (GetCol("StandardCode").Visible) { <td><MudTextField T="string" @bind-Value="request.StandardCode" Dense="true" Variant="Variant.Outlined" Size="Size.Small" FullWidth="true" /></td> }
                                    @if (GetCol("TotalQuantity").Visible) { <td><MudNumericField T="int?" @bind-Value="request.TotalQuantity" Dense="true" Variant="Variant.Outlined" Size="Size.Small" HideSpinButtons="true" FullWidth="true" /></td> }
                                    @if (GetCol("TotalWeight").Visible) { <td><MudNumericField T="decimal?" @bind-Value="request.TotalWeight" Dense="true" Variant="Variant.Outlined" Size="Size.Small" Format="G29" HideSpinButtons="true" FullWidth="true" /></td> }
                                    @if (GetCol("OuterDiameterNegative").Visible) { <td><MudNumericField T="decimal?" @bind-Value="request.OuterDiameterNegative" Dense="true" Variant="Variant.Outlined" Size="Size.Small" Format="G29" HideSpinButtons="true" FullWidth="true" /></td> }
                                    @if (GetCol("OuterDiameterPositive").Visible) { <td><MudNumericField T="decimal?" @bind-Value="request.OuterDiameterPositive" Dense="true" Variant="Variant.Outlined" Size="Size.Small" Format="G29" HideSpinButtons="true" FullWidth="true" /></td> }
                                    @if (GetCol("WallThicknessNegative").Visible) { <td><MudNumericField T="decimal?" @bind-Value="request.WallThicknessNegative" Dense="true" Variant="Variant.Outlined" Size="Size.Small" Format="G29" HideSpinButtons="true" FullWidth="true" /></td> }
                                    @if (GetCol("WallThicknessPositive").Visible) { <td><MudNumericField T="decimal?" @bind-Value="request.WallThicknessPositive" Dense="true" Variant="Variant.Outlined" Size="Size.Small" Format="G29" HideSpinButtons="true" FullWidth="true" /></td> }
                                    @if (GetCol("MinLength").Visible) { <td><MudNumericField T="decimal?" @bind-Value="request.MinLength" Dense="true" Variant="Variant.Outlined" Size="Size.Small" Format="G29" HideSpinButtons="true" FullWidth="true" /></td> }
                                    @if (GetCol("MaxLength").Visible) { <td><MudNumericField T="decimal?" @bind-Value="request.MaxLength" Dense="true" Variant="Variant.Outlined" Size="Size.Small" Format="G29" HideSpinButtons="true" FullWidth="true" /></td> }
                                    @if (GetCol("TechnicalRequirements").Visible)
                                    {
                                        <td>
                                            <MudSelect T="RequirementType?" @bind-Value="formTechnicalRequirements" Dense="true" Variant="Variant.Outlined" Size="Size.Small" FullWidth="true">
                                                <MudSelectItem Value="@((RequirementType?)null)">请选择</MudSelectItem>
                                                @foreach (var opt in DisplayHelper.GetEnumOptions<RequirementType>())
                                                {
                                                    <MudSelectItem Value="@((RequirementType?)Enum.Parse<RequirementType>(opt.Value))">@opt.Display</MudSelectItem>
                                                }
                                            </MudSelect>
                                        </td>
                                    }
                                    @if (GetCol("SignDate").Visible) { <td><MudTextField T="string" @bind-Value="editSignDateStr" Placeholder="yyyy-MM-dd" Dense="true" Variant="Variant.Outlined" Size="Size.Small" FullWidth="true" /></td> }
                                    @if (GetCol("DeliveryDate").Visible) { <td><MudTextField T="string" @bind-Value="editDeliveryDateStr" Placeholder="yyyy-MM-dd" Dense="true" Variant="Variant.Outlined" Size="Size.Small" FullWidth="true" /></td> }
                                    @if (GetCol("Salesman").Visible) { <td><MudTextField T="string" @bind-Value="request.Salesman" Dense="true" Variant="Variant.Outlined" Size="Size.Small" FullWidth="true" /></td> }
                                    @if (GetCol("EndCustomer").Visible) { <td><MudTextField T="string" @bind-Value="request.EndCustomer" Dense="true" Variant="Variant.Outlined" Size="Size.Small" FullWidth="true" /></td> }
                                    @if (GetCol("DelayPenalty").Visible) { <td><MudCheckBox @bind-Value="editDelayPenaltyValue" Color="Color.Warning" /></td> }
                                    @if (GetCol("TotalMeters").Visible) { <td><MudNumericField T="decimal?" @bind-Value="request.TotalMeters" Dense="true" Variant="Variant.Outlined" Size="Size.Small" Format="G29" HideSpinButtons="true" FullWidth="true" /></td> }
                                    @if (GetCol("TotalItemCount").Visible) { <td><MudNumericField T="int?" @bind-Value="request.TotalItemCount" Dense="true" Variant="Variant.Outlined" Size="Size.Small" HideSpinButtons="true" FullWidth="true" /></td> }
                                    @if (GetCol("OrderItemIds").Visible) { <td><MudTextField T="string" @bind-Value="request.OrderItemIds" Dense="true" Variant="Variant.Outlined" Size="Size.Small" FullWidth="true" /></td> }
                                    @if (GetCol("ItemDetails").Visible) { <td><MudTextField T="string" @bind-Value="request.ItemDetails" Dense="true" Variant="Variant.Outlined" Size="Size.Small" FullWidth="true" /></td> }
                                </tr>
                            </tbody>
                        </MudSimpleTable>
                    </div>
                }
            </MudCardContent>
        </MudCard>



        <!-- ==================== Block C/D: 基础信息（含质量要求） ==================== -->
