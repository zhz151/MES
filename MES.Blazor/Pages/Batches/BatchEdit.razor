        request.SourceUnitWeight = originalBatch.SourceUnitWeight;
        request.InputQuantity = originalBatch.InputQuantity;
        request.InputWeight = originalBatch.InputWeight;
        request.InputType = originalBatch.InputType;
        request.SourceRemark = originalBatch.SourceRemark;
        request.SourceProductionNo = originalBatch.SourceProductionNo;
        editSourceWorkOrderNo = originalBatch.WorkOrderNo;

        // 合并投料来源
        _selectedSources = (originalBatch.SourceItems ?? new()).Select(s => new SelectedSourceItem
        {
            InventoryBatchId = s.InventoryBatchId,
            OutboundRecordId = s.OutboundRecordId,
            BatchNo = s.BatchNo,
            MaterialType = s.MaterialType ?? default,
            SourceName = s.SourceName,
            HeatNo = s.HeatNo,
            PlantGrade = s.PlantGrade,
