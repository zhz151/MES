        <!-- ==================== Block E: 工序组 ==================== -->
        <MudCard Class="mb-4 compact-card">
            <MudCardHeader>
                <CardHeaderContent>
                    <div class="d-flex align-center">
                        <MudIcon Icon="@Icons.Material.Filled.Factory" Class="mr-1" Color="Color.Primary" />
