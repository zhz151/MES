        // 质量要求
        request.SolutionParams = originalBatch.SolutionParams;
        request.QualityRemark = originalBatch.QualityRemark;

        // 投料信息
        request.SourceBatchNo = originalBatch.SourceBatchNo;
        request.SourceMaterialType = originalBatch.SourceMaterialType;
        request.SourceName = originalBatch.SourceName;
