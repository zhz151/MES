                </CardHeaderContent>
            </MudCardHeader>
            <MudCardContent>
                <div class="d-flex flex-wrap align-center" style="gap:8px; margin-bottom:12px; justify-content:flex-end;">
                    <MudButton Variant="Variant.Outlined" Color="Color.Info" Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.ContentCopy" OnClick="CopyLastBatchProcessGroups"
                               Disabled="@lastBatchLoading">
                        @if (lastBatchLoading)
                        {
                            <MudProgressCircular Size="Size.Small" Indeterminate Color="Color.Inherit" />
                        }
                        else
                        {
                            <span>复制上个工序组</span>
                        }
                    </MudButton>
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.Add" OnClick="AddProcessGroupRow">新增工序</MudButton>
                    <ColumnDisplaySelect Columns="pgCols" ShowCommonFields="false"
                                       OnColumnToggle="OnPgColumnToggle"
                                       OnMoveUp="OnPgColumnMove"
                                       OnMoveDown="OnPgColumnMove" />
                    <MudButton Variant="Variant.Text" Size="Size.Small" Color="Color.Warning"
                               StartIcon="@Icons.Material.Filled.Refresh" OnClick="ResetPgColumns">重置</MudButton>
                    <div style="width:130px;">
                        <MudTextField T="string" @bind-Value="_copyBatchNo"
