@page "/batches/{Id:int}/edit"
@using MES.Blazor.Helpers
@using MES.Blazor.Services
@using MES.Blazor.Shared
@using MES.Core.DTOs
@using MES.Core.Constants
@using Microsoft.AspNetCore.Authorization
@inject BatchService BatchService
@inject WorkOrderService WorkOrderService
@inject GradeMappingService GradeMappingService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject ColumnPrefsService ColumnPrefs
@inject IJSRuntime JS
@attribute [Authorize(Roles = "BatchStaff,BatchDirector,Admin")]

<MudContainer MaxWidth="MaxWidth.False" Class="mt-4" id="batch-edit-form">
    @if (isLoading)
    {
        <MudProgressCircular Indeterminate Size="Size.Large" Class="d-flex justify-center ma-8" />
    }
    else if (originalBatch == null)
    {
        <MudText Typo="Typo.body2" Color="Color.Error">批次不存在</MudText>
    }
    else
    {
        <MudCard Class="mb-4 compact-card">
            <MudCardHeader>
                <CardHeaderContent>
                    <MudText Typo="Typo.h5" Class="font-weight-bold">
                        <MudIcon Icon="@Icons.Material.Filled.Edit" Class="mr-2" Color="Color.Warning" />
                        编辑生产批次
                    </MudText>
                </CardHeaderContent>
                <CardHeaderActions>
                    <MudButton Variant="Variant.Text" Color="Color.Default" StartIcon="@Icons.Material.Filled.ArrowBack" OnClick="GoBack" Class="mr-2">返回批次列表</MudButton>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAsync" Loading="@_isSubmitting" StartIcon="@Icons.Material.Filled.Save">
                        保存批次
                    </MudButton>
                </CardHeaderActions>
            </MudCardHeader>
        </MudCard>

        <!-- ==================== Block A: 仓库信息 ==================== -->
        <MudCard Class="mb-4 compact-card">
            <MudCardHeader>
                <CardHeaderContent>
                    <div class="d-flex align-center">
                        <MudIcon Icon="@Icons.Material.Filled.Warehouse" Class="mr-1" Color="Color.Primary" />
                        <MudText Typo="Typo.h6" Class="font-weight-bold">仓库信息</MudText>
                    </div>
                </CardHeaderContent>
                <CardHeaderActions>
                    <MudButton Variant="Variant.Text" Size="Size.Small" Color="Color.Info"
                               StartIcon="@(showAvailablePanel ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                               OnClick="ToggleAvailablePanel">
                        @(showAvailablePanel ? "隐藏可用批次" : "显示可用批次")
                    </MudButton>
                </CardHeaderActions>
            </MudCardHeader>
            <MudCardContent>
                @if (showAvailablePanel)
                {
                    <MudPaper Class="pa-3 mb-4" Elevation="1" Style="border:1px solid #e0e0e0; border-radius:8px;">
                        <MudText Typo="Typo.subtitle2" Class="mb-2">
                            <MudIcon Icon="@Icons.Material.Filled.Inventory" Class="mr-1" Size="Size.Small" />
                            可用库存批次
                            <MudTextField T="string" @bind-Value="searchText" Label="筛选" Dense="true" Variant="Variant.Outlined" Size="Size.Small" Immediate="true" DebounceInterval="500" Style="width:160px; margin-left:12px;" />
                        </MudText>
                        @if (availableBatchesLoading)
                        {
                            <MudProgressCircular Indeterminate Size="Size.Small" Class="my-2" />
                        }
                        else if (availableBatches.Count == 0)
                        {
                        }
                        else
                        {
                            <div style="overflow-x:auto; max-height:250px; overflow-y:auto;">
                                <MudTable T="AvailableBatchDto" Items="@sortedAvailableBatches" RowsPerPage="5" Dense="true" Hover="true" Elevation="0" Class="auto-table" Style="cursor:pointer;">
                                    <HeaderContent>
                                        <MudTh Style="width:100px;">
                                            <span Class="sortable-header" @onclick="@(() => ToggleSort("BatchNo"))">
                                                批次号
                                                @if (sortColumn == "BatchNo") { <span Class="sort-arrow">@(sortAscending ? "▲" : "▼")</span> }
                                            </span>
                                        </MudTh>
                                        <MudTh Style="width:80px;">
                                            <span Class="sortable-header" @onclick="@(() => ToggleSort("MaterialType"))">
                                                原料类型
                                                @if (sortColumn == "MaterialType") { <span Class="sort-arrow">@(sortAscending ? "▲" : "▼")</span> }
                                            </span>
                                        </MudTh>
                                        <MudTh Style="width:80px;">
                                            <span Class="sortable-header" @onclick="@(() => ToggleSort("InboundSource"))">
                                                入库来源
                                                @if (sortColumn == "InboundSource") { <span Class="sort-arrow">@(sortAscending ? "▲" : "▼")</span> }
                                            </span>
                                        </MudTh>
                                        <MudTh Style="width:100px;">
                                            <span Class="sortable-header" @onclick="@(() => ToggleSort("SourceName"))">
                                                来料单位
                                                @if (sortColumn == "SourceName") { <span Class="sort-arrow">@(sortAscending ? "▲" : "▼")</span> }
                                            </span>
                                        </MudTh>
                                        <MudTh Style="width:80px;">
                                            <span Class="sortable-header" @onclick="@(() => ToggleSort("InboundDate"))">
                                                入库日期
                                                @if (sortColumn == "InboundDate") { <span Class="sort-arrow">@(sortAscending ? "▲" : "▼")</span> }
                                            </span>
                                        </MudTh>
                                        <MudTh Style="width:80px;">
                                            <span Class="sortable-header" @onclick="@(() => ToggleSort("HeatNo"))">
                                                炉号
                                                @if (sortColumn == "HeatNo") { <span Class="sort-arrow">@(sortAscending ? "▲" : "▼")</span> }
                                            </span>
                                        </MudTh>
                                        <MudTh Style="width:80px;">
                                            <span Class="sortable-header" @onclick="@(() => ToggleSort("PlantGrade"))">
                                                工厂牌号
                                                @if (sortColumn == "PlantGrade") { <span Class="sort-arrow">@(sortAscending ? "▲" : "▼")</span> }
                                            </span>
                                        </MudTh>
                                        <MudTh Style="width:80px;">
                                            <span Class="sortable-header" @onclick="@(() => ToggleSort("Specification"))">
                                                名义规格
                                                @if (sortColumn == "Specification") { <span Class="sort-arrow">@(sortAscending ? "▲" : "▼")</span> }
                                            </span>
                                        </MudTh>
                                        <MudTh Style="width:60px;">
                                            <span Class="sortable-header" @onclick="@(() => ToggleSort("LengthStatus"))">
                                                长度状态
                                                @if (sortColumn == "LengthStatus") { <span Class="sort-arrow">@(sortAscending ? "▲" : "▼")</span> }
                                            </span>
                                        </MudTh>
                                        <MudTh Style="width:60px;" Class="text-right">
                                            <span Class="sortable-header" @onclick="@(() => ToggleSort("UnitWeight"))">
                                                单支重
                                                @if (sortColumn == "UnitWeight") { <span Class="sort-arrow">@(sortAscending ? "▲" : "▼")</span> }
                                            </span>
                                        </MudTh>
                                        <MudTh Style="width:60px;" Class="text-right">
                                            <span Class="sortable-header" @onclick="@(() => ToggleSort("OutboundQuantity"))">
                                                支数
                                                @if (sortColumn == "OutboundQuantity") { <span Class="sort-arrow">@(sortAscending ? "▲" : "▼")</span> }
                                            </span>
                                        </MudTh>
                                        <MudTh Style="width:80px;" Class="text-right">
                                            <span Class="sortable-header" @onclick="@(() => ToggleSort("OutboundWeight"))">
                                                重量(kg)
                                                @if (sortColumn == "OutboundWeight") { <span Class="sort-arrow">@(sortAscending ? "▲" : "▼")</span> }
                                            </span>
                                        </MudTh>
                                        <MudTh Style="width:100px;">
                                            <span Class="sortable-header" @onclick="@(() => ToggleSort("WorkOrderNo"))">
                                                关联工单号
                                                @if (sortColumn == "WorkOrderNo") { <span Class="sort-arrow">@(sortAscending ? "▲" : "▼")</span> }
                                            </span>
                                        </MudTh>
                                    </HeaderContent>
                                    <RowTemplate Context="batch">
                                        <MudTd @onclick="() => FillFromAvailableBatch(batch)" Style="cursor:pointer;color:#1976D2;"><b>@batch.BatchNo</b></MudTd>
                                        <MudTd @onclick="() => FillFromAvailableBatch(batch)">@batch.MaterialType</MudTd>
                                        <MudTd @onclick="() => FillFromAvailableBatch(batch)">@DisplayHelper.GetInboundSourceText(batch.InboundSource)</MudTd>
                                        <MudTd @onclick="() => FillFromAvailableBatch(batch)">@batch.SourceName</MudTd>
                                        <MudTd @onclick="() => FillFromAvailableBatch(batch)">@batch.InboundDate?.ToString("yyyy-MM-dd")</MudTd>
                                        <MudTd @onclick="() => FillFromAvailableBatch(batch)">@batch.HeatNo</MudTd>
                                        <MudTd @onclick="() => FillFromAvailableBatch(batch)">@batch.PlantGrade</MudTd>
                                        <MudTd @onclick="() => FillFromAvailableBatch(batch)">@batch.Specification</MudTd>
                                        <MudTd @onclick="() => FillFromAvailableBatch(batch)">@DisplayHelper.GetLengthStatusText(batch.LengthStatus)</MudTd>
                                        <MudTd @onclick="() => FillFromAvailableBatch(batch)" Class="text-right">@batch.UnitWeight?.ToString("G29")</MudTd>
                                        <MudTd @onclick="() => FillFromAvailableBatch(batch)" Class="text-right">@batch.OutboundQuantity</MudTd>
                                        <MudTd @onclick="() => FillFromAvailableBatch(batch)" Class="text-right">@batch.OutboundWeight?.ToString("G29")</MudTd>
                                        <MudTd @onclick="() => FillFromAvailableBatch(batch)">@batch.WorkOrderNo</MudTd>
                                    </RowTemplate>
                                    <PagerContent>
                                        <MudTablePager />
                                    </PagerContent>
                                </MudTable>
                            </div>
                        }
                    </MudPaper>
                }

                <MudSimpleTable Dense="true" Class="auto-table">
                    <thead>
                        <tr>
                            <th>来源库存批次号</th>
                            <th>原料类型</th>
                            <th>入库来源</th>
                            <th>来料单位</th>
                            <th>入库日期</th>
                            <th>炉号</th>
                            <th>工厂牌号</th>
                            <th>名义规格</th>
                            <th>长度状态</th>
                            <th>单支重(kg)</th>
                            <th>领料支数</th>
                            <th>领料重量(kg)</th>
                            <th>来源工单号</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td><MudTextField T="string" @bind-Value="request.SourceBatchNo" Dense="true" Variant="Variant.Outlined" Size="Size.Small" /></td>
                            <td><MudTextField T="string" @bind-Value="request.SourceMaterialType" Dense="true" Variant="Variant.Outlined" Size="Size.Small" /></td>
                            <td><MudSelect T="string" @bind-Value="request.InboundSource" Dense="true" Variant="Variant.Outlined" Size="Size.Small">
                                    <MudSelectItem Value="@("Purchase")">外购</MudSelectItem>
                                    <MudSelectItem Value="@("Subcontract")">委外</MudSelectItem>
                                    <MudSelectItem Value="@("ReturnIn")">退货入库</MudSelectItem>
                                    <MudSelectItem Value="@("ProductionInbound")">生产入库</MudSelectItem>
                                    <MudSelectItem Value="@("InspectionInbound")">检验入库</MudSelectItem>
                                    <MudSelectItem Value="@("TransferIn")">移库入库</MudSelectItem>
                                    <MudSelectItem Value="@("Other")">其它</MudSelectItem>
                                </MudSelect></td>
                            <td><MudTextField T="string" @bind-Value="request.SourceName" Dense="true" Variant="Variant.Outlined" Size="Size.Small" /></td>
                            <td><MudTextField T="string" @bind-Value="editInboundDateStr" Placeholder="yyyy-MM-dd" Dense="true" Variant="Variant.Outlined" Size="Size.Small" /></td>
                            <td><MudTextField T="string" @bind-Value="request.SourceHeatNo" Dense="true" Variant="Variant.Outlined" Size="Size.Small" /></td>
                            <td><MudTextField T="string" @bind-Value="request.SourcePlantGrade" Dense="true" Variant="Variant.Outlined" Size="Size.Small" /></td>
                            <td><MudTextField T="string" @bind-Value="request.SourceSpecification" Dense="true" Variant="Variant.Outlined" Size="Size.Small" /></td>
                            <td><MudTextField T="string" @bind-Value="request.SourceLengthStatus" Dense="true" Variant="Variant.Outlined" Size="Size.Small" /></td>
                            <td><MudNumericField T="decimal?" @bind-Value="request.SourceUnitWeight" Dense="true" Variant="Variant.Outlined" Size="Size.Small" Format="G29" HideSpinButtons="true" /></td>
                            <td><MudNumericField T="int?" @bind-Value="request.InputQuantity" Dense="true" Variant="Variant.Outlined" Size="Size.Small" HideSpinButtons="true" /></td>
                            <td><MudNumericField T="decimal?" @bind-Value="request.InputWeight" Dense="true" Variant="Variant.Outlined" Size="Size.Small" Format="G29" HideSpinButtons="true" /></td>
                            <td><MudTextField T="string" @bind-Value="editSourceWorkOrderNo" Dense="true" Variant="Variant.Outlined" Size="Size.Small" /></td>
                        </tr>
                    </tbody>
                </MudSimpleTable>
            </MudCardContent>
        </MudCard>

        <!-- ==================== Block B: 工单字段信息 ==================== -->
        <MudCard Class="mb-4 compact-card">
            <MudCardHeader>
                <CardHeaderContent>
                    <div class="d-flex align-center">
                        <MudIcon Icon="@Icons.Material.Filled.Assignment" Class="mr-1" Color="Color.Primary" />
                        <MudText Typo="Typo.h6" Class="font-weight-bold">工单字段信息</MudText>
                        <span Class="ml-3 text-caption" Style="color:#999;">（@visibleFieldCount 字段可见/共29字段）</span>
                    </div>
                </CardHeaderContent>
                <CardHeaderActions>
                    <ColumnDisplaySelect Columns="workOrderCols" ShowCommonFields="false"
                                       OnColumnToggle="OnWorkOrderColumnToggle"
                                       OnMoveUp="OnWorkOrderColumnMove"
                                       OnMoveDown="OnWorkOrderColumnMove" />
                    <MudButton Variant="Variant.Text" Size="Size.Small" Color="Color.Warning"
                               StartIcon="@Icons.Material.Filled.Refresh" OnClick="ResetWorkOrderColumns">重置</MudButton>
                </CardHeaderActions>
            </MudCardHeader>
            <MudCardContent>
                <div style="display:flex; align-items:center; gap:8px; margin-bottom:4px; flex-wrap:wrap;">
                    <div style="display:flex; align-items:center; gap:8px; flex:1; max-width:400px;">
                        <MudTextField T="string" @bind-Value="request.WorkOrderNo"
                                      Dense="true" Variant="Variant.Outlined" Size="Size.Small" Style="flex:1;" />
                        <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small"
                                   OnClick="ConfirmWorkOrder" Disabled="@workOrderLoading">
                            @if (workOrderLoading)
                            {
                                <MudProgressCircular Size="Size.Small" Indeterminate Color="Color.Inherit" />
                            }
                            else
                            {
                                <span>确认</span>
                            }
                        </MudButton>
                    </div>
                </div>

                @if (visibleFieldCount == 0)
                {
                }
                else
                {
                    <MudSimpleTable Dense="true" Class="auto-table">
                        <thead>
                            <tr>
                                @if (GetCol("SalesOrderNo").Visible) { <th>源订单号</th> }
                                @if (GetCol("ProductionMainNo").Visible) { <th>主号</th> }
                                @if (GetCol("ProductionSubNo").Visible) { <th>次号</th> }
                                @if (GetCol("OrderItemIds").Visible) { <th>项次ID列表</th> }
                                @if (GetCol("SignDate").Visible) { <th>签订日期</th> }
                                @if (GetCol("Salesman").Visible) { <th>业务员</th> }
                                @if (GetCol("EndCustomer").Visible) { <th>最终用户</th> }
                                @if (GetCol("DeliveryDate").Visible) { <th>交货日期</th> }
                                @if (GetCol("DelayPenalty").Visible) { <th>延期罚款</th> }
                                @if (GetCol("MaterialName").Visible) { <th>物料名称</th> }
                                @if (GetCol("SettlementMethod").Visible) { <th>结算方式</th> }
                                @if (GetCol("StandardCode").Visible) { <th>产品标准编码</th> }
                                @if (GetCol("DeliveryState").Visible) { <th>交货状态</th> }
                                @if (GetCol("PlantGrade").Visible) { <th>工厂牌号</th> }
                                @if (GetCol("Specification").Visible) { <th>规格</th> }
                                @if (GetCol("OuterDiameterNegative").Visible) { <th>外径负公差</th> }
                                @if (GetCol("OuterDiameterPositive").Visible) { <th>外径正公差</th> }
                                @if (GetCol("WallThicknessNegative").Visible) { <th>壁厚负公差</th> }
                                @if (GetCol("WallThicknessPositive").Visible) { <th>壁厚正公差</th> }
                                @if (GetCol("LengthStatus").Visible) { <th>长度状态</th> }
                                @if (GetCol("MinLength").Visible) { <th>最小长度(mm)</th> }
                                @if (GetCol("MaxLength").Visible) { <th>最大长度(mm)</th> }
                                @if (GetCol("TotalQuantity").Visible) { <th>总支数</th> }
                                @if (GetCol("TotalMeters").Visible) { <th>总米数</th> }
                                @if (GetCol("TotalWeight").Visible) { <th>总重量(kg)</th> }
                                @if (GetCol("TotalItemCount").Visible) { <th>总项次数</th> }
                                @if (GetCol("ItemDetails").Visible) { <th>明细</th> }
                                @if (GetCol("TechnicalRequirements").Visible) { <th>技术要求</th> }
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                @if (GetCol("SalesOrderNo").Visible) { <td><MudTextField T="string" @bind-Value="request.SalesOrderNo" Dense="true" Variant="Variant.Outlined" Size="Size.Small" /></td> }
                                @if (GetCol("ProductionMainNo").Visible) { <td><MudTextField T="string" @bind-Value="request.ProductionMainNo" Dense="true" Variant="Variant.Outlined" Size="Size.Small" /></td> }
                                @if (GetCol("ProductionSubNo").Visible) { <td><MudTextField T="string" @bind-Value="request.ProductionSubNo" Dense="true" Variant="Variant.Outlined" Size="Size.Small" /></td> }
                                @if (GetCol("OrderItemIds").Visible) { <td><MudTextField T="string" @bind-Value="request.OrderItemIds" Dense="true" Variant="Variant.Outlined" Size="Size.Small" /></td> }
                                @if (GetCol("SignDate").Visible) { <td><MudTextField T="string" @bind-Value="editSignDateStr" Placeholder="yyyy-MM-dd" Dense="true" Variant="Variant.Outlined" Size="Size.Small" /></td> }
                                @if (GetCol("Salesman").Visible) { <td><MudTextField T="string" @bind-Value="request.Salesman" Dense="true" Variant="Variant.Outlined" Size="Size.Small" /></td> }
                                @if (GetCol("EndCustomer").Visible) { <td><MudTextField T="string" @bind-Value="request.EndCustomer" Dense="true" Variant="Variant.Outlined" Size="Size.Small" /></td> }
                                @if (GetCol("DeliveryDate").Visible) { <td><MudTextField T="string" @bind-Value="editDeliveryDateStr" Placeholder="yyyy-MM-dd" Dense="true" Variant="Variant.Outlined" Size="Size.Small" /></td> }
                                @if (GetCol("DelayPenalty").Visible) { <td><MudCheckBox @bind-Value="editDelayPenaltyValue" Color="Color.Warning" /></td> }
                                @if (GetCol("MaterialName").Visible) { <td><MudSelect T="string" @bind-Value="request.MaterialName" Dense="true" Variant="Variant.Outlined" Size="Size.Small"><MudSelectItem Value="@((string?)null)">请选择</MudSelectItem><MudSelectItem Value="@("SeamlessPipe")">无缝管</MudSelectItem><MudSelectItem Value="@("WeldedPipe")">焊管</MudSelectItem></MudSelect></td> }
                                @if (GetCol("SettlementMethod").Visible) { <td><MudSelect T="string" @bind-Value="request.SettlementMethod" Dense="true" Variant="Variant.Outlined" Size="Size.Small"><MudSelectItem Value="@((string?)null)">请选择</MudSelectItem><MudSelectItem Value="@("Weighing")">过磅</MudSelectItem><MudSelectItem Value="@("WeighingNegative")">过磅-负</MudSelectItem><MudSelectItem Value="@("Theoretical")">理算</MudSelectItem></MudSelect></td> }
                                @if (GetCol("StandardCode").Visible) { <td><MudTextField T="string" @bind-Value="request.StandardCode" Dense="true" Variant="Variant.Outlined" Size="Size.Small" /></td> }
                                @if (GetCol("DeliveryState").Visible) { <td><MudSelect T="string" @bind-Value="request.DeliveryState" Dense="true" Variant="Variant.Outlined" Size="Size.Small"><MudSelectItem Value="@((string?)null)">请选择</MudSelectItem><MudSelectItem Value="@("SolutionAnnealedAndPickled")">固溶酸洗</MudSelectItem><MudSelectItem Value="@("SolutionAnnealedAndPickledUTube")">固溶酸洗-U型管</MudSelectItem><MudSelectItem Value="@("SolutionAnnealedAndPickledExternalPolished")">固溶酸洗-外抛光</MudSelectItem><MudSelectItem Value="@("SolutionAnnealedAndPickledInternalPolished")">固溶酸洗-内抛光</MudSelectItem><MudSelectItem Value="@("SolutionAnnealedAndPickledBothPolished")">固溶酸洗-内外抛光</MudSelectItem><MudSelectItem Value="@("SolutionAnnealedAndPickledCoiled")">固溶酸洗-盘管</MudSelectItem><MudSelectItem Value="@("Bright")">光亮</MudSelectItem><MudSelectItem Value="@("BrightUTube")">光亮-U型管</MudSelectItem><MudSelectItem Value="@("BrightCoiled")">光亮-盘管</MudSelectItem><MudSelectItem Value="@("Hard")">硬态</MudSelectItem></MudSelect></td> }
                                @if (GetCol("PlantGrade").Visible) { <td><MudTextField T="string" @bind-Value="request.PlantGrade" Dense="true" Variant="Variant.Outlined" Size="Size.Small" /></td> }
                                @if (GetCol("Specification").Visible) { <td><MudTextField T="string" @bind-Value="request.Specification" Dense="true" Variant="Variant.Outlined" Size="Size.Small" /></td> }
                                @if (GetCol("OuterDiameterNegative").Visible) { <td><MudNumericField T="decimal?" @bind-Value="request.OuterDiameterNegative" Dense="true" Variant="Variant.Outlined" Size="Size.Small" Format="G29" HideSpinButtons="true" /></td> }
                                @if (GetCol("OuterDiameterPositive").Visible) { <td><MudNumericField T="decimal?" @bind-Value="request.OuterDiameterPositive" Dense="true" Variant="Variant.Outlined" Size="Size.Small" Format="G29" HideSpinButtons="true" /></td> }
                                @if (GetCol("WallThicknessNegative").Visible) { <td><MudNumericField T="decimal?" @bind-Value="request.WallThicknessNegative" Dense="true" Variant="Variant.Outlined" Size="Size.Small" Format="G29" HideSpinButtons="true" /></td> }
                                @if (GetCol("WallThicknessPositive").Visible) { <td><MudNumericField T="decimal?" @bind-Value="request.WallThicknessPositive" Dense="true" Variant="Variant.Outlined" Size="Size.Small" Format="G29" HideSpinButtons="true" /></td> }
                                @if (GetCol("LengthStatus").Visible) { <td><MudSelect T="string" @bind-Value="request.LengthStatus" Dense="true" Variant="Variant.Outlined" Size="Size.Small"><MudSelectItem Value="@((string?)null)">请选择</MudSelectItem><MudSelectItem Value="@("Fixed")">定尺</MudSelectItem><MudSelectItem Value="@("Range")">范围尺</MudSelectItem><MudSelectItem Value="@("NonFixed")">非定尺</MudSelectItem></MudSelect></td> }
                                @if (GetCol("MinLength").Visible) { <td><MudNumericField T="decimal?" @bind-Value="request.MinLength" Dense="true" Variant="Variant.Outlined" Size="Size.Small" Format="G29" HideSpinButtons="true" /></td> }
                                @if (GetCol("MaxLength").Visible) { <td><MudNumericField T="decimal?" @bind-Value="request.MaxLength" Dense="true" Variant="Variant.Outlined" Size="Size.Small" Format="G29" HideSpinButtons="true" /></td> }
                                @if (GetCol("TotalQuantity").Visible) { <td><MudNumericField T="int?" @bind-Value="request.TotalQuantity" Dense="true" Variant="Variant.Outlined" Size="Size.Small" HideSpinButtons="true" /></td> }
                                @if (GetCol("TotalMeters").Visible) { <td><MudNumericField T="decimal?" @bind-Value="request.TotalMeters" Dense="true" Variant="Variant.Outlined" Size="Size.Small" Format="G29" HideSpinButtons="true" /></td> }
                                @if (GetCol("TotalWeight").Visible) { <td><MudNumericField T="decimal?" @bind-Value="request.TotalWeight" Dense="true" Variant="Variant.Outlined" Size="Size.Small" Format="G29" HideSpinButtons="true" /></td> }
                                @if (GetCol("TotalItemCount").Visible) { <td><MudNumericField T="int?" @bind-Value="request.TotalItemCount" Dense="true" Variant="Variant.Outlined" Size="Size.Small" HideSpinButtons="true" /></td> }
