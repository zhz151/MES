                                <th style="width:140px;">生产类型</th>
                                <th style="width:140px;">制造物品</th>
                                <th style="width:140px;">制造状态</th>
                                <th style="width:90px;">制成倍数</th>
                                <th style="width:90px;">有效支数</th>
                                <th style="width:110px;">有效重量(kg)</th>
                                <th style="width:200px;">备注</th>
                                <th style="width:180px;">固溶参数</th>
