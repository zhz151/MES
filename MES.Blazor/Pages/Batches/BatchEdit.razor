                                            <MudSelectItem Value="@("在制修检")">在制修检</MudSelectItem>
                                            <MudSelectItem Value="@("冷轧")">冷轧</MudSelectItem>
                                            <MudSelectItem Value="@("冷拔")">冷拔</MudSelectItem>
