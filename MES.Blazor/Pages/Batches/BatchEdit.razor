</MudContainer>

@code {
    [Parameter] public int Id { get; set; }

    private ProductionBatchDetailDto? originalBatch;
    private bool isLoading = true;
    private bool _isSubmitting;
    private bool _isArrowNavSetup;

    // ========== 主请求对象（编辑用，预填数据） ==========
    private UpdateProductionBatchRequest request = new()
    {
        WorkOrderNo = ""
    };

    // ========== 仓库补充字段（不在UpdateProductionBatchRequest中） ==========
    private string? editInboundSource;
    private string? editInboundDateStr;
    private string? editSourceWorkOrderNo;

    // ========== 基础信息扩展字段 ==========
    private string _copyBatchNo = string.Empty;
    private bool _copyBatchLoading;

    // ========== 工单日期辅助 ==========
    private string? editSignDateStr
    {
        get => request.SignDate?.ToString("yyyy-MM-dd");
        set
        {
            if (string.IsNullOrWhiteSpace(value))
                request.SignDate = null;
            else if (DateTime.TryParse(value, out var dt))
                request.SignDate = dt;
        }
    }
    private string? editDeliveryDateStr
    {
        get => request.DeliveryDate?.ToString("yyyy-MM-dd");
        set
        {
            if (string.IsNullOrWhiteSpace(value))
                request.DeliveryDate = null;
            else if (DateTime.TryParse(value, out var dt))
                request.DeliveryDate = dt;
        }
    }
    private bool editDelayPenaltyValue
    {
        get => request.DelayPenalty ?? false;
        set => request.DelayPenalty = value;
    }

    // ========== 可用批次面板 ==========
    private List<AvailableBatchDto> availableBatches = new();
    private bool availableBatchesLoading;
    private bool showAvailablePanel;
    private string searchText = "";
    private string sortColumn = "BatchNo";
    private bool sortAscending = true;
    private bool workOrderLoading;
    private bool lastBatchLoading;

    private List<AvailableBatchDto> sortedAvailableBatches
    {
        get
        {
            var filtered = string.IsNullOrWhiteSpace(searchText)
                ? availableBatches
                : availableBatches.Where(b =>
                    (b.BatchNo?.Contains(searchText, StringComparison.OrdinalIgnoreCase) ?? false) ||
                    (b.MaterialType?.Contains(searchText, StringComparison.OrdinalIgnoreCase) ?? false) ||
                    (b.InboundSource?.Contains(searchText, StringComparison.OrdinalIgnoreCase) ?? false) ||
                    (b.SourceName?.Contains(searchText, StringComparison.OrdinalIgnoreCase) ?? false) ||
                    (b.InboundDate?.ToString("yyyy-MM-dd")?.Contains(searchText, StringComparison.OrdinalIgnoreCase) ?? false) ||
                    (b.HeatNo?.Contains(searchText, StringComparison.OrdinalIgnoreCase) ?? false) ||
                    (b.OutboundQuantity?.ToString()?.Contains(searchText, StringComparison.OrdinalIgnoreCase) ?? false) ||
                    (b.OutboundWeight?.ToString("G29")?.Contains(searchText, StringComparison.OrdinalIgnoreCase) ?? false) ||
                    (b.WorkOrderNo?.Contains(searchText, StringComparison.OrdinalIgnoreCase) ?? false) ||
                    (b.PlantGrade?.Contains(searchText, StringComparison.OrdinalIgnoreCase) ?? false) ||
                    (b.Specification?.Contains(searchText, StringComparison.OrdinalIgnoreCase) ?? false) ||
                    (b.LengthStatus?.Contains(searchText, StringComparison.OrdinalIgnoreCase) ?? false) ||
                    (b.UnitWeight?.ToString("G29")?.Contains(searchText, StringComparison.OrdinalIgnoreCase) ?? false))
                .ToList();

            var sorted = sortColumn switch
            {
                "BatchNo" => filtered.OrderBy(b => b.BatchNo),
                "MaterialType" => filtered.OrderBy(b => b.MaterialType),
                "InboundSource" => filtered.OrderBy(b => b.InboundSource),
                "SourceName" => filtered.OrderBy(b => b.SourceName),
                "InboundDate" => filtered.OrderBy(b => b.InboundDate),
                "HeatNo" => filtered.OrderBy(b => b.HeatNo),
                "OutboundQuantity" => filtered.OrderBy(b => b.OutboundQuantity),
                "OutboundWeight" => filtered.OrderBy(b => b.OutboundWeight),
                "WorkOrderNo" => filtered.OrderBy(b => b.WorkOrderNo),
                "PlantGrade" => filtered.OrderBy(b => b.PlantGrade),
                "Specification" => filtered.OrderBy(b => b.Specification),
                "LengthStatus" => filtered.OrderBy(b => b.LengthStatus),
                "UnitWeight" => filtered.OrderBy(b => b.UnitWeight),
                _ => filtered.OrderBy(b => b.BatchNo)
            };
            return sortAscending ? sorted.ToList() : sorted.Reverse().ToList();
        }
    }

    private void ToggleSort(string column)
    {
        if (sortColumn == column)
            sortAscending = !sortAscending;
        else
        {
            sortColumn = column;
            sortAscending = true;
        }
    }

    // ========== 工单字段列显示 ==========
    private List<ColumnDef> workOrderCols = new();
    private const string WoColPrefsKey = "batch_edit_workorder";

    private int visibleFieldCount => workOrderCols.Count(c => c.Visible);

    // ========== 工序组 ==========
    private List<EditProcessGroupItem> editProcessGroups = new();
    private List<ColumnDef> pgCols = new();
    private const string PgColPrefsKey = "batch_edit_pg";

    public class EditProcessGroupItem
    {
        public int Id { get; set; }
        public int SequenceNumber { get; set; }
        public string ProcessName { get; set; } = "荒管处理";
        public string? ManufacturingSpec { get; set; }
        public string? OuterDiameterTolerance { get; set; }
        public string? WallThicknessTolerance { get; set; }
        public string? ManufacturingLength { get; set; }
        public string? CuttingTreatment { get; set; }
        public int ManufacturingMultiple { get; set; } = 1;
        public string? Remark { get; set; }
        public int? ColdRollDraw { get; set; }
        public int? OilPipeCut { get; set; }
        public int? Degrease { get; set; }
        public int? Solution { get; set; }
        public int? Straighten { get; set; }
        public int? Cut { get; set; }
        public int? ThicknessMeasure { get; set; }
        public int? Pickle { get; set; }
        public int? OuterPolish { get; set; }
        public int? InnerGrinding { get; set; }
        public int? OuterSpotGrinding { get; set; }
        public int? Inspection { get; set; }
        public int? WeldingHead { get; set; }
        public int? Lubrication { get; set; }
        public int? Warehouse { get; set; }
    }

    // ========== 初始化 ==========

    protected override async Task OnInitializedAsync()
    {
        await Task.WhenAll(
            LoadDataAsync(),
            LoadAvailableBatchesAsync(),
            InitWorkOrderColumnsAsync(),
            InitProcessGroupColumnsAsync());

        // 用仓库实时数据更新来源工单号
        if (originalBatch != null && !string.IsNullOrEmpty(originalBatch.SourceBatchNo))
        {
            var realTime = availableBatches.FirstOrDefault(b => b.BatchNo == originalBatch.SourceBatchNo);
            if (realTime != null)
                editSourceWorkOrderNo = realTime.WorkOrderNo;
        }
    }

