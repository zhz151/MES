                    Degrease = cpg.Degrease,
                    EmulsionWash = cpg.EmulsionWash,
                    UltrasonicWash = cpg.UltrasonicWash,
                    ClothPolish = cpg.ClothPolish,
                    BrightAnnealing = cpg.BrightAnnealing,
                    Solution = cpg.Solution,
                    Straighten = cpg.Straighten,
                    Cut = cpg.Cut,
                    ThicknessMeasure = cpg.ThicknessMeasure,
                    Pickle = cpg.Pickle,
                    OuterPolish = cpg.OuterPolish,
                    InnerPolish = cpg.InnerPolish,
                    InnerGrinding = cpg.InnerGrinding,
                    OuterSpotGrinding = cpg.OuterSpotGrinding,
                    SandBlasting = cpg.SandBlasting,
                    ShotBlasting = cpg.ShotBlasting,
                    Inspection = cpg.Inspection,
                    WeldingHead = cpg.WeldingHead,
                    Welding = cpg.Welding,
                    Lubrication = cpg.Lubrication,
                    Packing = cpg.Packing,
                    Warehouse = cpg.Warehouse,
                    Extra1 = cpg.Extra1,
                    Extra2 = cpg.Extra2
                }).ToList();
                Snackbar.Add($"已从上一批次复制 {apiResult.Data.Count} 条工序组数据", Severity.Success);
            }
            else
            {
                Snackbar.Add("没有找到上一批次的工序组数据", Severity.Info);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"复制失败: {ex.Message}", Severity.Error);
        }
        finally
        {
            lastBatchLoading = false;
            StateHasChanged();
        }
    }

    // ========== 保存 ==========

    private async Task SaveAsync()
    {
        if (originalBatch == null) return;

        // 验证
        var errors = new List<string>();

        // ========== 统一必填（两路径共用） ==========
        var effectivePlantGrade = request.PlantGrade ?? originalBatch.PlantGrade;
        var effectiveSpec = request.Specification ?? originalBatch.Specification;
        var effectiveDelivery = request.DeliveryState?.ToString() ?? originalBatch.DeliveryState.ToString();
        var effectiveMaterialName = request.MaterialName?.ToString() ?? originalBatch.MaterialName;
        var effectiveLengthStatus = request.LengthStatus?.ToString() ?? originalBatch.LengthStatus.ToString();
        var effectiveTotalWeight = request.TotalWeight ?? originalBatch.TotalWeight;
        var effectiveProductionRatio = request.ProductionRatio ?? originalBatch.ProductionRatio;
        var effectiveTotalQuantity = request.TotalQuantity ?? originalBatch.TotalQuantity;
        var effectiveSourceGrade = request.SourcePlantGrade ?? originalBatch.SourcePlantGrade;
        var effectiveSourceSpec = request.SourceSpecification ?? originalBatch.SourceSpecification;
        var effectiveSourceLengthStatus = request.SourceLengthStatus?.ToString() ?? originalBatch.SourceLengthStatus?.ToString();
        var effectiveInputWeight = request.InputWeight ?? originalBatch.InputWeight;
        var effectiveInputQuantity = request.InputQuantity ?? originalBatch.InputQuantity;

        if (string.IsNullOrWhiteSpace(effectivePlantGrade))
            errors.Add("工厂牌号不能为空");
        if (string.IsNullOrWhiteSpace(effectiveSpec))
            errors.Add("规格不能为空");
        if (string.IsNullOrWhiteSpace(effectiveDelivery))
            errors.Add("交货状态不能为空");
        if (string.IsNullOrWhiteSpace(effectiveMaterialName))
            errors.Add("钢管制造不能为空");
        if (string.IsNullOrWhiteSpace(effectiveLengthStatus))
            errors.Add("长度状态不能为空");
        // 非工单不校验总重量/总支数
        var isNonWorkOrder = request.WorkOrderNo == WorkOrderNoSentinel.NotWorkOrder || originalBatch?.WorkOrderNo == WorkOrderNoSentinel.NotWorkOrder;
        if (!isNonWorkOrder)
        {
            if (effectiveTotalWeight <= 0)
                errors.Add("总重量必须大于0");
            if (effectiveLengthStatus == "Fixed" && effectiveTotalQuantity <= 0)
                errors.Add("总支数（定尺时必须大于0）");
        }
        // 制成倍数必须大于0
        if (effectiveProductionRatio <= 0)
            errors.Add("制成倍数必须大于0");
        if (string.IsNullOrWhiteSpace(effectiveSourceGrade))
            errors.Add("投料信息：工厂牌号不能为空");
        if (string.IsNullOrWhiteSpace(effectiveSourceSpec))
            errors.Add("投料信息：规格不能为空");
        if (effectiveInputWeight == null || effectiveInputWeight <= 0)
            errors.Add("领料重量必须大于0");
        if (effectiveInputQuantity == null || effectiveInputQuantity <= 0)
            errors.Add("领料支数必须大于0");

        // ========== 投料类型验证 ==========
        var effectiveInputType = request.InputType ?? (originalBatch != null ? originalBatch.InputType : null);
        if (effectiveInputType == null)
            errors.Add("投料类型不能为空");
        else if (effectiveInputType == BatchInputType.SplitFromNumber)
        {
            var effectiveSourceProdNo = request.SourceProductionNo ?? originalBatch?.SourceProductionNo;
            if (string.IsNullOrWhiteSpace(effectiveSourceProdNo))
                errors.Add("投料类型为「编号拆分」时，源生产编号不能为空");
        }

        // ========== 有工单路径额外验证 ==========
        var effectiveWorkOrderNo = request.WorkOrderNo ?? originalBatch!.WorkOrderNo;
        if (effectiveWorkOrderNo != WorkOrderNoSentinel.NotWorkOrder)
        {
            var effectiveSettlementMethod = request.SettlementMethod?.ToString() ?? originalBatch!.SettlementMethod.ToString();
            var effectiveStandardCode = request.StandardCode ?? originalBatch!.StandardCode;
            var effectiveTechnicalRequirements = request.TechnicalRequirements?.ToString() ?? originalBatch!.TechnicalRequirements;

            if (string.IsNullOrWhiteSpace(effectiveSettlementMethod))
                errors.Add("结算方式不能为空");
            if (string.IsNullOrWhiteSpace(effectiveStandardCode))
                errors.Add("产品标准编码不能为空");
            if (string.IsNullOrWhiteSpace(effectiveTechnicalRequirements))
                errors.Add("技术要求不能为空");
        }

        // 工厂牌号验证（高代低）
        var sourceGrade = _selectedSources.Count > 0 ? _selectedSources[0].PlantGrade : (request.SourcePlantGrade ?? originalBatch!.SourcePlantGrade);
        if (!GradeSubstitutes.IsSubstitutable(request.PlantGrade, sourceGrade))
            errors.Add("仓库工厂牌号与工单工厂牌号不一致，且不可替代（仅允许高代低）");

        // 工序组验证
        if (editProcessGroups.Any(pg => string.IsNullOrWhiteSpace(pg.ProcessName)))
            errors.Add("工序组存在工序名称为空的记录");
        ValidateEditProcessGroups(editProcessGroups, errors);

        // 最大工序序号的制造规格必须等于工单成品规格
        var effectiveWoNo3 = request.WorkOrderNo ?? originalBatch!.WorkOrderNo;
        if (effectiveWoNo3 != WorkOrderNoSentinel.NotWorkOrder && editProcessGroups.Count > 0)
        {
            var specForLastPg = request.Specification ?? originalBatch!.Specification;
            // 最大工序 = 列表最后一行（与后端保存按行序重排 seq=i+1 一致；不可用 MaxBy(SequenceNumber)，新增/调取/复制的行序号恒为 0 会误判）
            var lastPg = editProcessGroups[^1];
            if (!string.IsNullOrWhiteSpace(lastPg.ManufacturingSpec)
                && !string.Equals(lastPg.ManufacturingSpec, specForLastPg, StringComparison.OrdinalIgnoreCase))
                errors.Add($"最大工序序号的制造规格「{lastPg.ManufacturingSpec}」必须等于工单成品规格「{specForLastPg}」");
        }

        // ========== 制造状态与制造物品业务规则 ==========
        var effectiveMfgItem = request.ManufacturingItem ?? originalBatch!.ManufacturingItem;
        var effectiveMfgStatus = request.ManufacturingStatus ?? originalBatch!.ManufacturingStatus;
        var effectiveDeliveryState = request.DeliveryState ?? originalBatch!.DeliveryState;
        if (effectiveMfgItem == MaterialType.SpecialDeliveryStatus)
        {
            if (effectiveMfgStatus == effectiveDeliveryState)
                errors.Add("制造物品为「订成-非交付态」时，制造状态不能等于交货状态");
        }
        else if (effectiveMfgStatus != effectiveDeliveryState)
        {
            errors.Add("制造物品不为「订成-非交付态」时，制造状态必须等于交货状态");
        }

        if (errors.Any())
        {
            Snackbar.Add(string.Join("；", errors), Severity.Warning);
            return;
        }

        // ========== 理论单支重验证（警告，可继续保存） ==========
        var effectiveWoNo2 = request.WorkOrderNo ?? originalBatch!.WorkOrderNo;
        var effectiveLenStatus2 = request.LengthStatus?.ToString() ?? originalBatch!.LengthStatus.ToString();
        var effectiveCurValidWeight = request.CurrentValidWeight ?? originalBatch!.CurrentValidWeight ?? 0;
        if (effectiveWoNo2 != WorkOrderNoSentinel.NotWorkOrder
            && effectiveLenStatus2 == nameof(LengthStatus.Fixed)
            && effectiveCurValidWeight > 500
            && effectiveTotalWeight > 0 && effectiveTotalQuantity > 0)
        {
            var woUnitWeight = effectiveTotalWeight / (decimal)effectiveTotalQuantity;
            var theoUnitWeight = ComputeEditTheoreticalUnitWeight();

            if (theoUnitWeight.HasValue
                && (woUnitWeight > theoUnitWeight.Value * 1.10m || woUnitWeight < theoUnitWeight.Value * 0.90m))
            {
                var dialog = await DialogService.ShowAsync<ConfirmDialog>("投料单重存疑", new DialogParameters
                {
                    ["Title"] = "投料单重存疑",
                    ["ContentText"] = $"工单单支重（{woUnitWeight:G29}kg）与理论单支重（{theoUnitWeight:G29}kg）偏差超过10%，请确认投料数据是否正确。",
                    ["ConfirmText"] = "仍然保存"
                });
                var result = await dialog.Result;
                if (result.Canceled) return;
            }
        }

        _isSubmitting = true;
        try
        {
            // ===== 构建批量保存请求（单次HTTP调用） =====
            var saveRequest = new SaveBatchRequest
            {
                TagNo = request.TagNo,
                ProductionType = request.ProductionType,
                ManufacturingItem = request.ManufacturingItem,
                ManufacturingStatus = request.ManufacturingStatus,
                QualityRemark = request.QualityRemark,
                SolutionParams = request.SolutionParams,
                Remark = request.Remark,
                SourceBatchNo = request.SourceBatchNo,
                SourceMaterialType = request.SourceMaterialType,
                SourceName = request.SourceName,
                SourceHeatNo = request.SourceHeatNo,
                SourcePlantGrade = request.SourcePlantGrade,
                SourceSpecification = request.SourceSpecification,
                SourceLengthStatus = request.SourceLengthStatus,
                SourceUnitWeight = request.SourceUnitWeight,
                InputQuantity = request.InputQuantity,
                InputWeight = request.InputWeight,
                InputType = request.InputType,
                SourceRemark = request.SourceRemark,
                SourceProductionNo = request.SourceProductionNo,
                CurrentValidQty = request.CurrentValidQty,
                CurrentValidWeight = request.CurrentValidWeight,
                ProductionRatio = request.ProductionRatio,
                WorkOrderNo = request.WorkOrderNo,
                SalesOrderNo = request.SalesOrderNo,
                ProductionMainNo = request.ProductionMainNo,
                ProductionSubNo = request.ProductionSubNo,
                OrderItemIds = request.OrderItemIds,
                SignDate = request.SignDate,
                Salesman = request.Salesman,
                EndCustomer = request.EndCustomer,
                DeliveryDate = request.DeliveryDate,
                DelayPenalty = request.DelayPenalty,
                MaterialName = request.MaterialName,
                SettlementMethod = request.SettlementMethod,
                StandardCode = request.StandardCode,
                DeliveryState = request.DeliveryState,
                PlantGrade = request.PlantGrade,
                Specification = request.Specification,
                OuterDiameterNegative = request.OuterDiameterNegative,
                OuterDiameterPositive = request.OuterDiameterPositive,
                WallThicknessNegative = request.WallThicknessNegative,
                WallThicknessPositive = request.WallThicknessPositive,
                LengthStatus = request.LengthStatus,
                MinLength = request.MinLength,
                MaxLength = request.MaxLength,
                TotalQuantity = request.TotalQuantity,
                TotalMeters = request.TotalMeters,
                TotalWeight = request.TotalWeight,
                TotalItemCount = request.TotalItemCount,
                ItemDetails = request.ItemDetails,
                TechnicalRequirements = request.TechnicalRequirements,
                Status = originalBatch!.Status,
                RowVersion = originalBatch.RowVersion,
                ProcessGroups = editProcessGroups.Select(epg => new CreateProcessGroupRequest
                {
                    ProcessName = epg.ProcessName,
                    ManufacturingSpec = epg.ManufacturingSpec,
                    OuterDiameterTolerance = epg.OuterDiameterTolerance,
                    WallThicknessTolerance = epg.WallThicknessTolerance,
                    ManufacturingLength = epg.ManufacturingLength,
                    CuttingTreatment = epg.CuttingTreatment,
                    Remark = epg.Remark,
                    ColdRollDraw = epg.ColdRollDraw,
                    OilPipeCut = epg.OilPipeCut,
                    Degrease = epg.Degrease,
                    EmulsionWash = epg.EmulsionWash,
                    UltrasonicWash = epg.UltrasonicWash,
                    ClothPolish = epg.ClothPolish,
                    BrightAnnealing = epg.BrightAnnealing,
                    Solution = epg.Solution,
                    Straighten = epg.Straighten,
                    Cut = epg.Cut,
                    ThicknessMeasure = epg.ThicknessMeasure,
                    Pickle = epg.Pickle,
                    OuterPolish = epg.OuterPolish,
                    InnerPolish = epg.InnerPolish,
                    InnerGrinding = epg.InnerGrinding,
                    OuterSpotGrinding = epg.OuterSpotGrinding,
                    SandBlasting = epg.SandBlasting,
                    ShotBlasting = epg.ShotBlasting,
                    Inspection = epg.Inspection,
                    WeldingHead = epg.WeldingHead,
                    Welding = epg.Welding,
                    Lubrication = epg.Lubrication,
                    Packing = epg.Packing,
                    Warehouse = epg.Warehouse,
                    Extra1 = epg.Extra1,
                    Extra2 = epg.Extra2
                }).ToList(),
                SourceItems = _selectedSources.Select(s => new SourceBatchItemRequest
                {
                    InventoryBatchId = s.InventoryBatchId,
                    OutboundRecordId = s.OutboundRecordId,
                    InputQuantity = s.InputQuantity,
                    InputWeight = s.InputWeight
                }).ToList()
            };

            var result = await BatchService.SaveAllAsync(Id, saveRequest);
            if (!result.Success)
            {
                Snackbar.Add(result.Message ?? "保存失败", Severity.Error);
                return;
            }

            Snackbar.Add("保存成功", Severity.Success);
            Navigation.NavigateTo($"/batches/{Id}");
        }
        catch (Exception ex)
        {
            Snackbar.Add($"保存失败: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isSubmitting = false;
            StateHasChanged();
        }
    }

