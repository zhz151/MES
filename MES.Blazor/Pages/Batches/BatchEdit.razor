                                <td><MudTextField T="string" @bind-Value="request.TagNo" Dense="true" Variant="Variant.Outlined" Size="Size.Small" FullWidth="true" /></td>
                                <td>
                                    <MudSelect T="ProductionType" @bind-Value="formProductionType" Dense="true" Variant="Variant.Outlined" Size="Size.Small" FullWidth="true">
                                        @foreach (var opt in DisplayHelper.GetEnumOptions<ProductionType>())
                                        {
                                            <MudSelectItem Value="@(Enum.Parse<ProductionType>(opt.Value))">@opt.Display</MudSelectItem>
                                        }
                                    </MudSelect>
                                </td>
                                <td>
                                    <MudSelect T="MaterialType" @bind-Value="formManufacturingItem" Dense="true" Variant="Variant.Outlined" Size="Size.Small" FullWidth="true">
                                        @foreach (var val in ValidManufacturingItems)
                                        {
                                            <MudSelectItem Value="@val">@DisplayHelper.GetMaterialTypeText(val)</MudSelectItem>
                                        }
                                    </MudSelect>
                                </td>
                                <td>
                                    <MudSelect T="DeliveryState?" @bind-Value="formManufacturingStatus" Dense="true" Variant="Variant.Outlined" Size="Size.Small" FullWidth="true">
                                        <MudSelectItem Value="@((DeliveryState?)null)">请选择</MudSelectItem>
