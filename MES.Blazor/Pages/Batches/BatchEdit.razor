        request.EndCustomer = originalBatch.EndCustomer;
        request.DeliveryDate = originalBatch.DeliveryDate;
        request.DelayPenalty = originalBatch.DelayPenalty;
        request.MaterialName = string.IsNullOrEmpty(originalBatch.MaterialName) ? null : Enum.Parse<PipeManufacturingType>(originalBatch.MaterialName);
        request.SettlementMethod = originalBatch.SettlementMethod;
        request.StandardCode = originalBatch.StandardCode;
        request.DeliveryState = originalBatch.DeliveryState;
