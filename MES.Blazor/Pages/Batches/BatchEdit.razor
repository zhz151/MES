                    Warehouse = cpg.Warehouse
                }).ToList();
                Snackbar.Add($"已从上一批次复制 {apiResult.Data.Count} 条工序组数据", Severity.Success);
            }
            else
            {
                Snackbar.Add("没有找到上一批次的工序组数据", Severity.Info);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"复制失败: {ex.Message}", Severity.Error);
        }
        finally
        {
            lastBatchLoading = false;
            StateHasChanged();
        }
    }

    // ========== 保存 ==========

    private async Task SaveAsync()
    {
        if (originalBatch == null) return;

        // 验证
        var errors = new List<string>();
        if (!string.IsNullOrEmpty(editInboundDateStr) && !DateTime.TryParse(editInboundDateStr, out _))
            errors.Add("入库日期格式无效（正确格式：yyyy-MM-dd）");

        // ========== 统一必填（两路径共用） ==========
        if (string.IsNullOrWhiteSpace(request.ProductionType))
            errors.Add("生产类型不能为空");
        if (string.IsNullOrWhiteSpace(request.ManufacturingItem))
            errors.Add("制造物品不能为空");

        var effectivePlantGrade = request.PlantGrade ?? originalBatch.PlantGrade;
        var effectiveSpec = request.Specification ?? originalBatch.Specification;
        var effectiveDelivery = request.DeliveryState ?? originalBatch.DeliveryState;
        var effectiveMaterialName = request.MaterialName ?? originalBatch.MaterialName;
        var effectiveLengthStatus = request.LengthStatus ?? originalBatch.LengthStatus;
        var effectiveTotalWeight = request.TotalWeight ?? originalBatch.TotalWeight;
        var effectiveProductionRatio = request.ProductionRatio ?? originalBatch.ProductionRatio;
        var effectiveTotalQuantity = request.TotalQuantity ?? originalBatch.TotalQuantity;
        var effectiveSourceGrade = request.SourcePlantGrade ?? originalBatch.SourcePlantGrade;
        var effectiveSourceSpec = request.SourceSpecification ?? originalBatch.SourceSpecification;
        var effectiveSourceLengthStatus = request.SourceLengthStatus ?? originalBatch.SourceLengthStatus;
        var effectiveInputWeight = request.InputWeight ?? originalBatch.InputWeight;
        var effectiveInputQuantity = request.InputQuantity ?? originalBatch.InputQuantity;

        if (string.IsNullOrWhiteSpace(effectivePlantGrade))
            errors.Add("工厂牌号不能为空");
        if (string.IsNullOrWhiteSpace(effectiveSpec))
            errors.Add("规格不能为空");
        if (string.IsNullOrWhiteSpace(effectiveDelivery))
            errors.Add("交货状态不能为空");
        if (string.IsNullOrWhiteSpace(effectiveMaterialName))
            errors.Add("物料名称不能为空");
        if (string.IsNullOrWhiteSpace(effectiveLengthStatus))
            errors.Add("长度状态不能为空");
        if (effectiveTotalWeight <= 0)
            errors.Add("总重量必须大于0");
        // 制成倍数必须大于0
        if (effectiveProductionRatio <= 0)
            errors.Add("制成倍数必须大于0");
        // 定尺时总支数必须大于0
        if (effectiveLengthStatus == "Fixed" && effectiveTotalQuantity <= 0)
            errors.Add("总支数（定尺时必须大于0）");
        if (string.IsNullOrWhiteSpace(effectiveSourceGrade))
            errors.Add("仓库工厂牌号不能为空");
        if (string.IsNullOrWhiteSpace(effectiveSourceSpec))
            errors.Add("仓库规格不能为空");
        if (string.IsNullOrWhiteSpace(effectiveSourceLengthStatus))
            errors.Add("来源长度状态不能为空");
        if (effectiveInputWeight == null || effectiveInputWeight <= 0)
            errors.Add("领料重量必须大于0");
        if (effectiveInputQuantity == null || effectiveInputQuantity <= 0)
            errors.Add("领料支数必须大于0");

        // ========== 有工单路径额外验证 ==========
        var effectiveWorkOrderNo = request.WorkOrderNo ?? originalBatch.WorkOrderNo;
        if (effectiveWorkOrderNo != "非工单")
        {
            var effectiveSettlementMethod = request.SettlementMethod ?? originalBatch.SettlementMethod;
            var effectiveStandardCode = request.StandardCode ?? originalBatch.StandardCode;
            var effectiveTechnicalRequirements = request.TechnicalRequirements ?? originalBatch.TechnicalRequirements;

            if (string.IsNullOrWhiteSpace(effectiveSettlementMethod))
                errors.Add("结算方式不能为空");
            if (string.IsNullOrWhiteSpace(effectiveStandardCode))
                errors.Add("产品标准编码不能为空");
            if (string.IsNullOrWhiteSpace(effectiveTechnicalRequirements))
                errors.Add("技术要求不能为空");
        }

        // 工厂牌号验证（高代低）
        if (!GradeSubstitutes.IsSubstitutable(request.PlantGrade, request.SourcePlantGrade))
            errors.Add("仓库工厂牌号与工单工厂牌号不一致，且不可替代（仅允许高代低）");

        // 工序组验证
        if (editProcessGroups.Any(pg => string.IsNullOrWhiteSpace(pg.ProcessName)))
            errors.Add("工序组存在工序名称为空的记录");
        ValidateEditProcessGroups(editProcessGroups, errors);

        if (errors.Any())
        {
            Snackbar.Add(string.Join("；", errors), Severity.Warning);
            return;
        }

        _isSubmitting = true;
        try
        {
            // ===== 构建批量保存请求（单次HTTP调用） =====
            var saveRequest = new SaveBatchRequest
            {
                TagNo = request.TagNo,
                ProductionType = request.ProductionType,
                ManufacturingItem = request.ManufacturingItem,
                InboundSource = request.InboundSource,
                InboundDate = request.InboundDate,
                QualityRemark = request.QualityRemark,
                SolutionParams = request.SolutionParams,
                Remark = request.Remark,
                SourceBatchNo = request.SourceBatchNo,
                WarehouseId = request.WarehouseId,
                SourceMaterialType = request.SourceMaterialType,
                SourceName = request.SourceName,
                SourceHeatNo = request.SourceHeatNo,
                SourcePlantGrade = request.SourcePlantGrade,
                SourceSpecification = request.SourceSpecification,
                SourceLengthStatus = request.SourceLengthStatus,
                SourceUnitWeight = request.SourceUnitWeight,
                InputQuantity = request.InputQuantity,
                InputWeight = request.InputWeight,
                CurrentValidQty = request.CurrentValidQty,
                CurrentValidWeight = request.CurrentValidWeight,
                ProductionRatio = request.ProductionRatio,
                WorkOrderNo = request.WorkOrderNo,
                SalesOrderNo = request.SalesOrderNo,
                ProductionMainNo = request.ProductionMainNo,
                ProductionSubNo = request.ProductionSubNo,
                OrderItemIds = request.OrderItemIds,
                SignDate = request.SignDate,
                Salesman = request.Salesman,
                EndCustomer = request.EndCustomer,
                DeliveryDate = request.DeliveryDate,
                DelayPenalty = request.DelayPenalty,
                MaterialName = request.MaterialName,
                SettlementMethod = request.SettlementMethod,
                StandardCode = request.StandardCode,
                DeliveryState = request.DeliveryState,
                PlantGrade = request.PlantGrade,
                Specification = request.Specification,
                OuterDiameterNegative = request.OuterDiameterNegative,
                OuterDiameterPositive = request.OuterDiameterPositive,
                WallThicknessNegative = request.WallThicknessNegative,
                WallThicknessPositive = request.WallThicknessPositive,
                LengthStatus = request.LengthStatus,
                MinLength = request.MinLength,
                MaxLength = request.MaxLength,
                TotalQuantity = request.TotalQuantity,
                TotalMeters = request.TotalMeters,
                TotalWeight = request.TotalWeight,
                TotalItemCount = request.TotalItemCount,
                ItemDetails = request.ItemDetails,
                TechnicalRequirements = request.TechnicalRequirements,
                Status = originalBatch.Status,
                RowVersion = originalBatch.RowVersion,
                ProcessGroups = editProcessGroups.Select(epg => new CreateProcessGroupRequest
                {
                    ProcessName = epg.ProcessName,
                    ManufacturingSpec = epg.ManufacturingSpec,
                    OuterDiameterTolerance = epg.OuterDiameterTolerance,
                    WallThicknessTolerance = epg.WallThicknessTolerance,
                    ManufacturingLength = epg.ManufacturingLength,
                    CuttingTreatment = epg.CuttingTreatment,
                    ManufacturingMultiple = epg.ManufacturingMultiple,
                    Remark = epg.Remark,
                    ColdRollDraw = epg.ColdRollDraw,
                    OilPipeCut = epg.OilPipeCut,
                    Degrease = epg.Degrease,
                    Solution = epg.Solution,
                    Straighten = epg.Straighten,
                    Cut = epg.Cut,
                    ThicknessMeasure = epg.ThicknessMeasure,
                    Pickle = epg.Pickle,
                    OuterPolish = epg.OuterPolish,
                    InnerGrinding = epg.InnerGrinding,
                    OuterSpotGrinding = epg.OuterSpotGrinding,
                    Inspection = epg.Inspection,
                    WeldingHead = epg.WeldingHead,
                    Lubrication = epg.Lubrication,
                    Warehouse = epg.Warehouse
                }).ToList()
            };

            var result = await BatchService.SaveAllAsync(Id, saveRequest);
            if (!result.Success)
            {
                Snackbar.Add(result.Message ?? "保存失败", Severity.Error);
                return;
            }

            Snackbar.Add("保存成功", Severity.Success);
            Navigation.NavigateTo($"/batches/{Id}");
        }
        catch (Exception ex)
        {
            Snackbar.Add($"保存失败: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isSubmitting = false;
            StateHasChanged();
        }
    }

    // ========== 导航 ==========

    private void GoBack() => Navigation.NavigateTo("/batches");

    /// <summary>
    /// 工序组数值验证（EditProcessGroupItem 版本）：同组不重复、全局从1开始连续且不重复
    /// </summary>
    private static void ValidateEditProcessGroups(List<EditProcessGroupItem> processGroups, List<string> errors)
    {
        if (processGroups == null || processGroups.Count == 0) return;

        var allValues = new List<int>();
        var nameSpecCombos = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
        for (int i = 0; i < processGroups.Count; i++)
        {
            var pg = processGroups[i];
            var values = GetEditSectionValues(pg);
            var nonNullValues = values.Where(v => v.HasValue).Select(v => v!.Value).ToList();

            if (nonNullValues.Count == 0)
            {
                errors.Add($"工序组第{i + 1}行：至少需要1个工段有值");
                continue;
            }

            if (nonNullValues.Distinct().Count() != nonNullValues.Count)
                errors.Add($"工序组第{i + 1}行：工段数值不能重复");

            // 工序名称不为空时制造规格必填
            if (!string.IsNullOrWhiteSpace(pg.ProcessName) && string.IsNullOrWhiteSpace(pg.ManufacturingSpec))
                errors.Add($"工序组第{i + 1}行：工序名称「{pg.ProcessName}」已填写，制造规格不能为空");

            // 工序名称+制造规格在批次内唯一
            if (!string.IsNullOrWhiteSpace(pg.ProcessName))
            {
                var comboKey = $"{pg.ProcessName}|{pg.ManufacturingSpec ?? ""}";
                if (!nameSpecCombos.Add(comboKey))
                    errors.Add($"工序组第{i + 1}行：工序名称「{pg.ProcessName}」+制造规格「{pg.ManufacturingSpec ?? ""}」组合已在其他工序组中存在");
            }

            foreach (var v in nonNullValues)
            {
                if (allValues.Contains(v))
                    errors.Add($"工段数值{v}在多个工序组中重复，同一批次中每个工段值必须唯一");
                else
                    allValues.Add(v);
            }
        }

        // 全局连续性检查：从1开始连续
        if (allValues.Count > 0)
        {
            allValues.Sort();
            if (allValues[0] != 1)
                errors.Add($"工段数值必须从1开始（当前最小值为{allValues[0]}）");
            for (int i = 1; i < allValues.Count; i++)
            {
                if (allValues[i] != allValues[i - 1] + 1)
                    errors.Add($"工段数值必须连续（1,2,3...），缺失值: {allValues[i - 1] + 1}");
            }
        }
    }

    /// <summary>
    /// 获取 EditProcessGroupItem 的15个工段数值列表
    /// </summary>
    private static List<int?> GetEditSectionValues(EditProcessGroupItem pg)
    {
        return new List<int?>
        {
            pg.ColdRollDraw, pg.OilPipeCut, pg.Degrease, pg.Solution,
            pg.Straighten, pg.Cut, pg.ThicknessMeasure, pg.Pickle,
            pg.OuterPolish, pg.InnerGrinding, pg.OuterSpotGrinding,
            pg.Inspection, pg.WeldingHead, pg.Lubrication, pg.Warehouse
        };
    }
