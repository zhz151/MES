        request.OuterDiameterNegative = originalBatch.OuterDiameterNegative;
        request.OuterDiameterPositive = originalBatch.OuterDiameterPositive;
        request.WallThicknessNegative = originalBatch.WallThicknessNegative;
        request.WallThicknessPositive = originalBatch.WallThicknessPositive;
        request.LengthStatus = originalBatch.LengthStatus;
        request.MinLength = originalBatch.MinLength;
        request.MaxLength = originalBatch.MaxLength;
        request.TotalQuantity = originalBatch.TotalQuantity;
        request.TotalMeters = originalBatch.TotalMeters;
        request.TotalWeight = originalBatch.TotalWeight;
        request.TotalItemCount = originalBatch.TotalItemCount;
        request.ItemDetails = originalBatch.ItemDetails;
        request.TechnicalRequirements = string.IsNullOrEmpty(originalBatch.TechnicalRequirements) ? null : Enum.Parse<RequirementType>(originalBatch.TechnicalRequirements);
        request.CurrentValidQty = originalBatch.CurrentValidQty;
        request.CurrentValidWeight = originalBatch.CurrentValidWeight;
        request.ProductionRatio = originalBatch.ProductionRatio;

        // 工序组
        editProcessGroups = (originalBatch.ProcessGroups ?? new()).Select(pg => new EditProcessGroupItem
        {
            Id = pg.Id,
