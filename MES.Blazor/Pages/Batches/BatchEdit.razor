                    <MudButton Variant="Variant.Outlined" Color="Color.Tertiary" Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.FileCopy"
                               OnClick="CopyProcessGroupsByBatchNo"
                               Disabled="@_copyBatchLoading"
                               Style="width:130px;">
                        调取工序
                    </MudButton>
                </div>
                @if (editProcessGroups.Count == 0)
                {
                }
                else
                {
                    <div style="overflow-x: auto;">
                        <MudTable T="EditProcessGroupItem" Items="@editProcessGroups" Dense="true" Hover="true" Elevation="0" Class="auto-table compact-table">
                            <HeaderContent>
                                <MudTh Style="width:40px;">#</MudTh>
                                @if (GetPgCol("ProcessName").Visible) { <MudTh Style="width:120px;">工序名称</MudTh> }
                                @if (GetPgCol("ManufacturingSpec").Visible) { <MudTh Style="width:120px;">制造规格</MudTh> }
                                @if (GetPgCol("OuterDiameterTolerance").Visible) { <MudTh Style="width:80px;">外径公差</MudTh> }
                                @if (GetPgCol("WallThicknessTolerance").Visible) { <MudTh Style="width:80px;">壁厚公差</MudTh> }
                                @if (GetPgCol("ManufacturingLength").Visible) { <MudTh Style="width:80px;">制造长度</MudTh> }
                                @if (GetPgCol("CuttingTreatment").Visible) { <MudTh Style="width:80px;">断切处理</MudTh> }
                                @if (GetPgCol("Remark").Visible) { <MudTh Style="width:120px;">备注</MudTh> }
                                @foreach (var sc in _sectionCols)
                                {
                                    if (GetPgCol(sc.SectionKey).Visible)
                                    {
                                        <MudTh Style="width:60px;">@SectionDisplayHelper.GetSectionNameText(sc.SectionKey)</MudTh>
                                    }
                                }
                                <MudTh Style="width:45px;">操作</MudTh>
                            </HeaderContent>
                            <RowTemplate Context="pg">
                                <MudTd>@(editProcessGroups.IndexOf(pg) + 1)</MudTd>
                                @if (GetPgCol("ProcessName").Visible)
                                {
                                    <MudTd>
                                        <MudSelect T="string" @bind-Value="pg.ProcessName" Dense="true" Variant="Variant.Outlined" Size="Size.Small"
                                                   ToStringFunc="@((string v) => ProcessDisplayHelper.GetProcessNameText(v))">
                                            @foreach (var opt in _processOptions)
                                            {
                                                <MudSelectItem Value="@opt.ProcessKey">@ProcessDisplayHelper.GetProcessNameText(opt.ProcessName)</MudSelectItem>
                                            }
                                        </MudSelect>
                                    </MudTd>
                                }
                                @if (GetPgCol("ManufacturingSpec").Visible) { <MudTd><MudTextField T="string" @bind-Value="pg.ManufacturingSpec" Dense="true" Variant="Variant.Outlined" Size="Size.Small" /></MudTd> }
                                @if (GetPgCol("OuterDiameterTolerance").Visible) { <MudTd><MudTextField T="string" @bind-Value="pg.OuterDiameterTolerance" Dense="true" Variant="Variant.Outlined" Size="Size.Small" /></MudTd> }
                                @if (GetPgCol("WallThicknessTolerance").Visible) { <MudTd><MudTextField T="string" @bind-Value="pg.WallThicknessTolerance" Dense="true" Variant="Variant.Outlined" Size="Size.Small" /></MudTd> }
                                @if (GetPgCol("ManufacturingLength").Visible) { <MudTd><MudTextField T="string" @bind-Value="pg.ManufacturingLength" Dense="true" Variant="Variant.Outlined" Size="Size.Small" /></MudTd> }
                                @if (GetPgCol("CuttingTreatment").Visible) { <MudTd><MudTextField T="string" @bind-Value="pg.CuttingTreatment" Dense="true" Variant="Variant.Outlined" Size="Size.Small" /></MudTd> }
                                @if (GetPgCol("Remark").Visible) { <MudTd><MudTextField T="string" @bind-Value="pg.Remark" Dense="true" Variant="Variant.Outlined" Size="Size.Small" /></MudTd> }
                                @foreach (var sc in _sectionCols)
                                {
                                    if (GetPgCol(sc.SectionKey).Visible)
                                    {
                                        <MudTd>
                                            <MudNumericField T="int?" Value="@GetSectionValue(pg, sc.SectionKey)"
                                                             ValueChanged="@((int? v) => SetSectionValue(pg, sc.SectionKey, v))"
                                                             Dense="true" Variant="Variant.Outlined" Size="Size.Small" HideSpinButtons="true" />
                                        </MudTd>
                                    }
                                }
                                <MudTd><MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" Title="删除" OnClick="@(() => DeleteProcessGroupRow(pg))" /></MudTd>
                            </RowTemplate>
                        </MudTable>
                    </div>
                }
            </MudCardContent>
        </MudCard>
    }
</MudContainer>

@code {
    [Parameter] public int Id { get; set; }

    private ProductionBatchDetailDto? originalBatch;
    private bool isLoading = true;
    private bool _isSubmitting;
    private bool _isArrowNavSetup;

    // ========== 主请求对象（编辑用，预填数据） ==========
    private UpdateProductionBatchRequest request = new()
    {
        WorkOrderNo = ""
    };

    // ========== 仓库补充字段 ==========
    private string? editSourceWorkOrderNo;

    // ========== 合并投料 - 已选来源批次 ==========

    public class SelectedSourceItem
    {
        public int InventoryBatchId { get; set; }
        public long? OutboundRecordId { get; set; }
        public string BatchNo { get; set; } = null!;
        public MaterialType MaterialType { get; set; }
        public InboundSource? InboundSource { get; set; }
        public string? SourceName { get; set; }
        public DateTime? InboundDate { get; set; }
        public string? HeatNo { get; set; }
        public string? PlantGrade { get; set; }
        public string? Specification { get; set; }
        public string? LengthStatus { get; set; }
        public decimal? UnitWeight { get; set; }
        public string? WarehouseName { get; set; }
        public string? WorkOrderNo { get; set; }
        public int InputQuantity { get; set; }
        public decimal InputWeight { get; set; }
    }

    private List<SelectedSourceItem> _selectedSources = new();

    private int _totalInputQty => _selectedSources.Sum(s => s.InputQuantity);
    private decimal _totalInputWeight => _selectedSources.Sum(s => s.InputWeight);

    // ========== 基础信息扩展字段 ==========
    private string _copyBatchNo = string.Empty;
    private bool _copyBatchLoading;

    // ========== 工单日期辅助 ==========
    private string? editSignDateStr
    {
        get => request.SignDate?.ToString("yyyy-MM-dd");
        set
        {
            if (string.IsNullOrWhiteSpace(value))
                request.SignDate = null;
            else if (DateTime.TryParse(value, out var dt))
                request.SignDate = dt;
        }
    }
    private string? editDeliveryDateStr
    {
        get => request.DeliveryDate?.ToString("yyyy-MM-dd");
        set
        {
            if (string.IsNullOrWhiteSpace(value))
                request.DeliveryDate = null;
            else if (DateTime.TryParse(value, out var dt))
                request.DeliveryDate = dt;
        }
    }
    private bool editDelayPenaltyValue
    {
        get => request.DelayPenalty ?? false;
        set => request.DelayPenalty = value;
    }

    // ========== 枚举计算属性（直接绑定 DTO 枚举字段） ==========
    private ProductionType formProductionType
    {
        get => request.ProductionType ?? default;
        set => request.ProductionType = value;
    }
    private MaterialType formManufacturingItem
    {
        get => request.ManufacturingItem ?? default;
        set => request.ManufacturingItem = value;
    }
    private DeliveryState? formManufacturingStatus
    {
        get => request.ManufacturingStatus;
        set => request.ManufacturingStatus = value;
    }

    /// <summary>根据工单号筛选可选的制造物品类型：非工单→备料成品/余库料，其他→订单成品/订成-非交付态</summary>
    private List<MaterialType> ValidManufacturingItems
    {
        get
        {
            if (request.WorkOrderNo == WorkOrderNoSentinel.NotWorkOrder)
                return new List<MaterialType> { MaterialType.Finished, MaterialType.Surplus };
            return new List<MaterialType> { MaterialType.OrderFinished, MaterialType.SpecialDeliveryStatus };
        }
    }

    /// <summary>工单号变更后同步制造物品：当前值不在合法范围内则重置</summary>
    private void SyncManufacturingItem()
    {
        var valid = ValidManufacturingItems;
        if (!valid.Contains(request.ManufacturingItem ?? default))
        {
            request.ManufacturingItem = request.WorkOrderNo == WorkOrderNoSentinel.NotWorkOrder
                ? MaterialType.Finished
                : MaterialType.OrderFinished;
        }
    }
    private PipeManufacturingType? formMaterialName
    {
        get => request.MaterialName;
        set => request.MaterialName = value;
    }
    private SettlementMethod? formSettlementMethod
    {
        get => request.SettlementMethod;
        set => request.SettlementMethod = value;
    }
    private DeliveryState? formDeliveryState
    {
        get => request.DeliveryState;
        set => request.DeliveryState = value;
    }
    private LengthStatus? formLengthStatus
    {
        get => request.LengthStatus;
        set => request.LengthStatus = value;
    }
    private RequirementType? formTechnicalRequirements
    {
        get => request.TechnicalRequirements;
        set => request.TechnicalRequirements = value;
    }

    private MaterialType? formSourceMaterialType
    {
        get => request.SourceMaterialType;
        set => request.SourceMaterialType = value;
    }

    private BatchInputType formInputType
    {
        get => request.InputType ?? BatchInputType.SplitFromNumber;
        set => request.InputType = value;
    }

    private string formSourceLengthStatus
    {
        get => request.SourceLengthStatus?.ToString() ?? "";
        set => request.SourceLengthStatus = string.IsNullOrEmpty(value) ? null : Enum.Parse<LengthStatus>(value);
    }

    private bool _hasSourceBatchNo => !string.IsNullOrEmpty(request.SourceBatchNo);

    // ========== 可用批次（仅用于初始化同步） ==========
    private List<AvailableBatchDto> availableBatches = new();
    private bool workOrderLoading;
    private bool lastBatchLoading;

    // ========== 工单字段列显示 ==========
    private List<ColumnDef> workOrderCols = new();
    private const string WoColPrefsKey = "batch_edit_workorder";

    private int visibleFieldCount => workOrderCols.Count(c => c.Visible);

    // ========== 工序组 ==========
    private List<EditProcessGroupItem> editProcessGroups = new();
    private List<ColumnDef> pgCols = new();
    private const string PgColPrefsKey = "batch_edit_pg";

    public class EditProcessGroupItem
    {
        public int Id { get; set; }
        public int SequenceNumber { get; set; }
        public string ProcessName { get; set; } = ProcessKeys.RoughTubeProcessing;
        public string? ManufacturingSpec { get; set; }
        public string? OuterDiameterTolerance { get; set; }
        public string? WallThicknessTolerance { get; set; }
        public string? ManufacturingLength { get; set; }
        public string? CuttingTreatment { get; set; }
        public string? Remark { get; set; }
        public int? ColdRollDraw { get; set; }
        public int? OilPipeCut { get; set; }
        public int? Degrease { get; set; }
        public int? EmulsionWash { get; set; }
        public int? UltrasonicWash { get; set; }
        public int? ClothPolish { get; set; }
        public int? BrightAnnealing { get; set; }
        public int? Solution { get; set; }
        public int? Straighten { get; set; }
        public int? Cut { get; set; }
        public int? ThicknessMeasure { get; set; }
        public int? Pickle { get; set; }
        public int? OuterPolish { get; set; }
        public int? InnerPolish { get; set; }
        public int? InnerGrinding { get; set; }
        public int? OuterSpotGrinding { get; set; }
        public int? SandBlasting { get; set; }
        public int? ShotBlasting { get; set; }
        public int? Inspection { get; set; }
        public int? WeldingHead { get; set; }
        public int? Welding { get; set; }
        public int? Lubrication { get; set; }
        public int? Packing { get; set; }
        public int? Warehouse { get; set; }
        public int? Extra1 { get; set; }
        public int? Extra2 { get; set; }
    }

    // ========== 初始化 ==========

    protected override async Task OnInitializedAsync()
    {
        await Task.WhenAll(
            LoadDataAsync(),
            LoadAvailableBatchesAsync(),
            InitWorkOrderColumnsAsync(),
            InitProcessGroupColumnsAsync());

        // 用仓库实时数据更新来源工单号
        if (originalBatch != null && !string.IsNullOrEmpty(originalBatch.SourceBatchNo))
        {
            var realTime = availableBatches.FirstOrDefault(b => b.BatchNo == originalBatch.SourceBatchNo);
            if (realTime != null)
                editSourceWorkOrderNo = realTime.WorkOrderNo;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_isArrowNavSetup)
        {
            _isArrowNavSetup = true;
            if (!await JS.InvokeAsync<bool>("enableTableArrowNav", "#batch-edit-form"))
                _isArrowNavSetup = false;
        }
    }

    private async Task LoadDataAsync()
    {
        if (Id <= 0)
        {
            Snackbar.Add("无效的批次ID", Severity.Error);
            isLoading = false;
            return;
        }

        isLoading = true;
        StateHasChanged();

        try
        {
            var result = await BatchService.GetByIdAsync(Id);
            if (result.Success && result.Data != null)
            {
                originalBatch = result.Data;
                PrepopulateFromBatch();
            }
            else
            {
                Snackbar.Add(result.Message ?? "加载批次详情失败", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"加载失败: {ex.Message}", Severity.Error);
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private void PrepopulateFromBatch()
    {
        if (originalBatch == null) return;

        // 基础信息
        request.TagNo = originalBatch.TagNo;
        request.ProductionType = originalBatch.ProductionType;
        request.ManufacturingItem = originalBatch.ManufacturingItem;
        request.ManufacturingStatus = originalBatch.ManufacturingStatus;
