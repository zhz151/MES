    /// <summary>
    /// 工序组数值验证（EditProcessGroupItem 版本）：同组不重复、全局从1开始连续且不重复
    /// </summary>
    private static void ValidateEditProcessGroups(List<EditProcessGroupItem> processGroups, List<string> errors)
    {
        if (processGroups == null || processGroups.Count == 0) return;

        var allValues = new List<int>();
        var nameSpecCombos = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
        for (int i = 0; i < processGroups.Count; i++)
        {
            var pg = processGroups[i];
            var values = GetEditSectionValues(pg);
            var nonNullValues = values.Where(v => v.HasValue).Select(v => v!.Value).ToList();

            if (nonNullValues.Count == 0)
            {
                errors.Add($"工序组第{i + 1}行：至少需要1个工段有值");
                continue;
            }

            if (nonNullValues.Distinct().Count() != nonNullValues.Count)
                errors.Add($"工序组第{i + 1}行：工段数值不能重复");

            // 工序名称不为空时制造规格必填
            if (!string.IsNullOrWhiteSpace(pg.ProcessName) && string.IsNullOrWhiteSpace(pg.ManufacturingSpec))
                errors.Add($"工序组第{i + 1}行：工序名称「{ProcessDisplayHelper.GetProcessNameText(pg.ProcessName)}」已填写，制造规格不能为空");

            // 工序名称+制造规格在批次内唯一
            if (!string.IsNullOrWhiteSpace(pg.ProcessName))
            {
                var comboKey = $"{pg.ProcessName}|{pg.ManufacturingSpec ?? ""}";
                if (!nameSpecCombos.Add(comboKey))
                    errors.Add($"工序组第{i + 1}行：工序名称「{ProcessDisplayHelper.GetProcessNameText(pg.ProcessName)}」+制造规格「{pg.ManufacturingSpec ?? ""}」组合已在其他工序组中存在");
            }

            foreach (var v in nonNullValues)
            {
                if (allValues.Contains(v))
                    errors.Add($"工段数值{v}在多个工序组中重复，同一批次中每个工段值必须唯一");
                else
                    allValues.Add(v);
            }
        }

        // 全局连续性检查：从1开始连续
        if (allValues.Count > 0)
        {
            allValues.Sort();
            if (allValues[0] != 1)
                errors.Add($"工段数值必须从1开始（当前最小值为{allValues[0]}）");
            for (int i = 1; i < allValues.Count; i++)
            {
                if (allValues[i] != allValues[i - 1] + 1)
                    errors.Add($"工段数值必须连续（1,2,3...），缺失值: {allValues[i - 1] + 1}");
            }
        }
    }

    /// <summary>
    /// 获取 EditProcessGroupItem 的26个工段数值列表
    /// </summary>
    private static List<int?> GetEditSectionValues(EditProcessGroupItem pg)
    {
        return new List<int?>
        {
            pg.ColdRollDraw, pg.OilPipeCut, pg.Degrease, pg.EmulsionWash,
            pg.UltrasonicWash, pg.ClothPolish, pg.BrightAnnealing, pg.Solution,
            pg.Straighten, pg.Cut, pg.ThicknessMeasure, pg.Pickle,
            pg.OuterPolish, pg.InnerPolish, pg.InnerGrinding, pg.OuterSpotGrinding,
            pg.SandBlasting, pg.ShotBlasting, pg.Inspection, pg.WeldingHead,
            pg.Welding, pg.Lubrication, pg.Packing, pg.Warehouse,
            pg.Extra1, pg.Extra2
        };
    }

    /// <summary>
    /// 与服务端 ComputeTheoreticalOutput 一致：基于当前表单数据重算理论单支重
    /// 理论成品支 = 有效支数 × 制成倍数
    /// 理论成品重 = 有效重量 × MAX(0, 1 - 有效工序组数 × 0.025)
    /// 理论单支重 = 理论成品重 / 理论成品支（1位小数）
    /// </summary>
    private decimal? ComputeEditTheoreticalUnitWeight()
    {
        var qty = request.CurrentValidQty ?? originalBatch?.CurrentValidQty;
        var weight = request.CurrentValidWeight ?? originalBatch?.CurrentValidWeight;
        var ratio = request.ProductionRatio ?? originalBatch?.ProductionRatio ?? 0;

        if (ratio <= 0 || !qty.HasValue || qty.Value <= 0) return null;
        var outputQty = qty.Value * ratio;

        if (!weight.HasValue || weight.Value <= 0) return null;

        var effectiveGroupCount = editProcessGroups
            .Count(pg => pg.ProcessName != ProcessKeys.InProcessRepair
                && pg.ProcessName != ProcessKeys.AdditionalFinalInspection
                && HasNonEmptyEditSection(pg));

        var discount = Math.Max(0, 1.0m - effectiveGroupCount * 0.025m);
        var outputWeight = (int?)(weight.Value * discount);

        if (!outputWeight.HasValue || outputWeight.Value <= 0) return null;
        return Math.Round((decimal)outputWeight.Value / outputQty, 1);
    }

    private static bool HasNonEmptyEditSection(EditProcessGroupItem pg)
    {
        return pg.ColdRollDraw.HasValue || pg.OilPipeCut.HasValue
            || pg.Degrease.HasValue || pg.EmulsionWash.HasValue
            || pg.UltrasonicWash.HasValue || pg.ClothPolish.HasValue
            || pg.BrightAnnealing.HasValue || pg.Solution.HasValue
            || pg.Straighten.HasValue || pg.Cut.HasValue
            || pg.ThicknessMeasure.HasValue || pg.Pickle.HasValue
            || pg.OuterPolish.HasValue || pg.InnerPolish.HasValue
            || pg.InnerGrinding.HasValue || pg.OuterSpotGrinding.HasValue
            || pg.SandBlasting.HasValue || pg.ShotBlasting.HasValue
            || pg.Inspection.HasValue || pg.WeldingHead.HasValue
            || pg.Welding.HasValue || pg.Lubrication.HasValue
            || pg.Packing.HasValue || pg.Warehouse.HasValue
            || pg.Extra1.HasValue || pg.Extra2.HasValue;
    }
