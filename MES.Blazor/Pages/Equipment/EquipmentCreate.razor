@page "/equipment/create"
@using MES.Blazor.Services
@using MES.Blazor.Helpers
@using MES.Core.DTOs.Equipment
@using MES.Core.Enums
@using Microsoft.AspNetCore.Authorization
@inject EquipmentService EquipmentService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject IJSRuntime JS
@inject ColumnPrefsService ColumnPrefs
@attribute [Authorize(Roles = Roles.Policies.EquipmentRead)]

<MudContainer MaxWidth="MaxWidth.False" Class="mt-4">
    <style>
        .edit-table td.mud-table-cell,
        .edit-table th.mud-table-cell {
            padding: 1px 4px !important;
        }
        .edit-table .mud-input-input-control {
            margin-top: 0;
        }
        .edit-table .mud-input {
            font-size: 13px;
            width: 100%;
            min-width: 0;
        }
        .edit-table th.mud-table-cell {
            white-space: nowrap;
        }
        .table-scroll {
            max-height: calc(100vh - 280px);
            overflow-y: auto;
            overflow-x: auto;
        }
    </style>

    <MudCard>
        <MudCardHeader>
            <CardHeaderContent>
                <MudText Typo="Typo.h5" Class="font-weight-bold">
                    <MudIcon Icon="@Icons.Material.Filled.AddCircleOutline" Class="mr-2" Color="Color.Primary" />
                    新建设备
                </MudText>
            </CardHeaderContent>
            <CardHeaderActions>
                <MudButton Variant="Variant.Text" Color="Color.Default" OnClick="GoBack">返回</MudButton>
            </CardHeaderActions>
        </MudCardHeader>

        <MudCardContent>
            <div id="equipment-create-table">
                @if (_rows.Any())
                {
                    <div class="d-flex align-center mb-2">
                        <ColumnDisplaySelect Columns="_allColumns"
                                             OnColumnToggle="OnColumnToggle"
                                             OnMoveUp="MoveColumnUp"
                                             OnMoveDown="MoveColumnDown" />
                        <MudButton Variant="Variant.Text" Size="Size.Small"
                                   Color="Color.Default"
                                   StartIcon="@Icons.Material.Filled.RestartAlt"
                                   OnClick="ResetColumnDisplay" Class="ml-2">
                            重置
                        </MudButton>
                        <MudSpacer />
                        <MudText Typo="Typo.body2">共 @_rows.Count 行</MudText>
                        <MudButton Variant="Variant.Text" Size="Size.Small"
                                   Color="Color.Default"
                                   StartIcon="@Icons.Material.Filled.AddCircleOutline"
                                   OnClick="AddRow" Class="ml-2">
                            添加行
                        </MudButton>
                    </div>
                    <div class="table-scroll">
                        <MudTable Items="@_rows" Dense="true" Hover="true" Elevation="0" Striped="true"
                                  Class="edit-table auto-table" SortMode="SortMode.None" FixedHeader="true">
                            <HeaderContent>
                                @foreach (var col in _visibleColumns)
                                {
                                    <MudTh>
                                        @col.Label
                                        @if (col.IsRequired)
                                        {
                                            <span class="required-star">*</span>
                                        }
                                    </MudTh>
                                }
                                <MudTh Style="width:60px;">操作</MudTh>
                            </HeaderContent>
                            <RowTemplate Context="r">
                                @foreach (var col in _visibleColumns)
                                {
                                    <MudTd>@RenderCell(r, col)</MudTd>
                                }
                                <MudTd>
                                    <MudIconButton Icon="@Icons.Material.Filled.RemoveCircleOutline"
                                                   Color="Color.Error" Size="Size.Small"
                                                   Title="删除"
                                                   OnClick="() => RemoveRow(r)"
                                                   Disabled="@(_rows.Count <= 1)" />
                                </MudTd>
                            </RowTemplate>
                            <FooterContent>
                                <MudTd colspan="@(_visibleColumns.Count + 1)">
                                    <MudIconButton Icon="@Icons.Material.Filled.AddCircleOutline"
                                                   Color="Color.Primary" Size="Size.Small"
                                                   OnClick="AddRow" />
                                </MudTd>
                            </FooterContent>
                        </MudTable>
                    </div>
                }
            </div>

            @if (!string.IsNullOrEmpty(_errorMessage))
            {
                <MudText Typo="Typo.body2" Color="Color.Error" Class="mt-4">@_errorMessage</MudText>
            }

            @if (_rows.Any())
            {
                <MudGrid Class="mt-4">
                    <MudItem xs="12" Class="d-flex justify-end">
                        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.CloudUpload"
                                   OnClick="Submit" Loading="@_isSubmitting"
                                   Size="Size.Large">
                            确认提交 (@_rows.Count 条)
                        </MudButton>
                    </MudItem>
                </MudGrid>
            }
        </MudCardContent>
    </MudCard>
</MudContainer>

@code {
    private List<EditRow> _rows = new();
    private bool _isSubmitting;
    private bool _isArrowNavSetup;
    private string _errorMessage = string.Empty;

    // ========== 列定义 ==========

    private List<ColumnDef> _allColumns = new();
    private List<ColumnDef> _visibleColumns =>
        _allColumns.Where(c => c.IsApplicable && c.Visible).ToList();

    private static List<ColumnDef> GetAllColumnDefs() => new()
    {
        new() { Key = "EquipmentCode",      Label = "设备编码", IsRequired = true },
        new() { Key = "EquipmentName",      Label = "设备名称", IsRequired = true },
        new() { Key = "ModelNumber",        Label = "型号规格" },
        new() { Key = "TechnicalParams",    Label = "技术参数" },
        new() { Key = "Manufacturer",       Label = "制造商" },
        new() { Key = "InstallationDate",   Label = "安装日期" },
        new() { Key = "Location",           Label = "所在区域" },
        new() { Key = "RelatedSection",     Label = "关联工段" },
        new() { Key = "LifecycleStatus",    Label = "生命周期", IsRequired = true },
        new() { Key = "UsageType",          Label = "作用类型" },
        new() { Key = "NeedInspection",     Label = "需点检" },
        new() { Key = "InspectionPerson",   Label = "点检负责人" },
        new() { Key = "InspectionCycleDays",Label = "点检周期" },
        new() { Key = "CurrentInspectionStartDate", Label = "本次点检日起始" },
        new() { Key = "NeedMaintenance",    Label = "需保养" },
        new() { Key = "MaintPerson",        Label = "保养负责人" },
        new() { Key = "MaintCycleDays",     Label = "保养周期" },
        new() { Key = "CurrentMaintStartDate",      Label = "本次保养日起始" },
        new() { Key = "Remark",             Label = "备注" },
    };

    private async Task OnColumnToggle(ColumnDef col)
    {
        await SaveColumnPrefs();
    }

    private async Task SaveColumnPrefs()
    {
        await ColumnPrefs.SaveAsync("equipment-create", null, _allColumns);
    }

    private async Task ResetColumnDisplay()
    {
        _allColumns = GetAllColumnDefs();
        await SaveColumnPrefs();
    }

    private async Task MoveColumnUp(ColumnDef col)
    {
        await SaveColumnPrefs();
    }

    private async Task MoveColumnDown(ColumnDef col)
    {
        await SaveColumnPrefs();
    }

    // ========== 内部模型 ==========

    private class EditRow
    {
        public string EquipmentCode { get; set; } = string.Empty;
        public string EquipmentName { get; set; } = string.Empty;
        public string? ModelNumber { get; set; }
        public string? TechnicalParams { get; set; }
        public string? Manufacturer { get; set; }
        public string InstallationDate { get; set; } = string.Empty;
        public string? Location { get; set; }
        public string? RelatedSection { get; set; }
        public LifecycleStatus LifecycleStatus { get; set; } = LifecycleStatus.Active;
        public UsageType UsageType { get; set; } = UsageType.Primary;
        public bool NeedInspection { get; set; }
        public string? InspectionPerson { get; set; }
        public int? InspectionCycleDays { get; set; } = 7;
        public string CurrentInspectionStartDate { get; set; } = string.Empty;
        public bool NeedMaintenance { get; set; }
        public string? MaintPerson { get; set; }
        public int? MaintCycleDays { get; set; } = 30;
        public string CurrentMaintStartDate { get; set; } = string.Empty;
        public string? Remark { get; set; }
    }

    protected override async Task OnInitializedAsync()
    {
        _allColumns = GetAllColumnDefs();
        var saved = await ColumnPrefs.LoadAsync("equipment-create", null);
        if (saved.Count > 0)
        {
            foreach (var s in saved)
            {
                var match = _allColumns.FirstOrDefault(c => c.Key == s.Key);
                if (match != null)
                    match.Visible = s.Visible;
            }
            var reordered = new List<ColumnDef>();
            foreach (var s in saved)
            {
                var match = _allColumns.FirstOrDefault(c => c.Key == s.Key);
                if (match != null && !reordered.Contains(match))
                    reordered.Add(match);
            }
            foreach (var c in _allColumns)
            {
                if (!reordered.Contains(c))
                    reordered.Add(c);
            }
            _allColumns = reordered;
        }

        if (!_rows.Any())
            _rows.Add(new EditRow());
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_isArrowNavSetup)
        {
            _isArrowNavSetup = true;
            if (!await JS.InvokeAsync<bool>("enableTableArrowNav", "#equipment-create-table"))
                _isArrowNavSetup = false;
        }
    }

    private void AddRow()
    {
        _rows.Add(new EditRow());
    }

    private void RemoveRow(EditRow row)
    {
        if (_rows.Count <= 1) return;
        _rows.Remove(row);
    }

    private async Task Submit()
    {
        _errorMessage = string.Empty;

        var errors = new List<string>();
        for (int i = 0; i < _rows.Count; i++)
        {
            var r = _rows[i];
            var seq = i + 1;
            if (string.IsNullOrWhiteSpace(r.EquipmentCode)) errors.Add($"第{seq}行：设备编码不能为空");
            if (string.IsNullOrWhiteSpace(r.EquipmentName)) errors.Add($"第{seq}行：设备名称不能为空");
            if (!string.IsNullOrWhiteSpace(r.InstallationDate) && !DateTime.TryParse(r.InstallationDate, out _))
                errors.Add($"第{seq}行：安装日期格式无效（请用 yyyy-MM-dd）");
            if (!string.IsNullOrWhiteSpace(r.CurrentInspectionStartDate) && !DateTime.TryParse(r.CurrentInspectionStartDate, out _))
                errors.Add($"第{seq}行：下次点检日格式无效（请用 yyyy-MM-dd）");
            if (!string.IsNullOrWhiteSpace(r.CurrentMaintStartDate) && !DateTime.TryParse(r.CurrentMaintStartDate, out _))
                errors.Add($"第{seq}行：下次保养日格式无效（请用 yyyy-MM-dd）");
        }

        if (errors.Any())
        {
            Snackbar.Add(string.Join("；", errors), Severity.Error);
            return;
        }

        _isSubmitting = true;
        StateHasChanged();

        var successCount = 0;
        var failMessages = new List<string>();

        for (int i = 0; i < _rows.Count; i++)
        {
            var r = _rows[i];
            var request = new CreateEquipmentRequest
            {
                EquipmentCode = r.EquipmentCode,
                EquipmentName = r.EquipmentName,
                ModelNumber = r.ModelNumber,
                TechnicalParams = r.TechnicalParams,
                Manufacturer = r.Manufacturer,
                InstallationDate = string.IsNullOrWhiteSpace(r.InstallationDate) ? null : DateTime.Parse(r.InstallationDate),
                Remark = r.Remark,
                Location = r.Location!,
                RelatedSection = r.RelatedSection,
                NeedInspection = r.NeedInspection,
                InspectionPerson = r.InspectionPerson,
                InspectionCycleDays = r.InspectionCycleDays ?? 7,
                CurrentInspectionStartDate = string.IsNullOrWhiteSpace(r.CurrentInspectionStartDate) ? null : DateTime.Parse(r.CurrentInspectionStartDate),
                NeedMaintenance = r.NeedMaintenance,
                MaintPerson = r.MaintPerson,
                MaintCycleDays = r.MaintCycleDays ?? 30,
                CurrentMaintStartDate = string.IsNullOrWhiteSpace(r.CurrentMaintStartDate) ? null : DateTime.Parse(r.CurrentMaintStartDate),
                LifecycleStatus = r.LifecycleStatus,
                UsageType = r.UsageType
            };

            try
            {
                var result = await EquipmentService.CreateAsync(request);
                if (result.Success)
                    successCount++;
                else
                    failMessages.Add($"第{i + 1}行: {result.Message}");
            }
            catch (Exception ex)
            {
                failMessages.Add($"第{i + 1}行: {ex.Message}");
            }
        }

        _isSubmitting = false;
        StateHasChanged();

        if (failMessages.Count == 0)
        {
            Snackbar.Add($"成功创建 {successCount} 条记录", Severity.Success);
            Navigation.NavigateTo("/equipment");
        }
        else
        {
            _errorMessage = $"成功 {successCount} 条，失败 {failMessages.Count} 条：{string.Join("；", failMessages)}";
        }
    }

    private void GoBack()
    {
        Navigation.NavigateTo("/equipment");
    }

    // ========== 单元格渲染 ==========

    private RenderFragment RenderCell(EditRow r, ColumnDef col) => builder =>
    {
        switch (col.Key)
        {
            case "EquipmentCode":
                builder.OpenComponent<MudTextField<string>>(0);
                builder.AddAttribute(1, "Dense", true);
                builder.AddAttribute(2, "Variant", Variant.Outlined);
                builder.AddAttribute(3, "Size", Size.Small);
                builder.AddAttribute(4, "Value", r.EquipmentCode);
                builder.AddAttribute(5, "ValueChanged", EventCallback.Factory.Create<string>(this, v => r.EquipmentCode = v));
                builder.CloseComponent();
                break;
            case "EquipmentName":
                builder.OpenComponent<MudTextField<string>>(0);
                builder.AddAttribute(1, "Dense", true);
                builder.AddAttribute(2, "Variant", Variant.Outlined);
                builder.AddAttribute(3, "Size", Size.Small);
                builder.AddAttribute(4, "Value", r.EquipmentName);
                builder.AddAttribute(5, "ValueChanged", EventCallback.Factory.Create<string>(this, v => r.EquipmentName = v));
                builder.CloseComponent();
                break;
            case "ModelNumber":
                builder.OpenComponent<MudTextField<string>>(0);
                builder.AddAttribute(1, "Dense", true);
                builder.AddAttribute(2, "Variant", Variant.Outlined);
                builder.AddAttribute(3, "Size", Size.Small);
                builder.AddAttribute(4, "Value", r.ModelNumber);
                builder.AddAttribute(5, "ValueChanged", EventCallback.Factory.Create<string?>(this, v => r.ModelNumber = v));
                builder.CloseComponent();
                break;
            case "TechnicalParams":
                builder.OpenComponent<MudTextField<string>>(0);
                builder.AddAttribute(1, "Dense", true);
                builder.AddAttribute(2, "Variant", Variant.Outlined);
                builder.AddAttribute(3, "Size", Size.Small);
                builder.AddAttribute(4, "Value", r.TechnicalParams);
                builder.AddAttribute(5, "ValueChanged", EventCallback.Factory.Create<string?>(this, v => r.TechnicalParams = v));
                builder.CloseComponent();
                break;
            case "Manufacturer":
                builder.OpenComponent<MudTextField<string>>(0);
                builder.AddAttribute(1, "Dense", true);
                builder.AddAttribute(2, "Variant", Variant.Outlined);
                builder.AddAttribute(3, "Size", Size.Small);
                builder.AddAttribute(4, "Value", r.Manufacturer);
                builder.AddAttribute(5, "ValueChanged", EventCallback.Factory.Create<string?>(this, v => r.Manufacturer = v));
                builder.CloseComponent();
                break;
            case "InstallationDate":
                builder.OpenComponent<MudTextField<string>>(0);
                builder.AddAttribute(1, "Dense", true);
                builder.AddAttribute(2, "Variant", Variant.Outlined);
                builder.AddAttribute(3, "Size", Size.Small);
                builder.AddAttribute(4, "Value", r.InstallationDate);
                builder.AddAttribute(5, "ValueChanged", EventCallback.Factory.Create<string>(this, v => r.InstallationDate = v));
                builder.AddAttribute(6, "Placeholder", "yyyy-MM-dd");
                builder.CloseComponent();
                break;
            case "Location":
                builder.OpenComponent<MudTextField<string>>(0);
                builder.AddAttribute(1, "Dense", true);
                builder.AddAttribute(2, "Variant", Variant.Outlined);
                builder.AddAttribute(3, "Size", Size.Small);
                builder.AddAttribute(4, "Value", r.Location);
                builder.AddAttribute(5, "ValueChanged", EventCallback.Factory.Create<string?>(this, v => r.Location = v));
                builder.CloseComponent();
                break;
            case "RelatedSection":
                builder.OpenComponent<MudTextField<string>>(0);
                builder.AddAttribute(1, "Dense", true);
                builder.AddAttribute(2, "Variant", Variant.Outlined);
                builder.AddAttribute(3, "Size", Size.Small);
                builder.AddAttribute(4, "Value", r.RelatedSection);
                builder.AddAttribute(5, "ValueChanged", EventCallback.Factory.Create<string?>(this, v => r.RelatedSection = v));
                builder.CloseComponent();
                break;
            case "LifecycleStatus":
                builder.OpenComponent<MudSelect<LifecycleStatus>>(0);
                builder.AddAttribute(1, "Dense", true);
                builder.AddAttribute(2, "Variant", Variant.Outlined);
                builder.AddAttribute(3, "Size", Size.Small);
                builder.AddAttribute(4, "Value", r.LifecycleStatus);
                builder.AddAttribute(5, "ValueChanged", EventCallback.Factory.Create<LifecycleStatus>(this, v => r.LifecycleStatus = v));
                builder.AddAttribute(6, "ChildContent", (RenderFragment)(cb =>
                {
                    foreach (var opt in DisplayHelper.GetEnumOptions<LifecycleStatus>())
                    {
                        cb.OpenComponent<MudSelectItem<LifecycleStatus>>(0);
                        cb.AddAttribute(1, "Value", Enum.Parse<LifecycleStatus>(opt.Value));
                        cb.AddAttribute(2, "ChildContent", (RenderFragment)(b => b.AddContent(0, opt.Display)));
                        cb.CloseComponent();
                    }
                }));
                builder.CloseComponent();
                break;
            case "UsageType":
                builder.OpenComponent<MudSelect<UsageType>>(0);
                builder.AddAttribute(1, "Dense", true);
                builder.AddAttribute(2, "Variant", Variant.Outlined);
                builder.AddAttribute(3, "Size", Size.Small);
                builder.AddAttribute(4, "Value", r.UsageType);
                builder.AddAttribute(5, "ValueChanged", EventCallback.Factory.Create<UsageType>(this, v => r.UsageType = v));
                builder.AddAttribute(6, "ChildContent", (RenderFragment)(cb =>
                {
                    foreach (var opt in DisplayHelper.GetEnumOptions<UsageType>())
                    {
                        cb.OpenComponent<MudSelectItem<UsageType>>(0);
                        cb.AddAttribute(1, "Value", Enum.Parse<UsageType>(opt.Value));
                        cb.AddAttribute(2, "ChildContent", (RenderFragment)(b => b.AddContent(0, opt.Display)));
                        cb.CloseComponent();
                    }
                }));
                builder.CloseComponent();
                break;
            case "NeedInspection":
                builder.OpenComponent<MudCheckBox<bool>>(0);
                builder.AddAttribute(1, "Dense", true);
                builder.AddAttribute(2, "Value", r.NeedInspection);
                builder.AddAttribute(3, "ValueChanged", EventCallback.Factory.Create<bool>(this, v => r.NeedInspection = v));
                builder.CloseComponent();
                break;
            case "InspectionPerson":
                builder.OpenComponent<MudTextField<string>>(0);
                builder.AddAttribute(1, "Dense", true);
                builder.AddAttribute(2, "Variant", Variant.Outlined);
                builder.AddAttribute(3, "Size", Size.Small);
                builder.AddAttribute(4, "Value", r.InspectionPerson);
                builder.AddAttribute(5, "ValueChanged", EventCallback.Factory.Create<string?>(this, v => r.InspectionPerson = v));
                builder.CloseComponent();
                break;
            case "InspectionCycleDays":
                builder.OpenComponent<MudNumericField<int?>>(0);
                builder.AddAttribute(1, "Dense", true);
                builder.AddAttribute(2, "Variant", Variant.Outlined);
                builder.AddAttribute(3, "Size", Size.Small);
                builder.AddAttribute(4, "HideSpinButtons", true);
                builder.AddAttribute(5, "Value", r.InspectionCycleDays);
                builder.AddAttribute(6, "ValueChanged", EventCallback.Factory.Create<int?>(this, v => r.InspectionCycleDays = v));
                builder.CloseComponent();
                break;
            case "CurrentInspectionStartDate":
                builder.OpenComponent<MudTextField<string>>(0);
                builder.AddAttribute(1, "Dense", true);
                builder.AddAttribute(2, "Variant", Variant.Outlined);
                builder.AddAttribute(3, "Size", Size.Small);
                builder.AddAttribute(4, "Value", r.CurrentInspectionStartDate);
                builder.AddAttribute(5, "ValueChanged", EventCallback.Factory.Create<string>(this, v => r.CurrentInspectionStartDate = v));
                builder.AddAttribute(6, "Placeholder", "yyyy-MM-dd");
                builder.CloseComponent();
                break;
            case "NeedMaintenance":
                builder.OpenComponent<MudCheckBox<bool>>(0);
                builder.AddAttribute(1, "Dense", true);
                builder.AddAttribute(2, "Value", r.NeedMaintenance);
                builder.AddAttribute(3, "ValueChanged", EventCallback.Factory.Create<bool>(this, v => r.NeedMaintenance = v));
                builder.CloseComponent();
                break;
            case "MaintPerson":
                builder.OpenComponent<MudTextField<string>>(0);
                builder.AddAttribute(1, "Dense", true);
                builder.AddAttribute(2, "Variant", Variant.Outlined);
                builder.AddAttribute(3, "Size", Size.Small);
                builder.AddAttribute(4, "Value", r.MaintPerson);
                builder.AddAttribute(5, "ValueChanged", EventCallback.Factory.Create<string?>(this, v => r.MaintPerson = v));
                builder.CloseComponent();
                break;
            case "MaintCycleDays":
                builder.OpenComponent<MudNumericField<int?>>(0);
                builder.AddAttribute(1, "Dense", true);
                builder.AddAttribute(2, "Variant", Variant.Outlined);
                builder.AddAttribute(3, "Size", Size.Small);
                builder.AddAttribute(4, "HideSpinButtons", true);
                builder.AddAttribute(5, "Value", r.MaintCycleDays);
                builder.AddAttribute(6, "ValueChanged", EventCallback.Factory.Create<int?>(this, v => r.MaintCycleDays = v));
                builder.CloseComponent();
                break;
            case "CurrentMaintStartDate":
                builder.OpenComponent<MudTextField<string>>(0);
                builder.AddAttribute(1, "Dense", true);
                builder.AddAttribute(2, "Variant", Variant.Outlined);
                builder.AddAttribute(3, "Size", Size.Small);
                builder.AddAttribute(4, "Value", r.CurrentMaintStartDate);
                builder.AddAttribute(5, "ValueChanged", EventCallback.Factory.Create<string>(this, v => r.CurrentMaintStartDate = v));
                builder.AddAttribute(6, "Placeholder", "yyyy-MM-dd");
                builder.CloseComponent();
                break;
            case "Remark":
                builder.OpenComponent<MudTextField<string>>(0);
                builder.AddAttribute(1, "Dense", true);
                builder.AddAttribute(2, "Variant", Variant.Outlined);
                builder.AddAttribute(3, "Size", Size.Small);
                builder.AddAttribute(4, "Value", r.Remark);
                builder.AddAttribute(5, "ValueChanged", EventCallback.Factory.Create<string?>(this, v => r.Remark = v));
                builder.CloseComponent();
                break;
            default:
                builder.AddContent(0, "");
                break;
        }
    };
}
