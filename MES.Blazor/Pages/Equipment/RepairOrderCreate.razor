@page "/repair-orders/create"
@using MES.Core.DTOs
@using MES.Blazor.Services
@using MES.Blazor.Shared
@using Microsoft.AspNetCore.Authorization
@inject RepairOrderService RepairOrderService
@inject EquipmentService EquipmentService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject IJSRuntime JS
@inject ColumnPrefsService ColumnPrefs
@attribute [Authorize(Roles = "EquipmentStaff,EquipmentDirector,Admin")]

<MudContainer MaxWidth="MaxWidth.False" Class="mt-4">
    <style>
        .edit-table td.mud-table-cell,
        .edit-table th.mud-table-cell {
            padding: 1px 4px !important;
        }
        .edit-table .mud-input-input-control {
            margin-top: 0;
        }
        .edit-table .mud-input {
            font-size: 13px;
            width: 100%;
            min-width: 0;
        }
        .edit-table th.mud-table-cell {
            white-space: nowrap;
        }
        .table-scroll {
            max-height: calc(100vh - 280px);
            overflow-y: auto;
            overflow-x: auto;
        }
    </style>

    <MudCard>
        <MudCardHeader>
            <CardHeaderContent>
                <MudText Typo="Typo.h5" Class="font-weight-bold">
                    <MudIcon Icon="@Icons.Material.Filled.AddCircleOutline" Class="mr-2" Color="Color.Primary" />
                    报修
                </MudText>
            </CardHeaderContent>
            <CardHeaderActions>
                <MudButton Variant="Variant.Text" Color="Color.Default" OnClick="GoBack">返回</MudButton>
            </CardHeaderActions>
        </MudCardHeader>

        <MudCardContent>

            <div id="repair-order-create-table">
                @if (_rows.Any())
                {
                    <div class="d-flex align-center mb-2">
                        <ColumnDisplaySelect Columns="_allColumns"
                                             OnColumnToggle="OnColumnToggle"
                                             OnMoveUp="MoveColumnUp"
                                             OnMoveDown="MoveColumnDown" />
                        <MudButton Variant="Variant.Text" Size="Size.Small"
                                   Color="Color.Default"
                                   StartIcon="@Icons.Material.Filled.RestartAlt"
                                   OnClick="ResetColumnDisplay" Class="ml-2">
                            重置
                        </MudButton>
                        <MudSpacer />
                        <MudText Typo="Typo.body2">共 @_rows.Count 行</MudText>
                        <MudButton Variant="Variant.Text" Size="Size.Small"
                                   Color="Color.Default"
                                   StartIcon="@Icons.Material.Filled.AddCircleOutline"
                                   OnClick="AddRow" Class="ml-2">
                            添加行
                        </MudButton>
                    </div>
                    <div class="table-scroll">
                        <MudTable Items="@_rows" Dense="true" Hover="true" Elevation="0" Striped="true"
                                  Class="edit-table auto-table" SortMode="SortMode.None" FixedHeader="true">
                            <HeaderContent>
                                @foreach (var col in _visibleColumns)
                                {
                                    <MudTh>
                                        @col.Label
                                        @if (col.IsRequired)
                                        {
                                            <span class="required-star">*</span>
                                        }
                                    </MudTh>
                                }
                                <MudTh Style="width:60px;">操作</MudTh>
                            </HeaderContent>
                            <RowTemplate Context="r">
                                @foreach (var col in _visibleColumns)
                                {
                                    <MudTd>@RenderCell(r, col)</MudTd>
                                }
                                <MudTd>
                                    <MudIconButton Icon="@Icons.Material.Filled.RemoveCircleOutline"
                                                   Color="Color.Error" Size="Size.Small"
                                                   Title="删除"
                                                   OnClick="() => RemoveRow(r)"
                                                   Disabled="@(_rows.Count <= 1)" />
                                </MudTd>
                            </RowTemplate>
                            <FooterContent>
                                <MudTd colspan="@(_visibleColumns.Count + 1)">
                                    <MudIconButton Icon="@Icons.Material.Filled.AddCircleOutline"
                                                   Color="Color.Primary" Size="Size.Small"
                                                   OnClick="AddRow" />
                                </MudTd>
                            </FooterContent>
                        </MudTable>
                    </div>
                }
            </div>

            @if (!string.IsNullOrEmpty(_errorMessage))
            {
                <MudText Typo="Typo.body2" Color="Color.Error" Class="mt-4">@_errorMessage</MudText>
            }

            @if (_rows.Any())
            {
                <MudGrid Class="mt-4">
                    <MudItem xs="12" Class="d-flex justify-end">
                        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.CloudUpload"
                                   OnClick="Submit" Loading="@_isSubmitting"
                                   Size="Size.Large">
                            确认提交 (@_rows.Count 条)
                        </MudButton>
                    </MudItem>
                </MudGrid>
            }
        </MudCardContent>
    </MudCard>
</MudContainer>

@code {
    private List<EditRow> _rows = new();
    private bool _isSubmitting;
    private bool _isArrowNavSetup;
    private string _errorMessage = string.Empty;

    private List<EquipmentListDto> _allEquipment = new();
    private List<string> _locations = new();
    private List<EquipmentListDto> _filteredEquipment = new();

    // ========== 列定义 ==========

    private List<ColumnDef> _allColumns = new();
    private List<ColumnDef> _visibleColumns =>
        _allColumns.Where(c => c.IsApplicable && c.Visible).ToList();

    private static List<ColumnDef> GetAllColumnDefs() => new()
    {
        new() { Key = "Location",         Label = "所在区域", IsRequired = true },
        new() { Key = "EquipmentName",    Label = "设备名称", IsRequired = true },
        new() { Key = "EquipmentCode",    Label = "设备编号" },
        new() { Key = "FaultDescription", Label = "故障描述", IsRequired = true },
        new() { Key = "FaultType",        Label = "故障类型" },
        new() { Key = "Priority",         Label = "优先级" },
        new() { Key = "ReportPerson",     Label = "报修人", IsRequired = true },
        new() { Key = "ReportTime",       Label = "报修时间", IsRequired = true },
    };

    private async Task OnColumnToggle(ColumnDef col)
    {
        await SaveColumnPrefs();
    }

    private async Task SaveColumnPrefs()
    {
        await ColumnPrefs.SaveAsync("repair-orders-create", null, _allColumns);
    }

    private async Task ResetColumnDisplay()
    {
        _allColumns = GetAllColumnDefs();
        await SaveColumnPrefs();
    }

    private async Task MoveColumnUp(ColumnDef col)
    {
        await SaveColumnPrefs();
    }

    private async Task MoveColumnDown(ColumnDef col)
    {
        await SaveColumnPrefs();
    }

    private class EditRow
    {
        public string? SelectedLocation { get; set; }
        public int? EquipmentId { get; set; }
        public string FaultDescription { get; set; } = string.Empty;
        public string? FaultType { get; set; }
        public string Priority { get; set; } = "Normal";
        public string ReportPerson { get; set; } = string.Empty;
        public string ReportTimeText { get; set; } = DateTime.Now.ToString("yyyy-MM-dd HH:mm");
    }

    protected override async Task OnInitializedAsync()
    {
        _allColumns = GetAllColumnDefs();
        var saved = await ColumnPrefs.LoadAsync("repair-orders-create", null);
        if (saved.Count > 0)
        {
            foreach (var s in saved)
            {
                var match = _allColumns.FirstOrDefault(c => c.Key == s.Key);
                if (match != null)
                    match.Visible = s.Visible;
            }
            var reordered = new List<ColumnDef>();
            foreach (var s in saved)
            {
                var match = _allColumns.FirstOrDefault(c => c.Key == s.Key);
                if (match != null && !reordered.Contains(match))
                    reordered.Add(match);
            }
            foreach (var c in _allColumns)
            {
                if (!reordered.Contains(c))
                    reordered.Add(c);
            }
            _allColumns = reordered;
        }

        await LoadEquipmentAsync();

        if (!_rows.Any())
            _rows.Add(new EditRow());
    }

    private async Task LoadEquipmentAsync()
    {
        var response = await EquipmentService.GetAllAsync();
        if (response?.Data != null)
        {
            _allEquipment = response.Data;
            _locations = _allEquipment
                .Select(e => e.Location)
                .Where(l => !string.IsNullOrEmpty(l))
                .Distinct()
                .OrderBy(l => l)
                .ToList()!;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_isArrowNavSetup)
        {
            _isArrowNavSetup = true;
            if (!await JS.InvokeAsync<bool>("enableTableArrowNav", "#repair-order-create-table"))
                _isArrowNavSetup = false;
        }
    }

    private void AddRow()
    {
        _rows.Add(new EditRow());
    }

    private void RemoveRow(EditRow row)
    {
        if (_rows.Count <= 1) return;
        _rows.Remove(row);
    }

    private async Task Submit()
    {
        _errorMessage = string.Empty;

        var errors = new List<string>();
        for (int i = 0; i < _rows.Count; i++)
        {
            var r = _rows[i];
            if (r.EquipmentId == null || r.EquipmentId <= 0)
                errors.Add($"第{i + 1}行：请选择设备");
            if (string.IsNullOrWhiteSpace(r.FaultDescription))
                errors.Add($"第{i + 1}行：故障描述不能为空");
            if (string.IsNullOrWhiteSpace(r.ReportPerson))
                errors.Add($"第{i + 1}行：报修人不能为空");
            if (!DateTime.TryParse(r.ReportTimeText, out _))
                errors.Add($"第{i + 1}行：报修时间格式无效（请用 yyyy-MM-dd HH:mm）");
        }

        if (errors.Any())
        {
            Snackbar.Add(string.Join("；", errors), Severity.Error);
            return;
        }

        _isSubmitting = true;
        StateHasChanged();

        try
        {
            var successCount = 0;
            foreach (var r in _rows)
            {
                var request = new CreateRepairOrderRequest
                {
                    EquipmentId = r.EquipmentId!.Value,
                    FaultDescription = r.FaultDescription,
                    FaultType = r.FaultType,
                    Priority = r.Priority,
                    ReportPerson = r.ReportPerson,
                    ReportTime = DateTime.Parse(r.ReportTimeText),
                };

                var result = await RepairOrderService.CreateAsync(request);
                if (result.Success)
                    successCount++;
                else
                {
                    _errorMessage = $"第{successCount + 1}行提交失败: {result.Message}";
                    return;
                }
            }

            Snackbar.Add($"报修成功，共{successCount}条", Severity.Success);
            Navigation.NavigateTo("/repair-orders");
        }
        catch (Exception ex)
        {
            _errorMessage = $"网络错误: {ex.Message}";
        }
        finally
        {
            _isSubmitting = false;
            StateHasChanged();
        }
    }

    private void GoBack()
    {
        Navigation.NavigateTo("/repair-orders");
    }

    // ========== 单元格渲染 ==========

    private RenderFragment RenderCell(EditRow r, ColumnDef col) => builder =>
    {
        switch (col.Key)
        {
            case "Location":
                builder.OpenComponent<MudSelect<string?>>(0);
                builder.AddAttribute(1, "Dense", true);
                builder.AddAttribute(3, "Variant", Variant.Outlined);
                builder.AddAttribute(4, "Size", Size.Small);
                builder.AddAttribute(5, "Value", r.SelectedLocation);
                builder.AddAttribute(6, "ValueChanged", EventCallback.Factory.Create<string?>(this, v =>
                {
                    r.SelectedLocation = v;
                    r.EquipmentId = null;
                }));
                builder.AddAttribute(7, "ChildContent", (RenderFragment)(cb =>
                {
                    cb.OpenComponent<MudSelectItem<string?>>(0);
                    cb.AddAttribute(1, "Value", (string?)null);
                    cb.CloseComponent();
                    foreach (var loc in _locations)
                    {
                        cb.OpenComponent<MudSelectItem<string?>>(0);
                        cb.AddAttribute(1, "Value", loc);
                        cb.AddAttribute(2, "ChildContent", (RenderFragment)(b => b.AddContent(0, loc)));
                        cb.CloseComponent();
                    }
                }));
                builder.CloseComponent();
                break;
            case "EquipmentName":
                var filtered = string.IsNullOrEmpty(r.SelectedLocation)
                    ? _allEquipment
                    : _allEquipment.Where(e => e.Location == r.SelectedLocation).ToList();
                builder.OpenComponent<MudSelect<EquipmentListDto?>>(0);
                builder.AddAttribute(1, "Dense", true);
                builder.AddAttribute(3, "Variant", Variant.Outlined);
                builder.AddAttribute(4, "Size", Size.Small);
                builder.AddAttribute(5, "Value", r.EquipmentId.HasValue ? _allEquipment.FirstOrDefault(e => e.Id == r.EquipmentId.Value) : null);
                builder.AddAttribute(6, "ValueChanged", EventCallback.Factory.Create<EquipmentListDto?>(this, v =>
                {
                    r.EquipmentId = v?.Id;
                }));
                builder.AddAttribute(7, "ToStringFunc", new Func<EquipmentListDto?, string?>(e => e?.EquipmentName));
                builder.AddAttribute(8, "ChildContent", (RenderFragment)(cb =>
                {
                    cb.OpenComponent<MudSelectItem<EquipmentListDto?>>(0);
                    cb.AddAttribute(1, "Value", (EquipmentListDto?)null);
                    cb.CloseComponent();
                    foreach (var eq in filtered)
                    {
                        cb.OpenComponent<MudSelectItem<EquipmentListDto?>>(0);
                        cb.AddAttribute(1, "Value", eq);
                        cb.CloseComponent();
                    }
                }));
                builder.CloseComponent();
                break;
            case "EquipmentCode":
                var equip = r.EquipmentId.HasValue ? _allEquipment.FirstOrDefault(e => e.Id == r.EquipmentId.Value) : null;
                builder.AddContent(0, equip?.EquipmentCode ?? "");
                break;
            case "FaultDescription":
                builder.OpenComponent<MudTextField<string>>(0);
                builder.AddAttribute(1, "Dense", true);
                builder.AddAttribute(2, "Variant", Variant.Outlined);
                builder.AddAttribute(3, "Size", Size.Small);
                builder.AddAttribute(4, "Value", r.FaultDescription);
                builder.AddAttribute(5, "ValueChanged", EventCallback.Factory.Create<string>(this, v => r.FaultDescription = v));
                builder.CloseComponent();
                break;
            case "FaultType":
                builder.OpenComponent<MudTextField<string>>(0);
                builder.AddAttribute(1, "Dense", true);
                builder.AddAttribute(2, "Variant", Variant.Outlined);
                builder.AddAttribute(3, "Size", Size.Small);
                builder.AddAttribute(4, "Value", r.FaultType);
                builder.AddAttribute(5, "ValueChanged", EventCallback.Factory.Create<string?>(this, v => r.FaultType = v));
                builder.CloseComponent();
                break;
            case "Priority":
                builder.OpenComponent<MudSelect<string>>(0);
                builder.AddAttribute(1, "Dense", true);
                builder.AddAttribute(2, "Variant", Variant.Outlined);
                builder.AddAttribute(3, "Size", Size.Small);
                builder.AddAttribute(4, "Value", r.Priority);
                builder.AddAttribute(5, "ValueChanged", EventCallback.Factory.Create<string>(this, v => r.Priority = v));
                builder.AddAttribute(6, "ChildContent", (RenderFragment)(b2 =>
                {
                    b2.OpenComponent<MudSelectItem<string>>(0);
                    b2.AddAttribute(1, "Value", "Normal");
                    b2.AddAttribute(2, "ChildContent", (RenderFragment)(b3 => b3.AddContent(0, "普通")));
                    b2.CloseComponent();
                    b2.OpenComponent<MudSelectItem<string>>(0);
                    b2.AddAttribute(1, "Value", "Urgent");
                    b2.AddAttribute(2, "ChildContent", (RenderFragment)(b3 => b3.AddContent(0, "紧急")));
                    b2.CloseComponent();
                    b2.OpenComponent<MudSelectItem<string>>(0);
                    b2.AddAttribute(1, "Value", "Emergency");
                    b2.AddAttribute(2, "ChildContent", (RenderFragment)(b3 => b3.AddContent(0, "特急")));
                    b2.CloseComponent();
                }));
                builder.CloseComponent();
                break;
            case "ReportPerson":
                builder.OpenComponent<MudTextField<string>>(0);
                builder.AddAttribute(1, "Dense", true);
                builder.AddAttribute(2, "Variant", Variant.Outlined);
                builder.AddAttribute(3, "Size", Size.Small);
                builder.AddAttribute(4, "Value", r.ReportPerson);
                builder.AddAttribute(5, "ValueChanged", EventCallback.Factory.Create<string>(this, v => r.ReportPerson = v));
                builder.CloseComponent();
                break;
            case "ReportTime":
                builder.OpenComponent<MudTextField<string>>(0);
                builder.AddAttribute(1, "Dense", true);
                builder.AddAttribute(2, "Variant", Variant.Outlined);
                builder.AddAttribute(3, "Size", Size.Small);
                builder.AddAttribute(4, "Value", r.ReportTimeText);
                builder.AddAttribute(5, "ValueChanged", EventCallback.Factory.Create<string>(this, v => r.ReportTimeText = v));
                builder.AddAttribute(6, "Placeholder", "yyyy-MM-dd HH:mm");
                builder.CloseComponent();
                break;
            default:
                builder.AddContent(0, "");
                break;
        }
    };
}
