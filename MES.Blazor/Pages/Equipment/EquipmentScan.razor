@page "/equipment-scan"
@using Microsoft.AspNetCore.Authorization
@using MES.Blazor.Services
@attribute [Authorize]
@implements IDisposable

<MudContainer MaxWidth="MaxWidth.False" Class="mt-4">
    <MudCard>
        <MudCardHeader>
            <CardHeaderContent>
                <MudText Typo="Typo.h5" Class="font-weight-bold">
                    <MudIcon Icon="@Icons.Material.Filled.QrCodeScanner" Class="mr-2" Color="Color.Primary" />
                    设备扫码
                </MudText>
            </CardHeaderContent>
            <CardHeaderActions>
                <MudButton Variant="Variant.Text" Color="Color.Default" OnClick="GoBack">返回</MudButton>
            </CardHeaderActions>
        </MudCardHeader>

        <MudCardContent>
            @* ========== 状态：等待扫码 ========== *@
            @if (_step == ScanStep.Scan)
            {
                <div class="d-flex flex-column align-center">
                    <MudText Typo="Typo.h6" Class="mb-3 font-weight-bold text-center">
                        <MudIcon Icon="@Icons.Material.Filled.QrCodeScanner" Color="Color.Primary" Class="mr-1" />
                        扫设备二维码
                    </MudText>

                    <MudButton Variant="Variant.Filled" Color="Color.Primary"
                               Size="Size.Large"
                               StartIcon="@Icons.Material.Filled.CameraAlt"
                               OnClick="StartCamera"
                               Disabled="@_isCameraStarted"
                               Class="mb-3 pa-3"
                               Style="font-size: 1rem; min-height: 44px;">
                        @(_isCameraStarted ? "扫描中..." : "扫设备条码")
                    </MudButton>

                    @if (_isCameraStarted)
                    {
                        <div class="camera-overlay">
                            <video id="equipment-scan-video" class="camera-video"></video>
                            <canvas id="equipment-scan-canvas" style="display: none;"></canvas>
                            <div class="camera-footer">
                                <MudButton Variant="Variant.Filled" Color="Color.Error"
                                           Size="Size.Large"
                                           OnClick="StopCamera"
                                           FullWidth="true"
                                           StartIcon="@Icons.Material.Filled.Close">
                                    取消扫描
                                </MudButton>
                            </div>
                        </div>
                    }

                    <MudText Typo="Typo.body2" Class="mt-3 mb-1" Color="Color.Secondary">或手动输入设备编码</MudText>
                    <div style="width: 100%;" class="manual-input-container">
                        <MudTextField @bind-Value="_manualInput"
                                      Label="输入设备编码（如 EQ-001）"
                                      Variant="Variant.Outlined"
                                      Class="mb-2"
                                      Style="font-size: 0.875rem; height: 44px;" />
                        <MudButton Variant="Variant.Outlined" Color="Color.Secondary"
                                   FullWidth="true"
                                   OnClick="ResolveManualInput"
                                   Disabled="string.IsNullOrWhiteSpace(_manualInput)">
                            解析
                        </MudButton>
                    </div>

                    @if (_resolveError != null)
                    {
                        <MudAlert Severity="Severity.Error" Class="mt-3 w-100">@_resolveError</MudAlert>
                    }
                </div>
            }

            @* ========== 状态：设备已识别，显示操作选择 ========== *@
            @if (_step == ScanStep.SelectAction)
            {
                <div class="d-flex flex-column">
                    @* 设备信息摘要 *@
                    <MudPaper Class="pa-3 mb-4" Elevation="2" Style="border-left: 4px solid #1976d2; background: #e3f2fd;">
                        <div class="d-flex align-center mb-1" style="gap: 12px;">
                            <MudIcon Icon="@Icons.Material.Filled.PrecisionManufacturing" Color="Color.Primary" Size="Size.Small" />
                            <MudText Typo="Typo.body2" Class="font-weight-bold" Color="Color.Primary">
                                @_equipment!.EquipmentName (@_equipment.EquipmentCode)
                            </MudText>
                            <MudChip Size="Size.Small" Color="Color.Primary">@_equipment!.Location</MudChip>
                            @if (!string.IsNullOrEmpty(_equipment!.RelatedSection))
                            {
                                <MudChip Size="Size.Small" Color="Color.Tertiary">@_equipment.RelatedSection</MudChip>
                            }
                        </div>
                        @if (!string.IsNullOrEmpty(_equipment.ModelNumber))
                        {
                            <MudText Typo="Typo.caption" Color="Color.Secondary">型号：@_equipment.ModelNumber</MudText>
                        }
                        <MudButton Variant="Variant.Text" Color="Color.Default" Size="Size.Small"
                                   OnClick="Rescan" Style="font-size: 0.75rem;">
                            重新扫描
                        </MudButton>
                    </MudPaper>

                    <MudText Typo="Typo.subtitle2" Class="mb-3 text-center font-weight-bold">请选择要执行的操作</MudText>

                    @* 报修按钮 *@
                    <MudButton Variant="Variant.Filled" Color="Color.Warning"
                               FullWidth="true"
                               Size="Size.Large"
                               OnClick="GoToRepair"
                               StartIcon="@Icons.Material.Filled.Build"
                               Class="mb-3 pa-4"
                               Style="font-size: 1.1rem; min-height: 56px;">
                        设备报修
                    </MudButton>

                    @* 维修按钮 *@
                    <MudButton Variant="Variant.Filled" Color="Color.Primary"
                               FullWidth="true"
                               Size="Size.Large"
                               OnClick="GoToExecute"
                               StartIcon="@Icons.Material.Filled.Handyman"
                               Class="mb-3 pa-4"
                               Style="font-size: 1.1rem; min-height: 56px;">
                        设备维修
                    </MudButton>

                    @* 工单列表按钮 *@
                    <MudButton Variant="Variant.Outlined" Color="Color.Default"
                               FullWidth="true"
                               Size="Size.Large"
                               OnClick="GoToOrderList"
                               StartIcon="@Icons.Material.Filled.ListAlt"
                               Class="pa-3"
                               Style="font-size: 1rem; min-height: 48px;">
                        维修工单列表
                    </MudButton>
                </div>
            }
        </MudCardContent>
    </MudCard>

    @* 加载提示 *@
    <MudOverlay Visible="_isLoading">
        <div class="d-flex flex-column align-center justify-center" style="height: 100%;">
            <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large" />
            <MudText Typo="Typo.body1" Color="Color.Primary" Class="mt-3">解析中...</MudText>
        </div>
    </MudOverlay>
</MudContainer>
