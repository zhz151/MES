@page "/outsource-recoveries"
@using MES.Blazor.Services
@using MES.Core.DTOs
@using MES.Core.Models
@using MES.Blazor.Helpers
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Rendering
@using MES.Blazor.Shared
@inject SectionOutsourceService SectionOutsourceService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject IJSRuntime JS
@inject ColumnPrefsService ColumnPrefs
@attribute [Authorize(Roles = "BatchStaff,BatchDirector,Admin")]

<MudContainer MaxWidth="MaxWidth.False" Class="mt-4 pl-0">
    <MudCard>
        <MudCardHeader>
            <CardHeaderContent>
                <MudText Typo="Typo.h5" Class="font-weight-bold">
                    <MudIcon Icon="@Icons.Material.Filled.Recycling" Class="mr-2" Color="Color.Success" />
                    委外回收
                </MudText>
            </CardHeaderContent>
            <CardHeaderActions>
                <MudButton Variant="Variant.Text" Color="Color.Default"
                           StartIcon="@Icons.Material.Filled.ArrowBack"
                           OnClick='() => Navigation.NavigateTo("/section-outsources")'>
                    返回委外
                </MudButton>
            </CardHeaderActions>
        </MudCardHeader>

        <MudCardContent>
            <!-- 搜索栏 -->
            <MudGrid>
                <MudItem xs="12" md="6">
                    <MudTextField T="string"
                                  Label="模糊搜索 - 批次号/工序/委外单位"
                                  Value="searchKeyword"
                                  ValueChanged="@OnSearchChanged"
                                  Immediate="true"
                                  DebounceInterval="500"
                                  Clearable="true"
                                  ClearButton="true"
                                  Adornment="Adornment.End"
                                  AdornmentIcon="@Icons.Material.Filled.Search" />
                </MudItem>
                <MudItem xs="12" md="3">
                    <MudTextField Label="回收日期起"
                                   @bind-Value="_recoveryDateFrom"
                                   Clearable="true"
                                   Dense="true"
                                   Variant="Variant.Outlined"
                                   Immediate="true"
                                   DebounceInterval="500" />
                </MudItem>
                <MudItem xs="12" md="3">
                    <MudTextField Label="回收日期止"
                                   @bind-Value="_recoveryDateTo"
                                   Clearable="true"
                                   Dense="true"
                                   Variant="Variant.Outlined"
                                   Immediate="true"
                                   DebounceInterval="500" />
                </MudItem>
            </MudGrid>

            <!-- 数据表格 -->
            <MudTable @ref="table"
                      T="OutsourceRecoveryDto"
                      ServerData="OnServerData"
                      Loading="@isLoading"
                      Dense="true"
                      Hover="true"
                      Class="mt-4 auto-table"
                      Elevation="0"
                      RowsPerPageLabel="每页行数:">
                <ToolBarContent>
                    <ColumnDisplaySelect Columns="_allColumns"
                                         OnColumnToggle="OnColumnToggle"
                                         OnMoveUp="MoveColumnUp"
                                         OnMoveDown="MoveColumnDown" />
                    <MudButton Variant="Variant.Text" Size="Size.Small"
                               Color="Color.Default"
                               StartIcon="@Icons.Material.Filled.RestartAlt"
                               OnClick="ResetColumnDisplay" Class="ml-2">
                        重置
                    </MudButton>
                    <MudSpacer />
                    <MudButton Variant="Variant.Outlined"
                               Size="Size.Small"
                               Color="Color.Info"
                               StartIcon="@Icons.Material.Filled.Print"
                               Disabled="@(!selectedIds.Any())"
                               OnClick="PrintSelected">
                        打印选中 (@selectedIds.Count)
                    </MudButton>
                    <MudButton Variant="Variant.Text"
                               Size="Size.Small"
                               Color="Color.Info"
                               StartIcon="@Icons.Material.Filled.Print"
                               OnClick="PrintAll">
                        打印全部
                    </MudButton>
                    <MudText Typo="Typo.body2" Class="ml-auto">
                        共 @totalCount 条记录
                    </MudText>
                </ToolBarContent>
                <HeaderContent>
                    <MudTh Style="width: 40px;">
                        <MudCheckBox T="bool" @bind-Value="allSelected" Dense="true" />
                    </MudTh>
                    @foreach (var col in _visibleColumns)
                    {
                        <MudTh>
                            @if (!string.IsNullOrEmpty(col.SortKey))
                            {
                                <span @onclick='() => ToggleSort(col.SortKey)' class="sortable-header">
                                    @col.Label
                                </span>
                                @if (sortColumn == col.SortKey)
                                {
                                    <span class="sort-arrow">@GetSortIndicator(col.SortKey)</span>
                                }
                            }
                            else
                            {
                                <span class="th-label">@col.Label</span>
                            }
                        </MudTh>
                    }
                    <MudTh>操作</MudTh>
                </HeaderContent>
                <RowTemplate Context="item">
                    <MudTd Style="width: 40px;">
                        <MudCheckBox T="bool"
                                     Value="@selectedIds.Contains(item.Id)"
                                     ValueChanged="@((v) => { if(v) selectedIds.Add(item.Id); else selectedIds.Remove(item.Id); _allSelected = records.Any() && records.All(i => selectedIds.Contains(i.Id)); StateHasChanged(); })"
                                     Dense="true" />
                    </MudTd>
                    @foreach (var col in _visibleColumns)
                    {
                        <MudTd>@RenderCell(item, col)</MudTd>
                    }
                    <MudTd Style="white-space: nowrap; width: 70px;">
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" OnClick="() => DeleteItem(item)" />
                    </MudTd>
                </RowTemplate>
                <PagerContent>
                    <MudTablePager />
                </PagerContent>
            </MudTable>
        </MudCardContent>
    </MudCard>
</MudContainer>

<!-- 新建回收对话框 → RecoveryCreateDialog.razor -->

@code {
    private MudTable<OutsourceRecoveryDto>? table;
    private List<OutsourceRecoveryDto> records = new();
    private HashSet<int> selectedIds = new();
    private bool _allSelected;
    private bool allSelected
    {
        get => _allSelected;
        set
        {
            if (_allSelected == value) return;
            _allSelected = value;
            if (value)
            {
                foreach (var item in records)
                    selectedIds.Add(item.Id);
            }
            else
            {
                selectedIds.Clear();
            }
            StateHasChanged();
        }
    }
    private bool isLoading = false;
    private string searchKeyword = string.Empty;
    private int totalCount = 0;

    private string sortColumn = "recoverydate";
    private bool sortDescending = true;

    // 日期筛选（字符串格式 yyyy-MM-dd）
    private string? _recoveryDateFrom;
    private string? _recoveryDateTo;

    private List<ColumnDef> _allColumns = new();
    private List<ColumnDef> _visibleColumns = new();

    private const string StorageKey = "outsource-recoveries";

    protected override async Task OnInitializedAsync()
    {
        _allColumns = new List<ColumnDef>
        {
            new() { Key = "batchno", Label = "批次号", Visible = true },
            new() { Key = "outsourcevendor", Label = "委外单位", Visible = true },
            new() { Key = "processname", Label = "工序名称", Visible = true },
            new() { Key = "sectionname", Label = "工段名称", Visible = true },
            new() { Key = "manufacturingspec", Label = "制造规格", Visible = true },
            new() { Key = "outsourcespec", Label = "委外规格", Visible = true },
            new() { Key = "sendquantity", Label = "发出支数", Visible = true },
            new() { Key = "sendweight", Label = "发出重量", Visible = true },
            new() { Key = "tagno", Label = "挂牌号", Visible = false },
            new() { Key = "plantgrade", Label = "工厂牌号", Visible = false },
            new() { Key = "recoverydate", Label = "回收日期", SortKey = "recoverydate", Visible = true },
            new() { Key = "recoveryquantity", Label = "正常回收(支)", SortKey = "recoveryquantity", Visible = true },
            new() { Key = "recoveryweight", Label = "正常回收(重)", SortKey = "recoveryweight", Visible = true },
            new() { Key = "unprocessedquantity", Label = "非正常回收(支)", SortKey = "unprocessedquantity", Visible = true },
            new() { Key = "unprocessedweight", Label = "非正常回收(重)", SortKey = "unprocessedweight", Visible = true },
            new() { Key = "remark", Label = "备注", Visible = false },
            new() { Key = "createdtime", Label = "创建时间", Visible = false }
        };

        var saved = await ColumnPrefs.LoadAsync(StorageKey, null);
        if (saved.Count > 0)
        {
            var savedKeys = saved.Where(c => c.Visible).Select(c => c.Key).ToList();
            var remaining = _allColumns.Where(c => !savedKeys.Contains(c.Key)).ToList();
            _allColumns = savedKeys
                .Select(k => _allColumns.FirstOrDefault(c => c.Key == k))
                .Where(c => c != null)
                .Cast<ColumnDef>()
                .Concat(remaining)
                .ToList();
            foreach (var col in _allColumns)
            {
                var savedCol = saved.FirstOrDefault(c => c.Key == col.Key);
                if (savedCol != null)
                    col.Visible = savedCol.Visible;
            }
        }

        _visibleColumns = _allColumns.Where(c => c.Visible).ToList();
    }

    private async Task<TableData<OutsourceRecoveryDto>> OnServerData(TableState state)
    {
        isLoading = true;
        try
        {
            DateTime? recDateFrom = DateTime.TryParse(_recoveryDateFrom, out var rdf) ? rdf : null;
            DateTime? recDateTo = DateTime.TryParse(_recoveryDateTo, out var rdt) ? rdt : null;
            var result = await SectionOutsourceService.GetRecoveriesPagedAsync(
                pageIndex: state.Page + 1,
                pageSize: state.PageSize,
                keyword: string.IsNullOrWhiteSpace(searchKeyword) ? null : searchKeyword.Trim(),
                sortBy: sortColumn,
                isDescending: sortDescending,
                recoveryDateFrom: recDateFrom,
                recoveryDateTo: recDateTo);

            if (!result.Success)
            {
                Snackbar.Add(result.Message, Severity.Error);
                return new TableData<OutsourceRecoveryDto> { TotalItems = 0, Items = new List<OutsourceRecoveryDto>() };
            }

            records = result.Data?.Items ?? new();
            totalCount = result.Data?.TotalCount ?? 0;
            return new TableData<OutsourceRecoveryDto>
            {
                TotalItems = totalCount,
                Items = records
            };
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task OnSearchChanged(string value)
    {
        searchKeyword = value ?? "";
        _allSelected = false;
        selectedIds.Clear();
        if (table != null) await table.ReloadServerData();
    }

    private async Task TriggerSearch()
    {
        _allSelected = false;
        selectedIds.Clear();
        if (table != null) await table.ReloadServerData();
    }

    private async Task ToggleSort(string column)
    {
        if (sortColumn == column)
            sortDescending = !sortDescending;
        else
        {
            sortColumn = column;
            sortDescending = true;
        }
        if (table != null) await table.ReloadServerData();
    }

    private string GetSortIndicator(string column)
    {
        if (sortColumn != column) return "";
        return sortDescending ? " ▼" : " ▲";
    }

    // ========== 列显示管理 ==========

    private async Task OnColumnToggle(ColumnDef col)
    {
        _visibleColumns = _allColumns.Where(c => c.Visible).ToList();
        await ColumnPrefs.SaveAsync(StorageKey, null, _allColumns);
    }

    private async Task MoveColumnUp(ColumnDef col)
    {
        _visibleColumns = _allColumns.Where(c => c.Visible).ToList();
        await ColumnPrefs.SaveAsync(StorageKey, null, _allColumns);
    }

    private async Task MoveColumnDown(ColumnDef col)
    {
        _visibleColumns = _allColumns.Where(c => c.Visible).ToList();
        await ColumnPrefs.SaveAsync(StorageKey, null, _allColumns);
    }

    private async Task ResetColumnDisplay()
    {
        _allColumns = new List<ColumnDef>
        {
            new() { Key = "batchno", Label = "批次号", Visible = true },
            new() { Key = "outsourcevendor", Label = "委外单位", Visible = true },
            new() { Key = "processname", Label = "工序名称", Visible = true },
            new() { Key = "sectionname", Label = "工段名称", Visible = true },
            new() { Key = "manufacturingspec", Label = "制造规格", Visible = true },
            new() { Key = "outsourcespec", Label = "委外规格", Visible = true },
            new() { Key = "sendquantity", Label = "发出支数", Visible = true },
            new() { Key = "sendweight", Label = "发出重量", Visible = true },
            new() { Key = "tagno", Label = "挂牌号", Visible = false },
            new() { Key = "plantgrade", Label = "工厂牌号", Visible = false },
            new() { Key = "recoverydate", Label = "回收日期", SortKey = "recoverydate", Visible = true },
            new() { Key = "recoveryquantity", Label = "正常回收(支)", SortKey = "recoveryquantity", Visible = true },
            new() { Key = "recoveryweight", Label = "正常回收(重)", SortKey = "recoveryweight", Visible = true },
            new() { Key = "unprocessedquantity", Label = "非正常回收(支)", SortKey = "unprocessedquantity", Visible = true },
            new() { Key = "unprocessedweight", Label = "非正常回收(重)", SortKey = "unprocessedweight", Visible = true },
            new() { Key = "remark", Label = "备注", Visible = false },
            new() { Key = "createdtime", Label = "创建时间", Visible = false }
        };
        _visibleColumns = _allColumns.Where(c => c.Visible).ToList();
        await ColumnPrefs.SaveAsync(StorageKey, null, _allColumns);
    }

    // ========== 单元格渲染 ==========

    private RenderFragment RenderCell(OutsourceRecoveryDto item, ColumnDef col) => builder =>
    {
        switch (col.Key)
        {
            case "batchno":
                builder.AddContent(0, item.BatchNo ?? "");
                break;
            case "outsourcevendor":
                builder.AddContent(0, item.OutsourceVendor ?? "");
                break;
            case "processname":
                builder.AddContent(0, item.ProcessName ?? "");
                break;
            case "sectionname":
                builder.AddContent(0, item.SectionName ?? "");
                break;
            case "manufacturingspec":
                builder.AddContent(0, DisplayHelper.FormatSpecification(item.ManufacturingSpec));
                break;
            case "outsourcespec":
                builder.AddContent(0, item.OutsourceSpec ?? "");
                break;
            case "sendquantity":
                builder.AddContent(0, DisplayHelper.FormatNullableInt(item.SendQuantity));
                break;
            case "sendweight":
                builder.AddContent(0, DisplayHelper.FormatNullableDecimal(item.SendWeight));
                break;
            case "tagno":
                builder.AddContent(0, item.TagNo ?? "");
                break;
            case "plantgrade":
                builder.AddContent(0, item.PlantGrade ?? "");
                break;
            case "recoverydate":
                builder.AddContent(0, item.RecoveryDate.ToString("yyyy-MM-dd"));
                break;
            case "recoveryquantity":
                builder.AddContent(0, item.RecoveryQuantity ?? 0);
                break;
            case "recoveryweight":
                builder.AddContent(0, item.RecoveryWeight?.ToString("G29") ?? "0");
                break;
            case "unprocessedquantity":
                builder.AddContent(0, item.UnprocessedQuantity ?? 0);
                break;
            case "unprocessedweight":
                builder.AddContent(0, item.UnprocessedWeight?.ToString("G29") ?? "0");
                break;
            case "remark":
                builder.AddContent(0, item.Remark ?? "");
                break;
            case "createdtime":
                builder.AddContent(0, item.CreatedTime.LocalDateTime.ToString("yyyy-MM-dd HH:mm"));
                break;
            default:
                builder.AddContent(0, "");
                break;
        }
    };

    // ========== 删除 ==========

    private async Task DeleteItem(OutsourceRecoveryDto item)
    {
        var dialog = await DialogService.ShowAsync<ConfirmDialog>("确认删除", new DialogParameters
        {
            ["ContentText"] = $"确定要删除 {item.RecoveryDate:yyyy-MM-dd} 的回收记录吗？",
            ["ConfirmText"] = "删除"
        });

        var result = await dialog.Result;
        if (result.Canceled) return;

        var response = await SectionOutsourceService.DeleteRecoveryAsync(item.Id);
        if (response.Success)
        {
            Snackbar.Add("删除成功", Severity.Success);
            if (table != null) await table.ReloadServerData();
        }
        else
        {
            Snackbar.Add(response.Message, Severity.Error);
        }
    }

    // ========== 打印 ==========

    private async Task PrintSelected()
    {
        if (!selectedIds.Any()) return;

        var columns = _visibleColumns
            .Where(c => c.Key != "createdtime")
            .Select(c => new PrintColumnDef
            {
                Key = c.Key switch
                {
                    "batchno" => "BatchNo",
                    "outsourcevendor" => "OutsourceVendor",
                    "processname" => "ProcessName",
                    "sectionname" => "SectionName",
                    "manufacturingspec" => "ManufacturingSpec",
                    "outsourcespec" => "OutsourceSpec",
                    "sendquantity" => "SendQuantity",
                    "sendweight" => "SendWeight",
                    "tagno" => "TagNo",
                    "plantgrade" => "PlantGrade",
                    "recoverydate" => "RecoveryDate",
                    "recoveryquantity" => "RecoveryQuantity",
                    "recoveryweight" => "RecoveryWeight",
                    "unprocessedquantity" => "UnprocessedQuantity",
                    "unprocessedweight" => "UnprocessedWeight",
                    "remark" => "Remark",
                    _ => c.Key
                },
                Label = c.Label
            })
            .ToList();

        var result = await SectionOutsourceService.PrintRecoverySelectedAsync(selectedIds.ToArray(), columns);
        if (result.Success)
            await JS.InvokeVoidAsync("openPdf", result.Data);
        else
            Snackbar.Add(result.Message, Severity.Error);
    }

    private async Task PrintAll()
    {
        var columns = _visibleColumns
            .Where(c => c.Key != "createdtime")
            .Select(c => new PrintColumnDef
            {
                Key = c.Key switch
                {
                    "batchno" => "BatchNo",
                    "outsourcevendor" => "OutsourceVendor",
                    "processname" => "ProcessName",
                    "sectionname" => "SectionName",
                    "manufacturingspec" => "ManufacturingSpec",
                    "outsourcespec" => "OutsourceSpec",
                    "sendquantity" => "SendQuantity",
                    "sendweight" => "SendWeight",
                    "tagno" => "TagNo",
                    "plantgrade" => "PlantGrade",
                    "recoverydate" => "RecoveryDate",
                    "recoveryquantity" => "RecoveryQuantity",
                    "recoveryweight" => "RecoveryWeight",
                    "unprocessedquantity" => "UnprocessedQuantity",
                    "unprocessedweight" => "UnprocessedWeight",
                    "remark" => "Remark",
                    _ => c.Key
                },
                Label = c.Label
            })
            .ToList();

        var result = await SectionOutsourceService.PrintRecoveryAllAsync(
            keyword: string.IsNullOrWhiteSpace(searchKeyword) ? null : searchKeyword.Trim(),
            sortBy: sortColumn,
            isDescending: sortDescending,
            columns: columns,
            recoveryDateFrom: DateTime.TryParse(_recoveryDateFrom, out var rdf) ? rdf : null,
            recoveryDateTo: DateTime.TryParse(_recoveryDateTo, out var rdt) ? rdt : null);
        if (result.Success)
            await JS.InvokeVoidAsync("openPdf", result.Data);
        else
            Snackbar.Add(result.Message, Severity.Error);
    }
}
