@page "/workorders/relation"
@using MES.Blazor.Helpers
@using MES.Blazor.Services
@using MES.Core.DTOs
@using Microsoft.AspNetCore.Authorization
@inject WorkOrderService WorkOrderService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

@attribute [Authorize(Roles = "WorkOrderStaff,WorkOrderDirector,Admin")]

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4">
    @if (isLoading)
    {
        <MudProgressCircular Indeterminate Size="Size.Large" Class="d-flex justify-center ma-8" />
    }
    else if (hasError)
    {
        <MudAlert Severity="Severity.Error" Class="mb-4">
            <strong>加载失败：</strong>@errorMessage
            <div class="mt-3">
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="GoBack">返回工单列表</MudButton>
            </div>
        </MudAlert>
    }
    else if (relation == null)
    {
        <MudAlert Severity="Severity.Error">未找到订单信息</MudAlert>
    }
    else
    {
        <MudCard>
            <MudCardHeader>
                <CardHeaderContent>
                    <MudText Typo="Typo.h5" Class="font-weight-bold">
                        <MudIcon Icon="@Icons.Material.Filled.Link" Class="mr-2" Color="Color.Primary" />
                        工单项次追溯
                    </MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">
                        订单号：@relation.OrderNumber | 客户：@relation.CustomerName
                    </MudText>
                </CardHeaderContent>
                <CardHeaderActions>
                    <MudButton Variant="Variant.Text" OnClick="GoBack">返回</MudButton>
                </CardHeaderActions>
            </MudCardHeader>

            <MudCardContent>
                <!-- 订单基本信息卡片 -->
                <MudPaper Class="pa-4 mb-4" Elevation="0" Style="background-color: #f5f5f5;">
                    <MudGrid>
                        <MudItem xs="12" md="3">
                            <MudText Typo="Typo.body2"><strong>订单号：</strong>@relation.OrderNumber</MudText>
                        </MudItem>
                        <MudItem xs="12" md="3">
                            <MudText Typo="Typo.body2"><strong>签订日期：</strong>@relation.SignDate.ToString("yyyy-MM-dd")</MudText>
                        </MudItem>
                        <MudItem xs="12" md="3">
                            <MudText Typo="Typo.body2"><strong>业务员：</strong>@relation.Salesman</MudText>
                        </MudItem>
                        <MudItem xs="12" md="3">
                            <MudText Typo="Typo.body2"><strong>客户名称：</strong>@relation.CustomerName</MudText>
                        </MudItem>
                        @if (!string.IsNullOrEmpty(relation.EndCustomer))
                        {
                            <MudItem xs="12" md="3">
                                <MudText Typo="Typo.body2"><strong>最终用户：</strong>@relation.EndCustomer</MudText>
                            </MudItem>
                        }
                    </MudGrid>
                </MudPaper>

                @if (!relation.WorkOrders.Any())
                {
                    <MudAlert Severity="Severity.Info">该订单下没有工单。</MudAlert>
                }
                else
                {
                    foreach (var workOrder in relation.WorkOrders)
                    {
                        <MudCard Class="mb-4" Style="border-left: 4px solid var(--mud-palette-primary);">
                            <MudCardHeader>
                                <CardHeaderContent>
                                    <div>
                                        <MudText Typo="Typo.subtitle1">
                                            <MudLink Typo="Typo.subtitle1" Color="Color.Primary" 
                                                     Underline="Underline.Always" 
                                                     OnClick="() => NavigateToWorkOrder(workOrder.WorkOrderId)">
                                                工单号：@workOrder.WorkOrderNo
                                            </MudLink>
                                        </MudText>
                                        <MudText Typo="Typo.body2" Color="Color.Secondary">
                                            主号：@workOrder.ProductionMainNo | 次号：@(workOrder.ProductionSubNo ?? "-")
                                        </MudText>
                                    </div>
                                </CardHeaderContent>
                                <CardHeaderActions>
                                    <MudChip Size="Size.Small" Color="@GetStatusColor(workOrder.Status)">
                                        @workOrder.StatusText
                                    </MudChip>
                                </CardHeaderActions>
                            </MudCardHeader>

                            <MudCardContent>
                                <!-- 工单基本信息区域 -->
                                <MudText Typo="Typo.subtitle2" Class="mb-2" Color="Color.Primary">工单基本信息</MudText>
                                <MudGrid>
                                    <MudItem xs="12" md="3">
                                        <MudText Typo="Typo.body2"><strong>物料名称：</strong>@DisplayHelper.GetMaterialNameText(workOrder.MaterialName)</MudText>
                                    </MudItem>
                                    <MudItem xs="12" md="3">
                                        <MudText Typo="Typo.body2"><strong>工厂牌号：</strong>@workOrder.PlantGrade</MudText>
                                    </MudItem>
                                    <MudItem xs="12" md="3">
                                        <MudText Typo="Typo.body2"><strong>规格：</strong>@DisplayHelper.FormatSpecification(workOrder.Specification)</MudText>
                                    </MudItem>
                                    <MudItem xs="12" md="3">
                                        <MudText Typo="Typo.body2"><strong>交货日期：</strong>@workOrder.DeliveryDate.ToString("yyyy-MM-dd")</MudText>
                                    </MudItem>
                                    <MudItem xs="12" md="3">
                                        <MudText Typo="Typo.body2"><strong>交货状态：</strong>@DisplayHelper.GetDeliveryStateText(workOrder.DeliveryState)</MudText>
                                    </MudItem>
                                    <MudItem xs="12" md="3">
                                        <MudText Typo="Typo.body2"><strong>长度状态：</strong>@DisplayHelper.GetLengthStatusText(workOrder.LengthStatus)</MudText>
                                    </MudItem>
                                    <MudItem xs="12" md="3">
                                        <MudText Typo="Typo.body2"><strong>总支数：</strong>@workOrder.TotalQuantity 支</MudText>
                                    </MudItem>
                                    <MudItem xs="12" md="3">
                                        <MudText Typo="Typo.body2"><strong>总重量：</strong>@DisplayHelper.FormatDecimal(workOrder.TotalWeight) kg</MudText>
                                    </MudItem>
                                </MudGrid>

                                <MudDivider Class="my-3" />

                                <MudText Typo="Typo.subtitle2" Class="mb-2" Color="Color.Primary">包含的原始订单项次：</MudText>

                                @if (!workOrder.OrderItems.Any())
                                {
                                    <MudText Typo="Typo.body2" Color="Color.Secondary">无项次明细</MudText>
                                }
                                else
                                {
                                    <MudTable T="OrderItemBriefDto" Items="@workOrder.OrderItems" Dense="true" Hover="true" Elevation="0">
                                        <HeaderContent>
                                            <MudTh>项次号</MudTh>
                                            <MudTh>标准牌号</MudTh>
                                            <MudTh>规格</MudTh>
                                            <MudTh>长度状态</MudTh>
                                            <MudTh>最小长度(mm)</MudTh>
                                            <MudTh>最大长度(mm)</MudTh>
                                            <MudTh>支数</MudTh>
                                            <MudTh>米数</MudTh>
                                            <MudTh>合同重量(kg)</MudTh>
                                            <MudTh>理算重量(kg)</MudTh>
                                        </HeaderContent>
                                        <RowTemplate>
                                            <MudTd class="table-cell-clamp-1">@context.Sequence</MudTd>
                                            <MudTd class="table-cell-clamp-1" title="@context.StandardGrade">@context.StandardGrade</MudTd>
                                            <MudTd class="table-cell-clamp-1" title="@DisplayHelper.FormatSpecification(context.Specification)">@DisplayHelper.FormatSpecification(context.Specification)</MudTd>
                                            <MudTd class="table-cell-clamp-1">@DisplayHelper.GetLengthStatusText(context.LengthStatus)</MudTd>
                                            <MudTd class="table-cell-clamp-1">@DisplayHelper.FormatNullableDecimal(context.MinLength)</MudTd>
                                            <MudTd class="table-cell-clamp-1">@DisplayHelper.FormatNullableDecimal(context.MaxLength)</MudTd>
                                            <MudTd class="table-cell-clamp-1">@context.Quantity</MudTd>
                                            <MudTd class="table-cell-clamp-1">@DisplayHelper.FormatNullableDecimal(context.Meters)</MudTd>
                                            <MudTd class="table-cell-clamp-1">@DisplayHelper.FormatDecimal(context.ContractWeight)</MudTd>
                                            <MudTd class="table-cell-clamp-1">@DisplayHelper.FormatDecimal(context.TheoreticalWeight)</MudTd>
                                        </RowTemplate>
                                    </MudTable>
                                }
                            </MudCardContent>
                        </MudCard>
                    }
                }
            </MudCardContent>
        </MudCard>
    }
</MudContainer>

@code {
    [Parameter]
    [SupplyParameterFromQuery]
    public string? salesOrderNo { get; set; }

    private OrderWorkOrderRelationDto? relation;
    private bool isLoading = true;
    private bool hasError = false;
    private string errorMessage = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        // 从 NavigationManager 解析查询参数
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        if (!string.IsNullOrEmpty(uri.Query))
        {
            var query = System.Web.HttpUtility.ParseQueryString(uri.Query);
            if (string.IsNullOrEmpty(salesOrderNo))
                salesOrderNo = query["salesOrderNo"] ?? salesOrderNo;
        }

        await LoadData();
    }

    private async Task LoadData()
    {
        if (string.IsNullOrEmpty(salesOrderNo))
        {
            hasError = true;
            errorMessage = "订单号不能为空，请从工单列表页面重新进入。";
            isLoading = false;
            return;
        }

        isLoading = true;
        StateHasChanged();

        try
        {
            var result = await WorkOrderService.GetOrderWorkOrderRelationAsync(salesOrderNo);
            if (result.Success && result.Data != null)
            {
                relation = result.Data;
            }
            else
            {
                hasError = true;
                errorMessage = result.Message ?? "获取数据失败";
            }
        }
        catch (Exception ex)
        {
            hasError = true;
            errorMessage = $"加载失败: {ex.Message}";
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private void NavigateToWorkOrder(int workOrderId)
    {
        Navigation.NavigateTo($"/workorders/{workOrderId}");
    }

    private void GoBack()
    {
        Navigation.NavigateTo("/workorders");
    }

    private Color GetStatusColor(int status)
    {
        return status switch
        {
            0 => Color.Default,
            1 => Color.Success,
            2 => Color.Warning,
            3 => Color.Error,
            _ => Color.Default
        };
    }

}