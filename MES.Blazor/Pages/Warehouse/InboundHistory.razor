@page "/warehouse/inbound-history"
@page "/warehouse/inbound-history/{Code}"
@using MES.Blazor.Services
@using MES.Core.Models
@using MES.Blazor.Helpers
@using Microsoft.AspNetCore.Authorization
@using MES.Blazor.Shared
@using MES.Blazor.Models
@using MES.Core.DTOs.Warehouse
@inject InventoryService InventoryService
@inject WarehouseService WarehouseService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject ColumnPrefsService ColumnPrefs
@inject IJSRuntime JS
@inject HttpClient Http
@inject PageStateService PageState
@attribute [Authorize]

<style>
    .inbound-history-edit-table td.mud-table-cell,
    .inbound-history-edit-table th.mud-table-cell {
        padding: 1px 4px !important;
    }
    .inbound-history-edit-table .mud-input-input-control {
        margin-top: 0;
    }
    .inbound-history-edit-table .mud-input {
        font-size: 13px;
        width: 100%;
        min-width: 0;
    }
    .inbound-history-edit-table th.mud-table-cell {
        white-space: nowrap;
    }
    .inbound-history-edit-table {
        table-layout: fixed;
    }
    /* 分组标题栏与表格容器水平对齐 */
    #inbound-history-table-wrapper {
        overflow: hidden;
    }
    #inbound-history-table-wrapper .col-group-header-scroll {
        overflow: visible !important;
    }
</style>
<MudContainer MaxWidth="MaxWidth.False" Class="mt-4 pl-0">
    <MudCard>
        <MudCardHeader>
            <CardHeaderContent>
                <MudText Typo="Typo.h5" Class="font-weight-bold">
                    <MudIcon Icon="@Icons.Material.Filled.History" Class="mr-2" Color="Color.Primary" />
                    入库历史记录查询及更正
                    @if (!string.IsNullOrEmpty(_warehouseName))
                    {
                        <span Class="font-weight-light" Style="font-size:0.8em;"> — @_warehouseName</span>
                    }
                </MudText>
            </CardHeaderContent>
            <CardHeaderActions>
                <MudButton Variant="Variant.Text" Color="Color.Default" OnClick="GoBack">返回</MudButton>
            </CardHeaderActions>
        </MudCardHeader>

        <MudCardContent>
            <!-- 工单号不匹配通知 -->
            @if (_mismatchBatches.Count > 0)
            {
                <MudAlert Severity="Severity.Warning" Variant="Variant.Filled" Class="mb-4">
                    <div>
                        @foreach (var item in _mismatchBatches)
                        {
                            <div>入库批次 "@item.BatchNo" 的工单号 "@item.WorkOrderNo" 已不存在，需修改！</div>
                        }
                    </div>
                </MudAlert>
            }
            <!-- 筛选栏 -->
            <MudGrid Class="mb-2">
                <MudItem xs="12" md="6">
                    <MudTextField T="string"
                                  Value="_searchKeyword"
                                  ValueChanged="@OnSearchChanged"
                                  Label="模糊搜索 - 批次/炉号/工单号/来料单位"
                                  Immediate="true"
                                  DebounceInterval="500"
                                  Clearable="true"
                                  ClearButton="true"
                                  Adornment="Adornment.End"
                                  AdornmentIcon="@Icons.Material.Filled.Search" />
                </MudItem>
                <MudItem xs="12" md="3">
                    <MudTextField T="string"
                                  Value="_dateFrom"
                                  ValueChanged="@OnDateFromChanged"
                                  Placeholder="yyyy-MM-dd"
                                  Label="入库日期从"
                                  Immediate="true"
                                  DebounceInterval="500"
                                  Clearable="true"
                                  ClearButton="true" />
                </MudItem>
                <MudItem xs="12" md="3">
                    <MudTextField T="string"
                                  Value="_dateTo"
                                  ValueChanged="@OnDateToChanged"
                                  Placeholder="yyyy-MM-dd"
                                  Label="入库日期至"
                                  Immediate="true"
                                  DebounceInterval="500"
                                  Clearable="true"
                                  ClearButton="true" />
                </MudItem>
            </MudGrid>

            <!-- 工具栏 -->
            <div class="woe-toolbar" style="min-height:28px;padding:2px 0;display:flex;align-items:center;">
                <div class="d-flex align-center">
                    <ColumnDisplaySelect Columns="_allColumns"
                                         OnColumnToggle="OnColumnToggle"
                                         OnMoveUp="MoveColumnUp"
                                         OnMoveDown="MoveColumnDown" />
                    <MudButton Variant="Variant.Text" Size="Size.Small"
                               Color="Color.Default"
                               StartIcon="@Icons.Material.Filled.RestartAlt"
                               OnClick="ResetColumnDisplay" Class="ml-2">
                        重置
                    </MudButton>
                </div>
                <div class="d-flex align-center" style="margin-left:auto;">
                    <MudButton Variant="Variant.Outlined" Size="Size.Small"
                               Color="Color.Info"
                               StartIcon="@Icons.Material.Filled.Print"
                               Disabled="@(!_selectedItems.Any())"
                               OnClick="PrintSelected" Class="mr-1">
                        打印选中 (@_selectedItems.Count)
                    </MudButton>
                    <MudButton Variant="Variant.Text" Size="Size.Small"
                               Color="Color.Info"
                               StartIcon="@Icons.Material.Filled.Print"
                               OnClick="PrintAll" Class="mr-4">
                        打印全部
                    </MudButton>
                    <MudText Typo="Typo.body2" Class="ml-4">
                        共 @_totalCount 条记录
                    </MudText>
                </div>
            </div>
            <!-- 数据表格（内联编辑） -->
            <div id="inbound-history-table-wrapper">
            @* 分组标题栏 *@
            <div class="col-group-header-scroll">
                <div class="col-group-header-bar" style="width: @(_totalTableWidth)px">
                    <div class="col-group-header-item" style="width:40px;flex:none;"></div>
                    @foreach (var gh in _groupHeaders)
                    {
                        <div class="col-group-header-item @gh.CssClass" style="width: @(gh.TotalWidth)px">
                            <span class="col-group-badge">@gh.GroupName</span>
                        </div>
                    }
                    <div class="col-group-header-item" style="width:150px;flex:none;"></div>
                </div>
            </div>
            <MudTable @ref="_table" T="InventoryBatchDto" ServerData="@LoadDataFromServer"
                      Dense="true" Hover="true"
                      Elevation="0" Striped="true" RowsPerPage="@_pageSize" RowsPerPageLabel="每页行数:"
                      Class="mt-0 auto-table inbound-history-edit-table compact-table">
                <HeaderContent>
                    <MudTh Style="width: 40px;">
                        <MudCheckBox T="bool" @bind-Value="allSelected" Dense="true" />
                    </MudTh>
                    @{
                        int? _prevGk = null;
                    }
                    @foreach (var col in _visibleColumns)
                    {
                        var _isGroupStart = col.GroupKey.HasValue && col.GroupKey != _prevGk;
                        _prevGk = col.GroupKey;
                        var _headerClass = GetHeaderGroupCss(col.GroupKey, _isGroupStart);
                        <MudTh Class="@_headerClass" Style="@($"width:{GetColWidth(col.Key)}px")">
                            <div style="display:inline-flex; align-items:center; gap:4px;">
                                <span @onclick='() => ToggleSort(col.Key)' style="cursor:pointer" class="th-label">
                                    @col.Label
                                    @if (col.IsRequired)
                                    {
                                        <span class="required-star">*</span>
                                    }
                                    @if (sortColumn == col.Key) {@(sortDescending ? " ▼" : " ▲")}
                                </span>
                                @if (col.FilterType != null)
                                {
                                    <ExcelFilter T="InventoryBatchDto"
                                                 Label="@col.Label"
                                                 FieldKey="@col.Key"
                                                 FilterOptions="@(_filterContextOptions.GetValueOrDefault(col.Key))"
                                                 ActiveFilterValues="@(_columnFilters.GetValueOrDefault(col.Key))"
                                                 FilterChanged="@(args => OnColumnFilterChanged(args.fieldKey, args.selectedValues))" />

                                }
                            </div>
                        </MudTh>
                    }
                    <MudTh Style="width:150px;">操作</MudTh>
                </HeaderContent>
                <RowTemplate Context="item">
                    @{
                        int? _prevGkEdit = null;
                        int? _prevGkView = null;
                    }
                    @if (_editingRowId == item.Id)
                    {
                        <MudTd Style="width: 40px;"></MudTd>
                        @foreach (var col in _visibleColumns)
                        {
                            var _isGroupStart2 = col.GroupKey.HasValue && col.GroupKey != _prevGkEdit;
                            _prevGkEdit = col.GroupKey;
                            var _cellClass = GetCellGroupCss(col.GroupKey, _isGroupStart2);
                            <MudTd Class="@_cellClass" Style="@($"width:{GetColWidth(col.Key)}px")">@RenderInlineEditor(item, col)</MudTd>
                        }
                        <MudTd>
                            <MudIconButton Icon="@Icons.Material.Filled.Check" Color="Color.Success"
                                           Size="Size.Small" Title="确认更改"
                                           OnClick="() => SaveRow(item)"
                                           Disabled="@_savingItemId.HasValue" />
                            <MudIconButton Icon="@Icons.Material.Filled.Close" Color="Color.Default"
                                           Size="Size.Small" Title="取消"
                                           OnClick="CancelEdit" />
                        </MudTd>
                    }
                    else
                    {
                        <MudTd Style="width: 40px;">
                            <MudCheckBox T="bool"
                                         Value="@_selectedItems.Contains(item)"
                                         ValueChanged="@((v) => { if(v) _selectedItems.Add(item); else _selectedItems.Remove(item); StateHasChanged(); })"
                                         Dense="true" />
                        </MudTd>
                        @foreach (var col in _visibleColumns)
                        {
                            var _isGroupStart3 = col.GroupKey.HasValue && col.GroupKey != _prevGkView;
                            _prevGkView = col.GroupKey;
                            var _cellClass = GetCellGroupCss(col.GroupKey, _isGroupStart3);
                            <MudTd Class="@_cellClass" Style="@($"width:{GetColWidth(col.Key)}px")">@RenderCell(item, col)</MudTd>
                        }
                        <MudTd>
                            <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary"
                                           Size="Size.Small" Title="更改"
                                           OnClick="() => StartEdit(item)" />
                            <MudIconButton Icon="@Icons.Material.Filled.DeleteForever" Color="Color.Error"
                                           Size="Size.Small" Title="物理删除"
                                           OnClick="() => ConfirmDelete(item)" />
                        </MudTd>
                    }
                </RowTemplate>
                <FooterContent>
                    @{
                        int? _prevGkFooter = null;
                    }
                    <MudTd Class="col-footer-cell"></MudTd>
                    @foreach (var col in _visibleColumns)
                    {
                        var _isGroupStart4 = col.GroupKey.HasValue && col.GroupKey != _prevGkFooter;
                        _prevGkFooter = col.GroupKey;
                        var _footerClass = GetCellGroupCss(col.GroupKey, _isGroupStart4);
                        <MudTd Class="@(_footerClass + " col-footer-cell")" Style="@($"width:{GetColWidth(col.Key)}px")"><span class="col-footer-sum">@RenderFooterCell(col)</span></MudTd>
                    }
                    <MudTd Class="col-footer-cell"></MudTd>
                </FooterContent>
                <PagerContent>
                    <MudTablePager PageSizeOptions="new int[]{10,15,25,50,100}" />
                </PagerContent>
                <NoRecordsContent>
                    <MudText Class="d-flex justify-center pa-4" Color="Color.Secondary">暂无入库记录</MudText>
                </NoRecordsContent>
            </MudTable>
            </div>
        </MudCardContent>
    </MudCard>
</MudContainer>

