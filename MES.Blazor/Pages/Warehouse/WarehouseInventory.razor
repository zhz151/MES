@page "/warehouse"
@page "/warehouse/{Code}"
@using MES.Blazor.Services
@using MES.Core.Models
@using MES.Blazor.Helpers
@using Microsoft.AspNetCore.Authorization
@using MES.Blazor.Models
@using MES.Core.DTOs.Warehouse
@using System.Text.Json
@inject WarehouseService WarehouseService
@inject InventoryService InventoryService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject ColumnPrefsService ColumnPrefs
@inject OutboundStateService OutboundState
@inject PageStateService PageState
@inject IJSRuntime JS
@inject HttpClient Http
@inject MaterialPlanService MaterialPlanService
@inject NotificationService NotificationService
@inject AuthenticationStateProvider AuthProvider
@attribute [Authorize(Roles = Roles.Policies.WarehouseView)]

@if (string.IsNullOrEmpty(Code))
{
    @* ======== 仓库首页：4个仓库卡片入口 ======== *@

    <MudContainer MaxWidth="MaxWidth.False" Class="mt-4 pl-0">
        <MudCard>
            <MudCardHeader>
                <CardHeaderContent>
                    <MudText Typo="Typo.h5" Class="font-weight-bold">
                        <MudIcon Icon="@Icons.Material.Filled.Warehouse" Class="mr-2" Color="Color.Primary" />
                        仓库管理
                    </MudText>
                </CardHeaderContent>
                <CardHeaderActions>
                </CardHeaderActions>
            </MudCardHeader>
            <MudCardContent>
                <MudGrid>
                    @foreach (var wh in warehouses)
                    {
                        <MudItem xs="12" sm="6" md="3">
                                <MudCard Class="warehouse-card" Style="@GetCardStyle(wh.IsActive)"
                                         @onclick="() => NavigateToWarehouse(wh.Code)">
                                    <MudCardContent Class="text-center pa-6">
                                        <MudIcon Icon="@GetWarehouseIcon(wh.Code)" Size="Size.Large" Color="Color.Primary" Class="mb-4" />
                                        <MudText Typo="Typo.h6" Class="font-weight-bold">@wh.Name</MudText>
                                        <MudText Typo="Typo.body2" Color="Color.Secondary">@wh.Code</MudText>
                                    </MudCardContent>
                                </MudCard>
                            </MudItem>
                    }
                </MudGrid>
            </MudCardContent>
        </MudCard>
    </MudContainer>
}
else
{
    <style>
    /* 分组标题栏与表格容器水平对齐 */
    #warehouse-inventory-table-wrapper {
        overflow: hidden;
    }
    #warehouse-inventory-table-wrapper .col-group-header-scroll {
        overflow: visible !important;
    }
    </style>
    @* ======== 单个仓库详情页 ======== *@
    <MudContainer MaxWidth="MaxWidth.False" Class="mt-4 pl-0">
        <MudCard>
            <MudCardHeader>
                <CardHeaderContent>
                    <MudText Typo="Typo.h5" Class="font-weight-bold">
                        <MudIcon Icon="@GetWarehouseIcon(warehouseCode)" Class="mr-2" Color="Color.Primary" />
                        @warehouseName
                    </MudText>
                </CardHeaderContent>
                <CardHeaderActions>
                    <MudButton Variant="Variant.Text" Color="Color.Primary"
                               Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.History"
                               OnClick="NavigateToInboundHistory">
                        入库历史
                    </MudButton>
                    <MudButton Variant="Variant.Text" Color="Color.Warning"
                               Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.History"
                               OnClick="NavigateToOutboundHistory">
                        出库历史
                    </MudButton>
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.AddCircleOutline"
                               OnClick="NavigateToInbound">
                        入库
                    </MudButton>
                </CardHeaderActions>
            </MudCardHeader>

            <MudCardContent>
                <!-- 待出库用料计划通知 -->
                @if (_pendingPlanBatches.Count > 0)
                {
                    <MudAlert Severity="Severity.Warning" Variant="Variant.Filled" Class="mb-4">
                        <div>
                            @foreach (var item in _pendingPlanBatches)
                            {
                                <div>仓库批 "@item.BatchNo"用料计划，（@item.PlanType，@item.WorkOrderNo，需出库 @(item.RequiredQuantity?.ToString() ?? "-")支 + @item.RequiredWeight.ToString("G29")kg），请出库！</div>
                            }
                        </div>
                    </MudAlert>
                }
                <!-- 工单内容变更通知（当前仓库相关） -->
                @if (_warehouseWorkOrderChangedNotices is { Count: > 0 })
                {
                    <MudAlert Severity="Severity.Info" Variant="Variant.Filled" Class="mb-4">
                        <div>
                            @foreach (var notice in _warehouseWorkOrderChangedNotices)
                            {
                                <div>@notice.Title — @notice.Content</div>
                            }
                        </div>
                        <MudButton Variant="Variant.Text" Color="Color.Inherit" Class="mt-2"
                                   OnClick="DismissWorkOrderChangedNotices">
                            已知晓，不再提醒
                        </MudButton>
                    </MudAlert>
                }
                <!-- 顶部：模糊搜索 + 日期搜索 + 出库筛选切换 -->
                <MudGrid Class="mb-2">
                    <MudItem xs="12" md="6">
                        <MudTextField T="string"
                                      Value="_searchKeyword" ValueExpression="@(() => _searchKeyword)"
                                      ValueChanged="@OnSearchChanged"
                                      Label="模糊搜索 - 批次/炉号/工单号/订单号"
                                      Immediate="true"
                                      DebounceInterval="500"
                                      Adornment="Adornment.End"
                                      AdornmentIcon="@Icons.Material.Filled.Search" />
                    </MudItem>
                    <MudItem xs="12" md="3">
                        <MudTextField T="string"
                                      Value="_dateFrom"
                                      ValueChanged="@OnDateFromChanged"
                                      Placeholder="yyyy-MM-dd"
                                      Label="入库日期从"
                                      Immediate="true"
                                      DebounceInterval="500"
                                     />
                    </MudItem>
                    <MudItem xs="12" md="3">
                        <MudTextField T="string"
                                      Value="_dateTo"
                                      ValueChanged="@OnDateToChanged"
                                      Placeholder="yyyy-MM-dd"
                                      Label="入库日期至"
                                      Immediate="true"
                                      DebounceInterval="500"
                                     />
                    </MudItem>
                    <MudItem xs="12" Class="d-flex align-center justify-end">
                        <MudButton Variant="@(_outboundMode ? Variant.Filled : Variant.Outlined)"
                                   Color="Color.Warning"
                                   StartIcon="@Icons.Material.Filled.FilterList"
                                   OnClick="ToggleOutboundMode"
                                   Size="Size.Small"
                                   Class="mr-2">
                            @if (_outboundMode)
                            {
                                <span>退出筛选</span>
                            }
                            else
                            {
                                <span>出库筛选</span>
                            }
                        </MudButton>
                        @if (_outboundMode)
                        {
                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Warning"
                                       StartIcon="@Icons.Material.Filled.ExitToApp"
                                       Disabled="@(_selectedItems.Count == 0)"
                                       OnClick="NavigateToOutbound"
                                       Size="Size.Small">
                                批量出库 (@_selectedItems.Count)
                            </MudButton>
                        }
                    </MudItem>
                </MudGrid>

                <!-- 工具栏 -->
                <div class="list-toolbar">
                    <div class="d-flex align-center">
                        <ColumnDisplaySelect Columns="_allColumns"
                                             OnColumnToggle="OnColumnToggle"
                                             OnMoveUp="MoveColumnUp"
                                             OnMoveDown="MoveColumnDown" />
                        <MudButton Variant="Variant.Text" Size="Size.Small"
                                   Color="Color.Default"
                                   StartIcon="@Icons.Material.Filled.RestartAlt"
                                   OnClick="ResetColumnDisplay" Class="ml-2">
                            重置
                        </MudButton>
                    </div>
                    <div class="d-flex align-center" style="margin-left:auto;">
                        <MudButton Variant="Variant.Outlined" Size="Size.Small"
                                   Color="Color.Info"
                                   StartIcon="@Icons.Material.Filled.Print"
                                   Disabled="@(!_selectedItems.Any())"
                                   OnClick="PrintSelected" Class="mr-1">
                            打印选中 (@_selectedItems.Count)
                        </MudButton>
                        @if (_outboundMode)
                        {
                            <MudText Typo="Typo.body2" Class="d-flex align-center" Style="color: var(--mud-palette-warning);">
                                已选 @_selectedItems.Count 项
                            </MudText>
                        }
                        <MudText Typo="Typo.body2" Class="d-flex align-center ml-4">
                            共 @_totalCount 条记录
                        </MudText>
                    </div>
                </div>
                <!-- 数据表格 -->
                <div id="warehouse-inventory-table-wrapper">
                @* 分组标题栏 *@
                <div class="col-group-header-scroll">
                    <div class="col-group-header-bar" style="width: @(_totalTableWidth)px">
                        <div class="col-group-header-item" style="width:40px;flex:none;"></div>
                        @foreach (var gh in _groupHeaders)
                        {
                            <div class="col-group-header-item @gh.CssClass" style="width: @(gh.TotalWidth)px">
                                <span class="col-group-badge">@gh.GroupName</span>
                            </div>
                        }
                    </div>
                </div>
                <MudTable @ref="table"
                          T="InventoryBatchDto"
                          ServerData="@LoadDataFromServer"
                          Dense="true"
                          Hover="true"
                          Class="mt-0 auto-table compact-table"
                          Elevation="0"
                          RowsPerPage="@_pageSize"
                          RowsPerPageLabel="每页行数:"
                          Striped="true">
                    <HeaderContent>
                        <MudTh Style="width: 40px;">
                            <MudCheckBox T="bool"
                                         Value="@(_pageItems.Any() && _pageItems.All(i => _selectedItems.Contains(i)))"
                                         ValueChanged="@((v) => { if(v) { foreach(var i in _pageItems) _selectedItems.Add(i); } else { foreach(var i in _pageItems) _selectedItems.Remove(i); } StateHasChanged(); })"
                                         Dense="true" />
                        </MudTh>
                        @{
                            int _prevGk = 0;
                            bool _isGroupStart = true;
                        }
                        @foreach (var col in _visibleColumns)
                        {
                            _isGroupStart = col.GroupKey.HasValue && col.GroupKey > 0 && col.GroupKey != _prevGk;
                            _prevGk = col.GroupKey ?? 0;
                            var _headerClass = GetHeaderGroupCss(col.GroupKey, _isGroupStart);
                            <MudTh Class="@_headerClass" Style="@($"width:{GetColWidth(col.Key)}px")">
                                <div style="display:inline-flex; align-items:center; gap:4px;">
                                    <span @onclick='() => ToggleSort(col.Key)' style="cursor:pointer" class="th-label">@col.Label @if (sortColumn == col.Key) {@(sortDescending ? " ▼" : " ▲")}</span>
                                    @if (col.FilterType != null)
                                    {
                                        <ExcelFilter T="InventoryBatchDto"
                                                     Label="@col.Label"
                                                     FieldKey="@col.Key"
                                                     FilterOptions="@(_filterContextOptions.GetValueOrDefault(col.Key))"
                                                     ActiveFilterValues="@(_columnFilters.GetValueOrDefault(col.Key))"
                                                     FilterChanged="@(args => OnColumnFilterChanged(args.fieldKey, args.selectedValues))" />

                                    }
                                </div>
                            </MudTh>
                        }
                    </HeaderContent>
                    <RowTemplate Context="item">
                        <MudTd Style="width: 40px;">
                            <MudCheckBox T="bool"
                                         Value="@_selectedItems.Contains(item)"
                                         ValueChanged="@((v) => { ToggleItemSelection(item); })"
                                         Dense="true" />
                        </MudTd>
                        @{
                            int _prevGkCell = 0;
                            bool _isGroupStartCell = true;
                        }
                        @foreach (var col in _visibleColumns)
                        {
                            _isGroupStartCell = col.GroupKey.HasValue && col.GroupKey > 0 && col.GroupKey != _prevGkCell;
                            _prevGkCell = col.GroupKey ?? 0;
                            var _cellClass = GetCellGroupCss(col.GroupKey, _isGroupStartCell);
                            <MudTd Class="@_cellClass" Style="@($"width:{GetColWidth(col.Key)}px")">@RenderCell(item, col)</MudTd>
                        }
                    </RowTemplate>
                    <FooterContent>
                        @{
                            int _prevGkFooter = 0;
                            bool _isGroupStartFooter = true;
                        }
                        <MudTd Class="col-footer-cell"></MudTd>
                        @foreach (var col in _visibleColumns)
                        {
                            _isGroupStartFooter = col.GroupKey.HasValue && col.GroupKey > 0 && col.GroupKey != _prevGkFooter;
                            _prevGkFooter = col.GroupKey ?? 0;
                            var _footerClass = GetCellGroupCss(col.GroupKey, _isGroupStartFooter);
                            <MudTd Class="@(_footerClass + " col-footer-cell")" Style="@($"width:{GetColWidth(col.Key)}px")"><span class="col-footer-sum">@RenderFooterCell(col)</span></MudTd>
                        }
                    </FooterContent>
                    <PagerContent>
                        <MudTablePager PageSizeOptions="new int[]{10,15,25,50,100}" />
                    </PagerContent>
                    <NoRecordsContent>
                        <MudText Class="d-flex justify-center pa-4" Color="Color.Secondary">暂无数据</MudText>
                    </NoRecordsContent>
                </MudTable>
                </div>
            </MudCardContent>
        </MudCard>
    </MudContainer>
}
