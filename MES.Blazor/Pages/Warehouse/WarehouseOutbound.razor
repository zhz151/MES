@page "/warehouse/outbound"
@page "/warehouse/outbound/{Code}"
@using MES.Core.Enums
@using MES.Blazor.Helpers
@using MES.Blazor.Models
@using MES.Blazor.Services
@using MES.Core.Models
@using Microsoft.AspNetCore.Authorization
@inject InventoryService InventoryService
@inject OutboundStateService OutboundState
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject IJSRuntime JS
@inject ColumnPrefsService ColumnPrefs
@attribute [Authorize]


<MudContainer MaxWidth="MaxWidth.False" Class="mt-4">
    <MudCard>
        <MudCardHeader>
            <CardHeaderContent>
                <MudText Typo="Typo.h5" Class="font-weight-bold">
                    <MudIcon Icon="@Icons.Material.Filled.ExitToApp" Class="mr-2" Color="Color.Warning" />
                    批量出库
                </MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">
                    仓库：<strong>@_warehouseName</strong> ｜ 待出库 @_items.Count 项
                </MudText>
            </CardHeaderContent>
            <CardHeaderActions>
                <MudButton Variant="Variant.Text" Color="Color.Default" OnClick="GoBack">返回</MudButton>
            </CardHeaderActions>
        </MudCardHeader>

        <MudCardContent>
            <!-- ============ 出库批次明细 ============ -->
            @if (_items.Count == 0)
            {
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="GoToWarehouse">
                    前往仓库选择
                </MudButton>
            }
            else
            {
            <div class="inbound-table-scroll">
                <!-- 工具栏：列显隐 -->
                <div class="woe-toolbar" style="min-height:28px;padding:2px 0;display:flex;align-items:center;">
                    <div class="d-flex align-center">
                        <ColumnDisplaySelect Columns="_allColumns"
                                             OnColumnToggle="OnColumnToggle"
                                             OnMoveUp="MoveColumnUp"
                                             OnMoveDown="MoveColumnDown" />
                        <MudButton Variant="Variant.Text" Size="Size.Small"
                                   Color="Color.Default"
                                   StartIcon="@Icons.Material.Filled.RestartAlt"
                                   OnClick="ResetColumnDisplay" Class="ml-2">
                            重置
                        </MudButton>
                    </div>
                </div>
                <MudTable Items="@_items" Dense="true" Hover="true" Elevation="0" Striped="true" Class="auto-table mb-4">
                    <HeaderContent>
                        @foreach (var col in _visibleColumns)
                        {
                            <MudTh Style="@($"width:{col.Width}px")">
                                @col.Label
                                @if (col.IsRequired)
                                {
                                    <span class="required-star">*</span>
                                }
                            </MudTh>
                        }
                        <MudTh Style="width:100px;">操作</MudTh>
                    </HeaderContent>
                    <RowTemplate Context="item">
                        @{
                            var idx = _items.IndexOf(item);
                        }
                        @foreach (var col in _visibleColumns)
                        {
                            <MudTd>@RenderCell(item, col, idx)</MudTd>
                        }
                        <MudTd>
                            <div class="d-flex flex-nowrap gap-1" style="gap:2px;">
                                @if (idx > 0)
                                {
                                    <MudIconButton Icon="@Icons.Material.Filled.ContentCopy" Size="Size.Small"
                                                   Color="Color.Info" Title="自动填充"
                                                   OnClick="() => AutoFill(idx)" />
                                }
                                <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small"
                                               Color="Color.Error" Title="取消此条"
                                               OnClick="() => RemoveItem(item)" />
                            </div>
                        </MudTd>
                    </RowTemplate>
                </MudTable>
            </div>

                <!-- 合计 -->
                <MudText Typo="Typo.body2" Class="font-weight-bold mb-4">
                    合计出库：@_items.Sum(i => i.OutboundQuantity) 支 / @_items.Sum(i => i.OutboundWeight).ToString("G29") kg
                    @if (_items.Any(i => i.OutboundMeters.HasValue))
                    {
                        @:/ @_items.Sum(i => i.OutboundMeters ?? 0).ToString("G29") 米
                    }
                </MudText>

                @if (!string.IsNullOrEmpty(_errorMessage))
                {
                    <MudText Typo="Typo.body2" Color="Color.Error" Class="mb-4">@_errorMessage</MudText>
                }

                <MudGrid Class="mt-4">
                    <MudItem xs="12" Class="d-flex justify-end">
                        <MudButton Variant="Variant.Text" Color="Color.Default" OnClick="GoBack" Class="mr-2">取消</MudButton>
                        <MudButton Variant="Variant.Filled" Color="Color.Warning"
                                   StartIcon="@Icons.Material.Filled.ExitToApp"
                                   OnClick="Submit" Loading="@_isSubmitting"
                                   Size="Size.Large">
                            确认出库 (@_items.Count 项)
                        </MudButton>
                    </MudItem>
                </MudGrid>
            }
        </MudCardContent>
    </MudCard>
</MudContainer>

@code {
    // ========== 出库条目模型（独立 DTO，不继承，避免 new 隐藏基类属性） ==========

    private class OutboundItem
    {
        public int Id { get; set; }
        public string BatchNo { get; set; } = string.Empty;
        public int WarehouseId { get; set; }
        public string? WarehouseName { get; set; }
        public string? MaterialType { get; set; }
        public string PlantGrade { get; set; } = string.Empty;
        public string Specification { get; set; } = string.Empty;
        public int RemainingQuantity { get; set; }
        public decimal RemainingWeight { get; set; }
        public decimal? RemainingMeters { get; set; }
        public int OutboundQuantity { get; set; }
        public decimal OutboundWeight { get; set; }
        public decimal? OutboundMeters { get; set; }
        public OutboundType OutboundType { get; set; } = OutboundType.ProductionPick;
        public string? WorkOrderNo { get; set; }
        public string? ReturnSourceBatchNo { get; set; }
        public string? SourceOrderNo { get; set; }
        public string? TargetCompany { get; set; }
        public string? Remark { get; set; }
    }

    // ========== 列定义 ==========

    private List<ColumnDef> _allColumns = new();
    private List<ColumnDef> _visibleColumns =>
        _allColumns.Where(c => c.Visible).ToList();

    private static List<ColumnDef> GetAllColumnDefs() => new()
    {
        new() { Key = "BatchNo",             Label = "批次号", Width = "120" },
        new() { Key = "PlantGrade",          Label = "工厂牌号", Width = "120" },
        new() { Key = "Specification",       Label = "规格", Width = "120" },
        new() { Key = "RemainingQuantity",   Label = "剩余支数", Width = "80" },
        new() { Key = "RemainingWeight",     Label = "剩余重量(kg)", Width = "80" },
        new() { Key = "RemainingMeters",     Label = "剩余米数", Width = "80" },
        new() { Key = "OutboundDate",        Label = "出库日期", IsRequired = true, Width = "120" },
        new() { Key = "OutboundQuantity",    Label = "出库支数", IsRequired = true, Width = "80" },
        new() { Key = "OutboundWeight",      Label = "出库重量(kg)", IsRequired = true, Width = "80" },
        new() { Key = "OutboundMeters",      Label = "出库米数", Width = "80" },
        new() { Key = "OutboundType",        Label = "出库类型", IsRequired = true, Width = "120" },
        new() { Key = "WorkOrderNo",         Label = "出库工单号", Width = "120" },
        new() { Key = "ReturnSourceBatchNo", Label = "退货-原仓库批", Width = "120" },
        new() { Key = "SourceOrderNo",       Label = "委外-穿孔号", Width = "120" },
        new() { Key = "TargetCompany",       Label = "目标单位", Width = "120" },
        new() { Key = "Remark",              Label = "备注", Width = "120" },
    };

    // ========== 列适配（按仓库类型隐藏无关列） ==========

    private void ApplyWarehouseDefaults()
    {
        foreach (var c in _allColumns) { c.IsApplicable = true; c.Visible = true; }
        switch (_warehouseCode)
        {
            case "RAW":
                SetNotApplicable("RemainingMeters");
                SetNotApplicable("OutboundMeters");
                break;
        }
    }

    private static void SetNotApplicable(List<ColumnDef> cols, string key)
    {
        var c = cols.FirstOrDefault(x => x.Key == key);
        if (c != null) { c.IsApplicable = false; c.Visible = false; }
    }

    private void SetNotApplicable(string key)
    {
        SetNotApplicable(_allColumns, key);
    }

    private void HideNonApplicable()
    {
        foreach (var c in _allColumns)
            if (!c.IsApplicable) c.Visible = false;
    }

    // ========== 列显隐操作 ==========

    private async Task OnColumnToggle(ColumnDef col)
    {
        await SaveColumnPrefs();
    }

    private async Task SaveColumnPrefs()
    {
        var key = string.IsNullOrEmpty(_warehouseCode) ? "default" : _warehouseCode.ToLowerInvariant();
        await ColumnPrefs.SaveAsync("outbound_batch", key, _allColumns);
    }

    private async Task ResetColumnDisplay()
    {
        _allColumns = GetAllColumnDefs();
        await SaveColumnPrefs();
    }

    private async Task MoveColumnUp(ColumnDef col)
    {
        await SaveColumnPrefs();
    }

    private async Task MoveColumnDown(ColumnDef col)
    {
        await SaveColumnPrefs();
    }

    // ========== 单元格渲染 ==========

    private RenderFragment RenderCell(OutboundItem item, ColumnDef col, int idx) => builder =>
    {
        switch (col.Key)
        {
            case "BatchNo":
                builder.OpenElement(0, "small");
                builder.AddContent(1, item.BatchNo);
                builder.CloseElement();
                break;
            case "PlantGrade":
                builder.OpenElement(0, "small");
                builder.AddContent(1, item.PlantGrade);
                builder.CloseElement();
                break;
            case "Specification":
                builder.OpenElement(0, "small");
                builder.AddContent(1, item.Specification);
                builder.CloseElement();
                break;
            case "RemainingQuantity":
                builder.OpenComponent<MudChip>(0);
                builder.AddAttribute(1, "Size", Size.Small);
                builder.AddAttribute(2, "Color", Color.Success);
                builder.AddAttribute(3, "ChildContent", (RenderFragment)(b2 => b2.AddContent(0, item.RemainingQuantity)));
                builder.CloseComponent();
                break;
            case "RemainingWeight":
                builder.OpenComponent<MudChip>(0);
                builder.AddAttribute(1, "Size", Size.Small);
                builder.AddAttribute(2, "Color", Color.Success);
                builder.AddAttribute(3, "ChildContent", (RenderFragment)(b2 => b2.AddContent(0, item.RemainingWeight.ToString("G29"))));
                builder.CloseComponent();
                break;
            case "RemainingMeters":
                if (item.RemainingMeters.HasValue)
                {
                    builder.OpenComponent<MudChip>(0);
                    builder.AddAttribute(1, "Size", Size.Small);
                    builder.AddAttribute(2, "Color", Color.Success);
                    builder.AddAttribute(3, "ChildContent", (RenderFragment)(b2 => b2.AddContent(0, item.RemainingMeters.Value.ToString("G29"))));
                    builder.CloseComponent();
                }
                break;
            case "OutboundDate":
                builder.OpenComponent<MudTextField<string>>(0);
                builder.AddAttribute(1, "Variant", Variant.Outlined);
                builder.AddAttribute(2, "Dense", true);
                builder.AddAttribute(3, "Value", _dateText);
                builder.AddAttribute(4, "ValueChanged", EventCallback.Factory.Create<string?>(this, v => _dateText = v ?? DateTime.Today.ToString("yyyy-MM-dd")));
                builder.CloseComponent();
                break;
            case "OutboundQuantity":
                builder.OpenComponent<MudNumericField<int>>(0);
                builder.AddAttribute(1, "Min", 1);
                builder.AddAttribute(2, "Max", item.RemainingQuantity);
                builder.AddAttribute(3, "Variant", Variant.Outlined);
                builder.AddAttribute(4, "Dense", true);
                builder.AddAttribute(5, "Class", "qty-input");
                builder.AddAttribute(6, "HideSpinButtons", true);
                builder.AddAttribute(7, "Value", item.OutboundQuantity);
                builder.AddAttribute(8, "ValueChanged", EventCallback.Factory.Create<int>(this, v => item.OutboundQuantity = v));
                builder.CloseComponent();
                break;
            case "OutboundWeight":
                builder.OpenComponent<MudNumericField<decimal>>(0);
                builder.AddAttribute(1, "Format", "G29");
                builder.AddAttribute(2, "Min", 0m);
                builder.AddAttribute(3, "Max", item.RemainingWeight);
                builder.AddAttribute(4, "Variant", Variant.Outlined);
                builder.AddAttribute(5, "Dense", true);
                builder.AddAttribute(6, "Class", "qty-input");
                builder.AddAttribute(7, "HideSpinButtons", true);
                builder.AddAttribute(8, "Value", item.OutboundWeight);
                builder.AddAttribute(9, "ValueChanged", EventCallback.Factory.Create<decimal>(this, v => item.OutboundWeight = v));
                builder.CloseComponent();
                break;
            case "OutboundMeters":
                builder.OpenComponent<MudNumericField<decimal>>(0);
                builder.AddAttribute(1, "Format", "G29");
                builder.AddAttribute(2, "Min", 0m);
                builder.AddAttribute(3, "Variant", Variant.Outlined);
                builder.AddAttribute(4, "Dense", true);
                builder.AddAttribute(5, "Class", "qty-input");
                builder.AddAttribute(6, "HideSpinButtons", true);
                builder.AddAttribute(7, "Value", item.OutboundMeters ?? 0m);
                builder.AddAttribute(8, "ValueChanged", EventCallback.Factory.Create<decimal>(this, v => item.OutboundMeters = v));
                builder.CloseComponent();
                break;
            case "OutboundType":
                builder.OpenComponent<MudSelect<OutboundType>>(0);
                builder.AddAttribute(1, "Variant", Variant.Outlined);
                builder.AddAttribute(2, "Dense", true);
                builder.AddAttribute(3, "Value", item.OutboundType);
                builder.AddAttribute(4, "ValueChanged", EventCallback.Factory.Create<OutboundType>(this, v => item.OutboundType = v));
                builder.AddAttribute(5, "ChildContent", (RenderFragment)(b2 =>
                {
                    foreach (var opt in _outboundTypeOptions)
                    {
                        b2.OpenComponent<MudSelectItem<OutboundType>>(0);
                        b2.AddAttribute(1, "Value", Enum.Parse<OutboundType>(opt.Value));
                        b2.AddAttribute(2, "Text", opt.Display);
                        b2.AddAttribute(3, "ChildContent", (RenderFragment)(b3 => b3.AddContent(0, opt.Display)));
                        b2.CloseComponent();
                    }
                }));
                builder.CloseComponent();
                break;
            case "WorkOrderNo":
                builder.OpenComponent<MudTextField<string>>(0);
                builder.AddAttribute(1, "Variant", Variant.Outlined);
                builder.AddAttribute(2, "Dense", true);
                builder.AddAttribute(3, "Value", item.WorkOrderNo);
                builder.AddAttribute(4, "ValueChanged", EventCallback.Factory.Create<string?>(this, v => item.WorkOrderNo = v));
                builder.CloseComponent();
                break;
            case "ReturnSourceBatchNo":
                builder.OpenComponent<MudTextField<string>>(0);
                builder.AddAttribute(1, "Variant", Variant.Outlined);
                builder.AddAttribute(2, "Dense", true);
                builder.AddAttribute(3, "Value", item.ReturnSourceBatchNo);
                builder.AddAttribute(4, "ValueChanged", EventCallback.Factory.Create<string?>(this, v => item.ReturnSourceBatchNo = v));
                builder.CloseComponent();
                break;
            case "SourceOrderNo":
                builder.OpenComponent<MudTextField<string>>(0);
                builder.AddAttribute(1, "Variant", Variant.Outlined);
                builder.AddAttribute(2, "Dense", true);
                builder.AddAttribute(3, "Value", item.SourceOrderNo);
                builder.AddAttribute(4, "ValueChanged", EventCallback.Factory.Create<string?>(this, v => item.SourceOrderNo = v));
                builder.CloseComponent();
                break;
            case "TargetCompany":
                builder.OpenComponent<MudTextField<string>>(0);
                builder.AddAttribute(1, "Variant", Variant.Outlined);
                builder.AddAttribute(2, "Dense", true);
                builder.AddAttribute(3, "Value", item.TargetCompany);
                builder.AddAttribute(4, "ValueChanged", EventCallback.Factory.Create<string?>(this, v => item.TargetCompany = v));
                builder.CloseComponent();
                break;
            case "Remark":
                builder.OpenComponent<MudTextField<string>>(0);
                builder.AddAttribute(1, "Variant", Variant.Outlined);
                builder.AddAttribute(2, "Dense", true);
                builder.AddAttribute(3, "Value", item.Remark);
                builder.AddAttribute(4, "ValueChanged", EventCallback.Factory.Create<string?>(this, v => item.Remark = v));
                builder.CloseComponent();
                break;
        }
    };

    private static readonly List<EnumOption> _outboundTypeOptions = DisplayHelper.GetEnumOptions<OutboundType>();

    // ========== 状态 ==========

    [Parameter] public string? Code { get; set; }

    private string _warehouseCode = string.Empty;
    private string _warehouseName = string.Empty;
    private List<OutboundItem> _items = new();
    private string _dateText = DateTime.Today.ToString("yyyy-MM-dd");
    private bool _isSubmitting;
    private bool _isArrowNavSetup;
    private string _errorMessage = string.Empty;

    // ========== 初始化 ==========

    protected override async Task OnInitializedAsync()
    {
        // 解析仓库代码：优先 URL 参数，回退到 OutboundState
        _warehouseCode = !string.IsNullOrWhiteSpace(Code) ? Code.ToUpperInvariant() : OutboundState.WarehouseCode.ToUpperInvariant();
        _warehouseName = OutboundState.WarehouseName;

        if (string.IsNullOrEmpty(_warehouseCode))
        {
            // 无仓库代码时重定向到仓库首页
            Navigation.NavigateTo("/warehouse", replace: true);
            return;
        }

        // 列定义
        _allColumns = GetAllColumnDefs();
        ApplyWarehouseDefaults();

        // 加载用户偏好
        await LoadColumnPrefsAsync();

        // 从共享状态读取选中的批次
        if (OutboundState.SelectedItems.Count > 0)
        {
            _items = OutboundState.SelectedItems.Select(s => new OutboundItem
            {
                Id = s.Id,
                BatchNo = s.BatchNo,
                WarehouseId = s.WarehouseId,
                WarehouseName = OutboundState.WarehouseName,
                MaterialType = s.MaterialType.ToString(),
                PlantGrade = s.PlantGrade,
                Specification = s.Specification,
                RemainingQuantity = s.RemainingQuantity,
                RemainingWeight = s.RemainingWeight,
                RemainingMeters = s.RemainingMeters,
                // 初始默认值：出库数 = 剩余数；出库工单号 = 仓库批的工单号（可手改）
                OutboundQuantity = s.RemainingQuantity,
                OutboundWeight = s.RemainingWeight,
                OutboundMeters = s.RemainingMeters,
                WorkOrderNo = s.WorkOrderNo,
            }).ToList();
        }
    }

    private async Task LoadColumnPrefsAsync()
    {
        var key = string.IsNullOrEmpty(_warehouseCode) ? "default" : _warehouseCode.ToLowerInvariant();
        var saved = await ColumnPrefs.LoadAsync("outbound_batch", key);
        if (saved.Count > 0)
        {
            foreach (var s in saved)
            {
                var match = _allColumns.FirstOrDefault(c => c.Key == s.Key);
                if (match != null)
                    match.Visible = s.Visible;
            }
            var reordered = new List<ColumnDef>();
            foreach (var s in saved)
            {
                var match = _allColumns.FirstOrDefault(c => c.Key == s.Key);
                if (match != null && !reordered.Contains(match))
                    reordered.Add(match);
            }
            foreach (var c in _allColumns)
            {
                if (!reordered.Contains(c))
                    reordered.Add(c);
            }
            _allColumns = reordered;
        }

        // 最终确保不可用列强制隐藏（用户偏好不可覆盖仓库业务规则）
        HideNonApplicable();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_isArrowNavSetup)
        {
            _isArrowNavSetup = true;
            if (!await JS.InvokeAsync<bool>("enableTableArrowNav", ".inbound-table-scroll"))
                _isArrowNavSetup = false;
        }
    }

    // ========== 提交 ==========

    private async Task Submit()
    {
        _errorMessage = string.Empty;

        var errors = new List<string>();

        // 解析日期
        DateTime parsedDate = default;
        if (string.IsNullOrWhiteSpace(_dateText))
            errors.Add("出库日期不能为空");
        else if (!DateTime.TryParse(_dateText, out var tmpDate))
            errors.Add("出库日期无效，请按 yyyy-MM-dd 格式输入");
        else
            parsedDate = tmpDate.Date;

        for (int i = 0; i < _items.Count; i++)
        {
            var item = _items[i];
            if (item.OutboundQuantity < 1)
                errors.Add($"第{i + 1}行（{item.BatchNo}）：出库支数必须大于0");
            if (item.OutboundQuantity > item.RemainingQuantity)
                errors.Add($"第{i + 1}行（{item.BatchNo}）：出库支数超过剩余量({item.RemainingQuantity})");
            if (item.OutboundWeight <= 0)
                errors.Add($"第{i + 1}行（{item.BatchNo}）：出库重量必须大于0");
            if (item.OutboundWeight > item.RemainingWeight)
                errors.Add($"第{i + 1}行（{item.BatchNo}）：出库重量超过剩余量({item.RemainingWeight:G29}kg)");
            if (item.OutboundType == OutboundType.SubcontractOut
                && item.MaterialType == nameof(MaterialType.RoundBar)
                && string.IsNullOrWhiteSpace(item.SourceOrderNo))
                errors.Add($"第{i + 1}行（{item.BatchNo}）：出库类型为委外出库且物料为圆棒时，「委外-穿孔号」必填");
        }

        if (errors.Any())
        {
            _errorMessage = string.Join("；", errors);
            return;
        }

        var first = _items[0];

        _isSubmitting = true;
        StateHasChanged();

        try
        {
            var request = new BatchOutboundRequest
            {
                OutboundType = first.OutboundType,
                WorkOrderNo = string.IsNullOrEmpty(first.WorkOrderNo) ? null : first.WorkOrderNo,
                ReturnSourceBatchNo = string.IsNullOrEmpty(first.ReturnSourceBatchNo) ? null : first.ReturnSourceBatchNo,
                SourceOrderNo = string.IsNullOrEmpty(first.SourceOrderNo) ? null : first.SourceOrderNo,
                TargetCompany = string.IsNullOrEmpty(first.TargetCompany) ? null : first.TargetCompany,
                OutboundDate = parsedDate,
                Remark = string.IsNullOrEmpty(first.Remark) ? null : first.Remark,
                Items = _items.Select(i => new OutboundItemRequest
                {
                    InventoryBatchId = i.Id,
                    OutboundQuantity = i.OutboundQuantity,
                    OutboundWeight = i.OutboundWeight,
                    OutboundMeters = i.OutboundMeters,
                    OutboundType = i.OutboundType,
                    WorkOrderNo = string.IsNullOrEmpty(i.WorkOrderNo) ? null : i.WorkOrderNo,
                    ReturnSourceBatchNo = string.IsNullOrEmpty(i.ReturnSourceBatchNo) ? null : i.ReturnSourceBatchNo,
                    SourceOrderNo = string.IsNullOrEmpty(i.SourceOrderNo) ? null : i.SourceOrderNo,
                    TargetCompany = string.IsNullOrEmpty(i.TargetCompany) ? null : i.TargetCompany,
                    Remark = string.IsNullOrEmpty(i.Remark) ? null : i.Remark,
                }).ToList()
            };

            var result = await InventoryService.BatchOutboundAsync(request);

            if (result.Success && result.Data != null)
            {
                Snackbar.Add($"批量出库成功，共{result.Data.SuccessCount}条", Severity.Success);
                var returnCode = _warehouseCode.ToLowerInvariant();
                OutboundState.Clear();
                Navigation.NavigateTo($"/warehouse/{returnCode}");
            }
            else
            {
                _errorMessage = result.Message ?? "批量出库失败";
            }
        }
        catch (Exception ex)
        {
            _errorMessage = $"网络错误: {ex.Message}";
        }
        finally
        {
            _isSubmitting = false;
            StateHasChanged();
        }
    }

    // ========== 行操作 ==========

    private void AutoFill(int idx)
    {
        if (idx <= 0 || idx >= _items.Count) return;
        var prev = _items[idx - 1];
        var curr = _items[idx];
        curr.OutboundType = prev.OutboundType;
        curr.WorkOrderNo = prev.WorkOrderNo;
        curr.ReturnSourceBatchNo = prev.ReturnSourceBatchNo;
        curr.SourceOrderNo = prev.SourceOrderNo;
        curr.TargetCompany = prev.TargetCompany;
        curr.Remark = prev.Remark;
    }

    private void RemoveItem(OutboundItem item)
    {
        _items.Remove(item);
    }

    // ========== 导航 ==========

    private void GoBack()
    {
        Navigation.NavigateTo($"/warehouse/{_warehouseCode.ToLowerInvariant()}");
    }

    private void GoToWarehouse()
    {
        Navigation.NavigateTo("/warehouse");
    }
}
