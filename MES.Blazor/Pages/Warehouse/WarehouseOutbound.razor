@page "/warehouse/outbound"
@using MES.Core.Enums
@using MES.Blazor.Helpers
@using MES.Blazor.Services
@using MES.Core.Models
@using MES.Core.DTOs.Warehouse
@using Microsoft.AspNetCore.Authorization
@inject InventoryService InventoryService
@inject OutboundStateService OutboundState
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject IJSRuntime JS
@attribute [Authorize]


<MudContainer MaxWidth="MaxWidth.False" Class="mt-4">
    <MudCard>
        <MudCardHeader>
            <CardHeaderContent>
                <MudText Typo="Typo.h5" Class="font-weight-bold">
                    <MudIcon Icon="@Icons.Material.Filled.ExitToApp" Class="mr-2" Color="Color.Warning" />
                    批量出库
                </MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">
                    仓库：<strong>@OutboundState.WarehouseName</strong> ｜ 待出库 @_items.Count 项
                </MudText>
            </CardHeaderContent>
            <CardHeaderActions>
                <MudButton Variant="Variant.Text" Color="Color.Default" OnClick="GoBack">返回</MudButton>
            </CardHeaderActions>
        </MudCardHeader>

        <MudCardContent>
            <!-- ============ 出库批次明细 ============ -->
            @if (_items.Count == 0)
            {
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="GoToWarehouse">
                    前往仓库选择
                </MudButton>
            }
            else
            {
            <div class="inbound-table-scroll">
                <MudTable Items="@_items" Dense="true" Hover="true" Elevation="0" Striped="true" Class="auto-table mb-4">
                    <HeaderContent>
                        <MudTh>批次号</MudTh>
                        <MudTh>工厂牌号</MudTh>
                        <MudTh>规格</MudTh>
                        <MudTh>剩余支数</MudTh>
                        <MudTh>剩余重量(kg)</MudTh>
                        <MudTh>出库日期<span class="required-star">*</span></MudTh>
                        <MudTh>出库支数<span class="required-star">*</span></MudTh>
                        <MudTh>出库重量(kg)<span class="required-star">*</span></MudTh>
                        <MudTh>出库类型<span class="required-star">*</span></MudTh>
                        <MudTh>委外穿孔号</MudTh>
                        <MudTh>目标单位</MudTh>
                        <MudTh>备注</MudTh>
                        <MudTh Style="width:100px;">操作</MudTh>
                    </HeaderContent>
                    <RowTemplate Context="item">
                        @{
                            var idx = _items.IndexOf(item);
                        }
                        <MudTd><small>@item.BatchNo</small></MudTd>
                        <MudTd><small>@item.PlantGrade</small></MudTd>
                        <MudTd><small>@item.Specification</small></MudTd>
                        <MudTd><MudChip Size="Size.Small" Color="Color.Success">@item.RemainingQuantity</MudChip></MudTd>
                        <MudTd><MudChip Size="Size.Small" Color="Color.Success">@item.RemainingWeight.ToString("G29")</MudChip></MudTd>
                        <MudTd>
                            <MudTextField T="string" @bind-Value="_dateText"
                                          Variant="Variant.Outlined" Dense="true" />
                        </MudTd>
                        <MudTd>
                            <MudNumericField T="int"
                                             @bind-Value="item.OutboundQuantity"
                                             Min="1" Max="@item.RemainingQuantity"
                                             Variant="Variant.Outlined" Dense="true"
                                             Class="qty-input" HideSpinButtons="true" />
                        </MudTd>
                        <MudTd>
                            <MudNumericField T="decimal" Format="G29"
                                             @bind-Value="item.OutboundWeight"
                                             Min="0" Max="@item.RemainingWeight"
                                             Variant="Variant.Outlined" Dense="true"
                                             Class="qty-input" HideSpinButtons="true" />
                        </MudTd>
                        <MudTd>
                            <MudSelect T="OutboundType" @bind-Value="item.OutboundType"
                                        Variant="Variant.Outlined" Dense="true">
                                <MudSelectItem Value="@(OutboundType.SalesOut)">@DisplayHelper.GetOutboundTypeText(OutboundType.SalesOut)</MudSelectItem>
                                <MudSelectItem Value="@(OutboundType.SubcontractOut)">@DisplayHelper.GetOutboundTypeText(OutboundType.SubcontractOut)</MudSelectItem>
                                <MudSelectItem Value="@(OutboundType.ReturnOut)">@DisplayHelper.GetOutboundTypeText(OutboundType.ReturnOut)</MudSelectItem>
                                <MudSelectItem Value="@(OutboundType.ProductionPick)">@DisplayHelper.GetOutboundTypeText(OutboundType.ProductionPick)</MudSelectItem>
                                <MudSelectItem Value="@(OutboundType.InspectionPick)">@DisplayHelper.GetOutboundTypeText(OutboundType.InspectionPick)</MudSelectItem>
                                <MudSelectItem Value="@(OutboundType.TransferOut)">@DisplayHelper.GetOutboundTypeText(OutboundType.TransferOut)</MudSelectItem>
                                <MudSelectItem Value="@(OutboundType.OtherOut)">@DisplayHelper.GetOutboundTypeText(OutboundType.OtherOut)</MudSelectItem>
                            </MudSelect>
                        </MudTd>
                        <MudTd>
                            <MudTextField T="string" @bind-Value="item.SourceOrderNo"
                                          Variant="Variant.Outlined" Dense="true" />
                        </MudTd>
                        <MudTd>
                            <MudTextField T="string" @bind-Value="item.TargetCompany"
                                          Variant="Variant.Outlined" Dense="true" />
                        </MudTd>
                        <MudTd>
                            <MudTextField T="string" @bind-Value="item.Remark"
                                          Variant="Variant.Outlined" Dense="true" />
                        </MudTd>
                        <MudTd>
                            <div class="d-flex flex-nowrap gap-1" style="gap:2px;">
                                @if (idx > 0)
                                {
                                    <MudIconButton Icon="@Icons.Material.Filled.ContentCopy" Size="Size.Small"
                                                   Color="Color.Info" Title="自动填充"
                                                   OnClick="() => AutoFill(idx)" />
                                }
                                <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small"
                                               Color="Color.Error" Title="取消此条"
                                               OnClick="() => RemoveItem(item)" />
                            </div>
                        </MudTd>
                    </RowTemplate>
                </MudTable>
            </div>

                <!-- 合计 -->
                <MudText Typo="Typo.body2" Class="font-weight-bold mb-4">
                    合计出库：@_items.Sum(i => i.OutboundQuantity) 支 / @_items.Sum(i => i.OutboundWeight).ToString("G29") kg
                </MudText>

                @if (!string.IsNullOrEmpty(_errorMessage))
                {
                    <MudText Typo="Typo.body2" Color="Color.Error" Class="mb-4">@_errorMessage</MudText>
                }

                <MudGrid Class="mt-4">
                    <MudItem xs="12" Class="d-flex justify-end">
                        <MudButton Variant="Variant.Text" Color="Color.Default" OnClick="GoBack" Class="mr-2">取消</MudButton>
                        <MudButton Variant="Variant.Filled" Color="Color.Warning"
                                   StartIcon="@Icons.Material.Filled.ExitToApp"
                                   OnClick="Submit" Loading="@_isSubmitting"
                                   Size="Size.Large">
                            确认出库 (@_items.Count 项)
                        </MudButton>
                    </MudItem>
                </MudGrid>
            }
        </MudCardContent>
    </MudCard>
</MudContainer>

@code {
    // ========== 出库条目模型（独立 DTO，不继承，避免 new 隐藏基类属性） ==========

    private class OutboundItem
    {
        public int Id { get; set; }
        public string BatchNo { get; set; } = string.Empty;
        public int WarehouseId { get; set; }
        public string? WarehouseName { get; set; }
        public string? MaterialType { get; set; }
        public string PlantGrade { get; set; } = string.Empty;
        public string Specification { get; set; } = string.Empty;
        public int RemainingQuantity { get; set; }
        public decimal RemainingWeight { get; set; }
        public int OutboundQuantity { get; set; }
        public decimal OutboundWeight { get; set; }
        public OutboundType OutboundType { get; set; } = OutboundType.ProductionPick;
        public string? SourceOrderNo { get; set; }
        public string? TargetCompany { get; set; }
        public string? Remark { get; set; }
    }

    // ========== 状态 ==========

    private List<OutboundItem> _items = new();
    private string _dateText = DateTime.Today.ToString("yyyy-MM-dd");
    private bool _isSubmitting;
    private bool _isArrowNavSetup;
    private string _errorMessage = string.Empty;

    // ========== 初始化 ==========

    protected override void OnInitialized()
    {
        // 从共享状态读取选中的批次
        if (OutboundState.SelectedItems.Count > 0)
        {
            _items = OutboundState.SelectedItems.Select(s => new OutboundItem
            {
                Id = s.Id,
                BatchNo = s.BatchNo,
                WarehouseId = s.WarehouseId,
                WarehouseName = OutboundState.WarehouseName,
                MaterialType = s.MaterialType.ToString(),
                PlantGrade = s.PlantGrade,
                Specification = s.Specification,
                RemainingQuantity = s.RemainingQuantity,
                RemainingWeight = s.RemainingWeight,
                // 初始默认值：出库数 = 剩余数
                OutboundQuantity = s.RemainingQuantity,
                OutboundWeight = s.RemainingWeight,
            }).ToList();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_isArrowNavSetup)
        {
            _isArrowNavSetup = true;
            if (!await JS.InvokeAsync<bool>("enableTableArrowNav", ".inbound-table-scroll"))
                _isArrowNavSetup = false;
        }
    }

    // ========== 提交 ==========

    private async Task Submit()
    {
        _errorMessage = string.Empty;

        var errors = new List<string>();

        // 解析日期
        DateTime parsedDate = default;
        if (string.IsNullOrWhiteSpace(_dateText))
            errors.Add("出库日期不能为空");
        else if (!DateTime.TryParse(_dateText, out var tmpDate))
            errors.Add("出库日期无效，请按 yyyy-MM-dd 格式输入");
        else
            parsedDate = tmpDate.Date;

        for (int i = 0; i < _items.Count; i++)
        {
            var item = _items[i];
            if (item.OutboundQuantity < 1)
                errors.Add($"第{i + 1}行（{item.BatchNo}）：出库支数必须大于0");
            if (item.OutboundQuantity > item.RemainingQuantity)
                errors.Add($"第{i + 1}行（{item.BatchNo}）：出库支数超过剩余量({item.RemainingQuantity})");
            if (item.OutboundWeight <= 0)
                errors.Add($"第{i + 1}行（{item.BatchNo}）：出库重量必须大于0");
            if (item.OutboundWeight > item.RemainingWeight)
                errors.Add($"第{i + 1}行（{item.BatchNo}）：出库重量超过剩余量({item.RemainingWeight:G29}kg)");
            if (item.OutboundType == OutboundType.SubcontractOut
                && item.MaterialType == nameof(MaterialType.RoundBar)
                && string.IsNullOrWhiteSpace(item.SourceOrderNo))
                errors.Add($"第{i + 1}行（{item.BatchNo}）：出库类型为委外出库且物料为圆棒时，「委外穿孔号」必填");
        }

        if (errors.Any())
        {
            _errorMessage = string.Join("；", errors);
            return;
        }

        var first = _items[0];

        _isSubmitting = true;
        StateHasChanged();

        try
        {
            var request = new BatchOutboundRequest
            {
                OutboundType = first.OutboundType,
                SourceOrderNo = string.IsNullOrEmpty(first.SourceOrderNo) ? null : first.SourceOrderNo,
                TargetCompany = string.IsNullOrEmpty(first.TargetCompany) ? null : first.TargetCompany,
                OutboundDate = parsedDate,
                Remark = string.IsNullOrEmpty(first.Remark) ? null : first.Remark,
                Items = _items.Select(i => new OutboundItemRequest
                {
                    InventoryBatchId = i.Id,
                    OutboundQuantity = i.OutboundQuantity,
                    OutboundWeight = i.OutboundWeight,
                    OutboundType = i.OutboundType,
                    SourceOrderNo = string.IsNullOrEmpty(i.SourceOrderNo) ? null : i.SourceOrderNo,
                    TargetCompany = string.IsNullOrEmpty(i.TargetCompany) ? null : i.TargetCompany,
                    Remark = string.IsNullOrEmpty(i.Remark) ? null : i.Remark,
                }).ToList()
            };

            var result = await InventoryService.BatchOutboundAsync(request);

            if (result.Success && result.Data != null)
            {
                Snackbar.Add($"批量出库成功，共{result.Data.SuccessCount}条", Severity.Success);
                var returnCode = OutboundState.WarehouseCode.ToLowerInvariant();
                OutboundState.Clear();
                Navigation.NavigateTo($"/warehouse/{returnCode}");
            }
            else
            {
                _errorMessage = result.Message ?? "批量出库失败";
            }
        }
        catch (Exception ex)
        {
            _errorMessage = $"网络错误: {ex.Message}";
        }
        finally
        {
            _isSubmitting = false;
            StateHasChanged();
        }
    }

    // ========== 行操作 ==========

    private void AutoFill(int idx)
    {
        if (idx <= 0 || idx >= _items.Count) return;
        var prev = _items[idx - 1];
        var curr = _items[idx];
        curr.OutboundType = prev.OutboundType;
        curr.SourceOrderNo = prev.SourceOrderNo;
        curr.TargetCompany = prev.TargetCompany;
        curr.Remark = prev.Remark;
    }

    private void RemoveItem(OutboundItem item)
    {
        _items.Remove(item);
    }

    // ========== 导航 ==========

    private void GoBack()
    {
        Navigation.NavigateTo($"/warehouse/{OutboundState.WarehouseCode.ToLowerInvariant()}");
    }

    private void GoToWarehouse()
    {
        Navigation.NavigateTo("/warehouse");
    }
}
