    // ========== 提交 ==========

    private async Task Submit()
    {
        _errorMessage = string.Empty;

        // ========== 来源单号验证 ==========
        var first = _rows[0];
        var inboundSource = first.InboundSource;
        var sourceOrderNo = first.SourceOrderNo;
        if ((inboundSource == "Purchase" || inboundSource == "Subcontract")
            && !string.IsNullOrEmpty(sourceOrderNo))
        {
            var validation = await InventoryService.ValidateSourceOrderAsync(sourceOrderNo, inboundSource);
            if (validation.Success && validation.Data != null)
            {
                var warnings = new List<string>();
                if (validation.Data.Warnings.Any())
                    warnings.AddRange(validation.Data.Warnings);

                // 检查工单号匹配（忽略大小写，SQL Server 默认不区分大小写）
                if (!string.IsNullOrEmpty(validation.Data.ExpectedWorkOrderNo))
                {
                    if (!string.Equals(first.WorkOrderNo, validation.Data.ExpectedWorkOrderNo, StringComparison.OrdinalIgnoreCase))
                    {
                        warnings.Add($"工单号不匹配：入库工单号为「{first.WorkOrderNo}」，预期为「{validation.Data.ExpectedWorkOrderNo}」");
                    }
                    if (!first.IsLinkedToWorkOrder)
                    {
                        warnings.Add("来源订单关联了工单，但入库未勾选「关联工单」");
                    }
                }

                if (warnings.Any())
                {
                    var sourceTypeText = inboundSource == "Purchase" ? "采购" : "委外";
                    var msg = $"来源类型「{sourceTypeText}」验证发现以下警告：\n\n"
                        + string.Join("\n", warnings.Select((w, i) => $"{i + 1}. {w}"))
                        + "\n\n是否仍然提交？";
                    var dialog = DialogService.Show<ConfirmDialog>("入库验证警告", new DialogParameters
                    {
                        { "ContentText", msg },
                        { "ConfirmText", "仍然提交" },
                        { "Color", Color.Warning }
                    });
                    var dialogResult = await dialog.Result;
                    if (dialogResult.Canceled)
                        return;
                }
            }
        }

        var errors = new List<string>();

        if (_warehouseId <= 0)
            errors.Add("请选择仓库");

        for (int i = 0; i < _rows.Count; i++)
        {
            var r = _rows[i];
            if (r.InitialQuantity < 1)
                errors.Add($"第{i + 1}行：支数必须大于0");
            if (r.InitialWeight <= 0)
                errors.Add($"第{i + 1}行：重量必须大于0");
        }

        if (errors.Any())
        {
            _errorMessage = string.Join("；", errors);
            return;
        }

        _isSubmitting = true;
        StateHasChanged();

        try
        {
            var request = new BatchInboundRequest
            {
                WarehouseId = _warehouseId,
                // 公共字段（取第1行）
                InboundSource = first.InboundSource,
                SourceName = first.SourceName,
                InboundDate = ParseDate(first.InboundDateStr),
                MaterialType = first.MaterialType,
                PlantGrade = first.PlantGrade,
                Specification = first.Specification,
                HeatNo = first.HeatNo,
                LengthStatus = first.LengthStatus,
                MinLength = first.MinLength,
                MaxLength = first.MaxLength,
                UnitWeight = first.UnitWeight,
                Meters = first.Meters,
                SurfaceCondition = first.SurfaceCondition,
                LocationArea = first.LocationArea,
                LocationRack = first.LocationRack,
                ProductionBatchNo = first.ProductionBatchNo,
                ActualSpecification = first.ActualSpecification,
                ActualOuterDiameter = first.ActualOuterDiameter,
                ActualWallThickness = first.ActualWallThickness,
                DefectReason = first.DefectReason,
                LiabilityType = first.LiabilityType,
                OriginalSupplier = first.OriginalSupplier,
                TagNo = first.TagNo,
                DefectRemark = first.DefectRemark,
                SalesOrderNo = string.IsNullOrEmpty(first.SalesOrderNo) ? null : first.SalesOrderNo,
                OrderItemIds = string.IsNullOrEmpty(first.OrderItemIds) ? null : first.OrderItemIds,
                IsLinkedToWorkOrder = first.IsLinkedToWorkOrder ? true : null,
                WorkOrderNo = first.WorkOrderNo,
                SourceOrderNo = first.SourceOrderNo,
                // 行级字段（所有可编辑字段按行发送，行值优先于公共值）
                Rows = _rows.Select(r => new InboundRow
                {
                    InitialQuantity = r.InitialQuantity,
                    InitialWeight = r.InitialWeight,
                    LengthStatus = r.LengthStatus,
                    MinLength = r.MinLength,
                    MaxLength = r.MaxLength,
                    UnitWeight = r.UnitWeight,
                    Meters = r.Meters,
                    SurfaceCondition = r.SurfaceCondition,
                    LocationArea = r.LocationArea,
                    LocationRack = r.LocationRack,
                    Remark = r.Remark,
                    DefectReason = r.DefectReason,
                    LiabilityType = r.LiabilityType,
                    OriginalSupplier = r.OriginalSupplier,
                    TagNo = r.TagNo,
                    DefectRemark = r.DefectRemark,
                    MaterialType = r.MaterialType,
                    PlantGrade = r.PlantGrade,
                    Specification = r.Specification,
                    HeatNo = r.HeatNo,
                    InboundSource = r.InboundSource,
                    SourceName = r.SourceName,
                    ProductionBatchNo = r.ProductionBatchNo,
                    ActualSpecification = r.ActualSpecification,
                    ActualOuterDiameter = r.ActualOuterDiameter,
                    ActualWallThickness = r.ActualWallThickness,
                    SalesOrderNo = string.IsNullOrEmpty(r.SalesOrderNo) ? null : r.SalesOrderNo,
                    OrderItemIds = string.IsNullOrEmpty(r.OrderItemIds) ? null : r.OrderItemIds,
                    IsLinkedToWorkOrder = r.IsLinkedToWorkOrder ? true : null,
                    WorkOrderNo = r.WorkOrderNo,
                    SourceOrderNo = r.SourceOrderNo,
                }).ToList()
            };

            var result = await InventoryService.BatchInboundAsync(request);

            if (result.Success && result.Data != null)
            {
                Snackbar.Add($"批量入库成功，共{result.Data.SuccessCount}条", Severity.Success);
                Navigation.NavigateTo($"/warehouse/{_warehouseCode.ToLowerInvariant()}");
            }
            else
            {
                _errorMessage = result.Message ?? "批量入库失败";
            }
        }
        catch (Exception ex)
        {
            _errorMessage = $"网络错误: {ex.Message}";
        }
        finally
        {
            _isSubmitting = false;
            StateHasChanged();
        }
    }

    private static DateTime? ParseDate(object? val) => val switch
    {
        DateTime dt => dt,
        string s when DateTime.TryParse(s, out var d) => d,
        _ => null
    };

    // ========== 来源单号自动填充 ==========

    private async Task LookupSourceOrder(InboundRowModel row)
    {
        if (string.IsNullOrEmpty(row.InboundSource) || string.IsNullOrEmpty(row.SourceOrderNo))
        {
            Snackbar.Add("请先填写「入库来源」和「来源单号」", Severity.Warning);
            return;
        }

        try
        {
            var result = await InventoryService.ValidateSourceOrderAsync(row.SourceOrderNo, row.InboundSource, row.SourceOrderSequence);
            if (!result.Success || result.Data == null)
            {
                Snackbar.Add(result.Message ?? "查询来源单号失败", Severity.Error);
                return;
            }

            var data = result.Data;
            if (!data.IsValid)
            {
                Snackbar.Add(string.Join("；", data.Warnings), Severity.Warning);
                return;
            }

            // 填充当前行字段
            var filled = new List<string>();
            if (!string.IsNullOrEmpty(data.MaterialCategory)) { row.MaterialType = data.MaterialCategory; filled.Add("物料分类"); }
            if (!string.IsNullOrEmpty(data.PlantGrade)) { row.PlantGrade = data.PlantGrade; filled.Add("厂内钢种"); }
            if (!string.IsNullOrEmpty(data.Specification)) { row.Specification = data.Specification; filled.Add("规格"); }
            if (!string.IsNullOrEmpty(data.SupplierName)) { row.SourceName = data.SupplierName; filled.Add("供应商"); }
            if (!string.IsNullOrEmpty(data.ExpectedWorkOrderNo))
            {
                row.WorkOrderNo = data.ExpectedWorkOrderNo;
                row.IsLinkedToWorkOrder = true;
                filled.Add("来源工单号");
                filled.Add("关联工单");
            }

            if (filled.Any())
                Snackbar.Add($"已填充: {string.Join("、", filled)}", Severity.Success);
            else
                Snackbar.Add("来源单号存在，但无可填充的字段", Severity.Info);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"查询失败: {ex.Message}", Severity.Error);
        }
    }

