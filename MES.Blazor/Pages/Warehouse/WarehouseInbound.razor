    // ========== 提交 ==========

    private async Task Submit()
    {
        _errorMessage = string.Empty;

        // ========== 来源单号验证（仅自动填充模式核查；非自动填充不做任何核查） ==========
        var first = _rows[0];
        var inboundSource = first.InboundSource;
        var sourceOrderNo = first.SourceOrderNo;
        if (_autoFillEnabled
            && (inboundSource == InboundSource.Purchase.ToString() || inboundSource == InboundSource.Subcontract.ToString())
            && !string.IsNullOrEmpty(sourceOrderNo))
        {
            var validation = await InventoryService.ValidateSourceOrderAsync(sourceOrderNo, inboundSource);
            if (validation.Success && validation.Data != null)
            {
                var warnings = new List<string>();
                if (validation.Data.Warnings.Any())
                    warnings.AddRange(validation.Data.Warnings);

                // 检查工单号匹配（忽略大小写，SQL Server 默认不区分大小写）
                if (!string.IsNullOrEmpty(validation.Data.ExpectedWorkOrderNo))
                {
                    if (!string.Equals(first.WorkOrderNo, validation.Data.ExpectedWorkOrderNo, StringComparison.OrdinalIgnoreCase))
                    {
                        warnings.Add($"工单号不匹配：入库工单号为「{first.WorkOrderNo}」，预期为「{validation.Data.ExpectedWorkOrderNo}」");
                    }
                    if (!first.IsLinkedToWorkOrder)
                    {
                        warnings.Add("来源订单关联了工单，但入库未勾选「关联工单」");
                    }
                }

                if (warnings.Any())
                {
                    var sourceTypeText = inboundSource == "Purchase" ? "采购" : "委外";
                    var msg = $"来源类型「{sourceTypeText}」验证发现以下警告：\n\n"
                        + string.Join("\n", warnings.Select((w, i) => $"{i + 1}. {w}"))
                        + "\n\n是否仍然提交？";
                    var dialog = DialogService.Show<ConfirmDialog>("入库验证警告", new DialogParameters
                    {
                        { "ContentText", msg },
                        { "ConfirmText", "仍然提交" },
                        { "Color", Color.Warning }
                    });
                    var dialogResult = await dialog.Result;
                    if (dialogResult.Canceled)
                        return;
                }
            }
        }

        var errors = new List<string>();

        // 工单号为空时清空「订单信息」组字段（关联工单=否，工单号/订单号/主号/项次全空）
        foreach (var r in _rows)
        {
            if (string.IsNullOrEmpty(r.WorkOrderNo))
            {
                r.IsLinkedToWorkOrder = false;
                r.SalesOrderNo = null;
                r.ProductionMainNo = null;
                r.OrderItemIds = null;
            }
        }

        if (_warehouseId <= 0)
            errors.Add("请选择仓库");

        for (int i = 0; i < _rows.Count; i++)
        {
            var r = _rows[i];
            if (string.IsNullOrEmpty(r.InboundDateStr))
                errors.Add($"第{i + 1}行：入库日期必填");
            if (string.IsNullOrEmpty(r.InboundSource))
                errors.Add($"第{i + 1}行：入库来源必填");
            if (r.InitialQuantity < 1)
                errors.Add($"第{i + 1}行：支数必须大于0");
            if (r.InitialWeight <= 0)
                errors.Add($"第{i + 1}行：重量必须大于0");
            if (string.IsNullOrEmpty(r.LengthStatus))
                errors.Add($"第{i + 1}行：长度状态必填");
            if (string.IsNullOrEmpty(r.Specification))
                errors.Add($"第{i + 1}行：名义规格必填");
            if (!string.IsNullOrEmpty(_warehouseCode) && !string.IsNullOrEmpty(r.MaterialType))
            {
                var allowed = MES.Core.Constants.InventoryMaterialTypes.GetAllowedTypes(_warehouseCode);
                if (allowed != null && Enum.TryParse<MaterialType>(r.MaterialType, out var mt) && !allowed.Contains(mt))
                    errors.Add($"第{i + 1}行：物料「{DisplayHelper.GetMaterialTypeText(r.MaterialType)}」不属于当前仓库({_warehouseCode})允许的物料类型");
            }
            if (string.IsNullOrEmpty(r.PlantGrade))
                errors.Add($"第{i + 1}行：工厂牌号必填");
            if (_warehouseCode == "DEFECT" && string.IsNullOrEmpty(r.DefectReason))
                errors.Add($"第{i + 1}行：次品原因必填");
            if (_warehouseCode == "DEFECT" && string.IsNullOrEmpty(r.LiabilityType))
                errors.Add($"第{i + 1}行：责任类型必填");
        }

        // 长度值逻辑验证（仅 FG/WIP 适用）
        var minLenApplicable = _allColumns.FirstOrDefault(c => c.Key == "MinLength")?.IsApplicable ?? false;
        if (minLenApplicable && (_warehouseCode == "FG" || _warehouseCode == "WIP"))
        {
            for (int i = 0; i < _rows.Count; i++)
            {
                var r = _rows[i];
                if (!string.IsNullOrEmpty(r.LengthStatus))
            {
                if (r.LengthStatus == LengthStatus.Fixed.ToString())
                {
                    if (!r.MinLength.HasValue || !r.MaxLength.HasValue)
                        errors.Add($"第{i + 1}行：长度状态为「定尺」时，最小长度和最大长度必填");
                    else if (r.MinLength.Value <= 0 || r.MaxLength.Value <= 0)
                        errors.Add($"第{i + 1}行：长度状态为「定尺」时，最小长度和最大长度必须大于0");
                    else if (r.MinLength.Value != r.MaxLength.Value)
                        errors.Add($"第{i + 1}行：长度状态为「定尺」时，最小长度和最大长度必须相等");
                }
                else if (r.LengthStatus == LengthStatus.Range.ToString())
                {
                    if (!r.MinLength.HasValue || !r.MaxLength.HasValue)
                        errors.Add($"第{i + 1}行：长度状态为「范围尺」时，最小长度和最大长度必填");
                    else if (r.MinLength.Value <= 0)
                        errors.Add($"第{i + 1}行：长度状态为「范围尺」时，最小长度必须大于0");
                    else if (r.MaxLength.Value <= r.MinLength.Value)
                        errors.Add($"第{i + 1}行：长度状态为「范围尺」时，最大长度必须大于最小长度");
                }
            }
        }
        }

        if (errors.Any())
        {
            _errorMessage = string.Join("；", errors);
            return;
        }

        _isSubmitting = true;
        StateHasChanged();

        try
        {
            var request = new BatchInboundRequest
            {
                WarehouseId = _warehouseId,
                // 公共字段（取第1行）
                InboundSource = first.InboundSource != null ? Enum.Parse<InboundSource>(first.InboundSource) : null,
                SourceName = first.SourceName,
                InboundDate = ParseDate(first.InboundDateStr),
                MaterialType = !string.IsNullOrEmpty(first.MaterialType) ? EnumHelper.Parse<MaterialType>(first.MaterialType) : null,
                PlantGrade = first.PlantGrade,
                Specification = first.Specification,
                HeatNo = first.HeatNo,
                LengthStatus = !string.IsNullOrEmpty(first.LengthStatus) ? EnumHelper.Parse<LengthStatus>(first.LengthStatus) : null,
                MinLength = first.MinLength,
                MaxLength = first.MaxLength,
                UnitWeight = first.UnitWeight,
                Meters = first.Meters,
                ManufacturingStatus = !string.IsNullOrEmpty(first.ManufacturingStatus) ? EnumHelper.Parse<DeliveryState>(first.ManufacturingStatus) : null,
                LocationArea = first.LocationArea,
                LocationRack = first.LocationRack,
                ProductionBatchNo = first.ProductionBatchNo,
                ActualSpecification = first.ActualSpecification,
                DefectReason = first.DefectReason,
                LiabilityType = first.LiabilityType,
                OriginalSupplier = first.OriginalSupplier,
                TagNo = first.TagNo,
                DefectRemark = first.DefectRemark,
                SalesOrderNo = string.IsNullOrEmpty(first.SalesOrderNo) ? null : first.SalesOrderNo,
                ProductionMainNo = string.IsNullOrEmpty(first.ProductionMainNo) ? null : first.ProductionMainNo,
                OrderItemIds = string.IsNullOrEmpty(first.OrderItemIds) ? null : first.OrderItemIds,
                IsLinkedToWorkOrder = first.IsLinkedToWorkOrder ? true : null,
                WorkOrderNo = first.WorkOrderNo,
                SourceOrderNo = first.SourceOrderNo,
                // 仅自动填充模式启用定尺切割长度匹配硬校验（自动填充第2种「检验入库」按生产批号时由后端核查主号定尺长度）
                EnforceCutLengthMatch = _autoFillEnabled,
                // 行级字段（所有可编辑字段按行发送，行值优先于公共值）
                Rows = _rows.Select(r => new InboundRow
                {
                    InitialQuantity = r.InitialQuantity,
                    InitialWeight = r.InitialWeight,
                    LengthStatus = !string.IsNullOrEmpty(r.LengthStatus) ? EnumHelper.Parse<LengthStatus>(r.LengthStatus) : null,
                    MinLength = r.MinLength,
                    MaxLength = r.MaxLength,
                    UnitWeight = r.UnitWeight,
                    Meters = r.Meters,
                    ManufacturingStatus = !string.IsNullOrEmpty(r.ManufacturingStatus) ? EnumHelper.Parse<DeliveryState>(r.ManufacturingStatus) : null,
                    LocationArea = r.LocationArea,
                    LocationRack = r.LocationRack,
                    Remark = r.Remark,
                    DefectReason = r.DefectReason,
                    LiabilityType = r.LiabilityType,
                    OriginalSupplier = r.OriginalSupplier,
                    TagNo = r.TagNo,
                    DefectRemark = r.DefectRemark,
                    MaterialType = !string.IsNullOrEmpty(r.MaterialType) ? EnumHelper.Parse<MaterialType>(r.MaterialType) : null,
                    PlantGrade = r.PlantGrade,
                    Specification = r.Specification,
                    HeatNo = r.HeatNo,
                    InboundSource = r.InboundSource != null ? Enum.Parse<InboundSource>(r.InboundSource) : null,
                    SourceName = r.SourceName,
                    ProductionBatchNo = r.ProductionBatchNo,
                    ActualSpecification = r.ActualSpecification,
                    SalesOrderNo = string.IsNullOrEmpty(r.SalesOrderNo) ? null : r.SalesOrderNo,
                    ProductionMainNo = string.IsNullOrEmpty(r.ProductionMainNo) ? null : r.ProductionMainNo,
                    OrderItemIds = string.IsNullOrEmpty(r.OrderItemIds) ? null : r.OrderItemIds,
                    IsLinkedToWorkOrder = r.IsLinkedToWorkOrder ? true : null,
                    WorkOrderNo = r.WorkOrderNo,
                    SourceOrderNo = r.SourceOrderNo,
                    SourceOrderSequence = r.SourceOrderSequence,
                }).ToList()
            };

            var result = await InventoryService.BatchInboundAsync(request);

            if (result.Success && result.Data != null)
            {
                Snackbar.Add($"批量入库成功，共{result.Data.SuccessCount}条", Severity.Success);
                Navigation.NavigateTo($"/warehouse/{_warehouseCode.ToLowerInvariant()}");
            }
            else
            {
                _errorMessage = result.Message ?? "批量入库失败";
            }
        }
        catch (Exception ex)
        {
            _errorMessage = $"网络错误: {ex.Message}";
        }
        finally
        {
            _isSubmitting = false;
            StateHasChanged();
        }
    }

    private static DateTime? ParseDate(object? val) => val switch
    {
        DateTime dt => dt,
        string s when DateTime.TryParse(s, out var d) => d,
        _ => null
    };

    // ========== 来源单号自动填充 ==========

    /// <summary>
    /// 清空自动填充组字段（RAW:组2自动填充；FG:组2订单信息+组3物料信息）
    /// 在 LookupSourceOrder / LookupProductionBatch 入口处调用，先清空再填充
    /// </summary>
    private void ClearAutoFillFields(InboundRowModel row)
    {
        // DEFECT 清空 G6（可填充），FG 清空 G2（订单信息）+G3（物料信息），其余清空 G2（自动填充）
        int minGroupKey, maxGroupKey;
        if (_warehouseCode == "DEFECT")
        {
            minGroupKey = 6;
            maxGroupKey = 6;
        }
        else
        {
            minGroupKey = 2;
            maxGroupKey = _warehouseCode == "FG" ? 3 : 2;
        }

        foreach (var col in _allColumns)
        {
            if (!col.IsApplicable || !col.Visible) continue;
            if (!col.GroupKey.HasValue || col.GroupKey < minGroupKey || col.GroupKey > maxGroupKey) continue;

            switch (col.Key)
            {
                case "MaterialType": row.MaterialType = null; break;
                case "PlantGrade": row.PlantGrade = null; break;
                case "Specification": row.Specification = null; break;
                case "SourceName": row.SourceName = null; break;
                case "WorkOrderNo": row.WorkOrderNo = null; break;
                case "SalesOrderNo": row.SalesOrderNo = null; break;
                case "ProductionMainNo": row.ProductionMainNo = null; break;
                case "OrderItemIds": row.OrderItemIds = null; break;
                case "HeatNo": row.HeatNo = null; break;
                case "ManufacturingStatus": row.ManufacturingStatus = null; break;
            }
        }

        // IsLinkedToWorkOrder 始终跟随 WorkOrderNo，即使字段被隐藏也需先清空
        row.IsLinkedToWorkOrder = false;
    }

    private async Task TriggerAutoFillAsync(InboundRowModel row)
    {
        if (!_autoFillEnabled)
            return;

        if (string.IsNullOrEmpty(row.InboundSource))
            return;

        if (row.InboundSource == InboundSource.InspectionInbound.ToString())
        {
            if (string.IsNullOrEmpty(row.ProductionBatchNo))
                return;
            await InvokeAsync(() => LookupProductionBatch(row));
            return;
        }

        // 外购：来源单号必填；委外：来源单号+委外序号必填
        if (row.InboundSource == InboundSource.Subcontract.ToString())
        {
            if (string.IsNullOrEmpty(row.SourceOrderNo) || !row.SourceOrderSequence.HasValue)
                return;
        }
        else
        {
            if (string.IsNullOrEmpty(row.SourceOrderNo))
                return;
        }
        await InvokeAsync(() => LookupSourceOrder(row));
    }

    private async Task LookupSourceOrder(InboundRowModel row)
    {
        if (string.IsNullOrEmpty(row.InboundSource) || string.IsNullOrEmpty(row.SourceOrderNo))
        {
            Snackbar.Add("请先填写「入库来源」和「来源单号」", Severity.Warning);
            return;
        }

        // 新模式：先清空旧数据，再填充新数据
        ClearAutoFillFields(row);

        try
        {
            var result = await InventoryService.ValidateSourceOrderAsync(row.SourceOrderNo, row.InboundSource, row.SourceOrderSequence);
            if (!result.Success || result.Data == null)
            {
                Snackbar.Add(result.Message ?? "查询来源单号失败", Severity.Error);
                return;
            }

            var data = result.Data;
            if (!data.IsValid)
            {
                Snackbar.Add(string.Join("；", data.Warnings), Severity.Warning);
                return;
            }

            // 填充当前行字段
            var filled = new List<string>();
            if (data.MaterialCategory.HasValue)
            {
                if (_warehouseCode == "DEFECT")
                {
                    // 次品库物料已选，不覆盖
                }
                else
                {
                    row.MaterialType = data.MaterialCategory.Value.ToString(); filled.Add("物料分类");
                }
            }
            if (!string.IsNullOrEmpty(data.PlantGrade)) { row.PlantGrade = data.PlantGrade; filled.Add("厂内钢种"); }
            if (!string.IsNullOrEmpty(data.Specification)) { row.Specification = data.Specification; filled.Add("规格"); }
            if (!string.IsNullOrEmpty(data.SupplierName)) { row.SourceName = data.SupplierName; filled.Add("供应商"); }
            if (!string.IsNullOrEmpty(data.SalesOrderNo)) { row.SalesOrderNo = data.SalesOrderNo; filled.Add("订单号"); }
            if (!string.IsNullOrEmpty(data.ProductionMainNo)) { row.ProductionMainNo = data.ProductionMainNo; filled.Add("主号"); }
            if (!string.IsNullOrEmpty(data.ExpectedWorkOrderNo))
            {
                row.WorkOrderNo = data.ExpectedWorkOrderNo;
                row.IsLinkedToWorkOrder = true;
                filled.Add("来源工单号");
                filled.Add("关联工单");
            }
            else
            {
                // 来源单无关联工单 → 清空上次残留的工单号
                if (!string.IsNullOrEmpty(row.WorkOrderNo) || row.IsLinkedToWorkOrder)
                {
                    row.WorkOrderNo = null;
                    row.IsLinkedToWorkOrder = false;
                }
            }

            if (filled.Any())
                Snackbar.Add($"已填充: {string.Join("、", filled)}", Severity.Success);
            else
                Snackbar.Add("来源单号存在，但无可填充的字段", Severity.Info);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"查询失败: {ex.Message}", Severity.Error);
        }
        StateHasChanged();
    }

    private async Task LookupFromSource(InboundRowModel row)
    {
        if (_warehouseCode == "DEFECT")
        {
            // 次品库：优先按生产批号查询，其次按来源单号
            if (!string.IsNullOrEmpty(row.ProductionBatchNo))
            {
                await LookupProductionBatch(row);
            }
            else if (!string.IsNullOrEmpty(row.SourceOrderNo))
            {
                await LookupSourceOrder(row);
            }
            else
            {
                Snackbar.Add("请先填写「生产批号」或「来源单号」", Severity.Warning);
            }
            return;
        }

        if (row.InboundSource == InboundSource.InspectionInbound.ToString())
            await LookupProductionBatch(row);
        else
            await LookupSourceOrder(row);
    }

    private async Task LookupProductionBatch(InboundRowModel row)
    {
        if (string.IsNullOrEmpty(row.ProductionBatchNo))
        {
            Snackbar.Add("请先填写「生产批号」", Severity.Warning);
            return;
        }

        // 新模式：先清空旧数据，再填充新数据
        ClearAutoFillFields(row);

        try
        {
            var result = await InventoryService.ValidateProductionBatchAsync(row.ProductionBatchNo);
            if (!result.Success || result.Data == null)
            {
                Snackbar.Add(result.Message ?? "查询生产批号失败", Severity.Error);
                return;
            }

            var data = result.Data;
            if (!data.IsValid)
            {
                Snackbar.Add(string.Join("；", data.Warnings), Severity.Warning);
                return;
            }

            // 填充当前行字段（MaterialType/ManufacturingStatus 存储原始值，RenderCell 负责中文显示）
            var filled = new List<string>();
            if (data.MaterialCategory.HasValue)
            {
                if (_warehouseCode == "DEFECT")
                {
                    // 次品库物料已选，不覆盖
                }
                else
                {
                    row.MaterialType = data.MaterialCategory.Value.ToString(); filled.Add("物料分类");
                }
            }
            if (!string.IsNullOrEmpty(data.PlantGrade)) { row.PlantGrade = data.PlantGrade; filled.Add("厂内钢种"); }
            if (!string.IsNullOrEmpty(data.Specification)) { row.Specification = data.Specification; filled.Add("规格"); }
            if (!string.IsNullOrEmpty(data.SalesOrderNo)) { row.SalesOrderNo = data.SalesOrderNo; filled.Add("订单号"); }
            if (!string.IsNullOrEmpty(data.ProductionMainNo)) { row.ProductionMainNo = data.ProductionMainNo; filled.Add("主号"); }
            if (!string.IsNullOrEmpty(data.OrderItemIds)) { row.OrderItemIds = data.OrderItemIds; filled.Add("项次"); }
            if (!string.IsNullOrEmpty(data.HeatNo)) { row.HeatNo = data.HeatNo; filled.Add("炉号"); }
            if (data.ManufacturingStatus.HasValue) { row.ManufacturingStatus = data.ManufacturingStatus.Value.ToString(); filled.Add("制造状态"); }
            if (!string.IsNullOrEmpty(data.SupplierName)) { row.SourceName = data.SupplierName; filled.Add("来料单位"); }
            if (!string.IsNullOrEmpty(data.ExpectedWorkOrderNo))
            {
                row.WorkOrderNo = data.ExpectedWorkOrderNo;
                row.IsLinkedToWorkOrder = true;
                filled.Add("来源工单号");
                filled.Add("关联工单");
            }
            else
            {
                if (!string.IsNullOrEmpty(row.WorkOrderNo) || row.IsLinkedToWorkOrder)
                {
                    row.WorkOrderNo = null;
                    row.IsLinkedToWorkOrder = false;
                }
            }

            if (filled.Any())
                Snackbar.Add($"已填充: {string.Join("、", filled)}", Severity.Success);
            else
                Snackbar.Add("生产批号存在，但无可填充的字段", Severity.Info);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"查询失败: {ex.Message}", Severity.Error);
        }
        StateHasChanged();
    }

    // ========== 自动填充开关 ==========

    private void OnAutoFillToggled(bool newValue)
    {
        _autoFillEnabled = newValue;
        // 切换自动填充时清空行（来源选项会变化）
        _rows.Clear();
        _rows.Add(new InboundRowModel());
        StateHasChanged();
    }

    // ========== 导航 ==========

    private void GoBack()
    {
        if (!string.IsNullOrEmpty(Code))
            Navigation.NavigateTo($"/warehouse/{Code.ToLowerInvariant()}");
        else
            Navigation.NavigateTo("/warehouse");
    }
}
