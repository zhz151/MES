@page "/warehouse/inbound"
@page "/warehouse/inbound/{Code}"
@using MES.Blazor.Services
@using MES.Core.Models
@using MES.Blazor.Helpers
@using MES.Core.Enums
@using MES.Core.DTOs.Warehouse
@using Microsoft.AspNetCore.Authorization
@inject WarehouseService WarehouseService
@inject InventoryService InventoryService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject ColumnPrefsService ColumnPrefs
@inject IJSRuntime JS
@inject IDialogService DialogService
@inject AuthenticationStateProvider AuthProvider
@attribute [Authorize(Roles = Roles.Policies.WarehouseView)]

<MudContainer MaxWidth="MaxWidth.False" Class="mt-4">
    <style>
        .inbound-edit-table {
            width: 100%;
        }
        .inbound-edit-table td.mud-table-cell,
        .inbound-edit-table th.mud-table-cell {
            padding: 1px 4px !important;
        }
        .inbound-edit-table {
            table-layout: fixed;
        }
        .inbound-edit-table .mud-input-input-control {
            margin-top: 0;
        }
        .inbound-edit-table .mud-input {
            font-size: 13px;
            width: 100%;
            min-width: 0;
        }
        /* 表头不换行 */
        .inbound-edit-table th.mud-table-cell {
            white-space: nowrap;
        }
        /* 表格容器（仅约束高度，滚动由 MudTable FixedHeader 内部处理） */
        #inbound-table-wrapper {
            max-height: calc(100vh - 310px);
            overflow: hidden;
        }
        /* 分组标题栏由 JS 用 transform 同步滚动，overflow:hidden 允许 scrollLeft 工作 */
        /* 此处需保留 overflow:hidden（来自 app.css），不能设为 visible/programmatic scrollLeft 需要 scroll container */
    </style>
    <MudCard>
        <MudCardHeader>
            <CardHeaderContent>
                <MudText Typo="Typo.h5" Class="font-weight-bold">
                    <MudIcon Icon="@Icons.Material.Filled.AddCircleOutline" Class="mr-2" Color="Color.Primary" />
                    批量入库
                    @if (!string.IsNullOrEmpty(_warehouseName))
                    {
                        <span> — @_warehouseName</span>
                    }
                </MudText>
            </CardHeaderContent>
            <CardHeaderActions>
                <MudButton Variant="Variant.Text" Color="Color.Default" OnClick="GoBack">返回</MudButton>
            </CardHeaderActions>
        </MudCardHeader>

        <MudCardContent>
            <!-- ============ 入库明细表 ============ -->
            @if (_rows.Any())
            {
                <div class="d-flex align-center mb-2">
                    <MudText Typo="Typo.body2">共 @_rows.Count 行</MudText>
                    <MudSpacer />
                    <ColumnDisplaySelect Columns="_allColumns"
                                         ShowCommonFields="true"
                                         OnColumnToggle="OnColumnToggle"
                                         OnMoveUp="MoveColumnUp"
                                         OnMoveDown="MoveColumnDown" />
                    @if (_warehouseCode == "FG" || _warehouseCode == "RAW")
                    {
                        <MudSwitch @bind-Value="_autoFillEnabled"
                                   Color="Color.Primary"
                                   OnValueChanged="OnAutoFillToggled"
                                   Class="ml-4">
                            <MudText Typo="Typo.body2">自动填充</MudText>
                        </MudSwitch>
                    }
                    <MudButton Variant="Variant.Text" Size="Size.Small"
                               Color="Color.Default"
                               StartIcon="@Icons.Material.Filled.RestartAlt"
                               OnClick="ResetAll" Class="ml-2">
                        重置
                    </MudButton>
                </div>
                <div id="inbound-table-wrapper">
                @* 分组标题栏 *@
                <div class="col-group-header-scroll">
                    <div class="col-group-header-bar" style="width: @(_totalTableWidth)px">
                        @foreach (var gh in _groupHeaders)
                        {
                            <div class="col-group-header-item @gh.CssClass" style="width: @(gh.TotalWidth)px">
                                <span class="col-group-badge">@gh.GroupName</span>
                            </div>
                        }
                        <div class="col-group-header-item" style="width:90px;flex:none;"></div>
                    </div>
                </div>
                <MudTable Items="@_rows" Dense="true" Hover="true" Elevation="0" Striped="true"
                          Class="inbound-edit-table auto-table" SortMode="SortMode.None" FixedHeader="true">
                    <HeaderContent>
                        @{
                            int? _prevGk = null;
                        }
                        @foreach (var col in _visibleColumns)
                        {
                            var _isGroupStart = col.GroupKey.HasValue && col.GroupKey != _prevGk;
                            _prevGk = col.GroupKey;
                            var _headerClass = GetHeaderGroupCss(col.GroupKey, _isGroupStart);
                            <MudTh Class="@_headerClass" Style="@($"width:{GetColWidth(col.Key)}px")">
                                @col.Label
                                @if (col.IsRequired)
                                {
                                    <span class="required-star">*</span>
                                }
                            </MudTh>
                        }
                        <MudTh Style="width:90px;">操作</MudTh>
                    </HeaderContent>
                    <RowTemplate Context="r">
                        @{
                            int? _prevGk2 = null;
                        }
                        @foreach (var col in _visibleColumns)
                        {
                            var _isGroupStart2 = col.GroupKey.HasValue && col.GroupKey != _prevGk2;
                            _prevGk2 = col.GroupKey;
                            var _cellClass = GetCellGroupCss(col.GroupKey, _isGroupStart2);
                            <MudTd Class="@($"{_cellClass} {GetCellClass(col.Key)}")" Style="@($"width:{GetColWidth(col.Key)}px")">
                                @RenderInlineEditor(r, col)
                            </MudTd>
                        }
                        <MudTd Style="white-space:nowrap;">
                            @if (_rows.IndexOf(r) > 0)
                            {
                                <MudIconButton Icon="@Icons.Material.Filled.ContentCopy"
                                               Color="Color.Info" Size="Size.Small"
                                               Title="与上行相同"
                                               OnClick="() => CopyFromAbove(r, _rows.IndexOf(r))" />
                            }
                            <MudIconButton Icon="@Icons.Material.Filled.Search"
                                           Color="Color.Primary" Size="Size.Small"
                                           Title="获取来源信息"
                                           OnClick="() => LookupFromSource(r)" />
                            <MudIconButton Icon="@Icons.Material.Filled.RemoveCircleOutline"
                                           Color="Color.Error" Size="Size.Small"
                                           Title="删除"
                                           OnClick="() => RemoveRow(r)"
                                           Disabled="@(_rows.Count <= 1)" />
                        </MudTd>
                    </RowTemplate>
                    <FooterContent>
                        @{
                            int? _prevGk3 = null;
                        }
                        @foreach (var col in _visibleColumns)
                        {
                            var _isGroupStart3 = col.GroupKey.HasValue && col.GroupKey != _prevGk3;
                            _prevGk3 = col.GroupKey;
                            var _footerClass = GetCellGroupCss(col.GroupKey, _isGroupStart3);
                            <MudTd Class="@($"{_footerClass} {GetCellClass(col.Key)}")" Style="@($"width:{GetColWidth(col.Key)}px")">
                                @RenderFooter(col)
                            </MudTd>
                        }
                        <MudTd>
                            <MudIconButton Icon="@Icons.Material.Filled.AddCircleOutline"
                                           Color="Color.Primary" Size="Size.Small"
                                           OnClick="AddRow" />
                        </MudTd>
                    </FooterContent>
                </MudTable>
                </div>
            }

            @if (!string.IsNullOrEmpty(_errorMessage))
            {
                <MudText Typo="Typo.body2" Color="Color.Error" Class="mt-4">@_errorMessage</MudText>
            }

            @if (_rows.Any())
            {
                <MudGrid Class="mt-4">
                    <MudItem xs="12" Class="d-flex justify-end">
                        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.CloudUpload"
                                   OnClick="Submit" Loading="@_isSubmitting"
                                   Size="Size.Large">
                            确认入库 (@_rows.Count 条)
                        </MudButton>
                    </MudItem>
                </MudGrid>
            }
        </MudCardContent>
    </MudCard>
</MudContainer>

@code {
    [Parameter]
    public string? Code { get; set; }

    // ========== 仓库 ==========
    private List<WarehouseDto> _warehouses = new();
    private int _warehouseId;
    private string _warehouseName = "";
    private string _warehouseCode = "";

    // ========== 明细行 ==========
    private List<InboundRowModel> _rows = new();

    // ========== 列定义 ==========
    private List<ColumnDef> _allColumns = new();
    private List<ColumnDef> _visibleColumns =>
        _allColumns.Where(c => c.IsApplicable && c.Visible).ToList();

    // ========== 状态 ==========
    private bool _isSubmitting;
    private string _errorMessage = string.Empty;
    /// <summary>成品库自动填充开关</summary>
    private bool _autoFillEnabled = true;
    // ========== 行模型 ==========

    private class InboundRowModel
    {
        public string? MaterialType { get; set; }
        public string? InboundSource { get; set; }
        public string? SourceName { get; set; }
        public string? InboundDateStr { get; set; } = DateTime.Today.ToString("yyyy-MM-dd");
        public string? HeatNo { get; set; }
        public string? PlantGrade { get; set; }
        public string? Specification { get; set; }
        public string? LengthStatus { get; set; }
        public int InitialQuantity { get; set; }
        public decimal InitialWeight { get; set; }
        public decimal? UnitWeight { get; set; }
        public string? ManufacturingStatus { get; set; }
        public string? LocationArea { get; set; }
        public string? LocationRack { get; set; }
        public string? Remark { get; set; }
        public bool IsLinkedToWorkOrder { get; set; }
        public string? WorkOrderNo { get; set; }
        public string? SalesOrderNo { get; set; }
        public string? ProductionMainNo { get; set; }
        public string? OrderItemIds { get; set; }
        public string? SourceOrderNo { get; set; }
        public int? SourceOrderSequence { get; set; }
        // 新增模板字段
        public decimal? MinLength { get; set; }
        public decimal? MaxLength { get; set; }
        public decimal? Meters { get; set; }
        public string? ActualSpecification { get; set; }
        public string? ProductionBatchNo { get; set; }
        public string? DefectReason { get; set; }
        public string? LiabilityType { get; set; }
        public string? OriginalSupplier { get; set; }
        public string? TagNo { get; set; }
        public string? DefectRemark { get; set; }
    }

    // ========== 列定义初始化 ==========

    private static List<ColumnDef> GetAllColumnDefs()
    {
        return new List<ColumnDef>
        {
            // ========== 第一组：来源信息 ==========
            new() { Key = "InboundDateStr",      Label = "入库日期",       IsCommon = true, Visible = false, IsRequired = true },
            new() { Key = "InboundSource",       Label = "来源类型",       IsCommon = true, Visible = false },
            new() { Key = "SourceOrderNo",       Label = "来源单号",       IsCommon = true, Visible = false },
            new() { Key = "SourceOrderSequence", Label = "委外序号",       IsCommon = true, Visible = false },

            // ========== 第二组：自动可填充（来源单号查询后回填，可修改） ==========
            new() { Key = "MaterialType",        Label = "物料类型",       IsCommon = true, Visible = true,  IsRequired = true },
            new() { Key = "PlantGrade",          Label = "工厂牌号",       IsCommon = true, Visible = false, IsRequired = true },
            new() { Key = "Specification",       Label = "名义规格",       IsCommon = true, Visible = true,  IsRequired = true },
            new() { Key = "SourceName",          Label = "来料单位",       IsCommon = true, Visible = false },
            new() { Key = "IsLinkedToWorkOrder", Label = "关联工单",       IsCommon = true, Visible = false },
            new() { Key = "WorkOrderNo",         Label = "工单号",         IsCommon = true, Visible = false },

            // ========== 第三组：手工填写 ==========
            new() { Key = "InitialQuantity",     Label = "支数",           IsCommon = true, Visible = true,  IsRequired = true },
            new() { Key = "InitialWeight",       Label = "重量(kg)",       IsCommon = true, Visible = true,  IsRequired = true },
            new() { Key = "UnitWeight",          Label = "单支重",         IsCommon = true, Visible = false },
            new() { Key = "LengthStatus",        Label = "长度状态",       IsCommon = true, Visible = true },
            new() { Key = "HeatNo",              Label = "来料原始炉号",   IsCommon = true, Visible = false },
            new() { Key = "ManufacturingStatus",    Label = "制造状态",       IsCommon = true, Visible = true },
            new() { Key = "LocationArea",        Label = "区域",           IsCommon = true, Visible = false },
            new() { Key = "LocationRack",        Label = "框架",           IsCommon = true, Visible = false },
            new() { Key = "Remark",              Label = "备注",           IsCommon = true, Visible = false },

            // ========== 不适用（各仓库模板控制显隐） ==========
            new() { Key = "MinLength",           Label = "最小长度",       IsCommon = true, Visible = false },
            new() { Key = "MaxLength",           Label = "最大长度",       IsCommon = true, Visible = false },
            new() { Key = "Meters",              Label = "米数",           IsCommon = true, Visible = false },
            new() { Key = "ProductionBatchNo",   Label = "生产批号",       IsCommon = true, Visible = false },
            new() { Key = "ActualSpecification", Label = "实际规格",       IsCommon = true, Visible = false },
            new() { Key = "DefectReason",        Label = "次品原因",       IsCommon = true, Visible = false },
            new() { Key = "LiabilityType",       Label = "责任类型",       IsCommon = true, Visible = false },
            new() { Key = "OriginalSupplier",    Label = "原始来料",       IsCommon = true, Visible = false },
            new() { Key = "TagNo",               Label = "挂牌号",         IsCommon = true, Visible = false },
            new() { Key = "DefectRemark",        Label = "次品备注",       IsCommon = true, Visible = false },
            new() { Key = "SalesOrderNo",        Label = "订单号",         IsCommon = true, Visible = false },
            new() { Key = "ProductionMainNo",    Label = "主号",           IsCommon = true, Visible = false },
            new() { Key = "OrderItemIds",        Label = "项次",           IsCommon = true, Visible = false },
        };
    }

    private List<(string Value, string Text)> _inboundSourceOptions =>
        _warehouseCode == "RAW" && _autoFillEnabled
            ? new List<(string, string)>
            {
                (InboundSource.Purchase.ToString(), DisplayHelper.GetInboundSourceText(InboundSource.Purchase)),
                (InboundSource.Subcontract.ToString(), DisplayHelper.GetInboundSourceText(InboundSource.Subcontract)),
            }
            : _warehouseCode == "FG" && _autoFillEnabled
                ? new List<(string, string)>
                {
                    (InboundSource.Purchase.ToString(), DisplayHelper.GetInboundSourceText(InboundSource.Purchase)),
                    (InboundSource.InspectionInbound.ToString(), DisplayHelper.GetInboundSourceText(InboundSource.InspectionInbound)),
                }
            : DisplayHelper.GetEnumOptions<InboundSource>()
                .Select(o => (o.Value, o.Display))
                .ToList();

    private readonly List<(string Value, string Text)> _lengthStatusOptions =
        DisplayHelper.GetEnumOptions<LengthStatus>()
            .Select(o => (o.Value, o.Display))
            .ToList();

    private readonly List<(string Value, string Text)> _manufacturingStatusOptions =
        DisplayHelper.GetEnumOptions<DeliveryState>()
            .Select(o => (o.Value, o.Display))
            .ToList();

    private List<(string Value, string Text)> _materialTypeOptions
    {
        get
        {
            var allowed = !string.IsNullOrEmpty(_warehouseCode)
                ? MES.Core.Constants.InventoryMaterialTypes.GetAllowedTypes(_warehouseCode)
                : null;
            IEnumerable<MaterialType> types = allowed ?? DisplayHelper.GetEnumOptions<MaterialType>().Select(o => Enum.Parse<MaterialType>(o.Value));
            return types.Select(v => (v.ToString(), DisplayHelper.GetMaterialTypeText(v))).ToList();
        }
    }

    // ========== B23 分组列标题栏（同订单成品(实时库存)页面） ==========

    private int _totalTableWidth =>
        _visibleColumns.Sum(c => GetColWidth(c.Key)) + 90; // +90px 操作列

    private List<GroupHeaderInfo> _groupHeaders => GetGroupHeaders();

    private class GroupHeaderInfo
    {
        public int GroupKey { get; init; }
        public string GroupName { get; init; } = "";
        public int TotalWidth { get; init; }
        public int ColumnCount { get; init; }
        public string CssClass { get; init; } = "";
    }

    private List<GroupHeaderInfo> GetGroupHeaders()
    {
        var result = new List<GroupHeaderInfo>();
        int? lastKey = null; int totalWidth = 0;
        var groupKey = 0; var groupName = ""; var count = 0;
        foreach (var col in _visibleColumns)
        {
            var gk = col.GroupKey ?? 0;
            if (gk != lastKey && lastKey.HasValue)
            {
                result.Add(new GroupHeaderInfo
                {
                    GroupKey = groupKey,
                    GroupName = groupName,
                    TotalWidth = totalWidth,
                    ColumnCount = count,
                    CssClass = GetHeaderGroupCss(groupKey, true)
                });
                totalWidth = 0; count = 0;
            }
            groupKey = gk; groupName = col.GroupName ?? "";
            totalWidth += GetColWidth(col.Key);
            count++; lastKey = gk;
        }
        if (count > 0)
            result.Add(new GroupHeaderInfo
            {
                GroupKey = groupKey,
                GroupName = groupName,
                TotalWidth = totalWidth,
                ColumnCount = count,
                CssClass = GetHeaderGroupCss(groupKey, true)
            });
        return result;
    }

    private static string GetHeaderGroupCss(int? groupKey, bool isGroupStart)
    {
        var cls = groupKey switch { 1 => "col-g1", 2 => "col-g2", 3 => "col-g3", 4 => "col-g4", 5 => "col-g5", 6 => "col-g6", _ => "" };
        if (isGroupStart && groupKey > 1) cls += " col-group-start";
        return cls;
    }

    private static string GetCellGroupCss(int? groupKey, bool isGroupStart)
    {
        var cls = groupKey switch { 1 => "col-g1-cell", 2 => "col-g2-cell", 3 => "col-g3-cell", 4 => "col-g4-cell", 5 => "col-g5-cell", 6 => "col-g6-cell", _ => "" };
        if (isGroupStart && groupKey > 1) cls += " col-group-start-cell";
        return cls;
    }

    private static int GetColWidth(string key) => key switch
    {
        "SourceOrderNo" => 180,
        "SourceOrderSequence" => 65,
        "InitialQuantity" => 90,
        "InitialWeight" => 120,
        "UnitWeight" => 120,
        "LengthStatus" => 100,
        "InboundDateStr" => 140,
        "Specification" => 160,
        "MaterialType" => 130,
        "PlantGrade" => 130,
        "HeatNo" => 140,
        "ManufacturingStatus" => 110,
        _ => 130
    };

    private static string GetCellClass(string key) => key switch
    {
        "InitialQuantity" or "InitialWeight" or "UnitWeight" => "text-right",
        _ => ""
    };

    // ========== 仓库模板默认列 ==========

    private static void ApplyWarehouseDefaults(List<ColumnDef> cols, string whCode)
    {
        // 先全部重置为适用
        foreach (var c in cols)
            c.IsApplicable = true;

        switch (whCode)
        {
            case "RAW":
                // 原料库不含：长度/米数/实际规格/生产批号/次品/订单关联
                SetNotApplicable(cols, "MinLength");
                SetNotApplicable(cols, "MaxLength");
                SetNotApplicable(cols, "Meters");
                SetNotApplicable(cols, "ActualSpecification");
                SetNotApplicable(cols, "ProductionBatchNo");
                SetNotApplicable(cols, "DefectReason");
                SetNotApplicable(cols, "LiabilityType");
                SetNotApplicable(cols, "OriginalSupplier");
                SetNotApplicable(cols, "TagNo");
                SetNotApplicable(cols, "DefectRemark");
                SetNotApplicable(cols, "SalesOrderNo");
                SetNotApplicable(cols, "ProductionMainNo");
                SetNotApplicable(cols, "OrderItemIds");
                SetNotApplicable(cols, "IsLinkedToWorkOrder");
                AssignRawGroups(cols);
                break;
            case "FG":
                // 成品库不含：次品、委外序号、开关/订单/项次（由工单自动关联）
                SetNotApplicable(cols, "DefectReason");
                SetNotApplicable(cols, "LiabilityType");
                SetNotApplicable(cols, "OriginalSupplier");
                SetNotApplicable(cols, "TagNo");
                SetNotApplicable(cols, "DefectRemark");
                SetNotApplicable(cols, "SourceOrderSequence");
                SetNotApplicable(cols, "IsLinkedToWorkOrder");
                SetNotApplicable(cols, "SalesOrderNo");
                SetNotApplicable(cols, "OrderItemIds");
                AssignFgGroups(cols);
                break;
            case "DEFECT":
                // 次品库不含：米数/实际规格/委外序号/项次（已弃用，待阶段二删除）
                SetNotApplicable(cols, "Meters");
                SetNotApplicable(cols, "ActualSpecification");
                SetNotApplicable(cols, "SourceOrderSequence");
                SetNotApplicable(cols, "OrderItemIds");
                AssignDefectGroups(cols);
                break;
            case "WIP":
                // 在制品库不含：来源单号/委外序号/来料单位/工单关联/次品/米数
                SetNotApplicable(cols, "SourceOrderNo");
                SetNotApplicable(cols, "SourceOrderSequence");
                SetNotApplicable(cols, "SourceName");
                SetNotApplicable(cols, "IsLinkedToWorkOrder");
                SetNotApplicable(cols, "WorkOrderNo");
                SetNotApplicable(cols, "SalesOrderNo");
                SetNotApplicable(cols, "ProductionMainNo");
                SetNotApplicable(cols, "OrderItemIds");
                SetNotApplicable(cols, "DefectReason");
                SetNotApplicable(cols, "LiabilityType");
                SetNotApplicable(cols, "OriginalSupplier");
                SetNotApplicable(cols, "TagNo");
                SetNotApplicable(cols, "DefectRemark");
                SetNotApplicable(cols, "Meters");
                AssignWipGroups(cols);
                break;
        }

        // 按分组排序以确保表格列顺序与分组一致
        SortByGroup(cols);
    }

    private static void SortByGroup(List<ColumnDef> cols)
    {
        var sorted = cols.OrderBy(c => c.GroupKey ?? int.MaxValue).ToList();
        cols.Clear();
        cols.AddRange(sorted);
    }

    private static void SetNotApplicable(List<ColumnDef> cols, string key)
    {
        var c = cols.FirstOrDefault(x => x.Key == key);
        if (c != null)
        {
            c.IsApplicable = false;
            c.Visible = false;
        }
    }

    private static void AssignRawGroups(List<ColumnDef> cols)
    {
        SetGroup(cols, "InboundDateStr", 1, "来源信息");
        SetGroup(cols, "InboundSource", 1, "来源信息");
        SetGroup(cols, "SourceOrderNo", 1, "来源信息");
        SetGroup(cols, "SourceOrderSequence", 1, "来源信息");
        SetGroup(cols, "MaterialType", 2, "自动填充");
        SetGroup(cols, "PlantGrade", 2, "自动填充");
        SetGroup(cols, "Specification", 2, "自动填充");
        SetGroup(cols, "SourceName", 2, "自动填充");
        SetGroup(cols, "IsLinkedToWorkOrder", 2, "自动填充");
        SetGroup(cols, "WorkOrderNo", 2, "自动填充");
        SetGroup(cols, "InitialQuantity", 3, "手工填写");
        SetGroup(cols, "InitialWeight", 3, "手工填写");
        SetGroup(cols, "UnitWeight", 3, "手工填写");
        SetGroup(cols, "LengthStatus", 3, "手工填写");
        SetGroup(cols, "HeatNo", 3, "手工填写");
        SetGroup(cols, "ManufacturingStatus", 3, "手工填写");
        SetGroup(cols, "LocationArea", 3, "手工填写");
        SetGroup(cols, "LocationRack", 3, "手工填写");
        SetGroup(cols, "Remark", 3, "手工填写");
    }

    private static void AssignFgGroups(List<ColumnDef> cols)
    {
        SetGroup(cols, "InboundDateStr", 1, "来源信息");
        SetGroup(cols, "InboundSource", 1, "来源信息");
        SetGroup(cols, "SourceOrderNo", 1, "来源信息");
        SetGroup(cols, "ProductionBatchNo", 1, "来源信息");
        SetGroup(cols, "SalesOrderNo", 2, "订单信息");
        SetGroup(cols, "ProductionMainNo", 2, "订单信息");
        SetGroup(cols, "OrderItemIds", 2, "订单信息");
        SetGroup(cols, "WorkOrderNo", 2, "订单信息");
        SetGroup(cols, "IsLinkedToWorkOrder", 2, "订单信息");
