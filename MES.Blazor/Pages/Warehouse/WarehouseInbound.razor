    // ========== 表格内联编辑 ==========

    private static string GetColumnType(string key) => key switch
    {
        "InboundSource" or "LengthStatus" => "select",
        "IsLinkedToWorkOrder" => "bool",
        "InitialQuantity" => "int",
        "SourceOrderSequence" => "nullable-int",
        "InitialWeight" => "decimal",
        "UnitWeight" or "MinLength" or "MaxLength" or "Meters"
            or "ActualOuterDiameter" or "ActualWallThickness" => "decimal",
        _ => "text"
    };

    private RenderFragment RenderInlineEditor(InboundRowModel row, ColumnDef col) => builder =>
    {
        switch (GetColumnType(col.Key))
        {
            case "select":
                var options = col.Key == "LengthStatus" ? _lengthStatusOptions : _inboundSourceOptions;
                var selVal = GetRowStringValue(row, col.Key);
                builder.OpenComponent<MudSelect<string>>(0);
                builder.AddAttribute(1, "Dense", true);
                builder.AddAttribute(2, "Variant", Variant.Outlined);
                builder.AddAttribute(3, "Value", selVal);
                builder.AddAttribute(4, "ValueChanged", EventCallback.Factory.Create<string?>(this, v => SetRowStringValue(row, col.Key, v)));
                builder.AddAttribute(5, "ChildContent", (RenderFragment)(b2 =>
                {
                    b2.OpenComponent<MudSelectItem<string>>(0);
                    b2.AddAttribute(1, "Value", (string?)null);
                    b2.CloseComponent();
                    foreach (var opt in options)
                    {
                        b2.OpenComponent<MudSelectItem<string>>(0);
                        b2.AddAttribute(1, "Value", opt.Value);
                        b2.AddAttribute(2, "ChildContent", (RenderFragment)(b3 => b3.AddContent(0, opt.Text)));
                        b2.CloseComponent();
                    }
                }));
                builder.CloseComponent();
                break;

            case "bool":
                builder.OpenComponent<MudSwitch<bool>>(0);
                builder.AddAttribute(1, "Dense", true);
                builder.AddAttribute(2, "Color", Color.Primary);
                builder.AddAttribute(3, "Value", row.IsLinkedToWorkOrder);
                builder.AddAttribute(4, "ValueChanged", EventCallback.Factory.Create<bool>(this, v =>
                {
                    row.IsLinkedToWorkOrder = v;
                    if (!v)
                    {
                        row.WorkOrderNo = null;
                        row.SalesOrderNo = null;
                        row.OrderItemIds = null;
                    }
                }));
                builder.CloseComponent();
                break;

            case "nullable-int":
                builder.OpenComponent<MudNumericField<int?>>(0);
                builder.AddAttribute(1, "Dense", true);
                builder.AddAttribute(2, "HideSpinButtons", true);
                builder.AddAttribute(3, "Value", row.SourceOrderSequence);
                builder.AddAttribute(4, "ValueChanged", EventCallback.Factory.Create<int?>(this, v => row.SourceOrderSequence = v));
                builder.AddAttribute(5, "Clearable", true);
                builder.CloseComponent();
                break;

            case "int":
                builder.OpenComponent<MudNumericField<int>>(0);
                builder.AddAttribute(1, "Dense", true);
                builder.AddAttribute(2, "HideSpinButtons", true);
                builder.AddAttribute(3, "Value", row.InitialQuantity);
                builder.AddAttribute(4, "ValueChanged", EventCallback.Factory.Create<int>(this, v => row.InitialQuantity = v));
                builder.CloseComponent();
                break;

            case "decimal":
                if (col.Key is "UnitWeight" or "MinLength" or "MaxLength" or "Meters" or "ActualOuterDiameter" or "ActualWallThickness")
                {
                    builder.OpenComponent<MudNumericField<decimal?>>(0);
                    builder.AddAttribute(1, "Dense", true);
                    builder.AddAttribute(2, "HideSpinButtons", true);
                    builder.AddAttribute(3, "Format", "G29");
                    builder.AddAttribute(4, "Value", GetRowNullableDecimal(row, col.Key));
                    builder.AddAttribute(5, "ValueChanged", EventCallback.Factory.Create<decimal?>(this, v => SetRowNullableDecimal(row, col.Key, v)));
                    builder.CloseComponent();
                }
                else
                {
                    builder.OpenComponent<MudNumericField<decimal>>(0);
                    builder.AddAttribute(1, "Dense", true);
                    builder.AddAttribute(2, "HideSpinButtons", true);
                    builder.AddAttribute(3, "Format", "G29");
                    builder.AddAttribute(4, "Value", row.InitialWeight);
                    builder.AddAttribute(5, "ValueChanged", EventCallback.Factory.Create<decimal>(this, v => row.InitialWeight = v));
                    builder.CloseComponent();
                }
                break;

            default: // text
                var txtVal = GetRowStringValue(row, col.Key);
                builder.OpenComponent<MudTextField<string>>(0);
                builder.AddAttribute(1, "Dense", true);
                builder.AddAttribute(2, "Variant", Variant.Outlined);
                builder.AddAttribute(3, "Value", txtVal);
                builder.AddAttribute(4, "ValueChanged", EventCallback.Factory.Create<string?>(this, v => SetRowStringValue(row, col.Key, v)));
                builder.CloseComponent();
                break;
        }
    };

