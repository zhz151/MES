    // ========== 自动填充标记 ==========
    /// <summary>支持自动填充的入库来源（Group 2 字段只读）</summary>
    private static readonly HashSet<string> _autoFillSources = new()
    {
        InboundSource.Purchase.ToString(),
        InboundSource.Subcontract.ToString(),
        InboundSource.InspectionInbound.ToString()
    };

    /// <summary>Group 2 自动填充字段</summary>
    private static readonly HashSet<string> _autoFillFields = new()
    {
        "MaterialType", "PlantGrade", "Specification",
        "SourceName", "IsLinkedToWorkOrder", "WorkOrderNo",
        "SalesOrderNo", "ProductionMainNo"
    };

    private bool IsAutoFillReadOnly(InboundRowModel row, string key) =>
        (_warehouseCode == "RAW" && _autoFillEnabled &&
         _autoFillSources.Contains(row.InboundSource ?? "") && _autoFillFields.Contains(key)) ||
        (_warehouseCode == "FG" && _autoFillEnabled &&
         _autoFillSources.Contains(row.InboundSource ?? "") && _autoFillFields.Contains(key)) ||
        (_warehouseCode == "FG" && _autoFillEnabled &&
         row.InboundSource == InboundSource.InspectionInbound.ToString() && key == "SourceOrderNo") ||
        (_warehouseCode == "FG" && _autoFillEnabled &&
         row.InboundSource == InboundSource.Purchase.ToString() && key == "ProductionBatchNo");

    // ========== 表格内联编辑 ==========

    private static string GetColumnType(string key) => key switch
    {
        "InboundSource" or "LengthStatus" or "MaterialType" or "ManufacturingStatus" => "select",
        "IsLinkedToWorkOrder" => "bool",
        "InitialQuantity" => "int",
        "SourceOrderSequence" => "nullable-int",
        "InitialWeight" => "decimal",
        "UnitWeight" or "MinLength" or "MaxLength" or "Meters" => "decimal",
        _ => "text"
    };

    private RenderFragment RenderInlineEditor(InboundRowModel row, ColumnDef col) => builder =>
    {
        // Group 2 字段在来源为外购/委外时只读显示（由自动填充填入）
        if (IsAutoFillReadOnly(row, col.Key))
        {
            RenderCell(row, col)(builder);
            return;
        }

        switch (GetColumnType(col.Key))
        {
            case "select":
                var options = col.Key == "LengthStatus" ? _lengthStatusOptions
                    : col.Key == "MaterialType" ? _materialTypeOptions
                    : col.Key == "ManufacturingStatus" ? _manufacturingStatusOptions
                    : _inboundSourceOptions;
                var selVal = GetRowStringValue(row, col.Key);
                builder.OpenComponent<MudSelect<string>>(0);
                builder.AddAttribute(1, "Dense", true);
                builder.AddAttribute(2, "Variant", Variant.Outlined);
                builder.AddAttribute(3, "Value", selVal);
                builder.AddAttribute(4, "ValueChanged", EventCallback.Factory.Create<string?>(this, v => SetRowStringValue(row, col.Key, v)));
                builder.AddAttribute(5, "ChildContent", (RenderFragment)(b2 =>
                {
                    b2.OpenComponent<MudSelectItem<string>>(0);
                    b2.AddAttribute(1, "Value", (string?)null);
                    b2.CloseComponent();
                    foreach (var opt in options)
                    {
                        b2.OpenComponent<MudSelectItem<string>>(0);
                        b2.AddAttribute(1, "Value", opt.Value);
                        b2.AddAttribute(2, "Text", opt.Text);
                        b2.AddAttribute(3, "ChildContent", (RenderFragment)(b3 => b3.AddContent(0, opt.Text)));
                        b2.CloseComponent();
                    }
                }));
                builder.CloseComponent();
                break;

            case "bool":
                builder.OpenComponent<MudSwitch<bool>>(0);
                builder.AddAttribute(1, "Dense", true);
                builder.AddAttribute(2, "Color", Color.Primary);
                builder.AddAttribute(3, "Value", row.IsLinkedToWorkOrder);
                builder.AddAttribute(4, "ValueChanged", EventCallback.Factory.Create<bool>(this, v =>
                {
                    row.IsLinkedToWorkOrder = v;
                    if (!v)
                    {
                        row.WorkOrderNo = null;
                        row.SalesOrderNo = null;
                        row.ProductionMainNo = null;
                        row.OrderItemIds = null;
                    }
                }));
                builder.CloseComponent();
                break;

            case "nullable-int":
                // 来源序号仅委外时显示编辑控件
                if (row.InboundSource == InboundSource.Subcontract.ToString())
                {
                    builder.OpenComponent<MudNumericField<int?>>(0);
                    builder.AddAttribute(1, "Dense", true);
                    builder.AddAttribute(2, "HideSpinButtons", true);
                    builder.AddAttribute(3, "Value", row.SourceOrderSequence);
                    builder.AddAttribute(4, "ValueChanged", EventCallback.Factory.Create<int?>(this, v => { row.SourceOrderSequence = v; _ = TriggerAutoFillAsync(row); }));
                    builder.AddAttribute(5, "Immediate", false);
                    builder.CloseComponent();
                }
                break;

            case "int":
                builder.OpenComponent<MudNumericField<int>>(0);
                builder.AddAttribute(1, "Dense", true);
                builder.AddAttribute(2, "HideSpinButtons", true);
                builder.AddAttribute(3, "Value", row.InitialQuantity);
                builder.AddAttribute(4, "ValueChanged", EventCallback.Factory.Create<int>(this, v =>
                {
                    row.InitialQuantity = v;
                    if (row.InitialWeight > 0 && v > 0)
                        row.UnitWeight = Math.Round(row.InitialWeight / (decimal)v, 1, MidpointRounding.AwayFromZero);
                }));
                builder.CloseComponent();
                break;

            case "decimal":
                if (col.Key is "UnitWeight" or "MinLength" or "MaxLength" or "Meters")
                {
                    builder.OpenComponent<MudNumericField<decimal?>>(0);
                    builder.AddAttribute(1, "Dense", true);
                    builder.AddAttribute(2, "HideSpinButtons", true);
                    builder.AddAttribute(3, "Format", "G29");
                    builder.AddAttribute(4, "Value", GetRowNullableDecimal(row, col.Key));
                    builder.AddAttribute(5, "ValueChanged", EventCallback.Factory.Create<decimal?>(this, v => SetRowNullableDecimal(row, col.Key, v)));
                    builder.CloseComponent();
                }
                else
                {
                    builder.OpenComponent<MudNumericField<decimal>>(0);
                    builder.AddAttribute(1, "Dense", true);
                    builder.AddAttribute(2, "HideSpinButtons", true);
                    builder.AddAttribute(3, "Format", "G29");
                    builder.AddAttribute(4, "Value", row.InitialWeight);
                    builder.AddAttribute(5, "ValueChanged", EventCallback.Factory.Create<decimal>(this, v =>
                    {
                        row.InitialWeight = v;
                        if (row.InitialQuantity > 0 && v > 0)
                            row.UnitWeight = Math.Round(v / row.InitialQuantity, 1, MidpointRounding.AwayFromZero);
                    }));
                    builder.CloseComponent();
                }
                break;

            default: // text
                var txtVal = GetRowStringValue(row, col.Key);
                builder.OpenComponent<MudTextField<string>>(0);
                builder.AddAttribute(1, "Dense", true);
                builder.AddAttribute(2, "Variant", Variant.Outlined);
                builder.AddAttribute(3, "Value", txtVal);
                builder.AddAttribute(4, "ValueChanged", EventCallback.Factory.Create<string?>(this, v => SetRowStringValue(row, col.Key, v)));
                if (col.Key is "SourceOrderNo" or "ProductionBatchNo")
                    builder.AddAttribute(5, "Immediate", false);
                builder.CloseComponent();
                break;
        }
    };

    private string? GetRowStringValue(InboundRowModel row, string key) => key switch
    {
        "MaterialType" => row.MaterialType,
        "InboundSource" => row.InboundSource,
        "SourceName" => row.SourceName,
        "InboundDateStr" => row.InboundDateStr,
        "HeatNo" => row.HeatNo,
        "PlantGrade" => row.PlantGrade,
        "Specification" => row.Specification,
        "LengthStatus" => row.LengthStatus,
        "ManufacturingStatus" => row.ManufacturingStatus,
        "LocationArea" => row.LocationArea,
        "LocationRack" => row.LocationRack,
        "Remark" => row.Remark,
        "WorkOrderNo" => row.WorkOrderNo,
        "SalesOrderNo" => row.SalesOrderNo,
        "ProductionMainNo" => row.ProductionMainNo,
        "OrderItemIds" => row.OrderItemIds,
        "SourceOrderNo" => row.SourceOrderNo,
        "ActualSpecification" => row.ActualSpecification,
        "ProductionBatchNo" => row.ProductionBatchNo,
        "DefectReason" => row.DefectReason,
        "LiabilityType" => row.LiabilityType,
        "OriginalSupplier" => row.OriginalSupplier,
        "TagNo" => row.TagNo,
        "DefectRemark" => row.DefectRemark,
        _ => null
    };

    private void SetRowStringValue(InboundRowModel row, string key, string? value)
    {
        switch (key)
        {
            case "MaterialType": row.MaterialType = value; break;
            case "InboundSource": row.InboundSource = value; if (value != InboundSource.Subcontract.ToString()) row.SourceOrderSequence = null; _ = TriggerAutoFillAsync(row); break;
            case "SourceName": row.SourceName = value; break;
            case "InboundDateStr": row.InboundDateStr = value; break;
            case "HeatNo": row.HeatNo = value; break;
            case "PlantGrade": row.PlantGrade = value; break;
            case "Specification": row.Specification = value; break;
            case "LengthStatus": row.LengthStatus = value; break;
            case "ManufacturingStatus": row.ManufacturingStatus = value; break;
            case "LocationArea": row.LocationArea = value; break;
            case "LocationRack": row.LocationRack = value; break;
            case "Remark": row.Remark = value; break;
            case "WorkOrderNo": row.WorkOrderNo = value; row.IsLinkedToWorkOrder = !string.IsNullOrEmpty(value); break;
            case "SalesOrderNo": row.SalesOrderNo = value; break;
            case "ProductionMainNo": row.ProductionMainNo = value; break;
            case "OrderItemIds": row.OrderItemIds = value; break;
            case "SourceOrderNo": row.SourceOrderNo = value; _ = TriggerAutoFillAsync(row); break;
            case "ActualSpecification": row.ActualSpecification = value; break;
            case "ProductionBatchNo": row.ProductionBatchNo = value; if (row.InboundSource == InboundSource.InspectionInbound.ToString()) _ = TriggerAutoFillAsync(row); break;
            case "DefectReason": row.DefectReason = value; break;
            case "LiabilityType": row.LiabilityType = value; break;
            case "OriginalSupplier": row.OriginalSupplier = value; break;
            case "TagNo": row.TagNo = value; break;
            case "DefectRemark": row.DefectRemark = value; break;
        }
    }

