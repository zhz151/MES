@page "/warehouse/inbound"
@page "/warehouse/inbound/{Code}"
@using MES.Blazor.Services
@using MES.Core.Models
@using MES.Blazor.Helpers
@using MES.Core.DTOs.Warehouse
@using Microsoft.AspNetCore.Authorization
@inject WarehouseService WarehouseService
@inject InventoryService InventoryService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject ColumnPrefsService ColumnPrefs
@inject IJSRuntime JS
@inject IDialogService DialogService
@attribute [Authorize]

<MudContainer MaxWidth="MaxWidth.False" Class="mt-4">
    <style>
        .inbound-edit-table {
            width: 100%;
        }
        .inbound-edit-table td.mud-table-cell,
        .inbound-edit-table th.mud-table-cell {
            padding: 1px 4px !important;
        }
        .inbound-edit-table .mud-input-input-control {
            margin-top: 0;
        }
        .inbound-edit-table .mud-input {
            font-size: 13px;
            width: 100%;
            min-width: 0;
        }
        /* 表头不换行，但不设固定宽度 */
        .inbound-edit-table th.mud-table-cell {
            white-space: nowrap;
        }
        /* 滚动容器 */
        .inbound-table-scroll {
            max-height: calc(100vh - 310px);
            overflow-y: auto;
            overflow-x: auto;
        }
    </style>
    <MudCard>
        <MudCardHeader>
            <CardHeaderContent>
                <MudText Typo="Typo.h5" Class="font-weight-bold">
                    <MudIcon Icon="@Icons.Material.Filled.AddCircleOutline" Class="mr-2" Color="Color.Primary" />
                    批量入库
                    @if (!string.IsNullOrEmpty(_warehouseName))
                    {
                        <span> — @_warehouseName</span>
                    }
                </MudText>
            </CardHeaderContent>
            <CardHeaderActions>
                <MudButton Variant="Variant.Text" Color="Color.Default" OnClick="GoBack">返回</MudButton>
            </CardHeaderActions>
        </MudCardHeader>

        <MudCardContent>
            @if (string.IsNullOrEmpty(Code))
            {
                <MudGrid Class="mb-4">
                    <MudItem xs="12" md="4">
                        <MudSelect T="int" Label="仓库 *"
                                   @bind-Value="_warehouseId"
                                   OnValueChanged="OnWarehouseChanged">
                            @foreach (var wh in _warehouses)
                            {
                                <MudSelectItem Value="(int?)wh.Id">@wh.Name</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                </MudGrid>
            }

            <!-- ============ 入库明细表 ============ -->
            @if (_rows.Any())
            {
                <div class="d-flex align-center mb-2">
                    <MudText Typo="Typo.body2">共 @_rows.Count 行</MudText>
                    <MudSpacer />
                    <ColumnDisplaySelect Columns="_allColumns"
                                         ShowCommonFields="true"
                                         OnColumnToggle="OnColumnToggle"
                                         OnMoveUp="MoveColumnUp"
                                         OnMoveDown="MoveColumnDown" />
                    <MudButton Variant="Variant.Text" Size="Size.Small"
                               Color="Color.Default"
                               StartIcon="@Icons.Material.Filled.RestartAlt"
                               OnClick="ResetAll" Class="ml-2">
                        重置
                    </MudButton>
                </div>
                <div class="inbound-table-scroll">
                <MudTable Items="@_rows" Dense="true" Hover="true" Elevation="0" Striped="true"
                          Class="inbound-edit-table auto-table" SortMode="SortMode.None" FixedHeader="true">
                    <HeaderContent>
                        @foreach (var col in _visibleColumns)
                        {
                            <MudTh Style="@($"width:{GetColWidth(col.Key)}px")">
                                @col.Label
                                @if (col.IsRequired)
                                {
                                    <span class="required-star">*</span>
                                }
                            </MudTh>
                        }
                        <MudTh Style="width:90px;">操作</MudTh>
                    </HeaderContent>
                    <RowTemplate Context="r">
                        @foreach (var col in _visibleColumns)
                        {
                            <MudTd Class="@GetCellClass(col.Key)">
                                @RenderInlineEditor(r, col)
                            </MudTd>
                        }
                        <MudTd Style="white-space:nowrap;">
                            @if (_rows.IndexOf(r) > 0)
                            {
                                <MudIconButton Icon="@Icons.Material.Filled.ContentCopy"
                                               Color="Color.Info" Size="Size.Small"
                                               Title="与上行相同"
                                               OnClick="() => CopyFromAbove(r, _rows.IndexOf(r))" />
                            }
                            <MudIconButton Icon="@Icons.Material.Filled.Search"
                                           Color="Color.Primary" Size="Size.Small"
                                           Title="获取来源信息"
                                           OnClick="() => LookupSourceOrder(r)" />
                            <MudIconButton Icon="@Icons.Material.Filled.RemoveCircleOutline"
                                           Color="Color.Error" Size="Size.Small"
                                           Title="删除"
                                           OnClick="() => RemoveRow(r)"
                                           Disabled="@(_rows.Count <= 1)" />
                        </MudTd>
                    </RowTemplate>
                    <FooterContent>
                        @foreach (var col in _visibleColumns)
                        {
                            <MudTd Class="@GetCellClass(col.Key)">
                                @RenderFooter(col)
                            </MudTd>
                        }
                        <MudTd>
                            <MudIconButton Icon="@Icons.Material.Filled.AddCircleOutline"
                                           Color="Color.Primary" Size="Size.Small"
                                           OnClick="AddRow" />
                        </MudTd>
                    </FooterContent>
                </MudTable>
                </div>
            }

            @if (!string.IsNullOrEmpty(_errorMessage))
            {
                <MudText Typo="Typo.body2" Color="Color.Error" Class="mt-4">@_errorMessage</MudText>
            }

            @if (_rows.Any())
            {
                <MudGrid Class="mt-4">
                    <MudItem xs="12" Class="d-flex justify-end">
                        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.CloudUpload"
                                   OnClick="Submit" Loading="@_isSubmitting"
                                   Size="Size.Large">
                            确认入库 (@_rows.Count 条)
                        </MudButton>
                    </MudItem>
                </MudGrid>
            }
        </MudCardContent>
    </MudCard>
</MudContainer>

@code {
    [Parameter]
    public string? Code { get; set; }

    // ========== 仓库 ==========
    private List<WarehouseDto> _warehouses = new();
    private int _warehouseId;
    private string _warehouseName = "";
    private string _warehouseCode = "";

    // ========== 明细行 ==========
    private List<InboundRowModel> _rows = new();

    // ========== 列定义 ==========
    private List<ColumnDef> _allColumns = new();
    private List<ColumnDef> _visibleColumns =>
        _allColumns.Where(c => c.IsApplicable && c.Visible).ToList();

    // ========== 状态 ==========
    private bool _isSubmitting;
    private string _errorMessage = string.Empty;
    // ========== 行模型 ==========

    private class InboundRowModel
    {
        public string? MaterialType { get; set; }
        public string? InboundSource { get; set; }
        public string? SourceName { get; set; }
        public string? InboundDateStr { get; set; } = DateTime.Today.ToString("yyyy-MM-dd");
        public string? HeatNo { get; set; }
        public string? PlantGrade { get; set; }
        public string? Specification { get; set; }
        public string? LengthStatus { get; set; }
        public int InitialQuantity { get; set; }
        public decimal InitialWeight { get; set; }
        public decimal? UnitWeight { get; set; }
        public string? SurfaceCondition { get; set; }
        public string? LocationArea { get; set; }
        public string? LocationRack { get; set; }
        public string? Remark { get; set; }
        public bool IsLinkedToWorkOrder { get; set; }
        public string? WorkOrderNo { get; set; }
        public string? SalesOrderNo { get; set; }
        public string? OrderItemIds { get; set; }
        public string? SourceOrderNo { get; set; }
        public int? SourceOrderSequence { get; set; }
        // 新增模板字段
        public decimal? MinLength { get; set; }
        public decimal? MaxLength { get; set; }
        public decimal? Meters { get; set; }
        public string? ActualSpecification { get; set; }
        public decimal? ActualOuterDiameter { get; set; }
        public decimal? ActualWallThickness { get; set; }
        public string? ProductionBatchNo { get; set; }
        public string? DefectReason { get; set; }
        public string? LiabilityType { get; set; }
        public string? OriginalSupplier { get; set; }
        public string? TagNo { get; set; }
        public string? DefectRemark { get; set; }
    }

    // ========== 列定义初始化 ==========

    private static List<ColumnDef> GetAllColumnDefs()
    {
        return new List<ColumnDef>
        {
            new() { Key = "InboundDateStr",      Label = "入库日期",       IsCommon = true, Visible = false, IsRequired = true },
            new() { Key = "InboundSource",       Label = "入库来源",       IsCommon = true, Visible = false },
            new() { Key = "SourceOrderNo",       Label = "来源单号",       IsCommon = true, Visible = false },
            new() { Key = "SourceOrderSequence", Label = "来源序号",       IsCommon = true, Visible = false },
            new() { Key = "MaterialType",        Label = "物料名称",       IsCommon = true, Visible = true,  IsRequired = true },
            new() { Key = "SourceName",          Label = "来料单位或部门", IsCommon = true, Visible = false },
            new() { Key = "SurfaceCondition",    Label = "物料状态",       IsCommon = true, Visible = true  },
            new() { Key = "LocationArea",        Label = "放置区域",       IsCommon = true, Visible = false },
            new() { Key = "LocationRack",        Label = "放置框架",       IsCommon = true, Visible = false },
            new() { Key = "HeatNo",              Label = "炉号",           IsCommon = true, Visible = false },
            new() { Key = "PlantGrade",          Label = "工厂牌号",       IsCommon = true, Visible = false, IsRequired = true },
            new() { Key = "Specification",       Label = "名义规格",       IsCommon = true, Visible = true,  IsRequired = true },
            new() { Key = "LengthStatus",        Label = "长度状态",       IsCommon = true, Visible = true  },
            new() { Key = "MinLength",           Label = "最小长度",       IsCommon = true, Visible = false },
            new() { Key = "MaxLength",           Label = "最大长度",       IsCommon = true, Visible = false },
            new() { Key = "InitialQuantity",     Label = "支数",           IsCommon = true, Visible = true,  IsRequired = true },
            new() { Key = "InitialWeight",       Label = "重量",           IsCommon = true, Visible = true,  IsRequired = true },
            new() { Key = "UnitWeight",          Label = "理论单支重",     IsCommon = true, Visible = false },
            new() { Key = "Meters",              Label = "米数",           IsCommon = true, Visible = false },
            new() { Key = "Remark",              Label = "物料备注",       IsCommon = true, Visible = false },
            new() { Key = "IsLinkedToWorkOrder", Label = "关联工单",       IsCommon = true, Visible = false },
            new() { Key = "WorkOrderNo",         Label = "工单号",         IsCommon = true, Visible = false },
            new() { Key = "SalesOrderNo",        Label = "订单号",         IsCommon = true, Visible = false },
            new() { Key = "OrderItemIds",        Label = "项次ID列表",     IsCommon = true, Visible = false },
            new() { Key = "ProductionBatchNo",   Label = "生产批号",       IsCommon = true, Visible = false },
            new() { Key = "ActualSpecification", Label = "实际规格",       IsCommon = true, Visible = false },
            new() { Key = "ActualOuterDiameter", Label = "实际外径",       IsCommon = true, Visible = false },
            new() { Key = "ActualWallThickness", Label = "实际壁厚",       IsCommon = true, Visible = false },
            new() { Key = "DefectReason",        Label = "次品原因",       IsCommon = true, Visible = false },
            new() { Key = "LiabilityType",       Label = "责任类型",       IsCommon = true, Visible = false },
            new() { Key = "OriginalSupplier",    Label = "原始来料单位",   IsCommon = true, Visible = false },
            new() { Key = "TagNo",               Label = "挂牌号",         IsCommon = true, Visible = false },
            new() { Key = "DefectRemark",        Label = "次品备注",       IsCommon = true, Visible = false },
        };
    }

    private readonly List<(string Value, string Text)> _inboundSourceOptions = new()
    {
        ("Purchase", "外购"),
        ("Subcontract", "委外"),
        ("ReturnIn", "退货入库"),
        ("ProductionInbound", "生产入库"),
        ("InspectionInbound", "检验入库"),
        ("TransferIn", "移库入库"),
        ("Other", "其它"),
    };

    private readonly List<(string Value, string Text)> _lengthStatusOptions = new()
    {
        ("Fixed", "定尺"),
        ("Range", "范围尺"),
        ("NonFixed", "非定尺"),
    };

    private static int GetColWidth(string key) => key switch
    {
        "SourceOrderSequence" => 90,
        "InitialQuantity" => 90,
        "InitialWeight" => 120,
        "UnitWeight" => 120,
        "LengthStatus" => 100,
        "InboundDateStr" => 140,
        "Specification" => 160,
        "MaterialType" => 130,
        "PlantGrade" => 130,
        "HeatNo" => 120,
        "SurfaceCondition" => 110,
        _ => 130
    };

    private static string GetCellClass(string key) => key switch
    {
        "InitialQuantity" or "InitialWeight" or "UnitWeight" => "text-right",
        _ => ""
    };

    // ========== 仓库模板默认列 ==========

    private static void ApplyWarehouseDefaults(List<ColumnDef> cols, string whCode)
    {
        // 先全部重置为适用
        foreach (var c in cols)
            c.IsApplicable = true;

        switch (whCode)
        {
            case "RAW":
                // 原料库不含：长度/米数/实际规格/生产批号/次品
                SetNotApplicable(cols, "MinLength");
                SetNotApplicable(cols, "MaxLength");
                SetNotApplicable(cols, "Meters");
                SetNotApplicable(cols, "ActualSpecification");
                SetNotApplicable(cols, "ActualOuterDiameter");
                SetNotApplicable(cols, "ActualWallThickness");
                SetNotApplicable(cols, "ProductionBatchNo");
                SetNotApplicable(cols, "DefectReason");
                SetNotApplicable(cols, "LiabilityType");
                SetNotApplicable(cols, "OriginalSupplier");
                SetNotApplicable(cols, "TagNo");
                SetNotApplicable(cols, "DefectRemark");
                break;
            case "FG":
                // 成品库不含：次品
                SetNotApplicable(cols, "DefectReason");
                SetNotApplicable(cols, "LiabilityType");
                SetNotApplicable(cols, "OriginalSupplier");
                SetNotApplicable(cols, "TagNo");
                SetNotApplicable(cols, "DefectRemark");
                break;
            case "DEFECT":
                // 次品库不含：米数/实际规格/外径/壁厚
                SetNotApplicable(cols, "Meters");
                SetNotApplicable(cols, "ActualSpecification");
                SetNotApplicable(cols, "ActualOuterDiameter");
                SetNotApplicable(cols, "ActualWallThickness");
                break;
            case "WIP":
                // 在制品库不含：工单关联/次品/米数
                SetNotApplicable(cols, "IsLinkedToWorkOrder");
                SetNotApplicable(cols, "WorkOrderNo");
                SetNotApplicable(cols, "SalesOrderNo");
                SetNotApplicable(cols, "OrderItemIds");
                SetNotApplicable(cols, "DefectReason");
                SetNotApplicable(cols, "LiabilityType");
                SetNotApplicable(cols, "OriginalSupplier");
                SetNotApplicable(cols, "TagNo");
                SetNotApplicable(cols, "DefectRemark");
                SetNotApplicable(cols, "Meters");
                break;
        }
    }

    private static void SetNotApplicable(List<ColumnDef> cols, string key)
    {
        var c = cols.FirstOrDefault(x => x.Key == key);
        if (c != null)
        {
            c.IsApplicable = false;
            c.Visible = false;
        }
    }

    // ========== 列管理 ==========

    private async Task MoveColumnUp(ColumnDef col)
    {
        await SaveColumnPrefs();
    }

    private async Task MoveColumnDown(ColumnDef col)
    {
        await SaveColumnPrefs();
    }

    private async Task OnColumnToggle(ColumnDef col)
    {
        await SaveColumnPrefs();
    }

    private async Task LoadColumnPrefs()
    {
        var saved = await ColumnPrefs.LoadAsync("inbound", _warehouseCode);
        if (saved.Count > 0)
        {
            foreach (var s in saved)
            {
                var match = _allColumns.FirstOrDefault(c => c.Key == s.Key);
                if (match != null)
                {
                    match.Visible = s.Visible;
                }
            }
            // 恢复顺序：将saved中存在的列按saved顺序重排，新列追加在末尾
            var reordered = new List<ColumnDef>();
            foreach (var s in saved)
            {
                var match = _allColumns.FirstOrDefault(c => c.Key == s.Key);
                if (match != null && !reordered.Contains(match))
                    reordered.Add(match);
            }
            foreach (var c in _allColumns)
            {
                if (!reordered.Contains(c))
                    reordered.Add(c);
            }
            _allColumns = reordered;
        }

        // 不适用列强制隐藏
        foreach (var c in _allColumns)
        {
            if (!c.IsApplicable) c.Visible = false;
        }
    }

    private async Task SaveColumnPrefs()
    {
        await ColumnPrefs.SaveAsync("inbound", _warehouseCode, _allColumns);
    }

    // ========== 初始化 ==========

    protected override async Task OnInitializedAsync()
    {
        _allColumns = GetAllColumnDefs();

        var result = await WarehouseService.GetAllAsync(true);
        if (result.Success && result.Data != null)
        {
            _warehouses = result.Data;

            if (!string.IsNullOrEmpty(Code))
            {
                var wh = _warehouses.FirstOrDefault(w => w.Code.Equals(Code, StringComparison.OrdinalIgnoreCase));
                if (wh != null)
                {
                    _warehouseId = wh.Id;
                    _warehouseName = wh.Name;
                    _warehouseCode = wh.Code.ToUpperInvariant();
                }
            }

            if (_warehouseId <= 0 && _warehouses.Any())
            {
                _warehouseId = _warehouses[0].Id;
                _warehouseName = _warehouses[0].Name;
                _warehouseCode = _warehouses[0].Code.ToUpperInvariant();
            }
        }

        // 按仓库模板设置适用列
        ApplyWarehouseDefaults(_allColumns, _warehouseCode);
        await LoadColumnPrefs();

        // 自动初始化一行空数据
        if (!_rows.Any())
            _rows.Add(new InboundRowModel());
    }

    private bool _isArrowNavSetup;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_isArrowNavSetup)
        {
            _isArrowNavSetup = true;
            if (!await JS.InvokeAsync<bool>("enableTableArrowNav", ".inbound-table-scroll"))
                _isArrowNavSetup = false;
        }
    }

    private async Task OnWarehouseChanged(int whId)
    {
        var wh = _warehouses.FirstOrDefault(w => w.Id == whId);
        if (wh != null)
        {
            _warehouseName = wh.Name;
            _warehouseCode = wh.Code.ToUpperInvariant();
            _allColumns = GetAllColumnDefs();
            ApplyWarehouseDefaults(_allColumns, _warehouseCode);
            await LoadColumnPrefs();
            _rows.Clear();
            _rows.Add(new InboundRowModel());
            _errorMessage = string.Empty;
        }
    }

    // ========== 行管理 ==========

    private void AddRow()
    {
        var newRow = new InboundRowModel();
        if (_rows.Any())
        {
            var source = _rows[^1];
            foreach (var col in _allColumns.Where(c => c.IsApplicable && c.IsCommon))
            {
                switch (col.Key)
                {
                    case "MaterialType": newRow.MaterialType = source.MaterialType; break;
                    case "InboundSource": newRow.InboundSource = source.InboundSource; break;
                    case "SourceName": newRow.SourceName = source.SourceName; break;
                    case "InboundDateStr": newRow.InboundDateStr = source.InboundDateStr; break;
                    case "HeatNo": newRow.HeatNo = source.HeatNo; break;
                    case "PlantGrade": newRow.PlantGrade = source.PlantGrade; break;
                    case "Specification": newRow.Specification = source.Specification; break;
                    case "LengthStatus": newRow.LengthStatus = source.LengthStatus; break;
                    case "SurfaceCondition": newRow.SurfaceCondition = source.SurfaceCondition; break;
                    case "LocationArea": newRow.LocationArea = source.LocationArea; break;
                    case "LocationRack": newRow.LocationRack = source.LocationRack; break;
                    case "UnitWeight": newRow.UnitWeight = source.UnitWeight; break;
                    case "MinLength": newRow.MinLength = source.MinLength; break;
                    case "MaxLength": newRow.MaxLength = source.MaxLength; break;
                    case "Meters": newRow.Meters = source.Meters; break;
                    case "ActualSpecification": newRow.ActualSpecification = source.ActualSpecification; break;
                    case "ActualOuterDiameter": newRow.ActualOuterDiameter = source.ActualOuterDiameter; break;
                    case "ActualWallThickness": newRow.ActualWallThickness = source.ActualWallThickness; break;
                    case "ProductionBatchNo": newRow.ProductionBatchNo = source.ProductionBatchNo; break;
                    case "DefectReason": newRow.DefectReason = source.DefectReason; break;
                    case "LiabilityType": newRow.LiabilityType = source.LiabilityType; break;
                    case "OriginalSupplier": newRow.OriginalSupplier = source.OriginalSupplier; break;
                    case "TagNo": newRow.TagNo = source.TagNo; break;
                    case "DefectRemark": newRow.DefectRemark = source.DefectRemark; break;
                    case "Remark": newRow.Remark = source.Remark; break;
                    case "WorkOrderNo": newRow.WorkOrderNo = source.WorkOrderNo; break;
                    case "SalesOrderNo": newRow.SalesOrderNo = source.SalesOrderNo; break;
                    case "OrderItemIds": newRow.OrderItemIds = source.OrderItemIds; break;
                    case "SourceOrderNo": newRow.SourceOrderNo = source.SourceOrderNo; break;
                    case "SourceOrderSequence": newRow.SourceOrderSequence = source.SourceOrderSequence; break;
                    case "IsLinkedToWorkOrder": newRow.IsLinkedToWorkOrder = source.IsLinkedToWorkOrder; break;
                }
            }
        }
        _rows.Add(newRow);
    }

    private void RemoveRow(InboundRowModel row)
    {
        if (_rows.Count <= 1) return;
        _rows.Remove(row);
    }

    private async Task ResetAll()
    {
        _allColumns = GetAllColumnDefs();
        ApplyWarehouseDefaults(_allColumns, _warehouseCode);
        foreach (var c in _allColumns)
        {
            if (c.IsApplicable) c.Visible = true;
        }
        await SaveColumnPrefs();
        _rows.Clear();
        _rows.Add(new InboundRowModel());
        _errorMessage = string.Empty;
    }

    // ========== 表格单元格渲染 ==========

    private RenderFragment RenderCell(InboundRowModel row, ColumnDef col) => builder =>
    {
        switch (col.Key)
        {
            case "MaterialType":
                if (!string.IsNullOrEmpty(row.MaterialType))
                    builder.AddContent(0, row.MaterialType);
                break;
            case "InboundSource":
                if (!string.IsNullOrEmpty(row.InboundSource))
                    builder.AddContent(0, DisplayHelper.GetInboundSourceText(row.InboundSource));
                break;
            case "SourceName":
                if (!string.IsNullOrEmpty(row.SourceName))
                    builder.AddContent(0, row.SourceName);
                break;
            case "InboundDateStr":
                if (!string.IsNullOrEmpty(row.InboundDateStr))
                    builder.AddContent(0, row.InboundDateStr);
                break;
            case "HeatNo":
                if (!string.IsNullOrEmpty(row.HeatNo))
                    builder.AddContent(0, row.HeatNo);
                break;
            case "PlantGrade":
                if (!string.IsNullOrEmpty(row.PlantGrade))
                    builder.AddContent(0, row.PlantGrade);
                break;
            case "Specification":
                if (!string.IsNullOrEmpty(row.Specification))
                    builder.AddContent(0, row.Specification);
                break;
            case "LengthStatus":
                if (!string.IsNullOrEmpty(row.LengthStatus))
                    builder.AddContent(0, DisplayHelper.GetLengthStatusText(row.LengthStatus));
                break;
            case "InitialQuantity":
                builder.AddContent(0, row.InitialQuantity);
                break;
            case "InitialWeight":
                builder.AddContent(0, row.InitialWeight.ToString("G29"));
                break;
            case "UnitWeight":
                if (row.UnitWeight.HasValue)
                    builder.AddContent(0, row.UnitWeight.Value.ToString("G29"));
                break;
            case "SurfaceCondition":
                if (!string.IsNullOrEmpty(row.SurfaceCondition))
                    builder.AddContent(0, row.SurfaceCondition);
                break;
            case "LocationArea":
                if (!string.IsNullOrEmpty(row.LocationArea))
                    builder.AddContent(0, row.LocationArea);
                break;
            case "LocationRack":
                if (!string.IsNullOrEmpty(row.LocationRack))
                    builder.AddContent(0, row.LocationRack);
                break;
            case "Remark":
