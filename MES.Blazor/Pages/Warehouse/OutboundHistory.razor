@page "/warehouse/outbound-history"
@page "/warehouse/outbound-history/{Code}"
@using System.Text.Json
@using MES.Blazor.Services
@using MES.Blazor.Helpers
@using MES.Blazor.Components
@using MES.Blazor.Models
@using MES.Core.DTOs
@using MES.Core.Models
@using Microsoft.AspNetCore.Authorization
@using MES.Blazor.Shared
@inject InventoryService InventoryService
@inject PageStateService PageState
@inject WarehouseService WarehouseService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject ColumnPrefsService ColumnPrefs
@inject IJSRuntime JS
@attribute [Authorize]

<style>
    .outbound-edit-table td.mud-table-cell,
    .outbound-edit-table th.mud-table-cell {
        padding: 1px 4px !important;
    }
    .outbound-edit-table .mud-input-input-control {
        margin-top: 0;
    }
    .outbound-edit-table .mud-input {
        font-size: 13px;
        width: 100%;
        min-width: 0;
    }
    .outbound-edit-table th.mud-table-cell {
        white-space: nowrap;
    }
</style>
<MudContainer MaxWidth="MaxWidth.False" Class="mt-4 pl-0">
    <MudCard>
        <MudCardHeader>
            <CardHeaderContent>
                <MudText Typo="Typo.h5" Class="font-weight-bold">
                    <MudIcon Icon="@Icons.Material.Filled.History" Class="mr-2" Color="Color.Warning" />
                    出库历史记录查询及更正
                    @if (!string.IsNullOrEmpty(_warehouseName))
                    {
                        <span Class="font-weight-light" Style="font-size:0.8em;"> — @_warehouseName</span>
                    }
                </MudText>
            </CardHeaderContent>
            <CardHeaderActions>
                <MudButton Variant="Variant.Text" Color="Color.Default" OnClick="GoBack">返回</MudButton>
            </CardHeaderActions>
        </MudCardHeader>

        <MudCardContent>
            <!-- 筛选栏 -->
            <MudGrid Class="mb-2">
                <MudItem xs="12" md="6">
                    <MudTextField T="string"
                                  Value="_searchKeyword"
                                  ValueChanged="@OnSearchChanged"
                                  Label="模糊搜索"
                                  Variant="Variant.Outlined"
                                  Dense="true"
                                  Immediate="true"
                                  DebounceInterval="500"
                                  Clearable="true"
                                  ClearButton="true"
                                  Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Filled.Search" />
                </MudItem>
            </MudGrid>

            <!-- 表格 -->
            <div id="outbound-history-list-table">
            <MudTable @ref="_table" T="OutboundRecordDto" ServerData="@LoadDataFromServer"
                      Dense="true" Hover="true"
                      Elevation="0" Striped="true" RowsPerPage="@_pageSize" RowsPerPageLabel="每页行数:"
                      Class="auto-table outbound-edit-table">
                <ToolBarContent>
                    <ColumnDisplaySelect Columns="_allColumns"
                                         OnColumnToggle="OnColumnToggle"
                                         OnMoveUp="MoveColumnUp"
                                         OnMoveDown="MoveColumnDown" />
                    <MudButton Variant="Variant.Text" Size="Size.Small"
                               Color="Color.Default"
                               StartIcon="@Icons.Material.Filled.RestartAlt"
                               OnClick="ResetColumnDisplay" Class="ml-2">
                        重置
                    </MudButton>
                    <MudSpacer />
                    <MudButton Variant="Variant.Outlined" Size="Size.Small"
                               Color="Color.Info"
                               StartIcon="@Icons.Material.Filled.Print"
                               Disabled="@(!_selectedItems.Any())"
                               OnClick="PrintSelected" Class="mr-1">
                        打印选中 (@_selectedItems.Count)
                    </MudButton>
                    <MudButton Variant="Variant.Text" Size="Size.Small"
                               Color="Color.Info"
                               StartIcon="@Icons.Material.Filled.Print"
                               OnClick="PrintAll" Class="mr-4">
                        打印全部
                    </MudButton>
                    <MudText Typo="Typo.body2" Class="ml-auto">
                        共 @_totalCount 条记录
                    </MudText>
                </ToolBarContent>
                <HeaderContent>
                    <MudTh Style="width: 40px;">
                        <MudCheckBox T="bool" @bind-Value="allSelected" Dense="true" />
                    </MudTh>
                    @foreach (var col in _visibleColumns)
                    {
                        <MudTh>
                            <div style="display:inline-flex; align-items:center; gap:4px;">
                                <span @onclick='() => ToggleSort(col.Key)' style="cursor:pointer" class="th-label">
                                    @col.Label
                                    @if (col.IsRequired)
                                    {
                                        <span class="required-star">*</span>
                                    }
                                    @if (sortColumn == col.Key) {@(sortDescending ? " ▼" : " ▲")}
                                </span>
                                @if (col.FilterType != null)
                                {
                                    <ExcelFilter T="OutboundRecordDto"
                                                 Label="@col.Label"
                                                 FieldKey="@col.Key"
                                                 FilterOptions="@(_filterContextOptions.GetValueOrDefault(col.Key))"
                                                 ActiveFilterValues="@(_columnFilters.GetValueOrDefault(col.Key))"
                                                 FilterChanged="@(args => OnColumnFilterChanged(args.fieldKey, args.selectedValues))" />

                                }
                            </div>
                        </MudTh>
                    }
                    <MudTh Style="width:150px;">操作</MudTh>
                </HeaderContent>
                <RowTemplate Context="item">
                    @if (_editingRowId == item.Id)
                    {
                        <MudTd Style="width: 40px;"></MudTd>
                        @foreach (var col in _visibleColumns)
                        {
                            <MudTd>@RenderInlineEditor(item, col)</MudTd>
                        }
                        <MudTd>
                            <MudButton Variant="Variant.Filled" Size="Size.Small"
                                       Color="Color.Primary"
                                       OnClick="() => SaveRow(item)"
                                       Disabled="@_savingItemId.HasValue"
                                       Class="mr-1">
                                确认更改
                            </MudButton>
                            <MudButton Variant="Variant.Text" Size="Size.Small"
                                       Color="Color.Default"
                                       OnClick="CancelEdit">
                                取消
                            </MudButton>
                        </MudTd>
                    }
                    else
                    {
                        <MudTd Style="width: 40px;">
                            <MudCheckBox T="bool"
                                         Value="@_selectedItems.Contains(item)"
                                         ValueChanged="@((v) => { if(v) _selectedItems.Add(item); else _selectedItems.Remove(item); _allSelected = _pageItems.Any() && _pageItems.All(i => _selectedItems.Contains(i)); StateHasChanged(); })"
                                         Dense="true" />
                        </MudTd>
                        @foreach (var col in _visibleColumns)
                        {
                            <MudTd>@RenderCell(item, col)</MudTd>
                        }
                        <MudTd>
                            <MudButton Variant="Variant.Outlined" Size="Size.Small"
                                       Color="Color.Primary"
                                       OnClick="() => StartEdit(item)"
                                       Class="mr-1">
                                更改
                            </MudButton>
                            <MudIconButton Icon="@Icons.Material.Filled.DeleteForever" Color="Color.Error"
                                           Size="Size.Small" Title="物理删除"
                                           OnClick="() => ConfirmDelete(item)" />
                        </MudTd>
                    }
                </RowTemplate>
                <FooterContent>
                    <MudTd Class="col-footer-cell"></MudTd>
                    @foreach (var col in _visibleColumns)
                    {
                        <MudTd Class="col-footer-cell"><span class="col-footer-sum">@RenderFooterCell(col)</span></MudTd>
                    }
                    <MudTd Class="col-footer-cell"></MudTd>
                </FooterContent>
                <PagerContent>
                    <MudText Typo="Typo.body2" Class="d-flex align-center mr-auto">共 @_totalCount 条记录</MudText>
                    <MudTablePager PageSizeOptions="new int[]{10,15,25,50,100}" />
                </PagerContent>
                <NoRecordsContent>
                    <MudText Class="d-flex justify-center pa-4" Color="Color.Secondary">暂无出库记录</MudText>
                </NoRecordsContent>
            </MudTable>
            </div>
        </MudCardContent>
    </MudCard>
</MudContainer>
