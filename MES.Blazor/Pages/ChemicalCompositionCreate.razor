@page "/quality/chemical-composition/create"
@using MES.Core.DTOs
@using MES.Blazor.Services
@using Microsoft.AspNetCore.Authorization
@using MES.Blazor.Shared
@inject ChemicalCompositionService ChemicalCompositionService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject IJSRuntime JS
@inject ColumnPrefsService ColumnPrefs
@attribute [Authorize(Roles = "QualityStaff,QualityDirector,Admin")]

<MudContainer MaxWidth="MaxWidth.False" Class="mt-4">
    <style>
        .edit-table td.mud-table-cell,
        .edit-table th.mud-table-cell {
            padding: 1px 4px !important;
        }
        .edit-table .mud-input-input-control {
            margin-top: 0;
        }
        .edit-table .mud-input {
            font-size: 13px;
            width: 100%;
            min-width: 0;
        }
        .edit-table th.mud-table-cell {
            white-space: nowrap;
        }
        .table-scroll {
            max-height: calc(100vh - 280px);
            overflow-y: auto;
            overflow-x: auto;
        }
    </style>

    <MudCard>
        <MudCardHeader>
            <CardHeaderContent>
                <MudText Typo="Typo.h5" Class="font-weight-bold">
                    <MudIcon Icon="@Icons.Material.Filled.AddCircleOutline" Class="mr-2" Color="Color.Primary" />
                    新建牌号化学成分
                </MudText>
            </CardHeaderContent>
            <CardHeaderActions>
                <MudButton Variant="Variant.Text" Color="Color.Default" OnClick="GoBack">返回</MudButton>
            </CardHeaderActions>
        </MudCardHeader>

        <MudCardContent>
            <div id="chemical-composition-create-table">
                @if (_rows.Any())
                {
                    <div class="d-flex align-center mb-2">
                        <ColumnDisplaySelect Columns="_allColumns"
                                             OnColumnToggle="OnColumnToggle"
                                             OnMoveUp="MoveColumnUp"
                                             OnMoveDown="MoveColumnDown" />
                        <MudButton Variant="Variant.Text" Size="Size.Small"
                                   Color="Color.Default"
                                   StartIcon="@Icons.Material.Filled.RestartAlt"
                                   OnClick="ResetColumnDisplay" Class="ml-2">
                            重置
                        </MudButton>
                        <MudSpacer />
                        <MudText Typo="Typo.body2">共 @_rows.Count 行</MudText>
                        <MudButton Variant="Variant.Text" Size="Size.Small"
                                   Color="Color.Default"
                                   StartIcon="@Icons.Material.Filled.AddCircleOutline"
                                   OnClick="AddRow" Class="ml-2">
                            添加行
                        </MudButton>
                    </div>
                    <div class="table-scroll">
                        <MudTable Items="@_rows" Dense="true" Hover="true" Elevation="0" Striped="true"
                                  Class="edit-table auto-table" SortMode="SortMode.None" FixedHeader="true">
                            <HeaderContent>
                                @foreach (var col in _visibleColumns)
                                {
                                    <MudTh>
                                        @col.Label
                                        @if (col.IsRequired)
                                        {
                                            <span class="required-star">*</span>
                                        }
                                    </MudTh>
                                }
                                <MudTh Style="width:60px;">操作</MudTh>
                            </HeaderContent>
                            <RowTemplate Context="r">
                                @foreach (var col in _visibleColumns)
                                {
                                    <MudTd>@RenderCell(r, col)</MudTd>
                                }
                                <MudTd>
                                    <MudIconButton Icon="@Icons.Material.Filled.RemoveCircleOutline"
                                                   Color="Color.Error" Size="Size.Small"
                                                   Title="删除"
                                                   OnClick="() => RemoveRow(r)"
                                                   Disabled="@(_rows.Count <= 1)" />
                                </MudTd>
                            </RowTemplate>
                            <FooterContent>
                                <MudTd colspan="@(_visibleColumns.Count + 1)">
                                    <MudIconButton Icon="@Icons.Material.Filled.AddCircleOutline"
                                                   Color="Color.Primary" Size="Size.Small"
                                                   OnClick="AddRow" />
                                </MudTd>
                            </FooterContent>
                        </MudTable>
                    </div>
                }
            </div>

            @if (!string.IsNullOrEmpty(_errorMessage))
            {
                <MudText Typo="Typo.body2" Color="Color.Error" Class="mt-4">@_errorMessage</MudText>
            }

            @if (_rows.Any())
            {
                <MudGrid Class="mt-4">
                    <MudItem xs="12" Class="d-flex justify-end">
                        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.CloudUpload"
                                   OnClick="Submit" Loading="@_isSubmitting"
                                   Size="Size.Large">
                            确认提交 (@_rows.Count 条)
                        </MudButton>
                    </MudItem>
                </MudGrid>
            }
        </MudCardContent>
    </MudCard>
</MudContainer>

@code {
    private List<EditRow> _rows = new();
    private bool _isSubmitting;
    private bool _isArrowNavSetup;
    private string _errorMessage = string.Empty;

    // ========== 列定义 ==========

    private List<ColumnDef> _allColumns = new();
    private List<ColumnDef> _visibleColumns =>
        _allColumns.Where(c => c.IsApplicable && c.Visible).ToList();

    private static List<ColumnDef> GetAllColumnDefs() => new()
    {
        new() { Key = "PlantGrade",   Label = "工厂牌号", IsRequired = true },
        new() { Key = "Carbon",       Label = "C" },
        new() { Key = "Silicon",      Label = "Si" },
        new() { Key = "Manganese",    Label = "Mn" },
        new() { Key = "Phosphorus",   Label = "P" },
        new() { Key = "Sulfur",       Label = "S" },
        new() { Key = "Nickel",       Label = "Ni" },
        new() { Key = "Chromium",     Label = "Cr" },
        new() { Key = "Molybdenum",   Label = "Mo" },
        new() { Key = "Copper",       Label = "Cu" },
        new() { Key = "Nitrogen",     Label = "N" },
        new() { Key = "Niobium",      Label = "Nb" },
        new() { Key = "Titanium",     Label = "Ti" },
        new() { Key = "Iron",         Label = "Fe" },
        new() { Key = "Aluminum",     Label = "Al" },
        new() { Key = "Tungsten",     Label = "W" },
        new() { Key = "PREN",         Label = "PREN腐蚀当量" },
    };

    private async Task OnColumnToggle(ColumnDef col)
    {
        await SaveColumnPrefs();
    }

    private async Task SaveColumnPrefs()
    {
        await ColumnPrefs.SaveAsync("chemical-composition-create", null, _allColumns);
    }

    private async Task ResetColumnDisplay()
    {
        _allColumns = GetAllColumnDefs();
        await SaveColumnPrefs();
    }

    private async Task MoveColumnUp(ColumnDef col)
    {
        await SaveColumnPrefs();
    }

    private async Task MoveColumnDown(ColumnDef col)
    {
        await SaveColumnPrefs();
    }

    private class EditRow
    {
        public string PlantGrade { get; set; } = string.Empty;
        public string? Carbon { get; set; }
        public string? Silicon { get; set; }
        public string? Manganese { get; set; }
        public string? Phosphorus { get; set; }
        public string? Sulfur { get; set; }
        public string? Nickel { get; set; }
        public string? Chromium { get; set; }
        public string? Molybdenum { get; set; }
        public string? Copper { get; set; }
        public string? Nitrogen { get; set; }
        public string? Niobium { get; set; }
        public string? Titanium { get; set; }
        public string? Iron { get; set; }
        public string? Aluminum { get; set; }
        public string? Tungsten { get; set; }
        public string? PREN { get; set; }
    }

    protected override async Task OnInitializedAsync()
    {
        _allColumns = GetAllColumnDefs();
        var saved = await ColumnPrefs.LoadAsync("chemical-composition-create", null);
        if (saved.Count > 0)
        {
            foreach (var s in saved)
            {
                var match = _allColumns.FirstOrDefault(c => c.Key == s.Key);
                if (match != null)
                    match.Visible = s.Visible;
            }
            var reordered = new List<ColumnDef>();
            foreach (var s in saved)
            {
                var match = _allColumns.FirstOrDefault(c => c.Key == s.Key);
                if (match != null && !reordered.Contains(match))
                    reordered.Add(match);
            }
            foreach (var c in _allColumns)
            {
                if (!reordered.Contains(c))
                    reordered.Add(c);
            }
            _allColumns = reordered;
        }

        if (!_rows.Any())
        {
            _rows.Add(new EditRow());
            _rows.Add(new EditRow());
            _rows.Add(new EditRow());
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_isArrowNavSetup)
        {
            _isArrowNavSetup = true;
            if (!await JS.InvokeAsync<bool>("enableTableArrowNav", "#chemical-composition-create-table"))
                _isArrowNavSetup = false;
        }
    }

    private void AddRow()
    {
        _rows.Add(new EditRow());
    }

    private void RemoveRow(EditRow row)
    {
        if (_rows.Count <= 1) return;
        _rows.Remove(row);
    }

    private async Task Submit()
    {
        _errorMessage = string.Empty;

        var errors = new List<string>();
        for (int i = 0; i < _rows.Count; i++)
        {
            var r = _rows[i];
            if (string.IsNullOrWhiteSpace(r.PlantGrade))
                errors.Add($"第{i + 1}行：工厂牌号不能为空");
        }

        if (errors.Any())
        {
            Snackbar.Add(string.Join("；", errors), Severity.Error);
            return;
        }

        _isSubmitting = true;
        StateHasChanged();

        try
        {
            var requests = _rows.Select(r => new CreateChemicalCompositionRequest
            {
                PlantGrade = r.PlantGrade,
                Carbon = r.Carbon,
                Silicon = r.Silicon,
                Manganese = r.Manganese,
                Phosphorus = r.Phosphorus,
                Sulfur = r.Sulfur,
                Nickel = r.Nickel,
                Chromium = r.Chromium,
                Molybdenum = r.Molybdenum,
                Copper = r.Copper,
                Nitrogen = r.Nitrogen,
                Niobium = r.Niobium,
                Titanium = r.Titanium,
                Iron = r.Iron,
                Aluminum = r.Aluminum,
                Tungsten = r.Tungsten,
                PREN = r.PREN,
            }).ToList();

            var result = await ChemicalCompositionService.BatchCreateAsync(requests);

            if (result.Success && result.Data != null)
            {
                Snackbar.Add($"批量创建牌号化学成分成功，共{result.Data.Count}条", Severity.Success);
                Navigation.NavigateTo("/quality/chemical-composition");
            }
            else
            {
                _errorMessage = result.Message ?? "批量创建失败";
            }
        }
        catch (Exception ex)
        {
            _errorMessage = $"网络错误: {ex.Message}";
        }
        finally
        {
            _isSubmitting = false;
            StateHasChanged();
        }
    }

    private void GoBack()
    {
        Navigation.NavigateTo("/quality/chemical-composition");
    }

    // ========== 单元格渲染 ==========

    private RenderFragment RenderCell(EditRow r, ColumnDef col) => builder =>
    {
        switch (col.Key)
        {
            case "PlantGrade":
                builder.OpenComponent<MudTextField<string>>(0);
                builder.AddAttribute(1, "Dense", true);
                builder.AddAttribute(2, "Variant", Variant.Outlined);
                builder.AddAttribute(3, "Size", Size.Small);
                builder.AddAttribute(4, "Value", r.PlantGrade);
                builder.AddAttribute(5, "ValueChanged", EventCallback.Factory.Create<string>(this, v => r.PlantGrade = v ?? ""));
                builder.AddAttribute(6, "Placeholder", "输入牌号");
                builder.CloseComponent();
                break;
            case "Carbon":
                RenderInputField(builder, r.Carbon, v => r.Carbon = v);
                break;
            case "Silicon":
                RenderInputField(builder, r.Silicon, v => r.Silicon = v);
                break;
            case "Manganese":
                RenderInputField(builder, r.Manganese, v => r.Manganese = v);
                break;
            case "Phosphorus":
                RenderInputField(builder, r.Phosphorus, v => r.Phosphorus = v);
                break;
            case "Sulfur":
                RenderInputField(builder, r.Sulfur, v => r.Sulfur = v);
                break;
            case "Nickel":
                RenderInputField(builder, r.Nickel, v => r.Nickel = v);
                break;
            case "Chromium":
                RenderInputField(builder, r.Chromium, v => r.Chromium = v);
                break;
            case "Molybdenum":
                RenderInputField(builder, r.Molybdenum, v => r.Molybdenum = v);
                break;
            case "Copper":
                RenderInputField(builder, r.Copper, v => r.Copper = v);
                break;
            case "Nitrogen":
                RenderInputField(builder, r.Nitrogen, v => r.Nitrogen = v);
                break;
            case "Niobium":
                RenderInputField(builder, r.Niobium, v => r.Niobium = v);
                break;
            case "Titanium":
                RenderInputField(builder, r.Titanium, v => r.Titanium = v);
                break;
            case "Iron":
                RenderInputField(builder, r.Iron, v => r.Iron = v);
                break;
            case "Aluminum":
                RenderInputField(builder, r.Aluminum, v => r.Aluminum = v);
                break;
            case "Tungsten":
                RenderInputField(builder, r.Tungsten, v => r.Tungsten = v);
                break;
            case "PREN":
                RenderInputField(builder, r.PREN, v => r.PREN = v);
                break;
            default:
                builder.AddContent(0, "");
                break;
        }
    };

    private void RenderInputField(Microsoft.AspNetCore.Components.Rendering.RenderTreeBuilder builder, string? value, Action<string?> setter)
    {
        builder.OpenComponent<MudTextField<string>>(0);
        builder.AddAttribute(1, "Dense", true);
        builder.AddAttribute(2, "Variant", Variant.Outlined);
        builder.AddAttribute(3, "Size", Size.Small);
        builder.AddAttribute(4, "Value", value);
        builder.AddAttribute(5, "ValueChanged", EventCallback.Factory.Create<string?>(this, setter));
        builder.CloseComponent();
    }
}
