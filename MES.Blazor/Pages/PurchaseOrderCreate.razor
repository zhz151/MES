@page "/purchase-orders/create"
@using MES.Blazor.Services
@using MES.Core.DTOs
@using Microsoft.AspNetCore.Authorization
@inject PurchaseOrderService PurchaseService
@inject SupplierService SupplierService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@attribute [Authorize(Roles = "MaterialStaff,MaterialDirector,Admin")]

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-4">
    <MudCard>
        <MudCardHeader>
            <CardHeaderContent>
                <MudText Typo="Typo.h5" Class="font-weight-bold"><MudIcon Icon="@Icons.Material.Filled.ShoppingCart" Class="mr-2" Color="Color.Primary" />新建采购订单</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">创建新的采购订单，关联供应商和物料信息</MudText>
            </CardHeaderContent>
            <CardHeaderActions>
                <MudButton Variant="Variant.Text" OnClick="GoBack">返回</MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Save" Disabled="@isSubmitting">
                    @if (isSubmitting) { <MudProgressCircular Size="Size.Small" Color="Color.Inherit" /> } else { <span>保存</span> }
                </MudButton>
            </CardHeaderActions>
        </MudCardHeader>
        <MudCardContent>
            <MudGrid>
                <MudItem xs="12">
                    <div class="form-inline-row">
                        <div class="form-inline-field">
                            <MudText class="form-label">供应商 *</MudText>
                            <div class="form-input">
                                <MudSelect T="int" @bind-Value="request.SupplierId" Required="true" Variant="Variant.Outlined">
                                    @foreach (var s in suppliers)
                                    {
                                        <MudSelectItem Value="s.Id">@s.SupplierName</MudSelectItem>
                                    }
                                </MudSelect>
                            </div>
                        </div>
                        <div class="form-inline-field">
                            <MudText class="form-label">下单日期 *</MudText>
                            <div class="form-input">
                                <MudTextField T="string" @bind-Value="orderDateText" Required="true" Placeholder="yyyy-MM-dd" Variant="Variant.Outlined" />
                            </div>
                        </div>
                        <div class="form-inline-field">
                            <MudText class="form-label">要求到货日期 *</MudText>
                            <div class="form-input">
                                <MudTextField T="string" @bind-Value="requiredDateText" Required="true" Placeholder="yyyy-MM-dd" Variant="Variant.Outlined" />
                            </div>
                        </div>
                    </div>
                </MudItem>
                <MudItem xs="12" md="4">
                    <div class="form-horizontal-field">
                        <MudText class="form-label">物料分类 *</MudText>
                        <div class="form-input">
                            <MudTextField T="string" @bind-Value="request.MaterialCategory" Required="true" Variant="Variant.Outlined" />
                        </div>
                    </div>
                </MudItem>
                <MudItem xs="12" md="4">
                    <div class="form-horizontal-field">
                        <MudText class="form-label">厂内钢种 *</MudText>
                        <div class="form-input">
                            <MudTextField T="string" @bind-Value="request.PlantGrade" Required="true" Variant="Variant.Outlined" />
                        </div>
                    </div>
                </MudItem>
                <MudItem xs="12" md="4">
                    <div class="form-horizontal-field">
                        <MudText class="form-label">规格 *</MudText>
                        <div class="form-input">
                            <MudTextField T="string" @bind-Value="request.Specification" Required="true" Variant="Variant.Outlined" />
                        </div>
                    </div>
                </MudItem>
                <MudItem xs="12" md="3">
                    <div class="form-horizontal-field">
                        <MudText class="form-label">单支重量(kg)</MudText>
                        <div class="form-input">
                            <MudTextField T="decimal?" @bind-Value="request.UnitWeight" Variant="Variant.Outlined" />
                        </div>
                    </div>
                </MudItem>
                <MudItem xs="12" md="3">
                    <div class="form-horizontal-field">
                        <MudText class="form-label">采购支数</MudText>
                        <div class="form-input">
                            <MudTextField T="int?" @bind-Value="request.Quantity" Variant="Variant.Outlined" />
                        </div>
                    </div>
                </MudItem>
                <MudItem xs="12" md="3">
                    <div class="form-horizontal-field">
                        <MudText class="form-label">采购重量(kg) *</MudText>
                        <div class="form-input">
                            <MudTextField T="decimal" @bind-Value="request.Weight" Required="true" Variant="Variant.Outlined" />
                        </div>
                    </div>
                </MudItem>
                <MudItem xs="12" md="3">
                    <div class="form-horizontal-field">
                        <MudText class="form-label">单价</MudText>
                        <div class="form-input">
                            <MudTextField T="decimal?" @bind-Value="request.UnitPrice" Variant="Variant.Outlined" />
                        </div>
                    </div>
                </MudItem>
                <MudItem xs="12" md="6">
                    <div class="form-horizontal-field">
                        <MudText class="form-label">来源工单号</MudText>
                        <div class="form-input">
                            <MudTextField T="string" @bind-Value="request.SourceWorkOrderNo" HelperText="可选，追溯用料计划" Variant="Variant.Outlined" />
                        </div>
                    </div>
                </MudItem>
                <MudItem xs="12" md="12">
                    <div class="form-horizontal-field form-field-multiline">
                        <MudText class="form-label">备注</MudText>
                        <div class="form-input">
                            <MudTextField T="string" @bind-Value="request.Remark" Multiline="true" Lines="3" Variant="Variant.Outlined" />
                        </div>
                    </div>
                </MudItem>
            </MudGrid>
        </MudCardContent>
    </MudCard>
</MudContainer>

@code {
    private CreatePurchaseOrderRequest request = new() { OrderDate = DateTime.Today, RequiredDate = DateTime.Today.AddDays(30) };
    private string orderDateText = DateTime.Today.ToString("yyyy-MM-dd");
    private string requiredDateText = DateTime.Today.AddDays(30).ToString("yyyy-MM-dd");
    private List<SupplierProfileDto> suppliers = new();
    private bool isSubmitting;

    protected override async Task OnInitializedAsync()
    {
        suppliers = await SupplierService.GetActiveAsync();
    }

    private async Task Save()
    {
        if (request.SupplierId <= 0) { Snackbar.Add("请选择供应商", Severity.Warning); return; }
        if (!DateTime.TryParse(orderDateText, out var orderDate)) { Snackbar.Add("下单日期格式错误，请使用 yyyy-MM-dd", Severity.Warning); return; }
        if (!DateTime.TryParse(requiredDateText, out var requiredDate)) { Snackbar.Add("要求到货日期格式错误，请使用 yyyy-MM-dd", Severity.Warning); return; }
        request.OrderDate = orderDate;
        request.RequiredDate = requiredDate;
        if (string.IsNullOrWhiteSpace(request.MaterialCategory)) { Snackbar.Add("物料分类不能为空", Severity.Warning); return; }
        if (string.IsNullOrWhiteSpace(request.PlantGrade)) { Snackbar.Add("厂内钢种不能为空", Severity.Warning); return; }
        if (string.IsNullOrWhiteSpace(request.Specification)) { Snackbar.Add("规格不能为空", Severity.Warning); return; }
        if (request.Weight <= 0) { Snackbar.Add("采购重量必须大于0", Severity.Warning); return; }

        isSubmitting = true; StateHasChanged();
        try
        {
            var result = await PurchaseService.CreateAsync(request);
            if (result.Success) { Snackbar.Add("创建成功", Severity.Success); Navigation.NavigateTo("/purchase-orders"); }
            else { Snackbar.Add(result.Message ?? "创建失败", Severity.Error); }
        }
        catch (Exception ex) { Snackbar.Add($"创建失败: {ex.Message}", Severity.Error); }
        finally { isSubmitting = false; StateHasChanged(); }
    }

    private void GoBack() => Navigation.NavigateTo("/purchase-orders");
}
