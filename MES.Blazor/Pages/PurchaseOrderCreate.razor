@page "/purchase-orders/create"
@using MES.Blazor.Services
@using MES.Core.DTOs
@using Microsoft.AspNetCore.Authorization
@inject PurchaseOrderService PurchaseService
@inject SupplierService SupplierService
@inject WorkOrderService WorkOrderService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@attribute [Authorize(Roles = "MaterialStaff,MaterialDirector,Admin")]

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-4">
    <MudCard>
        <MudCardHeader>
            <CardHeaderContent>
                <MudText Typo="Typo.h5" Class="font-weight-bold"><MudIcon Icon="@Icons.Material.Filled.ShoppingCart" Class="mr-2" Color="Color.Primary" />新建采购订单</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">创建新的采购订单，可批量添加多条记录</MudText>
            </CardHeaderContent>
            <CardHeaderActions>
                <MudButton Variant="Variant.Text" OnClick="GoBack">返回</MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAll" Disabled="@isSubmitting">
                    @if (isSubmitting) { <MudProgressCircular Size="Size.Small" Color="Color.Inherit" /> } else { <span>保存</span> }
                </MudButton>
            </CardHeaderActions>
        </MudCardHeader>

        <MudCardContent>
            <div class="d-flex justify-space-between align-center mb-3">
                <MudText Typo="Typo.subtitle1">采购订单列表</MudText>
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="AddRow">添加订单</MudButton>
            </div>

            @if (rows.Count == 0)
            {
                <MudAlert Severity="Severity.Info">请点击"添加订单"按钮添加记录</MudAlert>
            }
            else
            {
                <MudAlert Severity="Severity.Warning" Class="mb-3">点击右上角"保存"按钮一次性提交所有记录。</MudAlert>

                <div style="overflow-x: auto;">
                    <MudTable T="PurchaseOrderRow" Items="@rows" Dense="true" Hover="true" Elevation="0">
                        <HeaderContent>
                            <MudTh Style="width: 50px;">行号</MudTh>
                            <MudTh Style="width: 140px;">供应商</MudTh>
                            <MudTh Style="width: 120px;">下单日期</MudTh>
                            <MudTh Style="width: 120px;">要求到货日期</MudTh>
                            <MudTh Style="width: 110px;">物料分类</MudTh>
                            <MudTh Style="width: 110px;">厂内钢种</MudTh>
                            <MudTh Style="width: 130px;">规格</MudTh>
                            <MudTh Style="width: 100px;">单支重量(kg)</MudTh>
                            <MudTh Style="width: 90px;">采购支数</MudTh>
                            <MudTh Style="width: 100px;">采购重量(kg)</MudTh>
                            <MudTh Style="width: 90px;">单价</MudTh>
                            <MudTh Style="min-width: 200px;">来源工单号</MudTh>
                            <MudTh Style="min-width: 150px;">备注</MudTh>
                            <MudTh Style="width: 60px;">操作</MudTh>
                        </HeaderContent>
                        <RowTemplate Context="row">
                            <MudTd>
                                <MudText Typo="Typo.body2">@row.Sequence</MudText>
                            </MudTd>
                            <MudTd>
                                <MudSelect T="int" @bind-Value="row.SupplierId"
                                           Dense="true" Variant="Variant.Outlined" Size="Size.Small" Immediate="true">
                                    @foreach (var s in suppliers)
                                    {
                                        <MudSelectItem Value="s.Id">@s.SupplierName</MudSelectItem>
                                    }
                                </MudSelect>
                            </MudTd>
                            <MudTd>
                                <MudTextField T="string"
                                              @bind-Value="row.OrderDateStr"
                                              Dense="true"
                                              Variant="Variant.Outlined"
                                              Size="Size.Small"
                                              Placeholder="yyyy-MM-dd"
                                              Immediate="true" />
                            </MudTd>
                            <MudTd>
                                <MudTextField T="string"
                                              @bind-Value="row.RequiredDateStr"
                                              Dense="true"
                                              Variant="Variant.Outlined"
                                              Size="Size.Small"
                                              Placeholder="yyyy-MM-dd"
                                              Immediate="true" />
                            </MudTd>
                            <MudTd>
                                <MudTextField T="string"
                                              @bind-Value="row.MaterialCategory"
                                              Dense="true"
                                              Variant="Variant.Outlined"
                                              Size="Size.Small"
                                              Immediate="true" />
                            </MudTd>
                            <MudTd>
                                <MudTextField T="string"
                                              @bind-Value="row.PlantGrade"
                                              Dense="true"
                                              Variant="Variant.Outlined"
                                              Size="Size.Small"
                                              Immediate="true" />
                            </MudTd>
                            <MudTd>
                                <MudTextField T="string"
                                              @bind-Value="row.Specification"
                                              Dense="true"
                                              Variant="Variant.Outlined"
                                              Size="Size.Small"
                                              Immediate="true" />
                            </MudTd>
                            <MudTd>
                                <MudTextField T="string"
                                              @bind-Value="row.UnitWeightStr"
                                              Dense="true"
                                              Variant="Variant.Outlined"
                                              Size="Size.Small"
                                              Style="width: 80px;"
                                              Immediate="true" />
                            </MudTd>
                            <MudTd>
                                <MudTextField T="string"
                                              @bind-Value="row.QuantityStr"
                                              Dense="true"
                                              Variant="Variant.Outlined"
                                              Size="Size.Small"
                                              Style="width: 70px;"
                                              Immediate="true" />
                            </MudTd>
                            <MudTd>
                                <MudTextField T="string"
                                              @bind-Value="row.WeightStr"
                                              Dense="true"
                                              Variant="Variant.Outlined"
                                              Size="Size.Small"
                                              Style="width: 80px;"
                                              Immediate="true" />
                            </MudTd>
                            <MudTd>
                                <MudTextField T="string"
                                              @bind-Value="row.UnitPriceStr"
                                              Dense="true"
                                              Variant="Variant.Outlined"
                                              Size="Size.Small"
                                              Style="width: 70px;"
                                              Immediate="true" />
                            </MudTd>
                            <MudTd>
                                <div style="display: flex; align-items: center; gap: 4px;">
                                    <MudTextField T="string"
                                                  @bind-Value="row.SourceWorkOrderNo"
                                                  Dense="true"
                                                  Variant="Variant.Outlined"
                                                  Size="Size.Small"
                                                  Style="width: 110px;"
                                                  Immediate="true" />
                                    <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Info"
                                               OnClick="() => ToggleWorkOrderInfo(row)"
                                               Disabled="string.IsNullOrWhiteSpace(row.SourceWorkOrderNo) && !row.ShowWorkOrderInfo">
                                        @(row.ShowWorkOrderInfo ? "隐藏" : "展示")
                                    </MudButton>
                                </div>
                                @if (row.ShowWorkOrderInfo)
                                {
                                    <div style="margin-top: 4px; padding: 6px; border: 1px solid #e8e8e8; border-radius: 4px; background: #fafafa; font-size: 0.7rem; line-height: 1.4;">
                                        @if (row.WorkOrderLoading)
                                        {
                                            <MudProgressCircular Size="Size.Small" Indeterminate Class="my-1" />
                                        }
                                        else if (row.WorkOrderInfo != null)
                                        {
                                            <div><strong>工单号：</strong>@row.WorkOrderInfo.WorkOrderNo</div>
                                            <div><strong>订单号：</strong>@row.WorkOrderInfo.SalesOrderNo</div>
                                            <div><strong>主号/次号：</strong>@row.WorkOrderInfo.ProductionMainNo@(!string.IsNullOrEmpty(row.WorkOrderInfo.ProductionSubNo) ? "/" + row.WorkOrderInfo.ProductionSubNo : "")</div>
                                            <div><strong>物料名称：</strong>@row.WorkOrderInfo.MaterialName</div>
                                            <div><strong>规格：</strong>@row.WorkOrderInfo.Specification</div>
                                            <div><strong>数量/重量：</strong>@row.WorkOrderInfo.TotalQuantity 支 / @row.WorkOrderInfo.TotalWeight kg</div>
                                            <div><strong>状态：</strong>@row.WorkOrderInfo.StatusText</div>
                                        }
                                        else
                                        {
                                            <span style="color: #999;">无此工单</span>
                                        }
                                    </div>
                                }
                            </MudTd>
                            <MudTd>
                                <MudTextField T="string"
                                              @bind-Value="row.Remark"
                                              Dense="true"
                                              Variant="Variant.Outlined"
                                              Size="Size.Small"
                                              Immediate="true" />
                            </MudTd>
                            <MudTd>
                                @if (rows.Count > 1)
                                {
                                    <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                                   Color="Color.Error"
                                                   Size="Size.Small"
                                                   OnClick="() => RemoveRow(row)" />
                                }
                            </MudTd>
                        </RowTemplate>
                    </MudTable>
                </div>
            }
        </MudCardContent>
    </MudCard>
</MudContainer>

@code {
    private List<PurchaseOrderRow> rows = new();
    private bool isSubmitting;
    private List<SupplierProfileDto> suppliers = new();

    private class PurchaseOrderRow
    {
        public int Sequence { get; set; }
        public int SupplierId { get; set; }
        public string OrderDateStr { get; set; } = DateTime.Today.ToString("yyyy-MM-dd");
        public string RequiredDateStr { get; set; } = DateTime.Today.AddDays(30).ToString("yyyy-MM-dd");
        public string MaterialCategory { get; set; } = string.Empty;
        public string PlantGrade { get; set; } = string.Empty;
        public string Specification { get; set; } = string.Empty;
        public string UnitWeightStr { get; set; } = string.Empty;
        public string QuantityStr { get; set; } = string.Empty;
        public string WeightStr { get; set; } = string.Empty;
        public string UnitPriceStr { get; set; } = string.Empty;
        public string? SourceWorkOrderNo { get; set; }
        public string? Remark { get; set; }
        public bool ShowWorkOrderInfo { get; set; }
        public bool WorkOrderLoading { get; set; }
        public WorkOrderDetailDto? WorkOrderInfo { get; set; }

        public decimal? UnitWeight => ParseDecimal(UnitWeightStr);
        public int? Quantity => ParseInt(QuantityStr);
        public decimal Weight => decimal.TryParse(WeightStr, out var v) ? v : 0;
        public decimal? UnitPrice => ParseDecimal(UnitPriceStr);

        private static decimal? ParseDecimal(string v) => decimal.TryParse(v, out var r) ? r : null;
        private static int? ParseInt(string v) => int.TryParse(v, out var r) ? r : null;
    }

    protected override async Task OnInitializedAsync()
    {
        suppliers = await SupplierService.GetActiveAsync();
        AddRow();
    }

    private void AddRow()
    {
        rows.Add(new PurchaseOrderRow { Sequence = rows.Count + 1 });
    }

    private void RemoveRow(PurchaseOrderRow row)
    {
        if (rows.Count <= 1) { Snackbar.Add("至少保留一条记录", Severity.Warning); return; }
        rows.Remove(row);
        for (int i = 0; i < rows.Count; i++) rows[i].Sequence = i + 1;
    }

    private async Task ToggleWorkOrderInfo(PurchaseOrderRow row)
    {
        if (row.ShowWorkOrderInfo)
        {
            row.ShowWorkOrderInfo = false;
            return;
        }

        if (string.IsNullOrWhiteSpace(row.SourceWorkOrderNo))
        {
            Snackbar.Add("请先输入工单号", Severity.Warning);
            return;
        }

        row.ShowWorkOrderInfo = true;
        row.WorkOrderLoading = true;
        row.WorkOrderInfo = null;
        StateHasChanged();

        try
        {
            var result = await WorkOrderService.GetByWorkOrderNoAsync(row.SourceWorkOrderNo);
            if (result.Success && result.Data != null)
            {
                row.WorkOrderInfo = result.Data;
            }
        }
        catch
        {
            // 无此工单 - WorkOrderInfo stays null
        }
        finally
        {
            row.WorkOrderLoading = false;
            StateHasChanged();
        }
    }

    private async Task SaveAll()
    {
        var errors = new List<string>();
        for (int i = 0; i < rows.Count; i++)
        {
            var r = rows[i];
            var seq = i + 1;
            if (r.SupplierId <= 0) errors.Add($"行{seq}: 请选择供应商");
            if (!DateTime.TryParse(r.OrderDateStr, out _)) errors.Add($"行{seq}: 下单日期格式错误");
            if (!DateTime.TryParse(r.RequiredDateStr, out _)) errors.Add($"行{seq}: 要求到货日期格式错误");
            if (string.IsNullOrWhiteSpace(r.MaterialCategory)) errors.Add($"行{seq}: 物料分类不能为空");
            if (string.IsNullOrWhiteSpace(r.PlantGrade)) errors.Add($"行{seq}: 厂内钢种不能为空");
            if (string.IsNullOrWhiteSpace(r.Specification)) errors.Add($"行{seq}: 规格不能为空");
            if (r.Weight <= 0) errors.Add($"行{seq}: 采购重量必须大于0");
        }
        if (errors.Any()) { Snackbar.Add(string.Join("；", errors), Severity.Warning); return; }

        isSubmitting = true; StateHasChanged();
        var successCount = 0;
        var failCount = 0;
        var failMessages = new List<string>();

        for (int i = 0; i < rows.Count; i++)
        {
            var r = rows[i];
            var request = new CreatePurchaseOrderRequest
            {
                SupplierId = r.SupplierId,
                OrderDate = DateTime.Parse(r.OrderDateStr),
                RequiredDate = DateTime.Parse(r.RequiredDateStr),
                MaterialCategory = r.MaterialCategory,
                PlantGrade = r.PlantGrade,
                Specification = r.Specification,
                UnitWeight = r.UnitWeight,
                Quantity = r.Quantity,
                Weight = r.Weight,
                UnitPrice = r.UnitPrice,
                SourceWorkOrderNo = r.SourceWorkOrderNo,
                Remark = r.Remark
            };

            try
            {
                var result = await PurchaseService.CreateAsync(request);
                if (result.Success) successCount++;
                else { failCount++; failMessages.Add($"行{i + 1}: {result.Message}"); }
            }
            catch (Exception ex) { failCount++; failMessages.Add($"行{i + 1}: {ex.Message}"); }
        }

        isSubmitting = false; StateHasChanged();

        if (failCount == 0)
        {
            Snackbar.Add($"成功创建 {successCount} 条记录", Severity.Success);
            Navigation.NavigateTo("/purchase-orders");
        }
        else
        {
            Snackbar.Add($"成功 {successCount} 条，失败 {failCount} 条：{string.Join("；", failMessages)}", Severity.Error);
        }
    }

    private void GoBack() => Navigation.NavigateTo("/purchase-orders");
}
