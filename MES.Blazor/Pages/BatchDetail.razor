@page "/batches/{Id:int}"
@using MES.Blazor.Helpers
@using MES.Blazor.Services
@using MES.Blazor.Shared
@using MES.Core.DTOs
@using MES.Core.Enums
@using Microsoft.AspNetCore.Authorization
@inject BatchService BatchService
@inject ProductionRecordService ProdRecordService
@inject WorkOrderService WorkOrderService
@inject OrderService OrderService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject IJSRuntime JS
@inject IDialogService DialogService
@attribute [Authorize(Roles = "BatchStaff,BatchDirector,Admin")]

<MudContainer MaxWidth="MaxWidth.False" Class="mt-4">
    @if (isLoading)
    {
        <MudProgressCircular Indeterminate Size="Size.Large" Class="d-flex justify-center ma-8" />
    }
    else if (batch == null)
    {
        <MudText Typo="Typo.body2" Color="Color.Error">批次不存在</MudText>
    }
    else
    {
        <!-- ===== 页眉 ===== -->
        <MudPaper Class="detail-card pa-3 mb-2" Elevation="0">
            <div class="d-flex align-center justify-space-between flex-wrap" Style="gap:4px;">
                <div class="d-flex align-center flex-wrap" Style="gap:6px;">
                    <MudIcon Icon="@Icons.Material.Filled.PrecisionManufacturing" Color="Color.Primary" Size="Size.Small" />
                    <MudText Typo="Typo.subtitle1" Class="font-weight-bold mr-1">批次详情</MudText>
                    <MudChip Size="Size.Small" Color="@DisplayHelper.GetBatchStatusColor(batch.Status)">@DisplayHelper.GetBatchStatusText(batch.Status)</MudChip>
                    <MudText Typo="Typo.body2" Color="Color.Primary" Class="font-weight-bold ml-1">@batch.BatchNo</MudText>
                </div>
                <div class="d-flex align-center" Style="gap:2px;">
                    <MudIconButton Icon="@Icons.Material.Filled.ChevronLeft" Size="Size.Small"
                                   Disabled="@(!_hasPrev)" OnClick="NavigatePrev"
                                   Title="@(_hasPrev ? $"上一个 ({_prevBatchNo})" : "已是第一个")" />
                    <MudIconButton Icon="@Icons.Material.Filled.ChevronRight" Size="Size.Small"
                                   Disabled="@(!_hasNext)" OnClick="NavigateNext"
                                   Title="@(_hasNext ? $"下一个 ({_nextBatchNo})" : "已是最后一个")" />
                </div>
                <div class="d-flex align-center flex-wrap" Style="gap:4px;">
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary"
                               Size="Size.Small" StartIcon="@Icons.Material.Filled.Print"
                               OnClick="PrintAsync" Class="ml-1">打印</MudButton>
                    @if (CanEdit)
                    {
                        <MudButton Variant="Variant.Filled" Color="Color.Warning"
                                   Size="Size.Small" StartIcon="@Icons.Material.Filled.Edit"
                                   OnClick="EnterEditMode" Class="ml-1">编辑</MudButton>
                    }
                    @if (CanDelete)
                    {
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error"
                                       Size="Size.Small" OnClick="DeleteAsync" Title="删除" />
                    }
                    <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="GoBack" Class="ml-1">返回列表</MudButton>
                </div>
            </div>
        </MudPaper>

        <!-- ===== 区块一：批次基本信息 ===== -->
        <MudPaper Class="detail-card-bg pa-4 mb-3" Elevation="0">
            <MudText Typo="Typo.subtitle2" Class="detail-label font-weight-bold mb-3">
                <MudIcon Icon="@Icons.Material.Filled.Info" Class="mr-1" Size="Size.Small" />批次基本信息
            </MudText>
            <div class="d-flex flex-wrap" style="gap: 0.6rem 2rem;">
                <div><MudText Typo="Typo.caption" Class="detail-label font-weight-bold">生产编号</MudText><MudText Typo="Typo.body2">@batch.BatchNo</MudText></div>
                <div><MudText Typo="Typo.caption" Class="detail-label font-weight-bold">挂牌号</MudText><MudText Typo="Typo.body2">@(batch.TagNo ?? "-")</MudText></div>
                <div><MudText Typo="Typo.caption" Class="detail-label font-weight-bold">生产类型</MudText><MudText Typo="Typo.body2">@(DisplayHelper.GetProductionTypeText(batch.ProductionType))</MudText></div>
                <div><MudText Typo="Typo.caption" Class="detail-label font-weight-bold">制造物品</MudText><MudText Typo="Typo.body2">@(DisplayHelper.GetManufacturingItemText(batch.ManufacturingItem))</MudText></div>
                <div><MudText Typo="Typo.caption" Class="detail-label font-weight-bold">制几率</MudText><MudText Typo="Typo.body2">@(batch.ProductionRatio?.ToString() ?? "-")</MudText></div>
                <div><MudText Typo="Typo.caption" Class="detail-label font-weight-bold">备注</MudText><MudText Typo="Typo.body2">@(batch.Remark ?? "-")</MudText></div>
                <div><MudText Typo="Typo.caption" Class="detail-label font-weight-bold">状态</MudText><MudText Typo="Typo.body2">@DisplayHelper.GetBatchStatusText(batch.Status)</MudText></div>
                <div><MudText Typo="Typo.caption" Class="detail-label font-weight-bold">创建人</MudText><MudText Typo="Typo.body2">@batch.CreatedBy</MudText></div>
                <div><MudText Typo="Typo.caption" Class="detail-label font-weight-bold">创建时间</MudText><MudText Typo="Typo.body2">@batch.CreatedTime.LocalDateTime.ToString("yyyy-MM-dd HH:mm")</MudText></div>
                <div><MudText Typo="Typo.caption" Class="detail-label font-weight-bold">最后更新</MudText><MudText Typo="Typo.body2">@batch.UpdatedBy / @batch.UpdatedTime.LocalDateTime.ToString("yyyy-MM-dd HH:mm")</MudText></div>
            </div>
        </MudPaper>

        <!-- ===== 区块二：执行信息 ===== -->
        <MudPaper Class="detail-card-bg pa-4 mb-3" Elevation="0">
            <MudText Typo="Typo.subtitle2" Class="detail-label font-weight-bold mb-3">
                <MudIcon Icon="@Icons.Material.Filled.PlayCircle" Class="mr-1" Size="Size.Small" />执行信息
            </MudText>
            <div class="d-flex flex-wrap" style="gap: 0.6rem 2rem;">
                <div><MudText Typo="Typo.caption" Class="detail-label font-weight-bold">截止执行日</MudText><MudText Typo="Typo.body2">@(batch.CurrentExecDate?.ToString("yyyy-MM-dd") ?? "-")</MudText></div>
                <div><MudText Typo="Typo.caption" Class="detail-label font-weight-bold">当前工序</MudText><MudText Typo="Typo.body2">@(batch.CurrentGroupName ?? "-")</MudText></div>
                <div><MudText Typo="Typo.caption" Class="detail-label font-weight-bold">当前工段</MudText><MudText Typo="Typo.body2">@(batch.CurrentSectionName ?? "-")</MudText></div>
                <div><MudText Typo="Typo.caption" Class="detail-label font-weight-bold">当前设备</MudText><MudText Typo="Typo.body2">@(batch.CurrentEquipmentName ?? "-")</MudText></div>
                <div><MudText Typo="Typo.caption" Class="detail-label font-weight-bold">当前委外</MudText><MudText Typo="Typo.body2">@(batch.CurrentOutsource ?? "-")</MudText></div>
                <div><MudText Typo="Typo.caption" Class="detail-label font-weight-bold">当前规格</MudText><MudText Typo="Typo.body2">@(batch.CurrentSpec ?? "-")</MudText></div>
                <div><MudText Typo="Typo.caption" Class="detail-label font-weight-bold">下一工段</MudText><MudText Typo="Typo.body2">@(batch.NextSectionName ?? "-")</MudText></div>
                <div><MudText Typo="Typo.caption" Class="detail-label font-weight-bold">对应规格</MudText><MudText Typo="Typo.body2">@(batch.CorrespondingSpec ?? "-")</MudText></div>
                <div><MudText Typo="Typo.caption" Class="detail-label font-weight-bold">强制完成</MudText><MudText Typo="Typo.body2">@(batch.IsForceCompleted ? "是" : "否")</MudText></div>
                <div class="d-flex align-center" Style="gap:6px; width:100%; flex-wrap:wrap;">
                    <MudButton Variant="Variant.Outlined" Size="Size.Small" Color="Color.Info"
                               StartIcon="@Icons.Material.Filled.Refresh"
                               OnClick="RefreshTracking">刷新执行状态</MudButton>
                    @if (batch.Status == "None")
                    {
                        <MudButton Variant="Variant.Outlined" Size="Size.Small" Color="Color.Error"
                                   StartIcon="@Icons.Material.Filled.Cancel"
                                   OnClick="CancelBatchAsync">作废</MudButton>
                    }
                    @if (batch.Status == "InProgress" || batch.Status == "Completed")
                    {
                        <MudButton Variant="Variant.Outlined" Size="Size.Small" Color="Color.Warning"
                                   StartIcon="@Icons.Material.Filled.PauseCircle"
                                   OnClick="PauseBatchAsync">暂停</MudButton>
                        <MudButton Variant="Variant.Outlined" Size="Size.Small" Color="Color.Error"
                                   StartIcon="@Icons.Material.Filled.Cancel"
                                   OnClick="CancelBatchAsync">作废</MudButton>
                        <MudButton Variant="Variant.Outlined" Size="Size.Small" Color="Color.Error"
                                   StartIcon="@Icons.Material.Filled.Verified"
                                   OnClick="ForceCompleteAsync">强制完成</MudButton>
                    }
                    else if (batch.Status == "Suspended")
                    {
                        <MudButton Variant="Variant.Outlined" Size="Size.Small" Color="Color.Success"
                                   StartIcon="@Icons.Material.Filled.PlayCircle"
                                   OnClick="ResumeBatchAsync">恢复</MudButton>
                    }
                    else if (batch.Status == "Cancelled")
                    {
                        <MudButton Variant="Variant.Outlined" Size="Size.Small" Color="Color.Success"
                                   StartIcon="@Icons.Material.Filled.Restore"
                                   OnClick="ResumeBatchAsync">恢复</MudButton>
                    }
                    @if (batch.IsForceCompleted && batch.Status == "Completed")
                    {
                        <MudButton Variant="Variant.Outlined" Size="Size.Small" Color="Color.Default"
                                   StartIcon="@Icons.Material.Filled.Undo"
                                   OnClick="UnforceCompleteAsync">转为在产</MudButton>
                    }
                </div>
            </div>
        </MudPaper>

        <!-- ===== 区块三：批次执行进度 ===== -->
        <MudPaper Class="detail-card pa-4 mb-3" Elevation="0">
            <MudText Typo="Typo.subtitle2" Class="detail-label font-weight-bold mb-3">
                <MudIcon Icon="@Icons.Material.Filled.Timeline" Class="mr-1" Size="Size.Small" />
                批次执行进度
            </MudText>

            @if (_isTrackingLoading)
            {
                <MudProgressCircular Indeterminate Size="Size.Small" Class="mb-3" />
            }
            else if (_trackingVisual == null)
            {
                <MudText Typo="Typo.body2" Class="detail-empty">暂无执行记录</MudText>
            }
            else
            {
                <!-- 顶部统计条 -->
                <div class="d-flex flex-wrap align-center mb-3" Style="gap: 8px 24px;">
                    <MudChip Size="Size.Small" Color="Color.Tertiary">
                        已执行 @_trackingVisual.CompletedSectionCount / @_trackingVisual.TotalSectionCount 工段
                    </MudChip>
                    @if (_trackingVisual.TotalSectionCount > 0)
                    {
                        <div class="detail-progress-track">
                            <div class="detail-progress-fill" Style="width:@(_trackingVisual.ProgressPercent)%"></div>
                        </div>
                        <MudText Typo="Typo.body2">@_trackingVisual.ProgressPercent%</MudText>
                    }
                    @if (_trackingVisual.InputQuantity.HasValue)
                    {
                        <MudText Typo="Typo.body2" Color="Color.Primary">
                            投料量：@_trackingVisual.InputQuantity 支 / @(_trackingVisual.InputWeight) kg
                        </MudText>
                    }
                    @if (_trackingVisual.TargetQuantity.HasValue)
                    {
                        <MudText Typo="Typo.body2" Color="Color.Secondary">
                            目标量：@_trackingVisual.TargetQuantity 支 / @(_trackingVisual.TargetWeight) kg
                        </MudText>
                    }
                </div>

                <!-- 当前/下一工段摘要 -->
                <div class="detail-summary-bar d-flex flex-wrap mb-3">
                    @if (!string.IsNullOrEmpty(_trackingVisual.CurrentSectionName))
                    {
                        <MudText Typo="Typo.body2" Class="detail-current-section">
                            📍 当前：<span class="detail-current-name">@_trackingVisual.CurrentGroupName</span> &gt;
                            <span class="detail-current-name">@_trackingVisual.CurrentSectionName</span>
                        </MudText>
                    }
                    @if (!string.IsNullOrEmpty(_trackingVisual.CurrentEquipmentName))
                    {
                        <MudText Typo="Typo.body2">🔧 设备：@_trackingVisual.CurrentEquipmentName</MudText>
                    }
                    @if (!string.IsNullOrEmpty(_trackingVisual.CurrentOutsource))
                    {
                        <MudText Typo="Typo.body2" Class="detail-outsource-status">🚚 委外中：@_trackingVisual.CurrentOutsource</MudText>
                    }
                    @if (!string.IsNullOrEmpty(_trackingVisual.NextSectionName))
                    {
                        <MudText Typo="Typo.body2" Class="detail-next-section">⏭ 下一工段：@_trackingVisual.NextSectionName</MudText>
                    }
                </div>

                <!-- 流程图：工序组水平排列 -->
                <div class="detail-section-scroll">
                    @foreach (var group in _trackingVisual.ProcessGroups)
                    {
                        <div class="detail-group-card">
                            <!-- 组标题 -->
                            <div class="detail-group-header">
                                @group.ProcessName
                                <span class="detail-group-count">(@group.CompletedSections/@group.TotalSections)</span>
                            </div>
                            <!-- 工段卡片列表 -->
                            <div class="detail-section-list">
                                @foreach (var section in group.Sections)
                                {
                                    <div class="detail-section-item d-flex align-center"
                                         Style="border-radius:4px; margin:2px 0; padding:4px 6px; gap:6px; @GetSectionStyle(section.Status)"
                                         title="@GetSectionTooltip(section)">
                                        <span class="detail-section-icon">@GetSectionIcon(section.Status)</span>
                                        <span class="detail-section-name">@(section.SectionName)</span>
                                        @if (section.Status == "Outsource")
                                        {
                                            <MudChip Size="Size.Small" Color="Color.Warning" Class="detail-outsource-chip ma-0">委外</MudChip>
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
        </MudPaper>

        <!-- ===== 区块四：质量要求 ===== -->
        <MudPaper Class="detail-card-bg pa-4 mb-3" Elevation="0">
            <MudText Typo="Typo.subtitle2" Class="detail-label font-weight-bold mb-3">
                <MudIcon Icon="@Icons.Material.Filled.FactCheck" Class="mr-1" Size="Size.Small" />质量要求
            </MudText>
            <div class="d-flex flex-wrap" style="gap: 0.6rem 2rem;">
                <div style="min-width:300px; flex:1;"><MudText Typo="Typo.caption" Class="detail-label font-weight-bold">固溶参数</MudText><MudText Typo="Typo.body2">@(batch.SolutionParams ?? "-")</MudText></div>
                <div style="min-width:300px; flex:1;"><MudText Typo="Typo.caption" Class="detail-label font-weight-bold">质量备注</MudText><MudText Typo="Typo.body2">@(batch.QualityRemark ?? "-")</MudText></div>
            </div>
        </MudPaper>

        <!-- ===== 区块五：仓库来源信息 ===== -->
        <MudPaper Class="detail-card-bg pa-4 mb-3" Elevation="0">
            <MudText Typo="Typo.subtitle2" Class="detail-label font-weight-bold mb-3">
                <MudIcon Icon="@Icons.Material.Filled.Warehouse" Class="mr-1" Size="Size.Small" />仓库来源信息
            </MudText>
            @if (!string.IsNullOrEmpty(batch.SourceBatchNo))
            {
                <div class="d-flex flex-wrap" style="gap: 0.6rem 2rem;">
                    <div><MudText Typo="Typo.caption" Class="detail-label font-weight-bold">来源库存批次</MudText><MudText Typo="Typo.body2">@batch.SourceBatchNo</MudText></div>
                    <div><MudText Typo="Typo.caption" Class="detail-label font-weight-bold">仓库名称</MudText><MudText Typo="Typo.body2">@(batch.WarehouseName ?? "-")</MudText></div>
                    <div><MudText Typo="Typo.caption" Class="detail-label font-weight-bold">来源工单号</MudText><MudText Typo="Typo.body2">@batch.WorkOrderNo</MudText></div>
                    <div><MudText Typo="Typo.caption" Class="detail-label font-weight-bold">原料类型</MudText><MudText Typo="Typo.body2">@(batch.SourceMaterialType ?? "-")</MudText></div>
                    <div><MudText Typo="Typo.caption" Class="detail-label font-weight-bold">入库来源</MudText><MudText Typo="Typo.body2">@DisplayHelper.GetInboundSourceText(batch.InboundSource)</MudText></div>
                    <div><MudText Typo="Typo.caption" Class="detail-label font-weight-bold">来料单位</MudText><MudText Typo="Typo.body2">@(batch.SourceName ?? "-")</MudText></div>
                    <div><MudText Typo="Typo.caption" Class="detail-label font-weight-bold">入库日期</MudText><MudText Typo="Typo.body2">@(batch.InboundDate?.ToString("yyyy-MM-dd") ?? "-")</MudText></div>
                    <div><MudText Typo="Typo.caption" Class="detail-label font-weight-bold">炉号</MudText><MudText Typo="Typo.body2">@(batch.SourceHeatNo ?? "-")</MudText></div>
                    <div><MudText Typo="Typo.caption" Class="detail-label font-weight-bold">工厂牌号</MudText><MudText Typo="Typo.body2">@(batch.SourcePlantGrade ?? "-")</MudText></div>
                    <div><MudText Typo="Typo.caption" Class="detail-label font-weight-bold">名义规格</MudText><MudText Typo="Typo.body2">@(batch.SourceSpecification ?? "-")</MudText></div>
                    <div><MudText Typo="Typo.caption" Class="detail-label font-weight-bold">长度状态</MudText><MudText Typo="Typo.body2">@DisplayHelper.GetLengthStatusText(batch.SourceLengthStatus)</MudText></div>
                    <div><MudText Typo="Typo.caption" Class="detail-label font-weight-bold">单支重</MudText><MudText Typo="Typo.body2">@DisplayHelper.FormatNullableDecimal(batch.SourceUnitWeight) kg</MudText></div>
                    <div><MudText Typo="Typo.caption" Class="detail-label font-weight-bold">领料支数</MudText><MudText Typo="Typo.body2">@(batch.InputQuantity?.ToString() ?? "-") 支</MudText></div>
                    <div><MudText Typo="Typo.caption" Class="detail-label font-weight-bold">领料重量</MudText><MudText Typo="Typo.body2">@DisplayHelper.FormatNullableDecimal(batch.InputWeight) kg</MudText></div>
                    <div><MudText Typo="Typo.caption" Class="detail-label font-weight-bold">现有效原料支数</MudText><MudText Typo="Typo.body2">@(batch.CurrentValidQty?.ToString() ?? "-") 支</MudText></div>
                    <div><MudText Typo="Typo.caption" Class="detail-label font-weight-bold">现有效原料重量</MudText><MudText Typo="Typo.body2">@DisplayHelper.FormatNullableDecimal(batch.CurrentValidWeight) kg</MudText></div>
                </div>
            }
        </MudPaper>

        <!-- ===== 区块六：工单信息（只读快照） ===== -->
        <MudPaper Class="detail-card-bg pa-4 mb-3" Elevation="0">
            <MudText Typo="Typo.subtitle2" Class="detail-label font-weight-bold mb-3">
                <MudIcon Icon="@Icons.Material.Filled.Assignment" Class="mr-1" Size="Size.Small" />工单信息（创建时快照，只读）
            </MudText>
            <!-- 第1组 -->
            <MudText Typo="Typo.caption" Class="detail-subsection font-weight-bold mb-2">基本信息</MudText>
            <div class="d-flex flex-wrap" style="gap: 0.6rem 2rem;">
                <div><MudText Typo="Typo.caption" Class="detail-label font-weight-bold">工单号</MudText>
                    <MudLink Typo="Typo.body2" Class="detail-link" OnClick="() => NavigateToWorkOrder(batch.WorkOrderNo)">
                        @batch.WorkOrderNo
                    </MudLink></div>
                <div><MudText Typo="Typo.caption" Class="detail-label font-weight-bold">源订单号</MudText>
                    <MudLink Typo="Typo.body2" Class="detail-link" OnClick="() => NavigateToSalesOrder(batch.SalesOrderNo)">
                        @batch.SalesOrderNo
                    </MudLink></div>
                <div><MudText Typo="Typo.caption" Class="detail-label font-weight-bold">主号</MudText><MudText Typo="Typo.body2">@batch.ProductionMainNo</MudText></div>
                <div><MudText Typo="Typo.caption" Class="detail-label font-weight-bold">次号</MudText><MudText Typo="Typo.body2">@(batch.ProductionSubNo ?? "-")</MudText></div>
                <div><MudText Typo="Typo.caption" Class="detail-label font-weight-bold">项次ID</MudText><MudText Typo="Typo.body2">@batch.OrderItemIds</MudText></div>
                <div><MudText Typo="Typo.caption" Class="detail-label font-weight-bold">签订日期</MudText><MudText Typo="Typo.body2">@batch.SignDate.ToString("yyyy-MM-dd")</MudText></div>
                <div><MudText Typo="Typo.caption" Class="detail-label font-weight-bold">业务员</MudText><MudText Typo="Typo.body2">@batch.Salesman</MudText></div>
                <div><MudText Typo="Typo.caption" Class="detail-label font-weight-bold">最终用户</MudText><MudText Typo="Typo.body2">@(batch.EndCustomer ?? "-")</MudText></div>
                <div><MudText Typo="Typo.caption" Class="detail-label font-weight-bold">交货日期</MudText><MudText Typo="Typo.body2">@batch.DeliveryDate.ToString("yyyy-MM-dd")</MudText></div>
                <div><MudText Typo="Typo.caption" Class="detail-label font-weight-bold">延期罚款</MudText><MudText Typo="Typo.body2">@(batch.DelayPenalty ? "是" : "否")</MudText></div>
                <div><MudText Typo="Typo.caption" Class="detail-label font-weight-bold">物料名称</MudText><MudText Typo="Typo.body2">@DisplayHelper.GetMaterialNameText(Enum.TryParse<MaterialName>(batch.MaterialName, ignoreCase: true, out var mn) ? mn : default)</MudText></div>
                <div><MudText Typo="Typo.caption" Class="detail-label font-weight-bold">结算方式</MudText><MudText Typo="Typo.body2">@DisplayHelper.GetSettlementMethodText(Enum.TryParse<SettlementMethod>(batch.SettlementMethod, ignoreCase: true, out var sm) ? sm : default)</MudText></div>
                <div><MudText Typo="Typo.caption" Class="detail-label font-weight-bold">标准编码</MudText><MudText Typo="Typo.body2">@batch.StandardCode</MudText></div>
            </div>

            <MudDivider Class="my-3" />
            <!-- 第2组 -->
            <MudText Typo="Typo.caption" Class="detail-subsection font-weight-bold mb-2">工艺参数及汇总</MudText>
            <div class="d-flex flex-wrap" style="gap: 0.6rem 2rem;">
                <div><MudText Typo="Typo.caption" Class="detail-label font-weight-bold">交货状态</MudText><MudText Typo="Typo.body2">@DisplayHelper.GetDeliveryStateText(Enum.TryParse<DeliveryState>(batch.DeliveryState, ignoreCase: true, out var ds) ? ds : default)</MudText></div>
                <div><MudText Typo="Typo.caption" Class="detail-label font-weight-bold">工厂牌号</MudText><MudText Typo="Typo.body2">@batch.PlantGrade</MudText></div>
                <div><MudText Typo="Typo.caption" Class="detail-label font-weight-bold">规格</MudText><MudText Typo="Typo.body2">@DisplayHelper.FormatSpecification(batch.Specification)</MudText></div>
                <div><MudText Typo="Typo.caption" Class="detail-label font-weight-bold">外径公差</MudText><MudText Typo="Typo.body2">@DisplayHelper.FormatTolerance(batch.OuterDiameterNegative, batch.OuterDiameterPositive)</MudText></div>
                <div><MudText Typo="Typo.caption" Class="detail-label font-weight-bold">壁厚公差</MudText><MudText Typo="Typo.body2">@DisplayHelper.FormatTolerance(batch.WallThicknessNegative, batch.WallThicknessPositive)</MudText></div>
                <div><MudText Typo="Typo.caption" Class="detail-label font-weight-bold">长度状态</MudText><MudText Typo="Typo.body2">@DisplayHelper.GetLengthStatusText(batch.LengthStatus)</MudText></div>
                <div><MudText Typo="Typo.caption" Class="detail-label font-weight-bold">最小长度</MudText><MudText Typo="Typo.body2">@DisplayHelper.FormatNullableDecimal(batch.MinLength) mm</MudText></div>
                <div><MudText Typo="Typo.caption" Class="detail-label font-weight-bold">最大长度</MudText><MudText Typo="Typo.body2">@DisplayHelper.FormatNullableDecimal(batch.MaxLength) mm</MudText></div>
                <div><MudText Typo="Typo.caption" Class="detail-label font-weight-bold">总支数</MudText><MudText Typo="Typo.body2">@batch.TotalQuantity 支</MudText></div>
                <div><MudText Typo="Typo.caption" Class="detail-label font-weight-bold">总米数</MudText><MudText Typo="Typo.body2">@DisplayHelper.FormatDecimal(batch.TotalMeters) m</MudText></div>
                <div><MudText Typo="Typo.caption" Class="detail-label font-weight-bold">总重量</MudText><MudText Typo="Typo.body2">@DisplayHelper.FormatDecimal(batch.TotalWeight) kg</MudText></div>
                <div><MudText Typo="Typo.caption" Class="detail-label font-weight-bold">技术要求</MudText><MudText Typo="Typo.body2">@DisplayHelper.GetTechnicalRequirementsText(batch.TechnicalRequirements)</MudText></div>
            </div>

            <MudDivider Class="my-3" />
            <!-- 第3组 -->
            <MudText Typo="Typo.caption" Class="detail-subsection font-weight-bold mb-2">项次及明细</MudText>
            <div class="d-flex flex-wrap" style="gap: 0.6rem 2rem;">
                <div><MudText Typo="Typo.caption" Class="detail-label font-weight-bold">总项次数</MudText><MudText Typo="Typo.body2">@batch.TotalItemCount</MudText></div>
                <div style="flex:1; min-width:200px;">
                    <MudText Typo="Typo.caption" Class="detail-label font-weight-bold">明细</MudText>
                    <MudText Typo="Typo.body2" class="detail-text-ellipsis" title="@batch.ItemDetails">
                        @(batch.ItemDetails ?? "-")
                    </MudText>
                </div>
            </div>
        </MudPaper>

        <!-- ===== 区块七：工序组列表 ===== -->
        <MudPaper Class="detail-card-bg pa-4 mb-3" Elevation="0">
            <MudText Typo="Typo.subtitle2" Class="detail-label font-weight-bold mb-3">
                <MudIcon Icon="@Icons.Material.Filled.AccountTree" Class="mr-1" Size="Size.Small" />工序组
            </MudText>
            @if (batch.ProcessGroups.Count > 0)
            {
                <div class="detail-table-scroll">
                    <MudTable T="ProcessGroupDto" Items="batch.ProcessGroups" Dense="true" Hover="true" Elevation="0" ReadOnly="true" Class="auto-table">
                        <HeaderContent>
                            <MudTh>序号</MudTh>
                            <MudTh>工序名称</MudTh>
                            <MudTh>制造规格</MudTh>
                            <MudTh>外径公差</MudTh>
                            <MudTh>壁厚公差</MudTh>
                            <MudTh>制造长度</MudTh>
                            <MudTh>断切处理</MudTh>
                            <MudTh>备注</MudTh>
                            <MudTh>冷轧拔</MudTh>
                            <MudTh>油管断</MudTh>
                            <MudTh>去油</MudTh>
                            <MudTh>固溶</MudTh>
                            <MudTh>矫直</MudTh>
                            <MudTh>断切</MudTh>
                            <MudTh>测壁厚</MudTh>
                            <MudTh>酸洗</MudTh>
                            <MudTh>外抛光</MudTh>
                            <MudTh>内修磨</MudTh>
                            <MudTh>外点磨</MudTh>
                            <MudTh>检验</MudTh>
                            <MudTh>打焊头</MudTh>
                            <MudTh>润滑</MudTh>
                            <MudTh>入库</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd><MudText Typo="Typo.body2">@context.SequenceNumber</MudText></MudTd>
                            <MudTd><MudText Typo="Typo.body2" Class="font-weight-bold">@context.ProcessName</MudText></MudTd>
                            <MudTd title="@context.ManufacturingSpec"><MudText Typo="Typo.body2">@(context.ManufacturingSpec ?? "-")</MudText></MudTd>
                            <MudTd title="@context.OuterDiameterTolerance"><MudText Typo="Typo.body2">@(context.OuterDiameterTolerance ?? "-")</MudText></MudTd>
                            <MudTd title="@context.WallThicknessTolerance"><MudText Typo="Typo.body2">@(context.WallThicknessTolerance ?? "-")</MudText></MudTd>
                            <MudTd title="@context.ManufacturingLength"><MudText Typo="Typo.body2">@(context.ManufacturingLength ?? "-")</MudText></MudTd>
                            <MudTd title="@context.CuttingTreatment"><MudText Typo="Typo.body2">@(context.CuttingTreatment ?? "-")</MudText></MudTd>
                            <MudTd title="@context.Remark"><MudText Typo="Typo.body2">@(context.Remark ?? "-")</MudText></MudTd>
                            <MudTd><MudText Typo="Typo.body2">@(context.ColdRollDraw?.ToString() ?? "-")</MudText></MudTd>
                            <MudTd><MudText Typo="Typo.body2">@(context.OilPipeCut?.ToString() ?? "-")</MudText></MudTd>
                            <MudTd><MudText Typo="Typo.body2">@(context.Degrease?.ToString() ?? "-")</MudText></MudTd>
                            <MudTd><MudText Typo="Typo.body2">@(context.Solution?.ToString() ?? "-")</MudText></MudTd>
                            <MudTd><MudText Typo="Typo.body2">@(context.Straighten?.ToString() ?? "-")</MudText></MudTd>
                            <MudTd><MudText Typo="Typo.body2">@(context.Cut?.ToString() ?? "-")</MudText></MudTd>
                            <MudTd><MudText Typo="Typo.body2">@(context.ThicknessMeasure?.ToString() ?? "-")</MudText></MudTd>
                            <MudTd><MudText Typo="Typo.body2">@(context.Pickle?.ToString() ?? "-")</MudText></MudTd>
                            <MudTd><MudText Typo="Typo.body2">@(context.OuterPolish?.ToString() ?? "-")</MudText></MudTd>
                            <MudTd><MudText Typo="Typo.body2">@(context.InnerGrinding?.ToString() ?? "-")</MudText></MudTd>
                            <MudTd><MudText Typo="Typo.body2">@(context.OuterSpotGrinding?.ToString() ?? "-")</MudText></MudTd>
                            <MudTd><MudText Typo="Typo.body2">@(context.Inspection?.ToString() ?? "-")</MudText></MudTd>
                            <MudTd><MudText Typo="Typo.body2">@(context.WeldingHead?.ToString() ?? "-")</MudText></MudTd>
                            <MudTd><MudText Typo="Typo.body2">@(context.Lubrication?.ToString() ?? "-")</MudText></MudTd>
                            <MudTd><MudText Typo="Typo.body2">@(context.Warehouse?.ToString() ?? "-")</MudText></MudTd>
                        </RowTemplate>
                    </MudTable>
                </div>
            }
        </MudPaper>

        <!-- ===== 区块八：操作日志 ===== -->
        <MudPaper Class="detail-card-bg pa-4 mb-3" Elevation="0">
            <div class="d-flex align-center mb-3">
                <MudText Typo="Typo.subtitle2" Class="detail-label font-weight-bold">
                    <MudIcon Icon="@Icons.Material.Filled.History" Class="mr-1" Size="Size.Small" />操作日志
                </MudText>
                <MudSpacer />
                <MudButton Variant="Variant.Text" Size="Size.Small"
                           StartIcon="@(_showOperationLog ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)"
                           OnClick="ToggleOperationLog">
                    @(_showOperationLog ? "收起" : "展开")
                </MudButton>
            </div>
            @if (_showOperationLog)
            {
                @if (_operationLogsLoading)
                {
                    <MudProgressCircular Indeterminate Size="Size.Small" />
                }
                else if (_operationLogs.Count == 0)
                {
                    <MudText Typo="Typo.body2" Class="detail-empty">暂无操作记录</MudText>
                }
                else
                {
                    <MudTable Items="_operationLogs" Dense="true" Hover="true" Elevation="0" ReadOnly="true" Class="auto-table">
                        <HeaderContent>
                            <MudTh>操作类型</MudTh>
                            <MudTh>详情</MudTh>
                            <MudTh>操作人</MudTh>
                            <MudTh>操作时间</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd>
                                <MudChip Size="Size.Small" Color="@GetOperationLogColor(context.OperationType)">
                                    @context.OperationType
                                </MudChip>
                            </MudTd>
                            <MudTd><MudText Typo="Typo.body2">@(context.Detail ?? "-")</MudText></MudTd>
                            <MudTd><MudText Typo="Typo.body2">@context.CreatedBy</MudText></MudTd>
                            <MudTd><MudText Typo="Typo.body2">@context.CreatedTime.LocalDateTime.ToString("yyyy-MM-dd HH:mm")</MudText></MudTd>
                        </RowTemplate>
                    </MudTable>
                }
            }
        </MudPaper>

    }
</MudContainer>

@code {
    [Parameter] public int Id { get; set; }

    private ProductionBatchDetailDto? batch;
    private bool isLoading = true;

    private BatchTrackingVisualDto? _trackingVisual;
    private bool _isTrackingLoading;

    // 操作日志
    private List<BatchOperationLogDto> _operationLogs = new();
    private bool _operationLogsLoading;
    private bool _showOperationLog;

    // 相邻批次导航
    private bool _hasPrev;
    private bool _hasNext;
    private int? _prevId;
    private int? _nextId;
    private string? _prevBatchNo;
    private string? _nextBatchNo;

    private bool CanEdit => IsInRole("BatchDirector,Admin");
    private bool CanDelete => IsInRole("Admin");

    private static bool IsInRole(string roles)
    {
        // 由 Blazor [Authorize] 保证页面级权限，按钮级权限不做严格检查
        return true;
    }

    protected override async Task OnParametersSetAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        if (Id <= 0)
        {
            Snackbar.Add("无效的批次ID", Severity.Error);
            isLoading = false;
            return;
        }

        isLoading = true;
        StateHasChanged();

        try
        {
            var result = await BatchService.GetByIdAsync(Id);
            if (result.Success && result.Data != null)
            {
                batch = result.Data;
            }
            else
            {
                Snackbar.Add(result.Message ?? "加载批次详情失败", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"加载失败: {ex.Message}", Severity.Error);
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }

        // 并行加载跟踪可视化数据
        await LoadTrackingVisual();

        // 加载相邻批次导航
        await LoadAdjacentBatch();

        // 加载操作日志
        await LoadOperationLogs();
    }

    // ========== 操作 ==========

    private void EnterEditMode()
    {
        Navigation.NavigateTo($"/batches/{Id}/edit");
    }

    private async Task PrintAsync()
    {
        try
        {
            var result = await BatchService.PrintBatchAsync(Id);
            if (result.Success && !string.IsNullOrEmpty(result.Data))
            {
                await JS.InvokeVoidAsync("openPdf", result.Data);
            }
            else
            {
                Snackbar.Add(result.Message ?? "打印失败", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"打印失败: {ex.Message}", Severity.Error);
        }
    }

    private async Task DeleteAsync()
    {
        var dialog = await DialogService.ShowAsync<ConfirmDialog>("确认删除", new DialogParameters
        {
            ["ContentText"] = $"确定删除生产批次 {batch?.BatchNo} 吗？关联的工序组将一并删除，且不可恢复。",
            ["ConfirmText"] = "删除",
            ["Color"] = Color.Error
        });
        var result = await dialog.Result;
        if (result.Canceled) return;

        try
        {
            var apiResult = await BatchService.DeleteAsync(Id);
            if (apiResult.Success)
            {
                Snackbar.Add("删除成功", Severity.Success);
                Navigation.NavigateTo("/batches");
            }
            else
            {
                Snackbar.Add(apiResult.Message ?? "删除失败", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"删除失败: {ex.Message}", Severity.Error);
        }
    }

    private void GoBack() => Navigation.NavigateTo("/batches");

    private async Task RefreshTracking()
    {
        try
        {
            var result = await ProdRecordService.RefreshBatchTrackingAsync(Id);
            if (result.Success)
            {
                Snackbar.Add("执行状态已刷新", Severity.Success);
                await LoadData();
            }
            else
            {
                Snackbar.Add(result.Message ?? "刷新失败", Severity.Error);
            }
        }
        catch (Exception ex) { Snackbar.Add($"刷新失败: {ex.Message}", Severity.Error); }
    }

    // ========== 操作日志 ==========

    private void ToggleOperationLog()
    {
        _showOperationLog = !_showOperationLog;
        if (_showOperationLog && _operationLogs.Count == 0)
            _ = LoadOperationLogs();
    }

    private async Task LoadOperationLogs()
    {
        if (Id <= 0) return;
        _operationLogsLoading = true;
        try
        {
            var result = await BatchService.GetOperationLogsAsync(Id);
            if (result.Success && result.Data != null)
                _operationLogs = result.Data;
        }
        catch { }
        finally
        {
            _operationLogsLoading = false;
            StateHasChanged();
        }
    }

    private static Color GetOperationLogColor(string operationType) => operationType switch
    {
        "创建" => Color.Info,
        "状态变更" => Color.Warning,
        "强制完成" => Color.Error,
        "删除" => Color.Error,
        "更新工单" => Color.Primary,
        _ => Color.Default
    };

    // ========== 批次操作 ==========

    private async Task PauseBatchAsync()
    {
        var dialog = await DialogService.ShowAsync<ConfirmDialog>("确认暂停", new DialogParameters
        {
            ["ContentText"] = $"确定暂停批次 {batch?.BatchNo} 吗？暂停后不会自动执行工段。",
            ["ConfirmText"] = "暂停",
            ["Color"] = Color.Warning
        });
        var result = await dialog.Result;
        if (result.Canceled) return;

        await UpdateBatchStatusAsync("Suspended");
    }

    private async Task ResumeBatchAsync()
    {
        await UpdateBatchStatusAsync("InProgress");
    }

    private async Task ForceCompleteAsync()
    {
        var dialog = await DialogService.ShowAsync<ConfirmDialog>("确认强制完成", new DialogParameters
        {
            ["ContentText"] = $"确定强制完成批次 {batch?.BatchNo} 吗？此操作将跳过剩余工段。",
            ["ConfirmText"] = "强制完成",
            ["Color"] = Color.Error
        });
        var result = await dialog.Result;
        if (result.Canceled) return;

        await UpdateBatchStatusAsync("Completed");
    }

    private async Task UnforceCompleteAsync()
    {
        var dialog = await DialogService.ShowAsync<ConfirmDialog>("确认恢复", new DialogParameters
        {
            ["ContentText"] = $"确定将批次 {batch?.BatchNo} 转为在产状态吗？",
            ["ConfirmText"] = "转为在产",
            ["Color"] = Color.Warning
        });
        var result = await dialog.Result;
        if (result.Canceled) return;

        await UpdateBatchStatusAsync("InProgress");
    }

    private async Task CancelBatchAsync()
    {
        var dialog = await DialogService.ShowAsync<ConfirmDialog>("确认作废", new DialogParameters
        {
            ["ContentText"] = $"确定将批次 {batch?.BatchNo} 作废吗？",
            ["ConfirmText"] = "作废",
            ["Color"] = Color.Error
        });
        var result = await dialog.Result;
        if (result.Canceled) return;

        await UpdateBatchStatusAsync("Cancelled");
    }

    private async Task UpdateBatchStatusAsync(string newStatus)
    {
        if (batch == null) return;
        try
        {
            var request = new UpdateBatchStatusRequest
            {
                Status = newStatus,
                RowVersion = batch.RowVersion
            };
            var result = await BatchService.UpdateStatusAsync(Id, request);
            if (result.Success)
            {
                Snackbar.Add("状态已更新", Severity.Success);
                await LoadData();
            }
            else
            {
                Snackbar.Add(result.Message ?? "更新失败", Severity.Error);
            }
        }
        catch (Exception ex) { Snackbar.Add($"更新失败: {ex.Message}", Severity.Error); }
    }

    private async Task NavigateToWorkOrder(string workOrderNo)
    {
        try
        {
            var result = await WorkOrderService.GetByWorkOrderNoAsync(workOrderNo);
            if (result.Success && result.Data != null)
            {
                Navigation.NavigateTo($"/workorders/{result.Data.Id}");
            }
            else
            {
                Snackbar.Add($"未找到工单 {workOrderNo}", Severity.Warning);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"跳转失败: {ex.Message}", Severity.Error);
        }
    }

    private async Task NavigateToSalesOrder(string salesOrderNo)
    {
        try
        {
            var result = await OrderService.GetIdByOrderNumberAsync(salesOrderNo);
            if (result.Success && result.Data.HasValue)
            {
                Navigation.NavigateTo($"/orders/{result.Data.Value}");
            }
            else
            {
                Snackbar.Add($"未找到订单 {salesOrderNo}", Severity.Warning);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"跳转失败: {ex.Message}", Severity.Error);
        }
    }

    // ========== 相邻批次导航 ==========

    private async Task LoadAdjacentBatch()
    {
        try
        {
            var result = await BatchService.GetAdjacentBatchAsync(Id);
            if (result.Success && result.Data != null)
            {
                _prevId = result.Data.PrevId;
                _nextId = result.Data.NextId;
                _prevBatchNo = result.Data.PrevBatchNo;
                _nextBatchNo = result.Data.NextBatchNo;
                _hasPrev = _prevId.HasValue;
                _hasNext = _nextId.HasValue;
            }
        }
        catch { }
    }

    private void NavigatePrev()
    {
        if (_prevId.HasValue)
            Navigation.NavigateTo($"/batches/{_prevId}");
    }

    private void NavigateNext()
    {
        if (_nextId.HasValue)
            Navigation.NavigateTo($"/batches/{_nextId}");
    }

    // ========== 跟踪可视化 ==========

    private async Task LoadTrackingVisual()
    {
        if (Id <= 0) return;

        _isTrackingLoading = true;
        StateHasChanged();

        try
        {
            var result = await ProdRecordService.GetTrackingVisualAsync(Id);
            if (result.Success && result.Data != null)
            {
                _trackingVisual = result.Data;
            }
            else
            {
                _trackingVisual = null;
            }
        }
        catch
        {
            _trackingVisual = null;
        }
        finally
        {
            _isTrackingLoading = false;
            StateHasChanged();
        }
    }

    private static string GetSectionStyle(string status) => status switch
    {
        "Completed" => "background:#e8f5e9; opacity:0.85;",
        "InProgress" => "background:#e3f2fd; border-left:3px solid #1976d2;",
        "Outsource" => "background:#fff3e0; border-left:3px solid #f57c00;",
        "Next" => "background:#f3e5f5; border:1px dashed #9c27b0;",
        _ => "background:#fafafa; opacity:0.6;"
    };

    private static string GetSectionIcon(string status) => status switch
    {
        "Completed" => "✅",
        "InProgress" => "🔄",
        "Outsource" => "🚚",
        "Next" => "⏭",
        _ => "⭕"
    };

    private static string GetSectionTooltip(SectionVisualDto section)
    {
        var parts = new List<string> { section.SectionName };
        if (section.ExecDate.HasValue)
            parts.Add($"执行日: {section.ExecDate:yyyy-MM-dd}");
        if (section.EquipmentName != null)
            parts.Add($"设备: {section.EquipmentName}");
        if (section.Quantity.HasValue)
            parts.Add($"数量: {section.Quantity}支");
        if (section.Weight.HasValue)
            parts.Add($"重量: {section.Weight:G29}kg");
        if (section.Operator != null)
            parts.Add($"操作人: {section.Operator}");
        if (section.OutsourceVendor != null)
        {
            parts.Add($"委外: {section.OutsourceVendor}");
            if (section.OutsourceProgress.HasValue)
                parts.Add($"回收进度: {section.OutsourceProgress}%");
        }
        return string.Join(" | ", parts);
    }

}
