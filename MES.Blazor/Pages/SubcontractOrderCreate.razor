@page "/subcontract-orders/create"
@using MES.Blazor.Services
@using MES.Core.DTOs
@using Microsoft.AspNetCore.Authorization
@inject SubcontractOrderService SubcontractService
@inject SupplierService SupplierService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@attribute [Authorize(Roles = "MaterialStaff,MaterialDirector,Admin")]

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-4">
    <MudCard>
        <MudCardHeader>
            <CardHeaderContent>
                <MudText Typo="Typo.h5" Class="font-weight-bold"><MudIcon Icon="@Icons.Material.Filled.Handyman" Class="mr-2" Color="Color.Primary" />新建委外加工单</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">创建新的委外加工单，关联发出物料和加工要求</MudText>
            </CardHeaderContent>
            <CardHeaderActions>
                <MudButton Variant="Variant.Text" OnClick="GoBack">返回</MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Save" Disabled="@isSubmitting">
                    @if (isSubmitting) { <MudProgressCircular Size="Size.Small" Color="Color.Inherit" /> } else { <span>保存</span> }
                </MudButton>
            </CardHeaderActions>
        </MudCardHeader>
        <MudCardContent>
            <MudText Typo="Typo.subtitle1" Class="mb-4 font-weight-bold"><MudIcon Icon="@Icons.Material.Filled.Info" Size="Size.Small" Class="mr-1" />基本信息</MudText>
            <MudGrid>
                <MudItem xs="12">
                    <div class="form-inline-row">
                        <div class="form-inline-field">
                            <MudText class="form-label">供应商 *</MudText>
                            <div class="form-input">
                                <MudSelect T="int" @bind-Value="request.SupplierId" Required="true" Variant="Variant.Outlined">
                                    @foreach (var s in suppliers) { <MudSelectItem Value="s.Id">@s.SupplierName</MudSelectItem> }
                                </MudSelect>
                            </div>
                        </div>
                        <div class="form-inline-field">
                            <MudText class="form-label">下单日期</MudText>
                            <div class="form-input">
                                <MudTextField T="string" @bind-Value="orderDateText" Required="true" Placeholder="yyyy-MM-dd" Variant="Variant.Outlined" />
                            </div>
                        </div>
                        <div class="form-inline-field">
                            <MudText class="form-label">收回期限</MudText>
                            <div class="form-input">
                                <MudTextField T="string" @bind-Value="returnDeadlineText" Placeholder="yyyy-MM-dd" Variant="Variant.Outlined" />
                            </div>
                        </div>
                    </div>
                </MudItem>
            </MudGrid>

            <MudText Typo="Typo.subtitle1" Class="mb-4 mt-4 font-weight-bold"><MudIcon Icon="@Icons.Material.Filled.Output" Size="Size.Small" Class="mr-1" />发出物料</MudText>
            <MudGrid>
                <MudItem xs="12" md="4">
                    <div class="form-horizontal-field">
                        <MudText class="form-label">物料分类 *</MudText>
                        <div class="form-input">
                            <MudTextField T="string" @bind-Value="request.OutMaterialCategory" Required="true" Variant="Variant.Outlined" />
                        </div>
                    </div>
                </MudItem>
                <MudItem xs="12" md="4">
                    <div class="form-horizontal-field">
                        <MudText class="form-label">厂内钢种 *</MudText>
                        <div class="form-input">
                            <MudTextField T="string" @bind-Value="request.OutPlantGrade" Required="true" Variant="Variant.Outlined" />
                        </div>
                    </div>
                </MudItem>
                <MudItem xs="12" md="4">
                    <div class="form-horizontal-field">
                        <MudText class="form-label">规格 *</MudText>
                        <div class="form-input">
                            <MudTextField T="string" @bind-Value="request.OutSpecification" Required="true" Variant="Variant.Outlined" />
                        </div>
                    </div>
                </MudItem>
                <MudItem xs="12" md="3">
                    <div class="form-horizontal-field">
                        <MudText class="form-label">发出支数 *</MudText>
                        <div class="form-input">
                            <MudTextField T="int" @bind-Value="request.OutQuantity" Required="true" Variant="Variant.Outlined" />
                        </div>
                    </div>
                </MudItem>
                <MudItem xs="12" md="3">
                    <div class="form-horizontal-field">
                        <MudText class="form-label">发出重量(kg) *</MudText>
                        <div class="form-input">
                            <MudTextField T="decimal" @bind-Value="request.OutWeight" Required="true" Variant="Variant.Outlined" />
                        </div>
                    </div>
                </MudItem>
                <MudItem xs="12" md="6">
                    <div class="form-horizontal-field">
                        <MudText class="form-label">来源工单号</MudText>
                        <div class="form-input">
                            <MudTextField T="string" @bind-Value="request.SourceWorkOrderNo" HelperText="可选，追溯用料计划" Variant="Variant.Outlined" />
                        </div>
                    </div>
                </MudItem>
                <MudItem xs="12" md="12">
                    <div class="form-horizontal-field form-field-multiline">
                        <MudText class="form-label">备注</MudText>
                        <div class="form-input">
                            <MudTextField T="string" @bind-Value="request.Remark" Multiline="true" Lines="2" Variant="Variant.Outlined" />
                        </div>
                    </div>
                </MudItem>
            </MudGrid>

            <MudText Typo="Typo.subtitle1" Class="mb-4 mt-4 font-weight-bold">
                <MudIcon Icon="@Icons.Material.Filled.ListAlt" Size="Size.Small" Class="mr-1" />加工要求明细
                <MudButton Variant="Variant.Outlined" Size="Size.Small" Color="Color.Primary" OnClick="AddReturnItem" Class="ml-4">+ 添加</MudButton>
            </MudText>
            <MudTable Dense="true" Hover="true" Elevation="0" Items="@returnItems" ReadOnly="true">
                <HeaderContent>
                    <MudTh>序号</MudTh>
                    <MudTh>加工要求</MudTh>
                    <MudTh>物料分类</MudTh>
                    <MudTh>加工规格</MudTh>
                    <MudTh>状态说明</MudTh>
                    <MudTh>单价</MudTh>
                    <MudTh>金额</MudTh>
                    <MudTh>工单号</MudTh>
                    <MudTh>操作</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>@context.Sequence</MudTd>
                    <MudTd><MudTextField T="string" @bind-Value="context.ProcessType" Placeholder="加工要求" Dense="true" /></MudTd>
                    <MudTd><MudTextField T="string" @bind-Value="context.MaterialCategory" Placeholder="物料分类" Dense="true" /></MudTd>
                    <MudTd><MudTextField T="string" @bind-Value="context.ProcessSpecification" Placeholder="加工规格" Dense="true" /></MudTd>
                    <MudTd><MudTextField T="string" @bind-Value="context.ProcessStatusRemark" Placeholder="状态说明" Dense="true" /></MudTd>
                    <MudTd><MudTextField T="decimal?" @bind-Value="context.ProcessUnitPrice" Placeholder="单价" Dense="true" /></MudTd>
                    <MudTd><MudTextField T="decimal?" @bind-Value="context.ProcessTotalAmount" Placeholder="金额" Dense="true" /></MudTd>
                    <MudTd><MudTextField T="string" @bind-Value="context.SourceWorkOrderNo" Placeholder="工单号" Dense="true" /></MudTd>
                    <MudTd><MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" OnClick="() => RemoveReturnItem(context)" /></MudTd>
                </RowTemplate>
            </MudTable>
        </MudCardContent>
    </MudCard>
</MudContainer>

@code {
    private CreateSubcontractOrderRequest request = new() { OrderDate = DateTime.Today, ReturnDeadline = DateTime.Today.AddDays(60) };
    private string orderDateText = DateTime.Today.ToString("yyyy-MM-dd");
    private string returnDeadlineText = DateTime.Today.AddDays(60).ToString("yyyy-MM-dd");
    private List<SupplierProfileDto> suppliers = new();
    private List<CreateReturnItemRequest> returnItems = new();
    private bool isSubmitting;

    private class CreateReturnItemRequest
    {
        public int Sequence { get; set; }
        public string ProcessType { get; set; } = string.Empty;
        public string MaterialCategory { get; set; } = string.Empty;
        public string ProcessSpecification { get; set; } = string.Empty;
        public string? ProcessStatusRemark { get; set; }
        public decimal? ProcessUnitPrice { get; set; }
        public decimal? ProcessTotalAmount { get; set; }
        public string? SourceWorkOrderNo { get; set; }
    }

    protected override async Task OnInitializedAsync()
    {
        suppliers = await SupplierService.GetActiveAsync();
    }

    private void AddReturnItem()
    {
        returnItems.Add(new CreateReturnItemRequest { Sequence = returnItems.Count + 1 });
    }

    private void RemoveReturnItem(CreateReturnItemRequest item)
    {
        returnItems.Remove(item);
        for (int i = 0; i < returnItems.Count; i++)
            returnItems[i].Sequence = i + 1;
    }

    private async Task Save()
    {
        if (request.SupplierId <= 0) { Snackbar.Add("请选择供应商", Severity.Warning); return; }
        if (!DateTime.TryParse(orderDateText, out var orderDate)) { Snackbar.Add("下单日期格式错误，请使用 yyyy-MM-dd", Severity.Warning); return; }
        request.OrderDate = orderDate;
        if (!string.IsNullOrWhiteSpace(returnDeadlineText) && !DateTime.TryParse(returnDeadlineText, out var returnDeadline)) { Snackbar.Add("收回期限格式错误，请使用 yyyy-MM-dd", Severity.Warning); return; }
        if (!string.IsNullOrWhiteSpace(returnDeadlineText)) request.ReturnDeadline = DateTime.Parse(returnDeadlineText); else request.ReturnDeadline = null;
        if (string.IsNullOrWhiteSpace(request.OutMaterialCategory)) { Snackbar.Add("发出物料分类不能为空", Severity.Warning); return; }
        if (string.IsNullOrWhiteSpace(request.OutPlantGrade)) { Snackbar.Add("发出钢种不能为空", Severity.Warning); return; }
        if (string.IsNullOrWhiteSpace(request.OutSpecification)) { Snackbar.Add("发出规格不能为空", Severity.Warning); return; }
        if (request.OutQuantity <= 0) { Snackbar.Add("发出支数必须大于0", Severity.Warning); return; }
        if (request.OutWeight <= 0) { Snackbar.Add("发出重量必须大于0", Severity.Warning); return; }
        if (returnItems.Count == 0) { Snackbar.Add("请至少添加一条加工要求", Severity.Warning); return; }

        // Validate items
        var invalidItems = returnItems.Where(i => string.IsNullOrWhiteSpace(i.ProcessType) || string.IsNullOrWhiteSpace(i.MaterialCategory) || string.IsNullOrWhiteSpace(i.ProcessSpecification)).ToList();
        if (invalidItems.Any()) { Snackbar.Add("加工要求、物料分类、加工规格为必填", Severity.Warning); return; }

        isSubmitting = true; StateHasChanged();
        try
        {
            request.ReturnItems = returnItems.Select(i => new MES.Core.DTOs.CreateReturnItemRequest
            {
                ProcessType = i.ProcessType,
                MaterialCategory = i.MaterialCategory,
                ProcessSpecification = i.ProcessSpecification,
                ProcessStatusRemark = i.ProcessStatusRemark,
                ProcessUnitPrice = i.ProcessUnitPrice,
                ProcessTotalAmount = i.ProcessTotalAmount,
                SourceWorkOrderNo = i.SourceWorkOrderNo
            }).ToList();

            var result = await SubcontractService.CreateAsync(request);
            if (result.Success) { Snackbar.Add("创建成功", Severity.Success); Navigation.NavigateTo("/subcontract-orders"); }
            else { Snackbar.Add(result.Message ?? "创建失败", Severity.Error); }
        }
        catch (Exception ex) { Snackbar.Add($"创建失败: {ex.Message}", Severity.Error); }
        finally { isSubmitting = false; StateHasChanged(); }
    }

    private void GoBack() => Navigation.NavigateTo("/subcontract-orders");
}
