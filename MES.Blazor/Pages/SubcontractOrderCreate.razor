@page "/subcontract-orders/create"
@using MES.Blazor.Services
@using MES.Core.DTOs
@using Microsoft.AspNetCore.Authorization
@inject SubcontractOrderService SubcontractService
@inject SupplierService SupplierService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@attribute [Authorize(Roles = "MaterialStaff,MaterialDirector,Admin")]

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-4">
    <MudCard>
        <MudCardHeader>
            <CardHeaderContent>
                <MudText Typo="Typo.h5" Class="font-weight-bold"><MudIcon Icon="@Icons.Material.Filled.Handyman" Class="mr-2" Color="Color.Primary" />新建委外加工单</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">创建新的委外加工单，关联发出物料和加工要求</MudText>
            </CardHeaderContent>
            <CardHeaderActions>
                <MudButton Variant="Variant.Text" OnClick="GoBack">返回</MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Save" Disabled="@isSubmitting">
                    @if (isSubmitting) { <MudProgressCircular Size="Size.Small" Color="Color.Inherit" /> } else { <span>保存</span> }
                </MudButton>
            </CardHeaderActions>
        </MudCardHeader>
        <MudCardContent>
            <!-- ========== 1. 基本信息 ========== -->
            <MudText Typo="Typo.subtitle1" Class="mb-4 font-weight-bold"><MudIcon Icon="@Icons.Material.Filled.Info" Size="Size.Small" Class="mr-1" />基本信息</MudText>
            <div class="form-inline-row">
                <div class="form-inline-field">
                    <span class="form-label">供应商</span>
                    <div class="form-input-stack">
                        <div class="form-hidden-input form-input-required">
                            <MudSelect T="int" @bind-Value="request.SupplierId"
                                       Dense="true" Variant="Variant.Outlined" Size="Size.Small" Immediate="true">
                                @foreach (var s in suppliers) { <MudSelectItem Value="s.Id">@s.SupplierName</MudSelectItem> }
                            </MudSelect>
                        </div>
                    </div>
                </div>
                <div class="form-inline-field">
                    <span class="form-label">下单日期</span>
                    <div class="form-input-stack">
                        <div class="form-hidden-input form-input-required">
                            <MudTextField T="string"
                                          @bind-Value="orderDateText"
                                          Dense="true"
                                          Variant="Variant.Outlined"
                                          Size="Size.Small"
                                          Immediate="true" />
                        </div>
                    </div>
                </div>
                <div class="form-inline-field">
                    <span class="form-label">收回期限</span>
                    <div class="form-input-stack">
                        <div class="form-hidden-input">
                            <MudTextField T="string"
                                          @bind-Value="returnDeadlineText"
                                          Dense="true"
                                          Variant="Variant.Outlined"
                                          Size="Size.Small"
                                          Immediate="true" />
                        </div>
                    </div>
                </div>
            </div>

            <MudDivider Class="my-4" />

            <!-- ========== 2. 发出物料 ========== -->
            <MudText Typo="Typo.subtitle1" Class="mb-4 font-weight-bold"><MudIcon Icon="@Icons.Material.Filled.Output" Size="Size.Small" Class="mr-1" />发出物料</MudText>
            <div class="form-inline-row">
                <div class="form-inline-field">
                    <span class="form-label">物料分类</span>
                    <div class="form-input-stack">
                        <div class="form-hidden-input form-input-required">
                            <MudTextField T="string"
                                          @bind-Value="request.OutMaterialCategory"
                                          Dense="true"
                                          Variant="Variant.Outlined"
                                          Size="Size.Small"
                                          Immediate="true" />
                        </div>
                    </div>
                </div>
                <div class="form-inline-field">
                    <span class="form-label">厂内钢种</span>
                    <div class="form-input-stack">
                        <div class="form-hidden-input form-input-required">
                            <MudTextField T="string"
                                          @bind-Value="request.OutPlantGrade"
                                          Dense="true"
                                          Variant="Variant.Outlined"
                                          Size="Size.Small"
                                          Immediate="true" />
                        </div>
                    </div>
                </div>
                <div class="form-inline-field">
                    <span class="form-label">规格</span>
                    <div class="form-input-stack">
                        <div class="form-hidden-input form-input-required">
                            <MudTextField T="string"
                                          @bind-Value="request.OutSpecification"
                                          Dense="true"
                                          Variant="Variant.Outlined"
                                          Size="Size.Small"
                                          Immediate="true" />
                        </div>
                    </div>
                </div>
            </div>
            <div class="form-inline-row mt-3">
                <div class="form-inline-field">
                    <span class="form-label">发出支数</span>
                    <div class="form-input-stack">
                        <div class="form-hidden-input form-input-required">
                            <MudTextField T="int"
                                          @bind-Value="request.OutQuantity"
                                          Dense="true"
                                          Variant="Variant.Outlined"
                                          Size="Size.Small"
                                          Immediate="true" />
                        </div>
                    </div>
                </div>
                <div class="form-inline-field">
                    <span class="form-label">发出重量(kg)</span>
                    <div class="form-input-stack">
                        <div class="form-hidden-input form-input-required">
                            <MudTextField T="decimal"
                                          @bind-Value="request.OutWeight"
                                          Dense="true"
                                          Variant="Variant.Outlined"
                                          Size="Size.Small"
                                          Immediate="true" />
                        </div>
                    </div>
                </div>
                <div class="form-inline-field">
                    <span class="form-label">来源工单号</span>
                    <div class="form-input-stack">
                        <div class="form-hidden-input">
                            <MudTextField T="string"
                                          @bind-Value="request.SourceWorkOrderNo"
                                          Dense="true"
                                          Variant="Variant.Outlined"
                                          Size="Size.Small"
                                          Immediate="true" />
                        </div>
                    </div>
                </div>
            </div>
            <div class="form-inline-row mt-3">
                <div class="form-inline-field" style="flex: 2;">
                    <span class="form-label">备注</span>
                    <div class="form-input-stack" style="width: 100%;">
                        <div class="form-hidden-input">
                            <MudTextField T="string"
                                          @bind-Value="request.Remark"
                                          Dense="true"
                                          Variant="Variant.Outlined"
                                          Size="Size.Small"
                                          Immediate="true" />
                        </div>
                    </div>
                </div>
            </div>

            <MudDivider Class="my-4" />

            <!-- ========== 3. 加工要求明细 ========== -->
            <MudText Typo="Typo.subtitle1" Class="mb-4 font-weight-bold">
                <MudIcon Icon="@Icons.Material.Filled.ListAlt" Size="Size.Small" Class="mr-1" />加工要求明细
                <MudButton Variant="Variant.Outlined" Size="Size.Small" Color="Color.Primary" OnClick="AddReturnItem" Class="ml-4">+ 添加</MudButton>
            </MudText>
            <div style="overflow-x: auto;">
                <MudTable Dense="true" Hover="true" Elevation="0" Items="@returnItems">
                    <HeaderContent>
                        <MudTh Style="width: 50px;">序号</MudTh>
                        <MudTh Style="min-width: 120px;">加工要求</MudTh>
                        <MudTh Style="min-width: 120px;">物料分类</MudTh>
                        <MudTh Style="min-width: 120px;">加工规格</MudTh>
                        <MudTh Style="min-width: 120px;">状态说明</MudTh>
                        <MudTh Style="width: 100px;">单价</MudTh>
                        <MudTh Style="width: 100px;">金额</MudTh>
                        <MudTh Style="min-width: 120px;">工单号</MudTh>
                        <MudTh Style="width: 60px;">操作</MudTh>
                    </HeaderContent>
                    <RowTemplate Context="item">
                        <MudTd><MudText Typo="Typo.body2">@item.Sequence</MudText></MudTd>
                        <MudTd><MudTextField T="string" @bind-Value="item.ProcessType" Placeholder="加工要求" Dense="true" Variant="Variant.Outlined" Size="Size.Small" Immediate="true" /></MudTd>
                        <MudTd><MudTextField T="string" @bind-Value="item.MaterialCategory" Placeholder="物料分类" Dense="true" Variant="Variant.Outlined" Size="Size.Small" Immediate="true" /></MudTd>
                        <MudTd><MudTextField T="string" @bind-Value="item.ProcessSpecification" Placeholder="加工规格" Dense="true" Variant="Variant.Outlined" Size="Size.Small" Immediate="true" /></MudTd>
                        <MudTd><MudTextField T="string" @bind-Value="item.ProcessStatusRemark" Placeholder="状态说明" Dense="true" Variant="Variant.Outlined" Size="Size.Small" Immediate="true" /></MudTd>
                        <MudTd><MudTextField T="string" @bind-Value="item.UnitPriceStr" Placeholder="单价" Dense="true" Variant="Variant.Outlined" Size="Size.Small" Style="width: 80px;" Immediate="true" /></MudTd>
                        <MudTd><MudTextField T="string" @bind-Value="item.TotalAmountStr" Placeholder="金额" Dense="true" Variant="Variant.Outlined" Size="Size.Small" Style="width: 80px;" Immediate="true" /></MudTd>
                        <MudTd><MudTextField T="string" @bind-Value="item.SourceWorkOrderNo" Placeholder="工单号" Dense="true" Variant="Variant.Outlined" Size="Size.Small" Immediate="true" /></MudTd>
                        <MudTd><MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" OnClick="() => RemoveReturnItem(item)" /></MudTd>
                    </RowTemplate>
                </MudTable>
            </div>
        </MudCardContent>
    </MudCard>
</MudContainer>

@code {
    private CreateSubcontractOrderRequest request = new() { OrderDate = DateTime.Today, ReturnDeadline = DateTime.Today.AddDays(60) };
    private string orderDateText = DateTime.Today.ToString("yyyy-MM-dd");
    private string returnDeadlineText = DateTime.Today.AddDays(60).ToString("yyyy-MM-dd");
    private List<SupplierProfileDto> suppliers = new();
    private List<ReturnItemRow> returnItems = new();
    private bool isSubmitting;

    private class ReturnItemRow
    {
        public int Sequence { get; set; }
        public string ProcessType { get; set; } = string.Empty;
        public string MaterialCategory { get; set; } = string.Empty;
        public string ProcessSpecification { get; set; } = string.Empty;
        public string? ProcessStatusRemark { get; set; }
        public string UnitPriceStr { get; set; } = string.Empty;
        public string TotalAmountStr { get; set; } = string.Empty;
        public string? SourceWorkOrderNo { get; set; }

        public decimal? UnitPrice => decimal.TryParse(UnitPriceStr, out var v) ? v : null;
        public decimal? TotalAmount => decimal.TryParse(TotalAmountStr, out var v) ? v : null;
    }

    protected override async Task OnInitializedAsync()
    {
        suppliers = await SupplierService.GetActiveAsync();
    }

    private void AddReturnItem()
    {
        returnItems.Add(new ReturnItemRow { Sequence = returnItems.Count + 1 });
    }

    private void RemoveReturnItem(ReturnItemRow item)
    {
        returnItems.Remove(item);
        for (int i = 0; i < returnItems.Count; i++)
            returnItems[i].Sequence = i + 1;
    }

    private async Task Save()
    {
        var errors = new List<string>();

        if (request.SupplierId <= 0) errors.Add("请选择供应商");
        if (!DateTime.TryParse(orderDateText, out var orderDate)) errors.Add("下单日期格式错误，请使用 yyyy-MM-dd");
        else request.OrderDate = orderDate;
        if (!string.IsNullOrWhiteSpace(returnDeadlineText))
        {
            if (!DateTime.TryParse(returnDeadlineText, out var returnDeadline)) errors.Add("收回期限格式错误，请使用 yyyy-MM-dd");
            else request.ReturnDeadline = returnDeadline;
        }
        else request.ReturnDeadline = null;
        if (string.IsNullOrWhiteSpace(request.OutMaterialCategory)) errors.Add("发出物料分类不能为空");
        if (string.IsNullOrWhiteSpace(request.OutPlantGrade)) errors.Add("发出钢种不能为空");
        if (string.IsNullOrWhiteSpace(request.OutSpecification)) errors.Add("发出规格不能为空");
        if (request.OutQuantity <= 0) errors.Add("发出支数必须大于0");
        if (request.OutWeight <= 0) errors.Add("发出重量必须大于0");
        if (returnItems.Count == 0) errors.Add("请至少添加一条加工要求");

        var invalidItems = returnItems.Where(i => string.IsNullOrWhiteSpace(i.ProcessType) || string.IsNullOrWhiteSpace(i.MaterialCategory) || string.IsNullOrWhiteSpace(i.ProcessSpecification)).ToList();
        if (invalidItems.Any()) errors.Add("加工要求、物料分类、加工规格为必填");

        if (errors.Any()) { Snackbar.Add(string.Join("；", errors), Severity.Warning); return; }

        isSubmitting = true; StateHasChanged();
        try
        {
            request.ReturnItems = returnItems.Select(i => new MES.Core.DTOs.CreateReturnItemRequest
            {
                ProcessType = i.ProcessType,
                MaterialCategory = i.MaterialCategory,
                ProcessSpecification = i.ProcessSpecification,
                ProcessStatusRemark = i.ProcessStatusRemark,
                ProcessUnitPrice = i.UnitPrice,
                ProcessTotalAmount = i.TotalAmount,
                SourceWorkOrderNo = i.SourceWorkOrderNo
            }).ToList();

            var result = await SubcontractService.CreateAsync(request);
            if (result.Success) { Snackbar.Add("创建成功", Severity.Success); Navigation.NavigateTo("/subcontract-orders"); }
            else { Snackbar.Add(result.Message ?? "创建失败", Severity.Error); }
        }
        catch (Exception ex) { Snackbar.Add($"创建失败: {ex.Message}", Severity.Error); }
        finally { isSubmitting = false; StateHasChanged(); }
    }

    private void GoBack() => Navigation.NavigateTo("/subcontract-orders");
}
