@page "/subcontract-orders/create"
@using MES.Blazor.Services
@using MES.Blazor.Shared
@using MES.Blazor.Helpers
@using MES.Core.DTOs
@using Microsoft.AspNetCore.Authorization
@inject SubcontractOrderService SubcontractService
@inject PurchaseOrderService PurchaseService
@inject SupplierService SupplierService
@inject MaterialService MaterialService
@inject WorkOrderService WorkOrderService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject IJSRuntime JS
@attribute [Authorize(Roles = "MaterialStaff,MaterialDirector,Admin")]

<MudContainer MaxWidth="MaxWidth.False" Class="mt-4">
    <MudCard>
        <MudCardHeader>
            <CardHeaderContent>
                <MudText Typo="Typo.h5" Class="font-weight-bold"><MudIcon Icon="@Icons.Material.Filled.Handyman" Class="mr-2" Color="Color.Primary" />新建委外加工单</MudText>
            </CardHeaderContent>
            <CardHeaderActions>
                <MudButton Variant="Variant.Text" OnClick="GoBack">返回</MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Save" Loading="@isSubmitting">
                    保存
                </MudButton>
            </CardHeaderActions>
        </MudCardHeader>

        <MudCardContent>
            @* ========== 工单用料计划执行状态（采购+委外总览） ========== *@
            @if (procurementStatusLoaded)
            {
                var noneCount = procurementItems.Count(x => x.StatusText == "未采购");
                var partialCount = procurementItems.Count(x => x.StatusText == "部分采购");
                <MudPaper Class="pa-3 mb-3" Elevation="0" Style="border: 1px solid #e0e0e0; border-radius: 8px;">
                    <div Class="d-flex align-center" style="cursor: pointer;" @onclick="ToggleProcurementStatus">
                        <MudIcon Icon="@Icons.Material.Filled.Info" Color="Color.Info" Class="mr-2" />
                        <MudText Typo="Typo.body1" Class="font-weight-bold flex-grow-1">工单用料计划执行状态</MudText>
                        @if (!string.IsNullOrEmpty(procurementStatusError))
                        {
                            <MudChip Size="Size.Small" Color="Color.Error" Class="mr-1">加载失败</MudChip>
                        }
                        else if (procurementItems.Count == 0)
                        {
                            <MudChip Size="Size.Small" Color="Color.Default" Class="mr-1">暂无待处理</MudChip>
                        }
                        else
                        {
                            <MudChip Size="Size.Small" Color="Color.Error" Class="mr-1">未采购 @noneCount</MudChip>
                            <MudChip Size="Size.Small" Color="Color.Warning" Class="mr-1">部分采购 @partialCount</MudChip>
                        }
                        <MudIcon Icon="@(showProcurementStatus ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)" Color="Color.Default" />
                    </div>
                    @if (showProcurementStatus)
                    {
                        if (!string.IsNullOrEmpty(procurementStatusError))
                        {
                            <MudText Typo="Typo.body2" Color="Color.Error" Class="mt-2">获取状态失败：@procurementStatusError</MudText>
                        }
                        else if (procurementItems.Count == 0)
                        {
                        }
                        else
                        {
                            <div style="overflow-x: auto; overflow-y: auto; margin-top: 8px; max-height: 25vh;">
                                <MudTable T="ProcurementStatusDto" Items="@procurementItems" Dense="true" Hover="true" Elevation="0" Class="auto-table">
                                    <HeaderContent>
                                        <MudTh Style="width: 120px;">工单号</MudTh>
                                        <MudTh Style="width: 90px;">物料分类</MudTh>
                                        <MudTh Style="width: 100px;" Class="text-right">计划总量(kg)</MudTh>
                                        <MudTh Style="width: 100px;" Class="text-right">已采购(kg)</MudTh>
                                        <MudTh Style="width: 100px;" Class="text-right">已委外(kg)</MudTh>
                                        <MudTh Style="width: 100px;" Class="text-right">合计(kg)</MudTh>
                                        <MudTh Style="width: 90px;">状态</MudTh>
                                    </HeaderContent>
                                    <RowTemplate>
                                        <MudTd>
                                            <MudText Style="cursor: pointer; color: #1976D2;" @onclick="@(() => AddFromProcurement(context))">
                                                @context.WorkOrderNo
                                            </MudText>
                                        </MudTd>
                                        <MudTd>@context.MaterialCategory</MudTd>
                                        <MudTd Class="text-right">@context.PlanWeight.ToString("G29")</MudTd>
                                        <MudTd Class="text-right">@context.PurchaseWeight.ToString("G29")</MudTd>
                                        <MudTd Class="text-right">@context.SubcontractWeight.ToString("G29")</MudTd>
                                        <MudTd Class="text-right">@context.TotalWeight.ToString("G29")</MudTd>
                                        <MudTd>
                                            <MudChip Size="Size.Small" Color="@(context.StatusText == "未采购" ? Color.Error : Color.Warning)">
                                                @context.StatusText
                                            </MudChip>
                                        </MudTd>
                                    </RowTemplate>
                                </MudTable>
                            </div>
                        }
                    }
                </MudPaper>
            }

            @* ========== 1. 公共信息 ========== *@
            <MudText Typo="Typo.subtitle1" Class="mb-4 font-weight-bold"><MudIcon Icon="@Icons.Material.Filled.Info" Size="Size.Small" Class="mr-1" />公共信息</MudText>
            <MudSimpleTable Class="mud-table-dense auto-table">
                <thead>
                    <tr>
                        <th>下单日期<span class="required-star">*</span></th>
                        <th>加工类型<span class="required-star">*</span></th>
                        <th>物料分类<span class="required-star">*</span></th>
                        <th>炉号</th>
                        <th>工厂牌号<span class="required-star">*</span></th>
                        <th>规格<span class="required-star">*</span></th>
                        <th>发出支数</th>
                        <th>发出重量<span class="required-star">*</span></th>
                        <th>供应商<span class="required-star">*</span></th>
                        <th>收回期限<span class="required-star">*</span></th>
                        <th>备注</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td><MudTextField T="string" @bind-Value="orderDateText" Dense="true" Variant="Variant.Outlined" Size="Size.Small"Placeholder="yyyy-MM-dd" Margin="Margin.Dense" /></td>
                        <td><MudTextField T="string" @bind-Value="processType" Dense="true" Variant="Variant.Outlined" Size="Size.Small"Margin="Margin.Dense" /></td>
                        <td><MudTextField T="string" @bind-Value="outMaterialCategory" Dense="true" Variant="Variant.Outlined" Size="Size.Small"Margin="Margin.Dense" /></td>
                        <td><MudTextField T="string" @bind-Value="furnaceNumber" Dense="true" Variant="Variant.Outlined" Size="Size.Small"Margin="Margin.Dense" /></td>
                        <td><MudTextField T="string" @bind-Value="outPlantGrade" Dense="true" Variant="Variant.Outlined" Size="Size.Small"Margin="Margin.Dense" /></td>
                        <td><MudTextField T="string" @bind-Value="outSpecification" Dense="true" Variant="Variant.Outlined" Size="Size.Small"Margin="Margin.Dense" /></td>
                        <td><MudTextField T="string" @bind-Value="outQuantityStr" Dense="true" Variant="Variant.Outlined" Size="Size.Small"Margin="Margin.Dense" /></td>
                        <td><MudTextField T="string" @bind-Value="outWeightStr" Dense="true" Variant="Variant.Outlined" Size="Size.Small"Margin="Margin.Dense" /></td>
                        <td>
                            <MudAutocomplete T="SupplierProfileDto"
                                             Value="@selectedSupplier"
                                             ValueChanged="@(v => { selectedSupplier = v; if (v != null) supplierName = v.SupplierName; })"
                                             Text="@supplierName"
                                             TextChanged="@(t => { if (selectedSupplier == null) supplierName = t ?? string.Empty; })"
                                             SearchFunc="@FilterSuppliers"
                                             ToStringFunc="@FormatSupplier"
                                             Dense="true" Variant="Variant.Outlined" Size="Size.Small"
                                            Clearable="true" Margin="Margin.Dense" />
                        </td>
                        <td><MudTextField T="string" @bind-Value="returnDeadlineText" Dense="true" Variant="Variant.Outlined" Size="Size.Small"Placeholder="yyyy-MM-dd" Margin="Margin.Dense" /></td>
                        <td><MudTextField T="string" @bind-Value="remark" Dense="true" Variant="Variant.Outlined" Size="Size.Small"Multiline="true" Lines="1" Margin="Margin.Dense" /></td>
                    </tr>
                </tbody>
            </MudSimpleTable>

            <MudDivider Class="my-4" />

            @* ========== 3. 明细数据 — 加工要求明细 ========== *@
            <MudText Typo="Typo.subtitle1" Class="mb-4 font-weight-bold">
                <MudIcon Icon="@Icons.Material.Filled.ListAlt" Size="Size.Small" Class="mr-1" />加工要求明细
                <MudButton Variant="Variant.Outlined" Size="Size.Small" Color="Color.Primary" OnClick="AddReturnItem" Class="ml-4">+ 添加</MudButton>
            </MudText>

            <div id="subcontract-create-table"><div style="overflow-x: auto;">
                    <MudTable T="ReturnItemRow" Items="@returnItems" Dense="true" Hover="true" Elevation="0" Class="auto-table">
                        <HeaderContent>
                            <MudTh Style="width: 40px;">行号</MudTh>
                            <MudTh Style="width: 100px;">来源工单号</MudTh>
                            <MudTh Style="width: 100px;">物料分类<span class="required-star">*</span></MudTh>
                            <MudTh Style="width: 90px;">工厂牌号</MudTh>
                            <MudTh Style="width: 100px;">加工规格<span class="required-star">*</span></MudTh>
                            <MudTh Style="width: 70px;">单重</MudTh>
                            <MudTh Style="width: 70px;">需求支数</MudTh>
                            <MudTh Style="width: 80px;">需求重量</MudTh>
                            <MudTh Style="width: 100px;">状态说明</MudTh>
                            <MudTh Style="width: 100px;">备注</MudTh>
                            <MudTh Style="width: 70px;">单价</MudTh>
                            <MudTh Style="width: 70px;">金额</MudTh>
                            <MudTh Style="width: 50px;">操作</MudTh>
                        </HeaderContent>
                        <RowTemplate Context="item">
                            <MudTd><MudText Typo="Typo.body2">@item.Sequence</MudText></MudTd>
                            <MudTd>
                                <div style="display: flex; align-items: center; gap: 4px;">
                                    <MudTextField T="string" @bind-Value="item.SourceWorkOrderNo" Dense="true" Variant="Variant.Outlined" Size="Size.Small"/>
                                    <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Info" OnClick="() => ToggleWorkOrderInfo(item)">
                                        @(item.ShowWorkOrderInfo ? "隐藏" : "展示")
                                    </MudButton>
                                </div>
                                @if (item.ShowWorkOrderInfo)
                                {
                                    <div style="margin-top: 4px; padding: 6px; border: 1px solid #e8e8e8; border-radius: 4px; background: #fafafa; font-size: 0.7rem; line-height: 1.4;">
                                        @if (item.WorkOrderLoading)
                                        {
                                            <MudProgressCircular Size="Size.Small" Indeterminate Class="my-1" />
                                        }
                                        else if (item.WorkOrderInfo != null)
                                        {
                                            <div><strong>工单号：</strong>@item.WorkOrderInfo.WorkOrderNo</div>
                                            <div><strong>订单号：</strong>@item.WorkOrderInfo.SalesOrderNo</div>
                                            <div><strong>主号/次号：</strong>@item.WorkOrderInfo.ProductionMainNo@(!string.IsNullOrEmpty(item.WorkOrderInfo.ProductionSubNo) ? "/" + item.WorkOrderInfo.ProductionSubNo : "")</div>
                                            <div><strong>厂内牌号：</strong>@item.WorkOrderInfo.PlantGrade</div>
                                            <div><strong>规格：</strong>@item.WorkOrderInfo.Specification</div>
                                            <div><strong>交货状态：</strong>@DisplayHelper.GetDeliveryStateText(item.WorkOrderInfo.DeliveryState)</div>
                                            <div><strong>交货日期：</strong>@item.WorkOrderInfo.DeliveryDate.ToString("yyyy-MM-dd")</div>
                                            <div><strong>数量/重量：</strong>@item.WorkOrderInfo.TotalQuantity 支 / @item.WorkOrderInfo.TotalWeight kg</div>
                                        }
                                        else
                                        {
                                            <span style="color: #999;">无此工单</span>
                                        }
                                    </div>
                                }
                            </MudTd>
                            <MudTd><MudTextField T="string" @bind-Value="item.MaterialCategory" Dense="true" Variant="Variant.Outlined" Size="Size.Small"/></MudTd>
                            <MudTd><MudTextField T="string" @bind-Value="item.PlantGrade" Dense="true" Variant="Variant.Outlined" Size="Size.Small"/></MudTd>
                            <MudTd><MudTextField T="string" @bind-Value="item.ProcessSpecification" Dense="true" Variant="Variant.Outlined" Size="Size.Small"/></MudTd>
                            <MudTd><MudTextField T="string" @bind-Value="item.UnitWeightStr" Dense="true" Variant="Variant.Outlined" Size="Size.Small" Style="width: 60px;"/></MudTd>
                            <MudTd><MudTextField T="string" @bind-Value="item.RequiredQuantityStr" Dense="true" Variant="Variant.Outlined" Size="Size.Small" Style="width: 60px;"/></MudTd>
                            <MudTd><MudTextField T="string" @bind-Value="item.RequiredWeightStr" Dense="true" Variant="Variant.Outlined" Size="Size.Small" Style="width: 70px;"/></MudTd>
                            <MudTd><MudTextField T="string" @bind-Value="item.ProcessStatusRemark" Dense="true" Variant="Variant.Outlined" Size="Size.Small"/></MudTd>
                            <MudTd><MudTextField T="string" @bind-Value="item.Remark" Dense="true" Variant="Variant.Outlined" Size="Size.Small"/></MudTd>
                            <MudTd><MudTextField T="string" @bind-Value="item.UnitPriceStr" Dense="true" Variant="Variant.Outlined" Size="Size.Small" Style="width: 60px;"/></MudTd>
                            <MudTd><MudTextField T="string" @bind-Value="item.TotalAmountStr" Dense="true" Variant="Variant.Outlined" Size="Size.Small" Style="width: 60px;"/></MudTd>
                            <MudTd><MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" OnClick="() => RemoveReturnItem(item)" /></MudTd>
                        </RowTemplate>
                    </MudTable>
                </div></div>
        </MudCardContent>
    </MudCard>
</MudContainer>

@code {
    private List<ReturnItemRow> returnItems = new();
    private bool isSubmitting;
    private bool _isArrowNavSetup;

    // 公共数据 — 基本信息
    private SupplierProfileDto? selectedSupplier;
    private string supplierName = string.Empty;
    private string orderDateText = DateTime.Today.ToString("yyyy-MM-dd");
    private string processType = string.Empty;
    private string returnDeadlineText = string.Empty;
    private string? remark;

    // 公共数据 — 发出物料
    private string outMaterialCategory = string.Empty;
    private string? furnaceNumber;
    private string outPlantGrade = string.Empty;
    private string outSpecification = string.Empty;
    private string outQuantityStr = string.Empty;
    private string outWeightStr = string.Empty;

    // 供应商 + 采购执行状态
    private List<SupplierProfileDto> allSuppliers = new();
    private List<ProcurementStatusDto> procurementItems = new();
    private bool showProcurementStatus;
    private bool procurementStatusLoaded;
    private string? procurementStatusError;

    private class ReturnItemRow
    {
        public int Sequence { get; set; }
        public string MaterialCategory { get; set; } = string.Empty;
        public string? PlantGrade { get; set; }
        public string ProcessSpecification { get; set; } = string.Empty;
        public string UnitWeightStr { get; set; } = string.Empty;
        public string RequiredQuantityStr { get; set; } = string.Empty;
        public string RequiredWeightStr { get; set; } = string.Empty;
        public string? ProcessStatusRemark { get; set; }
        public string? Remark { get; set; }
        public string? SourceWorkOrderNo { get; set; }
        public string UnitPriceStr { get; set; } = string.Empty;
        public string TotalAmountStr { get; set; } = string.Empty;
        public bool ShowWorkOrderInfo { get; set; }
        public bool WorkOrderLoading { get; set; }
        public WorkOrderDetailDto? WorkOrderInfo { get; set; }

        public decimal? UnitWeight => decimal.TryParse(UnitWeightStr, out var v) ? v : null;
        public int? RequiredQuantity => int.TryParse(RequiredQuantityStr, out var v) ? v : null;
        public decimal? RequiredWeight => decimal.TryParse(RequiredWeightStr, out var v) ? v : null;
        public decimal? UnitPrice => decimal.TryParse(UnitPriceStr, out var v) ? v : null;
        public decimal? TotalAmount => decimal.TryParse(TotalAmountStr, out var v) ? v : null;
    }

    protected override async Task OnInitializedAsync()
    {
        allSuppliers = await SupplierService.GetActiveAsync();
        try
        {
            var statusResult = await PurchaseService.GetProcurementStatusAsync();
            if (statusResult.Success && statusResult.Data != null)
                procurementItems = statusResult.Data;
            else
                procurementStatusError = statusResult.Message ?? "未知错误";
        }
        catch (Exception ex)
        {
            procurementStatusError = ex.Message;
        }
        procurementStatusLoaded = true;
    }

    private void ToggleProcurementStatus() => showProcurementStatus = !showProcurementStatus;

    private string FormatSupplier(SupplierProfileDto? s) =>
        s == null ? "" : $"{s.MaterialCategory} - {s.SupplierName}";

    private Task<IEnumerable<SupplierProfileDto>> FilterSuppliers(string search)
    {
        var query = allSuppliers.AsEnumerable();
        var category = GetActiveMaterialCategory();
        if (!string.IsNullOrWhiteSpace(category))
            query = query.Where(s => s.MaterialCategory != null &&
                s.MaterialCategory.Equals(category, StringComparison.OrdinalIgnoreCase));
        if (!string.IsNullOrWhiteSpace(search))
            query = query.Where(s => s.SupplierName.Contains(search, StringComparison.OrdinalIgnoreCase));
        return Task.FromResult(query.Take(30));
    }

    private void AddReturnItem()
    {
        returnItems.Add(new ReturnItemRow { Sequence = returnItems.Count + 1 });
    }

    private void RemoveReturnItem(ReturnItemRow item)
    {
        returnItems.Remove(item);
        for (int i = 0; i < returnItems.Count; i++)
            returnItems[i].Sequence = i + 1;
    }

    private async Task AddFromProcurement(ProcurementStatusDto item)
    {
        var result = await PurchaseService.GetPlanDetailAsync(item.WorkOrderNo, item.MaterialCategory ?? "");
        if (!result.Success || result.Data == null)
        {
            Snackbar.Add($"未找到工单 {item.WorkOrderNo} 的用料计划", Severity.Warning);
            return;
        }

        var plan = result.Data;
        returnItems.Add(new ReturnItemRow
        {
            Sequence = returnItems.Count + 1,
            SourceWorkOrderNo = plan.WorkOrderNo,
            MaterialCategory = plan.MaterialCategory,
            PlantGrade = plan.PlantGrade,
            ProcessSpecification = plan.Specification ?? string.Empty,
            UnitWeightStr = plan.UnitWeight?.ToString("G29") ?? string.Empty,
            RequiredQuantityStr = plan.Quantity?.ToString() ?? string.Empty,
            RequiredWeightStr = plan.Weight.ToString("G29"),
            Remark = plan.Remark
        });
        Snackbar.Add($"已添加工单 {plan.WorkOrderNo}（{plan.MaterialCategory}）", Severity.Success);
    }

    private string GetActiveMaterialCategory()
    {
        var categories = returnItems
            .Select(r => r.MaterialCategory)
            .Where(c => !string.IsNullOrWhiteSpace(c))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();
        if (categories.Count == 1) return categories[0];
        return outMaterialCategory;
    }

    private async Task ToggleWorkOrderInfo(ReturnItemRow item)
    {
        if (item.ShowWorkOrderInfo)
        {
            item.ShowWorkOrderInfo = false;
            return;
        }

        if (string.IsNullOrWhiteSpace(item.SourceWorkOrderNo))
        {
            Snackbar.Add("请先输入工单号", Severity.Warning);
            return;
        }

        item.ShowWorkOrderInfo = true;
        item.WorkOrderLoading = true;
        item.WorkOrderInfo = null;
        StateHasChanged();

        try
        {
            var result = await WorkOrderService.GetByWorkOrderNoAsync(item.SourceWorkOrderNo);
            if (result.Success && result.Data != null)
                item.WorkOrderInfo = result.Data;
        }
        catch { }
        finally
        {
            item.WorkOrderLoading = false;
            StateHasChanged();
        }
    }

    private async Task Save()
    {
        // ========== 验证 ==========
        var errors = new List<string>();

        if (selectedSupplier == null && string.IsNullOrWhiteSpace(supplierName))
            errors.Add("请选择供应商");
        else if (selectedSupplier == null && supplierName.Trim().Length < 2)
            errors.Add("供应商名称至少2个字符");
        if (!DateTime.TryParse(orderDateText, out var orderDate))
            errors.Add("下单日期格式错误，请使用 yyyy-MM-dd");
        if (!string.IsNullOrWhiteSpace(returnDeadlineText) && !DateTime.TryParse(returnDeadlineText, out _))
            errors.Add("收回期限格式错误，请使用 yyyy-MM-dd");
        else if (string.IsNullOrWhiteSpace(returnDeadlineText))
            errors.Add("收回期限不能为空");
        if (string.IsNullOrWhiteSpace(outMaterialCategory)) errors.Add("发出物料分类不能为空");
        if (string.IsNullOrWhiteSpace(processType)) errors.Add("加工类型不能为空");
        if (string.IsNullOrWhiteSpace(outPlantGrade)) errors.Add("发出钢种不能为空");
        if (string.IsNullOrWhiteSpace(outSpecification)) errors.Add("发出规格不能为空");
        if (!string.IsNullOrWhiteSpace(outQuantityStr) && (!int.TryParse(outQuantityStr, out var parsedQty) || parsedQty <= 0))
            errors.Add("发出支数必须大于0（非必填）");
        if (!decimal.TryParse(outWeightStr, out var outWgt) || outWgt <= 0) errors.Add("发出重量必须大于0");
        if (returnItems.Count == 0) errors.Add("请至少添加一条加工要求");

        var invalidItems = returnItems.Where(i => string.IsNullOrWhiteSpace(i.MaterialCategory) || string.IsNullOrWhiteSpace(i.ProcessSpecification)).ToList();
        if (invalidItems.Any()) errors.Add("物料分类、加工规格为必填");

        if (errors.Any()) { Snackbar.Add(string.Join("；", errors), Severity.Warning); return; }

        // ========== 物料匹配检测 ==========
        var unmatched = false;
        if (!string.IsNullOrWhiteSpace(outMaterialCategory) &&
            !string.IsNullOrWhiteSpace(outPlantGrade) &&
            !string.IsNullOrWhiteSpace(outSpecification))
        {
            var matchResult = await MaterialService.MatchAsync(outMaterialCategory, outPlantGrade, outSpecification);
            if (matchResult?.Data == null)
            {
                var dialog = DialogService.Show<ConfirmDialog>("物料档案匹配", new DialogParameters
                {
                    { "ContentText", $"发出物料（{outMaterialCategory}/{outPlantGrade}/{outSpecification}）未匹配到物料档案。\n\n是否继续保存并自动添加到物料档案？" },
                    { "ConfirmText", "继续保存" },
                    { "Color", Color.Warning }
                });
                var result = await dialog.Result;
                if (result.Canceled) { Snackbar.Add("已取消保存", Severity.Normal); return; }
                unmatched = true;
            }
        }

        // ========== 供应商解析 ==========
        int supplierId;
        if (selectedSupplier != null)
        {
            supplierId = selectedSupplier.Id;
        }
        else
        {
            // 按名称查找已有供应商
            var existing = allSuppliers.FirstOrDefault(s =>
                s.SupplierName.Equals(supplierName.Trim(), StringComparison.OrdinalIgnoreCase) &&
                (string.IsNullOrWhiteSpace(outMaterialCategory) ||
                 s.MaterialCategory == null ||
                 s.MaterialCategory.Equals(outMaterialCategory, StringComparison.OrdinalIgnoreCase)));
            if (existing != null)
            {
                supplierId = existing.Id;
            }
            else
            {
                // 自动创建新供应商
                try
                {
                    var createResult = await SupplierService.CreateAsync(new CreateSupplierRequest
                    {
                        SupplierName = supplierName.Trim(),
                        MaterialCategory = string.IsNullOrWhiteSpace(outMaterialCategory) ? null : outMaterialCategory,
                        IsActive = true
                    });
                    if (createResult.Success && createResult.Data != null)
                        supplierId = createResult.Data.Id;
                    else
                    {
                        Snackbar.Add($"创建供应商失败: {createResult.Message}", Severity.Error);
                        return;
                    }
                }
                catch (Exception ex)
                {
                    Snackbar.Add($"创建供应商失败: {ex.Message}", Severity.Error);
                    return;
                }
            }
        }

        // ========== 自动添加物料档案 ==========
        if (unmatched)
        {
            try
            {
                await MaterialService.CreateAsync(new CreateMaterialRequest
                {
                    MaterialCategory = outMaterialCategory,
                    PlantGrade = outPlantGrade,
                    Specification = outSpecification,
                    IsActive = true
                });
            }
            catch (Exception ex)
            {
                Snackbar.Add($"自动添加物料档案失败: {ex.Message}", Severity.Error);
                return;
            }
        }

        // ========== 构建请求 ==========
        isSubmitting = true; StateHasChanged();
        try
        {
            var request = new CreateSubcontractOrderRequest
            {
                SupplierId = supplierId,
                OrderDate = orderDate,
                ProcessType = processType,
                FurnaceNumber = string.IsNullOrWhiteSpace(furnaceNumber) ? null : furnaceNumber,
                ReturnDeadline = string.IsNullOrWhiteSpace(returnDeadlineText) ? null : DateTime.Parse(returnDeadlineText),
                OutMaterialCategory = outMaterialCategory,
                OutPlantGrade = outPlantGrade,
                OutSpecification = outSpecification,
                OutQuantity = string.IsNullOrWhiteSpace(outQuantityStr) ? 0 : int.Parse(outQuantityStr),
                OutWeight = outWgt,
                Remark = string.IsNullOrWhiteSpace(remark) ? null : remark,
                ReturnItems = returnItems.Select(i => new CreateReturnItemRequest
                {
                    MaterialCategory = i.MaterialCategory,
                    PlantGrade = i.PlantGrade,
                    ProcessSpecification = i.ProcessSpecification,
                    UnitWeight = i.UnitWeight,
                    RequiredQuantity = i.RequiredQuantity,
                    RequiredWeight = i.RequiredWeight,
                    ProcessStatusRemark = i.ProcessStatusRemark,
                    Remark = i.Remark,
                    SourceWorkOrderNo = i.SourceWorkOrderNo,
                    ProcessUnitPrice = i.UnitPrice,
                    ProcessTotalAmount = i.TotalAmount
                }).ToList()
            };

            var result = await SubcontractService.CreateAsync(request);
            if (result.Success)
            {
                Snackbar.Add("创建成功", Severity.Success);
                Navigation.NavigateTo("/subcontract-orders");
            }
            else
            {
                Snackbar.Add(result.Message ?? "创建失败", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"创建失败: {ex.Message}", Severity.Error);
        }
        finally
        {
            isSubmitting = false; StateHasChanged();
        }
    }

    private void GoBack() => Navigation.NavigateTo("/subcontract-orders");

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_isArrowNavSetup)
        {
            _isArrowNavSetup = true;
            if (!await JS.InvokeAsync<bool>("enableTableArrowNav", "#subcontract-create-table"))
                _isArrowNavSetup = false;
        }
    }
}
