@page "/warehouse"
@page "/warehouse/{Code}"
@using MES.Blazor.Services
@using MES.Core.DTOs
@using MES.Core.Models
@using MES.Blazor.Helpers
@using Microsoft.AspNetCore.Authorization
@inject WarehouseService WarehouseService
@inject InventoryService InventoryService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject ColumnPrefsService ColumnPrefs
@inject OutboundStateService OutboundState
@inject IJSRuntime JS
@attribute [Authorize]

@if (string.IsNullOrEmpty(Code))
{
    @* ======== 仓库首页：4个仓库卡片入口 ======== *@
    <MudContainer MaxWidth="MaxWidth.False" Class="mt-4 pl-0">
        <MudCard>
            <MudCardHeader>
                <CardHeaderContent>
                    <MudText Typo="Typo.h5" Class="font-weight-bold">
                        <MudIcon Icon="@Icons.Material.Filled.Warehouse" Class="mr-2" Color="Color.Primary" />
                        仓库管理
                    </MudText>
                </CardHeaderContent>
                <CardHeaderActions>
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.AddCircleOutline"
                               OnClick="NavigateToInboundFromHome">
                        入库
                    </MudButton>
                </CardHeaderActions>
            </MudCardHeader>
            <MudCardContent>
                <MudGrid>
                    @foreach (var wh in warehouses)
                    {
                        <MudItem xs="12" sm="6" md="3">
                            <MudCard Class="warehouse-card" Style="@GetCardStyle(wh.IsActive)"
                                     OnClick="() => NavigateToWarehouse(wh.Code)">
                                <MudCardContent Class="text-center pa-6">
                                    <MudIcon Icon="@GetWarehouseIcon(wh.Code)" Size="Size.Large" Color="Color.Primary" Class="mb-4" />
                                    <MudText Typo="Typo.h6" Class="font-weight-bold">@wh.Name</MudText>
                                    <MudText Typo="Typo.body2" Color="Color.Secondary">@wh.Code</MudText>
                                </MudCardContent>
                            </MudCard>
                        </MudItem>
                    }
                </MudGrid>
            </MudCardContent>
        </MudCard>
    </MudContainer>
}
else
{
    @* ======== 单个仓库详情页 ======== *@
    <MudContainer MaxWidth="MaxWidth.False" Class="mt-4 pl-0">
        <MudCard>
            <MudCardHeader>
                <CardHeaderContent>
                    <MudText Typo="Typo.h5" Class="font-weight-bold">
                        <MudIcon Icon="@GetWarehouseIcon(warehouseCode)" Class="mr-2" Color="Color.Primary" />
                        @warehouseName
                    </MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">库存批次列表</MudText>
                </CardHeaderContent>
                <CardHeaderActions>
                    <MudButton Variant="Variant.Text" Color="Color.Primary"
                               Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.History"
                               OnClick="NavigateToInboundHistory">
                        入库历史
                    </MudButton>
                    <MudButton Variant="Variant.Text" Color="Color.Warning"
                               Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.History"
                               OnClick="NavigateToOutboundHistory">
                        出库历史
                    </MudButton>
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.AddCircleOutline"
                               OnClick="NavigateToInbound">
                        入库
                    </MudButton>
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Info"
                               Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.Refresh"
                               OnClick="LoadWarehouseMismatches"
                               Class="ml-2">
                        即时更新
                    </MudButton>
                </CardHeaderActions>
            </MudCardHeader>

            <MudCardContent>
                <!-- 顶部：模糊搜索 + 出库筛选切换 -->
                <MudGrid Class="mb-2">
                    <MudItem xs="12" md="5">
                        <MudTextField T="string"
                                      Value="_searchKeyword"
                                      ValueChanged="@OnSearchChanged"
                                      Label="模糊搜索"
                                      Variant="Variant.Outlined"
                                      Dense="true"
                                      Immediate="true"
                                      DebounceInterval="500"
                                      Clearable="true"
                                      ClearButton="true"
                                      Adornment="Adornment.Start"
                                      AdornmentIcon="@Icons.Material.Filled.Search" />
                    </MudItem>
                    <MudItem xs="12" md="7" Class="d-flex align-center justify-end">
                        <MudButton Variant="@(_outboundMode ? Variant.Filled : Variant.Outlined)"
                                   Color="Color.Warning"
                                   StartIcon="@Icons.Material.Filled.FilterList"
                                   OnClick="ToggleOutboundMode"
                                   Size="Size.Small"
                                   Class="mr-2">
                            @if (_outboundMode)
                            {
                                <span>退出筛选</span>
                            }
                            else
                            {
                                <span>出库筛选</span>
                            }
                        </MudButton>
                        @if (_outboundMode)
                        {
                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Warning"
                                       StartIcon="@Icons.Material.Filled.ExitToApp"
                                       Disabled="@(_selectedItems.Count == 0)"
                                       OnClick="NavigateToOutbound"
                                       Size="Size.Small">
                                批量出库 (@_selectedItems.Count)
                            </MudButton>
                        }
                    </MudItem>
                </MudGrid>

                <!-- 数据表格 -->
                <div style="overflow-x:auto; max-width:100%;">
                <MudTable @ref="table"
                          T="InventoryBatchDto"
                          Items="@_filteredItems"
                          Dense="true"
                          Hover="true"
                          Class="auto-table"
                          Elevation="0"
                          RowsPerPage="10"
                          RowsPerPageLabel="每页行数:"
                          Striped="true"
                          MultiSelection="true"
                          @bind-SelectedItems="_selectedItems">
                    <ToolBarContent>
                        <ColumnDisplaySelect Columns="_allColumns"
                                             OnColumnToggle="OnColumnToggle"
                                             OnMoveUp="MoveColumnUp"
                                             OnMoveDown="MoveColumnDown" />
                        <MudButton Variant="Variant.Text" Size="Size.Small"
                                   Color="Color.Default"
                                   StartIcon="@Icons.Material.Filled.RestartAlt"
                                   OnClick="ResetColumnDisplay" Class="ml-2">
                            重置
                        </MudButton>
                        <MudSpacer />
                        <MudButton Variant="Variant.Outlined" Size="Size.Small"
                                   Color="Color.Info"
                                   StartIcon="@Icons.Material.Filled.Print"
                                   Disabled="@(!_selectedItems.Any())"
                                   OnClick="PrintSelected" Class="mr-1">
                            打印选中 (@_selectedItems.Count)
                        </MudButton>
                        <MudButton Variant="Variant.Text" Size="Size.Small"
                                   Color="Color.Info"
                                   StartIcon="@Icons.Material.Filled.Print"
                                   OnClick="PrintAll" Class="mr-4">
                            打印全部
                        </MudButton>
                        @if (_outboundMode)
                        {
                            <MudText Typo="Typo.body2" Class="d-flex align-center" Style="color: var(--mud-palette-warning);">
                                已选 @_selectedItems.Count 项
                            </MudText>
                        }
                    </ToolBarContent>
                    <HeaderContent>
                        @foreach (var col in _visibleColumns)
                        {
                            <MudTh>
                                <div style="display:inline-flex; align-items:center; gap:4px;">
                                    <span class="th-label">@col.Label</span>
                                    @if (col.FilterType != null)
                                    {
                                        <ExcelFilter T="InventoryBatchDto"
                                                     Label="@col.Label"
                                                     FieldKey="@col.Key"
                                                     AllItems="@_allItems"
                                                     ActiveFilterValues="@(_columnFilters.GetValueOrDefault(col.Key))"
                                                     DisplaySelector="@(x => GetCellDisplayText(x, col.Key))"
                                                     RawValueSelector="@(x => GetCellRawValue(x, col.Key))"
                                                     FilterChanged="@(args => OnColumnFilterChanged(args.fieldKey, args.selectedValues))"
                                                     SortRequested="@(args => OnExcelSortRequested(args.fieldKey, args.ascending))" />
                                    }
                                </div>
                            </MudTh>
                        }
                    </HeaderContent>
                    <RowTemplate Context="item">
                        @foreach (var col in _visibleColumns)
                        {
                            <MudTd>@RenderCell(item, col)</MudTd>
                        }
                    </RowTemplate>
                    <PagerContent>
                        <MudText Typo="Typo.body2" Class="d-flex align-center mr-auto">共 @(_filteredItems?.Count ?? 0) 条记录</MudText>
                        <MudTablePager PageSizeOptions="new int[]{10,15,25,50,100}" />
                    </PagerContent>
                    <NoRecordsContent>
                        <MudText Class="d-flex justify-center pa-4" Color="Color.Secondary">暂无数据</MudText>
                    </NoRecordsContent>
                </MudTable>
                </div>
            </MudCardContent>
        </MudCard>
    </MudContainer>
}

@code {
    [Parameter]
    public string? Code { get; set; }

    private MudTable<InventoryBatchDto>? table;
    private List<InventoryBatchDto> _allItems = new();
    private List<InventoryBatchDto>? _filteredItemsList;
    private List<InventoryBatchDto> _filteredItems => _filteredItemsList ?? _allItems;
    private List<WarehouseDto> warehouses = new();

    // 当前仓库信息
    private string warehouseCode = string.Empty;
    private string warehouseName = string.Empty;
    private int warehouseId;

    // 出库模式
    private bool _outboundMode;

    // 关键字搜索
    private string _searchKeyword = string.Empty;

    // 排序状态
    private string sortColumn = "inbounddate";
    private bool sortDescending = true;

    // ========== ExcelFilter 状态 ==========
    private Dictionary<string, HashSet<string>> _columnFilters = new();
    private Dictionary<string, List<InventoryBatchDto>> _filterContexts = new();

    // 列定义
    private List<ColumnDef> _allColumns = new();
    private List<ColumnDef> _visibleColumns =>
        _allColumns.Where(c => c.IsApplicable && c.Visible).ToList();

    // 多选
    private HashSet<InventoryBatchDto> _selectedItems = new();

    // ========== 列定义 ==========

    private static List<ColumnDef> GetAllColumnDefs() => new()
    {
        new() { Key = "BatchNo",             Label = "批次号",   SortKey = "batchno", FilterType = "string" },
        new() { Key = "InboundDate",         Label = "入库日期", SortKey = "inbounddate", FilterType = "date" },
        new() { Key = "InboundSource",       Label = "来源",     SortKey = "inboundsource", FilterType = "enum",
            EnumOptions = new() { new("Purchase", "外购"), new("Subcontract", "委外"), new("ReturnIn", "退货入库"), new("ProductionInbound", "生产入库"), new("InspectionInbound", "检验入库"), new("TransferIn", "移库入库"), new("Other", "其它") } },
        new() { Key = "SourceOrderNo",       Label = "物料单号", SortKey = "sourceorderno", FilterType = "string" },
        new() { Key = "MaterialType",        Label = "物料",     SortKey = "materialtype", FilterType = "string" },
        new() { Key = "SourceName",          Label = "来料单位", SortKey = "sourcename", FilterType = "string" },
        new() { Key = "SurfaceCondition",    Label = "物料状态", SortKey = "surfacecondition", FilterType = "string" },
        new() { Key = "LocationArea",        Label = "区域", SortKey = "locationarea", FilterType = "string" },
        new() { Key = "LocationRack",        Label = "框架", SortKey = "locationrack", FilterType = "string" },
        new() { Key = "HeatNo",              Label = "炉号",     SortKey = "heatno", FilterType = "string" },
        new() { Key = "PlantGrade",          Label = "工厂牌号", SortKey = "plantgrade", FilterType = "string" },
        new() { Key = "Specification",       Label = "名义规格", SortKey = "specification", FilterType = "string" },
        new() { Key = "LengthStatus",        Label = "长度状态", SortKey = "lengthstatus", FilterType = "enum",
            EnumOptions = new() { new("Fixed", "定尺"), new("Range", "范围尺") } },
        new() { Key = "MinLength",           Label = "最小长度", SortKey = "minlength", FilterType = "number" },
        new() { Key = "MaxLength",           Label = "最大长度", SortKey = "maxlength", FilterType = "number" },
        new() { Key = "InitialQuantity",     Label = "支数",     SortKey = "initialquantity", FilterType = "number" },
        new() { Key = "InitialWeight",       Label = "重量(kg)", SortKey = "initialweight", FilterType = "number" },
        new() { Key = "UnitWeight",          Label = "单支重",   SortKey = "unitweight", FilterType = "number" },
        new() { Key = "Meters",              Label = "米数", SortKey = "meters", FilterType = "number" },
        new() { Key = "Remark",              Label = "备注", SortKey = "remark", FilterType = "string" },
        new() { Key = "RemainingQuantity",   Label = "剩余支数", SortKey = "remainingquantity", FilterType = "number" },
        new() { Key = "RemainingWeight",     Label = "剩余重量", SortKey = "remainingweight", FilterType = "number" },
        new() { Key = "IsLinkedToWorkOrder", Label = "关联工单", SortKey = "islinkedtoworkorder", FilterType = "enum",
            EnumOptions = new() { new("True", "是"), new("False", "否") } },
        new() { Key = "WorkOrderNo",         Label = "工单号",   SortKey = "workorderno", FilterType = "string" },
        new() { Key = "SalesOrderNo",        Label = "订单号",   SortKey = "salesorderno", FilterType = "string" },
        new() { Key = "OrderItemIds",        Label = "项次", SortKey = "orderitemids", FilterType = "string" },
        new() { Key = "ProductionBatchNo",   Label = "生产批号", SortKey = "productionbatchno", FilterType = "string" },
        new() { Key = "ActualSpecification", Label = "实际规格", SortKey = "actualspecification", FilterType = "string" },
        new() { Key = "ActualOuterDiameter", Label = "外径", SortKey = "actualouterdiameter", FilterType = "number" },
        new() { Key = "ActualWallThickness", Label = "壁厚", SortKey = "actualwallthickness", FilterType = "number" },
        new() { Key = "DefectReason",        Label = "次品原因", SortKey = "defectreason", FilterType = "string" },
        new() { Key = "LiabilityType",       Label = "责任类型", SortKey = "liabilitytype", FilterType = "string" },
        new() { Key = "OriginalSupplier",    Label = "原始来料", SortKey = "originalsupplier", FilterType = "string" },
        new() { Key = "TagNo",               Label = "挂牌号", SortKey = "tagno", FilterType = "string" },
        new() { Key = "DefectRemark",        Label = "次品备注", SortKey = "defectremark", FilterType = "string" },
    };

    private static void ApplyWarehouseDefaults(List<ColumnDef> cols, string whCode)
    {
        // 先全部重置为适用+可见
        foreach (var c in cols)
        {
            c.IsApplicable = true;
            c.Visible = true;
        }

        switch (whCode)
        {
            case "RAW":
                SetNotApplicable(cols, "MinLength");
                SetNotApplicable(cols, "MaxLength");
                SetNotApplicable(cols, "Meters");
                SetNotApplicable(cols, "ActualSpecification");
                SetNotApplicable(cols, "ActualOuterDiameter");
                SetNotApplicable(cols, "ActualWallThickness");
                SetNotApplicable(cols, "ProductionBatchNo");
                SetNotApplicable(cols, "DefectReason");
                SetNotApplicable(cols, "LiabilityType");
                SetNotApplicable(cols, "OriginalSupplier");
                SetNotApplicable(cols, "TagNo");
                SetNotApplicable(cols, "DefectRemark");
                break;
            case "FG":
                SetNotApplicable(cols, "DefectReason");
                SetNotApplicable(cols, "LiabilityType");
                SetNotApplicable(cols, "OriginalSupplier");
                SetNotApplicable(cols, "TagNo");
                SetNotApplicable(cols, "DefectRemark");
                break;
            case "DEFECT":
                SetNotApplicable(cols, "Meters");
                SetNotApplicable(cols, "ActualSpecification");
                SetNotApplicable(cols, "ActualOuterDiameter");
                SetNotApplicable(cols, "ActualWallThickness");
                SetNotApplicable(cols, "SourceOrderNo");
                break;
            case "WIP":
                SetNotApplicable(cols, "IsLinkedToWorkOrder");
                SetNotApplicable(cols, "WorkOrderNo");
                SetNotApplicable(cols, "SalesOrderNo");
                SetNotApplicable(cols, "OrderItemIds");
                SetNotApplicable(cols, "DefectReason");
                SetNotApplicable(cols, "LiabilityType");
                SetNotApplicable(cols, "OriginalSupplier");
                SetNotApplicable(cols, "TagNo");
                SetNotApplicable(cols, "DefectRemark");
                SetNotApplicable(cols, "Meters");
                SetNotApplicable(cols, "SourceOrderNo");
                break;
        }
    }

    private static void SetNotApplicable(List<ColumnDef> cols, string key)
    {
        var c = cols.FirstOrDefault(x => x.Key == key);
        if (c != null)
        {
            c.IsApplicable = false;
            c.Visible = false;
        }
    }

    // ========== 单元格渲染 ==========

    private RenderFragment RenderCell(InventoryBatchDto item, ColumnDef col) => builder =>
    {
        switch (col.Key)
        {
            case "BatchNo":
                if (!string.IsNullOrEmpty(item.BatchNo))
                    builder.AddContent(0, item.BatchNo);
                break;
            case "MaterialType":
                builder.AddContent(0, item.MaterialType);
                break;
            case "InboundSource":
                builder.AddContent(0, DisplayHelper.GetInboundSourceText(item.InboundSource));
                break;
            case "SourceName":
                builder.AddContent(0, TruncateSourceName(item.SourceName));
                break;
            case "InboundDate":
                builder.AddContent(0, item.InboundDate.ToString("yyyy-MM-dd"));
                break;
            case "HeatNo":
                builder.AddContent(0, item.HeatNo);
                break;
            case "PlantGrade":
                builder.AddContent(0, item.PlantGrade);
                break;
            case "Specification":
                builder.AddContent(0, item.Specification);
                break;
            case "LengthStatus":
                builder.AddContent(0, DisplayHelper.GetLengthStatusText(item.LengthStatus));
                break;
            case "MinLength":
                if (item.MinLength.HasValue)
                    builder.AddContent(0, item.MinLength.Value.ToString("G29"));
                break;
            case "MaxLength":
                if (item.MaxLength.HasValue)
                    builder.AddContent(0, item.MaxLength.Value.ToString("G29"));
                break;
            case "InitialQuantity":
                builder.AddContent(0, item.InitialQuantity);
                break;
            case "InitialWeight":
                builder.AddContent(0, item.InitialWeight.ToString("G29"));
                break;
            case "Meters":
                if (item.Meters.HasValue)
                    builder.AddContent(0, item.Meters.Value.ToString("G29"));
                break;
            case "RemainingQuantity":
                builder.OpenComponent<MudChip>(0);
                builder.AddAttribute(1, "Size", Size.Small);
                builder.AddAttribute(2, "Color", item.RemainingQuantity > 0 ? Color.Success : Color.Default);
                builder.AddAttribute(3, "ChildContent", (RenderFragment)(b2 => b2.AddContent(0, item.RemainingQuantity)));
                builder.CloseComponent();
                break;
            case "RemainingWeight":
                builder.OpenComponent<MudChip>(0);
                builder.AddAttribute(1, "Size", Size.Small);
                builder.AddAttribute(2, "Color", item.RemainingWeight > 0 ? Color.Success : Color.Default);
                builder.AddAttribute(3, "ChildContent", (RenderFragment)(b2 => b2.AddContent(0, item.RemainingWeight.ToString("G29"))));
                builder.CloseComponent();
                break;
            case "UnitWeight":
                if (item.UnitWeight.HasValue)
                    builder.AddContent(0, item.UnitWeight.Value.ToString("G29"));
                break;
            case "ActualSpecification":
                builder.AddContent(0, item.ActualSpecification);
                break;
            case "ActualOuterDiameter":
                if (item.ActualOuterDiameter.HasValue)
                    builder.AddContent(0, item.ActualOuterDiameter.Value.ToString("G29"));
                break;
            case "ActualWallThickness":
                if (item.ActualWallThickness.HasValue)
                    builder.AddContent(0, item.ActualWallThickness.Value.ToString("G29"));
                break;
            case "SurfaceCondition":
                builder.AddContent(0, item.SurfaceCondition);
                break;
            case "LocationArea":
                builder.AddContent(0, TruncateSourceName(item.LocationArea));
                break;
            case "LocationRack":
                builder.AddContent(0, item.LocationRack);
                break;
            case "Remark":
                builder.AddContent(0, item.Remark);
                break;
            case "DefectReason":
                builder.AddContent(0, item.DefectReason);
                break;
            case "LiabilityType":
                builder.AddContent(0, item.LiabilityType);
                break;
            case "OriginalSupplier":
                builder.AddContent(0, item.OriginalSupplier);
                break;
            case "TagNo":
                builder.AddContent(0, item.TagNo);
                break;
            case "DefectRemark":
                builder.AddContent(0, item.DefectRemark);
                break;
            case "ProductionBatchNo":
                builder.AddContent(0, item.ProductionBatchNo);
                break;
            case "IsLinkedToWorkOrder":
                if (item.IsLinkedToWorkOrder)
                {
                    builder.OpenComponent<MudChip>(0);
                    builder.AddAttribute(1, "Size", Size.Small);
                    builder.AddAttribute(2, "Color", Color.Success);
                    builder.AddAttribute(3, "ChildContent", (RenderFragment)(b2 => b2.AddContent(0, "是")));
                    builder.CloseComponent();
                }
                else
                {
                    builder.OpenComponent<MudChip>(0);
                    builder.AddAttribute(1, "Size", Size.Small);
                    builder.AddAttribute(2, "Color", Color.Default);
                    builder.AddAttribute(3, "ChildContent", (RenderFragment)(b2 => b2.AddContent(0, "否")));
                    builder.CloseComponent();
                }
                break;
            case "WorkOrderNo":
                builder.AddContent(0, item.WorkOrderNo);
                break;
            case "SalesOrderNo":
                builder.AddContent(0, item.SalesOrderNo);
                break;
            case "OrderItemIds":
                builder.AddContent(0, item.OrderItemIds);
                break;
            case "SourceOrderNo":
                if (!string.IsNullOrEmpty(item.SourceOrderNo))
                    builder.AddContent(0, item.SourceOrderNo);
                break;
        }
    };

    // ========== 来料单位截断 ==========
    private static string TruncateSourceName(string? name)
    {
        if (string.IsNullOrEmpty(name)) return "";
        return name.Length > 4 ? name[..4] + "…" : name;
    }

    protected override async Task OnInitializedAsync()
    {
        var result = await WarehouseService.GetAllAsync(true);
        if (result.Success && result.Data != null)
            warehouses = result.Data;

        if (!string.IsNullOrEmpty(Code))
        {
            await ResolveWarehouse();
            await LoadAllDataAsync();
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (!string.IsNullOrEmpty(Code))
        {
            await ResolveWarehouse();
            await LoadAllDataAsync();
        }
    }

    private async Task ResolveWarehouse()
    {
        _searchKeyword = string.Empty;
        _outboundMode = false;
        _columnFilters.Clear();
        _filteredItemsList = null;

        warehouseCode = Code!.ToUpperInvariant();
        var wh = warehouses.FirstOrDefault(w => w.Code.Equals(warehouseCode, StringComparison.OrdinalIgnoreCase));
        if (wh != null)
        {
            warehouseId = wh.Id;
            warehouseName = wh.Name;
        }
        else
        {
            warehouseName = Code;
        }

        // 初始化列定义
        _allColumns = GetAllColumnDefs();
        ApplyWarehouseDefaults(_allColumns, warehouseCode);

        // 加载用户自定义列偏好 → 覆盖可见性和顺序
        var saved = await ColumnPrefs.LoadAsync("inventory", warehouseCode);
        if (saved.Count > 0)
        {
            foreach (var s in saved)
            {
                var match = _allColumns.FirstOrDefault(c => c.Key == s.Key);
                if (match != null)
                    match.Visible = s.Visible;
            }
            var reordered = new List<ColumnDef>();
            foreach (var s in saved)
            {
                var match = _allColumns.FirstOrDefault(c => c.Key == s.Key);
                if (match != null && !reordered.Contains(match))
                    reordered.Add(match);
            }
            foreach (var c in _allColumns)
            {
                if (!reordered.Contains(c))
                    reordered.Add(c);
            }
            _allColumns = reordered;
        }

        foreach (var c in _allColumns)
        {
            if (!c.IsApplicable) c.Visible = false;
        }
    }

    // ========== 列管理 ==========

    private async Task OnColumnToggle(ColumnDef col)
    {
        await SaveColumnPrefs();
    }

    private async Task SaveColumnPrefs()
    {
        await ColumnPrefs.SaveAsync("inventory", warehouseCode, _allColumns);
    }

    private async Task ResetColumnDisplay()
    {
        _allColumns = GetAllColumnDefs();
        ApplyWarehouseDefaults(_allColumns, warehouseCode);
        foreach (var c in _allColumns)
        {
            if (c.IsApplicable) c.Visible = true;
        }
        await SaveColumnPrefs();
        await LoadAllDataAsync();
    }

    private async Task MoveColumnUp(ColumnDef col)
    {
        await SaveColumnPrefs();
    }

    private async Task MoveColumnDown(ColumnDef col)
    {
        await SaveColumnPrefs();
    }

    // ========== 数据加载 ==========

    private async Task LoadAllDataAsync()
    {
        try
        {
            var queryParams = new InventoryQueryParams
            {
                SortBy = sortColumn,
                IsDescending = sortDescending,
                WarehouseId = warehouseId,
                Keyword = null,
                OnlyWithStock = true
            };

            var result = await InventoryService.GetAllListAsync(queryParams);

            if (result.Success && result.Data != null)
            {
                _allItems = result.Data;
                _filteredItemsList = null;

                _selectedItems.RemoveWhere(i => !_allItems.Any(x => x.Id == i.Id));

                RefreshFilteredData();
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"加载失败: {ex.Message}", Severity.Error);
        }
        finally
        {
            StateHasChanged();
        }
    }

    // ========== 搜索 ==========
    private async Task OnSearchChanged(string value)
    {
        _searchKeyword = value ?? string.Empty;
        RefreshFilteredData();
    }

    // ========== ExcelFilter 回调 ==========

    private async Task OnColumnFilterChanged(string fieldKey, HashSet<string> selectedValues)
    {
        if (selectedValues.Count > 0)
            _columnFilters[fieldKey] = selectedValues;
        else
            _columnFilters.Remove(fieldKey);

        RefreshFilteredData();
        await SavePageStateAsync();
    }

    private async Task OnExcelSortRequested(string fieldKey, bool ascending)
    {
        sortColumn = fieldKey;
        sortDescending = !ascending;
        RefreshFilteredData();
        await SavePageStateAsync();
    }

    // ========== 持久化 ==========

    private async Task SavePageStateAsync()
    {
        await Task.CompletedTask;
    }

    // ========== 客户端刷新 ==========

    private void RefreshFilteredData()
    {
        var query = _allItems.AsEnumerable();

        // 关键字搜索
        if (!string.IsNullOrWhiteSpace(_searchKeyword))
        {
            var kw = _searchKeyword;
            query = query.Where(x =>
                (x.BatchNo != null && x.BatchNo.Contains(kw, StringComparison.OrdinalIgnoreCase)) ||
                (x.MaterialType != null && x.MaterialType.Contains(kw, StringComparison.OrdinalIgnoreCase)) ||
                (x.PlantGrade != null && x.PlantGrade.Contains(kw, StringComparison.OrdinalIgnoreCase)) ||
                (x.Specification != null && x.Specification.Contains(kw, StringComparison.OrdinalIgnoreCase)) ||
                (x.HeatNo != null && x.HeatNo.Contains(kw, StringComparison.OrdinalIgnoreCase)) ||
                (x.SourceName != null && x.SourceName.Contains(kw, StringComparison.OrdinalIgnoreCase)) ||
                (x.WorkOrderNo != null && x.WorkOrderNo.Contains(kw, StringComparison.OrdinalIgnoreCase)) ||
                (x.SalesOrderNo != null && x.SalesOrderNo.Contains(kw, StringComparison.OrdinalIgnoreCase))
            );
        }

        // ExcelFilter 列筛选
        foreach (var cf in _columnFilters)
        {
            var fieldKey = cf.Key;
            var selected = cf.Value;
            query = query.Where(x =>
            {
                var raw = GetCellRawValue(x, fieldKey);
                return raw != null && selected.Contains(raw);
            });
        }

        // 排序
        if (!string.IsNullOrEmpty(sortColumn))
        {
            query = sortColumn switch
            {
                "batchno" => sortDescending ? query.OrderByDescending(x => x.BatchNo) : query.OrderBy(x => x.BatchNo),
                "inbounddate" => sortDescending ? query.OrderByDescending(x => x.InboundDate) : query.OrderBy(x => x.InboundDate),
                "inboundsource" => sortDescending ? query.OrderByDescending(x => x.InboundSource) : query.OrderBy(x => x.InboundSource),
                "sourceorderno" => sortDescending ? query.OrderByDescending(x => x.SourceOrderNo ?? "") : query.OrderBy(x => x.SourceOrderNo ?? ""),
                "materialtype" => sortDescending ? query.OrderByDescending(x => x.MaterialType) : query.OrderBy(x => x.MaterialType),
                "sourcename" => sortDescending ? query.OrderByDescending(x => x.SourceName ?? "") : query.OrderBy(x => x.SourceName ?? ""),
                "surfacecondition" => sortDescending ? query.OrderByDescending(x => x.SurfaceCondition ?? "") : query.OrderBy(x => x.SurfaceCondition ?? ""),
                "locationarea" => sortDescending ? query.OrderByDescending(x => x.LocationArea ?? "") : query.OrderBy(x => x.LocationArea ?? ""),
                "locationrack" => sortDescending ? query.OrderByDescending(x => x.LocationRack ?? "") : query.OrderBy(x => x.LocationRack ?? ""),
                "heatno" => sortDescending ? query.OrderByDescending(x => x.HeatNo ?? "") : query.OrderBy(x => x.HeatNo ?? ""),
                "plantgrade" => sortDescending ? query.OrderByDescending(x => x.PlantGrade) : query.OrderBy(x => x.PlantGrade),
                "specification" => sortDescending ? query.OrderByDescending(x => x.Specification) : query.OrderBy(x => x.Specification),
                "lengthstatus" => sortDescending ? query.OrderByDescending(x => x.LengthStatus ?? "") : query.OrderBy(x => x.LengthStatus ?? ""),
                "minlength" => sortDescending ? query.OrderByDescending(x => x.MinLength) : query.OrderBy(x => x.MinLength),
                "maxlength" => sortDescending ? query.OrderByDescending(x => x.MaxLength) : query.OrderBy(x => x.MaxLength),
                "initialquantity" => sortDescending ? query.OrderByDescending(x => x.InitialQuantity) : query.OrderBy(x => x.InitialQuantity),
                "initialweight" => sortDescending ? query.OrderByDescending(x => x.InitialWeight) : query.OrderBy(x => x.InitialWeight),
                "unitweight" => sortDescending ? query.OrderByDescending(x => x.UnitWeight) : query.OrderBy(x => x.UnitWeight),
                "meters" => sortDescending ? query.OrderByDescending(x => x.Meters) : query.OrderBy(x => x.Meters),
                "remark" => sortDescending ? query.OrderByDescending(x => x.Remark ?? "") : query.OrderBy(x => x.Remark ?? ""),
                "remainingquantity" => sortDescending ? query.OrderByDescending(x => x.RemainingQuantity) : query.OrderBy(x => x.RemainingQuantity),
                "remainingweight" => sortDescending ? query.OrderByDescending(x => x.RemainingWeight) : query.OrderBy(x => x.RemainingWeight),
                "islinkedtoworkorder" => sortDescending ? query.OrderByDescending(x => x.IsLinkedToWorkOrder) : query.OrderBy(x => x.IsLinkedToWorkOrder),
                "workorderno" => sortDescending ? query.OrderByDescending(x => x.WorkOrderNo ?? "") : query.OrderBy(x => x.WorkOrderNo ?? ""),
                "salesorderno" => sortDescending ? query.OrderByDescending(x => x.SalesOrderNo ?? "") : query.OrderBy(x => x.SalesOrderNo ?? ""),
                "orderitemids" => sortDescending ? query.OrderByDescending(x => x.OrderItemIds ?? "") : query.OrderBy(x => x.OrderItemIds ?? ""),
                "productionbatchno" => sortDescending ? query.OrderByDescending(x => x.ProductionBatchNo ?? "") : query.OrderBy(x => x.ProductionBatchNo ?? ""),
                "actualspecification" => sortDescending ? query.OrderByDescending(x => x.ActualSpecification ?? "") : query.OrderBy(x => x.ActualSpecification ?? ""),
                "actualouterdiameter" => sortDescending ? query.OrderByDescending(x => x.ActualOuterDiameter) : query.OrderBy(x => x.ActualOuterDiameter),
                "actualwallthickness" => sortDescending ? query.OrderByDescending(x => x.ActualWallThickness) : query.OrderBy(x => x.ActualWallThickness),
                "defectreason" => sortDescending ? query.OrderByDescending(x => x.DefectReason ?? "") : query.OrderBy(x => x.DefectReason ?? ""),
                "liabilitytype" => sortDescending ? query.OrderByDescending(x => x.LiabilityType ?? "") : query.OrderBy(x => x.LiabilityType ?? ""),
                "originalsupplier" => sortDescending ? query.OrderByDescending(x => x.OriginalSupplier ?? "") : query.OrderBy(x => x.OriginalSupplier ?? ""),
                "tagno" => sortDescending ? query.OrderByDescending(x => x.TagNo ?? "") : query.OrderBy(x => x.TagNo ?? ""),
                "defectremark" => sortDescending ? query.OrderByDescending(x => x.DefectRemark ?? "") : query.OrderBy(x => x.DefectRemark ?? ""),
                _ => sortDescending ? query.OrderByDescending(x => x.BatchNo) : query.OrderBy(x => x.BatchNo)
            };
        }

        _filteredItemsList = query.ToList();
        StateHasChanged();
    }

