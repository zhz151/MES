@page "/purchase-orders"
@using MES.Blazor.Services
@using MES.Blazor.Helpers
@using MES.Core.DTOs
@using MES.Core.Enums
@using MES.Core.Models
@using Microsoft.AspNetCore.Authorization
@using MES.Blazor.Shared
@inject PurchaseOrderService PurchaseService
@inject SupplierService SupplierService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject IJSRuntime JS
@inject ColumnPrefsService ColumnPrefs
@attribute [Authorize(Roles = "MaterialStaff,MaterialDirector,Admin")]

<MudContainer MaxWidth="MaxWidth.False" Class="mt-4 pl-0">
    <MudCard>
        <MudCardHeader>
            <CardHeaderContent>
                <MudText Typo="Typo.h5" Class="font-weight-bold"><MudIcon Icon="@Icons.Material.Filled.ShoppingCart" Class="mr-2" Color="Color.Primary" />采购订单</MudText>
            </CardHeaderContent>
            <CardHeaderActions>
                <MudButton Variant="Variant.Outlined" Color="Color.Info" StartIcon="@Icons.Material.Filled.Sync" OnClick="() => SyncAllAsync()" Disabled="@isSyncing" Class="mr-2">
                    @if (isSyncing) { <MudProgressCircular Size="Size.Small" Color="Color.Inherit" /> } else { <span>即时更新</span> }
                </MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="NavigateToCreate">新建采购单</MudButton>
            </CardHeaderActions>
        </MudCardHeader>
        <MudCardContent>
            <MudGrid>
                <MudItem xs="12" md="6">
                    <MudTextField T="string" Label="模糊搜索 - 单号/物料分类/钢种/规格/供应商/工单号" @bind-Value="searchKeyword" Immediate="true" DebounceInterval="500" OnKeyDown="OnSearchKeyDown" Clearable="true" ClearButton="true" Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.Search" />
                </MudItem>
                <MudItem xs="12" md="2">
                    <MudSelect T="string" @bind-Value="filterStatus" OnValueChanged="OnFilterChanged">
                        <MudSelectItem Value="@("")">全部状态</MudSelectItem>
                        <MudSelectItem Value="@("Open")">已下单</MudSelectItem>
                        <MudSelectItem Value="@("Partial")">部分到货</MudSelectItem>
                        <MudSelectItem Value="@("Completed")">已完成</MudSelectItem>
                        <MudSelectItem Value="@("Cancelled")">已取消</MudSelectItem>
                    </MudSelect>
                </MudItem>
            </MudGrid>

            @* 工单用料计划执行状态 *@
            @if (procurementItems.Any())
            {
                var noneCount = procurementItems.Count(x => x.StatusText == "未采购");
                var partialCount = procurementItems.Count(x => x.StatusText == "部分采购");
                <MudPaper Class="pa-3 mb-3" Elevation="0" Style="border: 1px solid #e0e0e0; border-radius: 8px;">
                    <div Class="d-flex align-center" style="cursor: pointer;" @onclick="ToggleProcurementStatus">
                        <MudIcon Icon="@Icons.Material.Filled.Info" Color="Color.Info" Class="mr-2" />
                        <MudText Typo="Typo.body1" Class="font-weight-bold flex-grow-1">工单用料计划执行状态</MudText>
                        <MudChip Size="Size.Small" Color="Color.Error" Class="mr-1">未采购 @noneCount</MudChip>
                        <MudChip Size="Size.Small" Color="Color.Warning" Class="mr-1">部分采购 @partialCount</MudChip>
                        <MudIcon Icon="@(showProcurementStatus ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)" Color="Color.Default" />
                    </div>
                    @if (showProcurementStatus)
                    {
                        <div style="overflow-x: auto; overflow-y: auto; margin-top: 8px; max-height: 25vh;">
                            <MudTable T="ProcurementStatusDto" Items="@procurementItems" Dense="true" Hover="true" Class="auto-table" Elevation="0">
                                <HeaderContent>
                                    <MudTh Style="width: 120px;">工单号</MudTh>
                                    <MudTh Style="width: 90px;">物料分类</MudTh>
                                    <MudTh Style="width: 100px;" Class="text-right">计划总量(kg)</MudTh>
                                    <MudTh Style="width: 100px;" Class="text-right">已采购(kg)</MudTh>
                                    <MudTh Style="width: 100px;" Class="text-right">已委外(kg)</MudTh>
                                    <MudTh Style="width: 100px;" Class="text-right">合计(kg)</MudTh>
                                    <MudTh Style="width: 90px;">状态</MudTh>
                                </HeaderContent>
                                <RowTemplate>
                                    <MudTd>@context.WorkOrderNo</MudTd>
                                    <MudTd>@context.MaterialCategory</MudTd>
                                    <MudTd Class="text-right">@context.PlanWeight.ToString("G29")</MudTd>
                                    <MudTd Class="text-right">@context.PurchaseWeight.ToString("G29")</MudTd>
                                    <MudTd Class="text-right">@context.SubcontractWeight.ToString("G29")</MudTd>
                                    <MudTd Class="text-right">@context.TotalWeight.ToString("G29")</MudTd>
                                    <MudTd>
                                        <MudChip Size="Size.Small" Color="@(context.StatusText == "未采购" ? Color.Error : Color.Warning)">
                                            @context.StatusText
                                        </MudChip>
                                    </MudTd>
                                </RowTemplate>
                            </MudTable>
                        </div>
                    }
                </MudPaper>
            }

            <div id="purchase-orders-list-table"><MudTable @ref="table" T="PurchaseOrderDto" ServerData="OnServerData" Loading="@isLoading" Dense="true" Hover="true" Class="mt-4 auto-table" Elevation="0" RowsPerPageLabel="每页行数:">
                <ToolBarContent>
                    <ColumnDisplaySelect Columns="_allColumns"
                                         OnColumnToggle="OnColumnToggle"
                                         OnMoveUp="MoveColumnUp"
                                         OnMoveDown="MoveColumnDown" />
                    <MudButton Variant="Variant.Text" Size="Size.Small"
                               Color="Color.Default"
                               StartIcon="@Icons.Material.Filled.RestartAlt"
                               OnClick="ResetColumnDisplay" Class="ml-2">
                        重置
                    </MudButton>
                    <MudSpacer />
                    <MudButton Variant="Variant.Outlined" Size="Size.Small" Color="Color.Info" StartIcon="@Icons.Material.Filled.Print" Disabled="@(!selectedIds.Any())" OnClick="PrintSelected">
                        打印选中 (@selectedIds.Count)
                    </MudButton>
                    <MudButton Variant="Variant.Text" Size="Size.Small" Color="Color.Info" StartIcon="@Icons.Material.Filled.Print" OnClick="PrintAll">
                        打印全部
                    </MudButton>
                    <MudText Typo="Typo.body2" Class="ml-4">共 @totalCount 条记录</MudText>
                </ToolBarContent>
                <HeaderContent>
                    <MudTh Style="width: 36px;">
                        <MudCheckBox T="bool" @bind-Value="allSelected" Dense="true" />
                    </MudTh>
                    @foreach (var col in _visibleColumns)
                    {
                        <MudTh>
                            @if (!string.IsNullOrEmpty(col.SortKey))
                            {
                                <span @onclick='() => ToggleSort(col.SortKey)' class="sortable-header">
                                    @col.Label
                                    @if (sortColumn == col.SortKey)
                                    {
                                        <span class="sort-arrow">@GetSortIndicator(col.SortKey)</span>
                                    }
                                </span>
                            }
                            else
                            {
                                <span class="th-label">@col.Label</span>
                            }
                        </MudTh>
                    }
                    <MudTh Style="width: 90px;">操作</MudTh>
                </HeaderContent>
                <RowTemplate Context="item">
                    <MudTd Style="width: 36px;">
                        <MudCheckBox T="bool"
                                     Value="@selectedIds.Contains(item.Id)"
                                     ValueChanged="@((v) => { if(v) selectedIds.Add(item.Id); else selectedIds.Remove(item.Id); _allSelected = items.Any() && items.All(i => selectedIds.Contains(i.Id)); StateHasChanged(); })"
                                     Dense="true" />
                    </MudTd>
                    @foreach (var col in _visibleColumns)
                    {
                        <MudTd>@RenderCell(item, col)</MudTd>
                    }
                    <MudTd>
                        @if (item.Status != PurchaseOrderStatus.Completed && item.Status != PurchaseOrderStatus.Cancelled)
                        {
                            <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Warning" Size="Size.Small" OnClick="() => NavigateToEdit(item.Id)" />
                            <MudIconButton Icon="@Icons.Material.Filled.Cancel" Color="Color.Error" Size="Size.Small" OnClick="() => CancelOrder(item)" />
                        }
                    </MudTd>
                </RowTemplate>
                <PagerContent><MudTablePager /></PagerContent>
            </MudTable></div>
        </MudCardContent>
    </MudCard>
</MudContainer>

@code {
    private MudTable<PurchaseOrderDto>? table;
    private List<PurchaseOrderDto> items = new();
    private HashSet<int> selectedIds = new();
    private bool _allSelected;
    private bool allSelected
    {
        get => _allSelected;
        set
        {
            if (_allSelected == value) return;
            _allSelected = value;
            if (value)
            {
                foreach (var item in items)
                    selectedIds.Add(item.Id);
            }
            else
            {
                selectedIds.Clear();
            }
            StateHasChanged();
        }
    }
    private bool isLoading, isSyncing;
    private string searchKeyword = string.Empty;
    private string filterStatus = string.Empty;
    private int totalCount;

    private bool _isArrowNavSetup;

    private string sortColumn = "orderdate";
    private bool sortDescending = true;

    private List<ProcurementStatusDto> procurementItems = new();
    private bool showProcurementStatus = false;
    private List<OrderMismatchInfo> mismatchItems = new();

    // ========== 列定义 ==========

    private List<ColumnDef> _allColumns = new();
    private List<ColumnDef> _visibleColumns =>
        _allColumns.Where(c => c.IsApplicable && c.Visible).ToList();
    private static List<ColumnDef> GetAllColumnDefs() => new()
    {
        new() { Key = "OrderNo",             Label = "采购单号",     SortKey = "orderno" },
        new() { Key = "SourceWorkOrderNo",   Label = "来源工单号",   SortKey = "sourceworkorderno" },
        new() { Key = "WoSalesOrderNo",      Label = "订单号",       SortKey = "wosalesorderno" },
        new() { Key = "WoProductionMainNo",  Label = "主号",         SortKey = "woproductionmainno" },
        new() { Key = "WoProductionSubNo",   Label = "次号" },
        new() { Key = "WoSignDate",          Label = "签订日期",     SortKey = "wosigndate" },
        new() { Key = "WoSalesman",          Label = "业务员",       SortKey = "wosalesman" },
        new() { Key = "WoEndCustomer",       Label = "最终用户" },
        new() { Key = "WoDeliveryDate",      Label = "交货日期",     SortKey = "wodeliverydate" },
        new() { Key = "WoDelayPenalty",      Label = "延期罚款" },
        new() { Key = "WoSettlementMethod",  Label = "结算方式" },
        new() { Key = "WoPlantGrade",        Label = "工厂牌号",     SortKey = "woplantgrade" },
        new() { Key = "WoSpecification",     Label = "成品规格",     SortKey = "wospecification" },
        new() { Key = "WoLengthStatus",      Label = "长度状态" },
        new() { Key = "WoMaxLength",         Label = "最大长度",     SortKey = "womaxlength" },
        new() { Key = "WoTotalQuantity",     Label = "总支数",       SortKey = "wototalquantity" },
        new() { Key = "WoTotalWeight",       Label = "总重量",       SortKey = "wototalweight" },
        new() { Key = "WoDeliveryState",     Label = "交货状态" },
        new() { Key = "WoTotalItemCount",    Label = "含项次数",     SortKey = "wototalitemcount" },
        new() { Key = "OrderDate",           Label = "下单日期",     SortKey = "orderdate" },
        new() { Key = "MaterialCategory",    Label = "物料分类",     SortKey = "materialcategory" },
        new() { Key = "PlantGrade",          Label = "厂内钢种",     SortKey = "plantgrade" },
        new() { Key = "Specification",       Label = "规格",         SortKey = "specification" },
        new() { Key = "UnitWeight",          Label = "单支重量" },
        new() { Key = "Quantity",            Label = "支数" },
        new() { Key = "Weight",              Label = "采购重量" },
        new() { Key = "RequiredDate",        Label = "要求到货日",   SortKey = "requireddate" },
        new() { Key = "SupplierName",        Label = "供应商",       SortKey = "suppliername" },
        new() { Key = "Status",              Label = "状态",         SortKey = "status" },
        new() { Key = "Received",            Label = "已到货" },
    };

    // ========== 列选择操作 ==========

    private async Task OnColumnToggle(ColumnDef col)
    {
        await SaveColumnPrefs();
    }

    private async Task SaveColumnPrefs()
    {
        await ColumnPrefs.SaveAsync("purchase_orders", null, _allColumns);
    }

    private async Task ResetColumnDisplay()
    {
        _allColumns = GetAllColumnDefs();
        await SaveColumnPrefs();
    }

    private async Task MoveColumnUp(ColumnDef col)
    {
        await SaveColumnPrefs();
    }

    private async Task MoveColumnDown(ColumnDef col)
    {
        await SaveColumnPrefs();
    }

    private string GetSortIndicator(string column)
    {
        if (sortColumn != column) return "";
        return sortDescending ? "\u25BC" : "\u25B2";
    }

    private async Task ToggleSort(string column)
    {
        if (sortColumn == column)
            sortDescending = !sortDescending;
        else
        {
            sortColumn = column;
            sortDescending = column == "orderdate" || column == "requireddate";
        }
        if (table != null)
            await table.ReloadServerData();
    }

    protected override async Task OnInitializedAsync()
    {
        // 先同步仓库数据（到货进度），再加载状态和检测不匹配
        await SyncAllAsync(silent: true);
        await LoadProcurementStatus();
        await LoadOrderMismatches();

        // 列定义与偏好加载
        _allColumns = GetAllColumnDefs();
        var saved = await ColumnPrefs.LoadAsync("purchase_orders", null);
        if (saved.Count > 0)
        {
            foreach (var s in saved)
            {
                var match = _allColumns.FirstOrDefault(c => c.Key == s.Key);
                if (match != null)
                    match.Visible = s.Visible;
            }
            var reordered = new List<ColumnDef>();
            foreach (var s in saved)
            {
                var match = _allColumns.FirstOrDefault(c => c.Key == s.Key);
                if (match != null && !reordered.Contains(match))
                    reordered.Add(match);
            }
            foreach (var c in _allColumns)
            {
                if (!reordered.Contains(c))
                    reordered.Add(c);
            }
            _allColumns = reordered;
        }
    }

    private async Task LoadProcurementStatus()
    {
        try
        {
            var result = await PurchaseService.GetProcurementStatusAsync();
            if (result.Success && result.Data != null)
                procurementItems = result.Data;
            else if (!result.Success)
                Snackbar.Add($"加载用料计划执行状态失败: {result.Message}", Severity.Warning);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"加载用料计划执行状态异常: {ex.Message}", Severity.Error);
        }
    }

    private void ToggleProcurementStatus() => showProcurementStatus = !showProcurementStatus;

    private async Task LoadOrderMismatches()
    {
        try
        {
            var result = await PurchaseService.GetMismatchedOrdersAsync();
            if (result.Success && result.Data != null && result.Data.Count > 0)
            {
                mismatchItems = result.Data;
                foreach (var item in mismatchItems)
                {
                    var woNos = string.Join("；", item.MismatchedWorkOrderNos);
                    Snackbar.Add($"采购单号 {item.OrderNo} 中，来源工单号：{woNos} 已不关联采购用料计划，需修改！", Severity.Warning, config =>
                    {
                        config.VisibleStateDuration = 20000;
                        config.Action = "忽略";
                    });
                }
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"检测工单关联异常: {ex.Message}", Severity.Error);
        }
    }

    private async Task<TableData<PurchaseOrderDto>> OnServerData(TableState state)
    {
        isLoading = true; StateHasChanged();
        try
        {
            var query = new QueryParams
            {
                PageIndex = state.Page + 1,
                PageSize = state.PageSize,
                Keyword = string.IsNullOrWhiteSpace(searchKeyword) ? null : searchKeyword,
                SortBy = sortColumn,
                IsDescending = sortDescending
            };
            var statusFilter = string.IsNullOrEmpty(filterStatus) ? null : filterStatus;
            var result = await PurchaseService.GetPagedAsync(query, statusFilter);
            if (result.Success && result.Data != null) { items = result.Data.Items; totalCount = result.Data.TotalCount; return new TableData<PurchaseOrderDto> { Items = items, TotalItems = totalCount }; }
            return new TableData<PurchaseOrderDto> { Items = new List<PurchaseOrderDto>(), TotalItems = 0 };
        }
        catch (Exception ex) { Snackbar.Add($"加载失败: {ex.Message}", Severity.Error); return new TableData<PurchaseOrderDto> { Items = new List<PurchaseOrderDto>(), TotalItems = 0 }; }
        finally { isLoading = false; StateHasChanged(); }
    }

    private async Task Search() { if (table != null) await table.ReloadServerData(); }
    private void OnSearchKeyDown(KeyboardEventArgs args) { if (args.Key == "Enter") _ = Search(); }
    private async Task OnFilterChanged() { await Search(); }
    private void NavigateToCreate() => Navigation.NavigateTo("/purchase-orders/create");
    private void ViewDetail(int id) => Navigation.NavigateTo($"/purchase-orders/{id}");
    private void NavigateToEdit(int id) => Navigation.NavigateTo($"/purchase-orders/{id}");

    private async Task SyncAllAsync(bool silent = false)
    {
        if (!silent) { isSyncing = true; StateHasChanged(); }
        try
        {
            var result = await PurchaseService.SyncAllAsync();
            if (result.Success)
            {
                if (!silent) Snackbar.Add("同步完成", Severity.Success);
                await Search();
                await LoadProcurementStatus();
                await LoadOrderMismatches();
            }
            else if (!silent)
            {
                Snackbar.Add(result.Message ?? "同步失败", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            if (!silent) Snackbar.Add($"同步失败: {ex.Message}", Severity.Error);
        }
        finally { if (!silent) { isSyncing = false; StateHasChanged(); } }
    }

    // ========== 单元格渲染 ==========

    private RenderFragment RenderCell(PurchaseOrderDto item, ColumnDef col) => builder =>
    {
        switch (col.Key)
        {
            case "OrderNo":
                builder.OpenComponent<MudLink>(0);
                builder.AddAttribute(1, "Typo", Typo.body2);
                builder.AddAttribute(2, "OnClick", EventCallback.Factory.Create<MouseEventArgs?>(this, () => ViewDetail(item.Id)));
                builder.AddAttribute(3, "ChildContent", (RenderFragment)(b2 => {
                    b2.OpenElement(4, "strong");
                    b2.AddContent(5, item.OrderNo);
                    b2.CloseElement();
                }));
                builder.CloseComponent();
                break;
            case "SourceWorkOrderNo":
                builder.AddContent(0, item.SourceWorkOrderNo);
                break;
            case "WoSalesOrderNo":
                builder.AddContent(0, item.WoSalesOrderNo);
                break;
            case "WoProductionMainNo":
                builder.AddContent(0, item.WoProductionMainNo);
                break;
            case "WoProductionSubNo":
                builder.AddContent(0, item.WoProductionSubNo);
                break;
            case "WoSignDate":
                builder.AddContent(0, item.WoSignDate?.ToString("yyyy-MM-dd"));
                break;
            case "WoSalesman":
                builder.AddContent(0, item.WoSalesman);
                break;
            case "WoEndCustomer":
                builder.AddContent(0, item.WoEndCustomer ?? "-");
                break;
            case "WoDeliveryDate":
                builder.AddContent(0, item.WoDeliveryDate?.ToString("yyyy-MM-dd"));
                break;
            case "WoDelayPenalty":
                builder.AddContent(0, item.WoDelayPenalty ? "是" : "否");
                break;
            case "WoSettlementMethod":
                builder.AddContent(0, item.WoSettlementMethod.HasValue ? DisplayHelper.GetSettlementMethodText(item.WoSettlementMethod.Value) : "-");
                break;
            case "WoPlantGrade":
                builder.AddContent(0, item.WoPlantGrade);
                break;
            case "WoSpecification":
                builder.AddContent(0, item.WoSpecification);
                break;
            case "WoLengthStatus":
                builder.AddContent(0, item.WoLengthStatus.HasValue ? DisplayHelper.GetLengthStatusText(item.WoLengthStatus.Value) : "-");
                break;
            case "WoMaxLength":
                builder.AddContent(0, item.WoMaxLength?.ToString("G29") ?? "-");
                break;
            case "WoTotalQuantity":
                builder.AddContent(0, item.WoTotalQuantity);
                break;
            case "WoTotalWeight":
                builder.AddContent(0, item.WoTotalWeight?.ToString("G29") ?? "-");
                break;
            case "WoDeliveryState":
                builder.AddContent(0, item.WoDeliveryState.HasValue ? DisplayHelper.GetDeliveryStateText(item.WoDeliveryState.Value) : "-");
                break;
            case "WoTotalItemCount":
                builder.AddContent(0, item.WoTotalItemCount);
                break;
            case "OrderDate":
                builder.OpenComponent<MudChip>(0);
                builder.AddAttribute(1, "Size", Size.Small);
                builder.AddAttribute(2, "Color", Color.Info);
                builder.AddAttribute(3, "ChildContent", (RenderFragment)(b2 => b2.AddContent(0, item.OrderDate.ToString("yyyy-MM-dd"))));
                builder.CloseComponent();
                break;
            case "MaterialCategory":
                builder.AddContent(0, item.MaterialCategory);
                break;
            case "PlantGrade":
                builder.AddContent(0, item.PlantGrade);
                break;
            case "Specification":
                builder.AddContent(0, item.Specification);
                break;
            case "UnitWeight":
                builder.AddContent(0, item.UnitWeight?.ToString("G29") ?? "-");
                break;
            case "Quantity":
                builder.AddContent(0, item.Quantity?.ToString("G29") ?? "-");
                break;
            case "Weight":
                builder.AddContent(0, item.Weight.ToString("G29"));
                break;
            case "RequiredDate":
                builder.AddContent(0, item.RequiredDate.ToString("yyyy-MM-dd"));
                break;
            case "SupplierName":
                builder.AddContent(0, item.SupplierName);
                break;
            case "Status":
                builder.OpenComponent<MudChip>(0);
                builder.AddAttribute(1, "Size", Size.Small);
                builder.AddAttribute(2, "Color", GetStatusColor(item.Status));
                builder.AddAttribute(3, "ChildContent", (RenderFragment)(b2 => b2.AddContent(0, GetStatusText(item.Status))));
                builder.CloseComponent();
                break;
            case "Received":
                builder.AddContent(0, $"{item.ReceivedQuantity}支/{item.ReceivedWeight.ToString("G29")}kg");
                break;
        }
    };

    // ========== 打印 ==========

    private async Task PrintSelected()
    {
        if (!selectedIds.Any())
        {
            Snackbar.Add("请先选择要打印的采购单", Severity.Warning);
            return;
        }
        try
        {
            var ids = selectedIds.ToArray();
            var result = await PurchaseService.PrintOrderBatchAsync(ids);
            if (result.Success && result.Data != null)
                await JS.InvokeVoidAsync("openPdf", result.Data);
            else
                Snackbar.Add(result.Message ?? "打印失败", Severity.Error);
        }
        catch (Exception ex) { Snackbar.Add($"打印失败: {ex.Message}", Severity.Error); }
    }

    private async Task PrintAll()
    {
        try
        {
            var result = await PurchaseService.PrintOrderAllAsync(
                string.IsNullOrWhiteSpace(searchKeyword) ? null : searchKeyword,
                sortColumn, sortDescending);
            if (result.Success && result.Data != null)
                await JS.InvokeVoidAsync("openPdf", result.Data);
            else
                Snackbar.Add(result.Message ?? "打印失败", Severity.Error);
        }
        catch (Exception ex) { Snackbar.Add($"打印失败: {ex.Message}", Severity.Error); }
    }

    private async Task CancelOrder(PurchaseOrderDto item)
    {
        var dialog = DialogService.Show<ConfirmDialog>("确认", new DialogParameters { ["ContentText"] = $"确定要取消采购单 \"{item.OrderNo}\" 吗？", ["ConfirmText"] = "确认取消", ["Color"] = Color.Error });
        var dialogResult = await dialog.Result;
        if (!dialogResult.Canceled)
        {
            try
            {
                var result = await PurchaseService.DeleteAsync(item.Id);
                if (result.Success) { Snackbar.Add("取消成功", Severity.Success); await Search(); await LoadProcurementStatus(); }
                else { Snackbar.Add(result.Message ?? "取消失败", Severity.Error); }
            }
            catch (Exception ex) { Snackbar.Add($"取消失败: {ex.Message}", Severity.Error); }
        }
    }

    private static Color GetStatusColor(PurchaseOrderStatus status) => status switch { PurchaseOrderStatus.Open => Color.Info, PurchaseOrderStatus.Partial => Color.Warning, PurchaseOrderStatus.Completed => Color.Success, PurchaseOrderStatus.Cancelled => Color.Default, _ => Color.Default };
    private static string GetStatusText(PurchaseOrderStatus status) => status switch { PurchaseOrderStatus.Open => "已下单", PurchaseOrderStatus.Partial => "部分到货", PurchaseOrderStatus.Completed => "已完成", PurchaseOrderStatus.Cancelled => "已取消", _ => status.ToString() };

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_isArrowNavSetup)
        {
            _isArrowNavSetup = true;
            if (!await JS.InvokeAsync<bool>("enableTableArrowNav", "#purchase-orders-list-table"))
                _isArrowNavSetup = false;
        }
    }
}
