@page "/purchase-orders"
@using MES.Blazor.Services
@using MES.Blazor.Helpers
@using MES.Core.DTOs
@using MES.Core.Enums
@using MES.Core.Models
@using Microsoft.AspNetCore.Authorization
@using MES.Blazor.Shared
@inject PurchaseOrderService PurchaseService
@inject SupplierService SupplierService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject IJSRuntime JS
@inject ColumnPrefsService ColumnPrefs
@attribute [Authorize(Roles = "MaterialStaff,MaterialDirector,Admin")]

<MudContainer MaxWidth="MaxWidth.False" Class="mt-4 pl-0">
    <MudCard>
        <MudCardHeader>
            <CardHeaderContent>
                <MudText Typo="Typo.h5" Class="font-weight-bold"><MudIcon Icon="@Icons.Material.Filled.ShoppingCart" Class="mr-2" Color="Color.Primary" />采购订单</MudText>
            </CardHeaderContent>
            <CardHeaderActions>
                <MudButton Variant="Variant.Outlined" Color="Color.Info" StartIcon="@Icons.Material.Filled.Sync" OnClick="() => SyncAllAsync()" Disabled="@isSyncing" Class="mr-2">
                    @if (isSyncing) { <MudProgressCircular Size="Size.Small" Color="Color.Inherit" /> } else { <span>即时更新</span> }
                </MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="NavigateToCreate">新建采购单</MudButton>
            </CardHeaderActions>
        </MudCardHeader>
        <MudCardContent>
            <MudGrid>
                <MudItem xs="12" md="6">
                    <MudTextField T="string" Label="模糊搜索 - 单号/物料分类/钢种/规格/供应商/工单号" Value="_searchKeyword" ValueChanged="@OnSearchChanged" Immediate="true" DebounceInterval="500" Clearable="true" ClearButton="true" Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.Search" />
                </MudItem>
            </MudGrid>

            @* 工单采购计划执行状态 *@
            @if (procurementItems.Any())
            {
                var noneCount = procurementItems.Count(x => x.StatusText == "未采购");
                var partialCount = procurementItems.Count(x => x.StatusText == "部分采购");
                <MudPaper Class="pa-3 mb-3" Elevation="0" Style="border: 1px solid #e0e0e0; border-radius: 8px;">
                    <div Class="d-flex align-center" style="cursor: pointer;" @onclick="ToggleProcurementStatus">
                        <MudIcon Icon="@Icons.Material.Filled.Info" Color="Color.Info" Class="mr-2" />
                        <MudText Typo="Typo.body1" Class="font-weight-bold flex-grow-1">工单采购计划执行状态</MudText>
                        <MudChip Size="Size.Small" Color="Color.Error" Class="mr-1">未采购 @noneCount</MudChip>
                        <MudChip Size="Size.Small" Color="Color.Warning" Class="mr-1">部分采购 @partialCount</MudChip>
                        <MudIcon Icon="@(showProcurementStatus ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)" Color="Color.Default" />
                    </div>
                    @if (showProcurementStatus)
                    {
                        <div style="overflow-x: auto; overflow-y: auto; margin-top: 8px; max-height: 25vh;">
                            <MudTable T="ProcurementStatusDto" Items="@procurementItems" Dense="true" Hover="true" Class="auto-table" Elevation="0">
                                <HeaderContent>
                                    <MudTh Style="width: 120px;">工单号</MudTh>
                                    <MudTh Style="width: 90px;">物料分类</MudTh>
                                    <MudTh Style="width: 100px;" Class="text-right">计划总量(kg)</MudTh>
                                    <MudTh Style="width: 100px;" Class="text-right">已采购(kg)</MudTh>
                                    <MudTh Style="width: 100px;" Class="text-right">已委外(kg)</MudTh>
                                    <MudTh Style="width: 100px;" Class="text-right">合计(kg)</MudTh>
                                    <MudTh Style="width: 90px;">状态</MudTh>
                                </HeaderContent>
                                <RowTemplate>
                                    <MudTd>@context.WorkOrderNo</MudTd>
                                    <MudTd>@context.MaterialCategory</MudTd>
                                    <MudTd Class="text-right">@context.PlanWeight.ToString("G29")</MudTd>
                                    <MudTd Class="text-right">@context.PurchaseWeight.ToString("G29")</MudTd>
                                    <MudTd Class="text-right">@context.SubcontractWeight.ToString("G29")</MudTd>
                                    <MudTd Class="text-right">@context.TotalWeight.ToString("G29")</MudTd>
                                    <MudTd>
                                        <MudChip Size="Size.Small" Color="@(context.StatusText == "未采购" ? Color.Error : Color.Warning)">
                                            @context.StatusText
                                        </MudChip>
                                    </MudTd>
                                </RowTemplate>
                            </MudTable>
                        </div>
                    }
                </MudPaper>
            }

            <div id="purchase-orders-list-table"><MudTable @ref="table" T="PurchaseOrderDto" Items="@_filteredItems" Dense="true" Hover="true" Class="mt-4 auto-table" Elevation="0" RowsPerPage="10" RowsPerPageLabel="每页行数:">
                <ToolBarContent>
                    <ColumnDisplaySelect Columns="_allColumns"
                                         OnColumnToggle="OnColumnToggle"
                                         OnMoveUp="MoveColumnUp"
                                         OnMoveDown="MoveColumnDown" />
                    <MudButton Variant="Variant.Text" Size="Size.Small"
                               Color="Color.Default"
                               StartIcon="@Icons.Material.Filled.RestartAlt"
                               OnClick="ResetColumnDisplay" Class="ml-2">
                        重置
                    </MudButton>
                    <MudSpacer />
                    <MudButton Variant="Variant.Outlined" Size="Size.Small" Color="Color.Info" StartIcon="@Icons.Material.Filled.Print" Disabled="@(!selectedIds.Any())" OnClick="PrintSelected">
                        打印选中 (@selectedIds.Count)
                    </MudButton>
                    <MudButton Variant="Variant.Text" Size="Size.Small" Color="Color.Info" StartIcon="@Icons.Material.Filled.Print" OnClick="PrintAll">
                        打印全部
                    </MudButton>
                    <MudText Typo="Typo.body2" Class="ml-4">共 @(_filteredItems?.Count ?? 0) 条记录</MudText>
                </ToolBarContent>
                <HeaderContent>
                    <MudTh Style="width: 36px;">
                        <MudCheckBox T="bool" @bind-Value="allSelected" Dense="true" />
                    </MudTh>
                    @foreach (var col in _visibleColumns)
                    {
                        <MudTh>
                            <div style="display:inline-flex; align-items:center; gap:4px;">
                                <span class="th-label">@col.Label</span>
                                @if (col.FilterType != null)
                                {
                                    <ExcelFilter T="PurchaseOrderDto"
                                                 Label="@col.Label"
                                                 FieldKey="@col.Key"
                                                 AllItems="@_allItems"
                                                 ActiveFilterValues="@(_columnFilters.GetValueOrDefault(col.Key))"
                                                 DisplaySelector="@(x => GetCellDisplayText(x, col.Key))"
                                                 RawValueSelector="@(x => GetCellRawValue(x, col.Key))"
                                                 FilterChanged="@(args => OnColumnFilterChanged(args.fieldKey, args.selectedValues))"
                                                 SortRequested="@(args => OnExcelSortRequested(args.fieldKey, args.ascending))" />
                                }
                            </div>
                        </MudTh>
                    }
                    <MudTh Style="width: 90px;">操作</MudTh>
                </HeaderContent>
                <RowTemplate Context="item">
                    <MudTd Style="width: 36px;">
                        <MudCheckBox T="bool"
                                     Value="@selectedIds.Contains(item.Id)"
                                     ValueChanged="@((v) => { if(v) selectedIds.Add(item.Id); else selectedIds.Remove(item.Id); _allSelected = _filteredItems.Any() && _filteredItems.All(i => selectedIds.Contains(i.Id)); StateHasChanged(); })"
                                     Dense="true" />
                    </MudTd>
                    @foreach (var col in _visibleColumns)
                    {
                        <MudTd>@RenderCell(item, col)</MudTd>
                    }
                    <MudTd>
                        @if (item.Status != PurchaseOrderStatus.Completed && item.Status != PurchaseOrderStatus.Cancelled)
                        {
                            <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Warning" Size="Size.Small" OnClick="() => NavigateToEdit(item.Id)" />
                            <MudIconButton Icon="@Icons.Material.Filled.Cancel" Color="Color.Error" Size="Size.Small" OnClick="() => CancelOrder(item)" />
                        }
                    </MudTd>
                </RowTemplate>
                <PagerContent><MudTablePager PageSizeOptions="new int[]{10,15,25,50,100}" /></PagerContent>
            </MudTable></div>
        </MudCardContent>
    </MudCard>
</MudContainer>

@code {
    private MudTable<PurchaseOrderDto>? table;
    private List<PurchaseOrderDto> _allItems = new();
    private List<PurchaseOrderDto>? _filteredItemsList;
    private List<PurchaseOrderDto> _filteredItems => _filteredItemsList ?? _allItems;
    private HashSet<int> selectedIds = new();
    private bool _allSelected;
    private bool allSelected
    {
        get => _allSelected;
        set
        {
            if (_allSelected == value) return;
            _allSelected = value;
            if (value)
            {
                foreach (var item in _filteredItems)
                    selectedIds.Add(item.Id);
            }
            else
            {
                selectedIds.Clear();
            }
            StateHasChanged();
        }
    }
    private bool isSyncing;
    private string _searchKeyword = string.Empty;

    private bool _isArrowNavSetup;

    private string sortColumn = "orderdate";
    private bool sortDescending = true;

    // ========== ExcelFilter 状态 ==========
    private Dictionary<string, HashSet<string>> _columnFilters = new();
    private Dictionary<string, List<PurchaseOrderDto>> _filterContexts = new();

    private List<ProcurementStatusDto> procurementItems = new();
    private bool showProcurementStatus = false;
    private List<OrderMismatchInfo> mismatchItems = new();

    // ========== 列定义 ==========

    private List<ColumnDef> _allColumns = new();
    private List<ColumnDef> _visibleColumns =>
        _allColumns.Where(c => c.IsApplicable && c.Visible).ToList();
    private static List<ColumnDef> GetAllColumnDefs() => new()
    {
        new() { Key = "OrderNo",             Label = "采购单号",     SortKey = "orderno", FilterType = "string" },
        new() { Key = "SourceWorkOrderNo",   Label = "来源工单号",   SortKey = "sourceworkorderno", FilterType = "string" },
        new() { Key = "WoSalesOrderNo",      Label = "订单号",       SortKey = "wosalesorderno", FilterType = "string" },
        new() { Key = "WoProductionMainNo",  Label = "主号",         SortKey = "woproductionmainno", FilterType = "string" },
        new() { Key = "WoProductionSubNo",   Label = "次号",         SortKey = "woproductionsubno", FilterType = "string" },
        new() { Key = "WoSignDate",          Label = "签订日期",     SortKey = "wosigndate", FilterType = "date" },
        new() { Key = "WoSalesman",          Label = "业务员",       SortKey = "wosalesman", FilterType = "string" },
        new() { Key = "WoEndCustomer",       Label = "最终用户",     SortKey = "woendcustomer", FilterType = "string" },
        new() { Key = "WoDeliveryDate",      Label = "交货日期",     SortKey = "wodeliverydate", FilterType = "date" },
        new() { Key = "WoDelayPenalty",      Label = "延期罚款",     SortKey = "wodelaypenalty", FilterType = "enum",
            EnumOptions = new() { new("True", "是"), new("False", "否") } },
        new() { Key = "WoSettlementMethod",  Label = "结算方式",     SortKey = "wosettlementmethod", FilterType = "enum",
            EnumOptions = new() { new("MonthlyStatement", "月结"), new("PerOrder", "单结"), new("Deposit", "定金"), new("FullPayment", "全款") } },
        new() { Key = "WoPlantGrade",        Label = "工厂牌号",     SortKey = "woplantgrade", FilterType = "string" },
        new() { Key = "WoSpecification",     Label = "成品规格",     SortKey = "wospecification", FilterType = "string" },
        new() { Key = "WoLengthStatus",      Label = "长度状态",     FilterType = "enum",
            EnumOptions = new() { new("Fixed", "定尺"), new("Range", "范围尺") } },
        new() { Key = "WoMaxLength",         Label = "最大长度",     SortKey = "womaxlength", FilterType = "number" },
        new() { Key = "WoTotalQuantity",     Label = "总支数",       SortKey = "wototalquantity", FilterType = "number" },
        new() { Key = "WoTotalWeight",       Label = "总重量",       SortKey = "wototalweight", FilterType = "number" },
        new() { Key = "WoDeliveryState",     Label = "交货状态",     FilterType = "enum",
            EnumOptions = new() { new("Raw", "原料"), new("SemiFinished", "半成品"), new("Finished", "成品") } },
        new() { Key = "WoTotalItemCount",    Label = "含项次数",     SortKey = "wototalitemcount", FilterType = "number" },
        new() { Key = "OrderDate",           Label = "下单日期",     SortKey = "orderdate", FilterType = "date" },
        new() { Key = "MaterialCategory",    Label = "物料分类",     SortKey = "materialcategory", FilterType = "string" },
        new() { Key = "PlantGrade",          Label = "厂内钢种",     SortKey = "plantgrade", FilterType = "string" },
        new() { Key = "Specification",       Label = "规格",         SortKey = "specification", FilterType = "string" },
        new() { Key = "UnitWeight",          Label = "单支重量",     SortKey = "unitweight", FilterType = "number" },
        new() { Key = "Quantity",            Label = "支数",         SortKey = "quantity", FilterType = "number" },
        new() { Key = "Weight",              Label = "采购重量",     SortKey = "weight", FilterType = "number" },
        new() { Key = "RequiredDate",        Label = "要求到货日",   SortKey = "requireddate", FilterType = "date" },
        new() { Key = "SupplierName",        Label = "供应商",       SortKey = "suppliername", FilterType = "string" },
        new() { Key = "Status",              Label = "状态",         FilterType = "enum",
            EnumOptions = new() { new("Open", "已下单"), new("Partial", "部分到货"), new("Completed", "已完成"), new("Cancelled", "已取消") } },
        new() { Key = "Received",            Label = "已到货" },
    };

    // ========== 列选择操作 ==========

    private async Task OnColumnToggle(ColumnDef col)
    {
        await SaveColumnPrefs();
    }

    private async Task SaveColumnPrefs()
    {
        await ColumnPrefs.SaveAsync("purchase_orders", null, _allColumns);
    }

    private async Task ResetColumnDisplay()
    {
        _allColumns = GetAllColumnDefs();
        await SaveColumnPrefs();
    }

    private async Task MoveColumnUp(ColumnDef col)
    {
        await SaveColumnPrefs();
    }

    private async Task MoveColumnDown(ColumnDef col)
    {
        await SaveColumnPrefs();
    }

    protected override async Task OnInitializedAsync()
    {
        // 先同步仓库数据（到货进度），再加载状态和检测不匹配
        await SyncAllAsync(silent: true);
        await LoadProcurementStatus();
        await LoadOrderMismatches();

        // 列定义与偏好加载
        _allColumns = GetAllColumnDefs();
        var saved = await ColumnPrefs.LoadAsync("purchase_orders", null);
        if (saved.Count > 0)
        {
            foreach (var s in saved)
            {
                var match = _allColumns.FirstOrDefault(c => c.Key == s.Key);
                if (match != null)
                    match.Visible = s.Visible;
            }
            var reordered = new List<ColumnDef>();
            foreach (var s in saved)
            {
                var match = _allColumns.FirstOrDefault(c => c.Key == s.Key);
                if (match != null && !reordered.Contains(match))
                    reordered.Add(match);
            }
            foreach (var c in _allColumns)
            {
                if (!reordered.Contains(c))
                    reordered.Add(c);
            }
            _allColumns = reordered;
        }

        await LoadAllDataAsync();
    }

    private async Task LoadAllDataAsync()
    {
        try
        {
            var result = await PurchaseService.GetAllListAsync();
            if (result.Success && result.Data != null)
            {
                _allItems = result.Data;
                _filteredItemsList = null;
                RefreshFilteredData();
            }
            else
            {
                Snackbar.Add(result.Message ?? "加载失败", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"加载失败: {ex.Message}", Severity.Error);
        }
        finally
        {
            StateHasChanged();
        }
    }

    private async Task LoadProcurementStatus()
    {
        try
        {
            var result = await PurchaseService.GetProcurementStatusAsync();
            if (result.Success && result.Data != null)
                procurementItems = result.Data;
            else if (!result.Success)
                Snackbar.Add($"加载用料计划执行状态失败: {result.Message}", Severity.Warning);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"加载用料计划执行状态异常: {ex.Message}", Severity.Error);
        }
    }

    private void ToggleProcurementStatus() => showProcurementStatus = !showProcurementStatus;

    private async Task LoadOrderMismatches()
    {
        try
        {
            var result = await PurchaseService.GetMismatchedOrdersAsync();
            if (result.Success && result.Data != null && result.Data.Count > 0)
            {
                mismatchItems = result.Data;
                var messages = mismatchItems.Select(item =>
                    $"采购单号 {item.OrderNo} 中，来源工单号：{string.Join("；", item.MismatchedWorkOrderNos)} 已不关联采购用料计划，需修改！");
                Snackbar.Add($"发现 {mismatchItems.Count} 条工单关联异常：\n{string.Join("\n", messages)}", Severity.Warning, config =>
                {
                    config.VisibleStateDuration = 20000;
                    config.Action = "忽略";
                });
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"检测工单关联异常: {ex.Message}", Severity.Error);
        }
    }

    // ========== 搜索 ==========

    private async Task OnSearchChanged(string value)
    {
        _searchKeyword = value ?? string.Empty;
        RefreshFilteredData();
    }

    // ========== ExcelFilter 回调 ==========

    private async Task OnColumnFilterChanged(string fieldKey, HashSet<string> selectedValues)
    {
        if (selectedValues.Count > 0)
            _columnFilters[fieldKey] = selectedValues;
        else
            _columnFilters.Remove(fieldKey);

        RefreshFilteredData();
        await SavePageStateAsync();
    }

    private async Task OnExcelSortRequested(string fieldKey, bool ascending)
    {
        sortColumn = fieldKey;
        sortDescending = !ascending;
        RefreshFilteredData();
        await SavePageStateAsync();
    }

    // ========== 客户端刷新 ==========

    private void RefreshFilteredData()
    {
        var query = _allItems.AsEnumerable();

        // 关键字搜索
        if (!string.IsNullOrWhiteSpace(_searchKeyword))
        {
            var kw = _searchKeyword;
            query = query.Where(x =>
                (x.OrderNo != null && x.OrderNo.Contains(kw, StringComparison.OrdinalIgnoreCase)) ||
                (x.MaterialCategory != null && x.MaterialCategory.Contains(kw, StringComparison.OrdinalIgnoreCase)) ||
                (x.PlantGrade != null && x.PlantGrade.Contains(kw, StringComparison.OrdinalIgnoreCase)) ||
                (x.Specification != null && x.Specification.Contains(kw, StringComparison.OrdinalIgnoreCase)) ||
                (x.SupplierName != null && x.SupplierName.Contains(kw, StringComparison.OrdinalIgnoreCase)) ||
                (x.SourceWorkOrderNo != null && x.SourceWorkOrderNo.Contains(kw, StringComparison.OrdinalIgnoreCase)) ||
                (x.WoSalesOrderNo != null && x.WoSalesOrderNo.Contains(kw, StringComparison.OrdinalIgnoreCase)) ||
                (x.WoProductionMainNo != null && x.WoProductionMainNo.Contains(kw, StringComparison.OrdinalIgnoreCase)) ||
                (x.WoProductionSubNo != null && x.WoProductionSubNo.Contains(kw, StringComparison.OrdinalIgnoreCase))
            );
        }

        // ExcelFilter 列筛选
        foreach (var cf in _columnFilters)
        {
            var fieldKey = cf.Key;
            var selected = cf.Value;
            // 对 Received 复合列跳过筛选
            if (fieldKey == "Received") continue;
            query = query.Where(x =>
            {
                var raw = GetCellRawValue(x, fieldKey);
                return raw != null && selected.Contains(raw);
            });
        }

        // 排序
        if (!string.IsNullOrEmpty(sortColumn))
        {
            query = sortColumn switch
            {
                "orderno" => sortDescending ? query.OrderByDescending(x => x.OrderNo) : query.OrderBy(x => x.OrderNo),
                "sourceworkorderno" => sortDescending ? query.OrderByDescending(x => x.SourceWorkOrderNo ?? "") : query.OrderBy(x => x.SourceWorkOrderNo ?? ""),
                "wosalesorderno" => sortDescending ? query.OrderByDescending(x => x.WoSalesOrderNo ?? "") : query.OrderBy(x => x.WoSalesOrderNo ?? ""),
                "woproductionmainno" => sortDescending ? query.OrderByDescending(x => x.WoProductionMainNo ?? "") : query.OrderBy(x => x.WoProductionMainNo ?? ""),
                "woproductionsubno" => sortDescending ? query.OrderByDescending(x => x.WoProductionSubNo ?? "") : query.OrderBy(x => x.WoProductionSubNo ?? ""),
                "wosigndate" => sortDescending ? query.OrderByDescending(x => x.WoSignDate) : query.OrderBy(x => x.WoSignDate),
                "wosalesman" => sortDescending ? query.OrderByDescending(x => x.WoSalesman ?? "") : query.OrderBy(x => x.WoSalesman ?? ""),
                "woendcustomer" => sortDescending ? query.OrderByDescending(x => x.WoEndCustomer ?? "") : query.OrderBy(x => x.WoEndCustomer ?? ""),
                "wodeliverydate" => sortDescending ? query.OrderByDescending(x => x.WoDeliveryDate) : query.OrderBy(x => x.WoDeliveryDate),
                "wodelaypenalty" => sortDescending ? query.OrderByDescending(x => x.WoDelayPenalty) : query.OrderBy(x => x.WoDelayPenalty),
                "wosettlementmethod" => sortDescending ? query.OrderByDescending(x => x.WoSettlementMethod) : query.OrderBy(x => x.WoSettlementMethod),
                "woplantgrade" => sortDescending ? query.OrderByDescending(x => x.WoPlantGrade ?? "") : query.OrderBy(x => x.WoPlantGrade ?? ""),
                "wospecification" => sortDescending ? query.OrderByDescending(x => x.WoSpecification ?? "") : query.OrderBy(x => x.WoSpecification ?? ""),
                "womaxlength" => sortDescending ? query.OrderByDescending(x => x.WoMaxLength) : query.OrderBy(x => x.WoMaxLength),
                "wototalquantity" => sortDescending ? query.OrderByDescending(x => x.WoTotalQuantity) : query.OrderBy(x => x.WoTotalQuantity),
                "wototalweight" => sortDescending ? query.OrderByDescending(x => x.WoTotalWeight) : query.OrderBy(x => x.WoTotalWeight),
                "wototalitemcount" => sortDescending ? query.OrderByDescending(x => x.WoTotalItemCount) : query.OrderBy(x => x.WoTotalItemCount),
                "orderdate" => sortDescending ? query.OrderByDescending(x => x.OrderDate) : query.OrderBy(x => x.OrderDate),
                "materialcategory" => sortDescending ? query.OrderByDescending(x => x.MaterialCategory) : query.OrderBy(x => x.MaterialCategory),
                "plantgrade" => sortDescending ? query.OrderByDescending(x => x.PlantGrade) : query.OrderBy(x => x.PlantGrade),
                "specification" => sortDescending ? query.OrderByDescending(x => x.Specification) : query.OrderBy(x => x.Specification),
                "unitweight" => sortDescending ? query.OrderByDescending(x => x.UnitWeight) : query.OrderBy(x => x.UnitWeight),
                "quantity" => sortDescending ? query.OrderByDescending(x => x.Quantity) : query.OrderBy(x => x.Quantity),
                "weight" => sortDescending ? query.OrderByDescending(x => x.Weight) : query.OrderBy(x => x.Weight),
                "requireddate" => sortDescending ? query.OrderByDescending(x => x.RequiredDate) : query.OrderBy(x => x.RequiredDate),
                "suppliername" => sortDescending ? query.OrderByDescending(x => x.SupplierName) : query.OrderBy(x => x.SupplierName),
                _ => sortDescending ? query.OrderByDescending(x => x.OrderNo) : query.OrderBy(x => x.OrderNo)
            };
        }

        _filteredItemsList = query.ToList();
        StateHasChanged();
    }

    // ========== 单元格原始值/显示值 ==========

    private string? GetCellRawValue(PurchaseOrderDto item, string key) => key switch
    {
        "OrderNo" => item.OrderNo,
        "SourceWorkOrderNo" => item.SourceWorkOrderNo,
        "WoSalesOrderNo" => item.WoSalesOrderNo,
        "WoProductionMainNo" => item.WoProductionMainNo,
        "WoProductionSubNo" => item.WoProductionSubNo,
        "WoSignDate" => item.WoSignDate?.ToString("yyyy-MM-dd"),
        "WoSalesman" => item.WoSalesman,
        "WoEndCustomer" => item.WoEndCustomer,
        "WoDeliveryDate" => item.WoDeliveryDate?.ToString("yyyy-MM-dd"),
