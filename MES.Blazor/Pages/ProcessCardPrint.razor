@page "/process-card-print"
@using MES.Core.DTOs
@using MES.Core.Models
@using MES.Blazor.Services
@using MES.Blazor.Helpers
@using Microsoft.AspNetCore.Authorization
@inject BatchService BatchService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject ColumnPrefsService ColumnPrefs
@inject IJSRuntime JS
@attribute [Authorize(Roles = "BatchStaff,BatchDirector,Admin")]

<MudContainer MaxWidth="MaxWidth.False" Class="mt-4 pl-0">
    <!-- 页眉 -->
    <MudCard Class="mb-4 compact-card">
        <MudCardHeader>
            <CardHeaderContent>
                <MudText Typo="Typo.h5" Class="font-weight-bold">
                    <MudIcon Icon="@Icons.Material.Filled.Print" Class="mr-2" Color="Color.Primary" />
                    工艺流转卡打印
                </MudText>
            </CardHeaderContent>
            <CardHeaderActions>
                <MudButton Variant="Variant.Filled" Color="Color.Info"
                           StartIcon="@Icons.Material.Filled.Print"
                           Disabled="@(!selectedIds.Any())"
                           OnClick="PrintSelected"
                           Class="mr-2">
                    打印选中 (@selectedIds.Count)
                </MudButton>
                <MudButton Variant="Variant.Text" Color="Color.Info"
                           StartIcon="@Icons.Material.Filled.Print"
                           OnClick="PrintAll">
                    打印全部
                </MudButton>
                <MudButton Variant="Variant.Text" Color="Color.Default"
                           StartIcon="@Icons.Material.Filled.ArrowBack"
                           OnClick='() => Navigation.NavigateTo("/batches")'>
                    返回批次列表
                </MudButton>
            </CardHeaderActions>
        </MudCardHeader>
    </MudCard>

    <!-- 格式设置面板 -->
    <MudCard Class="mb-4 compact-card">
        <MudCardHeader>
            <CardHeaderContent>
                <div class="d-flex align-center">
                    <MudIcon Icon="@Icons.Material.Filled.Settings" Class="mr-1" Color="Color.Warning" />
                    <MudText Typo="Typo.h6" Class="font-weight-bold">格式设置</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="ml-2">选择需要打印的区块和字段</MudText>
                    <MudButton Variant="Variant.Text" Size="Size.Small" Color="Color.Warning"
                               StartIcon="@Icons.Material.Filled.Refresh" OnClick="ResetColumnDefaults" Class="ml-4">重置</MudButton>
                </div>
            </CardHeaderContent>
            <CardHeaderActions>
                <MudButton Variant="Variant.Outlined" Size="Size.Small"
                           StartIcon="@(showSettings ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)"
                           OnClick="() => showSettings = !showSettings">
                    @(showSettings ? "收起" : "展开")
                </MudButton>
            </CardHeaderActions>
        </MudCardHeader>
        @if (showSettings)
        {
            <MudCardContent>
                @foreach (var blockGroup in allColumns.GroupBy(c => c.BlockKey))
                {
                    <MudText Typo="Typo.subtitle2" Class="font-weight-bold mb-1 mt-2" Style="color:#37474F;">
                        <MudIcon Icon="@GetBlockIcon(blockGroup.Key)" Class="mr-1" Size="Size.Small" />
                        @GetBlockTitle(blockGroup.Key)
                    </MudText>
                    <div class="d-flex flex-wrap" style="gap: 4px 12px; padding-left: 12px;">
                        @foreach (var col in blockGroup)
                        {
                            <div class="d-flex align-center" style="min-width:120px;">
                                <MudSwitch Value="col.Visible"
                                           ValueChanged="@((bool v) => ToggleColumn(v, col))"
                                           Color="Color.Primary" Dense="true" Size="Size.Small" />
                                <MudText Typo="Typo.body2" Class="ml-1">@col.Label</MudText>
                            </div>
                        }
                    </div>
                }
            </MudCardContent>
        }
    </MudCard>

    <!-- 批次列表 -->
    <MudCard Class="compact-card">
        <MudCardHeader>
            <CardHeaderContent>
                <MudText Typo="Typo.h6" Class="font-weight-bold">
                    <MudIcon Icon="@Icons.Material.Filled.List" Class="mr-1" Color="Color.Primary" />
                    选择批次
                </MudText>
            </CardHeaderContent>
        </MudCardHeader>
        <MudCardContent>
            <!-- 搜索栏 -->
            <MudGrid>
                <MudItem xs="12" md="6">
                    <MudTextField T="string"
                                  Label="模糊搜索 - 生产编号/挂牌号/工单号/订单号/主号/次号"
                                  Value="_searchKeyword"
                                  ValueChanged="@OnSearchChanged"
                                  Immediate="true"
                                  DebounceInterval="500"
                                  Clearable="true"
                                  ClearButton="true"
                                  Adornment="Adornment.End"
                                  AdornmentIcon="@Icons.Material.Filled.Search" />
                </MudItem>
                <MudItem xs="6" md="3" Class="d-flex align-center">
                    <MudText Typo="Typo.body2">共 @(_filteredItems?.Count ?? 0) 条记录</MudText>
                </MudItem>
            </MudGrid>

            <!-- 数据表格 -->
            <MudTable @ref="table"
                      T="ProductionBatchListDto"
                      Items="@_filteredItems"
                      Dense="true"
                      Hover="true"
                      Class="mt-2 auto-table"
                      Elevation="0"
                      RowsPerPage="10"
                      RowsPerPageLabel="每页行数:">
                <ToolBarContent>
                    <ColumnDisplaySelect Columns="_allColumns"
                                         OnColumnToggle="OnColumnToggle"
                                         OnMoveUp="MoveColumnUp"
                                         OnMoveDown="MoveColumnDown" />
                    <MudButton Variant="Variant.Text" Size="Size.Small"
                               Color="Color.Default"
                               StartIcon="@Icons.Material.Filled.RestartAlt"
                               OnClick="ResetColumnDisplay" Class="ml-2">
                        重置
                    </MudButton>
                    <MudSpacer />
                    <MudText Typo="Typo.body2" Class="ml-auto">
                        共 @(_filteredItems?.Count ?? 0) 条记录
                    </MudText>
                </ToolBarContent>
                <HeaderContent>
                    <MudTh Style="width: 40px;">
                        <MudCheckBox T="bool" @bind-Value="allSelected" Dense="true" />
                    </MudTh>
                    @foreach (var col in _visibleColumns)
                    {
                        <MudTh>
                            <div style="display:inline-flex; align-items:center; gap:4px;">
                                <span class="th-label">@col.Label</span>
                                @if (col.FilterType != null)
                                {
                                    <ExcelFilter T="ProductionBatchListDto"
                                                 Label="@col.Label"
                                                 FieldKey="@col.Key"
                                                 AllItems="@_allItems"
                                                 ActiveFilterValues="@(_columnFilters.GetValueOrDefault(col.Key))"
                                                 DisplaySelector="@(x => GetCellDisplayText(x, col.Key))"
                                                 RawValueSelector="@(x => GetCellRawValue(x, col.Key))"
                                                 FilterChanged="@(args => OnColumnFilterChanged(args.fieldKey, args.selectedValues))"
                                                 SortRequested="@(args => OnExcelSortRequested(args.fieldKey, args.ascending))" />
                                }
                            </div>
                        </MudTh>
                    }
                    <MudTh>操作</MudTh>
                </HeaderContent>
                <RowTemplate Context="item">
                    <MudTd Style="width: 40px;">
                        <MudCheckBox T="bool"
                                     Value="@selectedIds.Contains(item.Id)"
                                     ValueChanged="@((v) => { if(v) selectedIds.Add(item.Id); else selectedIds.Remove(item.Id); _allSelected = _filteredItems.Any() && _filteredItems.All(i => selectedIds.Contains(i.Id)); StateHasChanged(); })"
                                     Dense="true" />
                    </MudTd>
                    @foreach (var col in _visibleColumns)
                    {
                        <MudTd>@RenderCell(item, col)</MudTd>
                    }
                    <MudTd>
                        <MudIconButton Icon="@Icons.Material.Filled.Visibility"
                                       Color="Color.Info"
                                       Size="Size.Small"
                                       OnClick="() => NavigateToBatch(item.Id)" />
                    </MudTd>
                </RowTemplate>
                <PagerContent>
                    <MudTablePager PageSizeOptions="new int[]{10,15,25,50,100}" />
                </PagerContent>
            </MudTable>
        </MudCardContent>
    </MudCard>
</MudContainer>

@code {
    private MudTable<ProductionBatchListDto>? table;
    private List<ProductionBatchListDto> _allItems = new();
    private List<ProductionBatchListDto>? _filteredItemsList;
    private List<ProductionBatchListDto> _filteredItems => _filteredItemsList ?? _allItems;
    private HashSet<int> selectedIds = new();
    private bool _allSelected;
    private bool allSelected
    {
        get => _allSelected;
        set
        {
            if (_allSelected == value) return;
            _allSelected = value;
            if (value)
            {
                foreach (var item in _filteredItems)
                    selectedIds.Add(item.Id);
            }
            else
            {
                selectedIds.Clear();
            }
            StateHasChanged();
        }
    }
