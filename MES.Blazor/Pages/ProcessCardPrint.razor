    // ========== 初始化 ==========

    protected override async Task OnInitializedAsync()
    {
        // 加载批次列表列偏好
        _allColumns = GetAllColumnDefs();
        var savedList = await ColumnPrefs.LoadAsync("batches", null);
        if (savedList.Count > 0)
        {
            foreach (var s in savedList)
            {
                var match = _allColumns.FirstOrDefault(c => c.Key == s.Key);
                if (match != null)
                    match.Visible = s.Visible;
            }
            var reordered = new List<ColumnDef>();
            foreach (var s in savedList)
            {
                var match = _allColumns.FirstOrDefault(c => c.Key == s.Key);
                if (match != null && !reordered.Contains(match))
                    reordered.Add(match);
            }
            foreach (var c in _allColumns)
            {
                if (!reordered.Contains(c))
                    reordered.Add(c);
            }
            _allColumns = reordered;
        }

        // 加载格式设置列偏好
        var defaults = GetDefaultColumns();
        allColumns = defaults.Select(d => new ProcessCardColumnDef
        {
            BlockKey = d.BlockKey, Key = d.Key, Label = d.Label, Visible = d.Visible
        }).ToList();
        var saved = await ColumnPrefs.LoadAsync(PrefsKey, null);
        if (saved.Count > 0)
        {
            var savedKeys = new HashSet<string>(saved.Select(s => s.Key), StringComparer.OrdinalIgnoreCase);
            foreach (var savedCol in saved)
            {
                var match = allColumns.FirstOrDefault(c =>
                    c.Key.Equals(savedCol.Key, StringComparison.OrdinalIgnoreCase));
                if (match != null) match.Visible = savedCol.Visible;
            }
            // 确保新增字段（默认 Visible=true 但不在已保存偏好中）保持可见
            foreach (var def in defaults)
            {
                if (!savedKeys.Contains(def.Key) && def.Visible)
                {
                    var match = allColumns.FirstOrDefault(c =>
                        c.Key.Equals(def.Key, StringComparison.OrdinalIgnoreCase));
                    if (match != null) match.Visible = true;
                }
            }
        }

        await LoadAllDataAsync();
    }

    private async Task SaveFormatColumnPrefs()
    {
        var prefs = allColumns.Select(c => new ColumnDef { Key = c.Key, Visible = c.Visible }).ToList();
        await ColumnPrefs.SaveAsync(PrefsKey, null, prefs);
    }

    private void ToggleColumn(bool v, ProcessCardColumnDef col)
    {
        col.Visible = v;
        _ = SaveFormatColumnPrefs();
    }

    private async Task ResetColumnDefaults()
    {
        allColumns = GetDefaultColumns();
        await SaveFormatColumnPrefs();
        Snackbar.Add("已重置列显示", Severity.Normal);
    }

    // ========== 数据加载 ==========

    private async Task LoadAllDataAsync()
    {
        try
        {
            _allItems = await BatchService.GetAllBatchListAsync();
            _filteredItemsList = null;
            RefreshFilteredData();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"加载失败: {ex.Message}", Severity.Error);
        }
        finally
        {
            StateHasChanged();
        }
    }

    // ========== 搜索/筛选 ==========

    private async Task OnSearchChanged(string value)
    {
        _searchKeyword = value ?? string.Empty;
        RefreshFilteredData();
    }

    // ========== ExcelFilter 回调 ==========

    private async Task OnColumnFilterChanged(string fieldKey, HashSet<string> selectedValues)
    {
        if (selectedValues.Count > 0)
            _columnFilters[fieldKey] = selectedValues;
        else
            _columnFilters.Remove(fieldKey);

        RefreshFilteredData();
    }

    private async Task OnExcelSortRequested(string fieldKey, bool ascending)
    {
        sortColumn = fieldKey;
        sortDescending = !ascending;
        RefreshFilteredData();
    }

    // ========== 客户端刷新 ==========

    private void RefreshFilteredData()
    {
        var query = _allItems.AsEnumerable();

        // 关键字搜索
        if (!string.IsNullOrWhiteSpace(_searchKeyword))
        {
            var kw = _searchKeyword;
            query = query.Where(x =>
                (x.BatchNo != null && x.BatchNo.Contains(kw, StringComparison.OrdinalIgnoreCase)) ||
                (x.TagNo != null && x.TagNo.Contains(kw, StringComparison.OrdinalIgnoreCase)) ||
                (x.WorkOrderNo != null && x.WorkOrderNo.Contains(kw, StringComparison.OrdinalIgnoreCase)) ||
                (x.SalesOrderNo != null && x.SalesOrderNo.Contains(kw, StringComparison.OrdinalIgnoreCase)) ||
                (x.ProductionMainNo != null && x.ProductionMainNo.Contains(kw, StringComparison.OrdinalIgnoreCase)) ||
                (x.ProductionSubNo != null && x.ProductionSubNo.Contains(kw, StringComparison.OrdinalIgnoreCase))
            );
        }

        // ExcelFilter 列筛选
        foreach (var cf in _columnFilters)
        {
            var fieldKey = cf.Key;
            var selected = cf.Value;
            query = query.Where(x =>
            {
                var raw = GetCellRawValue(x, fieldKey);
                return raw != null && selected.Contains(raw);
            });
        }

        // 排序
        if (!string.IsNullOrEmpty(sortColumn))
        {
            query = sortColumn switch
            {
                "batchno" => sortDescending ? query.OrderByDescending(x => x.BatchNo) : query.OrderBy(x => x.BatchNo),
                "tagno" => sortDescending ? query.OrderByDescending(x => x.TagNo) : query.OrderBy(x => x.TagNo),
                "createdtime" => sortDescending ? query.OrderByDescending(x => x.CreatedTime) : query.OrderBy(x => x.CreatedTime),
                "workorderno" => sortDescending ? query.OrderByDescending(x => x.WorkOrderNo) : query.OrderBy(x => x.WorkOrderNo),
                "salesorderno" => sortDescending ? query.OrderByDescending(x => x.SalesOrderNo) : query.OrderBy(x => x.SalesOrderNo),
                "productionmainno" => sortDescending ? query.OrderByDescending(x => x.ProductionMainNo) : query.OrderBy(x => x.ProductionMainNo),
                "productionsubno" => sortDescending ? query.OrderByDescending(x => x.ProductionSubNo) : query.OrderBy(x => x.ProductionSubNo),
                "productiontype" => sortDescending ? query.OrderByDescending(x => x.ProductionType) : query.OrderBy(x => x.ProductionType),
                "manufacturingitem" => sortDescending ? query.OrderByDescending(x => x.ManufacturingItem) : query.OrderBy(x => x.ManufacturingItem),
                "status" => sortDescending ? query.OrderByDescending(x => x.Status) : query.OrderBy(x => x.Status),
                "currentexecdate" => sortDescending ? query.OrderByDescending(x => x.CurrentExecDate) : query.OrderBy(x => x.CurrentExecDate),
                "currentgroupname" => sortDescending ? query.OrderByDescending(x => x.CurrentGroupName) : query.OrderBy(x => x.CurrentGroupName),
                "currentsectionname" => sortDescending ? query.OrderByDescending(x => x.CurrentSectionName) : query.OrderBy(x => x.CurrentSectionName),
                "currentequipmentname" => sortDescending ? query.OrderByDescending(x => x.CurrentEquipmentName) : query.OrderBy(x => x.CurrentEquipmentName),
                "currentoutsource" => sortDescending ? query.OrderByDescending(x => x.CurrentOutsource) : query.OrderBy(x => x.CurrentOutsource),
                "currentspec" => sortDescending ? query.OrderByDescending(x => x.CurrentSpec) : query.OrderBy(x => x.CurrentSpec),
                "nextsectionname" => sortDescending ? query.OrderByDescending(x => x.NextSectionName) : query.OrderBy(x => x.NextSectionName),
                "correspondingspec" => sortDescending ? query.OrderByDescending(x => x.CorrespondingSpec) : query.OrderBy(x => x.CorrespondingSpec),
                _ => sortDescending ? query.OrderByDescending(x => x.BatchNo) : query.OrderBy(x => x.BatchNo)
            };
        }

        _filteredItemsList = query.ToList();
        StateHasChanged();
    }

    // ========== 单元格原始值/显示值 ==========

    private string? GetCellRawValue(ProductionBatchListDto item, string key) => key switch
    {
        "BatchNo" => item.BatchNo,
        "TagNo" => item.TagNo,
        "CreatedTime" => item.CreatedTime.LocalDateTime.ToString("yyyy-MM-dd HH:mm"),
        "WorkOrderNo" => item.WorkOrderNo,
        "SalesOrderNo" => item.SalesOrderNo,
        "ProductionMainNo" => item.ProductionMainNo,
        "ProductionSubNo" => item.ProductionSubNo,
        "ProductionType" => item.ProductionType,
        "ManufacturingItem" => item.ManufacturingItem,
        "Status" => item.Status,
        "CurrentExecDate" => item.CurrentExecDate?.ToString("yyyy-MM-dd"),
        "CurrentGroupName" => item.CurrentGroupName,
        "CurrentSectionName" => item.CurrentSectionName,
        "CurrentEquipmentName" => item.CurrentEquipmentName,
        "CurrentOutsource" => item.CurrentOutsource,
        "CurrentSpec" => item.CurrentSpec,
        "NextSectionName" => item.NextSectionName,
        "CorrespondingSpec" => item.CorrespondingSpec,
        _ => null
    };

    private string? GetCellDisplayText(ProductionBatchListDto item, string key) => key switch
    {
        "ProductionType" => DisplayHelper.GetProductionTypeText(item.ProductionType),
        "ManufacturingItem" => DisplayHelper.GetManufacturingItemText(item.ManufacturingItem),
        "Status" => DisplayHelper.GetBatchStatusText(item.Status),
        _ => GetCellRawValue(item, key) ?? ""
    };

    // ========== 单元格渲染 ==========

    private RenderFragment RenderCell(ProductionBatchListDto item, ColumnDef col) => builder =>
    {
        switch (col.Key)
        {
            case "BatchNo":
                builder.OpenComponent<MudLink>(0);
                builder.AddAttribute(1, "Typo", Typo.body2);
                builder.AddAttribute(2, "OnClick", EventCallback.Factory.Create<MouseEventArgs?>(this, () => Navigation.NavigateTo($"/batches/{item.Id}")));
                builder.AddAttribute(3, "ChildContent", (RenderFragment)(b2 => b2.AddContent(0, item.BatchNo)));
                builder.CloseComponent();
                break;
            case "Status":
                builder.OpenComponent<MudChip>(0);
                builder.AddAttribute(1, "Size", Size.Small);
                builder.AddAttribute(2, "Color", DisplayHelper.GetBatchStatusColor(item.Status));
                builder.AddAttribute(3, "ChildContent", (RenderFragment)(b2 => b2.AddContent(0, DisplayHelper.GetBatchStatusText(item.Status))));
                builder.CloseComponent();
                break;
            case "CreatedTime":
                builder.AddContent(0, item.CreatedTime.LocalDateTime.ToString("yyyy-MM-dd HH:mm"));
                break;
            case "CurrentExecDate":
                builder.AddContent(0, item.CurrentExecDate?.ToString("yyyy-MM-dd") ?? "");
                break;
            default:
                var val = GetColumnValue(item, col.Key);
                builder.AddContent(0, val);
                break;
        }
    };

    private static string GetColumnValue(ProductionBatchListDto item, string key) => key switch
    {
        "TagNo" => item.TagNo ?? "",
        "WorkOrderNo" => item.WorkOrderNo,
        "SalesOrderNo" => item.SalesOrderNo,
        "ProductionMainNo" => item.ProductionMainNo,
        "ProductionSubNo" => item.ProductionSubNo ?? "",
        "ProductionType" => DisplayHelper.GetProductionTypeText(item.ProductionType),
        "CurrentGroupName" => item.CurrentGroupName ?? "",
        "CurrentSectionName" => item.CurrentSectionName ?? "",
        "CurrentEquipmentName" => item.CurrentEquipmentName ?? "",
        "CurrentOutsource" => item.CurrentOutsource ?? "",
        "CurrentSpec" => item.CurrentSpec ?? "",
        "NextSectionName" => item.NextSectionName ?? "",
        "CorrespondingSpec" => item.CorrespondingSpec ?? "",
        "ManufacturingItem" => DisplayHelper.GetManufacturingItemText(item.ManufacturingItem),
        _ => ""
    };

    private void NavigateToBatch(int id) => Navigation.NavigateTo($"/batches/{id}");

    // ========== 打印 ==========

    private async Task PrintSelected()
    {
        if (!selectedIds.Any())
        {
            Snackbar.Add("请先选择要打印的批次", Severity.Warning);
            return;
        }

        if (!allColumns.Any(c => c.Visible))
        {
            Snackbar.Add("请先在格式设置中选择至少一个字段", Severity.Warning);
            return;
        }

        try
        {
            var request = new ProcessCardPrintRequest
            {
                Ids = selectedIds.ToArray(),
                Columns = allColumns.ToList()
            };
            var result = await BatchService.PrintProcessCardAsync(request);
            if (result.Success && result.Data != null)
                await JS.InvokeVoidAsync("openPdf", result.Data);
            else
                Snackbar.Add(result.Message ?? "打印失败", Severity.Error);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"打印失败: {ex.Message}", Severity.Error);
        }
    }

    private async Task PrintAll()
    {
        if (!allColumns.Any(c => c.Visible))
        {
            Snackbar.Add("请先在格式设置中选择至少一个字段", Severity.Warning);
            return;
        }

        try
        {
            var request = new ProcessCardPrintRequest
            {
                Ids = Array.Empty<int>(),
                Columns = allColumns.ToList()
            };
            var result = await BatchService.PrintProcessCardAsync(request);
            if (result.Success && result.Data != null)
                await JS.InvokeVoidAsync("openPdf", result.Data);
            else
                Snackbar.Add(result.Message ?? "打印失败", Severity.Error);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"打印失败: {ex.Message}", Severity.Error);
        }
    }

