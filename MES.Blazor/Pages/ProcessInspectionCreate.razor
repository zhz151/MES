                builder.AddAttribute(1, "Dense", true);
                builder.AddAttribute(2, "Variant", Variant.Outlined);
                builder.AddAttribute(3, "Size", Size.Small);
                builder.AddAttribute(5, "HideSpinButtons",true);
                builder.AddAttribute(5, "Format", "G29");
                builder.AddAttribute(6, "Value", r.QualifiedWeight);
                builder.AddAttribute(7, "ValueChanged", EventCallback.Factory.Create<decimal?>(this, v => r.QualifiedWeight = v));
                builder.AddAttribute(8, "Clearable", true);
                builder.CloseComponent();
                break;
            case "DefectReworkQuantity":
                builder.OpenComponent<MudNumericField<int?>>(0);
                builder.AddAttribute(1, "Dense", true);
                builder.AddAttribute(2, "Variant", Variant.Outlined);
                builder.AddAttribute(3, "Size", Size.Small);
                builder.AddAttribute(5, "HideSpinButtons",true);
                builder.AddAttribute(5, "Value", r.DefectReworkQuantity);
                builder.AddAttribute(6, "ValueChanged", EventCallback.Factory.Create<int?>(this, v => r.DefectReworkQuantity = v));
                builder.AddAttribute(7, "Clearable", true);
                builder.CloseComponent();
                break;
            case "DefectWarehouseQuantity":
                builder.OpenComponent<MudNumericField<int?>>(0);
                builder.AddAttribute(1, "Dense", true);
                builder.AddAttribute(2, "Variant", Variant.Outlined);
                builder.AddAttribute(3, "Size", Size.Small);
                builder.AddAttribute(5, "HideSpinButtons",true);
                builder.AddAttribute(5, "Value", r.DefectWarehouseQuantity);
                builder.AddAttribute(6, "ValueChanged", EventCallback.Factory.Create<int?>(this, v => r.DefectWarehouseQuantity = v));
                builder.AddAttribute(7, "Clearable", true);
                builder.CloseComponent();
                break;
            case "DefectScrapQuantity":
                builder.OpenComponent<MudNumericField<int?>>(0);
                builder.AddAttribute(1, "Dense", true);
                builder.AddAttribute(2, "Variant", Variant.Outlined);
                builder.AddAttribute(3, "Size", Size.Small);
                builder.AddAttribute(5, "HideSpinButtons",true);
                builder.AddAttribute(5, "Value", r.DefectScrapQuantity);
                builder.AddAttribute(6, "ValueChanged", EventCallback.Factory.Create<int?>(this, v => r.DefectScrapQuantity = v));
                builder.AddAttribute(7, "Clearable", true);
                builder.CloseComponent();
                break;
            case "DefectDescription":
                builder.OpenComponent<MudTextField<string>>(0);
                builder.AddAttribute(1, "Dense", true);
                builder.AddAttribute(2, "Variant", Variant.Outlined);
                builder.AddAttribute(3, "Size", Size.Small);
                builder.AddAttribute(5, "Value",r.DefectDescription);
                builder.AddAttribute(5, "ValueChanged", EventCallback.Factory.Create<string?>(this, v => r.DefectDescription = v));
                builder.CloseComponent();
                break;
            case "SourceUnit":
                builder.OpenComponent<MudTextField<string>>(0);
                builder.AddAttribute(1, "Dense", true);
                builder.AddAttribute(2, "Variant", Variant.Outlined);
                builder.AddAttribute(3, "Size", Size.Small);
                builder.AddAttribute(5, "Value",r.SourceUnit);
                builder.AddAttribute(5, "ValueChanged", EventCallback.Factory.Create<string?>(this, v => r.SourceUnit = v));
                builder.CloseComponent();
                break;
            case "TagNo":
                builder.OpenComponent<MudTextField<string>>(0);
                builder.AddAttribute(1, "Dense", true);
                builder.AddAttribute(2, "Variant", Variant.Outlined);
                builder.AddAttribute(3, "Size", Size.Small);
                builder.AddAttribute(5, "Value",r.TagNo);
                builder.AddAttribute(5, "ValueChanged", EventCallback.Factory.Create<string?>(this, v => r.TagNo = v));
                builder.CloseComponent();
                break;
            case "PlantGrade":
                builder.OpenComponent<MudTextField<string>>(0);
                builder.AddAttribute(1, "Dense", true);
                builder.AddAttribute(2, "Variant", Variant.Outlined);
                builder.AddAttribute(3, "Size", Size.Small);
                builder.AddAttribute(5, "Value",r.PlantGrade);
                builder.AddAttribute(5, "ValueChanged", EventCallback.Factory.Create<string?>(this, v => r.PlantGrade = v));
                builder.CloseComponent();
                break;
            case "Remark":
                builder.OpenComponent<MudTextField<string>>(0);
                builder.AddAttribute(1, "Dense", true);
                builder.AddAttribute(2, "Variant", Variant.Outlined);
                builder.AddAttribute(3, "Size", Size.Small);
                builder.AddAttribute(5, "Value",r.Remark);
                builder.AddAttribute(5, "ValueChanged", EventCallback.Factory.Create<string?>(this, v => r.Remark = v));
                builder.CloseComponent();
                break;
            default:
                builder.AddContent(0, "");
                break;
        }
    };
}
