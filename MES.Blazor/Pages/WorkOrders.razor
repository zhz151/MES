@page "/workorders"
@using MES.Blazor.Services
@using MES.Core.DTOs
@using MES.Core.Enums
@using MES.Core.Models
@using Microsoft.AspNetCore.Authorization
@using MES.Blazor.Shared
@inject WorkOrderService WorkOrderService
@inject NotificationService NotificationService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject IJSRuntime JS
@inject ColumnPrefsService ColumnPrefs
@attribute [Authorize(Roles = "WorkOrderStaff,WorkOrderDirector,Admin")]

<MudContainer MaxWidth="MaxWidth.False" Class="mt-4 pl-0">
    <!-- 页面顶部工具栏（铃铛图标和刷新） -->
    <div class="d-flex justify-space-between align-center mb-4">
        <MudText Typo="Typo.h5" Class="font-weight-bold">
            <MudIcon Icon="@Icons.Material.Filled.Assignment" Class="mr-2" Color="Color.Primary" />
            工单管理
        </MudText>
        <div class="d-flex align-center">
            <MudButton Variant="Variant.Filled"
                       Color="Color.Info"
                       StartIcon="@Icons.Material.Filled.Sync"
                       OnClick="CheckAllOrderChange"
                       Loading="@isSyncing"
                       Disabled="@isSyncing"
                       Class="ml-2">
                即时更新
            </MudButton>
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Refresh"
                       OnClick="Search"
                       Class="ml-2">
                刷新
            </MudButton>
        </div>
    </div>

    <!-- 订单变更通知提醒 -->
    @if (_orderChangeNotices is { Count: > 0 })
    {
        <MudAlert Severity="Severity.Warning" Variant="Variant.Filled" Class="mb-4">
            <div class="d-flex justify-space-between align-center">
                <div>
                    @foreach (var notice in _orderChangeNotices)
                    {
                        <div>@notice.Content</div>
                    }
                </div>
                <MudButton Variant="Variant.Text" Size="Size.Small" Color="Color.Inherit" OnClick="DismissOrderChangeNotices">全部忽略</MudButton>
            </div>
        </MudAlert>
    }

    <!-- 订单删除通知提醒 -->
    @if (_orderDeletedNotices is { Count: > 0 })
    {
        <MudAlert Severity="Severity.Warning" Variant="Variant.Filled" Class="mb-4">
            <div class="d-flex justify-space-between align-center">
                <div>
                    @foreach (var notice in _orderDeletedNotices)
                    {
                        <div>@notice.Content</div>
                    }
                </div>
                <MudButton Variant="Variant.Text" Size="Size.Small" Color="Color.Inherit" OnClick="DismissOrderDeletedNotices">全部忽略</MudButton>
            </div>
        </MudAlert>
    }

    <!-- 订单已取消-工单待删除区域 -->
    @if (cancelledOrders.Any())
    {
        <MudCard Class="mb-4" Style="border-left: 4px solid var(--mud-palette-error);">
            <MudCardHeader>
                <CardHeaderContent>
                    <MudText Typo="Typo.subtitle1" Color="Color.Error">
                        <MudIcon Icon="@Icons.Material.Filled.Warning" Class="mr-2" Size="Size.Small" />
                        订单已取消-工单待删除
                    </MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">
                        以下订单已取消，但关联的工单尚未删除，请点击订单号进行软删除
                    </MudText>
                </CardHeaderContent>
            </MudCardHeader>
            <MudCardContent>
                <MudGrid>
                    @foreach (var item in cancelledOrders)
                    {
                        <MudItem xs="12" md="6" lg="4">
                            <MudPaper Class="pa-3 d-flex justify-space-between align-center" Elevation="0" Style="background-color: #fff3f3;">
                                <div>
                                    <MudText Typo="Typo.body2">
                                        <strong>订单号：</strong>
                                        <MudLink Typo="Typo.body2" Color="Color.Error" Underline="Underline.Always"
                                                 OnClick="() => SoftDeleteWorkOrder(item.WorkOrderId, item.OrderNumber)">
                                            @item.OrderNumber
                                        </MudLink>
                                    </MudText>
                                    <MudText Typo="Typo.body2">签订日期：@item.SignDate.ToString("yyyy-MM-dd")</MudText>
                                    <MudText Typo="Typo.body2">业务员：@item.Salesman</MudText>
                                    <MudText Typo="Typo.body2">客户名称：@item.CustomerName</MudText>
                                </div>
                                <MudChip Size="Size.Small" Color="Color.Error">待删除</MudChip>
                            </MudPaper>
                        </MudItem>
                    }
                </MudGrid>
            </MudCardContent>
        </MudCard>
    }

    <MudCard>
        <MudCardContent>
            <!-- 筛选栏 -->
            <MudGrid>
                <MudItem xs="12" md="6">
                    <MudTextField T="string"
                                  Label="模糊搜索 - 订单号/客户名称/业务员/最终客户/延期罚款"
                                  Value="@searchKeyword"
                                  ValueChanged="@OnSearchChanged"
                                  Immediate="true"
                                  DebounceInterval="500"
                                  Clearable="true"
                                  ClearButton="true"
                                  Adornment="Adornment.End"
                                  AdornmentIcon="@Icons.Material.Filled.Search" />
                </MudItem>
                <MudItem xs="12" md="3">
                    <MudSelect T="string" Label="工单状态" Value="@selectedStatus" ValueChanged="@OnStatusFilterChanged">
                        <MudSelectItem Value="@("All")">全部</MudSelectItem>
                        <MudSelectItem Value="@(WorkOrderStatus.NotGenerated.ToString())">未编制</MudSelectItem>
                        <MudSelectItem Value="@(WorkOrderStatus.Confirmed.ToString())">已确定</MudSelectItem>
                        <MudSelectItem Value="@(WorkOrderStatus.Pending.ToString())">待修正</MudSelectItem>
                        <MudSelectItem Value="@(WorkOrderStatus.Cancelled.ToString())">已取消</MudSelectItem>
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" md="3">
                    <!-- 占位，保持布局 -->
                </MudItem>
            </MudGrid>

            <!-- 数据表格 -->
            <div id="workorders-list-table">
            <MudTable @ref="table"
                      T="OrderWorkOrderStatusDto"
                      ServerData="OnServerData"
                      Loading="@isLoading"
                      Dense="true"
                      Hover="true"
                      Class="mt-4 auto-table"
                      Elevation="0"
                      RowsPerPageLabel="每页行数:">
                <ToolBarContent>
                    <ColumnDisplaySelect Columns="_allColumns"
                                         OnColumnToggle="OnColumnToggle"
                                         OnMoveUp="MoveColumnUp"
                                         OnMoveDown="MoveColumnDown" />
                    <MudButton Variant="Variant.Text" Size="Size.Small"
                               Color="Color.Default"
                               StartIcon="@Icons.Material.Filled.RestartAlt"
                               OnClick="ResetColumnDisplay" Class="ml-2">
                        重置
                    </MudButton>
                    <MudSpacer />
                    <MudButton Variant="Variant.Outlined"
                               Size="Size.Small"
                               Color="Color.Info"
                               StartIcon="@Icons.Material.Filled.Print"
                               Disabled="@(!selectedOrderNos.Any())"
                               OnClick="PrintSelected">
                        打印选中 (@selectedOrderNos.Count)
                    </MudButton>
                    <MudButton Variant="Variant.Text"
                               Size="Size.Small"
                               Color="Color.Info"
                               StartIcon="@Icons.Material.Filled.Print"
                               OnClick="PrintAll">
                        打印全部
                    </MudButton>
                    <MudText Typo="Typo.body2" Class="ml-2">
                        共 @totalCount 条记录
                    </MudText>
                </ToolBarContent>
                <HeaderContent>
                    <MudTh Style="width: 40px;">
                        <MudCheckBox T="bool" @bind-Value="allSelected" Dense="true" />
                    </MudTh>
                    @foreach (var col in _visibleColumns)
                    {
                        <MudTh>
                            @if (!string.IsNullOrEmpty(col.SortKey))
                            {
                                <span @onclick='() => ToggleSort(col.SortKey)' class="sortable-header">
                                    @col.Label
                                    @if (sortColumn == col.SortKey)
                                    {
                                        <span class="sort-arrow">@GetSortIndicator(col.SortKey)</span>
                                    }
                                </span>
                            }
                            else
                            {
                                <span class="th-label">@col.Label</span>
                            }
                        </MudTh>
                    }
                    <MudTh>操作</MudTh>
                </HeaderContent>
                <RowTemplate Context="order">
                    <MudTd Style="width: 40px;">
                        <MudCheckBox T="bool"
                                     Value="@selectedOrderNos.Contains(order.OrderNumber)"
                                     ValueChanged="@((v) => { if(v) selectedOrderNos.Add(order.OrderNumber); else selectedOrderNos.Remove(order.OrderNumber); _allSelected = orders.Any() && orders.All(i => selectedOrderNos.Contains(i.OrderNumber)); StateHasChanged(); })"
                                     Dense="true" />
                    </MudTd>
                    @foreach (var col in _visibleColumns)
                    {
                        <MudTd>@RenderCell(order, col)</MudTd>
                    }
                    <MudTd>
@if (order.WorkOrderStatus == WorkOrderStatus.NotGenerated)
{
    <MudButton Variant="Variant.Text"
               Color="Color.Primary"
               Size="Size.Small"
               StartIcon="@Icons.Material.Filled.Add"
               OnClick="() => NavigateToGenerate(order.OrderNumber, order.WorkOrderStatus.ToString())">
        生成工单
    </MudButton>
}
else if (order.WorkOrderStatus == WorkOrderStatus.Confirmed)
{
    <div class="d-flex flex-nowrap" style="gap: 4px;">
        <MudButton Variant="Variant.Text"
                   Color="Color.Warning"
                   Size="Size.Small"
                   StartIcon="@Icons.Material.Filled.Refresh"
                   OnClick="() => NavigateToRegenerate(order.OrderNumber, order.WorkOrderStatus.ToString())">
            重新生成
        </MudButton>
        <MudButton Variant="Variant.Text"
                   Color="Color.Info"
                   Size="Size.Small"
                   StartIcon="@Icons.Material.Filled.Edit"
                   OnClick="() => NavigateToUpdate(order.OrderNumber, order.WorkOrderStatus.ToString())">
            更新修改
        </MudButton>
    </div>
}
else if (order.WorkOrderStatus == WorkOrderStatus.Pending)
{
    <div class="d-flex flex-nowrap" style="gap: 4px;">
        <MudButton Variant="Variant.Text"
                   Color="Color.Primary"
                   Size="Size.Small"
                   StartIcon="@Icons.Material.Filled.Refresh"
                   OnClick="() => NavigateToRegenerate(order.OrderNumber, order.WorkOrderStatus.ToString())">
            重新生成
        </MudButton>
        <MudButton Variant="Variant.Text"
                   Color="Color.Info"
                   Size="Size.Small"
                   StartIcon="@Icons.Material.Filled.Edit"
                   OnClick="() => NavigateToUpdate(order.OrderNumber, order.WorkOrderStatus.ToString())">
            更新修改
        </MudButton>
    </div>
}
                    </MudTd>
                </RowTemplate>
                <PagerContent>
                    <MudTablePager />
                </PagerContent>
            </MudTable>
            </div>
        </MudCardContent>
    </MudCard>
</MudContainer>

@code {
    private MudTable<OrderWorkOrderStatusDto>? table;
    private List<OrderWorkOrderStatusDto> orders = new();
    private List<CancelledOrderDto> cancelledOrders = new();
    private bool isLoading = false;
    private bool isSyncing = false;
    private string searchKeyword = string.Empty;
    private string selectedStatus = "All";
    private int totalCount = 0;
    private bool _isArrowNavSetup;

    // 排序状态
    private string sortColumn = "signdate";
    private bool sortDescending = true;

    // 选中与悬停
    private bool _allSelected;
    private bool allSelected
    {
        get => _allSelected;
        set
        {
            if (_allSelected == value) return;
            _allSelected = value;
            if (value)
            {
                foreach (var item in orders)
                    selectedOrderNos.Add(item.OrderNumber);
            }
            else
            {
                selectedOrderNos.Clear();
            }
            StateHasChanged();
        }
    }
    private HashSet<string> selectedOrderNos = new();

    // ========== 列选择管理 ==========
    private List<ColumnDef> _allColumns = new();
    private List<ColumnDef> _visibleColumns =>
        _allColumns.Where(c => c.Visible).ToList();

    private static List<ColumnDef> GetAllColumnDefs() => new()
    {
        new() { Key = "ordernumber",    Label = "订单号",   SortKey = "ordernumber" },
        new() { Key = "signdate",       Label = "签订日期", SortKey = "signdate" },
        new() { Key = "salesman",       Label = "业务员",   SortKey = "salesman" },
        new() { Key = "customername",   Label = "客户名称", SortKey = "customername" },
        new() { Key = "endcustomer",    Label = "最终客户", SortKey = "endcustomer" },
        new() { Key = "deliverystart",  Label = "交期起始", SortKey = "deliverystart" },
        new() { Key = "deliveryend",    Label = "交期截止", SortKey = "deliveryend" },
        new() { Key = "hasdelaypenalty",Label = "延期罚款", SortKey = "hasdelaypenalty" },
        new() { Key = "totalcontractweight", Label = "订单总重量", SortKey = "totalcontractweight" },
        new() { Key = "itemcount",      Label = "含项次数", SortKey = "itemcount" },
        new() { Key = "workordercount", Label = "现工单数", SortKey = "workordercount" },
        new() { Key = "workorderstatus",Label = "工单状态", SortKey = "workorderstatus" },
    };

    private async Task OnColumnToggle(ColumnDef col)
    {
        await SaveColumnPrefs();
    }

    private async Task SaveColumnPrefs()
    {
        await ColumnPrefs.SaveAsync("workorders", null, _allColumns);
    }

    private async Task ResetColumnDisplay()
    {
        _allColumns = GetAllColumnDefs();
        await SaveColumnPrefs();
    }

    private async Task MoveColumnUp(ColumnDef col)
    {
        await SaveColumnPrefs();
    }

    private async Task MoveColumnDown(ColumnDef col)
    {
        await SaveColumnPrefs();
    }

    // ========== 单元格渲染 ==========

    private RenderFragment RenderCell(OrderWorkOrderStatusDto order, ColumnDef col) => builder =>
    {
        switch (col.Key)
        {
            case "ordernumber":
                builder.OpenComponent<MudLink>(0);
                builder.AddAttribute(1, "Typo", Typo.body2);
                builder.AddAttribute(2, "OnClick", EventCallback.Factory.Create<MouseEventArgs?>(this, () => NavigateToTrace(order.OrderNumber)));
                builder.AddAttribute(3, "ChildContent", (RenderFragment)(b2 => b2.AddContent(0, order.OrderNumber)));
                builder.CloseComponent();
                break;
            case "signdate":
                builder.AddContent(0, order.SignDate.ToString("yyyy-MM-dd"));
                break;
            case "salesman":
                builder.AddContent(0, order.Salesman);
                break;
            case "customername":
                builder.AddContent(0, order.CustomerName);
                break;
            case "endcustomer":
                builder.AddContent(0, order.EndCustomer);
                break;
            case "deliverystart":
                builder.AddContent(0, order.DeliveryStart?.ToString("yyyy-MM-dd") ?? "-");
                break;
            case "deliveryend":
                builder.AddContent(0, order.DeliveryEnd?.ToString("yyyy-MM-dd") ?? "-");
                break;
            case "hasdelaypenalty":
                builder.AddContent(0, order.HasDelayPenalty ? "是" : "否");
                break;
            case "totalcontractweight":
                builder.AddContent(0, order.TotalContractWeight.ToString("G29"));
                break;
            case "itemcount":
                builder.AddContent(0, order.ItemCount);
                break;
            case "workordercount":
                builder.OpenComponent<MudChip>(0);
                builder.AddAttribute(1, "Size", Size.Small);
                builder.AddAttribute(2, "Color", Color.Primary);
                builder.AddAttribute(3, "ChildContent", (RenderFragment)(b2 => b2.AddContent(0, order.WorkOrderCount)));
                builder.CloseComponent();
                break;
            case "workorderstatus":
                builder.OpenComponent<MudChip>(0);
                builder.AddAttribute(1, "Size", Size.Small);
                builder.AddAttribute(2, "Color", GetStatusColor(order.WorkOrderStatus));
                builder.AddAttribute(3, "Clickable", true);
                builder.AddAttribute(4, "OnClick", EventCallback.Factory.Create<MouseEventArgs?>(this, () => FilterByStatus(order.WorkOrderStatus.ToString())));
                builder.AddAttribute(5, "ChildContent", (RenderFragment)(b2 => b2.AddContent(0, order.WorkOrderStatusText)));
                builder.CloseComponent();
                break;
        }
    };

    private string GetSortIndicator(string column)
    {
        if (sortColumn != column) return "";
        return sortDescending ? "\u25BC" : "\u25B2";
    }

    // 通知提醒条
    private List<NotificationDto>? _orderChangeNotices;
    private List<NotificationDto>? _orderDeletedNotices;

    protected override async Task OnInitializedAsync()
    {
        // 初始化列定义
        _allColumns = GetAllColumnDefs();
        var saved = await ColumnPrefs.LoadAsync("workorders", null);
        if (saved.Count > 0)
        {
            foreach (var s in saved)
            {
                var match = _allColumns.FirstOrDefault(c => c.Key == s.Key);
                if (match != null)
                    match.Visible = s.Visible;
            }
            var reordered = new List<ColumnDef>();
            foreach (var s in saved)
            {
                var match = _allColumns.FirstOrDefault(c => c.Key == s.Key);
                if (match != null && !reordered.Contains(match))
                    reordered.Add(match);
            }
            foreach (var c in _allColumns)
            {
                if (!reordered.Contains(c))
                    reordered.Add(c);
            }
            _allColumns = reordered;
        }

        await CheckNotifications();
        await LoadCancelledOrders();
        await base.OnInitializedAsync();
    }

    private async Task CheckNotifications()
    {
        try
        {
            var changeTask = NotificationService.GetByTypeAsync("OrderChanged");
            var deletedTask = NotificationService.GetByTypeAsync("OrderDeleted");
            await Task.WhenAll(changeTask, deletedTask);

            var changeResult = await changeTask;
            if (changeResult.Success && changeResult.Data != null)
                _orderChangeNotices = changeResult.Data;
            else
                _orderChangeNotices = null;

            var deletedResult = await deletedTask;
            if (deletedResult.Success && deletedResult.Data != null)
                _orderDeletedNotices = deletedResult.Data;
            else
                _orderDeletedNotices = null;
        }
        catch
        {
            _orderChangeNotices = null;
            _orderDeletedNotices = null;
        }
    }

    private async Task DismissOrderChangeNotices()
    {
        var result = await NotificationService.MarkAllByTypeAsReadAsync("OrderChanged");
        if (result.Success)
        {
            _orderChangeNotices = null;
            Snackbar.Add("提醒已忽略", Severity.Success);
        }
    }

    private async Task DismissOrderDeletedNotices()
    {
        var result = await NotificationService.MarkAllByTypeAsReadAsync("OrderDeleted");
        if (result.Success)
        {
            _orderDeletedNotices = null;
            Snackbar.Add("提醒已忽略", Severity.Success);
        }
    }

    private async Task LoadCancelledOrders()
    {
        try
        {
            var result = await WorkOrderService.GetCancelledOrdersAsync();
            if (result.Success && result.Data != null)
            {
                cancelledOrders = result.Data;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"加载待删除订单失败: {ex.Message}");
        }
    }

    private async Task<TableData<OrderWorkOrderStatusDto>> OnServerData(TableState state)
    {
        isLoading = true;
        StateHasChanged();

        try
        {
            var queryParams = new WorkOrderQueryParams
            {
                PageIndex = state.Page + 1,
                PageSize = state.PageSize,
                SortBy = sortColumn,
                IsDescending = sortDescending,
                Keyword = string.IsNullOrWhiteSpace(searchKeyword) ? null : searchKeyword,
                WorkOrderStatus = selectedStatus == "All" ? null : selectedStatus
            };

            var result = await WorkOrderService.GetOrderWorkOrderStatusPageAsync(queryParams);

            if (result.Success && result.Data != null)
            {
                orders = result.Data.Items;
                totalCount = result.Data.TotalCount;
            }
            else
            {
                orders = new List<OrderWorkOrderStatusDto>();
                totalCount = 0;
            }

            return new TableData<OrderWorkOrderStatusDto>
            {
                Items = orders,
                TotalItems = totalCount
            };
        }
        catch (Exception ex)
        {
            Console.WriteLine($"加载失败: {ex.Message}");
            Snackbar.Add($"加载失败: {ex.Message}", Severity.Error);
            return new TableData<OrderWorkOrderStatusDto>
            {
                Items = new List<OrderWorkOrderStatusDto>(),
                TotalItems = 0
            };
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task Search()
    {
        if (table != null)
            await table.ReloadServerData();
        await LoadCancelledOrders();
    }

    private async Task CheckAllOrderChange()
    {
        isSyncing = true;
        try
        {
            var result = await WorkOrderService.CheckAllOrderChangeAsync();
            if (result.Success)
            {
                Snackbar.Add("订单变更检测完成，工单状态已同步", Severity.Success);
            }
            else
            {
                Snackbar.Add(result.Message ?? "同步失败", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"同步失败: {ex.Message}", Severity.Error);
        }
        finally
        {
            isSyncing = false;
        }
        await CheckNotifications();
        await Search();
    }

    private async Task OnSearchChanged(string value)
    {
        searchKeyword = value ?? string.Empty;
        if (table != null)
            await table.ReloadServerData();
        await LoadCancelledOrders();
    }

    private async Task OnStatusFilterChanged(string value)
    {
        selectedStatus = value ?? string.Empty;
        if (table != null)
            await table.ReloadServerData();
        await LoadCancelledOrders();
    }

    private async Task ToggleSort(string column)
    {
        if (sortColumn == column)
            sortDescending = !sortDescending;
        else
        {
            sortColumn = column;
            sortDescending = false;
        }
        if (table != null)
            await table.ReloadServerData();
    }

    private async Task FilterByStatus(string status)
    {
        selectedStatus = status ?? string.Empty;
        StateHasChanged();
        if (table != null)
            await table.ReloadServerData();
        await LoadCancelledOrders();
    }

    private Color GetStatusColor(WorkOrderStatus status)
    {
        return status switch
        {
            WorkOrderStatus.NotGenerated => Color.Default,
            WorkOrderStatus.Confirmed => Color.Success,
            WorkOrderStatus.Pending => Color.Warning,
            _ => Color.Default
        };
    }

    private void NavigateToGenerate(string salesOrderNo, string workOrderStatus)
    {
        Navigation.NavigateTo($"/workorders/generate?salesOrderNo={Uri.EscapeDataString(salesOrderNo)}&status={workOrderStatus}");
    }

    private void NavigateToRegenerate(string salesOrderNo, string workOrderStatus)
    {
        Navigation.NavigateTo($"/workorders/generate?salesOrderNo={Uri.EscapeDataString(salesOrderNo)}&status={workOrderStatus}&regenerate=true");
    }

    private void NavigateToUpdate(string salesOrderNo, string workOrderStatus)
    {
        Navigation.NavigateTo($"/workorders/generate?salesOrderNo={Uri.EscapeDataString(salesOrderNo)}&status={workOrderStatus}&update=true");
    }

    private void NavigateToTrace(string orderNumber)
    {
        Navigation.NavigateTo($"/workorders/relation?salesOrderNo={Uri.EscapeDataString(orderNumber)}");
    }

    private async Task SoftDeleteWorkOrder(int workOrderId, string orderNumber)
    {
        var dialog = DialogService.Show<ConfirmDialog>("确认", new DialogParameters
        {
            ["ContentText"] = $"确定要删除订单 \"{orderNumber}\" 关联的工单吗？\n\n删除后数据将不可恢复！",
            ["ConfirmText"] = "确认删除",
            ["Color"] = Color.Error
        });
        var dialogResult = await dialog.Result;
        if (dialogResult.Canceled) return;

        try
        {
            var result = await WorkOrderService.SoftDeleteAsync(workOrderId);
            if (result.Success)
            {
                Snackbar.Add($"工单已删除", Severity.Success);
                await LoadCancelledOrders();
                await Search();
            }
            else
            {
                Snackbar.Add(result.Message ?? "删除失败", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"删除失败: {ex.Message}", Severity.Error);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_isArrowNavSetup)
        {
            _isArrowNavSetup = true;
            if (!await JS.InvokeAsync<bool>("enableTableArrowNav", "#workorders-list-table"))
                _isArrowNavSetup = false;
        }
    }

    private async Task PrintSelected()
    {
        if (!selectedOrderNos.Any()) return;
        try
        {
            var result = await WorkOrderService.PrintOrderWorkOrdersBatchAsync(selectedOrderNos.ToArray());
            if (result.Success && result.Data != null)
            {
                await JS.InvokeVoidAsync("openPdf", result.Data);
            }
            else
            {
                Snackbar.Add(result.Message ?? "打印失败", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"打印失败: {ex.Message}", Severity.Error);
        }
    }

    private async Task PrintAll()
    {
        try
        {
            var queryParams = new WorkOrderQueryParams
            {
                Keyword = string.IsNullOrWhiteSpace(searchKeyword) ? null : searchKeyword,
                WorkOrderStatus = selectedStatus == "All" ? null : selectedStatus
            };
            var result = await WorkOrderService.PrintOrderWorkOrdersAllAsync(queryParams);
