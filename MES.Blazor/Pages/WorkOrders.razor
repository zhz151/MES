@page "/workorders"
@using MES.Blazor.Services
@using MES.Core.DTOs
@using MES.Core.Models
@using Microsoft.AspNetCore.Authorization
@using MES.Blazor.Shared
@inject WorkOrderService WorkOrderService
@inject NotificationService NotificationService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@attribute [Authorize(Roles = "WorkOrderStaff,WorkOrderDirector,Admin")]

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4">
    <!-- 页面顶部工具栏（铃铛图标和刷新） -->
    <div class="d-flex justify-space-between align-center mb-4">
        <MudText Typo="Typo.h5" Class="font-weight-bold">
            <MudIcon Icon="@Icons.Material.Filled.Assignment" Class="mr-2" Color="Color.Primary" />
            工单管理
        </MudText>
        <div class="d-flex align-center">
            <MudIconButton Icon="@Icons.Material.Filled.Notifications"
                           Color="Color.Primary"
                           Badge="@(unreadCount > 0 ? unreadCount.ToString() : null)"
                           BadgeColor="Color.Error"
                           OnClick="@(() => notificationDrawerOpen = true)" />
            <MudButton Variant="Variant.Filled"
                       Color="Color.Info"
                       StartIcon="@Icons.Material.Filled.Sync"
                       OnClick="CheckAllOrderChange"
                       Loading="@isSyncing"
                       Disabled="@isSyncing"
                       Class="ml-2">
                即时更新
            </MudButton>
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Refresh"
                       OnClick="Search"
                       Class="ml-2">
                刷新
            </MudButton>
        </div>
    </div>

    <!-- 订单已取消-工单待删除区域 -->
    @if (cancelledOrders.Any())
    {
        <MudCard Class="mb-4" Style="border-left: 4px solid var(--mud-palette-error);">
            <MudCardHeader>
                <CardHeaderContent>
                    <MudText Typo="Typo.subtitle1" Color="Color.Error">
                        <MudIcon Icon="@Icons.Material.Filled.Warning" Class="mr-2" Size="Size.Small" />
                        订单已取消-工单待删除
                    </MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">
                        以下订单已取消，但关联的工单尚未删除，请点击订单号进行软删除
                    </MudText>
                </CardHeaderContent>
            </MudCardHeader>
            <MudCardContent>
                <MudGrid>
                    @foreach (var item in cancelledOrders)
                    {
                        <MudItem xs="12" md="6" lg="4">
                            <MudPaper Class="pa-3 d-flex justify-space-between align-center" Elevation="0" Style="background-color: #fff3f3;">
                                <div>
                                    <MudText Typo="Typo.body2">
                                        <strong>订单号：</strong>
                                        <MudLink Typo="Typo.body2" Color="Color.Error" Underline="Underline.Always"
                                                 OnClick="() => SoftDeleteWorkOrder(item.WorkOrderId, item.OrderNumber)">
                                            @item.OrderNumber
                                        </MudLink>
                                    </MudText>
                                    <MudText Typo="Typo.body2">签订日期：@item.SignDate.ToString("yyyy-MM-dd")</MudText>
                                    <MudText Typo="Typo.body2">业务员：@item.Salesman</MudText>
                                    <MudText Typo="Typo.body2">客户名称：@item.CustomerName</MudText>
                                </div>
                                <MudChip Size="Size.Small" Color="Color.Error">待删除</MudChip>
                            </MudPaper>
                        </MudItem>
                    }
                </MudGrid>
            </MudCardContent>
        </MudCard>
    }

    <MudCard>
        <MudCardContent>
            <!-- 筛选栏 -->
            <MudGrid>
                <MudItem xs="12" md="6">
                    <MudTextField T="string"
                                  Label="搜索 - 订单号/客户名称/业务员"
                                  Placeholder="输入关键字进行模糊搜索..."
                                  @bind-Value="searchKeyword"
                                  Immediate="true"
                                  DebounceInterval="500"
                                  OnKeyDown="OnSearchKeyDown"
                                  Clearable="true"
                                  ClearButton="true"
                                  Adornment="Adornment.End"
                                  AdornmentIcon="@Icons.Material.Filled.Search" />
                </MudItem>
                <MudItem xs="12" md="3">
                    <MudSelect T="string" Label="工单状态" @bind-Value="selectedStatus">
                        <MudSelectItem Value="@(null as string)">全部</MudSelectItem>
                        <MudSelectItem Value="@("NotGenerated")">未编制</MudSelectItem>
                        <MudSelectItem Value="@("Confirmed")">已确定</MudSelectItem>
                        <MudSelectItem Value="@("Pending")">待修正</MudSelectItem>
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" md="3">
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               FullWidth="true"
                               StartIcon="@Icons.Material.Filled.Search"
                               OnClick="Search">
                        搜索
                    </MudButton>
                </MudItem>
            </MudGrid>

            <!-- 数据表格 -->
            <MudTable @ref="table"
                      T="OrderWorkOrderStatusDto"
                      ServerData="OnServerData"
                      Loading="@isLoading"
                      Dense="true"
                      Hover="true"
                      Class="mt-4"
                      Elevation="0"
                      RowsPerPageLabel="每页行数:">
                <ToolBarContent>
                    <MudText Typo="Typo.body2" Class="ml-auto">
                        共 @totalCount 条记录
                    </MudText>
                </ToolBarContent>
                <HeaderContent>
                    <MudTh>订单号</MudTh>
                    <MudTh>签订日期</MudTh>
                    <MudTh>业务员</MudTh>
                    <MudTh>客户名称</MudTh>
                    <MudTh>工单状态</MudTh>
                    <MudTh>操作</MudTh>
                </HeaderContent>
                <RowTemplate Context="order">
                    <MudTd  title="@order.OrderNumber">@order.OrderNumber</MudTd>
                    <MudTd >@order.SignDate.ToString("yyyy-MM-dd")</MudTd>
                    <MudTd  title="@order.Salesman">@order.Salesman</MudTd>
                    <MudTd title="@order.CustomerName">@order.CustomerName</MudTd>
                    <MudTd>
                        <MudChip Size="Size.Small" 
                                 Color="@GetStatusColor(order.WorkOrderStatus)"
                                 Clickable="true"
                                 OnClick="() => FilterByStatus(order.WorkOrderStatus)">
                            @order.WorkOrderStatusText
                        </MudChip>
                    </MudTd>
                    <MudTd>
                        <MudIconButton Icon="@Icons.Material.Filled.Link"
                                       Color="Color.Primary"
                                       Size="Size.Small"
                                       OnClick="() => NavigateToTrace(order.OrderNumber)"
                                       Title="工单项次追溯" />

@if (order.WorkOrderStatus == "NotGenerated")
{
    <MudButton Variant="Variant.Text"
               Color="Color.Primary"
               Size="Size.Small"
               StartIcon="@Icons.Material.Filled.Add"
               OnClick="() => NavigateToGenerate(order.OrderNumber, order.WorkOrderStatus)">
        生成工单
    </MudButton>
}
else if (order.WorkOrderStatus == "Confirmed")
{
    <MudButton Variant="Variant.Text"
               Color="Color.Warning"
               Size="Size.Small"
               StartIcon="@Icons.Material.Filled.Refresh"
               OnClick="() => NavigateToRegenerate(order.OrderNumber, order.WorkOrderStatus)">
        重新生成
    </MudButton>
}
else if (order.WorkOrderStatus == "Pending")
{
    <MudButton Variant="Variant.Text"
               Color="Color.Primary"
               Size="Size.Small"
               StartIcon="@Icons.Material.Filled.Add"
               OnClick="() => NavigateToGenerate(order.OrderNumber, order.WorkOrderStatus)">
        生成工单
    </MudButton>
}
                    </MudTd>
                </RowTemplate>
                <PagerContent>
                    <MudTablePager />
                </PagerContent>
            </MudTable>
        </MudCardContent>
    </MudCard>
</MudContainer>

<!-- 通知抽屉 -->
<MudDrawer @bind-Open="notificationDrawerOpen" Anchor="Anchor.Right" Variant="DrawerVariant.Temporary">
    <MudCard Style="height: 100%; display: flex; flex-direction: column;">
        <MudCardHeader>
            <CardHeaderContent>
                <MudText Typo="Typo.h6">订单变更通知</MudText>
            </CardHeaderContent>
            <CardHeaderActions>
                <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="MarkAllNotificationsRead">全部已读</MudButton>
                <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" OnClick="() => notificationDrawerOpen = false" />
            </CardHeaderActions>
        </MudCardHeader>
        <MudCardContent Style="flex: 1; overflow-y: auto;">
            <MudTable @ref="notificationTable"
                      T="OrderChangeNotificationDto"
                      ServerData="LoadNotifications"
                      Loading="@isLoadingNotifications"
                      Dense="true"
                      Hover="true"
                      Elevation="0"
                      RowsPerPageLabel="每页行数:">
                <HeaderContent>
                    <MudTh>订单号</MudTh>
                    <MudTh>类型</MudTh>
                    <MudTh>清理工单数</MudTh>
                    <MudTh>时间</MudTh>
                    <MudTh>操作</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>@context.OrderNumber</MudTd>
                    <MudTd>@context.ChangeTypeText</MudTd>
                    <MudTd>@(context.WorkOrderCount > 0 ? context.WorkOrderCount.ToString() : "-")</MudTd>
                    <MudTd>@context.CreatedTime.ToString("yyyy-MM-dd HH:mm")</MudTd>
                    <MudTd>
                        @if (!context.IsRead)
                        {
                            <MudIconButton Icon="@Icons.Material.Filled.Done"
                                           Size="Size.Small"
                                           Color="Color.Success"
                                           OnClick="() => MarkNotificationRead(context.Id)"
                                           Title="标记已读" />
                        }
                    </MudTd>
                </RowTemplate>
                <PagerContent>
                    <MudTablePager />
                </PagerContent>
            </MudTable>
        </MudCardContent>
    </MudCard>
</MudDrawer>

@code {
    private MudTable<OrderWorkOrderStatusDto>? table;
    private MudTable<OrderChangeNotificationDto>? notificationTable;
    private List<OrderWorkOrderStatusDto> orders = new();
    private List<CancelledOrderDto> cancelledOrders = new();
    private bool isLoading = false;
    private bool isSyncing = false;
    private string searchKeyword = string.Empty;
    private string selectedStatus = string.Empty;
    private int totalCount = 0;

    // 通知相关
    private bool notificationDrawerOpen = false;
    private int unreadCount = 0;
    private bool isLoadingNotifications = false;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await LoadUnreadCount();
        }
        catch
        {
            // 通知未读数加载失败不影响主页面
        }
        await LoadCancelledOrders();
        await base.OnInitializedAsync();
    }

    private async Task LoadUnreadCount()
    {
        try
        {
            var result = await NotificationService.GetUnreadCountAsync();
            if (result.Success)
                unreadCount = result.Data;
        }
        catch
        {
            unreadCount = 0;
        }
    }

    private async Task<TableData<OrderChangeNotificationDto>> LoadNotifications(TableState state)
    {
        isLoadingNotifications = true;
        StateHasChanged();

        try
        {
            var result = await NotificationService.GetPagedAsync(state.Page + 1, state.PageSize);
            if (result.Success && result.Data != null)
            {
                return new TableData<OrderChangeNotificationDto>
                {
                    Items = result.Data.Items,
                    TotalItems = result.Data.TotalCount
                };
            }
            return new TableData<OrderChangeNotificationDto> { Items = new List<OrderChangeNotificationDto>(), TotalItems = 0 };
        }
        finally
        {
            isLoadingNotifications = false;
            StateHasChanged();
        }
    }

    private async Task MarkNotificationRead(int id)
    {
        var result = await NotificationService.MarkAsReadAsync(id);
        if (result.Success)
        {
            if (notificationTable != null)
                await notificationTable.ReloadServerData();
            await LoadUnreadCount();
            Snackbar.Add("已标记为已读", Severity.Success);
        }
        else
        {
            Snackbar.Add(result.Message ?? "操作失败", Severity.Error);
        }
    }

    private async Task MarkAllNotificationsRead()
    {
        var result = await NotificationService.MarkAllAsReadAsync();
        if (result.Success)
        {
            if (notificationTable != null)
                await notificationTable.ReloadServerData();
            await LoadUnreadCount();
            Snackbar.Add("已全部标记为已读", Severity.Success);
        }
        else
        {
            Snackbar.Add(result.Message ?? "操作失败", Severity.Error);
        }
    }

    private async Task LoadCancelledOrders()
    {
        try
        {
            var result = await WorkOrderService.GetCancelledOrdersAsync();
            if (result.Success && result.Data != null)
            {
                cancelledOrders = result.Data;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"加载待删除订单失败: {ex.Message}");
        }
    }

    private async Task<TableData<OrderWorkOrderStatusDto>> OnServerData(TableState state)
    {
        isLoading = true;
        StateHasChanged();

        try
        {
            var queryParams = new WorkOrderQueryParams
            {
                PageIndex = state.Page + 1,
                PageSize = state.PageSize,
                SortBy = "SignDate",
                IsDescending = true,
                Keyword = string.IsNullOrWhiteSpace(searchKeyword) ? null : searchKeyword,
                WorkOrderStatus = string.IsNullOrWhiteSpace(selectedStatus) ? null : selectedStatus
            };

            var result = await WorkOrderService.GetOrderWorkOrderStatusPageAsync(queryParams);

            if (result.Success && result.Data != null)
            {
                orders = result.Data.Items;
                totalCount = result.Data.TotalCount;
            }
            else
            {
                orders = new List<OrderWorkOrderStatusDto>();
                totalCount = 0;
            }

            return new TableData<OrderWorkOrderStatusDto>
            {
                Items = orders,
                TotalItems = totalCount
            };
        }
        catch (Exception ex)
        {
            Console.WriteLine($"加载失败: {ex.Message}");
            Snackbar.Add($"加载失败: {ex.Message}", Severity.Error);
            return new TableData<OrderWorkOrderStatusDto>
            {
                Items = new List<OrderWorkOrderStatusDto>(),
                TotalItems = 0
            };
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task Search()
    {
        if (table != null)
            await table.ReloadServerData();
        await LoadCancelledOrders();
    }

    private async Task CheckAllOrderChange()
    {
        isSyncing = true;
        try
        {
            var result = await WorkOrderService.CheckAllOrderChangeAsync();
            if (result.Success)
            {
                Snackbar.Add("订单变更检测完成，工单状态已同步", Severity.Success);
            }
            else
            {
                Snackbar.Add(result.Message ?? "同步失败", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"同步失败: {ex.Message}", Severity.Error);
        }
        finally
        {
            isSyncing = false;
        }
        await Search();
    }

    private void OnSearchKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Enter")
            _ = Search();
    }

    private async Task FilterByStatus(string status)
    {
        selectedStatus = status;
        await Search();
    }

    private Color GetStatusColor(string status)
    {
        return status switch
        {
            "NotGenerated" => Color.Default,
            "Confirmed" => Color.Success,
            "Pending" => Color.Warning,
            _ => Color.Default
        };
    }

    private void NavigateToGenerate(string salesOrderNo, string workOrderStatus)
    {
        Navigation.NavigateTo($"/workorders/generate?salesOrderNo={Uri.EscapeDataString(salesOrderNo)}&status={workOrderStatus}");
    }

    private void NavigateToRegenerate(string salesOrderNo, string workOrderStatus)
    {
        Navigation.NavigateTo($"/workorders/generate?salesOrderNo={Uri.EscapeDataString(salesOrderNo)}&status={workOrderStatus}&regenerate=true");
    }

    private void NavigateToTrace(string orderNumber)
    {
        Navigation.NavigateTo($"/workorders/relation?salesOrderNo={Uri.EscapeDataString(orderNumber)}");
    }

    private async Task SoftDeleteWorkOrder(int workOrderId, string orderNumber)
    {
        var dialog = DialogService.Show<ConfirmDialog>("确认", new DialogParameters
        {
            ["ContentText"] = $"确定要删除订单 \"{orderNumber}\" 关联的工单吗？\n\n删除后数据将不可恢复！",
            ["ConfirmText"] = "确认删除",
            ["Color"] = Color.Error
        });
        var dialogResult = await dialog.Result;
        if (dialogResult.Canceled) return;

        try
        {
            var result = await WorkOrderService.SoftDeleteAsync(workOrderId);
            if (result.Success)
            {
                Snackbar.Add($"工单已删除", Severity.Success);
                await LoadCancelledOrders();
                await Search();
            }
            else
            {
                Snackbar.Add(result.Message ?? "删除失败", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"删除失败: {ex.Message}", Severity.Error);
        }
    }
}