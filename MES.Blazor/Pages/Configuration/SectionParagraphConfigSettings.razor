@page "/section-paragraph-config-settings"
@using MES.Blazor.Services
@using MES.Core.Models
@using MES.Blazor.Helpers
@using MES.Core.DTOs.Configuration
@using Microsoft.AspNetCore.Authorization
@inject SectionParagraphConfigService Service
@inject ISnackbar Snackbar
@attribute [Authorize(Roles = Roles.Policies.ConfigurationView)]

<MudContainer MaxWidth="MaxWidth.False" Class="mt-4 pl-0">
    <MudCard>
        <MudCardHeader>
            <CardHeaderContent>
                <MudText Typo="Typo.h5" Class="font-weight-bold">
                    <MudIcon Icon="@Icons.Material.Filled.Tune" Class="mr-2" Color="Color.Primary" />
                    段落日产配置
                </MudText>
            </CardHeaderContent>
            <CardHeaderActions>
                <MudText Typo="Typo.body2" Class="mr-4">
                    共 @_items.Count 个段落
                </MudText>
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           Disabled="@_isLoading"
                           OnClick="LoadDataAsync">
                    <MudIcon Icon="@Icons.Material.Filled.Refresh" Class="mr-1" />
                    刷新
                </MudButton>
            </CardHeaderActions>
        </MudCardHeader>

        <MudCardContent>
            <!-- 3 类筛选 Tab（段落由 3 类配置自动生成，仅参数可编辑，此处按类筛选查看） -->
            <div class="d-flex flex-wrap align-center mb-2" style="gap: 4px 8px;">
                @foreach (var tab in _categoryTabs)
                {
                    var isActive = (tab.Key == "" && _selectedCategory == null)
                        || (tab.Key != "" && _selectedCategory == tab.Key);
                    <MudButton Variant="@(isActive ? Variant.Filled : Variant.Outlined)"
                               Color="@(isActive ? Color.Primary : Color.Default)"
                               Size="Size.Small"
                               Class="ma-0"
                               OnClick="@(() => SetCategoryFilter(tab.Key == "" ? null : tab.Key))">
                        @tab.Display
                    </MudButton>
                }
            </div>

            <MudTable @ref="table"
                      T="SectionParagraphConfigDto"
                      Items="@_visibleItems"
                      Dense="true" Hover="true" Elevation="0" Class="auto-table"
                      RowsPerPage="25" RowsPerPageLabel="每页行数:">
                <HeaderContent>
                    <MudTh><span class="th-label">段落类别</span></MudTh>
                    <MudTh><span class="th-label">类型</span></MudTh>
                    <MudTh Class="mud-table-cell--right"><span class="th-label">序号</span></MudTh>
                    <MudTh Class="mud-table-cell--right"><span class="th-label">日流转设定</span></MudTh>
                    <MudTh Class="mud-table-cell--right"><span class="th-label">偏少天数值</span></MudTh>
                    <MudTh Class="mud-table-cell--right"><span class="th-label">过多天数值</span></MudTh>
                    <MudTh><span class="th-label">备注</span></MudTh>
                    <MudTh Style="width: 90px;">操作</MudTh>
                </HeaderContent>
                <RowTemplate Context="item">
                    @{
                        var rowEditing = _editingIds.Contains(item.Id);
                        var rowCache = rowEditing && _editCache.TryGetValue(item.Id, out var rc) ? rc : null;
                    }
                    <MudTd>@item.ParagraphName</MudTd>
                    <MudTd>@DisplayHelper.GetParagraphCategoryTypeText(item.CategoryType)</MudTd>
                    <MudTd Class="mud-table-cell--right">@item.DisplayOrder</MudTd>
                    <MudTd Class="mud-table-cell--right">
                        @if (rowEditing && rowCache != null)
                        {
                            <MudNumericField T="decimal?" Dense="true" Variant="Variant.Outlined"
                                             HideSpinButtons="true" Format="G29"
                                             Value="@rowCache.DailyFlowTarget"
                                             ValueChanged="@(v => rowCache.DailyFlowTarget = v)"
                                             Class="compact-input" />
                        }
                        else
                        {
                            @(item.DailyFlowTarget?.ToString("G29") ?? "-")
                        }
                    </MudTd>
                    <MudTd Class="mud-table-cell--right">
                        @if (rowEditing && rowCache != null)
                        {
                            <MudNumericField T="decimal?" Dense="true" Variant="Variant.Outlined"
                                             HideSpinButtons="true" Format="G29"
                                             Value="@rowCache.LowerLimitDays"
                                             ValueChanged="@(v => rowCache.LowerLimitDays = v)"
                                             Class="compact-input" />
                        }
                        else
                        {
                            @(item.LowerLimitDays?.ToString("G29") ?? "-")
                        }
                    </MudTd>
                    <MudTd Class="mud-table-cell--right">
                        @if (rowEditing && rowCache != null)
                        {
                            <MudNumericField T="decimal?" Dense="true" Variant="Variant.Outlined"
                                             HideSpinButtons="true" Format="G29"
                                             Value="@rowCache.UpperLimitDays"
                                             ValueChanged="@(v => rowCache.UpperLimitDays = v)"
                                             Class="compact-input" />
                        }
                        else
                        {
                            @(item.UpperLimitDays?.ToString("G29") ?? "-")
                        }
                    </MudTd>
                    <MudTd>
                        @if (rowEditing && rowCache != null)
                        {
                            <MudTextField T="string" Dense="true" Variant="Variant.Outlined"
                                          Value="@rowCache.Remark"
                                          ValueChanged="@(v => rowCache.Remark = v)"
                                          Class="compact-input" />
                        }
                        else
                        {
                            @item.Remark
                        }
                    </MudTd>
                    <MudTd Style="white-space: nowrap; width: 90px;" @onclick:stopPropagation>
                        @if (rowEditing)
                        {
                            <MudIconButton Icon="@Icons.Material.Filled.Check" Color="Color.Success" Size="Size.Small" OnClick="() => SaveEdit(item)" Disabled="@_isSaving" />
                            <MudIconButton Icon="@Icons.Material.Filled.Close" Color="Color.Default" Size="Size.Small" OnClick="() => CancelEdit(item)" />
                        }
                        else
                        {
                            <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Info" Size="Size.Small" OnClick="() => StartEdit(item)" />
                        }
                    </MudTd>
                </RowTemplate>
                <PagerContent>
                    <MudTablePager PageSizeOptions="new int[]{10,25,50,100}" />
                </PagerContent>
            </MudTable>
        </MudCardContent>
    </MudCard>

    <!-- 加载遮罩 -->
    <MudOverlay Visible="@_isLoading">
        <div class="d-flex justify-center align-center" style="height: 100%;">
            <MudProgressCircular Indeterminate="true" Size="Size.Large" />
        </div>
    </MudOverlay>
</MudContainer>
