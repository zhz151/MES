@page "/workstations"
@using MES.Blazor.Services
@using MES.Core.Enums
@using MES.Core.Constants
@using MES.Core.Models
@using MES.Blazor.Helpers
@using Microsoft.AspNetCore.Authorization
@using MES.Blazor.Shared
@using MES.Core.DTOs.Configuration
@inject WorkstationService WorkstationService
@inject StandardWorkDayService StandardWorkDayService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject IJSRuntime JS
@inject ColumnPrefsService ColumnPrefs
@inject PageStateService PageState
@attribute [Authorize(Roles = Roles.Policies.AdminOnly)]

<MudContainer MaxWidth="MaxWidth.False" Class="mt-4 pl-0">
    <MudCard>
        <MudCardHeader>
            <CardHeaderContent>
                <MudText Typo="Typo.h5" Class="font-weight-bold">
                    <MudIcon Icon="@Icons.Material.Filled.PrecisionManufacturing" Class="mr-2" Color="Color.Primary" />
                    扫码-工位管理
                </MudText>
            </CardHeaderContent>
            <CardHeaderActions>
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Add"
                           OnClick="AddNew">
                    新建
                </MudButton>
            </CardHeaderActions>
        </MudCardHeader>

        <MudCardContent>
            <!-- 搜索栏 -->
            <MudGrid>
                <MudItem xs="12" md="6">
                    <MudTextField T="string"
                                  Label="模糊搜索 - 工位编码/名称/设备/工段/模板类型"
                                  Value="_searchKeyword" ValueExpression="@(() => _searchKeyword)"
                                  ValueChanged="@OnSearchChanged"
                                  Immediate="true"
                                  DebounceInterval="500"
                                  Adornment="Adornment.End"
                                  AdornmentIcon="@Icons.Material.Filled.Search" />
                </MudItem>
            </MudGrid>

            <!-- 数据表格 -->
            <div id="workstations-list-table">
            <!-- 工具栏 -->
            <div class="list-toolbar">
                <div class="d-flex align-center">
                    <ColumnDisplaySelect Columns="_allColumns"
                                         OnColumnToggle="OnColumnToggle"
                                         OnMoveUp="MoveColumnUp"
                                         OnMoveDown="MoveColumnDown" />
                    <MudButton Variant="Variant.Text" Size="Size.Small"
                               Color="Color.Default"
                               StartIcon="@Icons.Material.Filled.RestartAlt"
                               OnClick="ResetColumnDisplay" Class="ml-2">
                        重置
                    </MudButton>
                </div>
                <div class="d-flex align-center" style="margin-left:auto;">
                    <MudButton Variant="Variant.Text" Size="Size.Small"
                               Color="Color.Default"
                               StartIcon="@Icons.Material.Filled.Print"
                               OnClick="PrintSelected" Class="ml-2">
                        打印选中
                    </MudButton>
                    <MudButton Variant="Variant.Text" Size="Size.Small"
                               Color="Color.Default"
                               StartIcon="@Icons.Material.Filled.Print"
                               OnClick="PrintAll" Class="ml-2">
                        打印全部
                    </MudButton>
                    <MudText Typo="Typo.body2" Class="ml-4">
                        共 @_totalCount 条记录
                    </MudText>
                </div>
            </div>
            <MudTable @ref="table"
                      T="WorkstationDto"
                      ServerData="@LoadDataFromServer"
                      Dense="true"
                      Hover="true"
                      Class="mt-0 auto-table"
                      Elevation="0"
                      RowsPerPage="@_pageSize"
                      RowsPerPageLabel="每页行数:">
                <HeaderContent>
                    <MudTh Class="col-selection-th" Style="width: 40px;">
                        <MudCheckBox Value="@allSelected"
                                     ValueChanged="@((bool v) => OnSelectAllChanged(v))" />
                    </MudTh>
                    @foreach (var col in _visibleColumns)
                    {
                        <MudTh>
                            <div style="display:inline-flex; align-items:center; gap:4px;">
                                <span @onclick='() => ToggleSort(col.Key)' style="cursor:pointer" class="th-label">@col.Label@if (col.IsRequired) {<span class="required-star">*</span>} @if (sortColumn == col.Key) {@(sortDescending ? " ▼" : " ▲")}</span>
                            </div>
                        </MudTh>
                    }
                    <MudTh Style="width: 90px;">操作</MudTh>
                </HeaderContent>
                <RowTemplate Context="item">
                    @{
                        var rowEditing = _editingIds.Contains(item.Id);
                        var rowCache = rowEditing && _editCache.TryGetValue(item.Id, out var rc) ? rc : null;
                    }
                    <MudTd Class="col-selection-td">
                        <MudCheckBox Value="@(selectedIds.Contains(item.Id))"
                                     ValueChanged="@((bool v) => OnRowSelectionChanged(item.Id, v))" />
                    </MudTd>
                    @foreach (var col in _visibleColumns)
                    {
                        <MudTd>
                        @if (col.Key == "Code")
                        {
                            if (rowEditing && rowCache != null)
                            {
                                <MudTextField T="string"
                                              Dense="true"
                                              Variant="Variant.Outlined"
                                              Value="@rowCache.Code"
                                              ValueChanged="@(v => rowCache.Code = v)"
                                              Class="compact-input"
                                              Required="true"
                                              Label="工位编码" />
                            }
                            else
                            {
                                <span class="font-weight-bold">@item.Code</span>
                            }
                        }
                        else if (col.Key == "Name")
                        {
                            if (rowEditing && rowCache != null)
                            {
                                <MudTextField T="string"
                                              Dense="true"
                                              Variant="Variant.Outlined"
                                              Value="@rowCache.Name"
                                              ValueChanged="@(v => rowCache.Name = v)"
                                              Class="compact-input"
                                              Label="工位名称" />
                            }
                            else
                            {
                                @item.Name
                            }
                        }
                        else if (col.Key == "ReportType")
                        {
                            if (rowEditing && rowCache != null)
                            {
                                <MudSelect T="ReportTemplateType"
                                           Dense="true"
                                           Variant="Variant.Outlined"
                                           @bind-Value="rowCache.ReportType"
                                           Class="compact-input"
                                           Label="报工模板类型">
                                    @foreach (var opt in DisplayHelper.GetEnumOptions<ReportTemplateType>())
                                    {
                                        <MudSelectItem Value="@(Enum.Parse<ReportTemplateType>(opt.Value))">@opt.Display</MudSelectItem>
                                    }
                                </MudSelect>
                            }
                            else
                            {
                                @DisplayHelper.GetReportTypeText(item.ReportType)
                            }
                        }
                        else if (col.Key == "EquipmentName")
                        {
                            if (rowEditing && rowCache != null)
                            {
                                <MudTextField T="string"
                                              Dense="true"
                                              Variant="Variant.Outlined"
                                              Value="@rowCache.EquipmentName"
                                              ValueChanged="@(v => rowCache.EquipmentName = v)"
                                              Class="compact-input"
                                              Label="设备名称" />
                            }
                            else
                            {
                                @item.EquipmentName
                            }
                        }
                        else if (col.Key == "SectionName")
                        {
                            if (rowEditing && rowCache != null)
                            {
                                <MudSelect T="string"
                                           Dense="true"
                                           Variant="Variant.Outlined"
                                           Value="@rowCache.SectionName"
                                           ValueChanged="@(v => rowCache.SectionName = v)"
                                           Class="compact-input"
                                           Label="工段">
                                    @foreach (var opt in _sectionOptions)
                                    {
                                        <MudSelectItem Value="@opt.Key">@opt.Text</MudSelectItem>
                                    }
                                </MudSelect>
                            }
                            else
                            {
                                @SectionDisplayHelper.GetSectionNameText(item.SectionName)
                            }
                        }
                        else if (col.Key == "IsActive")
                        {
                            if (rowEditing && rowCache != null)
                            {
                                <MudSwitch T="bool" Dense="true"
                                           Value="@rowCache.IsActive"
                                           ValueChanged="@(async v => { rowCache.IsActive = v; })"
                                           Color="Color.Primary" />
                            }
                            else
                            {
                                if (item.IsActive)
                                {
                                    <MudChip Size="Size.Small" Color="Color.Success">启用</MudChip>
                                }
                                else
                                {
                                    <MudChip Size="Size.Small" Color="Color.Default">停用</MudChip>
                                }
                            }
                        }
                        else
                        {
                            @("")
                        }
                        </MudTd>
                    }
                    <MudTd Style="white-space: nowrap; width: 90px;">
                        @if (rowEditing)
                        {
                            <MudIconButton Icon="@Icons.Material.Filled.Check" Color="Color.Success" Size="Size.Small" OnClick="() => SaveEdit(item)" Disabled="@_isSaving" />
                            <MudIconButton Icon="@Icons.Material.Filled.Close" Color="Color.Default" Size="Size.Small" OnClick="() => CancelEdit(item)" />
                        }
                        else
                        {
                            <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Info" Size="Size.Small" OnClick="() => StartEdit(item)" />
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" Title="删除" OnClick="() => DeleteItem(item)" />
                        }
                    </MudTd>
                </RowTemplate>
                <PagerContent>
                    <MudTablePager PageSizeOptions="new int[]{10,15,25,50,100}" />
                </PagerContent>
            </MudTable>
            </div>
        </MudCardContent>
    </MudCard>
</MudContainer>
