@page "/employees"
@using MES.Blazor.Services
@using MES.Core.Constants
@using MES.Core.Models
@using MES.Blazor.Helpers
@using Microsoft.AspNetCore.Authorization
@using MES.Blazor.Shared
@using MES.Core.DTOs.Configuration
@inject EmployeeService EmployeeService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject IJSRuntime JS
@inject ColumnPrefsService ColumnPrefs
@inject PageStateService PageState
@attribute [Authorize(Roles = Roles.Policies.AdminOnly)]

<MudContainer MaxWidth="MaxWidth.False" Class="mt-4 pl-0">
    <MudCard>
        <MudCardHeader>
            <CardHeaderContent>
                <MudText Typo="Typo.h5" Class="font-weight-bold">
                    <MudIcon Icon="@Icons.Material.Filled.Badge" Class="mr-2" Color="Color.Primary" />
                    员工管理
                </MudText>
            </CardHeaderContent>
            <CardHeaderActions>
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Add"
                           OnClick="AddNew">
                    新建
                </MudButton>
            </CardHeaderActions>
        </MudCardHeader>

        <MudCardContent>
            <!-- 搜索栏 -->
            <MudGrid>
                <MudItem xs="12" md="6">
                    <MudTextField T="string"
                                  Label="模糊搜索 - 工号/姓名/部门/岗位/结算模式"
                                  Value="_searchKeyword"
                                  ValueChanged="@OnSearchChanged"
                                  Immediate="true"
                                  DebounceInterval="500"
                                  Clearable="true"
                                  ClearButton="true"
                                  Adornment="Adornment.End"
                                  AdornmentIcon="@Icons.Material.Filled.Search" />
                </MudItem>
            </MudGrid>

            <!-- 数据表格 -->
            <div id="employees-list-table">
            <MudTable @ref="table"
                      T="EmployeeDto"
                      ServerData="@LoadDataFromServer"
                      Dense="true"
                      Hover="true"
                      Class="mt-4 auto-table"
                      Elevation="0"
                      RowsPerPage="@_pageSize"
                      RowsPerPageLabel="每页行数:">
                <ToolBarContent>
                    <ColumnDisplaySelect Columns="_allColumns"
                                         OnColumnToggle="OnColumnToggle"
                                         OnMoveUp="MoveColumnUp"
                                         OnMoveDown="MoveColumnDown" />
                    <MudButton Variant="Variant.Text" Size="Size.Small"
                               Color="Color.Default"
                               StartIcon="@Icons.Material.Filled.RestartAlt"
                               OnClick="ResetColumnDisplay" Class="ml-2">
                        重置
                    </MudButton>
                    <MudSpacer />
                    <MudText Typo="Typo.body2" Class="ml-auto">
                        共 @_totalCount 条记录
                    </MudText>
                </ToolBarContent>
                <HeaderContent>
                    @foreach (var col in _visibleColumns)
                    {
                        <MudTh>
                            <div style="display:inline-flex; align-items:center; gap:4px;">
                                <span @onclick='() => ToggleSort(col.Key)' style="cursor:pointer" class="th-label">@col.Label@if (col.IsRequired) {<span class="required-star">*</span>} @if (sortColumn == col.Key) {@(sortDescending ? " ▼" : " ▲")}</span>
                            </div>
                        </MudTh>
                    }
                    <MudTh Style="width: 90px;">操作</MudTh>
                </HeaderContent>
                <RowTemplate Context="item">
                    @{
                        var rowEditing = _editingIds.Contains(item.Id);
                        var rowCache = rowEditing && _editCache.TryGetValue(item.Id, out var rc) ? rc : null;
                    }
                    @foreach (var col in _visibleColumns)
                    {
                        <MudTd>
                        @if (col.Key == "Code")
                        {
                            if (rowEditing && rowCache != null)
                            {
                                <MudTextField T="string"
                                              Dense="true"
                                              Variant="Variant.Outlined"
                                              Value="@rowCache.Code"
                                              ValueChanged="@(v => rowCache.Code = v)"
                                              Class="compact-input"
                                              Required="true"
                                              Label="工号" />
                            }
                            else
                            {
                                <span class="font-weight-bold">@item.Code</span>
                            }
                        }
                        else if (col.Key == "Name")
                        {
                            if (rowEditing && rowCache != null)
                            {
                                <MudTextField T="string"
                                              Dense="true"
                                              Variant="Variant.Outlined"
                                              Value="@rowCache.Name"
                                              ValueChanged="@(v => rowCache.Name = v)"
                                              Class="compact-input"
                                              Required="true"
                                              Label="姓名" />
                            }
                            else
                            {
                                @item.Name
                            }
                        }
                        else if (col.Key == "Department")
                        {
                            if (rowEditing && rowCache != null)
                            {
                                <MudTextField T="string"
                                              Dense="true"
                                              Variant="Variant.Outlined"
                                              Value="@rowCache.Department"
                                              ValueChanged="@(v => rowCache.Department = v)"
                                              Class="compact-input"
                                              Label="部门" />
                            }
                            else
                            {
                                @item.Department
                            }
                        }
                        else if (col.Key == "Position")
                        {
                            if (rowEditing && rowCache != null)
                            {
                                <MudTextField T="string"
                                              Dense="true"
                                              Variant="Variant.Outlined"
                                              Value="@rowCache.Position"
                                              ValueChanged="@(v => rowCache.Position = v)"
                                              Class="compact-input"
                                              Label="岗位" />
                            }
                            else
                            {
                                @item.Position
                            }
                        }
                        else if (col.Key == "PositionRemark")
                        {
                            if (rowEditing && rowCache != null)
                            {
                                <MudTextField T="string"
                                              Dense="true"
                                              Variant="Variant.Outlined"
                                              Value="@rowCache.PositionRemark"
                                              ValueChanged="@(v => rowCache.PositionRemark = v)"
                                              Class="compact-input"
                                              Label="岗位备注" />
                            }
                            else
                            {
                                @item.PositionRemark
                            }
                        }
                        else if (col.Key == "SalaryMode")
                        {
                            if (rowEditing && rowCache != null)
                            {
                                <MudTextField T="string"
                                              Dense="true"
                                              Variant="Variant.Outlined"
                                              Value="@rowCache.SalaryMode"
                                              ValueChanged="@(v => rowCache.SalaryMode = v)"
                                              Class="compact-input"
                                              Label="工资结算模式" />
                            }
                            else
                            {
                                @item.SalaryMode
                            }
                        }
                        else if (col.Key == "SalaryRemark")
                        {
                            if (rowEditing && rowCache != null)
                            {
                                <MudTextField T="string"
                                              Dense="true"
                                              Variant="Variant.Outlined"
                                              Value="@rowCache.SalaryRemark"
                                              ValueChanged="@(v => rowCache.SalaryRemark = v)"
                                              Class="compact-input"
                                              Label="工资结算备注" />
                            }
                            else
                            {
                                @item.SalaryRemark
                            }
                        }
                        else if (col.Key == "IsActive")
                        {
                            if (rowEditing && rowCache != null)
                            {
                                <MudSwitch T="bool" Dense="true"
                                           Value="@rowCache.IsActive"
                                           ValueChanged="@(async v => { rowCache.IsActive = v; })"
                                           Color="Color.Primary" />
                            }
                            else
                            {
                                if (item.IsActive)
                                {
                                    <MudChip Size="Size.Small" Color="Color.Success">启用</MudChip>
                                }
                                else
                                {
                                    <MudChip Size="Size.Small" Color="Color.Default">停用</MudChip>
                                }
                            }
                        }
                        else
                        {
                            @("")
                        }
                        </MudTd>
                    }
                    <MudTd Style="white-space: nowrap; width: 90px;">
                        @if (rowEditing)
                        {
                            <MudIconButton Icon="@Icons.Material.Filled.Check" Color="Color.Success" Size="Size.Small" OnClick="() => SaveEdit(item)" Disabled="@_isSaving" />
                            <MudIconButton Icon="@Icons.Material.Filled.Close" Color="Color.Default" Size="Size.Small" OnClick="() => CancelEdit(item)" />
                        }
                        else
                        {
                            <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Info" Size="Size.Small" OnClick="() => StartEdit(item)" />
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" OnClick="() => DeleteItem(item)" />
                        }
                    </MudTd>
                </RowTemplate>
                <PagerContent>
                    <MudTablePager PageSizeOptions="new int[]{10,15,25,50,100}" />
                </PagerContent>
            </MudTable>
            </div>
        </MudCardContent>
    </MudCard>
</MudContainer>
