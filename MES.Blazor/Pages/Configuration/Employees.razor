@page "/employees"
@using MES.Blazor.Services
@using MES.Core.Constants
@using MES.Core.Models
@using MES.Blazor.Helpers
@using Microsoft.AspNetCore.Authorization
@using MES.Blazor.Shared
@using MES.Core.DTOs.Configuration
@inject EmployeeService EmployeeService
@inject StandardWorkDayService StandardWorkDayService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject IJSRuntime JS
@inject ColumnPrefsService ColumnPrefs
@inject PageStateService PageState
@attribute [Authorize(Roles = Roles.Policies.ConfigurationView)]

<MudContainer MaxWidth="MaxWidth.False" Class="mt-4 pl-0">
    <MudCard>
        <MudCardHeader>
            <CardHeaderContent>
                <MudText Typo="Typo.h5" Class="font-weight-bold">
                    <MudIcon Icon="@Icons.Material.Filled.Badge" Class="mr-2" Color="Color.Primary" />
                    扫码-员工管理
                </MudText>
            </CardHeaderContent>
            <CardHeaderActions>
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Add"
                           OnClick="AddNew">
                    新建
                </MudButton>
            </CardHeaderActions>
        </MudCardHeader>

        <MudCardContent>
            <!-- 搜索栏 -->
            <MudGrid>
                <MudItem xs="12" md="6">
                    <MudTextField T="string"
                                  Label="模糊搜索 - 工号/姓名/部门/岗位/结算模式"
                                  Value="_searchKeyword" ValueExpression="@(() => _searchKeyword)"
                                  ValueChanged="@OnSearchChanged"
                                  Immediate="true"
                                  DebounceInterval="500"
                                  Adornment="Adornment.End"
                                  AdornmentIcon="@Icons.Material.Filled.Search" />
                </MudItem>
            </MudGrid>

            <!-- 数据表格 -->
            <div id="employees-list-table">
            <!-- 工具栏 -->
            <div class="list-toolbar">
                <div class="d-flex align-center">
                    <ColumnDisplaySelect Columns="_allColumns"
                                         OnColumnToggle="OnColumnToggle"
                                         OnMoveUp="MoveColumnUp"
                                         OnMoveDown="MoveColumnDown" />
                    <MudButton Variant="Variant.Text" Size="Size.Small"
                               Color="Color.Default"
                               StartIcon="@Icons.Material.Filled.RestartAlt"
                               OnClick="ResetColumnDisplay" Class="ml-2">
                        重置
                    </MudButton>
                </div>
                <div class="d-flex align-center" style="margin-left:auto;">
                    <MudButton Variant="Variant.Text" Size="Size.Small"
                               Color="Color.Default"
                               StartIcon="@Icons.Material.Filled.Print"
                               OnClick="PrintSelected" Class="ml-2">
                        打印选中
                    </MudButton>
                    <MudButton Variant="Variant.Text" Size="Size.Small"
                               Color="Color.Default"
                               StartIcon="@Icons.Material.Filled.QrCode"
                               Disabled="@(!selectedIds.Any())"
                               OnClick="PrintQrCodes" Class="ml-2">
                        打印二维码
                    </MudButton>
                    <MudText Typo="Typo.body2" Class="ml-4">
                        共 @_totalCount 条记录
                    </MudText>
                </div>
            </div>
            <MudTable @ref="table"
                      T="EmployeeDto"
                      ServerData="@LoadDataFromServer"
                      Dense="true"
                      Hover="true"
                      Class="mt-0 auto-table"
                      Elevation="0"
                      RowsPerPage="@_pageSize"
                      RowsPerPageLabel="每页行数:">
                <HeaderContent>
                    <MudTh Class="col-selection-th" Style="width: 40px;">
                        <MudCheckBox Value="@allSelected"
                                     ValueChanged="@((bool v) => OnSelectAllChanged(v))" />
                    </MudTh>
                    @foreach (var col in _visibleColumns)
                    {
                        <MudTh>
                            <div style="display:inline-flex; align-items:center; gap:4px;">
                                <span @onclick='() => ToggleSort(col.Key)' style="cursor:pointer" class="th-label">@col.Label@if (col.IsRequired) {<span class="required-star">*</span>} @if (sortColumn == col.Key) {@(sortDescending ? " ▼" : " ▲")}</span>
                                @if (col.FilterType != null)
                                {
                                    <ExcelFilter T="EmployeeDto"
                                                 Label="@col.Label"
                                                 FieldKey="@col.Key"
                                                 FilterOptions="@(_filterContextOptions.GetValueOrDefault(col.Key))"
                                                 ActiveFilterValues="@(_columnFilters.GetValueOrDefault(col.Key))"
                                                 FilterChanged="@(args => OnColumnFilterChanged(args.fieldKey, args.selectedValues))" />
                                }
                            </div>
                        </MudTh>
                    }
                    <MudTh Style="width: 130px;">操作</MudTh>
                </HeaderContent>
                <RowTemplate Context="item">
                    @{
                        var rowEditing = _editingIds.Contains(item.Id);
                        var rowCache = rowEditing && _editCache.TryGetValue(item.Id, out var rc) ? rc : null;
                    }
                    <MudTd Class="col-selection-td">
                        <MudCheckBox Value="@(selectedIds.Contains(item.Id))"
                                     ValueChanged="@((bool v) => OnRowSelectionChanged(item.Id, v))" />
                    </MudTd>
                    @foreach (var col in _visibleColumns)
                    {
                        <MudTd>
                        @if (col.Key == "Code")
                        {
                            if (rowEditing && rowCache != null)
                            {
                                <MudTextField T="string"
                                              Dense="true"
                                              Variant="Variant.Outlined"
                                              Value="@rowCache.Code"
                                              ValueChanged="@(v => rowCache.Code = v)"
                                              Class="compact-input"
                                              Required="true"
                                              Label="工号" />
                            }
                            else
                            {
                                <span class="font-weight-bold">@item.Code</span>
                            }
                        }
                        else if (col.Key == "Name")
                        {
                            if (rowEditing && rowCache != null)
                            {
                                <MudTextField T="string"
                                              Dense="true"
                                              Variant="Variant.Outlined"
                                              Value="@rowCache.Name"
                                              ValueChanged="@(v => rowCache.Name = v)"
                                              Class="compact-input"
                                              Required="true"
                                              Label="姓名" />
                            }
                            else
                            {
                                @item.Name
                            }
                        }
                        else if (col.Key == "Department")
                        {
                            if (rowEditing && rowCache != null)
                            {
                                <MudTextField T="string"
                                              Dense="true"
                                              Variant="Variant.Outlined"
                                              Value="@rowCache.Department"
                                              ValueChanged="@(v => rowCache.Department = v)"
                                              Class="compact-input"
                                              Label="部门" />
                            }
                            else
                            {
                                @item.Department
                            }
                        }
                        else if (col.Key == "Position")
                        {
                            if (rowEditing && rowCache != null)
                            {
                                <MudTextField T="string"
                                              Dense="true"
                                              Variant="Variant.Outlined"
                                              Value="@rowCache.Position"
                                              ValueChanged="@(v => rowCache.Position = v)"
                                              Class="compact-input"
                                              Label="岗位" />
                            }
                            else
                            {
                                @item.Position
                            }
                        }
                        else if (col.Key == "PositionRemark")
                        {
                            if (rowEditing && rowCache != null)
                            {
                                <MudTextField T="string"
                                              Dense="true"
                                              Variant="Variant.Outlined"
                                              Value="@rowCache.PositionRemark"
                                              ValueChanged="@(v => rowCache.PositionRemark = v)"
                                              Class="compact-input"
                                              Label="岗位备注" />
                            }
                            else
                            {
                                @item.PositionRemark
                            }
                        }
                        else if (col.Key == "SalaryMode")
                        {
                            if (rowEditing && rowCache != null)
                            {
                                <MudTextField T="string"
                                              Dense="true"
                                              Variant="Variant.Outlined"
                                              Value="@rowCache.SalaryMode"
                                              ValueChanged="@(v => rowCache.SalaryMode = v)"
                                              Class="compact-input"
                                              Label="工资结算模式" />
                            }
                            else
                            {
                                @item.SalaryMode
                            }
                        }
                        else if (col.Key == "SalaryRemark")
                        {
                            if (rowEditing && rowCache != null)
                            {
                                <MudTextField T="string"
                                              Dense="true"
                                              Variant="Variant.Outlined"
                                              Value="@rowCache.SalaryRemark"
                                              ValueChanged="@(v => rowCache.SalaryRemark = v)"
                                              Class="compact-input"
                                              Label="工资结算备注" />
                            }
                            else
                            {
                                @item.SalaryRemark
                            }
                        }
                        else if (col.Key == "SectionName")
                        {
                            if (rowEditing && rowCache != null)
                            {
                                <MudSelect T="string"
                                           Dense="true"
                                           MultiSelection="true"
                                           Variant="Variant.Outlined"
                                           SelectedValues="@SplitSections(rowCache.SectionName)"
                                           SelectedValuesChanged="@(v => rowCache.SectionName = string.Join(",", v))"
                                           Class="compact-input"
                                           Label="生产工段（可多选）">
                                    @foreach (var opt in _sectionOptions)
                                    {
                                        <MudSelectItem Value="@opt.Key">@opt.Text</MudSelectItem>
                                    }
                                </MudSelect>
                            }
                            else
                            {
                                @FormatSections(item.SectionName)
                            }
                        }
                        else if (col.Key == "GroupName")
                        {
                            if (rowEditing && rowCache != null)
                            {
                                <MudTextField T="string"
                                              Dense="true"
                                              Variant="Variant.Outlined"
                                              Value="@rowCache.GroupName"
                                              ValueChanged="@(v => rowCache.GroupName = v)"
                                              Class="compact-input"
                                              Label="组类（多个逗号分隔，可空）" />
                            }
                            else
                            {
                                @item.GroupName
                            }
                        }
                        else if (col.Key == "ProcessInspectionItems")
                        {
                            if (rowEditing && rowCache != null)
                            {
                                <MudSwitch T="bool?"
                                           Dense="true"
                                           Value="@rowCache.ProcessInspectionItems"
                                           ValueChanged="@(v => rowCache.ProcessInspectionItems = v)"
                                           Color="Color.Primary" />
                            }
                            else
                            {
                                if (item.ProcessInspectionItems == true)
                                {
                                    <MudChip Size="Size.Small" Color="Color.Success">是</MudChip>
                                }
                                else
                                {
                                    <MudChip Size="Size.Small" Color="Color.Default">否</MudChip>
                                }
                            }
                        }
                        else if (col.Key == "MaterialReceiveCheckItems")
                        {
                            if (rowEditing && rowCache != null)
                            {
                                <MudSwitch T="bool?"
                                           Dense="true"
                                           Value="@rowCache.MaterialReceiveCheckItems"
                                           ValueChanged="@(v => rowCache.MaterialReceiveCheckItems = v)"
                                           Color="Color.Primary" />
                            }
                            else
                            {
                                if (item.MaterialReceiveCheckItems == true)
                                {
                                    <MudChip Size="Size.Small" Color="Color.Success">是</MudChip>
                                }
                                else
                                {
                                    <MudChip Size="Size.Small" Color="Color.Default">否</MudChip>
                                }
                            }
                        }
                        else if (col.Key == "InspectionItems")
                        {
                            if (rowEditing && rowCache != null)
                            {
                                <MudSelect T="string"
                                           Dense="true"
                                           MultiSelection="true"
                                           Variant="Variant.Outlined"
                                           SelectedValues="@SplitInspectionItems(rowCache.InspectionItems)"
                                           SelectedValuesChanged="@(v => rowCache.InspectionItems = string.Join(",", v))"
                                           Class="compact-input"
                                           Label="成检项目（可多选）">
                                    @foreach (var opt in _inspectionItemOptions)
                                    {
                                        <MudSelectItem Value="@opt.Key">@opt.Text</MudSelectItem>
                                    }
                                </MudSelect>
                            }
                            else
                            {
                                @FormatInspectionItems(item.InspectionItems)
                            }
                        }
                        else if (col.Key == "IsActive")
                        {
                            if (rowEditing && rowCache != null)
                            {
                                <MudSwitch T="bool" Dense="true"
                                           Value="@rowCache.IsActive"
                                           ValueChanged="@(async v => { rowCache.IsActive = v; })"
                                           Color="Color.Primary" />
                            }
                            else
                            {
                                if (item.IsActive)
                                {
                                    <MudChip Size="Size.Small" Color="Color.Success">启用</MudChip>
                                }
                                else
                                {
                                    <MudChip Size="Size.Small" Color="Color.Default">停用</MudChip>
                                }
                            }
                        }
                        else
                        {
                            @("")
                        }
                        </MudTd>
                    }
                    <MudTd Style="white-space: nowrap; width: 130px;">
                        @if (rowEditing)
                        {
                            <MudIconButton Icon="@Icons.Material.Filled.Check" Color="Color.Success" Size="Size.Small" OnClick="() => SaveEdit(item)" Disabled="@_isSaving" />
                            <MudIconButton Icon="@Icons.Material.Filled.Close" Color="Color.Default" Size="Size.Small" OnClick="() => CancelEdit(item)" />
                        }
                        else
                        {
                            <MudIconButton Icon="@Icons.Material.Filled.QrCode" Color="Color.Default" Size="Size.Small" Title="二维码" OnClick="() => PrintSingleQrCode(item)" />
                            <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Info" Size="Size.Small" OnClick="() => StartEdit(item)" />
                        <AuthorizeView Roles="@Roles.Policies.ConfigurationDelete">
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" Title="删除" OnClick="() => DeleteItem(item)" />
                        </AuthorizeView>
                        }
                    </MudTd>
                </RowTemplate>
                <PagerContent>
                    <MudTablePager PageSizeOptions="new int[]{10,15,25,50,100}" />
                </PagerContent>
            </MudTable>
            </div>
        </MudCardContent>
    </MudCard>
</MudContainer>
