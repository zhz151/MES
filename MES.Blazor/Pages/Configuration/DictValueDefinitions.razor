@page "/dict-value-definitions"
@using MES.Blazor.Services
@using MES.Core.Constants
@using MES.Core.Models
@using MES.Blazor.Helpers
@using MES.Core.Helpers
@using Microsoft.AspNetCore.Authorization
@using MES.Blazor.Shared
@using MES.Core.DTOs.Configuration
@using System.Text.Json
@inject DictValueDefinitionService DictValueDefinitionService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject IJSRuntime JS
@inject ColumnPrefsService ColumnPrefs
@inject PageStateService PageState
@attribute [Authorize(Roles = Roles.Policies.ConfigurationView)]

<MudContainer MaxWidth="MaxWidth.False" Class="mt-4 pl-0">
    <MudCard>
        <MudCardHeader>
            <CardHeaderContent>
                <MudText Typo="Typo.h5" Class="font-weight-bold">
                    <MudIcon Icon="@Icons.Material.Filled.Tune" Class="mr-2" Color="Color.Primary" />
                    字典显示配置
                </MudText>
            </CardHeaderContent>
            <CardHeaderActions>
                <MudButton Variant="Variant.Text"
                           Color="Color.Secondary"
                           StartIcon="@Icons.Material.Filled.Restore"
                           OnClick="RestoreDefaults"
                           Disabled="@(string.IsNullOrEmpty(_selectedDictKey) || _isRestoring)">
                    恢复默认
                </MudButton>
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Add"
                           OnClick="AddNew">
                    新建
                </MudButton>
            </CardHeaderActions>
        </MudCardHeader>

        <MudCardContent>
            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mb-3">
                管理 string 存储字典字段（工段/工序/紧急度/产类/流转/关注目标/汇总行/责任类别）的中文显示名、
                显示顺序、启用状态与新增值。英文 Key 为存储/程序识别契约（字母开头，仅字母/数字/下划线）；
                隐藏（停用）后下拉/筛选不再出现，存量显示不受影响。刷新页面后生效。
            </MudAlert>

            <!-- 字典筛选 -->
            <MudGrid>
                <MudItem xs="12" md="4">
                    <MudSelect T="string"
                               Label="按字典筛选"
                               Value="_selectedDictKey"
                               ValueChanged="@OnDictKeyChanged"
                               Dense="true"
                               Variant="Variant.Outlined">
                        @foreach (var kv in _dictKeyOptions)
                        {
                            <MudSelectItem T="string" Value="@kv.Key">@kv.Text</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
            </MudGrid>

            <!-- 数据表格 -->
            <div id="dict-value-definitions-list-table">
            <MudTable @ref="table"
                      T="DictValueDefinitionDto"
                      ServerData="@LoadDataFromServer"
                      Dense="true"
                      Hover="true"
                      Class="mt-4 auto-table"
                      Elevation="0"
                      RowsPerPage="@_pageSize"
                      RowsPerPageLabel="每页行数:">
                <ToolBarContent>
                    <ColumnDisplaySelect Columns="_allColumns"
                                         OnColumnToggle="OnColumnToggle"
                                         OnMoveUp="MoveColumnUp"
                                         OnMoveDown="MoveColumnDown" />
                    <MudButton Variant="Variant.Text" Size="Size.Small"
                               Color="Color.Default"
                               StartIcon="@Icons.Material.Filled.RestartAlt"
                               OnClick="ResetColumnDisplay" Class="ml-2">
                        重置
                    </MudButton>
                    <MudSpacer />
                    <MudText Typo="Typo.body2" Class="ml-auto">
                        共 @_totalCount 条记录
                    </MudText>
                </ToolBarContent>
                <HeaderContent>
                    @foreach (var col in _visibleColumns)
                    {
                        <MudTh>
                            <div style="display:inline-flex; align-items:center; gap:4px;">
                                <span @onclick='() => ToggleSort(col.Key)' style="cursor:pointer" class="th-label">@col.Label@if (col.IsRequired) {<span class="required-star">*</span>} @if (sortColumn == col.Key) {@(sortDescending ? " ▼" : " ▲")}</span>
                                @if (col.FilterType != null)
                                {
                                    <ExcelFilter T="DictValueDefinitionDto"
                                                 Label="@col.Label"
                                                 FieldKey="@col.Key"
                                                 FilterOptions="@(_filterContextOptions.GetValueOrDefault(col.Key))"
                                                 ActiveFilterValues="@(_columnFilters.GetValueOrDefault(col.Key))"
                                                 FilterChanged="@(args => OnColumnFilterChanged(args.fieldKey, args.selectedValues))" />
                                }
                            </div>
                        </MudTh>
                    }
                    <MudTh Style="width: 90px;">操作</MudTh>
                </HeaderContent>
                <RowTemplate Context="item">
                    @{
                        var rowEditing = _editingIds.Contains(item.Id);
                        var rowCache = rowEditing && _editCache.TryGetValue(item.Id, out var rc) ? rc : null;
                    }
                    @foreach (var col in _visibleColumns)
                    {
                        <MudTd>
                        @if (col.Key == "DictKey")
                        {
                            @GetDictKeyText(item.DictKey)
                        }
                        else if (col.Key == "Value")
                        {
                            if (rowEditing && rowCache != null)
                            {
                                <MudTextField T="string"
                                              Dense="true"
                                              Variant="Variant.Outlined"
                                              Value="@rowCache.Value"
                                              ValueChanged="@(v => rowCache.Value = v)"
                                              Class="compact-input"
                                              Disabled="@(!IsNewItem(item.Id))"
                                              Title="@(IsNewItem(item.Id) ? "新增字典值可自定义英文 Key" : "存储/程序识别契约，不可修改")"
                                              Label="@(IsNewItem(item.Id) ? "英文 Key（字母开头）" : "英文 Key（契约）")" />
                            }
                            else
                            {
                                @item.Value
                            }
                        }
                        else if (col.Key == "DisplayName")
                        {
                            if (rowEditing && rowCache != null)
                            {
                                <MudTextField T="string"
                                              Dense="true"
                                              Variant="Variant.Outlined"
                                              Value="@rowCache.DisplayName"
                                              ValueChanged="@(v => rowCache.DisplayName = v)"
                                              Class="compact-input"
                                              Required="true"
                                              Label="中文显示（可改名）" />
                            }
                            else
                            {
                                @item.DisplayName
                            }
                        }
                        else if (col.Key == "DisplayOrder")
                        {
                            if (rowEditing && rowCache != null)
                            {
                                <MudNumericField T="int"
                                                 Dense="true"
                                                 Variant="Variant.Outlined"
                                                 HideSpinButtons="true"
                                                 Value="@rowCache.DisplayOrder"
                                                 ValueChanged="@(v => rowCache.DisplayOrder = v)"
                                                 Class="compact-input"
                                                 Min="1"
                                                 Max="999" />
                            }
                            else
                            {
                                @item.DisplayOrder
                            }
                        }
                        else if (col.Key == "IsEnabled")
                        {
                            if (rowEditing && rowCache != null)
                            {
                                <MudSwitch T="bool" Dense="true"
                                           Value="@rowCache.IsEnabled"
                                           ValueChanged="@(v => rowCache.IsEnabled = v)"
                                           Color="Color.Primary" />
                            }
                            else
                            {
                                @(item.IsEnabled ? "启用" : "隐藏")
                            }
                        }
                        else if (col.Key == "Remark")
                        {
                            if (rowEditing && rowCache != null)
                            {
                                <MudTextField T="string"
                                              Dense="true"
                                              Variant="Variant.Outlined"
                                              Value="@rowCache.Remark"
                                              ValueChanged="@(v => rowCache.Remark = v)"
                                              Class="compact-input" />
                            }
                            else
                            {
                                @item.Remark
                            }
                        }
                        else
                        {
                            @("")
                        }
                        </MudTd>
                    }
                    <MudTd Style="white-space: nowrap; width: 90px;">
                        @if (rowEditing)
                        {
                            <MudIconButton Icon="@Icons.Material.Filled.Check" Color="Color.Success" Size="Size.Small" OnClick="() => SaveEdit(item)" Disabled="@_isSaving" />
                            <MudIconButton Icon="@Icons.Material.Filled.Close" Color="Color.Default" Size="Size.Small" OnClick="() => CancelEdit(item)" />
                        }
                        else
                        {
                            <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Info" Size="Size.Small" OnClick="() => StartEdit(item)" />
                        <AuthorizeView Roles="@Roles.Policies.ConfigurationDelete">
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" Title="删除" OnClick="() => DeleteItem(item)" />
                        </AuthorizeView>
                        }
                    </MudTd>
                </RowTemplate>
                <PagerContent>
                    <MudTablePager PageSizeOptions="new int[]{10,15,25,50,100}" />
                </PagerContent>
            </MudTable>
            </div>
        </MudCardContent>
    </MudCard>
</MudContainer>
