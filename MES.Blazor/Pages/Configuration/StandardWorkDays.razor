@page "/standard-work-days"
@using MES.Blazor.Services
@using MES.Core.Constants
@using MES.Core.Models
@using MES.Blazor.Helpers
@using Microsoft.AspNetCore.Authorization
@using MES.Blazor.Shared
@using MES.Core.DTOs.Configuration
@using System.Text.Json
@inject StandardWorkDayService StandardWorkDayService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject IJSRuntime JS
@inject ColumnPrefsService ColumnPrefs
@inject PageStateService PageState
@attribute [Authorize(Roles = Roles.Policies.ConfigurationView)]

<MudContainer MaxWidth="MaxWidth.False" Class="mt-4 pl-0">
    <MudCard>
        <MudCardHeader>
            <CardHeaderContent>
                <MudText Typo="Typo.h5" Class="font-weight-bold">
                    <MudIcon Icon="@Icons.Material.Filled.CalendarMonth" Class="mr-2" Color="Color.Primary" />
                    工段工量天数
                </MudText>
            </CardHeaderContent>
            <CardHeaderActions>
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Add"
                           OnClick="AddNew">
                    新建
                </MudButton>
            </CardHeaderActions>
        </MudCardHeader>

        <MudCardContent>
            <!-- 搜索栏 -->
            <MudGrid>
                <MudItem xs="12" md="6">
                    <MudTextField T="string"
                                  Label="模糊搜索 - 工段名称/牌号前缀/备注"
                                  Value="_searchKeyword" ValueExpression="@(() => _searchKeyword)"
                                  ValueChanged="@OnSearchChanged"
                                  Immediate="true"
                                  DebounceInterval="500"
                                  Adornment="Adornment.End"
                                  AdornmentIcon="@Icons.Material.Filled.Search" />
                </MudItem>
            </MudGrid>

            <!-- 数据表格 -->
            <div id="standard-work-days-list-table">
            <MudTable @ref="table"
                      T="StandardWorkDayDto"
                      ServerData="@LoadDataFromServer"
                      Dense="true"
                      Hover="true"
                      Class="mt-4 auto-table"
                      Elevation="0"
                      RowsPerPage="@_pageSize"
                      RowsPerPageLabel="每页行数:">
                <ToolBarContent>
                    <ColumnDisplaySelect Columns="_allColumns"
                                         OnColumnToggle="OnColumnToggle"
                                         OnMoveUp="MoveColumnUp"
                                         OnMoveDown="MoveColumnDown" />
                    <MudButton Variant="Variant.Text" Size="Size.Small"
                               Color="Color.Default"
                               StartIcon="@Icons.Material.Filled.RestartAlt"
                               OnClick="ResetColumnDisplay" Class="ml-2">
                        重置
                    </MudButton>
                    <MudSpacer />
                    <MudText Typo="Typo.body2" Class="ml-auto">
                        共 @_totalCount 条记录
                    </MudText>
                </ToolBarContent>
                <HeaderContent>
                    @foreach (var col in _visibleColumns)
                    {
                        <MudTh>
                            <div style="display:inline-flex; align-items:center; gap:4px;">
                                <span @onclick='() => ToggleSort(col.Key)' style="cursor:pointer" class="th-label">@col.Label@if (col.IsRequired) {<span class="required-star">*</span>} @if (sortColumn == col.Key) {@(sortDescending ? " ▼" : " ▲")}</span>
                            </div>
                        </MudTh>
                    }
                    <MudTh Style="width: 90px;">操作</MudTh>
                </HeaderContent>
                <RowTemplate Context="item">
                    @{
                        var rowEditing = _editingIds.Contains(item.Id);
                        var rowCache = rowEditing && _editCache.TryGetValue(item.Id, out var rc) ? rc : null;
                    }
                    @foreach (var col in _visibleColumns)
                    {
                        <MudTd>
                        @if (col.Key == "SectionName")
                        {
                            if (rowEditing && rowCache != null)
                            {
                                <MudTextField T="string"
                                              Dense="true"
                                              Variant="Variant.Outlined"
                                              Value="@rowCache.SectionName"
                                              ValueChanged="@(v => rowCache.SectionName = v)"
                                              Class="compact-input"
                                              Required="true"
                                              Label="工段名称（可改名，槽位复用启新工段）" />
                            }
                            else
                            {
                                @item.SectionName
                            }
                        }
                        else if (col.Key == "SectionKey")
                        {
                            if (rowEditing && rowCache != null)
                            {
                                <MudTextField T="string"
                                              Dense="true"
                                              Variant="Variant.Outlined"
                                              Value="@rowCache.SectionKey"
                                              ValueChanged="@(v => rowCache.SectionKey = v)"
                                              Class="compact-input"
                                              Disabled="true"
                                              Title="程序识别工段用，随名称自动映射" />
                            }
                            else
                            {
                                @item.SectionKey
                            }
                        }
                        else if (col.Key == "DisplayOrder")
                        {
                            if (rowEditing && rowCache != null)
                            {
                                <MudNumericField T="int"
                                                 Dense="true"
                                                 Variant="Variant.Outlined"
                                                 HideSpinButtons="true"
                                                 Value="@rowCache.DisplayOrder"
                                                 ValueChanged="@(v => rowCache.DisplayOrder = v)"
                                                 Class="compact-input"
                                                 Min="1"
                                                 Max="999" />
                            }
                            else
                            {
                                @item.DisplayOrder
                            }
                        }
                        else if (col.Key == "IsEnabled")
                        {
                            if (rowEditing && rowCache != null)
                            {
                                <MudSwitch T="bool" Dense="true"
                                           Value="@rowCache.IsEnabled"
                                           ValueChanged="@(async v => { rowCache.IsEnabled = v; })"
                                           Color="Color.Primary" />
                            }
                            else
                            {
                                @(item.IsEnabled ? "启用" : "隐藏")
                            }
                        }
                        else if (col.Key == "PlantGradePrefix")
                        {
                            if (rowEditing && rowCache != null)
                            {
                                <MudTextField T="string"
                                              Dense="true"
                                              Variant="Variant.Outlined"
                                              Value="@rowCache.PlantGradePrefix"
                                              ValueChanged="@(v => rowCache.PlantGradePrefix = v)"
                                              Class="compact-input" />
                            }
                            else
                            {
                                @item.PlantGradePrefix
                            }
                        }
                        else if (col.Key == "StandardDays")
                        {
                            if (rowEditing && rowCache != null)
                            {
                                <MudNumericField T="double"
                                                 Dense="true"
                                                 Variant="Variant.Outlined"
                                                 HideSpinButtons="true"
                                                 Value="@rowCache.StandardDays"
                                                 ValueChanged="@(v => rowCache.StandardDays = v)"
                                                 Class="compact-input"
                                                 Min="0.1"
                                                 Max="365"
                                                 Format="G29" />
                            }
                            else
                            {
                                @item.StandardDays.ToString("G29")
                            }
                        }
                        else if (col.Key == "Remark")
                        {
                            if (rowEditing && rowCache != null)
                            {
                                <MudTextField T="string"
                                              Dense="true"
                                              Variant="Variant.Outlined"
                                              Value="@rowCache.Remark"
                                              ValueChanged="@(v => rowCache.Remark = v)"
                                              Class="compact-input" />
                            }
                            else
                            {
                                @item.Remark
                            }
                        }
                        else
                        {
                            @("")
                        }
                        </MudTd>
                    }
                    <MudTd Style="white-space: nowrap; width: 90px;">
                        @if (rowEditing)
                        {
                            <MudIconButton Icon="@Icons.Material.Filled.Check" Color="Color.Success" Size="Size.Small" OnClick="() => SaveEdit(item)" Disabled="@_isSaving" />
                            <MudIconButton Icon="@Icons.Material.Filled.Close" Color="Color.Default" Size="Size.Small" OnClick="() => CancelEdit(item)" />
                        }
                        else
                        {
                            <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Info" Size="Size.Small" OnClick="() => StartEdit(item)" />
                        <AuthorizeView Roles="@Roles.Policies.ConfigurationDelete">
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" Title="删除" OnClick="() => DeleteItem(item)" />
                        </AuthorizeView>
                        }
                    </MudTd>
                </RowTemplate>
                <PagerContent>
                    <MudTablePager PageSizeOptions="new int[]{10,15,25,50,100}" />
                </PagerContent>
            </MudTable>
            </div>
        </MudCardContent>
    </MudCard>
</MudContainer>
