@page "/section-flow-category-settings"
@using MES.Blazor.Services
@using MES.Core.Models
@using MES.Blazor.Shared
@using MES.Core.DTOs.Configuration
@using Microsoft.AspNetCore.Authorization
@inject SectionFlowCategoryService Service
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@attribute [Authorize(Roles = Roles.Policies.ConfigurationView)]

<MudContainer MaxWidth="MaxWidth.False" Class="mt-4 pl-0">
    <MudCard>
        <MudCardHeader>
            <CardHeaderContent>
                <MudText Typo="Typo.h5" Class="font-weight-bold">
                    <MudIcon Icon="@Icons.Material.Filled.Tune" Class="mr-2" Color="Color.Primary" />
                    流转类别日产配置
                </MudText>
            </CardHeaderContent>
            <CardHeaderActions>
                <MudText Typo="Typo.body2" Class="mr-4">
                    共 @_items.Count 个类别
                </MudText>
                <MudButton Variant="Variant.Filled"
                           Color="Color.Success"
                           Disabled="@_isLoading"
                           OnClick="AddNewSetting"
                           Class="mr-2">
                    <MudIcon Icon="@Icons.Material.Filled.Add" Class="mr-1" />
                    新增类别
                </MudButton>
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           Disabled="@_isLoading"
                           OnClick="LoadDataAsync">
                    <MudIcon Icon="@Icons.Material.Filled.Refresh" Class="mr-1" />
                    刷新
                </MudButton>
            </CardHeaderActions>
        </MudCardHeader>

        <MudCardContent>
            <MudTable @ref="table"
                      T="SectionFlowCategorySettingDto"
                      Items="@_items"
                      Dense="true" Hover="true" Elevation="0" Class="auto-table"
                      RowsPerPage="25" RowsPerPageLabel="每页行数:">
                <HeaderContent>
                    <MudTh><span class="th-label">流转类别<span class="required-star">*</span></span></MudTh>
                    <MudTh Class="mud-table-cell--right"><span class="th-label">排序号</span></MudTh>
                    <MudTh Class="mud-table-cell--right"><span class="th-label">日产设定</span></MudTh>
                    <MudTh Class="mud-table-cell--right"><span class="th-label">偏少天数值</span></MudTh>
                    <MudTh Class="mud-table-cell--right"><span class="th-label">过多天数值</span></MudTh>
                    <MudTh><span class="th-label">备注</span></MudTh>
                    <MudTh Style="width: 120px;">操作</MudTh>
                </HeaderContent>
                <RowTemplate Context="item">
                    @{
                        var rowEditing = _editingIds.Contains(item.Id);
                        var rowCache = rowEditing && _editCache.TryGetValue(item.Id, out var rc) ? rc : null;
                    }
                    <MudTd>
                        @if (rowEditing && rowCache != null)
                        {
                            <MudTextField T="string" Dense="true" Variant="Variant.Outlined"
                                          Value="@rowCache.CategoryName"
                                          ValueChanged="@(v => rowCache.CategoryName = v)"
                                          Class="compact-input" />
                        }
                        else
                        {
                            @item.CategoryName
                        }
                    </MudTd>
                    <MudTd Class="mud-table-cell--right">
                        @if (rowEditing && rowCache != null)
                        {
                            <MudNumericField T="int" Dense="true" Variant="Variant.Outlined"
                                             HideSpinButtons="true"
                                             Value="@rowCache.DisplayOrder"
                                             ValueChanged="@(v => rowCache.DisplayOrder = v)"
                                             Class="compact-input" Style="max-width:70px;" />
                        }
                        else
                        {
                            @item.DisplayOrder
                        }
                    </MudTd>
                    <MudTd Class="mud-table-cell--right">
                        @if (rowEditing && rowCache != null)
                        {
                            <MudNumericField T="decimal?" Dense="true" Variant="Variant.Outlined"
                                             HideSpinButtons="true" Format="G29"
                                             Value="@rowCache.DailyProductionTarget"
                                             ValueChanged="@(v => rowCache.DailyProductionTarget = v)"
                                             Class="compact-input" />
                        }
                        else
                        {
                            @(item.DailyProductionTarget?.ToString("G29") ?? "-")
                        }
                    </MudTd>
                    <MudTd Class="mud-table-cell--right">
                        @if (rowEditing && rowCache != null)
                        {
                            <MudNumericField T="decimal?" Dense="true" Variant="Variant.Outlined"
                                             HideSpinButtons="true" Format="G29"
                                             Value="@rowCache.LowerLimitDays"
                                             ValueChanged="@(v => rowCache.LowerLimitDays = v)"
                                             Class="compact-input" />
                        }
                        else
                        {
                            @(item.LowerLimitDays?.ToString("G29") ?? "-")
                        }
                    </MudTd>
                    <MudTd Class="mud-table-cell--right">
                        @if (rowEditing && rowCache != null)
                        {
                            <MudNumericField T="decimal?" Dense="true" Variant="Variant.Outlined"
                                             HideSpinButtons="true" Format="G29"
                                             Value="@rowCache.UpperLimitDays"
                                             ValueChanged="@(v => rowCache.UpperLimitDays = v)"
                                             Class="compact-input" />
                        }
                        else
                        {
                            @(item.UpperLimitDays?.ToString("G29") ?? "-")
                        }
                    </MudTd>
                    <MudTd>
                        @if (rowEditing && rowCache != null)
                        {
                            <MudTextField T="string" Dense="true" Variant="Variant.Outlined"
                                          Value="@rowCache.Remark"
                                          ValueChanged="@(v => rowCache.Remark = v)"
                                          Class="compact-input" />
                        }
                        else
                        {
                            @item.Remark
                        }
                    </MudTd>
                    <MudTd Style="white-space: nowrap; width: 120px;" @onclick:stopPropagation>
                        @if (rowEditing)
                        {
                            <MudIconButton Icon="@Icons.Material.Filled.Check" Color="Color.Success" Size="Size.Small" OnClick="() => SaveEdit(item)" Disabled="@_isSaving" />
                            <MudIconButton Icon="@Icons.Material.Filled.Close" Color="Color.Default" Size="Size.Small" OnClick="() => CancelEdit(item)" />
                        }
                        else
                        {
                            <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Info" Size="Size.Small" OnClick="() => StartEdit(item)" />
                        <AuthorizeView Roles="@Roles.Policies.ConfigurationDelete">
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" OnClick="() => DeleteSetting(item)" />
                        </AuthorizeView>
                        }
                    </MudTd>
                </RowTemplate>
                <PagerContent>
                    <MudTablePager PageSizeOptions="new int[]{10,25,50,100}" />
                </PagerContent>
            </MudTable>
        </MudCardContent>
    </MudCard>

    <!-- 加载遮罩 -->
    <MudOverlay Visible="@_isLoading">
        <div class="d-flex justify-center align-center" style="height: 100%;">
            <MudProgressCircular Indeterminate="true" Size="Size.Large" />
        </div>
    </MudOverlay>
</MudContainer>
