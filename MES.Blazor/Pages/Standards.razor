@page "/standards"
@using MES.Blazor.Services
@using MES.Core.DTOs
@using MES.Core.Models
@using Microsoft.AspNetCore.Authorization
@using MES.Blazor.Shared
@inject ProductionStandardService StandardService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject IJSRuntime JS
@attribute [Authorize(Roles = "OrderStaff,OrderDirector,Admin")]

<div class="mt-4">
    <MudCard>
        <MudCardHeader>
            <CardHeaderContent>
                <MudText Typo="Typo.h5" Class="font-weight-bold">
                    <MudIcon Icon="@Icons.Material.Filled.DocumentScanner" Class="mr-2" Color="Color.Primary" />
                    产品标准管理
                </MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">生产标准/工艺标准配置</MudText>
            </CardHeaderContent>
            <CardHeaderActions>
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Add"
                           OnClick="NavigateToCreate">
                    新建标准
                </MudButton>
            </CardHeaderActions>
        </MudCardHeader>

        <MudCardContent>
            <!-- 搜索栏 -->
            <MudGrid>
                <MudItem xs="12" md="12">
                    <MudTextField T="string"
                                  Label="模糊搜索 - 标准编码/名称/状态"
                                  Placeholder="输入关键字..."
                                  Value="searchKeyword"
                                  ValueChanged="@OnSearchChanged"
                                  Immediate="true"
                                  DebounceInterval="500"
                                  Clearable="true"
                                  ClearButton="true"
                                  Adornment="Adornment.End"
                                  AdornmentIcon="@Icons.Material.Filled.Search" />
                </MudItem>
            </MudGrid>

            <MudTable @ref="table"
                      T="ProductionStandardDto"
                      ServerData="OnServerData"
                      Loading="@isLoading"
                      Dense="true"
                      Hover="true"
                      Class="mt-4"
                      Elevation="0"
                      RowsPerPageLabel="每页行数:">
                <ToolBarContent>
                    <MudButton Variant="Variant.Outlined"
                               Size="Size.Small"
                               Color="Color.Info"
                               StartIcon="@Icons.Material.Filled.Print"
                               Disabled="@(!selectedIds.Any())"
                               OnClick="PrintSelected">
                        打印选中 (@selectedIds.Count)
                    </MudButton>
                    <MudButton Variant="Variant.Text"
                               Size="Size.Small"
                               Color="Color.Info"
                               StartIcon="@Icons.Material.Filled.Print"
                               OnClick="PrintAll">
                        打印全部
                    </MudButton>
                    <MudText Typo="Typo.body2" Class="ml-auto">
                        共 @totalCount 条记录
                    </MudText>
                </ToolBarContent>
                <HeaderContent>
                    <MudTh Style="width: 40px;">
                        <MudCheckBox T="bool" @bind-Value="allSelected" Dense="true" />
                    </MudTh>
                    <MudTh>
                        <span @onclick='() => ToggleSort("standardcode")' class="sortable-header">
                            标准编码
                            @if (sortColumn == "standardcode")
                            {
                                <span class="sort-arrow">@GetSortIndicator("standardcode")</span>
                            }
                        </span>
                    </MudTh>
                    <MudTh>
                        <span @onclick='() => ToggleSort("standardname")' class="sortable-header">
                            标准名称
                            @if (sortColumn == "standardname")
                            {
                                <span class="sort-arrow">@GetSortIndicator("standardname")</span>
                            }
                        </span>
                    </MudTh>
                    <MudTh>
                        <span @onclick='() => ToggleSort("isactive")' class="sortable-header">
                            状态
                            @if (sortColumn == "isactive")
                            {
                                <span class="sort-arrow">@GetSortIndicator("isactive")</span>
                            }
                        </span>
                    </MudTh>
                    <MudTh>操作</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd Style="width: 40px;">
                        <MudCheckBox T="bool"
                                     Value="@selectedIds.Contains(context.Id)"
                                     ValueChanged="@((v) => { if(v) selectedIds.Add(context.Id); else selectedIds.Remove(context.Id); _allSelected = standards.Any() && standards.All(i => selectedIds.Contains(i.Id)); StateHasChanged(); })"
                                     Dense="true" />
                    </MudTd>
                    <MudTd title="@context.StandardCode">
                        <MudLink Typo="Typo.body2" OnClick="() => ViewStandard(context.Id)">@context.StandardCode</MudLink>
                    </MudTd>
                    <MudTd title="@context.StandardName">@context.StandardName</MudTd>
                    <MudTd>
                        <MudChip Size="Size.Small" Color="@(context.IsActive ? Color.Success : Color.Error)">
                            @(context.IsActive ? "启用" : "停用")
                        </MudChip>
                    </MudTd>
                    <MudTd>
                        <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                       Color="Color.Warning"
                                       Size="Size.Small"
                                       OnClick="() => EditStandard(context.Id)" />
                        <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                       Color="Color.Error"
                                       Size="Size.Small"
                                       OnClick="() => DeleteStandard(context)" />
                    </MudTd>
                </RowTemplate>
                <PagerContent>
                    <MudTablePager />
                </PagerContent>
            </MudTable>
        </MudCardContent>
    </MudCard>
</div>

@code {
    private MudTable<ProductionStandardDto>? table;
    private List<ProductionStandardDto> standards = new();
    private HashSet<int> selectedIds = new();
    private bool _allSelected;
    private bool allSelected
    {
        get => _allSelected;
        set
        {
            if (_allSelected == value) return;
            _allSelected = value;
            if (value)
            {
                foreach (var item in standards)
                    selectedIds.Add(item.Id);
            }
            else
            {
                selectedIds.Clear();
            }
            StateHasChanged();
        }
    }
    private bool isLoading = false;
    private string searchKeyword = string.Empty;
    private int totalCount = 0;

    private string sortColumn = "standardcode";
    private bool sortDescending = false;

    private string GetSortIndicator(string column)
    {
        if (sortColumn != column) return "";
        return sortDescending ? "\u25BC" : "\u25B2";
    }

    private async Task<TableData<ProductionStandardDto>> OnServerData(TableState state)
    {
        isLoading = true;
        StateHasChanged();

        try
        {
            var queryParams = new QueryParams
            {
                PageIndex = state.Page + 1,
                PageSize = state.PageSize,
                Keyword = string.IsNullOrWhiteSpace(searchKeyword) ? null : searchKeyword,
                SortBy = sortColumn,
                IsDescending = sortDescending
            };

            var result = await StandardService.GetPagedAsync(queryParams, null);

            if (result.Success && result.Data != null)
            {
                standards = result.Data.Items;
                totalCount = result.Data.TotalCount;
                return new TableData<ProductionStandardDto>
                {
                    Items = standards,
                    TotalItems = totalCount
                };
            }

            return new TableData<ProductionStandardDto>
            {
                Items = new List<ProductionStandardDto>(),
                TotalItems = 0
            };
        }
        catch (Exception ex)
        {
            Console.WriteLine($"加载失败: {ex.Message}");
            Snackbar.Add($"加载失败: {ex.Message}", Severity.Error);
            return new TableData<ProductionStandardDto>
            {
                Items = new List<ProductionStandardDto>(),
                TotalItems = 0
            };
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task ToggleSort(string column)
    {
        if (sortColumn == column)
            sortDescending = !sortDescending;
        else
        {
            sortColumn = column;
            sortDescending = false;
        }
        if (table != null)
            await table.ReloadServerData();
    }

    private async Task Search()
    {
        if (table != null)
        {
            await table.ReloadServerData();
        }
    }

    private async Task OnSearchChanged(string value)
    {
        searchKeyword = value ?? string.Empty;
        if (table != null)
            await table.ReloadServerData();
    }

    private void NavigateToCreate() => Navigation.NavigateTo("/standards/create");
    private void ViewStandard(int id) => Navigation.NavigateTo($"/standards/{id}");
    private void EditStandard(int id) => Navigation.NavigateTo($"/standards/{id}/edit");

    private async Task DeleteStandard(ProductionStandardDto standard)
    {
        var dialog = DialogService.Show<ConfirmDialog>("确认", new DialogParameters
        {
            ["ContentText"] = $"确定要删除标准 \"{standard.StandardCode}\" 吗？\n\n删除后数据将不可恢复！",
            ["ConfirmText"] = "确认删除",
            ["Color"] = Color.Error
        });
        var dialogResult = await dialog.Result;
        if (!dialogResult.Canceled)
        {
            try
            {
                var result = await StandardService.DeleteAsync(standard.Id);
                if (result.Success)
                {
                    Snackbar.Add("删除成功", Severity.Success);
                    await Search();
                }
                else
                {
                    Snackbar.Add(result.Message ?? "删除失败", Severity.Error);
                }
            }
            catch (Exception ex)
            {
                Snackbar.Add($"删除失败: {ex.Message}", Severity.Error);
            }
        }
    }

    // ========== 打印方法 ==========

    private async Task PrintSelected()
    {
        if (!selectedIds.Any())
        {
            Snackbar.Add("请先选择要打印的标准", Severity.Warning);
            return;
        }
        try
        {
            var ids = selectedIds.ToArray();
            var result = await StandardService.PrintStandardBatchAsync(ids);
            if (result.Success && result.Data != null)
                await JS.InvokeVoidAsync("openPdf", result.Data);
            else
                Snackbar.Add(result.Message ?? "打印失败", Severity.Error);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"打印失败: {ex.Message}", Severity.Error);
        }
    }

    private async Task PrintAll()
    {
        try
        {
            var result = await StandardService.PrintStandardAllAsync(
                string.IsNullOrWhiteSpace(searchKeyword) ? null : searchKeyword,
                sortColumn, sortDescending);
            if (result.Success && result.Data != null)
                await JS.InvokeVoidAsync("openPdf", result.Data);
            else
                Snackbar.Add(result.Message ?? "打印失败", Severity.Error);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"打印失败: {ex.Message}", Severity.Error);
        }
    }
}