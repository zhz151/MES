@page "/offline"
@using MudBlazor
@inject NavigationManager Navigation

<MudContainer Style="height:100vh; display:flex; flex-direction:column; align-items:center; justify-content:center; text-align:center; padding:24px;">
    <MudIcon Icon="@Icons.Material.Filled.WifiOff" Size="Size.Large" Color="Color.Warning" Style="font-size:80px; margin-bottom:16px;" />
    <MudText Typo="Typo.h4" Class="mb-2">网络连接已断开</MudText>
    <MudText Typo="Typo.body1" Color="Color.Secondary" Class="mb-6">
        请检查网络连接后重试
    </MudText>
    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Reload">
        重新连接
    </MudButton>
</MudContainer>

@code {
    private void Reload()
    {
        Navigation.NavigateTo("/", forceLoad: true);
    }
}
