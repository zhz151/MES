@page "/workorders/{Id:int}"
@using MES.Blazor.Services
@using MES.Core.DTOs
@using Microsoft.AspNetCore.Authorization
@inject WorkOrderService WorkOrderService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject IJSRuntime JS
@attribute [Authorize(Roles = "WorkOrderStaff,WorkOrderDirector,Admin")]

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-4">
    @if (isLoading)
    {
        <MudProgressCircular Indeterminate Size="Size.Large" Class="d-flex justify-center ma-8" />
    }
    else if (workOrder == null)
    {
        <MudAlert Severity="Severity.Error">工单不存在</MudAlert>
    }
    else
    {
        <MudCard>
            <MudCardHeader>
                <CardHeaderContent>
                    <div class="d-flex align-center">
                        <MudIcon Icon="@Icons.Material.Filled.Assignment" Class="mr-2" Color="Color.Primary" Size="Size.Medium" />
                        <MudText Typo="Typo.h5" Class="font-weight-bold">工单详情</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="ml-4">工单号：@workOrder.WorkOrderNo</MudText>
                        <MudChip Size="Size.Small" Color="@GetStatusColor(workOrder.Status)" Class="ml-2">
                            @workOrder.StatusText
                        </MudChip>
                    </div>
                    <div class="d-flex align-center mt-1">
                        <MudText Typo="Typo.body2" Color="Color.Secondary">
                            订单号：@workOrder.SalesOrderNo
                            @if (siblingWorkOrders.Count > 0)
                            {
                                <span> | 共 @siblingWorkOrders.Count 个工单，当前第 @(currentIndex + 1) 个</span>
                            }
                        </MudText>
                    </div>
                </CardHeaderContent>
                <CardHeaderActions>
                    <div class="d-flex align-center">
                        <MudIconButton Icon="@Icons.Material.Filled.ChevronLeft"
                                       Color="Color.Primary"
                                       Disabled="@(!hasPrevious)"
                                       OnClick="GoToPrevious"
                                       Title="上一个工单" />
                        <MudText Typo="Typo.body2" Class="mx-2">
                            @if (siblingWorkOrders.Count > 0)
                            {
                                <text>@(currentIndex + 1) / @siblingWorkOrders.Count</text>
                            }
                            else
                            {
                                <text>- / -</text>
                            }
                        </MudText>
                        <MudIconButton Icon="@Icons.Material.Filled.ChevronRight"
                                       Color="Color.Primary"
                                       Disabled="@(!hasNext)"
                                       OnClick="GoToNext"
                                       Title="下一个工单" />
                    </div>
                    <MudButton Variant="Variant.Outlined" Color="Color.Info" StartIcon="@Icons.Material.Filled.ListAlt" OnClick="NavigateToItems">
                        查看项次明细
                    </MudButton>
                    <MudButton Variant="Variant.Text" OnClick="GoBack">返回</MudButton>
                </CardHeaderActions>
            </MudCardHeader>

            <MudCardContent>
                <MudGrid>
                    <!-- 基本信息 -->
                    <MudItem xs="12">
                        <MudText Typo="Typo.subtitle1" Class="mb-2">基本信息</MudText>
                    </MudItem>
                    <MudItem xs="12" md="4">
                        <MudText Typo="Typo.body2"><strong>工单号：</strong>@workOrder.WorkOrderNo</MudText>
                    </MudItem>
                    <MudItem xs="12" md="4">
                        <MudText Typo="Typo.body2"><strong>源订单号：</strong>@workOrder.SalesOrderNo</MudText>
                    </MudItem>
                    <MudItem xs="12" md="4">
                        <MudText Typo="Typo.body2"><strong>主号：</strong>@workOrder.ProductionMainNo</MudText>
                    </MudItem>
                    <MudItem xs="12" md="4">
                        <MudText Typo="Typo.body2"><strong>次号：</strong>@(workOrder.ProductionSubNo ?? "-")</MudText>
                    </MudItem>
                    <MudItem xs="12" md="4">
                        <MudText Typo="Typo.body2"><strong>状态：</strong>@workOrder.StatusText</MudText>
                    </MudItem>

                    <!-- 订单信息 -->
                    <MudItem xs="12">
                        <MudDivider Class="my-3" />
                        <MudText Typo="Typo.subtitle1" Class="mb-2">订单信息</MudText>
                    </MudItem>
                    <MudItem xs="12" md="4">
                        <MudText Typo="Typo.body2"><strong>签订日期：</strong>@workOrder.SignDate.ToString("yyyy-MM-dd")</MudText>
                    </MudItem>
                    <MudItem xs="12" md="4">
                        <MudText Typo="Typo.body2"><strong>业务员：</strong>@workOrder.Salesman</MudText>
                    </MudItem>
                    <MudItem xs="12" md="4">
                        <MudText Typo="Typo.body2"><strong>最终用户：</strong>@(workOrder.EndCustomer ?? "-")</MudText>
                    </MudItem>

                    <!-- 规格信息 -->
                    <MudItem xs="12">
                        <MudDivider Class="my-3" />
                        <MudText Typo="Typo.subtitle1" Class="mb-2">规格信息</MudText>
                    </MudItem>
                    <MudItem xs="12" md="3">
                        <MudText Typo="Typo.body2"><strong>交货日期：</strong>@workOrder.DeliveryDate.ToString("yyyy-MM-dd")</MudText>
                    </MudItem>
                    <MudItem xs="12" md="3">
                        <MudText Typo="Typo.body2"><strong>延期违约金：</strong>@(workOrder.DelayPenalty ? "是" : "否")</MudText>
                    </MudItem>
                    <MudItem xs="12" md="3">
                        <MudText Typo="Typo.body2"><strong>物料名称：</strong>@GetMaterialNameText(workOrder.MaterialName)</MudText>
                    </MudItem>
                    <MudItem xs="12" md="3">
                        <MudText Typo="Typo.body2"><strong>结算方式：</strong>@GetSettlementMethodText(workOrder.SettlementMethod)</MudText>
                    </MudItem>
                    <MudItem xs="12" md="3">
                        <MudText Typo="Typo.body2"><strong>产品标准：</strong>@workOrder.StandardCode</MudText>
                    </MudItem>
                    <MudItem xs="12" md="3">
                        <MudText Typo="Typo.body2"><strong>交货状态：</strong>@GetDeliveryStateText(workOrder.DeliveryState)</MudText>
                    </MudItem>
                    <MudItem xs="12" md="3">
                        <MudText Typo="Typo.body2"><strong>工厂牌号：</strong>@workOrder.PlantGrade</MudText>
                    </MudItem>
                    <MudItem xs="12" md="3">
                        <MudText Typo="Typo.body2"><strong>规格：</strong>@FormatSpecification(workOrder.Specification)</MudText>
                    </MudItem>
                    <MudItem xs="12" md="3">
                        <MudText Typo="Typo.body2"><strong>外径公差：</strong>@FormatDecimal(workOrder.OuterDiameterMinus) / @FormatDecimal(workOrder.OuterDiameterPlus)</MudText>
                    </MudItem>
                    <MudItem xs="12" md="3">
                        <MudText Typo="Typo.body2"><strong>壁厚公差：</strong>@FormatDecimal(workOrder.WallThicknessMinus) / @FormatDecimal(workOrder.WallThicknessPlus)</MudText>
                    </MudItem>
                    <MudItem xs="12" md="3">
                        <MudText Typo="Typo.body2"><strong>长度状态：</strong>@GetLengthStatusText(workOrder.LengthStatus)</MudText>
                    </MudItem>
                    <MudItem xs="12" md="3">
                        <MudText Typo="Typo.body2"><strong>长度范围：</strong>@FormatNullableDecimal(workOrder.MinLength) / @FormatNullableDecimal(workOrder.MaxLength)</MudText>
                    </MudItem>

                    <!-- 汇总信息 -->
                    <MudItem xs="12">
                        <MudDivider Class="my-3" />
                        <MudText Typo="Typo.subtitle1" Class="mb-2">汇总信息</MudText>
                    </MudItem>
                    <MudItem xs="12" md="3">
                        <MudText Typo="Typo.body2"><strong>总支数：</strong>@workOrder.TotalQuantity</MudText>
                    </MudItem>
                    <MudItem xs="12" md="3">
                        <MudText Typo="Typo.body2"><strong>总米数：</strong>@FormatDecimal(workOrder.TotalMeters)</MudText>
                    </MudItem>
                    <MudItem xs="12" md="3">
                        <MudText Typo="Typo.body2"><strong>总重量：</strong>@FormatDecimal(workOrder.TotalWeight)</MudText>
                    </MudItem>
                    <MudItem xs="12" md="3">
                        <MudText Typo="Typo.body2"><strong>总项次数：</strong>@workOrder.TotalItemCount</MudText>
                    </MudItem>

                    <!-- 明细信息 -->
                    @if (!string.IsNullOrEmpty(workOrder.ItemDetails))
                    {
                        <MudItem xs="12">
                            <MudDivider Class="my-3" />
                            <MudText Typo="Typo.subtitle1" Class="mb-2">明细</MudText>
                            <MudText Typo="Typo.body2">@workOrder.ItemDetails</MudText>
                        </MudItem>
                    }

                    <!-- 技术要求 -->
                    <MudItem xs="12">
                        <MudDivider Class="my-3" />
                        <MudText Typo="Typo.subtitle1" Class="mb-2">技术要求</MudText>
                        <MudChip Size="Size.Small" Color="@(workOrder.TechnicalRequirements == "Special" ? Color.Warning : Color.Default)">
                            @(workOrder.TechnicalRequirements == "Special" ? "特殊" : "常规")
                        </MudChip>
                    </MudItem>

                    <!-- 审计信息 -->
                    <MudItem xs="12">
                        <MudDivider Class="my-3" />
                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                            创建时间：@workOrder.CreatedTime.ToString("yyyy-MM-dd HH:mm") | 创建人：@workOrder.CreatedBy
                        </MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                            更新时间：@workOrder.UpdatedTime.ToString("yyyy-MM-dd HH:mm") | 更新人：@workOrder.UpdatedBy
                        </MudText>
                    </MudItem>
                </MudGrid>
            </MudCardContent>
        </MudCard>
    }
</MudContainer>

@code {
    [Parameter] public int Id { get; set; }
    private WorkOrderDetailDto? workOrder;
    private bool isLoading = true;
    private List<WorkOrderListDto> siblingWorkOrders = new();
    private int currentIndex = -1;

    private bool hasPrevious => currentIndex > 0;
    private bool hasNext => currentIndex >= 0 && currentIndex < siblingWorkOrders.Count - 1;

    private string FormatDecimal(decimal value) => value.ToString("G29");
    private string FormatNullableDecimal(decimal? value) => value?.ToString("G29") ?? "";

    private string FormatSpecification(string specification)
    {
        if (string.IsNullOrEmpty(specification)) return "";
        var parts = specification.Split('*');
        if (parts.Length != 2) return specification;
        var od = decimal.TryParse(parts[0], out var odValue) ? odValue.ToString("G29") : parts[0];
        var wt = decimal.TryParse(parts[1], out var wtValue) ? wtValue.ToString("G29") : parts[1];
        return $"{od}*{wt}";
    }

    protected override async Task OnParametersSetAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        if (Id <= 0)
        {
            Snackbar.Add("无效的工单ID", Severity.Error);
            isLoading = false;
            return;
        }

        isLoading = true;
        StateHasChanged();

        try
        {
            var result = await WorkOrderService.GetByIdAsync(Id);
            if (result.Success && result.Data != null)
            {
                workOrder = result.Data;
                await LoadSiblingWorkOrders(workOrder.SalesOrderNo);
            }
            else
            {
                Snackbar.Add(result.Message ?? "加载工单详情失败", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"加载失败: {ex.Message}", Severity.Error);
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task LoadSiblingWorkOrders(string salesOrderNo)
    {
        try
        {
            var result = await WorkOrderService.GetBySalesOrderNoAsync(salesOrderNo);
            if (result != null && result.Success && result.Data != null && result.Data.Any())
            {
                siblingWorkOrders = result.Data.OrderBy(wo => wo.Id).ToList();
                currentIndex = siblingWorkOrders.FindIndex(wo => wo.Id == Id);
                if (currentIndex == -1)
                {
                    var currentWorkOrder = new WorkOrderListDto
                    {
                        Id = Id,
                        WorkOrderNo = workOrder?.WorkOrderNo ?? string.Empty,
                        SalesOrderNo = salesOrderNo
                    };
                    siblingWorkOrders.Insert(0, currentWorkOrder);
                    currentIndex = 0;
                }
            }
            else
            {
                siblingWorkOrders = new List<WorkOrderListDto>();
                currentIndex = -1;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"加载工单列表异常: {ex.Message}");
            siblingWorkOrders = new List<WorkOrderListDto>();
            currentIndex = -1;
        }
    }

    private void GoToPrevious()
    {
        if (hasPrevious)
        {
            var previousWorkOrder = siblingWorkOrders[currentIndex - 1];
            Navigation.NavigateTo($"/workorders/{previousWorkOrder.Id}");
        }
    }

    private void GoToNext()
    {
        if (hasNext)
        {
            var nextWorkOrder = siblingWorkOrders[currentIndex + 1];
            Navigation.NavigateTo($"/workorders/{nextWorkOrder.Id}");
        }
    }

    private void NavigateToItems()
    {
        Navigation.NavigateTo($"/workorders/{Id}/items");
    }

    private void GoBack() => Navigation.NavigateTo("/workorders");

    private Color GetStatusColor(int status)
    {
        return status switch
        {
            0 => Color.Default,
            1 => Color.Success,
            2 => Color.Warning,
            3 => Color.Error,
            _ => Color.Default
        };
    }

    private string GetMaterialNameText(string materialName)
    {
        return materialName switch
        {
            "SeamlessPipe" => "无缝管",
            "WeldedPipe" => "焊管",
            _ => materialName
        };
    }

    private string GetSettlementMethodText(string method)
    {
        return method switch
        {
            "Theoretical" => "理算",
            "Weighing" => "过磅",
            "WeighingNegative" => "过磅-负",
            _ => method
        };
    }

    private string GetDeliveryStateText(string state)
    {
        return state switch
        {
            "SolutionAnnealedAndPickled" => "固溶酸洗",
            "SolutionAnnealedAndPickledUTube" => "固溶酸洗-U型管",
            "SolutionAnnealedAndPickledExternalPolished" => "固溶酸洗-外抛光",
            "SolutionAnnealedAndPickledInternalPolished" => "固溶酸洗-内抛光",
            "SolutionAnnealedAndPickledBothPolished" => "固溶酸洗-内外抛光",
            "SolutionAnnealedAndPickledCoiled" => "固溶酸洗-盘管",
            "Bright" => "光亮",
            "BrightUTube" => "光亮-U型管",
            "BrightCoiled" => "光亮-盘管",
            "Hard" => "硬态",
            _ => state
        };
    }

    private string GetLengthStatusText(string status)
    {
        return status switch
        {
            "Fixed" => "定尺",
            "Range" => "范围尺",
            "NonFixed" => "非定尺",
            _ => status
        };
    }
}