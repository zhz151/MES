@page "/workorders/{Id:int}"
@using MES.Blazor.Helpers
@using MES.Blazor.Services
@using MES.Core.DTOs
@using Microsoft.AspNetCore.Authorization
@inject WorkOrderService WorkOrderService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject IJSRuntime JS
@attribute [Authorize(Roles = "WorkOrderStaff,WorkOrderDirector,Admin")]

<MudContainer Class="mt-2 px-3" Style="max-width:100%;">
    @if (isLoading)
    {
        <MudProgressCircular Indeterminate Size="Size.Large" Class="d-flex justify-center ma-8" />
    }
    else if (workOrder == null)
    {
        <MudAlert Severity="Severity.Error">工单不存在</MudAlert>
    }
    else
    {
        <!-- ===== 压缩页眉：标题+导航+用料计划+返回 ===== -->
        <MudPaper Class="pa-3 mb-2" Elevation="0" Style="border:1px solid var(--mud-palette-lines-default); border-radius:8px;">
            <div class="d-flex align-center justify-space-between flex-wrap" Style="gap:4px;">
                <div class="d-flex align-center flex-wrap" Style="gap:4px;">
                    <MudIcon Icon="@Icons.Material.Filled.Assignment" Color="Color.Primary" Size="Size.Small" />
                    <MudText Typo="Typo.subtitle1" Class="font-weight-bold mr-1">工单详情</MudText>
                    <MudChip Size="Size.Small" Color="@GetStatusColor(workOrder.Status)">@workOrder.StatusText</MudChip>
                    <MudText Typo="Typo.body2" Color="Color.Primary" Class="font-weight-bold ml-2">@workOrder.WorkOrderNo</MudText>
                </div>
                <div class="d-flex align-center flex-wrap" Style="gap:4px;">
                    <MudIconButton Icon="@Icons.Material.Filled.ChevronLeft" Size="Size.Small"
                                   Color="Color.Primary" Disabled="@(!hasPrevious)"
                                   OnClick="GoToPrevious" Title="上一个工单" />
                    <MudText Typo="Typo.caption" Class="mx-1">
                        @(siblingWorkOrders.Count > 0 ? $"{currentIndex + 1}/{siblingWorkOrders.Count}" : "- / -")
                    </MudText>
                    <MudIconButton Icon="@Icons.Material.Filled.ChevronRight" Size="Size.Small"
                                   Color="Color.Primary" Disabled="@(!hasNext)"
                                   OnClick="GoToNext" Title="下一个工单" />
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary"
                               Size="Size.Small" StartIcon="@Icons.Material.Filled.Print"
                               OnClick="PrintAsync" Class="ml-1">打印</MudButton>
                    <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="GoBack" Class="ml-1">工单首页</MudButton>
                </div>
            </div>
        </MudPaper>

        <!-- ===== 工单信息统一卡片（三组上下结构） ===== -->
        <MudPaper Class="pa-4 mb-3" Elevation="0" Style="border:1px solid var(--mud-palette-lines-default); border-radius:8px; background:#fafafa;">
            <!-- 第1组：基本信息 -->
            <div class="d-flex flex-wrap" style="gap: 0.6rem 2rem;">
                <div><MudText Typo="Typo.body2" Class="font-weight-bold mb-0" Style="color:#37474F;">工单号</MudText><MudText Typo="Typo.body2" Class="mb-0">@workOrder.WorkOrderNo</MudText></div>
                <div><MudText Typo="Typo.body2" Class="font-weight-bold mb-0" Style="color:#37474F;">源订单号</MudText><MudText Typo="Typo.body2" Class="mb-0">@workOrder.SalesOrderNo</MudText></div>
                <div><MudText Typo="Typo.body2" Class="font-weight-bold mb-0" Style="color:#37474F;">主号</MudText><MudText Typo="Typo.body2" Class="mb-0">@workOrder.ProductionMainNo</MudText></div>
                <div><MudText Typo="Typo.body2" Class="font-weight-bold mb-0" Style="color:#37474F;">次号</MudText><MudText Typo="Typo.body2" Class="mb-0">@(workOrder.ProductionSubNo ?? "-")</MudText></div>
                <div><MudText Typo="Typo.body2" Class="font-weight-bold mb-0" Style="color:#37474F;">签订日期</MudText><MudText Typo="Typo.body2" Class="mb-0">@workOrder.SignDate.ToString("yyyy-MM-dd")</MudText></div>
                <div><MudText Typo="Typo.body2" Class="font-weight-bold mb-0" Style="color:#37474F;">业务员</MudText><MudText Typo="Typo.body2" Class="mb-0">@workOrder.Salesman</MudText></div>
                <div><MudText Typo="Typo.body2" Class="font-weight-bold mb-0" Style="color:#37474F;">最终用户</MudText><MudText Typo="Typo.body2" Class="mb-0">@(workOrder.EndCustomer ?? "-")</MudText></div>
                <div><MudText Typo="Typo.body2" Class="font-weight-bold mb-0" Style="color:#37474F;">交货日期</MudText><MudText Typo="Typo.body2" Class="mb-0">@workOrder.DeliveryDate.ToString("yyyy-MM-dd")</MudText></div>
                <div><MudText Typo="Typo.body2" Class="font-weight-bold mb-0" Style="color:#37474F;">延期罚款</MudText><MudText Typo="Typo.body2" Class="mb-0">@(workOrder.DelayPenalty ? "是" : "否")</MudText></div>
                <div><MudText Typo="Typo.body2" Class="font-weight-bold mb-0" Style="color:#37474F;">物料名称</MudText><MudText Typo="Typo.body2" Class="mb-0">@DisplayHelper.GetMaterialNameText(workOrder.MaterialName)</MudText></div>
                <div><MudText Typo="Typo.body2" Class="font-weight-bold mb-0" Style="color:#37474F;">结算方式</MudText><MudText Typo="Typo.body2" Class="mb-0">@DisplayHelper.GetSettlementMethodText(workOrder.SettlementMethod)</MudText></div>
                <div><MudText Typo="Typo.body2" Class="font-weight-bold mb-0" Style="color:#37474F;">标准编码</MudText><MudText Typo="Typo.body2" Class="mb-0">@workOrder.StandardCode</MudText></div>
            </div>

            <MudDivider Class="my-3" />

            <!-- 第2组：工艺参数+汇总 -->
            <div class="d-flex flex-wrap" style="gap: 0.6rem 2rem;">
                <div><MudText Typo="Typo.body2" Class="font-weight-bold mb-0" Style="color:#37474F;">交货状态</MudText><MudText Typo="Typo.body2" Class="mb-0">@DisplayHelper.GetDeliveryStateText(workOrder.DeliveryState)</MudText></div>
                <div><MudText Typo="Typo.body2" Class="font-weight-bold mb-0" Style="color:#37474F;">工厂牌号</MudText><MudText Typo="Typo.body2" Class="mb-0">@workOrder.PlantGrade</MudText></div>
                <div><MudText Typo="Typo.body2" Class="font-weight-bold mb-0" Style="color:#37474F;">规格</MudText><MudText Typo="Typo.body2" Class="mb-0">@DisplayHelper.FormatSpecification(workOrder.Specification)</MudText></div>
                <div><MudText Typo="Typo.body2" Class="font-weight-bold mb-0" Style="color:#37474F;">外径公差</MudText><MudText Typo="Typo.body2" Class="mb-0">@DisplayHelper.FormatTolerance(workOrder.OuterDiameterNegative, workOrder.OuterDiameterPositive)</MudText></div>
                <div><MudText Typo="Typo.body2" Class="font-weight-bold mb-0" Style="color:#37474F;">壁厚公差</MudText><MudText Typo="Typo.body2" Class="mb-0">@DisplayHelper.FormatTolerance(workOrder.WallThicknessNegative, workOrder.WallThicknessPositive)</MudText></div>
                <div><MudText Typo="Typo.body2" Class="font-weight-bold mb-0" Style="color:#37474F;">长度状态</MudText><MudText Typo="Typo.body2" Class="mb-0">@DisplayHelper.GetLengthStatusText(workOrder.LengthStatus)</MudText></div>
                <div><MudText Typo="Typo.body2" Class="font-weight-bold mb-0" Style="color:#37474F;">最小长度</MudText><MudText Typo="Typo.body2" Class="mb-0">@DisplayHelper.FormatNullableDecimal(workOrder.MinLength) mm</MudText></div>
                <div><MudText Typo="Typo.body2" Class="font-weight-bold mb-0" Style="color:#37474F;">最大长度</MudText><MudText Typo="Typo.body2" Class="mb-0">@DisplayHelper.FormatNullableDecimal(workOrder.MaxLength) mm</MudText></div>
                <div><MudText Typo="Typo.body2" Class="font-weight-bold mb-0" Style="color:#37474F;">总支数</MudText><MudText Typo="Typo.body2" Class="mb-0">@workOrder.TotalQuantity 支</MudText></div>
                <div><MudText Typo="Typo.body2" Class="font-weight-bold mb-0" Style="color:#37474F;">总米数</MudText><MudText Typo="Typo.body2" Class="mb-0">@DisplayHelper.FormatDecimal(workOrder.TotalMeters) m</MudText></div>
                <div><MudText Typo="Typo.body2" Class="font-weight-bold mb-0" Style="color:#37474F;">总重量</MudText><MudText Typo="Typo.body2" Class="mb-0">@DisplayHelper.FormatDecimal(workOrder.TotalWeight) kg</MudText></div>
                <div><MudText Typo="Typo.body2" Class="font-weight-bold mb-0" Style="color:#37474F;">理论单支重</MudText><MudText Typo="Typo.body2" Class="mb-0">@(workOrder.UnitWeight?.ToString("G29") ?? "-") kg</MudText></div>
                <div><MudText Typo="Typo.body2" Class="font-weight-bold mb-0" Style="color:#37474F;">技术要求</MudText><MudText Typo="Typo.body2" Class="mb-0">@(workOrder.TechnicalRequirements == "Special" ? "特殊" : "常规")</MudText></div>
            </div>

            <MudDivider Class="my-3" />

            <!-- 第3组：项次+明细 -->
            <div class="d-flex flex-wrap" style="gap: 0.6rem 2rem;">
                <div><MudText Typo="Typo.body2" Class="font-weight-bold mb-0" Style="color:#37474F;">总项次数</MudText><MudText Typo="Typo.body2" Class="mb-0">@workOrder.TotalItemCount</MudText></div>
                <div style="flex: 1; min-width: 200px;">
                    <MudText Typo="Typo.body2" Class="font-weight-bold mb-0" Style="color:#37474F;">明细</MudText>
                    <MudText Typo="Typo.body2" Class="mb-0" style="overflow: hidden; text-overflow: ellipsis; white-space: nowrap; max-width: 100%; display: block;"
                             title="@workOrder.ItemDetails">
                        @(workOrder.ItemDetails ?? "-")
                    </MudText>
                </div>
            </div>
        </MudPaper>
    }
</MudContainer>

@code {
    [Parameter] public int Id { get; set; }
    private WorkOrderDetailDto? workOrder;
    private bool isLoading = true;
    private List<WorkOrderListDto> siblingWorkOrders = new();
    private int currentIndex = -1;

    private bool hasPrevious => currentIndex > 0;
    private bool hasNext => currentIndex >= 0 && currentIndex < siblingWorkOrders.Count - 1;

    protected override async Task OnParametersSetAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        if (Id <= 0)
        {
            Snackbar.Add("无效的工单ID", Severity.Error);
            isLoading = false;
            return;
        }

        isLoading = true;
        StateHasChanged();

        try
        {
            var result = await WorkOrderService.GetByIdAsync(Id);
            if (result.Success && result.Data != null)
            {
                workOrder = result.Data;
                await LoadSiblingWorkOrders(workOrder.SalesOrderNo);
            }
            else
            {
                Snackbar.Add(result.Message ?? "加载工单详情失败", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"加载失败: {ex.Message}", Severity.Error);
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task LoadSiblingWorkOrders(string salesOrderNo)
    {
        try
        {
            var result = await WorkOrderService.GetBySalesOrderNoAsync(salesOrderNo);
            if (result != null && result.Success && result.Data != null && result.Data.Any())
            {
                siblingWorkOrders = result.Data.OrderBy(wo => wo.Id).ToList();
                currentIndex = siblingWorkOrders.FindIndex(wo => wo.Id == Id);
                if (currentIndex == -1)
                {
                    var currentWorkOrder = new WorkOrderListDto
                    {
                        Id = Id,
                        WorkOrderNo = workOrder?.WorkOrderNo ?? string.Empty,
                        SalesOrderNo = salesOrderNo
                    };
                    siblingWorkOrders.Insert(0, currentWorkOrder);
                    currentIndex = 0;
                }
            }
            else
            {
                siblingWorkOrders = new List<WorkOrderListDto>();
                currentIndex = -1;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"加载工单列表异常: {ex.Message}");
            siblingWorkOrders = new List<WorkOrderListDto>();
            currentIndex = -1;
        }
    }

    private void GoToPrevious()
    {
        if (hasPrevious)
        {
            var previousWorkOrder = siblingWorkOrders[currentIndex - 1];
            Navigation.NavigateTo($"/workorders/{previousWorkOrder.Id}");
        }
    }

    private void GoToNext()
    {
        if (hasNext)
        {
            var nextWorkOrder = siblingWorkOrders[currentIndex + 1];
            Navigation.NavigateTo($"/workorders/{nextWorkOrder.Id}");
        }
    }

    private void GoBack() => Navigation.NavigateTo("/workorders");
    private Color GetStatusColor(int status)
    {
        return DisplayHelper.GetWorkOrderStatusColor(status);
    }

    private async Task PrintAsync()
    {
        try
        {
            var result = await WorkOrderService.PrintAsync(Id);
            if (result.Success && !string.IsNullOrEmpty(result.Data))
            {
                await JS.InvokeVoidAsync("openPdf", result.Data);
            }
            else
            {
                Snackbar.Add(result.Message ?? "打印失败", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"打印失败: {ex.Message}", Severity.Error);
        }
    }
}