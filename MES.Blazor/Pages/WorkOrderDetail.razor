@page "/workorders/{Id:int}"
@using MES.Blazor.Helpers
@using MES.Blazor.Services
@using MES.Core.DTOs
@using Microsoft.AspNetCore.Authorization
@inject WorkOrderService WorkOrderService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject IJSRuntime JS
@attribute [Authorize(Roles = "WorkOrderStaff,WorkOrderDirector,Admin")]

<MudContainer Class="mt-2 px-3" Style="max-width:100%;">
    @if (isLoading)
    {
        <MudProgressCircular Indeterminate Size="Size.Large" Class="d-flex justify-center ma-8" />
    }
    else if (workOrder == null)
    {
        <MudAlert Severity="Severity.Error">工单不存在</MudAlert>
    }
    else
    {
        <!-- ===== 压缩页眉：标题+导航+用料计划+返回 ===== -->
        <MudPaper Class="pa-3 mb-2" Elevation="0" Style="border:1px solid var(--mud-palette-lines-default); border-radius:8px;">
            <div class="d-flex align-center justify-space-between flex-wrap" Style="gap:4px;">
                <div class="d-flex align-center flex-wrap" Style="gap:4px;">
                    <MudIcon Icon="@Icons.Material.Filled.Assignment" Color="Color.Primary" Size="Size.Small" />
                    <MudText Typo="Typo.subtitle1" Class="font-weight-bold mr-1">工单详情</MudText>
                    <MudChip Size="Size.Small" Color="@GetStatusColor(workOrder.Status)">@workOrder.StatusText</MudChip>
                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="ml-2">@workOrder.WorkOrderNo</MudText>
                </div>
                <div class="d-flex align-center flex-wrap" Style="gap:4px;">
                    <MudIconButton Icon="@Icons.Material.Filled.ChevronLeft" Size="Size.Small"
                                   Color="Color.Primary" Disabled="@(!hasPrevious)"
                                   OnClick="GoToPrevious" Title="上一个工单" />
                    <MudText Typo="Typo.caption" Class="mx-1">
                        @(siblingWorkOrders.Count > 0 ? $"{currentIndex + 1}/{siblingWorkOrders.Count}" : "- / -")
                    </MudText>
                    <MudIconButton Icon="@Icons.Material.Filled.ChevronRight" Size="Size.Small"
                                   Color="Color.Primary" Disabled="@(!hasNext)"
                                   OnClick="GoToNext" Title="下一个工单" />
                    <MudMenu>
                        <ActivatorContent>
                            <MudButton Variant="Variant.Outlined" Color="Color.Primary"
                                       Size="Size.Small" Class="ml-1"
                                       EndIcon="@Icons.Material.Filled.ArrowDropDown">
                                用料计划
                            </MudButton>
                        </ActivatorContent>
                        <ChildContent>
                            <MudMenuItem OnClick="NavigateToSemiPlan">
                                <MudIcon Icon="@Icons.Material.Filled.Inventory2" Size="Size.Small" Class="mr-1" />原料采购计划
                            </MudMenuItem>
                            <MudMenuItem OnClick="NavigateToFinishPlan">
                                <MudIcon Icon="@Icons.Material.Filled.Checklist" Size="Size.Small" Class="mr-1" />成品采购计划
                            </MudMenuItem>
                            <MudMenuItem OnClick="NavigateToInventoryPlan">
                                <MudIcon Icon="@Icons.Material.Filled.Warehouse" Size="Size.Small" Class="mr-1" />库存使用计划
                            </MudMenuItem>
                            <MudMenuItem OnClick="NavigateToReworkPlan">
                                <MudIcon Icon="@Icons.Material.Filled.Build" Size="Size.Small" Class="mr-1" />库料改制计划
                            </MudMenuItem>
                        </ChildContent>
                    </MudMenu>
                    <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="GoBack" Class="ml-1">工单首页</MudButton>
                    <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="GoToMaterialPlanOverview">用料计划总览</MudButton>
                </div>
            </div>
            <div class="d-flex align-center flex-wrap mt-1" Style="gap:6px;">
                <MudText Typo="Typo.caption" Color="Color.Secondary">
                    订单号：@workOrder.SalesOrderNo / @workOrder.ProductionMainNo@(!string.IsNullOrEmpty(workOrder.ProductionSubNo) ? $"/{workOrder.ProductionSubNo}" : "")
                    @if (siblingWorkOrders.Count > 0)
                    {
                        <span> | 共 @siblingWorkOrders.Count 个工单，当前第 @(currentIndex + 1) 个</span>
                    }
                </MudText>
                <MudChip Size="Size.Small" Color="@GetMaterialPlanColor(workOrder.MaterialPlanStatus)">
                    @GetMaterialPlanStatusText(workOrder.MaterialPlanStatus)
                </MudChip>
                <MudText Typo="Typo.caption" Color="Color.Secondary">满足率：@((int)Math.Round(workOrder.MaterialPlanRate))%</MudText>
            </div>
        </MudPaper>

        <!-- ===== 工单信息卡片（14字段紧凑布局） ===== -->
        <MudPaper Class="pa-3 mb-2" Elevation="0" Style="border:1px solid var(--mud-palette-lines-default); border-radius:8px; background-color:var(--mud-palette-info-hover);">
            <MudText Typo="Typo.subtitle2" Color="Color.Primary" Class="mb-1">
                <MudIcon Icon="@Icons.Material.Filled.Description" Size="Size.Small" Class="mr-1" />工单信息
            </MudText>
            <MudGrid>
                <MudItem xs="6" md="3">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">工单号</MudText>
                    <MudText Typo="Typo.body2" Class="font-weight-bold">@workOrder.WorkOrderNo</MudText>
                </MudItem>
                <MudItem xs="6" md="3">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">源订单号</MudText>
                    <MudText Typo="Typo.body2">@workOrder.SalesOrderNo</MudText>
                </MudItem>
                <MudItem xs="6" md="3">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">主号/次号</MudText>
                    <MudText Typo="Typo.body2">@workOrder.ProductionMainNo@(!string.IsNullOrEmpty(workOrder.ProductionSubNo) ? $"/{workOrder.ProductionSubNo}" : "")</MudText>
                </MudItem>
                <MudItem xs="6" md="3">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">物料名称</MudText>
                    <MudText Typo="Typo.body2">@GetMaterialNameText(workOrder.MaterialName)</MudText>
                </MudItem>
                <MudItem xs="6" md="3">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">结算方式</MudText>
                    <MudText Typo="Typo.body2">@GetSettlementMethodText(workOrder.SettlementMethod)</MudText>
                </MudItem>
                <MudItem xs="6" md="3">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">交货状态</MudText>
                    <MudText Typo="Typo.body2">@DisplayHelper.GetDeliveryStateText(workOrder.DeliveryState)</MudText>
                </MudItem>
                <MudItem xs="6" md="3">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">延期罚款</MudText>
                    <MudText Typo="Typo.body2">@(workOrder.DelayPenalty ? "是" : "否")</MudText>
                </MudItem>
                <MudItem xs="6" md="3">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">交货日期</MudText>
                    <MudText Typo="Typo.body2">@workOrder.DeliveryDate.ToString("yyyy-MM-dd")</MudText>
                </MudItem>
                <MudItem xs="6" md="3">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">工厂牌号</MudText>
                    <MudText Typo="Typo.body2">@workOrder.PlantGrade</MudText>
                </MudItem>
                <MudItem xs="6" md="3">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">规格</MudText>
                    <MudText Typo="Typo.body2">@DisplayHelper.FormatSpecification(workOrder.Specification)</MudText>
                </MudItem>
                <MudItem xs="6" md="3">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">外径公差(mm)</MudText>
                    <MudText Typo="Typo.body2">@DisplayHelper.FormatDecimal(workOrder.OuterDiameterNegative) / @DisplayHelper.FormatDecimal(workOrder.OuterDiameterPositive)</MudText>
                </MudItem>
                <MudItem xs="6" md="3">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">壁厚公差(mm)</MudText>
                    <MudText Typo="Typo.body2">@DisplayHelper.FormatDecimal(workOrder.WallThicknessNegative) / @DisplayHelper.FormatDecimal(workOrder.WallThicknessPositive)</MudText>
                </MudItem>
                <MudItem xs="6" md="3">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">长度状态</MudText>
                    <MudText Typo="Typo.body2">@DisplayHelper.GetLengthStatusText(workOrder.LengthStatus) @(workOrder.MaxLength.HasValue ? $"(最长{(int)workOrder.MaxLength.Value}mm)" : "")</MudText>
                </MudItem>
                <MudItem xs="6" md="3">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">数量/重量</MudText>
                    <MudText Typo="Typo.body2">@workOrder.TotalQuantity 支 / @workOrder.TotalWeight.ToString("G29") kg</MudText>
                </MudItem>
                <MudItem xs="6" md="3">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">总米数</MudText>
                    <MudText Typo="Typo.body2">@DisplayHelper.FormatDecimal(workOrder.TotalMeters) m</MudText>
                </MudItem>
                <MudItem xs="6" md="3">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">理论单支重</MudText>
                    <MudText Typo="Typo.body2">@(workOrder.UnitWeight?.ToString("G29") ?? "-") kg</MudText>
                </MudItem>
            </MudGrid>
        </MudPaper>

        <!-- ===== 明细（如有） ===== -->
        @if (!string.IsNullOrEmpty(workOrder.ItemDetails))
        {
            <MudPaper Class="pa-3 mb-2" Elevation="0" Style="border:1px solid var(--mud-palette-lines-default); border-radius:8px; max-height:80px; overflow-y:auto;">
                <MudText Typo="Typo.caption" Color="Color.Primary" Class="mb-1">
                    <MudIcon Icon="@Icons.Material.Filled.ListAlt" Size="Size.Small" Class="mr-1" />明细
                </MudText>
                <MudText Typo="Typo.caption">@workOrder.ItemDetails</MudText>
            </MudPaper>
        }

        <!-- ===== 底部：技术要求+审计 ===== -->
        <div class="d-flex flex-wrap align-center justify-space-between pa-2"
             Style="border:1px solid var(--mud-palette-lines-default); border-radius:8px;">
            <div class="d-flex align-center" Style="gap:4px;">
                <MudText Typo="Typo.caption" Color="Color.Secondary">技术要求：</MudText>
                <MudChip Size="Size.Small" Color="@(workOrder.TechnicalRequirements == "Special" ? Color.Warning : Color.Default)">
                    @(workOrder.TechnicalRequirements == "Special" ? "特殊" : "常规")
                </MudChip>
                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="ml-3">产品标准：@workOrder.StandardCode</MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="ml-3">总项次：@workOrder.TotalItemCount</MudText>
            </div>
            <MudText Typo="Typo.caption" Color="Color.Secondary">
                创建：@workOrder.CreatedBy @workOrder.CreatedTime.ToString("yyyy-MM-dd HH:mm") | 更新：@workOrder.UpdatedBy @workOrder.UpdatedTime.ToString("yyyy-MM-dd HH:mm")
            </MudText>
        </div>
    }
</MudContainer>

@code {
    [Parameter] public int Id { get; set; }
    private WorkOrderDetailDto? workOrder;
    private bool isLoading = true;
    private List<WorkOrderListDto> siblingWorkOrders = new();
    private int currentIndex = -1;

    private bool hasPrevious => currentIndex > 0;
    private bool hasNext => currentIndex >= 0 && currentIndex < siblingWorkOrders.Count - 1;

    protected override async Task OnParametersSetAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        if (Id <= 0)
        {
            Snackbar.Add("无效的工单ID", Severity.Error);
            isLoading = false;
            return;
        }

        isLoading = true;
        StateHasChanged();

        try
        {
            var result = await WorkOrderService.GetByIdAsync(Id);
            if (result.Success && result.Data != null)
            {
                workOrder = result.Data;
                await LoadSiblingWorkOrders(workOrder.SalesOrderNo);
            }
            else
            {
                Snackbar.Add(result.Message ?? "加载工单详情失败", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"加载失败: {ex.Message}", Severity.Error);
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task LoadSiblingWorkOrders(string salesOrderNo)
    {
        try
        {
            var result = await WorkOrderService.GetBySalesOrderNoAsync(salesOrderNo);
            if (result != null && result.Success && result.Data != null && result.Data.Any())
            {
                siblingWorkOrders = result.Data.OrderBy(wo => wo.Id).ToList();
                currentIndex = siblingWorkOrders.FindIndex(wo => wo.Id == Id);
                if (currentIndex == -1)
                {
                    var currentWorkOrder = new WorkOrderListDto
                    {
                        Id = Id,
                        WorkOrderNo = workOrder?.WorkOrderNo ?? string.Empty,
                        SalesOrderNo = salesOrderNo
                    };
                    siblingWorkOrders.Insert(0, currentWorkOrder);
                    currentIndex = 0;
                }
            }
            else
            {
                siblingWorkOrders = new List<WorkOrderListDto>();
                currentIndex = -1;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"加载工单列表异常: {ex.Message}");
            siblingWorkOrders = new List<WorkOrderListDto>();
            currentIndex = -1;
        }
    }

    private void GoToPrevious()
    {
        if (hasPrevious)
        {
            var previousWorkOrder = siblingWorkOrders[currentIndex - 1];
            Navigation.NavigateTo($"/workorders/{previousWorkOrder.Id}");
        }
    }

    private void GoToNext()
    {
        if (hasNext)
        {
            var nextWorkOrder = siblingWorkOrders[currentIndex + 1];
            Navigation.NavigateTo($"/workorders/{nextWorkOrder.Id}");
        }
    }

    private void GoBack() => Navigation.NavigateTo("/workorders");
    private void GoToMaterialPlanOverview() => Navigation.NavigateTo("/material-plan-overview");

    private Color GetStatusColor(int status)
    {
        return status switch
        {
            0 => Color.Default,
            1 => Color.Success,
            2 => Color.Warning,
            3 => Color.Error,
            _ => Color.Default
        };
    }

    private string GetMaterialNameText(string materialName)
    {
        return materialName switch
        {
            "SeamlessPipe" => "无缝管",
            "WeldedPipe" => "焊管",
            _ => materialName
        };
    }

    private string GetSettlementMethodText(string method)
    {
        return method switch
        {
            "Theoretical" => "理算",
            "Weighing" => "过磅",
            "WeighingNegative" => "过磅-负",
            _ => method
        };
    }

    private void NavigateToSemiPlan()
    {
        Navigation.NavigateTo($"/workorders/{Id}/material-plan");
    }

    private void NavigateToFinishPlan()
    {
        Navigation.NavigateTo($"/workorders/{Id}/finish-plan");
    }

    private void NavigateToInventoryPlan()
    {
        Navigation.NavigateTo($"/workorders/{Id}/inventory-plan");
    }

    private void NavigateToReworkPlan()
    {
        Navigation.NavigateTo($"/workorders/{Id}/rework-plan");
    }

    private Color GetMaterialPlanColor(int status)
    {
        return status switch
        {
            0 => Color.Default,
            1 => Color.Warning,
            2 => Color.Info,
            3 => Color.Success,
            4 => Color.Error,
            _ => Color.Default
        };
    }

    private string GetMaterialPlanStatusText(int status)
    {
        return status switch
        {
            0 => "未计划",
            1 => "部分",
            2 => "理论满足",
            3 => "满足",
            4 => "超量",
            _ => "未知"
        };
    }
}