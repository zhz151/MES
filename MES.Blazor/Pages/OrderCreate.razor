@page "/orders/create"
@using MES.Blazor.Helpers
@using MES.Blazor.Services
@using MES.Core.DTOs
@using MES.Core.Models
@using MES.Core.Enums
@using Microsoft.AspNetCore.Authorization
@inject OrderService OrderService
@inject CustomerService CustomerService
@inject ProductionStandardService StandardService
@using MES.Blazor.Shared
@inject GradeMappingService GradeMappingService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject IJSRuntime JS
@attribute [Authorize(Roles = "OrderDirector,Admin")]

<MudContainer MaxWidth="MaxWidth.False" Class="mt-4">
    <MudCard>
        <MudCardHeader>
            <CardHeaderContent>
                <MudText Typo="Typo.h5" Class="font-weight-bold">
                    <MudIcon Icon="@Icons.Material.Filled.Add" Class="mr-2" Color="Color.Primary" />
                    新建订单
                </MudText>
            </CardHeaderContent>
            <CardHeaderActions>
                <MudButton Variant="Variant.Text" OnClick="GoBack">返回</MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SubmitOrder" Loading="@isSubmitting">
                    提交订单
                </MudButton>
            </CardHeaderActions>
        </MudCardHeader>

        <MudCardContent>
            <div id="order-create-table">
            @if (isLoading)
            {
                <MudProgressCircular Indeterminate Size="Size.Large" Class="d-flex justify-center ma-8" />
            }
            else
            {
                <!-- ========== 1. 基本信息区域 ========== -->
                <MudText Typo="Typo.subtitle1" Class="mb-3">基本信息</MudText>
                <div style="overflow-x: auto;" class="mb-6">
                    <MudTable Items="@_headerDummy" Dense="true" Hover="true" Elevation="0" Class="auto-table">
                        <HeaderContent>
                            <MudTh>订单号<span class="required-star">*</span></MudTh>
                            <MudTh>签订日期</MudTh>
                            <MudTh>业务员</MudTh>
                            <MudTh>客户单位</MudTh>
                            <MudTh>最终客户</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd>
                                <MudTextField T="string"
                                              @bind-Value="headerData.OrderNumber"
                                              Dense="true"
                                              Variant="Variant.Outlined"
                                              Size="Size.Small" />
                            </MudTd>
                            <MudTd>
                                <MudTextField T="string"
                                              @bind-Value="headerData.SignDateStr"
                                              Dense="true"
                                              Variant="Variant.Outlined"
                                              Size="Size.Small" />
                            </MudTd>
                            <MudTd>
                                <MudSelect T="string"
                                           Value="headerData.SelectedSalesman"
                                           ValueChanged="EventCallback.Factory.Create<string>(this, OnSalesmanValueChanged)"
                                           Dense="true"
                                           Variant="Variant.Outlined"
                                           Size="Size.Small">
                                    @foreach (var s in _salesmen)
                                    {
                                        <MudSelectItem Value="@s">@s</MudSelectItem>
                                    }
                                </MudSelect>
                            </MudTd>
                            <MudTd>
                                <MudSelect T="string"
                                           Value="headerData.SelectedCustomerUnit"
                                           ValueChanged="EventCallback.Factory.Create<string>(this, OnCustomerUnitValueChanged)"
                                           Dense="true"
                                           Variant="Variant.Outlined"
                                           Size="Size.Small">
                                    @foreach (var u in _customerUnits)
                                    {
                                        <MudSelectItem Value="@u">@u</MudSelectItem>
                                    }
                                </MudSelect>
                            </MudTd>
                            <MudTd>
                                <MudSelect T="string"
                                           Value="headerData.SelectedEndCustomer"
                                           ValueChanged="EventCallback.Factory.Create<string>(this, OnEndCustomerValueChanged)"
                                           Dense="true"
                                           Variant="Variant.Outlined"
                                           Size="Size.Small">
                                    @foreach (var e in _endCustomers)
                                    {
                                        <MudSelectItem Value="@e">@e</MudSelectItem>
                                    }
                                </MudSelect>
                            </MudTd>
                        </RowTemplate>
                    </MudTable>
                </div>

                <MudDivider Class="my-4" />

                <!-- ========== 2. 订单项次区域 ========== -->
                <div class="d-flex justify-space-between align-center mb-3">
                    <MudText Typo="Typo.subtitle1">订单项次</MudText>
                    <MudButton Variant="Variant.Outlined" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.Add" OnClick="AddSimilarItem" Class="mr-2">添加同类项次</MudButton>
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="AddNewItem">添加异类项次</MudButton>
                </div>

                <div>
                @if (editItemViewModels.Count == 0)
                {
                }
                else
                {
                    <div style="overflow-x: auto;">
                        <MudTable T="OrderItemViewModel" Items="@editItemViewModels" Dense="true" Hover="true" Elevation="0" RowsPerPage="10" RowsPerPageLabel="每页行数:" Class="auto-table">
                            <HeaderContent>
                                <MudTh>项次</MudTh>
                                <MudTh>交货日期<span class="required-star">*</span></MudTh>
                                <MudTh>延期罚款</MudTh>
                                <MudTh>结算方式</MudTh>
                                <MudTh>物料名称</MudTh>
                                <MudTh>产品标准</MudTh>
                                <MudTh>交货状态</MudTh>
                                <MudTh>标准牌号<span class="required-star">*</span></MudTh>
                                <MudTh>外径</MudTh>
                                <MudTh>壁厚</MudTh>
                                <MudTh>外径下差</MudTh>
                                <MudTh>外径上差</MudTh>
                                <MudTh>壁厚下差</MudTh>
                                <MudTh>壁厚上差</MudTh>
                                <MudTh>长度状态</MudTh>
                                <MudTh>最小长度</MudTh>
                                <MudTh>最大长度</MudTh>
                                <MudTh>支数</MudTh>
                                <MudTh>米数</MudTh>
                                <MudTh>合同重量</MudTh>
                                <MudTh>理算重量</MudTh>
                                <MudTh>操作</MudTh>
                            </HeaderContent>
                            <PagerContent>
                                <MudTablePager />
                            </PagerContent>
                            <RowTemplate Context="item">
                                <!-- 项次 - 只读显示 -->
                                <MudTd>
                                    <MudText Typo="Typo.body2">@item.Sequence</MudText>
                                </MudTd>

                                <!-- 交货日期 - 文本输入 -->
                                <MudTd>
                                    <MudTextField T="string"
                                                  @bind-Value="item.DeliveryDateStr"
                                                  Dense="true"
                                                  Variant="Variant.Outlined"
                                                  Size="Size.Small"
                                                  Style="width: 72px;"
                                                  />
                                </MudTd>

                                <!-- 延期罚款 - 复选框 -->
                                <MudTd>
                                    <MudCheckBox @bind-Value="item.DelayPenalty" />
                                </MudTd>

                                <!-- 结算方式 - 下拉选择 -->
                                <MudTd>
                                    <MudSelect T="SettlementMethod" @bind-Value="item.SettlementMethod" Dense="true" Variant="Variant.Outlined" Size="Size.Small">
                                        <MudSelectItem Value="SettlementMethod.Theoretical">@DisplayHelper.GetSettlementMethodText(SettlementMethod.Theoretical)</MudSelectItem>
                                        <MudSelectItem Value="SettlementMethod.Weighing">@DisplayHelper.GetSettlementMethodText(SettlementMethod.Weighing)</MudSelectItem>
                                        <MudSelectItem Value="SettlementMethod.WeighingNegative">@DisplayHelper.GetSettlementMethodText(SettlementMethod.WeighingNegative)</MudSelectItem>
                                    </MudSelect>
                                </MudTd>

                                <!-- 物料名称 - 下拉选择 -->
                                <MudTd>
                                    <MudSelect T="MaterialName" @bind-Value="item.MaterialName" Dense="true" Variant="Variant.Outlined" Size="Size.Small">
                                        <MudSelectItem Value="MaterialName.SeamlessPipe">@DisplayHelper.GetMaterialNameText(MaterialName.SeamlessPipe)</MudSelectItem>
                                        <MudSelectItem Value="MaterialName.WeldedPipe">@DisplayHelper.GetMaterialNameText(MaterialName.WeldedPipe)</MudSelectItem>
                                    </MudSelect>
                                </MudTd>

                                <!-- 产品标准 - 下拉选择 -->
                                <MudTd>
                                    <MudSelect T="int" @bind-Value="item.ProductionStandardId" Dense="true" Variant="Variant.Outlined" Size="Size.Small">
                                        @foreach (var std in productionStandards)
                                        {
                                            <MudSelectItem Value="@std.Id">@std.StandardCode</MudSelectItem>
                                        }
                                    </MudSelect>
                                </MudTd>

                                <!-- 交货状态 - 下拉选择 -->
                                <MudTd>
                                    <MudSelect T="DeliveryState" @bind-Value="item.DeliveryState" Dense="true" Variant="Variant.Outlined" Size="Size.Small">
                                        <MudSelectItem Value="DeliveryState.SolutionAnnealedAndPickled">@DisplayHelper.GetDeliveryStateText(DeliveryState.SolutionAnnealedAndPickled)</MudSelectItem>
                                        <MudSelectItem Value="DeliveryState.Bright">@DisplayHelper.GetDeliveryStateText(DeliveryState.Bright)</MudSelectItem>
                                        <MudSelectItem Value="DeliveryState.Hard">@DisplayHelper.GetDeliveryStateText(DeliveryState.Hard)</MudSelectItem>
                                    </MudSelect>
                                </MudTd>

                                <!-- 标准牌号 - 下拉选择 -->
                                <MudTd>
                                    <MudSelect T="string" @bind-Value="item.StandardGrade" Dense="true" Variant="Variant.Outlined" Size="Size.Small">
                                        @foreach (var grade in gradeMappings)
                                        {
                                            <MudSelectItem Value="@grade.StandardGrade">@grade.StandardGrade</MudSelectItem>
                                        }
                                    </MudSelect>
                                </MudTd>

                                <!-- 外径 - 文本输入 -->
                                <MudTd>
                                    <MudTextField T="string"
                                                  @bind-Value="item.OuterDiameterStr"
                                                  Dense="true"
                                                  Variant="Variant.Outlined"
                                                  Size="Size.Small"
                                                  Style="width: 45px;" />
                                </MudTd>

                                <!-- 壁厚 - 文本输入 -->
                                <MudTd>
                                    <MudTextField T="string"
                                                  @bind-Value="item.WallThicknessStr"
                                                  Dense="true"
                                                  Variant="Variant.Outlined"
                                                  Size="Size.Small"
                                                  Style="width: 45px;" />
                                </MudTd>

                                <!-- 外径下差 - 文本输入 -->
                                <MudTd>
                                    <MudTextField T="string"
                                                  @bind-Value="item.OuterDiameterNegativeStr"
                                                  Dense="true"
                                                  Variant="Variant.Outlined"
                                                  Size="Size.Small"
                                                  Style="width: 40px;" />
                                </MudTd>

                                <!-- 外径上差 - 文本输入 -->
                                <MudTd>
                                    <MudTextField T="string"
                                                  @bind-Value="item.OuterDiameterPositiveStr"
                                                  Dense="true"
                                                  Variant="Variant.Outlined"
                                                  Size="Size.Small"
                                                  Style="width: 40px;" />
                                </MudTd>

                                <!-- 壁厚下差 - 文本输入 -->
                                <MudTd>
                                    <MudTextField T="string"
                                                  @bind-Value="item.WallThicknessNegativeStr"
                                                  Dense="true"
                                                  Variant="Variant.Outlined"
                                                  Size="Size.Small"
                                                  Style="width: 40px;" />
                                </MudTd>

                                <!-- 壁厚上差 - 文本输入 -->
                                <MudTd>
                                    <MudTextField T="string"
                                                  @bind-Value="item.WallThicknessPositiveStr"
                                                  Dense="true"
                                                  Variant="Variant.Outlined"
                                                  Size="Size.Small"
                                                  Style="width: 40px;" />
                                </MudTd>

                                <!-- 长度状态 - 下拉选择 -->
                                <MudTd>
                                    <MudSelect T="LengthStatus" @bind-Value="item.LengthStatus" Dense="true" Variant="Variant.Outlined" Size="Size.Small">
                                        <MudSelectItem Value="LengthStatus.Fixed">@DisplayHelper.GetLengthStatusText(LengthStatus.Fixed)</MudSelectItem>
                                        <MudSelectItem Value="LengthStatus.Range">@DisplayHelper.GetLengthStatusText(LengthStatus.Range)</MudSelectItem>
                                        <MudSelectItem Value="LengthStatus.NonFixed">@DisplayHelper.GetLengthStatusText(LengthStatus.NonFixed)</MudSelectItem>
                                    </MudSelect>
                                </MudTd>

                                <!-- 最小长度 - 文本输入 -->
                                <MudTd>
                                    <MudTextField T="string"
                                                  @bind-Value="item.MinLengthStr"
                                                  Dense="true"
                                                  Variant="Variant.Outlined"
                                                  Size="Size.Small"
                                                  Style="width: 50px;" />
                                </MudTd>

                                <!-- 最大长度 - 文本输入 -->
                                <MudTd>
                                    <MudTextField T="string"
                                                  @bind-Value="item.MaxLengthStr"
                                                  Dense="true"
                                                  Variant="Variant.Outlined"
                                                  Size="Size.Small"
                                                  Style="width: 50px;" />
                                </MudTd>

                                <!-- 支数 - 文本输入 -->
                                <MudTd>
                                    <MudTextField T="string"
                                                  @bind-Value="item.QuantityStr"
                                                  Dense="true"
                                                  Variant="Variant.Outlined"
                                                  Size="Size.Small"
                                                  Style="width: 40px;" />
                                </MudTd>

                                <!-- 米数 - 文本输入 + 计算按钮 -->
                                <MudTd>
                                    <div style="display: flex; align-items: center; gap: 4px;">
                                        <MudTextField T="string"
                                                      @bind-Value="item.MetersStr"
                                                      Dense="true"
                                                      Variant="Variant.Outlined"
                                                      Size="Size.Small"
                                                      Style="width: 48px;" />
                                        <MudIconButton Icon="@Icons.Material.Filled.Calculate"
                                                       Color="Color.Primary"
                                                       Size="Size.Small"
                                                       OnClick="() => CalculateMetersForItem(item)" />
                                    </div>
                                </MudTd>

                                <!-- 合同重量 - 文本输入 -->
                                <MudTd>
                                    <MudTextField T="string"
                                                  @bind-Value="item.ContractWeightStr"
                                                  Dense="true"
                                                  Variant="Variant.Outlined"
                                                  Size="Size.Small"
                                                  Style="width: 50px;" />
                                </MudTd>

                                <!-- 理算重量 - 只读 + 计算按钮 -->
                                <MudTd>
                                    <div style="display: flex; align-items: center; gap: 4px;">
                                        <MudText Typo="Typo.body2">@DisplayHelper.FormatDecimal(item.TheoreticalWeight)</MudText>
                                        <MudIconButton Icon="@Icons.Material.Filled.Calculate"
                                                       Color="Color.Primary"
                                                       Size="Size.Small"
                                                       OnClick="() => CalculateTheoreticalWeightForItem(item)" />
                                    </div>
                                </MudTd>

                                <!-- 操作 - 删除按钮 -->
                                <MudTd>
                                    @if (editItemViewModels.Count > 1)
                                    {
                                        <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                                       Color="Color.Error"
                                                       Size="Size.Small"
                                                       OnClick="() => RemoveItem(item)" />
                                    }
                                    else
                                    {
                                        <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                                       Color="Color.Error"
                                                       Size="Size.Small"
                                                       Disabled="true"
                                                       Title="订单至少需要保留一个项次" />
                                    }
                                </MudTd>
                            </RowTemplate>
                        </MudTable>
                    </div>
                }
                </div>
            }
            </div>
        </MudCardContent>
    </MudCard>
</MudContainer>

@code {
    // ========== ViewModel 定义 ==========

    private class OrderHeaderViewModel
    {
        public string OrderNumber { get; set; } = string.Empty;
        public string SignDateStr { get; set; } = DateTime.Today.ToString("yyyy-MM-dd");
        public string SelectedSalesman { get; set; } = string.Empty;
        public string SelectedCustomerUnit { get; set; } = string.Empty;
        public string SelectedEndCustomer { get; set; } = string.Empty;
    }

    private class OrderItemViewModel
    {
        public int Sequence { get; set; }
        public string DeliveryDateStr { get; set; } = DateTime.Now.AddMonths(1).ToString("yyyy-MM-dd");
        public bool DelayPenalty { get; set; }
        public SettlementMethod SettlementMethod { get; set; } = SettlementMethod.Theoretical;
        public MaterialName MaterialName { get; set; } = MaterialName.SeamlessPipe;
        public int ProductionStandardId { get; set; }
        public DeliveryState DeliveryState { get; set; } = DeliveryState.SolutionAnnealedAndPickled;
        public string StandardGrade { get; set; } = string.Empty;
        public LengthStatus LengthStatus { get; set; } = LengthStatus.Fixed;

        // 字符串绑定字段（用于用户输入）
        public string OuterDiameterStr { get; set; } = string.Empty;
        public string WallThicknessStr { get; set; } = string.Empty;
        public string OuterDiameterNegativeStr { get; set; } = "0";
        public string OuterDiameterPositiveStr { get; set; } = "0";
        public string WallThicknessNegativeStr { get; set; } = "0";
        public string WallThicknessPositiveStr { get; set; } = "0";
        public string MinLengthStr { get; set; } = string.Empty;
        public string MaxLengthStr { get; set; } = string.Empty;
        public string QuantityStr { get; set; } = string.Empty;
        public string MetersStr { get; set; } = string.Empty;
        public string ContractWeightStr { get; set; } = string.Empty;

        // 计算属性：将字符串转换为数值
        public decimal OuterDiameter => ParseDecimal(OuterDiameterStr);
        public decimal WallThickness => ParseDecimal(WallThicknessStr);
        public decimal OuterDiameterNegative => ParseDecimal(OuterDiameterNegativeStr);
        public decimal OuterDiameterPositive => ParseDecimal(OuterDiameterPositiveStr);
        public decimal WallThicknessNegative => ParseDecimal(WallThicknessNegativeStr);
        public decimal WallThicknessPositive => ParseDecimal(WallThicknessPositiveStr);
        public decimal? MinLength => ParseNullableDecimal(MinLengthStr);
        public decimal? MaxLength => ParseNullableDecimal(MaxLengthStr);
        public int? Quantity => ParseNullableInt(QuantityStr);
        public decimal? Meters => ParseNullableDecimal(MetersStr);
        public decimal ContractWeight => ParseDecimal(ContractWeightStr);

        // 理算重量（系统计算，只读）
        public decimal TheoreticalWeight { get; set; }

        public string? Remark { get; set; }

        private static decimal ParseDecimal(string value) => decimal.TryParse(value, out var result) ? result : 0;
        private static decimal? ParseNullableDecimal(string value) => decimal.TryParse(value, out var result) ? result : null;
        private static int? ParseNullableInt(string value) => int.TryParse(value, out var result) ? result : null;
    }

    // ========== 私有字段 ==========

    private OrderHeaderViewModel headerData = new();
    private List<OrderItemViewModel> editItemViewModels = new();
    private List<ProductionStandardDto> productionStandards = new();
    private List<StandardGradeMappingDto> gradeMappings = new();
    private List<CustomerProfileDto> allCustomers = new();
    private int? _selectedCustomerId;
    private bool isSubmitting = false;
    private bool isLoading = true;
    private bool _isArrowNavSetup;
    private List<int> _headerDummy => new() { 1 };

    // ========== 级联选择计算属性 ==========

    private List<string> _salesmen => allCustomers
        .Where(c => !string.IsNullOrEmpty(c.Salesman))
        .Select(c => c.Salesman)
        .Distinct()
        .OrderBy(s => s)
        .ToList();

    private List<CustomerProfileDto> _filteredBySalesman => string.IsNullOrEmpty(headerData.SelectedSalesman)
        ? new List<CustomerProfileDto>()
        : allCustomers.Where(c => c.Salesman == headerData.SelectedSalesman).ToList();

    private List<string> _customerUnits => _filteredBySalesman
        .Where(c => !string.IsNullOrEmpty(c.CustomerUnit))
        .Select(c => c.CustomerUnit)
        .Distinct()
        .OrderBy(u => u)
        .ToList();

    private List<CustomerProfileDto> _matchedCustomers => string.IsNullOrEmpty(headerData.SelectedCustomerUnit)
        ? new List<CustomerProfileDto>()
        : _filteredBySalesman.Where(c => c.CustomerUnit == headerData.SelectedCustomerUnit).ToList();

    private List<string> _endCustomers => _matchedCustomers
        .Where(c => !string.IsNullOrEmpty(c.EndCustomer))
        .Select(c => c.EndCustomer!)
        .Distinct()
        .OrderBy(e => e)
        .ToList();

    private bool _isEndCustomerAuto
    {
        get
        {
            var uniqueEndCustomers = _matchedCustomers
                .Where(c => !string.IsNullOrEmpty(c.EndCustomer))
                .Select(c => c.EndCustomer)
                .Distinct()
                .ToList();
            return uniqueEndCustomers.Count == 1;
        }
    }

    // ========== 辅助方法 ==========

    private string FormatDecimal(decimal value) => value == 0 ? "" : value.ToString("G29");

    private string FormatNullableDecimal(decimal? value) => value.HasValue && value.Value != 0 ? value.Value.ToString("G29") : "";

    // ========== 级联选择事件处理 ==========

    private void OnSalesmanValueChanged(string value)
    {
        headerData.SelectedSalesman = value;
        AfterSalesmanChanged();
    }

    private void OnCustomerUnitValueChanged(string value)
    {
        headerData.SelectedCustomerUnit = value;
        AfterCustomerUnitChanged();
    }

    private void OnEndCustomerValueChanged(string value)
    {
        headerData.SelectedEndCustomer = value;
        AfterEndCustomerChanged();
    }

    // ========== 值变更后续回调 ==========

    private void AfterSalesmanChanged()
    {
        headerData.SelectedCustomerUnit = string.Empty;
        headerData.SelectedEndCustomer = string.Empty;
        _selectedCustomerId = null;
    }

    private void AfterCustomerUnitChanged()
    {
        headerData.SelectedEndCustomer = string.Empty;
        _selectedCustomerId = null;

        if (_isEndCustomerAuto)
        {
            var matched = _matchedCustomers.FirstOrDefault(c => !string.IsNullOrEmpty(c.EndCustomer));
            if (matched != null)
            {
                headerData.SelectedEndCustomer = matched.EndCustomer!;
                _selectedCustomerId = matched.Id;
            }
        }
    }

    private void AfterEndCustomerChanged()
    {
        var matched = _matchedCustomers.FirstOrDefault(c => c.EndCustomer == headerData.SelectedEndCustomer);
        _selectedCustomerId = matched?.Id;
    }

    // ========== 项次操作方法 ==========

    private void AddNewItem()
    {
        var newSequence = editItemViewModels.Any() ? editItemViewModels.Max(x => x.Sequence) + 1 : 1;
        editItemViewModels.Add(new OrderItemViewModel
        {
            Sequence = newSequence,
            DeliveryDateStr = string.Empty,
            SettlementMethod = SettlementMethod.Theoretical,
            MaterialName = MaterialName.SeamlessPipe,
            DeliveryState = DeliveryState.SolutionAnnealedAndPickled,
            LengthStatus = LengthStatus.Fixed,
            OuterDiameterNegativeStr = string.Empty,
            OuterDiameterPositiveStr = string.Empty,
            WallThicknessNegativeStr = string.Empty,
            WallThicknessPositiveStr = string.Empty
        });
        StateHasChanged();
    }

    private void AddSimilarItem()
    {
        if (!editItemViewModels.Any())
        {
            AddNewItem();
            return;
        }
        var last = editItemViewModels.Last();
        var newSequence = editItemViewModels.Max(x => x.Sequence) + 1;
        editItemViewModels.Add(new OrderItemViewModel
        {
            Sequence = newSequence,
            DeliveryDateStr = last.DeliveryDateStr,
            DelayPenalty = last.DelayPenalty,
            SettlementMethod = last.SettlementMethod,
            MaterialName = last.MaterialName,
            ProductionStandardId = last.ProductionStandardId,
            DeliveryState = last.DeliveryState,
            StandardGrade = last.StandardGrade,
            OuterDiameterStr = last.OuterDiameterStr,
            WallThicknessStr = last.WallThicknessStr,
            OuterDiameterNegativeStr = last.OuterDiameterNegativeStr,
            OuterDiameterPositiveStr = last.OuterDiameterPositiveStr,
            WallThicknessNegativeStr = last.WallThicknessNegativeStr,
            WallThicknessPositiveStr = last.WallThicknessPositiveStr,
            LengthStatus = last.LengthStatus,
            // 以下6个字段默认置0
            MinLengthStr = "0",
            MaxLengthStr = "0",
            QuantityStr = "0",
            MetersStr = "0",
            ContractWeightStr = "0",
            TheoreticalWeight = 0
        });
        StateHasChanged();
    }

    private void RemoveItem(OrderItemViewModel item)
    {
        if (editItemViewModels.Count <= 1)
        {
            Snackbar.Add("订单至少需要保留一个项次", Severity.Warning);
            return;
        }
        editItemViewModels.Remove(item);
        for (int i = 0; i < editItemViewModels.Count; i++)
        {
            editItemViewModels[i].Sequence = i + 1;
        }
        StateHasChanged();
    }

    private void CalculateMetersForItem(OrderItemViewModel item)
    {
        if (item.LengthStatus == LengthStatus.Fixed)
        {
            if (item.MaxLength.HasValue && item.MaxLength > 0 && item.Quantity.HasValue && item.Quantity > 0)
            {
                var meters = Math.Round(item.MaxLength.Value * item.Quantity.Value / 1000m, 2);
                item.MetersStr = meters.ToString();
                StateHasChanged();
                Snackbar.Add($"米数已自动计算为 {meters} 米", Severity.Info);
            }
            else
            {
                Snackbar.Add("请先填写最大长度和支数", Severity.Warning);
            }
        }
        else
        {
            Snackbar.Add("仅在定尺模式下支持自动计算米数", Severity.Info);
        }
    }

    private void CalculateTheoreticalWeightForItem(OrderItemViewModel item)
    {
        var grade = gradeMappings.FirstOrDefault(g => g.StandardGrade == item.StandardGrade);
        if (grade == null)
        {
            Snackbar.Add($"标准牌号 '{item.StandardGrade}' 不存在", Severity.Warning);
            return;
        }

        var meters = item.Meters ?? 0m;
        if (meters <= 0 && item.LengthStatus == LengthStatus.Fixed && item.MaxLength.HasValue && item.Quantity.HasValue)
        {
            meters = item.MaxLength.Value * item.Quantity.Value / 1000m;
            item.MetersStr = meters.ToString();
        }

        if (meters <= 0)
        {
            Snackbar.Add("请先填写米数或定尺模式下的最大长度和支数", Severity.Warning);
            return;
        }

        const decimal pi = 3.1416m;
        var effectiveWall = item.WallThickness - 0.5m * item.WallThicknessNegative + 0.5m * item.WallThicknessPositive;
        var effectiveOd = item.OuterDiameter - 0.5m * item.OuterDiameterNegative + 0.5m * item.OuterDiameterPositive;
        if (effectiveWall < 0) effectiveWall = 0;
        if (effectiveOd <= effectiveWall) effectiveOd = effectiveWall + 0.001m;

        var weight = grade.Density * pi * effectiveWall * (effectiveOd - effectiveWall) * meters / 1000;
        item.TheoreticalWeight = Math.Round(weight < 0 ? 0 : weight, 2);
        
        // 定尺模式下设置最大长度等于最小长度
        if (item.LengthStatus == LengthStatus.Fixed && item.MinLength.HasValue)
        {
            item.MaxLengthStr = item.MinLengthStr;
        }
        
        StateHasChanged();
        Snackbar.Add($"理算重量已计算为 {item.TheoreticalWeight} kg", Severity.Info);
    }

    // ========== 数据加载 ==========

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        isLoading = true;
        StateHasChanged();

        try
        {
            // 并行加载：客户列表、产品标准、牌号对照（三者无依赖关系）
            var customersTask = CustomerService.GetAllAsync();
            var standardsTask = StandardService.GetAllAsync();
            var gradesTask = GradeMappingService.GetAllAsync();
            await Task.WhenAll(customersTask, standardsTask, gradesTask);

            // 处理客户数据
            allCustomers = await customersTask;

            // 产品和牌号数据已并行完成
            productionStandards = await standardsTask;
            gradeMappings = await gradesTask;

            // 添加一个默认项次
            AddNewItem();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"加载数据异常: {ex.Message}");
            Snackbar.Add($"加载数据失败: {ex.Message}", Severity.Error);
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    // ========== 提交订单 ==========

    private async Task SubmitOrder()
    {
        if (isSubmitting) return;

        var errors = new List<string>();
        var warnings = new List<string>();

        // 1. 验证基本信息
        if (string.IsNullOrEmpty(headerData.OrderNumber))
        {
            errors.Add("订单号不能为空");
        }
        else if (headerData.OrderNumber.Length != 11)
        {
            errors.Add("订单号必须为11位字符");
        }

        if (string.IsNullOrEmpty(headerData.SignDateStr))
        {
            errors.Add("请填写签订日期");
        }
        else if (!DateTime.TryParse(headerData.SignDateStr, out var signDate))
        {
            errors.Add("签订日期格式无效，请使用 yyyy-MM-dd 格式");
        }

        if (string.IsNullOrEmpty(headerData.SelectedSalesman))
        {
            errors.Add("请选择业务员");
        }
        else if (string.IsNullOrEmpty(headerData.SelectedCustomerUnit))
        {
            errors.Add("请选择客户单位");
        }
        else if (string.IsNullOrEmpty(headerData.SelectedEndCustomer))
        {
            errors.Add("请选择最终客户");
        }
        else if (_selectedCustomerId == null)
        {
            errors.Add("未找到匹配的客户档案，请先在客户管理中创建");
        }

        // 2. 验证项次
        if (editItemViewModels.Count == 0)
        {
            errors.Add("请至少添加一个订单项次");
        }

        for (int i = 0; i < editItemViewModels.Count; i++)
        {
            var item = editItemViewModels[i];
            var seq = i + 1;

            // 交货日期验证
            if (string.IsNullOrEmpty(item.DeliveryDateStr))
            {
                errors.Add($"项次 {seq}: 交货日期不能为空");
            }
            else if (!DateTime.TryParse(item.DeliveryDateStr, out _))
            {
                errors.Add($"项次 {seq}: 交货日期格式无效，请使用 yyyy-MM-dd");
            }

            // 标准牌号验证
            if (string.IsNullOrEmpty(item.StandardGrade))
            {
                errors.Add($"项次 {seq}: 标准牌号不能为空");
            }
            else if (!gradeMappings.Any(g => g.StandardGrade == item.StandardGrade))
            {
                errors.Add($"项次 {seq}: 标准牌号 '{item.StandardGrade}' 不存在");
            }

            // 数值验证
            if (item.OuterDiameter <= 0)
            {
                errors.Add($"项次 {seq}: 外径必须大于0");
            }
            if (item.WallThickness <= 0)
            {
                errors.Add($"项次 {seq}: 壁厚必须大于0");
            }
            if (item.ContractWeight <= 0)
            {
                errors.Add($"项次 {seq}: 合同重量必须大于0");
            }

            // 长度状态验证
            switch (item.LengthStatus)
            {
                case LengthStatus.Fixed:
                    // 定尺：必须有长度
                    if (string.IsNullOrEmpty(item.MinLengthStr) || item.MinLength <= 0)
                    {
                        errors.Add($"项次 {seq}: 定尺时必须填写长度");
                    }
                    else
                    {
                        // 定尺：最小长度必须等于最大长度
                        if (item.MaxLength == null || item.MaxLength != item.MinLength)
                        {
                            errors.Add($"项次 {seq}: 定尺模式下最小长度必须等于最大长度");
                        }
                    }
                    break;
                case LengthStatus.Range:
                    if (string.IsNullOrEmpty(item.MinLengthStr) || item.MinLength <= 0 ||
                        string.IsNullOrEmpty(item.MaxLengthStr) || item.MaxLength <= 0 ||
                        item.MaxLength <= item.MinLength)
                    {
                        errors.Add($"项次 {seq}: 范围尺时必须填写最小长度和最大长度，且最大长度必须大于最小长度");
                    }
                    break;
            }

            // 理算重量验证（定尺模式需要计算）
            if (item.LengthStatus == LengthStatus.Fixed)
            {
                // 检查理算重量是否已计算
                if (item.TheoreticalWeight <= 0)
                {
                    errors.Add($"项次 {seq}: 请先计算理算重量");
                }
                else
                {
                    // 计算合同重量与理算重量的比值
                    var ratio = item.ContractWeight / item.TheoreticalWeight;
                    var lowerBound = 0.94m;   // 94%
                    var upperBound = 1.06m;   // 106%
                    
                    if (ratio < lowerBound)
                    {
                        warnings.Add($"项次 {seq}: 合同重量 {item.ContractWeight:F2} kg 低于理算重量 {item.TheoreticalWeight:F2} kg 的94%，可能亏损，是否继续？");
                    }
                    else if (ratio > upperBound)
                    {
                        warnings.Add($"项次 {seq}: 合同重量 {item.ContractWeight:F2} kg 高于理算重量 {item.TheoreticalWeight:F2} kg 的106%，请确认");
                    }
                }
            }
        }

        // 3. 如果有错误，一次性显示所有错误
        if (errors.Any())
        {
            Snackbar.Add(string.Join("；", errors), Severity.Error);
            return;
        }

        // 4. 如果有警告，需要用户确认
        if (warnings.Any())
        {
            var warningMsg = string.Join("\n\n", warnings);
            warningMsg += "\n\n是否继续提交？";
            var dialog = DialogService.Show<ConfirmDialog>("确认", new DialogParameters
            {
                ["ContentText"] = warningMsg,
                ["ConfirmText"] = "继续提交",
                ["Color"] = Color.Warning
            });
            var dialogResult = await dialog.Result;
            if (dialogResult.Canceled) return;
        }

        // 5. 构建请求
        var items = new List<CreateOrderItemRequest>();
        foreach (var item in editItemViewModels)
        {
            // 计算米数
            var meters = item.Meters ?? 0m;
            if (item.LengthStatus == LengthStatus.Fixed && item.MaxLength.HasValue && item.Quantity.HasValue)
            {
                meters = item.MaxLength.Value * item.Quantity.Value / 1000m;
            }

            items.Add(new CreateOrderItemRequest
            {
                DeliveryDate = DateTime.Parse(item.DeliveryDateStr),
                DelayPenalty = item.DelayPenalty,
                SettlementMethod = item.SettlementMethod,
                MaterialName = item.MaterialName,
                ProductionStandardId = item.ProductionStandardId,
                DeliveryState = item.DeliveryState,
                StandardGrade = item.StandardGrade,
                OuterDiameter = item.OuterDiameter,
                WallThickness = item.WallThickness,
                OuterDiameterNegative = item.OuterDiameterNegative,
                OuterDiameterPositive = item.OuterDiameterPositive,
                WallThicknessNegative = item.WallThicknessNegative,
                WallThicknessPositive = item.WallThicknessPositive,
                LengthStatus = item.LengthStatus,
                MinLength = item.MinLength,
                MaxLength = item.MaxLength,
                Quantity = item.Quantity,
                Meters = Math.Round(meters, 2),
                ContractWeight = item.ContractWeight,
                Remark = item.Remark
            });
        }

        var request = new CreateSalesOrderRequest
        {
            OrderNumber = headerData.OrderNumber,
            SignDate = DateTime.Parse(headerData.SignDateStr),
            CustomerId = _selectedCustomerId!.Value,
            Items = items
        };

        // 6. 提交订单
        isSubmitting = true;
        StateHasChanged();

        try
        {
            var result = await OrderService.CreateAsync(request);
            if (result.Success && result.Data != null)
            {
                Snackbar.Add($"订单创建成功！订单号：{result.Data.OrderNumber}，状态：待处理", Severity.Success);
                await Task.Delay(500);
                Navigation.NavigateTo("/orders");
            }
            else
            {
                Snackbar.Add(result.Message ?? "创建订单失败", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"创建失败: {ex.Message}", Severity.Error);
        }
        finally
        {
            isSubmitting = false;
            StateHasChanged();
        }
    }

