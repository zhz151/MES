@page "/admin/users"
@using MES.Blazor.Services
@using MES.Core.DTOs.Auth
@using MES.Core.Models
@using MES.Shared.Constants
@using Microsoft.AspNetCore.Authorization
@inject UserService UserService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@attribute [Authorize(Roles = Roles.Admin)]

<MudContainer MaxWidth="MaxWidth.False" Class="mt-4 pl-0">
    <MudCard>
        <MudCardHeader>
            <CardHeaderContent>
                <MudText Typo="Typo.h5" Class="font-weight-bold">
                    <MudIcon Icon="@Icons.Material.Filled.Person" Class="mr-2" Color="Color.Primary" />
                    用户管理
                </MudText>
            </CardHeaderContent>
            <CardHeaderActions>
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Add"
                           OnClick="OpenCreateDialog">
                    新建用户
                </MudButton>
            </CardHeaderActions>
        </MudCardHeader>

        <MudCardContent>
            <!-- 搜索栏 -->
            <MudGrid>
                <MudItem xs="12" md="6">
                    <MudTextField T="string"
                                  Label="搜索 - 用户名/邮箱/姓名"
                                  Value="_searchKeyword"
                                  ValueChanged="@OnSearchChanged"
                                  Immediate="true"
                                  DebounceInterval="500"
                                  Adornment="Adornment.End"
                                  AdornmentIcon="@Icons.Material.Filled.Search" />
                </MudItem>
                <MudItem xs="12" md="6" Class="d-flex align-center">
                    <MudText Typo="Typo.body2" Class="ml-auto">
                        共 @_totalCount 条记录
                    </MudText>
                </MudItem>
            </MudGrid>

            <!-- 数据表格 -->
            <MudTable @ref="table"
                      T="UserDto"
                      ServerData="@LoadDataFromServer"
                      Dense="true"
                      Hover="true"
                      Class="mt-4 auto-table"
                      Elevation="0"
                      RowsPerPage="@_pageSize"
                      RowsPerPageLabel="每页行数:">
                <HeaderContent>
                    <MudTh Style="width: 80px;">序号</MudTh>
                    <MudTh>
                        <div style="display:inline-flex; align-items:center; gap:4px;">
                            <span @onclick='() => ToggleSort("UserName")' style="cursor:pointer" class="th-label">
                                用户名 @if (sortColumn == "UserName") {@(sortDescending ? " ▼" : " ▲")}
                            </span>
                        </div>
                    </MudTh>
                    <MudTh>
                        <div style="display:inline-flex; align-items:center; gap:4px;">
                            <span @onclick='() => ToggleSort("Email")' style="cursor:pointer" class="th-label">
                                邮箱 @if (sortColumn == "Email") {@(sortDescending ? " ▼" : " ▲")}
                            </span>
                        </div>
                    </MudTh>
                    <MudTh>
                        <div style="display:inline-flex; align-items:center; gap:4px;">
                            <span @onclick='() => ToggleSort("FullName")' style="cursor:pointer" class="th-label">
                                姓名 @if (sortColumn == "FullName") {@(sortDescending ? " ▼" : " ▲")}
                            </span>
                        </div>
                    </MudTh>
                    <MudTh>角色</MudTh>
                    <MudTh>
                        <div style="display:inline-flex; align-items:center; gap:4px;">
                            <span @onclick='() => ToggleSort("IsActive")' style="cursor:pointer" class="th-label">
                                状态 @if (sortColumn == "IsActive") {@(sortDescending ? " ▼" : " ▲")}
                            </span>
                        </div>
                    </MudTh>
                    <MudTh>
                        <div style="display:inline-flex; align-items:center; gap:4px;">
                            <span @onclick='() => ToggleSort("LastLoginAt")' style="cursor:pointer" class="th-label">
                                最后登录 @if (sortColumn == "LastLoginAt") {@(sortDescending ? " ▼" : " ▲")}
                            </span>
                        </div>
                    </MudTh>
                    <MudTh style="width: 160px;">操作</MudTh>
                </HeaderContent>
                <RowTemplate Context="item">
                    <MudTd DataLabel="序号">@((_currentPage - 1) * _pageSize + _pageItems.IndexOf(item) + 1)</MudTd>
                    <MudTd DataLabel="用户名">@item.UserName</MudTd>
                    <MudTd DataLabel="邮箱">@item.Email</MudTd>
                    <MudTd DataLabel="姓名">@item.FullName</MudTd>
                    <MudTd DataLabel="角色">
                        @foreach (var role in item.Roles)
                        {
                            <MudChip Size="Size.Small" Color="Color.Primary" Class="mr-1">@GetRoleDisplayName(role)</MudChip>
                        }
                    </MudTd>
                    <MudTd DataLabel="状态">
                        <MudChip Size="Size.Small" Color="@(item.IsActive ? Color.Success : Color.Error)">
                            @(item.IsActive ? "启用" : "停用")
                        </MudChip>
                    </MudTd>
                    <MudTd DataLabel="最后登录">@(item.LastLoginAt?.ToString("yyyy-MM-dd HH:mm") ?? "-")</MudTd>
                    <MudTd DataLabel="操作">
                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                                       Color="Color.Primary" Title="编辑"
                                       OnClick="@(() => OpenEditDialog(item))" />
                        <MudIconButton Icon="@Icons.Material.Filled.LockReset" Size="Size.Small"
                                       Color="Color.Warning" Title="重置密码"
                                       OnClick="@(() => OpenResetPasswordDialog(item))" />
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small"
                                       Color="Color.Error" Title="删除"
                                       Disabled="@(item.Roles.Contains("Admin"))"
                                       OnClick="@(() => DeleteItem(item))" />
                    </MudTd>
                </RowTemplate>
                <NoRecordsContent>
                    <MudText Typo="Typo.body2" Class="text-center pa-4">暂无用户数据</MudText>
                </NoRecordsContent>
                <LoadingContent>
                    <MudText Typo="Typo.body2" Class="text-center pa-4">加载中...</MudText>
                </LoadingContent>
            </MudTable>
        </MudCardContent>
    </MudCard>
</MudContainer>

@* ========== 角色中文映射字典（用于前端显示）========== *@
@code {
    private static readonly Dictionary<string, string> RoleDisplayNames = new()
    {
        ["Admin"] = "超级管理员",
        ["OrderDirector"] = "订单主任", ["OrderStaff"] = "订单专员",
        ["WorkOrderDirector"] = "工单主任", ["WorkOrderStaff"] = "工单专员",
        ["BatchDirector"] = "批次主任", ["BatchStaff"] = "批次专员",
        ["QualityDirector"] = "质检主任", ["QualityStaff"] = "质检专员",
        ["EquipmentDirector"] = "设备主任", ["EquipmentStaff"] = "设备专员",
        ["WarehouseDirector"] = "仓库主任", ["WarehouseStaff"] = "仓库专员",
        ["MaterialDirector"] = "物料主任", ["MaterialStaff"] = "物料专员",
    };

    private static string GetRoleDisplayName(string role) =>
        RoleDisplayNames.TryGetValue(role, out var name) ? name : role;
}
