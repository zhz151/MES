@page "/material-plan-overview"
@using MES.Blazor.Services
@using MES.Core.DTOs
@using MES.Core.Models
@using MES.Core.Enums
@using MES.Blazor.Shared
@using Microsoft.AspNetCore.Authorization
@inject WorkOrderService WorkOrderService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@attribute [Authorize(Roles = "WorkOrderStaff,WorkOrderDirector,Admin")]

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4">
    <MudCard>
        <MudCardHeader>
            <CardHeaderContent>
                <div class="d-flex align-center">
                    <MudIcon Icon="@Icons.Material.Filled.Assignment" Class="mr-2" Color="Color.Primary" Size="Size.Medium" />
                    <MudText Typo="Typo.h5" Class="font-weight-bold">用料计划总览</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="ml-4">查看所有工单的用料计划状态</MudText>
                </div>
            </CardHeaderContent>
            <CardHeaderActions>
                <MudButton Variant="Variant.Outlined"
                           Color="Color.Info"
                           StartIcon="@Icons.Material.Filled.Refresh"
                           OnClick="() => table.ReloadServerData()"
                           Size="Size.Small">
                    刷新
                </MudButton>
            </CardHeaderActions>
        </MudCardHeader>

        <MudCardContent>
            <!-- 错误提示 -->
            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <MudAlert Severity="Severity.Error" Class="mb-4" Variant="Variant.Filled">
                    @errorMessage
                </MudAlert>
            }

            <!-- 筛选栏 -->
            <MudGrid>
                <MudItem xs="12" md="3">
                    <MudTextField T="string"
                                  Label="搜索 - 工单号/订单号/主号/次号"
                                  @bind-Value="searchKeyword"
                                  Immediate="true"
                                  DebounceInterval="500"
                                  Clearable="true"
                                  Adornment="Adornment.End"
                                  AdornmentIcon="@Icons.Material.Filled.Search" />
                </MudItem>
                <MudItem xs="12" md="2">
                    <MudSelect T="int?" Label="工单用料计划状态" @bind-Value="selectedStatus">
                        <MudSelectItem Value="@((int?)null)">全部</MudSelectItem>
                        <MudSelectItem Value="@((int?)0)">未计划</MudSelectItem>
                        <MudSelectItem Value="@((int?)1)">部分</MudSelectItem>
                        <MudSelectItem Value="@((int?)2)">理论满足</MudSelectItem>
                        <MudSelectItem Value="@((int?)3)">满足</MudSelectItem>
                        <MudSelectItem Value="@((int?)4)">超量</MudSelectItem>
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" md="2">
                    <MudSelect T="int?" Label="关联主号用料" @bind-Value="selectedMainNoStatus">
                        <MudSelectItem Value="@((int?)null)">全部</MudSelectItem>
                        <MudSelectItem Value="@((int?)0)">未计划</MudSelectItem>
                        <MudSelectItem Value="@((int?)1)">部分</MudSelectItem>
                        <MudSelectItem Value="@((int?)3)">满足</MudSelectItem>
                        <MudSelectItem Value="@((int?)4)">超量</MudSelectItem>
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" md="2">
                    <MudSelect T="int?" Label="关联订单用料" @bind-Value="selectedOrderStatus">
                        <MudSelectItem Value="@((int?)null)">全部</MudSelectItem>
                        <MudSelectItem Value="@((int?)0)">未计划</MudSelectItem>
                        <MudSelectItem Value="@((int?)1)">部分</MudSelectItem>
                        <MudSelectItem Value="@((int?)3)">全部满足</MudSelectItem>
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" md="3">
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               FullWidth="true"
                               StartIcon="@Icons.Material.Filled.Search"
                               OnClick="() => table.ReloadServerData()">
                        搜索
                    </MudButton>
                </MudItem>
            </MudGrid>

            <!-- 数据表格 -->
            <MudTable @ref="table"
                      ServerData="ReloadData"
                      Dense="true"
                      Hover="true"
                      Elevation="0"
                      Class="mt-4"
                      RowsPerPage="10"
                      RowsPerPageLabel="每页行数:">
                <HeaderContent>
                    <MudTh>工单号</MudTh>
                    <MudTh>订单号</MudTh>
                    <MudTh>主号</MudTh>
                    <MudTh>次号</MudTh>
                    <MudTh>工单用料计划</MudTh>
                    <MudTh>工单满足率</MudTh>
                    <MudTh>用料占比</MudTh>
                    <MudTh>关联主号用料</MudTh>
                    <MudTh>关联订单用料</MudTh>
                    <MudTh>操作</MudTh>
                </HeaderContent>
                <RowTemplate Context="wo">
                    <MudTd title="@wo.WorkOrderNo">
                        <MudLink Typo="Typo.body2" OnClick="() => NavigateToDetail(wo.Id)">
                            @wo.WorkOrderNo
                        </MudLink>
                    </MudTd>
                    <MudTd title="@wo.SalesOrderNo">@wo.SalesOrderNo</MudTd>
                    <MudTd title="@wo.ProductionMainNo">@wo.ProductionMainNo</MudTd>
                    <MudTd title="@wo.ProductionSubNo">@wo.ProductionSubNo</MudTd>
                    <MudTd>
                        <MudChip Size="Size.Small" Color="@GetStatusColor(wo.MaterialPlanStatus)">
                            @GetStatusText(wo.MaterialPlanStatus)
                        </MudChip>
                    </MudTd>
                    <MudTd>@((int)Math.Round(wo.MaterialPlanRate))%</MudTd>
                    <MudTd>
                        @if (!string.IsNullOrEmpty(wo.PlanProportionText))
                        {
                            <MudText Typo="Typo.caption" Class="text-wrap" Style="max-width:180px;">@wo.PlanProportionText</MudText>
                        }
                        else
                        {
                            <MudText Typo="Typo.caption" Color="Color.Secondary">-</MudText>
                        }
                    </MudTd>
                    <MudTd>
                        <MudChip Size="Size.Small" Color="@GetStatusColor(wo.MainNoMaterialPlanStatus)">
                            @GetStatusText(wo.MainNoMaterialPlanStatus)
                        </MudChip>
                    </MudTd>
                    <MudTd>
                        <MudChip Size="Size.Small" Color="@GetOrderStatusColor(wo.OrderMaterialPlanStatus)">
                            @GetOrderStatusText(wo.OrderMaterialPlanStatus)
                        </MudChip>
                    </MudTd>
                    <MudTd>
                        <MudIconButton Icon="@Icons.Material.Filled.Warehouse"
                                       Size="Size.Small"
                                       Color="Color.Info"
                                       OnClick="() => NavigateToInventoryPlan(wo.Id)"
                                       Title="库存使用计划" />
                        <MudIconButton Icon="@Icons.Material.Filled.Construction"
                                       Size="Size.Small"
                                       Color="Color.Warning"
                                       OnClick="() => NavigateToReworkPlan(wo.Id)"
                                       Title="库料生产改制" />
                        <MudIconButton Icon="@Icons.Material.Filled.Inventory2"
                                       Size="Size.Small"
                                       Color="Color.Success"
                                       OnClick="() => NavigateToSemiPlan(wo.Id)"
                                       Title="原料采购计划" />
                        <MudIconButton Icon="@Icons.Material.Filled.Checklist"
                                       Size="Size.Small"
                                       Color="Color.Primary"
                                       OnClick="() => NavigateToFinishPlan(wo.Id)"
                                       Title="成品采购计划" />
                    </MudTd>
                </RowTemplate>
                <NoRecordsContent>
                    <MudText Class="d-flex justify-center pa-4" Color="Color.Secondary">暂无工单数据</MudText>
                </NoRecordsContent>
                <PagerContent>
                    <MudTablePager PageSizeOptions="new int[]{10, 25, 50, 100}" />
                </PagerContent>
            </MudTable>
        </MudCardContent>
    </MudCard>
</MudContainer>

@code {
    private MudTable<WorkOrderListDto> table = null!;
    private string errorMessage = string.Empty;
    private string searchKeyword = string.Empty;
    private int? selectedStatus;
    private int? selectedMainNoStatus;
    private int? selectedOrderStatus;

    private async Task<TableData<WorkOrderListDto>> ReloadData(TableState state)
    {
        errorMessage = string.Empty;

        try
        {
            var queryParams = new WorkOrderQueryParams
            {
                PageIndex = state.Page + 1,
                PageSize = state.PageSize,
                SortBy = "CreatedTime",
                IsDescending = true,
                Keyword = string.IsNullOrWhiteSpace(searchKeyword) ? null : searchKeyword,
                MaterialPlanStatus = selectedStatus,
                MainNoMaterialPlanStatus = selectedMainNoStatus,
                OrderMaterialPlanStatus = selectedOrderStatus
            };

            var result = await WorkOrderService.GetPagedAsync(queryParams);

            if (result.Success && result.Data != null)
            {
                return new TableData<WorkOrderListDto>
                {
                    Items = result.Data.Items,
                    TotalItems = result.Data.TotalCount
                };
            }

            errorMessage = result.Message ?? "查询失败，未返回数据";
        }
        catch (Exception ex)
        {
            errorMessage = $"加载异常: {ex.Message}";
        }

        return new TableData<WorkOrderListDto>
        {
            Items = Array.Empty<WorkOrderListDto>(),
            TotalItems = 0
        };
    }

    private void NavigateToDetail(int id)
    {
        Navigation.NavigateTo($"/workorders/{id}");
    }

    private void NavigateToSemiPlan(int id)
    {
        Navigation.NavigateTo($"/workorders/{id}/material-plan");
    }

    private void NavigateToFinishPlan(int id)
    {
        Navigation.NavigateTo($"/workorders/{id}/finish-plan");
    }

    private void NavigateToInventoryPlan(int id)
    {
        Navigation.NavigateTo($"/workorders/{id}/inventory-plan");
    }

    private void NavigateToReworkPlan(int id)
    {
        Navigation.NavigateTo($"/workorders/{id}/rework-plan");
    }

    private Color GetStatusColor(int status)
    {
        return status switch
        {
            0 => Color.Default,
            1 => Color.Warning,
            2 => Color.Info,
            3 => Color.Success,
            4 => Color.Error,
            _ => Color.Default
        };
    }

    private string GetStatusText(int status)
    {
        return status switch
        {
            0 => "未计划",
            1 => "部分",
            2 => "理论满足",
            3 => "满足",
            4 => "超量",
            _ => "未知"
        };
    }

    /// <summary>
    /// 订单级状态颜色（仅"全部满足"或"未满足"，不含理论满足）
    /// </summary>
    private Color GetOrderStatusColor(int status)
    {
        return status switch
        {
            0 => Color.Default,
            1 => Color.Warning,
            3 => Color.Success,
            _ => Color.Default
        };
    }

    private string GetOrderStatusText(int status)
    {
        return status switch
        {
            0 => "未计划",
            1 => "部分",
            3 => "全部满足",
            _ => "未知"
        };
    }
}
