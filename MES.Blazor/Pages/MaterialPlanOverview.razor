@page "/material-plan-overview"
@using MES.Blazor.Services
@using MES.Blazor.Helpers
@using MES.Core.DTOs
@using MES.Core.Models
@using MES.Core.Enums
@using MES.Blazor.Shared
@using Microsoft.AspNetCore.Authorization
@inject WorkOrderService WorkOrderService
@inject MaterialPlanService MaterialPlanService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject IJSRuntime JS
@inject ColumnPrefsService ColumnPrefs
@attribute [Authorize(Roles = "WorkOrderStaff,WorkOrderDirector,Admin")]

<MudContainer MaxWidth="MaxWidth.False" Class="mt-4 pl-0">
    <MudCard>
        <MudCardHeader>
            <CardHeaderContent>
                <div class="d-flex align-center">
                    <MudIcon Icon="@Icons.Material.Filled.Assignment" Class="mr-2" Color="Color.Primary" Size="Size.Medium" />
                    <MudText Typo="Typo.h5" Class="font-weight-bold">用料计划总览</MudText>
                </div>
            </CardHeaderContent>
            <CardHeaderActions>
                <MudButton Variant="Variant.Outlined"
                           Color="Color.Info"
                           StartIcon="@Icons.Material.Filled.Refresh"
                           OnClick="() => table.ReloadServerData()"
                           Size="Size.Small">
                    刷新
                </MudButton>
            </CardHeaderActions>
        </MudCardHeader>

        <MudCardContent>
            <!-- 错误提示 -->
            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <MudText Typo="Typo.body2" Color="Color.Error" Class="mb-4">@errorMessage</MudText>
            }

            <!-- 筛选栏 -->
            <MudGrid>
                <MudItem xs="12" md="3">
                    <MudTextField T="string"
                                  Label="模糊搜索 - 工单号/订单号/主号/次号/业务员/最终用户"
                                  Value="@searchKeyword"
                                  ValueChanged="@OnSearchChanged"
                                  Immediate="true"
                                  DebounceInterval="500"
                                  Clearable="true"
                                  ClearButton="true"
                                  Adornment="Adornment.End"
                                  AdornmentIcon="@Icons.Material.Filled.Search" />
                </MudItem>
                <MudItem xs="12" md="3">
                    <MudSelect T="int" Label="关联订单用料"
                               Value="@selectedOrderStatus"
                               ValueChanged="@((int v) => OnStatusFilterChanged(v, 3))"
                               AnchorOrigin="Origin.BottomCenter">
                        <MudSelectItem Value="-1">全部</MudSelectItem>
                        <MudSelectItem Value="0">未计划</MudSelectItem>
                        <MudSelectItem Value="1">部分</MudSelectItem>
                        <MudSelectItem Value="3">全部满足</MudSelectItem>
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" md="3">
                    <MudSelect T="int" Label="关联主号用料"
                               Value="@selectedMainNoStatus"
                               ValueChanged="@((int v) => OnStatusFilterChanged(v, 2))"
                               AnchorOrigin="Origin.BottomCenter">
                        <MudSelectItem Value="-1">全部</MudSelectItem>
                        <MudSelectItem Value="0">未计划</MudSelectItem>
                        <MudSelectItem Value="1">部分</MudSelectItem>
                        <MudSelectItem Value="3">满足</MudSelectItem>
                        <MudSelectItem Value="4">超量</MudSelectItem>
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" md="3">
                    <MudSelect T="int" Label="工单用料计划状态"
                               Value="@selectedStatus"
                               ValueChanged="@((int v) => OnStatusFilterChanged(v, 1))"
                               AnchorOrigin="Origin.BottomCenter">
                        <MudSelectItem Value="-1">全部</MudSelectItem>
                        <MudSelectItem Value="0">未计划</MudSelectItem>
                        <MudSelectItem Value="1">部分</MudSelectItem>
                        <MudSelectItem Value="2">理论满足</MudSelectItem>
                        <MudSelectItem Value="3">满足</MudSelectItem>
                        <MudSelectItem Value="4">超量</MudSelectItem>
                    </MudSelect>
                </MudItem>
            </MudGrid>

            <!-- 数据表格 -->
            <MudTable @ref="table"
                      ServerData="OnServerData"
                      Loading="@isLoading"
                      Dense="true"
                      Hover="true"
                      Elevation="0"
                      Class="auto-table"
                      RowsPerPage="10"
                      RowsPerPageLabel="每页行数:">
                <ToolBarContent>
                    <ColumnDisplaySelect Columns="_allColumns"
                                         OnColumnToggle="OnColumnToggle"
                                         OnMoveUp="MoveColumnUp"
                                         OnMoveDown="MoveColumnDown" />
                    <MudButton Variant="Variant.Text" Size="Size.Small"
                               Color="Color.Default"
                               StartIcon="@Icons.Material.Filled.RestartAlt"
                               OnClick="ResetColumnDisplay" Class="ml-2">
                        重置
                    </MudButton>
                    <MudSpacer />
                    <MudButton Variant="Variant.Filled"
                               Size="Size.Small"
                               Color="Color.Info"
                               StartIcon="@Icons.Material.Filled.Print"
                               Disabled="@(!selectedWorkOrderIds.Any() || !anyPlanTypeSelected)"
                               OnClick="PrintSelectedPlans">
                        打印选中 (@selectedWorkOrderIds.Count)
                    </MudButton>
                    <MudCheckBox T="bool" Value="@includePiercing" ValueChanged="@((bool v) => OnPlanTypeFilterChanged(v, 5))" Dense="true" Class="ml-2" />
                    <MudText Typo="Typo.body2" Class="mr-3">圆棒穿孔</MudText>
                    <MudCheckBox T="bool" Value="@includeSemi" ValueChanged="@((bool v) => OnPlanTypeFilterChanged(v, 1))" Dense="true" />
                    <MudText Typo="Typo.body2" Class="mr-3">荒管采购</MudText>
                    <MudCheckBox T="bool" Value="@includeFinish" ValueChanged="@((bool v) => OnPlanTypeFilterChanged(v, 2))" Dense="true" />
                    <MudText Typo="Typo.body2" Class="mr-3">成品采购</MudText>
                    <MudCheckBox T="bool" Value="@includeInventory" ValueChanged="@((bool v) => OnPlanTypeFilterChanged(v, 3))" Dense="true" />
                    <MudText Typo="Typo.body2" Class="mr-3">库存使用</MudText>
                    <MudCheckBox T="bool" Value="@includeRework" ValueChanged="@((bool v) => OnPlanTypeFilterChanged(v, 4))" Dense="true" />
                    <MudText Typo="Typo.body2" Class="mr-3">库料改制</MudText>
                    <MudText Typo="Typo.body2" Class="ml-4">
                        共 @totalCount 条记录
                    </MudText>
                </ToolBarContent>
                <HeaderContent>
                    <MudTh Style="width: 40px;">
                        <MudCheckBox T="bool" @bind-Value="allSelected" Dense="true" />
                    </MudTh>
                    @foreach (var col in _visibleColumns)
                    {
                        <MudTh>
                            @if (!string.IsNullOrEmpty(col.SortKey))
                            {
                                <span @onclick='() => ToggleSort(col.SortKey)' class="sortable-header">
                                    @col.Label
                                    @if (sortColumn == col.SortKey)
                                    {
                                        <span class="sort-arrow">@GetSortIndicator(col.SortKey)</span>
                                    }
                                </span>
                            }
                            else
                            {
                                <span class="th-label">@col.Label</span>
                            }
                        </MudTh>
                    }
                    <MudTh>操作</MudTh>
                </HeaderContent>
                <RowTemplate Context="wo">
                    <MudTd Style="width: 40px;">
                        <MudCheckBox T="bool"
                                     Value="@selectedWorkOrderIds.Contains(wo.Id)"
                                     ValueChanged="@((v) => ToggleSelectWorkOrder(wo.Id, v))"
                                     Dense="true" />
                    </MudTd>
                    @foreach (var col in _visibleColumns)
                    {
                        <MudTd>@RenderCell(wo, col)</MudTd>
                    }
                    <MudTd>
                        <MudIconButton Icon="@Icons.Material.Filled.Assignment"
                                       Size="Size.Small"
                                       Color="Color.Primary"
                                       OnClick="() => NavigateToMaterialPlan(wo.Id)"
                                       Title="工单用料计划" />
                    </MudTd>
                </RowTemplate>
                <NoRecordsContent>
                </NoRecordsContent>
                <PagerContent>
                    <MudTablePager PageSizeOptions="new int[]{10, 25, 50, 100}" />
                </PagerContent>
            </MudTable>
        </MudCardContent>
    </MudCard>
</MudContainer>

@code {
    private MudTable<WorkOrderListDto> table = null!;
    private string errorMessage = string.Empty;
    private string searchKeyword = string.Empty;
    private int selectedStatus = -1;
    private int selectedMainNoStatus = -1;
    private int selectedOrderStatus = -1;
    private bool isLoading;
    private List<WorkOrderListDto> currentPageItems = new();
    private int totalCount;

    // 排序状态
    private string sortColumn = "CreatedTime";
    private bool sortDescending = true;

    // 选中状态
    private bool _allSelected;
    private bool allSelected
    {
        get => _allSelected;
        set
        {
            if (_allSelected == value) return;
            _allSelected = value;
            if (value)
            {
                foreach (var item in currentPageItems)
                    selectedWorkOrderIds.Add(item.Id);
            }
            else
            {
                selectedWorkOrderIds.Clear();
            }
            StateHasChanged();
        }
    }
    private HashSet<int> selectedWorkOrderIds = new();

    // 打印类型选项
    private bool includeSemi = true;
    private bool includeFinish = true;
    private bool includeInventory = true;
    private bool includeRework = true;
    private bool includePiercing = true;
    private bool anyPlanTypeSelected => includeSemi || includeFinish || includeInventory || includeRework || includePiercing;

    // 列定义
    private List<ColumnDef> _allColumns = new();
    private List<ColumnDef> _visibleColumns =>
        _allColumns.Where(c => c.Visible).ToList();

    /// <summary>
    /// 获取列定义（不可排序列 SortKey 设为 null）
    /// </summary>
    private static List<ColumnDef> GetAllColumnDefs() => new()
    {
        new() { Key = "WorkOrderNo",        Label = "工单号",     SortKey = "WorkOrderNo" },
        new() { Key = "SalesOrderNo",       Label = "订单号",     SortKey = "SalesOrderNo" },
        new() { Key = "ProductionMainNo",   Label = "主号",       SortKey = "ProductionMainNo" },
        new() { Key = "ProductionSubNo",    Label = "次号",       SortKey = "ProductionSubNo" },
        new() { Key = "SignDate",           Label = "签订日期",   SortKey = "signdate" },
        new() { Key = "Salesman",           Label = "业务员",     SortKey = "salesman" },
        new() { Key = "EndCustomer",        Label = "最终用户",   SortKey = "endcustomer" },
        new() { Key = "DeliveryDate",       Label = "交货日期",   SortKey = "deliverydate" },
        new() { Key = "DelayPenalty",       Label = "延期罚款",   SortKey = "delaypenalty" },
        new() { Key = "SettlementMethod",   Label = "结算方式",   SortKey = "settlementmethod" },
        new() { Key = "PlantGrade",         Label = "工厂牌号",   SortKey = "plantgrade" },
        new() { Key = "Specification",      Label = "规格",       SortKey = "specification" },
        new() { Key = "MaterialName",       Label = "物料名称",   SortKey = "materialname" },
        new() { Key = "LengthStatus",       Label = "长度状态",   SortKey = "lengthstatus" },
        new() { Key = "MaxLength",          Label = "最大长度",   SortKey = "maxlength" },
        new() { Key = "MinLength",          Label = "最小长度",   SortKey = "minlength" },
        new() { Key = "TotalQuantity",      Label = "总支数",     SortKey = "totalquantity" },
        new() { Key = "TotalWeight",        Label = "总重量",     SortKey = "totalweight" },
        new() { Key = "DeliveryState",      Label = "交货状态",   SortKey = "deliverystate" },
        new() { Key = "TotalItemCount",     Label = "含项次数",   SortKey = "totalitemcount" },
        new() { Key = "LatestPlanDate",          Label = "计划日期",       SortKey = "LatestPlanDate" },
        new() { Key = "MaterialPlanStatus",      Label = "工单用料计划",   SortKey = "MaterialPlanStatus" },
        new() { Key = "MaterialPlanRate",        Label = "工单满足率",     SortKey = "MaterialPlanRate" },
        new() { Key = "PlanProportion",          Label = "用料占比",       SortKey = null },
        new() { Key = "MainNoMaterialPlanStatus",Label = "关联主号用料",   SortKey = "MainNoMaterialPlanStatus" },
        new() { Key = "OrderMaterialPlanStatus", Label = "关联订单用料",   SortKey = "OrderMaterialPlanStatus" },
    };

    /// <summary>
    /// 根据当前勾选的计算计划类型过滤字符串（全选时返回 null 不过滤）
    /// </summary>
    private string? GetPlanTypeFilter()
    {
        var types = new List<string>();
        if (includeSemi) types.Add("Semi");
        if (includeFinish) types.Add("Finish");
        if (includeInventory) types.Add("Inventory");
        if (includeRework) types.Add("Rework");
        if (includePiercing) types.Add("Piercing");
        return types.Count < 5 ? string.Join(",", types) : null;
    }

    private async Task OnPlanTypeFilterChanged(bool value, int planType)
    {
        switch (planType)
        {
            case 1: includeSemi = value; break;
            case 2: includeFinish = value; break;
            case 3: includeInventory = value; break;
            case 4: includeRework = value; break;
            case 5: includePiercing = value; break;
        }
        // 清除跨页选中，避免打印不存在的选中项
        selectedWorkOrderIds.Clear();
        _allSelected = false;
        if (table != null)
            await table.ReloadServerData();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // 初始化列定义
            _allColumns = GetAllColumnDefs();

            // 加载用户自定义列偏好
            var saved = await ColumnPrefs.LoadAsync("materialPlanOverview", null);
            if (saved.Count > 0)
            {
                // 先恢复可见性
                foreach (var s in saved)
                {
                    var match = _allColumns.FirstOrDefault(c => c.Key == s.Key);
                    if (match != null)
                        match.Visible = s.Visible;
                }
                // 再恢复列顺序
                var reordered = new List<ColumnDef>();
                foreach (var s in saved)
                {
                    var match = _allColumns.FirstOrDefault(c => c.Key == s.Key);
                    if (match != null && !reordered.Contains(match))
                        reordered.Add(match);
                }
                foreach (var c in _allColumns)
                {
                    if (!reordered.Contains(c))
                        reordered.Add(c);
                }
                _allColumns = reordered;
            }

            if (table != null)
                await table.ReloadServerData();
        }
    }

    private string GetSortIndicator(string column)
    {
        if (sortColumn != column) return "";
        return sortDescending ? "\u25BC" : "\u25B2";
    }

    private async Task OnSearchChanged(string value)
    {
        searchKeyword = value ?? string.Empty;
        if (table != null)
            await table.ReloadServerData();
    }

    private async Task OnStatusFilterChanged(int value, int filterType)
    {
        switch (filterType)
        {
            case 1:
                selectedStatus = value;
                break;
            case 2:
                selectedMainNoStatus = value;
                break;
            case 3:
                selectedOrderStatus = value;
                break;
        }
        if (table != null)
            await table.ReloadServerData();
    }

    private async Task ToggleSort(string column)
    {
        if (sortColumn == column)
            sortDescending = !sortDescending;
        else
        {
            sortColumn = column;
            sortDescending = false;
        }
        if (table != null)
            await table.ReloadServerData();
    }

    private async Task FilterByPlanStatus(int status)
    {
        selectedStatus = status;
        StateHasChanged();
        if (table != null)
            await table.ReloadServerData();
    }

    private async Task FilterByMainNoStatus(int status)
    {
        selectedMainNoStatus = status;
        StateHasChanged();
        if (table != null)
            await table.ReloadServerData();
    }

    private async Task FilterByOrderStatus(int status)
    {
        selectedOrderStatus = status;
        StateHasChanged();
        if (table != null)
            await table.ReloadServerData();
    }

    private async Task<TableData<WorkOrderListDto>> OnServerData(TableState state)
    {
        errorMessage = string.Empty;
        isLoading = true;
        StateHasChanged();

        try
        {
            var queryParams = new WorkOrderQueryParams
            {
                PageIndex = state.Page + 1,
                PageSize = state.PageSize,
                SortBy = sortColumn,
                IsDescending = sortDescending,
                Keyword = string.IsNullOrWhiteSpace(searchKeyword) ? null : searchKeyword,
                MaterialPlanStatus = selectedStatus >= 0 ? selectedStatus : null,
                MainNoMaterialPlanStatus = selectedMainNoStatus >= 0 ? selectedMainNoStatus : null,
                OrderMaterialPlanStatus = selectedOrderStatus >= 0 ? selectedOrderStatus : null,
                PlanTypeFilter = GetPlanTypeFilter()
            };

            var result = await WorkOrderService.GetPagedAsync(queryParams);

            if (result.Success && result.Data != null)
            {
                currentPageItems = result.Data.Items.ToList();
                totalCount = result.Data.TotalCount;
                return new TableData<WorkOrderListDto>
                {
                    Items = result.Data.Items,
                    TotalItems = result.Data.TotalCount
                };
            }

            errorMessage = result.Message ?? "查询失败，未返回数据";
        }
        catch (Exception ex)
        {
            errorMessage = $"加载异常: {ex.Message}";
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }

        return new TableData<WorkOrderListDto>
        {
            Items = Array.Empty<WorkOrderListDto>(),
            TotalItems = 0
        };
    }

    // ========== 单元格渲染 ==========

    private RenderFragment RenderCell(WorkOrderListDto wo, ColumnDef col) => builder =>
    {
        switch (col.Key)
        {
            case "WorkOrderNo":
                builder.OpenComponent<MudLink>(0);
                builder.AddAttribute(1, "Typo", Typo.body2);
                builder.AddAttribute(2, "OnClick", EventCallback.Factory.Create<MouseEventArgs?>(this, () => NavigateToMaterialPlan(wo.Id)));
                builder.AddAttribute(3, "ChildContent", (RenderFragment)(b2 => b2.AddContent(0, wo.WorkOrderNo)));
                builder.CloseComponent();
                break;
            case "SalesOrderNo":
                builder.AddContent(0, wo.SalesOrderNo);
                break;
            case "ProductionMainNo":
                builder.AddContent(0, wo.ProductionMainNo);
                break;
            case "ProductionSubNo":
                builder.AddContent(0, wo.ProductionSubNo);
                break;
            case "SignDate":
                builder.AddContent(0, wo.SignDate.ToString("yyyy-MM-dd"));
                break;
            case "Salesman":
                builder.AddContent(0, wo.Salesman);
                break;
            case "EndCustomer":
                builder.AddContent(0, wo.EndCustomer ?? "-");
                break;
            case "DeliveryDate":
                builder.AddContent(0, wo.DeliveryDate.ToString("yyyy-MM-dd"));
                break;
            case "DelayPenalty":
                builder.AddContent(0, wo.DelayPenalty ? "是" : "否");
                break;
            case "SettlementMethod":
                builder.AddContent(0, DisplayHelper.GetSettlementMethodText(wo.SettlementMethod));
                break;
            case "PlantGrade":
                builder.AddContent(0, wo.PlantGrade);
                break;
            case "Specification":
                builder.AddContent(0, wo.Specification);
                break;
            case "MaterialName":
                builder.AddContent(0, DisplayHelper.GetMaterialNameText(wo.MaterialName));
                break;
            case "LengthStatus":
                builder.AddContent(0, DisplayHelper.GetLengthStatusText(wo.LengthStatus));
                break;
            case "MaxLength":
                builder.AddContent(0, wo.MaxLength?.ToString("G29") ?? "-");
                break;
            case "MinLength":
                builder.AddContent(0, wo.MinLength?.ToString("G29") ?? "-");
                break;
            case "TotalQuantity":
                builder.AddContent(0, wo.TotalQuantity);
                break;
            case "TotalWeight":
                builder.AddContent(0, wo.TotalWeight.ToString("G29"));
                break;
            case "DeliveryState":
                builder.AddContent(0, DisplayHelper.GetDeliveryStateText(wo.DeliveryState));
                break;
            case "TotalItemCount":
                builder.AddContent(0, wo.TotalItemCount);
                break;
            case "LatestPlanDate":
                builder.OpenComponent<MudChip>(0);
                builder.AddAttribute(1, "Size", Size.Small);
                builder.AddAttribute(2, "Color", Color.Info);
                builder.AddAttribute(3, "ChildContent", (RenderFragment)(b2 => b2.AddContent(0, wo.LatestPlanDate?.ToString("yyyy-MM-dd") ?? "-")));
                builder.CloseComponent();
                break;
            case "MaterialPlanStatus":
                builder.OpenComponent<MudChip>(0);
                builder.AddAttribute(1, "Size", Size.Small);
                builder.AddAttribute(2, "Color", GetStatusColor(wo.MaterialPlanStatus));
                builder.AddAttribute(3, "Clickable", true);
                builder.AddAttribute(4, "OnClick", EventCallback.Factory.Create<MouseEventArgs?>(this, () => FilterByPlanStatus(wo.MaterialPlanStatus)));
                builder.AddAttribute(5, "ChildContent", (RenderFragment)(b2 => b2.AddContent(0, GetStatusText(wo.MaterialPlanStatus))));
                builder.CloseComponent();
                break;
            case "MaterialPlanRate":
                builder.AddContent(0, $"{(int)Math.Round(wo.MaterialPlanRate)}%");
                break;
            case "PlanProportion":
                if (!string.IsNullOrEmpty(wo.PlanProportionText))
                {
                    builder.OpenComponent<MudText>(0);
                    builder.AddAttribute(1, "Typo", Typo.caption);
                    builder.AddAttribute(2, "Class", "text-wrap");
                    builder.AddAttribute(3, "Style", "max-width:180px;");
                    builder.AddAttribute(4, "ChildContent", (RenderFragment)(b2 => b2.AddContent(0, wo.PlanProportionText)));
                    builder.CloseComponent();
                }
                else
                {
                    builder.OpenComponent<MudText>(0);
                    builder.AddAttribute(1, "Typo", Typo.caption);
                    builder.AddAttribute(2, "Color", Color.Secondary);
                    builder.AddAttribute(3, "ChildContent", (RenderFragment)(b2 => b2.AddContent(0, "-")));
                    builder.CloseComponent();
                }
                break;
            case "MainNoMaterialPlanStatus":
                builder.OpenComponent<MudChip>(0);
                builder.AddAttribute(1, "Size", Size.Small);
                builder.AddAttribute(2, "Color", GetStatusColor(wo.MainNoMaterialPlanStatus));
                builder.AddAttribute(3, "Clickable", true);
                builder.AddAttribute(4, "OnClick", EventCallback.Factory.Create<MouseEventArgs?>(this, () => FilterByMainNoStatus(wo.MainNoMaterialPlanStatus)));
                builder.AddAttribute(5, "ChildContent", (RenderFragment)(b2 => b2.AddContent(0, GetStatusText(wo.MainNoMaterialPlanStatus))));
                builder.CloseComponent();
                break;
            case "OrderMaterialPlanStatus":
                builder.OpenComponent<MudChip>(0);
                builder.AddAttribute(1, "Size", Size.Small);
                builder.AddAttribute(2, "Color", GetOrderStatusColor(wo.OrderMaterialPlanStatus));
                builder.AddAttribute(3, "Clickable", true);
                builder.AddAttribute(4, "OnClick", EventCallback.Factory.Create<MouseEventArgs?>(this, () => FilterByOrderStatus(wo.OrderMaterialPlanStatus)));
                builder.AddAttribute(5, "ChildContent", (RenderFragment)(b2 => b2.AddContent(0, GetOrderStatusText(wo.OrderMaterialPlanStatus))));
                builder.CloseComponent();
                break;
        }
    };

    // ========== 列管理 ==========

    private async Task OnColumnToggle(ColumnDef col)
    {
        await SaveColumnPrefs();
    }

    private async Task SaveColumnPrefs()
    {
        await ColumnPrefs.SaveAsync("materialPlanOverview", null, _allColumns);
    }

    private async Task ResetColumnDisplay()
    {
        _allColumns = GetAllColumnDefs();
        foreach (var c in _allColumns)
            c.Visible = true;
        await SaveColumnPrefs();
        if (table != null)
            await table.ReloadServerData();
    }

    private async Task MoveColumnUp(ColumnDef col)
    {
        await SaveColumnPrefs();
    }

    private async Task MoveColumnDown(ColumnDef col)
    {
        await SaveColumnPrefs();
    }

    // ========== 导航 ==========

    private void NavigateToMaterialPlan(int id)
    {
        Navigation.NavigateTo($"/workorders/{id}/material-plan");
    }

    // ===== 批量打印 =====

    private void ToggleSelectWorkOrder(int id, bool selected)
    {
        if (selected)
            selectedWorkOrderIds.Add(id);
        else
            selectedWorkOrderIds.Remove(id);

        _allSelected = currentPageItems.Any() && currentPageItems.All(i => selectedWorkOrderIds.Contains(i.Id));
        StateHasChanged();
    }

    private async Task PrintSelectedPlans()
    {
        if (!selectedWorkOrderIds.Any() || !anyPlanTypeSelected) return;

        var request = new MaterialPlanBatchPrintRequest
        {
            WorkOrderIds = selectedWorkOrderIds.ToArray(),
            IncludeSemi = includeSemi,
            IncludeFinish = includeFinish,
            IncludeInventory = includeInventory,
            IncludeRework = includeRework,
            IncludeRoundBarPiercing = includePiercing
        };

        try
        {
            var result = await MaterialPlanService.PrintSelectedPlansAsync(request);
            if (result.Success && !string.IsNullOrEmpty(result.Data))
            {
                await JS.InvokeVoidAsync("openPdf", result.Data);
            }
            else
            {
                Snackbar.Add(result.Message ?? "打印生成失败", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"打印失败: {ex.Message}", Severity.Error);
        }
    }

    private Color GetStatusColor(int status)
    {
        return status switch
        {
            0 => Color.Default,
            1 => Color.Warning,
            2 => Color.Info,
            3 => Color.Success,
            4 => Color.Error,
            _ => Color.Default
        };
    }

    private string GetStatusText(int status)
    {
        return status switch
        {
            0 => "未计划",
            1 => "部分",
            2 => "理论满足",
            3 => "满足",
            4 => "超量",
            _ => "未知"
        };
    }

    /// <summary>
    /// 订单级状态颜色（仅"全部满足"或"未满足"，不含理论满足）
    /// </summary>
    private Color GetOrderStatusColor(int status)
    {
        return status switch
        {
            0 => Color.Default,
            1 => Color.Warning,
            3 => Color.Success,
            _ => Color.Default
        };
    }

    private string GetOrderStatusText(int status)
    {
        return status switch
        {
            0 => "未计划",
            1 => "部分",
            3 => "全部满足",
            _ => "未知"
        };
    }
