@page "/chemical-validate/create"
@using MES.Blazor.Services
@using Microsoft.AspNetCore.Authorization
@using MES.Blazor.Shared
@using MES.Core.DTOs.ProductionStandard
@inject ChemicalValidationRuleService ChemicalValidationRuleService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject IJSRuntime JS
@inject ColumnPrefsService ColumnPrefs
@attribute [Authorize(Roles = Roles.Policies.StandardRead)]

<MudContainer MaxWidth="MaxWidth.False" Class="mt-4">
    <style>
        .edit-table td.mud-table-cell,
        .edit-table th.mud-table-cell {
            padding: 1px 4px !important;
        }
        .edit-table .mud-input-input-control {
            margin-top: 0;
        }
        .edit-table .mud-input {
            font-size: 13px;
            width: 100%;
            min-width: 0;
        }
        .edit-table th.mud-table-cell {
            white-space: nowrap;
        }
        .table-scroll {
            max-height: calc(100vh - 280px);
            overflow-y: auto;
            overflow-x: auto;
        }
    </style>

    <MudCard>
        <MudCardHeader>
            <CardHeaderContent>
                <MudText Typo="Typo.h5" Class="font-weight-bold">
                    <MudIcon Icon="@Icons.Material.Filled.AddCircleOutline" Class="mr-2" Color="Color.Primary" />
                    新建工厂牌号化分验证
                </MudText>
            </CardHeaderContent>
            <CardHeaderActions>
                <MudButton Variant="Variant.Text" Color="Color.Default" OnClick="GoBack">返回</MudButton>
            </CardHeaderActions>
        </MudCardHeader>

        <MudCardContent>
            <div id="chemical-validate-create-table">
                @if (_rows.Any())
                {
                    <div class="d-flex align-center mb-2">
                        <ColumnDisplaySelect Columns="_allColumns"
                                             OnColumnToggle="OnColumnToggle"
                                             OnMoveUp="MoveColumnUp"
                                             OnMoveDown="MoveColumnDown" />
                        <MudButton Variant="Variant.Text" Size="Size.Small"
                                   Color="Color.Default"
                                   StartIcon="@Icons.Material.Filled.RestartAlt"
                                   OnClick="ResetColumnDisplay" Class="ml-2">
                            重置
                        </MudButton>
                        <MudSpacer />
                        <MudText Typo="Typo.body2">共 @_rows.Count 行</MudText>
                        <MudButton Variant="Variant.Text" Size="Size.Small"
                                   Color="Color.Default"
                                   StartIcon="@Icons.Material.Filled.AddCircleOutline"
                                   OnClick="AddRow" Class="ml-2">
                            添加行
                        </MudButton>
                    </div>
                    <div class="table-scroll">
                        <MudTable Items="@_rows" Dense="true" Hover="true" Elevation="0" Striped="true"
                                  Class="edit-table auto-table" SortMode="SortMode.None" FixedHeader="true">
                            <HeaderContent>
                                @foreach (var col in _visibleColumns)
                                {
                                    <MudTh>
                                        @col.Label
                                        @if (col.IsRequired)
                                        {
                                            <span class="required-star">*</span>
                                        }
                                    </MudTh>
                                }
                                <MudTh Style="width:60px;">操作</MudTh>
                            </HeaderContent>
                            <RowTemplate Context="r">
                                @foreach (var col in _visibleColumns)
                                {
                                    <MudTd>@RenderCell(r, col)</MudTd>
                                }
                                <MudTd>
                                    <MudIconButton Icon="@Icons.Material.Filled.RemoveCircleOutline"
                                                   Color="Color.Error" Size="Size.Small"
                                                   Title="删除"
                                                   OnClick="() => RemoveRow(r)"
                                                   Disabled="@(_rows.Count <= 1)" />
                                </MudTd>
                            </RowTemplate>
                            <FooterContent>
                                <MudTd colspan="@(_visibleColumns.Count + 1)">
                                    <MudIconButton Icon="@Icons.Material.Filled.AddCircleOutline"
                                                   Color="Color.Primary" Size="Size.Small"
                                                   OnClick="AddRow" />
                                </MudTd>
                            </FooterContent>
                        </MudTable>
                    </div>
                }
            </div>

            @if (!string.IsNullOrEmpty(_errorMessage))
            {
                <MudText Typo="Typo.body2" Color="Color.Error" Class="mt-4">@_errorMessage</MudText>
            }

            @if (_rows.Any())
            {
                <MudGrid Class="mt-4">
                    <MudItem xs="12" Class="d-flex justify-end">
                        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.CloudUpload"
                                   OnClick="Submit" Loading="@_isSubmitting"
                                   Size="Size.Large">
                            确认提交 (@_rows.Count 条)
                        </MudButton>
                    </MudItem>
                </MudGrid>
            }
        </MudCardContent>
    </MudCard>
</MudContainer>

@code {
    private List<EditRow> _rows = new();
    private bool _isSubmitting;
    private bool _isArrowNavSetup;
    private string _errorMessage = string.Empty;

    // ========== 列定义 ==========

    private List<ColumnDef> _allColumns = new();
    private List<ColumnDef> _visibleColumns =>
        _allColumns.Where(c => c.IsApplicable && c.Visible).ToList();

    private static List<ColumnDef> GetAllColumnDefs() => new()
    {
        new() { Key = "PlantGrade",   Label = "工厂牌号", IsRequired = true },
        new() { Key = "CMin",         Label = "C-" },
        new() { Key = "CMax",         Label = "C+" },
        new() { Key = "SiMin",        Label = "Si-" },
        new() { Key = "SiMax",        Label = "Si+" },
        new() { Key = "MnMin",        Label = "Mn-" },
        new() { Key = "MnMax",        Label = "Mn+" },
        new() { Key = "PMin",         Label = "P-" },
        new() { Key = "PMax",         Label = "P+" },
        new() { Key = "SMin",         Label = "S-" },
        new() { Key = "SMax",         Label = "S+" },
        new() { Key = "NiMin",        Label = "Ni-" },
        new() { Key = "NiMax",        Label = "Ni+" },
        new() { Key = "CrMin",        Label = "Cr-" },
        new() { Key = "CrMax",        Label = "Cr+" },
        new() { Key = "MoMin",        Label = "Mo-" },
        new() { Key = "MoMax",        Label = "Mo+" },
        new() { Key = "CuMin",        Label = "Cu-" },
        new() { Key = "CuMax",        Label = "Cu+" },
        new() { Key = "NMin",         Label = "N-" },
        new() { Key = "NMax",         Label = "N+" },
        new() { Key = "NbMin",        Label = "Nb-" },
        new() { Key = "NbMax",        Label = "Nb+" },
        new() { Key = "TiMin",        Label = "Ti-" },
        new() { Key = "TiMax",        Label = "Ti+" },
        new() { Key = "FeMin",        Label = "Fe-" },
        new() { Key = "FeMax",        Label = "Fe+" },
        new() { Key = "AlMin",        Label = "Al-" },
        new() { Key = "AlMax",        Label = "Al+" },
        new() { Key = "WMin",         Label = "W-" },
        new() { Key = "WMax",         Label = "W+" },
        new() { Key = "PRENMin",      Label = "PREN腐蚀当量-" },
    };

    private async Task OnColumnToggle(ColumnDef col)
    {
        await SaveColumnPrefs();
    }

    private async Task SaveColumnPrefs()
    {
        await ColumnPrefs.SaveAsync("chemical-validate-create", null, _allColumns);
    }

    private async Task ResetColumnDisplay()
    {
        _allColumns = GetAllColumnDefs();
        await SaveColumnPrefs();
    }

    private async Task MoveColumnUp(ColumnDef col)
    {
        await SaveColumnPrefs();
    }

    private async Task MoveColumnDown(ColumnDef col)
    {
        await SaveColumnPrefs();
    }

    private class EditRow
    {
        public string PlantGrade { get; set; } = string.Empty;
        public string? CMin { get; set; }
        public string? CMax { get; set; }
        public string? SiMin { get; set; }
        public string? SiMax { get; set; }
        public string? MnMin { get; set; }
        public string? MnMax { get; set; }
        public string? PMin { get; set; }
        public string? PMax { get; set; }
        public string? SMin { get; set; }
        public string? SMax { get; set; }
        public string? NiMin { get; set; }
        public string? NiMax { get; set; }
        public string? CrMin { get; set; }
        public string? CrMax { get; set; }
        public string? MoMin { get; set; }
        public string? MoMax { get; set; }
        public string? CuMin { get; set; }
        public string? CuMax { get; set; }
        public string? NMin { get; set; }
        public string? NMax { get; set; }
        public string? NbMin { get; set; }
        public string? NbMax { get; set; }
        public string? TiMin { get; set; }
        public string? TiMax { get; set; }
        public string? FeMin { get; set; }
        public string? FeMax { get; set; }
        public string? AlMin { get; set; }
        public string? AlMax { get; set; }
        public string? WMin { get; set; }
        public string? WMax { get; set; }
        public string? PRENMin { get; set; }
    }

    protected override async Task OnInitializedAsync()
    {
        _allColumns = GetAllColumnDefs();
        var saved = await ColumnPrefs.LoadAsync("chemical-validate-create", null);
        if (saved.Count > 0)
        {
            foreach (var s in saved)
            {
                var match = _allColumns.FirstOrDefault(c => c.Key == s.Key);
                if (match != null)
                    match.Visible = s.Visible;
            }
            var reordered = new List<ColumnDef>();
            foreach (var s in saved)
            {
                var match = _allColumns.FirstOrDefault(c => c.Key == s.Key);
                if (match != null && !reordered.Contains(match))
                    reordered.Add(match);
            }
            foreach (var c in _allColumns)
            {
                if (!reordered.Contains(c))
                    reordered.Add(c);
            }
            _allColumns = reordered;
        }

        if (!_rows.Any())
        {
            _rows.Add(new EditRow());
            _rows.Add(new EditRow());
            _rows.Add(new EditRow());
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_isArrowNavSetup)
        {
            _isArrowNavSetup = true;
            if (!await JS.InvokeAsync<bool>("enableTableArrowNav", "#chemical-validate-create-table"))
                _isArrowNavSetup = false;
        }
    }

    private void AddRow()
    {
        _rows.Add(new EditRow());
    }

    private void RemoveRow(EditRow row)
    {
        if (_rows.Count <= 1) return;
        _rows.Remove(row);
    }

    private async Task Submit()
    {
        _errorMessage = string.Empty;

        var errors = new List<string>();
        for (int i = 0; i < _rows.Count; i++)
        {
            var r = _rows[i];
            if (string.IsNullOrWhiteSpace(r.PlantGrade))
                errors.Add($"第{i + 1}行：工厂牌号不能为空");
        }

        if (errors.Any())
        {
            Snackbar.Add(string.Join("；", errors), Severity.Error);
            return;
        }

        _isSubmitting = true;
        StateHasChanged();

        try
        {
            var requests = _rows.Select(r => new CreateChemicalValidationRuleRequest
            {
                PlantGrade = r.PlantGrade,
                CMin = r.CMin, CMax = r.CMax,
                SiMin = r.SiMin, SiMax = r.SiMax,
                MnMin = r.MnMin, MnMax = r.MnMax,
                PMin = r.PMin, PMax = r.PMax,
                SMin = r.SMin, SMax = r.SMax,
                NiMin = r.NiMin, NiMax = r.NiMax,
                CrMin = r.CrMin, CrMax = r.CrMax,
                MoMin = r.MoMin, MoMax = r.MoMax,
                CuMin = r.CuMin, CuMax = r.CuMax,
                NMin = r.NMin, NMax = r.NMax,
                NbMin = r.NbMin, NbMax = r.NbMax,
                TiMin = r.TiMin, TiMax = r.TiMax,
                FeMin = r.FeMin, FeMax = r.FeMax,
                AlMin = r.AlMin, AlMax = r.AlMax,
                WMin = r.WMin, WMax = r.WMax,
                PRENMin = r.PRENMin,
            }).ToList();

            var result = await ChemicalValidationRuleService.BatchCreateAsync(requests);

            if (result.Success && result.Data != null)
            {
                Snackbar.Add($"批量创建牌号验证规则成功，共{result.Data.Count}条", Severity.Success);
                Navigation.NavigateTo("/chemical-validate");
            }
            else
            {
                _errorMessage = result.Message ?? "批量创建失败";
            }
        }
        catch (Exception ex)
        {
            _errorMessage = $"网络错误: {ex.Message}";
        }
        finally
        {
            _isSubmitting = false;
            StateHasChanged();
        }
    }

    private void GoBack()
    {
        Navigation.NavigateTo("/chemical-validate");
    }

    // ========== 单元格渲染 ==========

    private RenderFragment RenderCell(EditRow r, ColumnDef col) => builder =>
    {
        switch (col.Key)
        {
            case "PlantGrade":
                builder.OpenComponent<MudTextField<string>>(0);
                builder.AddAttribute(1, "Dense", true);
                builder.AddAttribute(2, "Variant", Variant.Outlined);
                builder.AddAttribute(3, "Size", Size.Small);
                builder.AddAttribute(4, "Value", r.PlantGrade);
                builder.AddAttribute(5, "ValueChanged", EventCallback.Factory.Create<string>(this, v => r.PlantGrade = v ?? ""));
                builder.CloseComponent();
                break;
            case "CMin":         RenderInputField(builder, r.CMin, v => r.CMin = v); break;
            case "CMax":         RenderInputField(builder, r.CMax, v => r.CMax = v); break;
            case "SiMin":        RenderInputField(builder, r.SiMin, v => r.SiMin = v); break;
            case "SiMax":        RenderInputField(builder, r.SiMax, v => r.SiMax = v); break;
            case "MnMin":        RenderInputField(builder, r.MnMin, v => r.MnMin = v); break;
            case "MnMax":        RenderInputField(builder, r.MnMax, v => r.MnMax = v); break;
            case "PMin":         RenderInputField(builder, r.PMin, v => r.PMin = v); break;
            case "PMax":         RenderInputField(builder, r.PMax, v => r.PMax = v); break;
            case "SMin":         RenderInputField(builder, r.SMin, v => r.SMin = v); break;
            case "SMax":         RenderInputField(builder, r.SMax, v => r.SMax = v); break;
            case "NiMin":        RenderInputField(builder, r.NiMin, v => r.NiMin = v); break;
            case "NiMax":        RenderInputField(builder, r.NiMax, v => r.NiMax = v); break;
            case "CrMin":        RenderInputField(builder, r.CrMin, v => r.CrMin = v); break;
            case "CrMax":        RenderInputField(builder, r.CrMax, v => r.CrMax = v); break;
            case "MoMin":        RenderInputField(builder, r.MoMin, v => r.MoMin = v); break;
            case "MoMax":        RenderInputField(builder, r.MoMax, v => r.MoMax = v); break;
            case "CuMin":        RenderInputField(builder, r.CuMin, v => r.CuMin = v); break;
            case "CuMax":        RenderInputField(builder, r.CuMax, v => r.CuMax = v); break;
            case "NMin":         RenderInputField(builder, r.NMin, v => r.NMin = v); break;
            case "NMax":         RenderInputField(builder, r.NMax, v => r.NMax = v); break;
            case "NbMin":        RenderInputField(builder, r.NbMin, v => r.NbMin = v); break;
            case "NbMax":        RenderInputField(builder, r.NbMax, v => r.NbMax = v); break;
            case "TiMin":        RenderInputField(builder, r.TiMin, v => r.TiMin = v); break;
            case "TiMax":        RenderInputField(builder, r.TiMax, v => r.TiMax = v); break;
            case "FeMin":        RenderInputField(builder, r.FeMin, v => r.FeMin = v); break;
            case "FeMax":        RenderInputField(builder, r.FeMax, v => r.FeMax = v); break;
            case "AlMin":        RenderInputField(builder, r.AlMin, v => r.AlMin = v); break;
            case "AlMax":        RenderInputField(builder, r.AlMax, v => r.AlMax = v); break;
            case "WMin":         RenderInputField(builder, r.WMin, v => r.WMin = v); break;
            case "WMax":         RenderInputField(builder, r.WMax, v => r.WMax = v); break;
            case "PRENMin":      RenderInputField(builder, r.PRENMin, v => r.PRENMin = v); break;
            default:
                builder.AddContent(0, "");
                break;
        }
    };

    private void RenderInputField(Microsoft.AspNetCore.Components.Rendering.RenderTreeBuilder builder, string? value, Action<string?> setter)
    {
        builder.OpenComponent<MudTextField<string>>(0);
        builder.AddAttribute(1, "Dense", true);
        builder.AddAttribute(2, "Variant", Variant.Outlined);
        builder.AddAttribute(3, "Size", Size.Small);
        builder.AddAttribute(4, "Value", value);
        builder.AddAttribute(5, "ValueChanged", EventCallback.Factory.Create<string?>(this, setter));
        builder.CloseComponent();
    }
}
