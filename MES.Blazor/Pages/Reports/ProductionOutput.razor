@page "/reports/production-output"
@attribute [Authorize(Roles = $"{Roles.Staffs.Batch},{Roles.Directors.Batch},{Roles.Admin}")]
@using System.Text.Json
@inject ReportService ReportService
@inject ISnackbar Snackbar
@inject ColumnPrefsService ColumnPrefs
@inject IJSRuntime JS
@inject HttpClient Http

<MudContainer MaxWidth="MaxWidth.False" Class="mt-4 pl-0">
    <MudText Typo="Typo.h5" Class="mb-4 font-weight-bold">
        <MudIcon Icon="@Icons.Material.Filled.Assessment" Class="mr-2" Color="Color.Primary" />
        产量报表
    </MudText>

    <!-- 搜索栏 -->
    <MudPaper Class="pa-3 mb-4" Elevation="0">
        <MudGrid>
            <MudItem xs="12" md="3">
                <MudTextField T="string"
                              Label="日期从"
                              @bind-Value="_dateFrom"
                              Immediate="true" DebounceInterval="500"
                              Placeholder="yyyy-MM-dd" />
            </MudItem>
            <MudItem xs="12" md="3">
                <MudTextField T="string"
                              Label="日期至"
                              @bind-Value="_dateTo"
                              Immediate="true" DebounceInterval="500"
                              Placeholder="yyyy-MM-dd" />
            </MudItem>
            <MudItem xs="12" md="3" Class="d-flex align-center">
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           OnClick="LoadDataAsync"
                           Disabled="_loading"
                           StartIcon="@Icons.Material.Filled.Search">
                    查询
                </MudButton>
                <MudButton Variant="Variant.Text"
                           Color="Color.Default"
                           OnClick="SetThisMonth"
                           Class="ml-2"
                           Size="Size.Small">
                    本月
                </MudButton>
                <MudButton Variant="Variant.Text"
                           Color="Color.Default"
                           OnClick="SetLastMonth"
                           Class="ml-2"
                           Size="Size.Small">
                    上月
                </MudButton>
            </MudItem>
        </MudGrid>
    </MudPaper>

    @if (_loading)
    {
        <MudPaper Class="pa-8 text-center" Elevation="0">
            <MudProgressCircular Indeterminate="true" />
            <MudText Class="mt-4">加载中...</MudText>
        </MudPaper>
    }
    else if (_hasSearched)
    {
        <div id="production-output-list-table">
            <!-- 工具栏 -->
            <div class="list-toolbar">
                <div class="d-flex align-center">
                    <ColumnDisplaySelect Columns="_allColumns"
                                         OnColumnToggle="OnColumnToggle"
                                         OnMoveUp="OnMoveUp"
                                         OnMoveDown="OnMoveDown" />
                    <MudButton Variant="Variant.Text" Size="Size.Small"
                               Color="Color.Default"
                               StartIcon="@Icons.Material.Filled.RestartAlt"
                               OnClick="ResetColumnDisplay" Class="ml-2">
                        重置
                    </MudButton>
                </div>
                <div class="d-flex align-center" style="margin-left:auto;">
                    <MudButton Variant="Variant.Outlined"
                               Size="Size.Small"
                               Color="Color.Info"
                               StartIcon="@Icons.Material.Filled.Print"
                               OnClick="PrintReport">
                        打印
                    </MudButton>
                    <MudText Typo="Typo.body2" Class="ml-4">
                        共 @(_rows.Count) 条记录
                    </MudText>
                </div>
            </div>

            @if (_rows.Count > 0)
            {
                <!-- 表格 -->
                <MudTable Items="@_rows"
                          Dense="true"
                          Hover="true"
                          Elevation="0"
                          Class="mt-0 auto-table compact-table"
                          Height="calc(100vh - 320px)">
                    <HeaderContent>
                        <MudTh Class="report-th report-th-date" Style="width:110px;min-width:110px;">日期</MudTh>
                        @foreach (var col in _cachedVisibleColumns)
                        {
                            <MudTh Class="report-th" Style="@($"width:{col.Width}px;min-width:{col.Width}px;text-align:left;")">@col.Label</MudTh>
                        }
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="日期"
                               Class="report-td-date font-weight-bold"
                               Style="width:110px;min-width:110px;">
                            @context.DisplayDate
                        </MudTd>
                        @foreach (var col in _cachedVisibleColumns)
                        {
                            var hasValue = context.Values.TryGetValue(col.Key, out var weight);
                            <MudTd DataLabel="@col.Label"
                                   Class="report-td"
                                   Style="@($"width:{col.Width}px;min-width:{col.Width}px;text-align:left;")">
                                @if (hasValue && weight > 0)
                                {
                                    <span>@(((int)weight).ToString())</span>
                                }
                                else
                                {
                                    <span class="text-muted">-</span>
                                }
                            </MudTd>
                        }
                    </RowTemplate>
                    <FooterContent>
                        @if (_summaryRow != null)
                        {
                            <MudTd DataLabel="日期"
                                   Class="report-footer-date"
                                   Style="width:110px;min-width:110px;">
                                @_summaryRow.DisplayDate
                            </MudTd>
                            @foreach (var col in _cachedVisibleColumns)
                            {
                                var hasValue = _summaryRow.Values.TryGetValue(col.Key, out var weight);
                                <MudTd DataLabel="@col.Label"
                                       Class="report-footer-cell"
                                       Style="@($"width:{col.Width}px;min-width:{col.Width}px;text-align:left;")">
                                    @if (hasValue && weight > 0)
                                    {
                                        <span>@(((int)weight).ToString())</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </MudTd>
                            }
                        }
                    </FooterContent>
                </MudTable>
            }
            else
            {
                <MudPaper Class="pa-8 text-center" Elevation="0">
                    <MudText>选定日期范围内暂无数据</MudText>
                </MudPaper>
            }
        </div>
    }
</MudContainer>

<style>
    .report-table {
        font-size: 0.8rem;
    }
    .report-th {
        font-weight: 600;
        background-color: #f5f5f5;
        text-align: center;
        white-space: nowrap;
    }
    .report-th-date {
        position: sticky;
        left: 0;
        z-index: 2;
        background-color: #f5f5f5;
    }
    .report-td-date {
        position: sticky;
        left: 0;
        z-index: 1;
        background-color: white;
        white-space: nowrap;
    }
    .report-td {
        text-align: left;
        white-space: nowrap;
    }
    .text-muted {
        color: #bbb;
    }
    /* 固定列宽模式：所有列宽由表头严格决定，表体/表脚自动对齐 */
    #production-output-list-table table {
        table-layout: fixed !important;
        width: 100%;
    }
    /* CSS sticky 表头 — 替代 MudTable FixedHeader（后者会拆分表格导致表脚错位） */
    #production-output-list-table .mud-table-container {
        max-height: calc(100vh - 320px);
        overflow-y: auto;
    }
    #production-output-list-table .mud-table-head {
        position: sticky;
        top: 0;
        z-index: 10;
    }
    /* 汇总行的样式 — 效果等同原 col-footer-cell */
    .report-footer-date {
        border-top: 2px solid #BDBDBD !important;
        font-weight: 600 !important;
        background: #FAFAFA !important;
        white-space: nowrap;
    }
    .report-footer-cell {
        border-top: 2px solid #BDBDBD !important;
        font-weight: 600 !important;
        background: #FAFAFA !important;
        text-align: left;
        white-space: nowrap;
    }
    /* 统一对齐：覆盖 app.css 中 .auto-table th 和 .compact-table tbody 的强制左对齐 */
    #production-output-list-table .mud-table-cell {
        text-align: left !important;
    }
    /* 日期列表头居中 */
    #production-output-list-table .report-th-date {
        text-align: center !important;
    }
    /* 日期列表体居左 */
    #production-output-list-table .report-td-date {
        text-align: left !important;
    }
    /* 汇总行日期居中 */
    #production-output-list-table .report-footer-date {
        text-align: center !important;
    }
</style>
