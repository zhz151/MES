                                    <MudButton Variant="Variant.Text" Size="Size.Small" Color="Color.Primary"
                                               StartIcon="@Icons.Material.Filled.Print"
                                               OnClick="@(() => PrintTableAsync("#report-supplier-trade", "物料执行-供应商往来数据", "report:supplier-trade"))"
                                               Disabled="@(!_supplierTradeRows.Any())">打印</MudButton>
                                </div>
                            </div>
                            @if (!IsCardCollapsed("report:supplier-trade"))
                            {
                                var supplierRows = SupplierTradeShown();
                                @* 工具栏：外层 gap 16px 作为「组间隔离」，组内 gap 6px 紧凑（参照「客户往来数据」/「投料产出总况」日期范围组合） *@
