@page "/reports/overview"
@using MES.Blazor.Helpers
@using MES.Blazor.Pages.Scheduling
@attribute [Authorize(Roles = Roles.Policies.ReportView)]
@inject NavigationManager Navigation

<MudContainer MaxWidth="MaxWidth.False" Class="mt-4 pl-0">
    <div class="d-flex align-center mb-4">
        <MudText Typo="Typo.h5" Class="font-weight-bold">
            <MudIcon Icon="@Icons.Material.Filled.Assessment" Class="mr-2" Color="Color.Primary" />
            报表总览
        </MudText>
        <div class="ml-auto">
            <MudButton Variant="Variant.Text" Size="Size.Small" Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Refresh" OnClick="RefreshAllAsync">
                全部刷新
            </MudButton>
        </div>
    </div>

    <MudTabs Position="Position.Top" ActivePanelIndex="_activeIndex" ActivePanelIndexChanged="OnActivePanelIndexChanged">

        @* ========== Tab1 业务总况：订单接单·出库及现负荷汇总 ========== *@
        <MudTabPanel Text="业务总况" Icon="@Icons.Material.Filled.ShowChart">
            <div class="pa-2">
                @if (_loading[0])
                {
                    <div class="d-flex align-center" style="gap:8px;">
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                        <span>业务总况加载中...</span>
                    </div>
                }
                else if (_failed[0])
                {
                    <MudAlert Severity="Severity.Error">@_errorMessages[0]</MudAlert>
                }
                else
                {

                    <MudCard Class="mb-2 summary-card" Elevation="0">
                        <MudCardContent>
                        <div class="d-flex align-center mb-2">
                            <MudIconButton Icon="@(IsCardCollapsed("report:inout-summary") ? Icons.Material.Filled.ExpandMore : Icons.Material.Filled.ExpandLess)"
                                           Size="Size.Small" Color="@(IsCardCollapsed("report:inout-summary") ? Color.Default : Color.Primary)"
                                           OnClick="@(() => ToggleCardAsync("report:inout-summary"))" Title="展开/折叠" />
                            <MudText Typo="Typo.subtitle2" Class="ml-1"><span class="report-tt report-tt-2">订单接单·出库及现负荷汇总</span></MudText>
                            <MudText Typo="Typo.caption" Class="text-hint ml-2">重量：吨(t)（源 kg）；金额：万元（按订单项次计价、结算分治口径折算，取整）｜汇总列=本年 12 个月合计；成品库存与订单负荷量为当前时点存量，见表下「当前负荷快照」</MudText>
                            <div class="ml-auto">
                                <MudButton Variant="Variant.Text" Size="Size.Small" Color="Color.Primary"
                                           StartIcon="@Icons.Material.Filled.Print"
                                           OnClick="@(() => PrintTableAsync("#report-inout-summary-table", "业务总况-订单接单出库及现负荷汇总", "report:inout-summary"))"
                                           Disabled="@(_inOutSummary == null)">
                                    打印
                                </MudButton>
                            </div>
                        </div>
                        @if (!IsCardCollapsed("report:inout-summary"))
                        {
                        @if (_inOutSummary == null)
                        {
                            <MudText Typo="Typo.body2" Class="text-hint">正在加载...</MudText>
                        }
                        else
                        {
                            <div id="report-inout-summary-table">
                            @* 流量矩阵：接单量 / 出库量（按签订月 / 出库月分月），末列为本年 12 个月合计 *@
                            <table style="border-collapse: collapse; width: 100%; font-size: 0.8125rem;">
                                <thead>
                                    <tr>
                                        <th style="padding:4px 10px; background:#f5f5f5; border:1px solid #e0e0e0; text-align:center;">指标</th>
                                        @for (var m = 0; m < 12; m++)
                                        {
                                            <th style="padding:4px 10px; background:#f5f5f5; border:1px solid #e0e0e0; text-align:center;">@_inOutSummary.MonthLabels[m]</th>
                                        }
                                        <th style="padding:4px 10px; background:#e8f0fe; border:1px solid #e0e0e0; text-align:center;">汇总</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td style="padding:4px 10px; border:1px solid #e0e0e0; text-align:center; font-weight:600;">接单量</td>
                                        @for (var m = 0; m < 12; m++)
                                        {
                                            <td style="padding:4px 10px; border:1px solid #e0e0e0; text-align:center;">@OrderOverviewFormatter.RenderInOutCell(_inOutSummary.OrderWeightByMonth[m], _inOutSummary.OrderAmountByMonth[m])</td>
                                        }
                                        <td style="padding:4px 10px; border:1px solid #e0e0e0; text-align:center; background:#fafcff;">@RenderYearTotalCell(_inOutSummary.OrderWeightByMonth, _inOutSummary.OrderAmountByMonth)</td>
                                    </tr>
                                    <tr>
                                        <td style="padding:4px 10px; border:1px solid #e0e0e0; text-align:center; font-weight:600;">出库量</td>
                                        @for (var m = 0; m < 12; m++)
                                        {
                                            <td style="padding:4px 10px; border:1px solid #e0e0e0; text-align:center;">@OrderOverviewFormatter.RenderInOutCell(_inOutSummary.OutboundWeightByMonth[m], _inOutSummary.OutboundAmountByMonth[m])</td>
                                        }
                                        <td style="padding:4px 10px; border:1px solid #e0e0e0; text-align:center; background:#fafcff;">@RenderYearTotalCell(_inOutSummary.OutboundWeightByMonth, _inOutSummary.OutboundAmountByMonth)</td>
                                    </tr>
                                </tbody>
                            </table>

                            @* 当前负荷快照：存量指标（当前时点，非按月），与上方分月流量矩阵分离 *@
                            <div class="mt-3">
                                <MudText Typo="Typo.body2" Class="mb-1"><b>当前负荷快照</b></MudText>
                                <MudText Typo="Typo.caption" Class="text-hint mb-1">当前时点存量（非按月，系统无订单级历史库存快照）</MudText>
                                <div style="overflow-x:auto;">
                                    <table style="border-collapse: collapse; width: 100%; font-size: 0.8125rem;">
                                        <thead>
                                            <tr>
                                                <th style="padding:4px 10px; background:#f5f5f5; border:1px solid #e0e0e0; text-align:center;">指标</th>
                                                <th style="padding:4px 10px; background:#f5f5f5; border:1px solid #e0e0e0; text-align:center;">当前值</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <tr>
                                                <td style="padding:4px 10px; border:1px solid #e0e0e0; text-align:center; font-weight:600;">成品库存(完工)</td>
                                                <td style="padding:4px 10px; border:1px solid #e0e0e0; text-align:center;">@OrderOverviewFormatter.RenderInOutCell(_inOutSummary.FinishedStockCompleted, _inOutSummary.FinishedStockCompletedAmount)</td>
                                            </tr>
                                            <tr>
                                                <td style="padding:4px 10px; border:1px solid #e0e0e0; text-align:center; font-weight:600;">成品库存(未完工)</td>
                                                <td style="padding:4px 10px; border:1px solid #e0e0e0; text-align:center;">@OrderOverviewFormatter.RenderInOutCell(_inOutSummary.FinishedStockUncompleted, _inOutSummary.FinishedStockUncompletedAmount)</td>
                                            </tr>
                                            <tr>
                                                <td style="padding:4px 10px; border:1px solid #e0e0e0; text-align:center; font-weight:600;">订单负荷量(实时)</td>
                                                <td style="padding:4px 10px; border:1px solid #e0e0e0; text-align:center;">@OrderOverviewFormatter.RenderInOutCell(_inOutSummary.TurnoverTotal, _inOutSummary.TurnoverAmount)</td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                            </div>

                            @* 两小表（订单交期预估：订单完成预估 / 延期交货订单预估），直接属于「订单接单·出库及现负荷汇总」表 *@
                            @if (_deliveryEstimate != null)
                            {
                                @for (var i = 0; i < _deliveryEstimate.Tables.Count; i++)
                                {
                                    var table = _deliveryEstimate.Tables[i];
                                    var tableId = $"report-delivery-estimate-{i}";
                                    <div class="mt-3">
                                        <div class="d-flex justify-space-between align-center mb-1">
                                            <MudText Typo="Typo.body2"><b>@table.Name</b></MudText>
                                            <MudButton Variant="Variant.Text" Size="Size.Small" Color="Color.Primary"
                                                       StartIcon="@Icons.Material.Filled.Print"
                                                       OnClick="@(() => PrintTableAsync("#" + tableId, "业务总况-" + table.Name))">
                                                打印
                                            </MudButton>
                                        </div>
                                        <div id="@tableId" style="overflow-x:auto;">
                                        <table style="border-collapse: collapse; width: 100%; font-size: 0.8125rem;">
                                            <thead>
                                                <tr>
                                                    <th style="text-align:left; padding:4px 10px; background:#f5f5f5; border:1px solid #e0e0e0;">交货日期范围</th>
                                                    @foreach (var label in table.BucketLabels)
                                                    {
                                                        <th style="padding:4px 10px; background:#f5f5f5; border:1px solid #e0e0e0; text-align:center;">@label</th>
                                                    }
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <tr>
                                                    <td style="padding:4px 10px; border:1px solid #e0e0e0; font-weight:600;">单数/重量/金额</td>
                                                    @foreach (var bucket in table.Buckets)
                                                    {
                                                        <td style="padding:4px 10px; border:1px solid #e0e0e0; text-align:center;">@OrderOverviewFormatter.RenderEstimateCell(bucket.Count, bucket.Weight, bucket.Amount)</td>
                                                    }
                                                </tr>
                                            </tbody>
                                        </table>
                                        </div>
                                    </div>
                                }
                                <MudText Typo="Typo.caption" Class="text-hint">
                                    注：单元格 = 单数(蓝)/重量吨(绿)/金额万元(橙)，均取整显示。金额 = 桶内订单项次计价总价合计（未计价订单计 0）。
                                </MudText>
                            }
                        }
                        }
                        </MudCardContent>
                    </MudCard>

                    @* 投料产出总况（2026-09-14 新增：同源订单列表页卡片；行=订单完成月，口径可切换生产类型范围；默认折叠） *@
                    <MudCard Class="mb-2 summary-card" Elevation="0">
                        <MudCardContent>
                            <div class="d-flex align-center mb-2">
                                <MudIconButton Icon="@(IsCardCollapsed("report:throughput") ? Icons.Material.Filled.ExpandMore : Icons.Material.Filled.ExpandLess)"
                                               Size="Size.Small" Color="@(IsCardCollapsed("report:throughput") ? Color.Default : Color.Primary)"
                                               OnClick="@(() => ToggleCardAsync("report:throughput"))" Title="展开/折叠" />
                                <MudText Typo="Typo.subtitle2" Class="ml-1"><span class="report-tt report-tt-3">投料产出总况</span></MudText>
                                <MudText Typo="Typo.caption" Class="text-hint ml-2">@ThroughputRangeCaption()</MudText>
                                <div class="ml-auto">
                                    <MudButton Variant="Variant.Text" Size="Size.Small" Color="Color.Primary"
                                               StartIcon="@Icons.Material.Filled.Print"
                                               OnClick="@(() => PrintTableAsync("#report-throughput-table", $"投料产出总况（{ThroughputScopeLabel(_throughputScope)}）", "report:throughput"))"
                                               Disabled="@(_throughput == null)">
                                        打印
                                    </MudButton>
                                </div>
                            </div>
                            @if (!IsCardCollapsed("report:throughput"))
                            {
                                <div class="d-flex align-center flex-wrap mb-2" style="gap: 12px;">
                                    <MudSelect T="string" Value="_throughputScope" ValueChanged="OnThroughputScopeChangedAsync"
                                               Label="生产类型范围" Dense="true" Variant="Variant.Outlined" Margin="Margin.Dense"
                                               Style="min-width: 260px;">
                                        @foreach (var opt in _throughputScopeOptions)
                                        {
                                            <MudSelectItem T="string" Value="@opt.Key">@opt.Label</MudSelectItem>
                                        }
                                    </MudSelect>
                                    <MudSpacer />
                                    @* 完成日期范围：2 输入框 + 应用 + 清除 为一个整体，靠右紧凑排列 *@
                                    <div class="d-flex align-center" style="gap:8px;">
                                        <MudTextField T="string" @bind-Value="_throughputDateFrom" Immediate="true" Placeholder="yyyy-MM-dd"
                                                      Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense"
                                                      Style="width:140px" Label="完成日期起" />
                                        <MudTextField T="string" @bind-Value="_throughputDateTo" Immediate="true" Placeholder="yyyy-MM-dd"
                                                      Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense"
                                                      Style="width:140px" Label="完成日期止" />
                                        <MudButton Variant="Variant.Text" Size="Size.Small" Color="Color.Primary"
                                                   OnClick="ApplyThroughputRangeAsync">
                                            应用
                                        </MudButton>
                                        <MudButton Variant="Variant.Text" Size="Size.Small" Disabled="@(!_throughputRangeMode)"
                                                   OnClick="ClearThroughputRangeAsync">
                                            清除
                                        </MudButton>
                                    </div>
                                </div>
                                @if (_throughput == null)
                                {
                                    <MudText Typo="Typo.body2" Class="text-hint">暂无数据</MudText>
                                }
                                else
                                {
                                    var throughputRows = _throughputRows;
                                    <div id="report-throughput-table" style="overflow-x:auto;">
                                        <table style="border-collapse: collapse; width: 100%; font-size: 0.8125rem;">
                                            <thead>
                                                <tr>
                                                    @foreach (var header in new[] { _throughputRangeMode ? "选定范围" : "完成月", "订单数", "生产投料", "订单成品入库", "余库料入库", "次品入库", "备料成品", "投料产出率", "产出成品比", "退货" })
                                                    {
                                                        <th style="padding:4px 10px; background:#f5f5f5; border:1px solid #e0e0e0; text-align:center; white-space:nowrap;">@header</th>
                                                    }
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @if (throughputRows.Count == 0)
                                                {
                                                    <tr>
                                                        <td colspan="10" style="padding:6px 10px; border:1px solid #e0e0e0; text-align:center;">
                                                            @(_throughputRangeMode ? "该日期区间内暂无完成订单" : "近 12 个月暂无完成订单")
                                                        </td>
                                                    </tr>
                                                }
                                                else
                                                {
                                                    @foreach (var row in throughputRows)
                                                    {
                                                        <tr>
                                                            <td style="padding:4px 10px; border:1px solid #e0e0e0; text-align:center; font-weight:600; white-space:nowrap;">@row.Month</td>
                                                            <td style="padding:4px 10px; border:1px solid #e0e0e0; text-align:center;">@row.OrderCount</td>
                                                            <td style="padding:4px 10px; border:1px solid #e0e0e0; text-align:center;">@FormatThroughputWeight(row.InputWeight)</td>
                                                            <td style="padding:4px 10px; border:1px solid #e0e0e0; text-align:center;">@FormatThroughputWeight(row.OrderFinishedWeight)</td>
                                                            <td style="padding:4px 10px; border:1px solid #e0e0e0; text-align:center;">@FormatThroughputWeight(row.SurplusWeight)</td>
                                                            <td style="padding:4px 10px; border:1px solid #e0e0e0; text-align:center;">@FormatThroughputWeight(row.DefectWeight)</td>
                                                            <td style="padding:4px 10px; border:1px solid #e0e0e0; text-align:center;">@FormatThroughputWeight(row.PreparedWeight)</td>
                                                            <td style="padding:4px 10px; border:1px solid #e0e0e0; text-align:center; font-weight:600;">@FormatThroughputRate(row.InputOutputRate)</td>
                                                            <td style="padding:4px 10px; border:1px solid #e0e0e0; text-align:center; font-weight:600;">@FormatThroughputRate(row.FinishedOutputRate)</td>
                                                            <td style="padding:4px 10px; border:1px solid #e0e0e0; text-align:center;">@FormatThroughputWeight(row.ReturnWeight)</td>
                                                        </tr>
                                                    }
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                    <MudText Typo="Typo.caption" Class="text-hint">
                                        @ThroughputFootnote()
                                    </MudText>
                                }
                            }
                        </MudCardContent>
                    </MudCard>
                    @* 客户往来数据（同源客户管理列表：默认折叠；展开显 10 行可切换；身份列点击排序 + 搜索；合计按显示行） *@
                    <MudCard Class="mb-2 summary-card" Elevation="0">
                        <MudCardContent>
                            <div class="d-flex align-center mb-2">
                                <MudIconButton Icon="@(IsCardCollapsed("report:customer-trade") ? Icons.Material.Filled.ExpandMore : Icons.Material.Filled.ExpandLess)"
                                               Size="Size.Small" Color="@(IsCardCollapsed("report:customer-trade") ? Color.Default : Color.Primary)"
                                               OnClick="@(() => ToggleCardAsync("report:customer-trade"))" Title="展开/折叠" />
                                <MudText Typo="Typo.subtitle2" Class="ml-1"><span class="report-tt report-tt-1">客户往来数据</span></MudText>
                                <MudText Typo="Typo.caption" Class="text-hint ml-2">同源「客户管理」列表｜单数(蓝)/吨(绿)/万元(橙) 取整，0 省略</MudText>
                                <div class="ml-auto">
                                    <MudButton Variant="Variant.Text" Size="Size.Small" Color="Color.Primary"
                                               StartIcon="@Icons.Material.Filled.Print"
                                               OnClick="@(() => PrintTableAsync("#report-customer-trade", "业务总况-客户往来数据", "report:customer-trade"))"
                                               Disabled="@(!_customerTradeRows.Any())">打印</MudButton>
                                </div>
                            </div>
                            @if (!IsCardCollapsed("report:customer-trade"))
                            {
                                var customerRows = CustomerTradeShown();
                                @* 工具栏：外层 gap 16px 作为「组间隔离」，组内 gap 6px 紧凑（参照「投料产出总况」日期范围组合） *@
                                <div class="d-flex align-center mb-2" style="gap:16px; flex-wrap:wrap;">
                                    <MudTextField T="string" @bind-Value="_customerTradeKeyword" Immediate="true" Variant="Variant.Outlined"
                                                  Dense="true" Margin="Margin.Dense" Style="width:220px" Label="搜索业务员/最终用户" />
                                    @* 接单日期区间（2026-09-14）：任一端填写即「区间接单」生效；起/止/应用/清除 = 一个整体 *@
                                    <div class="d-flex align-center" style="gap:6px;">
                                        <MudTextField T="string" @bind-Value="_customerTradeSignFrom" Immediate="true" Variant="Variant.Outlined"
                                                      Dense="true" Margin="Margin.Dense" Style="width:140px" Label="接单日期起"
                                                      Placeholder="yyyy-MM-dd" />
                                        <MudTextField T="string" @bind-Value="_customerTradeSignTo" Immediate="true" Variant="Variant.Outlined"
                                                      Dense="true" Margin="Margin.Dense" Style="width:140px" Label="接单日期止"
                                                      Placeholder="yyyy-MM-dd" />
                                        <MudButton Variant="Variant.Outlined" Size="Size.Small" Color="Color.Primary"
                                                   OnClick="OnCustomerTradeSignChangedAsync">应用接单区间</MudButton>
                                        <MudButton Variant="Variant.Text" Size="Size.Small"
                                                   OnClick="@(() => { _customerTradeSignFrom = ""; _customerTradeSignTo = ""; return OnCustomerTradeSignChangedAsync(); })"
                                                   Disabled="@(!CustomerTradeSignRangeMode)">清除</MudButton>
                                    </div>
                                    <MudDivider Vertical="true" FlexItem="true" Style="height:28px;" />
                                    @* 发货日期区间（2026-09-14）：与接单区间互相独立、可叠加；起/止/应用/清除 = 一个整体 *@
                                    <div class="d-flex align-center" style="gap:6px;">
                                        <MudTextField T="string" @bind-Value="_customerTradeShipFrom" Immediate="true" Variant="Variant.Outlined"
                                                      Dense="true" Margin="Margin.Dense" Style="width:140px" Label="发货日期起"
                                                      Placeholder="yyyy-MM-dd" />
                                        <MudTextField T="string" @bind-Value="_customerTradeShipTo" Immediate="true" Variant="Variant.Outlined"
                                                      Dense="true" Margin="Margin.Dense" Style="width:140px" Label="发货日期止"
                                                      Placeholder="yyyy-MM-dd" />
                                        <MudButton Variant="Variant.Outlined" Size="Size.Small" Color="Color.Primary"
                                                   OnClick="OnCustomerTradeShipChangedAsync">应用发货区间</MudButton>
                                        <MudButton Variant="Variant.Text" Size="Size.Small"
                                                   OnClick="@(() => { _customerTradeShipFrom = ""; _customerTradeShipTo = ""; return OnCustomerTradeShipChangedAsync(); })"
                                                   Disabled="@(!CustomerTradeShipRangeMode)">清除</MudButton>
                                    </div>
                                    @* 显示行数 + 计数注释 = 一个整体 *@
                                    <div class="d-flex align-center" style="gap:6px;">
                                        <MudSelect T="int" @bind-Value="_customerTradeTake" Dense="true" Variant="Variant.Outlined"
                                                   Margin="Margin.Dense" Style="width:110px" Label="显示行数">
                                            <MudSelectItem T="int" Value="10">10 行</MudSelectItem>
                                            <MudSelectItem T="int" Value="20">20 行</MudSelectItem>
                                            <MudSelectItem T="int" Value="50">50 行</MudSelectItem>
                                            <MudSelectItem T="int" Value="0">全部</MudSelectItem>
                                        </MudSelect>
                                        <MudText Typo="Typo.caption" Class="text-hint">显示 @customerRows.Count / 共 @CustomerTradeVisible().Count 条｜合计按显示行计</MudText>
                                    </div>
                                    @if (CustomerTradeAnyRangeMode)
                                    {
                                        <MudButton Variant="Variant.Text" Size="Size.Small"
                                                   OnClick="ClearCustomerTradeRangeAsync">清空全部区间</MudButton>
                                    }
                                </div>
                                @if (CustomerTradeAnyRangeMode)
                                {
                                    <MudText Typo="Typo.caption" Class="text-hint mb-2">
                                        @CustomerTradeRangeHint()
                                    </MudText>
                                }
                                @if (customerRows.Count == 0)
                                {
                                    <MudText Typo="Typo.body2" Class="text-hint">暂无客户往来数据</MudText>
                                }
                                else
                                {
                                    <div id="report-customer-trade" style="overflow-x:auto; max-height:50vh; overflow-y:auto;">
                                        <table style="border-collapse: collapse; width: 100%; font-size: 0.8125rem;">
                                            <thead>
                                                <tr>
                                                    <th class="report-th-sort@(CustomerTradeSortedClass("salesman"))" @onclick="@(() => SortCustomerTrade("salesman"))" title="点击排序">业务员</th>
                                                    <th class="report-th-sort@(CustomerTradeSortedClass("endcustomer"))" @onclick="@(() => SortCustomerTrade("endcustomer"))" title="点击排序">最终用户</th>
                                                    <th style="padding:4px 10px; background:#f5f5f5; border:1px solid #e0e0e0; text-align:center;">累计接单</th>
                                                    <th style="padding:4px 10px; background:#f5f5f5; border:1px solid #e0e0e0; text-align:center;">@CustomerTradeHeader("YearOrder")</th>
                                                    <th style="padding:4px 10px; background:#f5f5f5; border:1px solid #e0e0e0; text-align:center;">@CustomerTradeHeader("ShippedDone")</th>
                                                    <th style="padding:4px 10px; background:#f5f5f5; border:1px solid #e0e0e0; text-align:center;">@CustomerTradeHeader("ShippedOther")</th>
                                                    @* 表头分组强调色（2026-09-14）：待发货=暖橙 / 待在产=冷紫，与源列表页 Customers.razor 同源 *@
                                                    <th style="padding:4px 10px; background:#fff3e0; color:#E65100; border:1px solid #e0e0e0; border-bottom:2px solid #ffb74d; text-align:center; font-weight:700;">待发货(整单)</th>
                                                    <th style="padding:4px 10px; background:#fff3e0; color:#E65100; border:1px solid #e0e0e0; border-bottom:2px solid #ffb74d; text-align:center; font-weight:700;">待发货(非整单)</th>
                                                    <th style="padding:4px 10px; background:#f3e5f5; color:#6A1B9A; border:1px solid #e0e0e0; border-bottom:2px solid #ce93d8; text-align:center; font-weight:700;">待在产(整单未入库)</th>
                                                    <th style="padding:4px 10px; background:#f3e5f5; color:#6A1B9A; border:1px solid #e0e0e0; border-bottom:2px solid #ce93d8; text-align:center; font-weight:700;">待在产(扣除部分入库)</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var r in customerRows)
                                                {
                                                    <tr>
                                                        <td style="padding:4px 10px; border:1px solid #e0e0e0;">@r.Salesman</td>
                                                        <td style="padding:4px 10px; border:1px solid #e0e0e0;">@r.EndCustomer</td>
                                                        <td style="padding:4px 10px; border:1px solid #e0e0e0; text-align:center;">@CustomerTradeCell(r, "TotalOrder")</td>
                                                        <td style="padding:4px 10px; border:1px solid #e0e0e0; text-align:center;">@CustomerTradeCell(r, "YearOrder")</td>
                                                        <td style="padding:4px 10px; border:1px solid #e0e0e0; text-align:center;">@CustomerTradeCell(r, "ShippedDone")</td>
                                                        <td style="padding:4px 10px; border:1px solid #e0e0e0; text-align:center;">@CustomerTradeCell(r, "ShippedOther")</td>
                                                        <td style="padding:4px 10px; border:1px solid #e0e0e0; text-align:center;">@CustomerTradeCell(r, "StockDone")</td>
                                                        <td style="padding:4px 10px; border:1px solid #e0e0e0; text-align:center;">@CustomerTradeCell(r, "StockOther")</td>
                                                        <td style="padding:4px 10px; border:1px solid #e0e0e0; text-align:center;">@CustomerTradeCell(r, "WipNone")</td>
                                                        <td style="padding:4px 10px; border:1px solid #e0e0e0; text-align:center;">@CustomerTradeCell(r, "WipPartial")</td>
                                                    </tr>
                                                }
                                            </tbody>
                                            <tfoot>
                                                <tr>
                                                    <td colspan="2" style="padding:4px 10px; border:1px solid #e0e0e0; font-weight:700; background:#fffde7;">合计</td>
                                                    <td style="padding:4px 10px; border:1px solid #e0e0e0; text-align:center; font-weight:700; background:#fffde7;">@CustomerTradeSummary(customerRows, "TotalOrder")</td>
                                                    <td style="padding:4px 10px; border:1px solid #e0e0e0; text-align:center; font-weight:700; background:#fffde7;">@CustomerTradeSummary(customerRows, "YearOrder")</td>
                                                    <td style="padding:4px 10px; border:1px solid #e0e0e0; text-align:center; font-weight:700; background:#fffde7;">@CustomerTradeSummary(customerRows, "ShippedDone")</td>
                                                    <td style="padding:4px 10px; border:1px solid #e0e0e0; text-align:center; font-weight:700; background:#fffde7;">@CustomerTradeSummary(customerRows, "ShippedOther")</td>
                                                    <td style="padding:4px 10px; border:1px solid #e0e0e0; text-align:center; font-weight:700; background:#fffde7;">@CustomerTradeSummary(customerRows, "StockDone")</td>
                                                    <td style="padding:4px 10px; border:1px solid #e0e0e0; text-align:center; font-weight:700; background:#fffde7;">@CustomerTradeSummary(customerRows, "StockOther")</td>
                                                    <td style="padding:4px 10px; border:1px solid #e0e0e0; text-align:center; font-weight:700; background:#fffde7;">@CustomerTradeSummary(customerRows, "WipNone")</td>
                                                    <td style="padding:4px 10px; border:1px solid #e0e0e0; text-align:center; font-weight:700; background:#fffde7;">@CustomerTradeSummary(customerRows, "WipPartial")</td>
                                                </tr>
                                            </tfoot>
                                        </table>
                                    </div>
                                }
                            }
                        </MudCardContent>
                    </MudCard>

                }
            </div>
        </MudTabPanel>

        @* ========== Tab2 现订单负荷总量：嵌入订单负荷总量组件 ========== *@
        <MudTabPanel Text="现订单负荷总量" Icon="@Icons.Material.Filled.HourglassEmpty">
            <div class="pa-2">
                <WorkOrderLoadOverview Title="现订单负荷总量" @key="_refreshKey" />
            </div>
        </MudTabPanel>

        @* ========== Tab3 原料需求：原锁待投料量汇总（矩阵 + 截日） ========== *@
        <MudTabPanel Text="原料需求" Icon="@Icons.Material.Filled.Inventory">
            <div class="pa-2">
                @if (_loading[2])
                {
                    <div class="d-flex align-center" style="gap:8px;">
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                        <span>原料需求加载中...</span>
                    </div>
                }
                else if (_failed[2])
                {
                    <MudAlert Severity="Severity.Error">@_errorMessages[2]</MudAlert>
                }
                else
                {
                    <MudPaper Class="pa-3" Elevation="0">
                        @if (_pendingSummary == null)
                        {
                            <MudText Typo="Typo.body2" Class="text-hint">正在加载...</MudText>
                        }
                        else
                        {
                            <div class="d-flex justify-space-between align-center mb-2">
                                <MudText Typo="Typo.subtitle2"><b>待投料量汇总（原料锁定）</b></MudText>
                                <MudButton Variant="Variant.Text" Size="Size.Small" Color="Color.Primary"
                                           StartIcon="@Icons.Material.Filled.Print"
                                           OnClick="@(() => PrintTableAsync("#report-pending-summary", "原料需求-待投料量汇总"))">
                                    打印
                                </MudButton>
                            </div>

                            @* 标量徽章（2026-09-10 用户决策：删「工单总数/计划投料」，全四档口径易误导） *@
                            <div class="d-flex" style="gap:24px; flex-wrap:wrap; margin-bottom:12px;">
                                <MudText Typo="Typo.body2" Class="text-warning-orange">
                                    <b>待投原料:</b> @((_pendingSummary.PendingWeight / 1000m).ToString("F1"))t
                                </MudText>
                                @if (_pendingSummary.HasPurchaseData)
                                {
                                    <MudText Typo="Typo.body2" Class="text-primary">
                                        <b>成购:</b> @((_pendingSummary.PurchaseWeight / 1000m).ToString("F1"))t
                                    </MudText>
                                }
                            </div>

                            <div id="report-pending-summary">
                                <div style="display:flex; gap:16px; flex-wrap:wrap;">
                                    @* 待投原料矩阵：行=原料锁定备注，列=主号计划性 *@
                                    <div style="flex:1; min-width:340px;">
                                        <div style="font-weight:600; color:#E65100; margin-bottom:4px;">待投原料</div>
                                        <table style="border-collapse: collapse; width: 100%; font-size: 0.8125rem;">
                                            <thead>
                                                <tr>
                                                    <th style="text-align:left; padding:4px 6px; background:#f5f5f5; border:1px solid #e0e0e0;">备注 \ 计划性</th>
                                                    @foreach (var label in _pendingSummary.MatrixColumnLabels)
                                                    {
                                                        <th style="padding:4px 6px; background:#f5f5f5; border:1px solid #e0e0e0; text-align:center;">@label</th>
                                                    }
                                                    <th style="padding:4px 10px; background:#eef3fa; border:1px solid #e0e0e0; text-align:center;">合计</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @for (var ri = 0; ri < _pendingSummary.MatrixRowLabels.Count; ri++)
                                                {
                                                    var row = _pendingSummary.MatrixRows[ri];
                                                    <tr>
                                                        <td style="padding:4px 10px; border:1px solid #e0e0e0; font-weight:600;">@_pendingSummary.MatrixRowLabels[ri]</td>
                                                        @foreach (var c in row.Cells)
                                                        {
                                                            <td style="padding:4px 10px; border:1px solid #e0e0e0; text-align:center;">@FormatMatrixPending(c.Count, c.PendingWeight)</td>
                                                        }
                                                        <td style="padding:4px 10px; border:1px solid #e0e0e0; text-align:center; background:#f0f7f0; font-weight:600;">@FormatMatrixPending(row.RowCount, row.RowPendingWeight)</td>
                                                    </tr>
                                                }
                                                <tr>
                                                    <td style="padding:4px 10px; border:1px solid #e0e0e0; font-weight:600; background:#eef3fa;">合计</td>
                                                    @foreach (var col in _pendingSummary.MatrixColumnTotals)
                                                    {
                                                        <td style="padding:4px 10px; border:1px solid #e0e0e0; text-align:center; background:#eef3fa; font-weight:600;">@FormatMatrixPending(col.Count, col.PendingWeight)</td>
                                                    }
                                                    <td style="padding:4px 10px; border:1px solid #e0e0e0; text-align:center; background:#e8f0e8; font-weight:700;">@FormatMatrixPending(_pendingSummary.MatrixGrandTotals.Count, _pendingSummary.MatrixGrandTotals.PendingWeight)</td>
                                                </tr>
                                            </tbody>
                                        </table>
                                    </div>

                                    @* 成购矩阵：仅当有外购成品未到时显示 *@
                                    @if (_pendingSummary.HasPurchaseData)
                                    {
                                        <div style="flex:1; min-width:340px;">
                                            <div style="font-weight:600; color:#1565C0; margin-bottom:4px;">成购（外购成品）</div>
                                            <table style="border-collapse: collapse; width: 100%; font-size: 0.8125rem;">
                                                <thead>
                                                    <tr>
                                                        <th style="text-align:left; padding:4px 6px; background:#f5f5f5; border:1px solid #e0e0e0;">备注 \ 计划性</th>
                                                        @foreach (var label in _pendingSummary.MatrixColumnLabels)
                                                        {
                                                            <th style="padding:4px 6px; background:#f5f5f5; border:1px solid #e0e0e0; text-align:center;">@label</th>
                                                        }
                                                        <th style="padding:4px 10px; background:#eef3fa; border:1px solid #e0e0e0; text-align:center;">合计</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @* 成购仅为「执行用料计划」档的一个分支：只渲染该行（其余 3 档恒为 -，2026-09-10 用户决策） *@
                                                    @{
                                                        var pri = PurchaseMatrixRowIndex;
                                                    }
                                                    @if (pri >= 0)
                                                    {
                                                        var row = _pendingSummary.MatrixRows[pri];
                                                        <tr>
                                                            <td style="padding:4px 10px; border:1px solid #e0e0e0; font-weight:600;">@_pendingSummary.MatrixRowLabels[pri]</td>
                                                            @foreach (var c in row.Cells)
                                                            {
                                                                <td style="padding:4px 10px; border:1px solid #e0e0e0; text-align:center;">@FormatMatrixPurchase(c.PurchaseCount, c.PurchaseWeight)</td>
                                                            }
                                                            <td style="padding:4px 10px; border:1px solid #e0e0e0; text-align:center; background:#f0f7f0; font-weight:600;">@FormatMatrixPurchase(row.RowPurchaseCount, row.RowPurchaseWeight)</td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        </div>
                                    }
                                </div>

                                @* 理论待投料截日 *@
                                <div style="margin-top:16px;">
                                    <div style="font-weight:600; color:#1565C0; margin-bottom:4px;">理论待投料截日</div>
                                    <table style="border-collapse: collapse; width: 100%; font-size: 0.8125rem;">
                                        <thead>
                                            <tr>
                                                <th style="text-align:left; padding:4px 6px; background:#f5f5f5; border:1px solid #e0e0e0;">原锁类别</th>
                                                <th style="padding:4px 6px; background:#f5f5f5; border:1px solid #e0e0e0; text-align:center;">全期合计</th>
                                                @foreach (var b in _pendingSummary.CutoffBucketLabels)
                                                {
                                                    <th style="padding:4px 6px; background:#f5f5f5; border:1px solid #e0e0e0; text-align:center; white-space:nowrap;">@b</th>
                                                }
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var r in _pendingSummary.CutoffRows)
                                            {
                                                var isTotal = r.Category == "合计";
                                                <tr>
                                                    <td style="padding:4px 10px; border:1px solid #e0e0e0; font-weight:600; @(isTotal ? "background:#e8f0e8;" : "")">@r.Category</td>
                                                    <td style="padding:4px 10px; border:1px solid #e0e0e0; text-align:center; @(isTotal ? "background:#e8f0e8;" : "")">@FormatCutoffCell(r.Total)</td>
                                                    @foreach (var v in r.Buckets)
                                                    {
                                                        <td style="padding:4px 10px; border:1px solid #e0e0e0; text-align:center; @(isTotal ? "background:#e8f0e8;" : "")">@FormatCutoffCell(v)</td>
                                                    }
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        }
                    </MudPaper>
                }
            </div>
        </MudTabPanel>

        @* ========== Tab4 物料执行：采购 6 卡 + 穿孔 3 卡 ========== *@
        <MudTabPanel Text="物料执行" Icon="@Icons.Material.Filled.LocalShipping">
            <div class="pa-2">
                @if (_loading[3])
                {
                    <div class="d-flex align-center" style="gap:8px;">
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                        <span>物料执行加载中...</span>
                    </div>
                }
                else if (_failed[3])
                {
                    <MudAlert Severity="Severity.Error">@_errorMessages[3]</MudAlert>
                }
                else
                {
                    @* 荒管待购（折叠：实时卡默认展开） *@
                    <MudCard Class="mb-2 summary-card" Elevation="0">
                        <MudCardContent>
                            <div class="d-flex align-center mb-2">
                                <MudIconButton Icon="@(IsCardCollapsed("material:semi-pending") ? Icons.Material.Filled.ExpandMore : Icons.Material.Filled.ExpandLess)"
                                               Size="Size.Small" Color="@(IsCardCollapsed("material:semi-pending") ? Color.Default : Color.Primary)"
                                               OnClick="@(() => ToggleCardAsync("material:semi-pending"))" Title="展开/折叠" />
                                <MudText Typo="Typo.subtitle2" Class="ml-1"><span class="report-tt report-tt-1">荒管待购实时数据</span></MudText>
                                <div class="ml-auto">
                                    <MudButton Variant="Variant.Text" Size="Size.Small" Color="Color.Primary"
                                               StartIcon="@Icons.Material.Filled.Print" OnClick="@(() => PrintTableAsync("#report-semi-pending", "荒管待购实时数据"))">打印</MudButton>
                                </div>
                            </div>
                            @if (!IsCardCollapsed("material:semi-pending"))
                            {
                                @if (_semiPendingItems.Count == 0)
                                {
                                    <MudText Typo="Typo.body2" Class="text-hint">暂无荒管待购数据</MudText>
                                }
                                else
                                {
                                    <div id="report-semi-pending" style="overflow-x: auto; max-height: 30vh;">
                                        <MudTable Breakpoint="Breakpoint.None" T="PurchasePendingDto" Items="@_semiPendingItems" Dense="true" Hover="true" Class="auto-table" Elevation="0">
                                            <HeaderContent>
                                                <MudTh Style="width: 120px;">工单号</MudTh>
                                                <MudTh Style="width: 90px;">工单关注</MudTh>
                                                <MudTh Style="width: 110px;">原锁执行</MudTh>
                                                <MudTh Style="width: 90px;">工单计划性</MudTh>
                                                <MudTh Style="width: 90px;">物料分类</MudTh>
                                                <MudTh Style="width: 130px;">厂内钢种</MudTh>
                                                <MudTh Style="width: 130px;">规格</MudTh>
                                                <MudTh Style="width: 100px;" Class="text-center">待购量(kg)</MudTh>
                                            </HeaderContent>
                                            <RowTemplate>
                                                <MudTd>@context.WorkOrderNo</MudTd>
                                                <MudTd>@IntStatusDisplayHelper.GetScheduleStageText(context.ExecutionScheduleStage, "-")</MudTd>
                                                <MudTd>@(context.ExecutionRawMaterialLockRemark != null ? (DictValueDisplayHelper.GetText(DictValueDefaults.RawMaterialLockRemarkKey, context.ExecutionRawMaterialLockRemark) ?? "-") : "-")</MudTd>
                                                <MudTd>@(context.ExecutionUrgencyLevel != null ? (DictValueDisplayHelper.GetText(DictValueDefaults.UrgencyLevelKey, context.ExecutionUrgencyLevel) ?? "-") : "-")</MudTd>
                                                <MudTd>@DisplayHelper.GetMaterialTypeText(context.MaterialCategory)</MudTd>
                                                <MudTd>@context.PlantGrade</MudTd>
                                                <MudTd>@context.Specification</MudTd>
                                                <MudTd Class="text-center">@FormatPendingWeight(context.PendingWeight)</MudTd>
                                            </RowTemplate>
                                        </MudTable>
                                    </div>
                                }
                            }
                        </MudCardContent>
                    </MudCard>

                    @* 荒管在购（供应商×厂内钢种二维表，折叠） *@
                    @if (_semiInProgressData is { Rows.Count: > 0 })
                    {
                        <MudCard Class="mb-2 summary-card" Elevation="0">
                            <MudCardContent>
                                <div class="d-flex align-center mb-2">
                                    <MudIconButton Icon="@(IsCardCollapsed("material:semi-in-progress") ? Icons.Material.Filled.ExpandMore : Icons.Material.Filled.ExpandLess)"
                                                   Size="Size.Small" Color="@(IsCardCollapsed("material:semi-in-progress") ? Color.Default : Color.Primary)"
                                                   OnClick="@(() => ToggleCardAsync("material:semi-in-progress"))" Title="展开/折叠" />
                                    <MudText Typo="Typo.subtitle2" Class="ml-1"><span class="report-tt report-tt-1">荒管在购实时数据</span></MudText>
                                    <div class="ml-auto">
                                        <MudButton Variant="Variant.Text" Size="Size.Small" Color="Color.Primary"
                                                   StartIcon="@Icons.Material.Filled.Print" OnClick="@(() => PrintTableAsync("#report-semi-in-progress", "荒管在购实时数据"))">打印</MudButton>
                                    </div>
                                </div>
                                @if (!IsCardCollapsed("material:semi-in-progress"))
                                {
                                <div id="report-semi-in-progress" style="overflow-x:auto;">
                                    <table style="border-collapse: collapse; width: 100%; font-size: 0.8125rem;">
                                        <thead>
                                            <tr>
                                                <th style="text-align:left; padding:4px 10px; background:#f5f5f5; border:1px solid #e0e0e0;">供应商</th>
                                                @foreach (var g in _semiInProgressData.SteelGrades)
                                                {
                                                    <th style="padding:4px 10px; background:#f5f5f5; border:1px solid #e0e0e0; text-align:center;">@g (t)</th>
                                                }
                                                <th style="padding:4px 10px; background:#fff8e1; border:1px solid #e0e0e0; text-align:center;">合计(t)</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var r in _semiInProgressData.Rows)
                                            {
                                                var isTotal = r.SupplierName == "合计";
                                                <tr>
                                                    <td style="padding:4px 10px; border:1px solid #e0e0e0; font-weight:@(isTotal ? "700" : "600"); @(isTotal ? "background:#eef3fa;" : "")">@r.SupplierName</td>
                                                    @foreach (var g in _semiInProgressData.SteelGrades)
                                                    {
                                                        <td style="padding:4px 10px; border:1px solid #e0e0e0; text-align:center; @(isTotal ? "background:#eef3fa;" : "")">@RenderInProgressCell(r.Cells.GetValueOrDefault(g) ?? new PurchaseInProgressCellDto())</td>
                                                    }
                                                    <td style="padding:4px 10px; border:1px solid #e0e0e0; text-align:center; font-weight:700; @(isTotal ? "background:#eef3fa;" : "background:#fff8e1;")">@RenderInProgressCell(r.Total)</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                                }
                            </MudCardContent>
                        </MudCard>
                    }

                    @* 荒管月度（供应商×1月~12月二维表） *@
                    @if (_semiMonthlyData is { Rows.Count: > 0 })
                    {
                        <MudCard Class="mb-2 summary-card" Elevation="0">
                            <MudCardContent>
                                <div class="d-flex align-center mb-2">
                                    <MudIconButton Icon="@(IsCardCollapsed("material:semi-monthly") ? Icons.Material.Filled.ExpandMore : Icons.Material.Filled.ExpandLess)"
                                                   Size="Size.Small" Color="@(IsCardCollapsed("material:semi-monthly") ? Color.Default : Color.Primary)"
                                                   OnClick="@(() => ToggleCardAsync("material:semi-monthly"))" Title="展开/折叠" />
                                    <MudText Typo="Typo.subtitle2" Class="ml-1"><span class="report-tt report-tt-1">荒管月度采购数据</span></MudText>
                                    <div class="ml-auto">
                                        <MudButton Variant="Variant.Text" Size="Size.Small" Color="Color.Primary"
                                                   StartIcon="@Icons.Material.Filled.Print" OnClick="@(() => PrintTableAsync("#report-semi-monthly", "荒管月度采购数据"))">打印</MudButton>
                                    </div>
                                </div>
                                @if (!IsCardCollapsed("material:semi-monthly"))
                                {
                                <div id="report-semi-monthly" style="overflow-x:auto;">
                                    <table style="border-collapse: collapse; width: 100%; font-size: 0.8125rem;">
                                        <thead>
                                            <tr>
                                                <th style="text-align:left; padding:4px 10px; background:#f5f5f5; border:1px solid #e0e0e0;">供应商</th>
                                                @foreach (var label in _semiMonthlyData.MonthLabels)
                                                {
                                                    <th style="padding:4px 10px; background:#f5f5f5; border:1px solid #e0e0e0; text-align:center;">@label</th>
                                                }
                                                <th style="padding:4px 10px; background:#fff8e1; border:1px solid #e0e0e0; text-align:center;">合计(t)</th>
                                                <th style="padding:4px 10px; background:#ffe0b2; border:1px solid #e0e0e0; text-align:center;">现在购(t)</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var r in _semiMonthlyData.Rows)
                                            {
