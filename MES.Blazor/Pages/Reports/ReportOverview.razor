@page "/reports/overview"
@using MES.Blazor.Helpers
@using MES.Blazor.Pages.Scheduling
@attribute [Authorize(Roles = Roles.Policies.ReportOverview)]

<MudContainer MaxWidth="MaxWidth.False" Class="mt-4 pl-0">
    <div class="d-flex align-center mb-4">
        <MudText Typo="Typo.h5" Class="font-weight-bold">
            <MudIcon Icon="@Icons.Material.Filled.Assessment" Class="mr-2" Color="Color.Primary" />
            报表总览
        </MudText>
        <div class="ml-auto">
            <MudButton Variant="Variant.Text" Size="Size.Small" Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Refresh" OnClick="RefreshAllAsync">
                全部刷新
            </MudButton>
        </div>
    </div>

    <MudTabs Position="Position.Top" ActivePanelIndex="_activeIndex" ActivePanelIndexChanged="OnActivePanelIndexChanged">

        @* ========== Tab1 业务总况：订单接单·出库及现负荷汇总 ========== *@
        <MudTabPanel Text="业务总况" Icon="@Icons.Material.Filled.ShowChart">
            <div class="pa-2">
                @if (_loading[0])
                {
                    <div class="d-flex align-center" style="gap:8px;">
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                        <span>业务总况加载中...</span>
                    </div>
                }
                else if (_failed[0])
                {
                    <MudAlert Severity="Severity.Error">@_errorMessages[0]</MudAlert>
                }
                else
                {
                    <MudPaper Class="pa-3" Elevation="0">
                        <div class="d-flex justify-space-between align-center mb-2">
                            <div class="d-flex align-center" style="gap: 8px;">
                                <MudText Typo="Typo.subtitle2"><b>订单接单·出库及现负荷汇总</b></MudText>
                                <MudText Typo="Typo.caption" Class="text-hint">单位：吨(t)（源数据 kg）｜成品库存(完工/未完工)与订单负荷量(实时)为当前存量，仅显示本月</MudText>
                            </div>
                            <MudButton Variant="Variant.Text" Size="Size.Small" Color="Color.Primary"
                                       StartIcon="@Icons.Material.Filled.Print"
                                       OnClick="@(() => PrintTableAsync("#report-inout-summary-table", "业务总况-订单接单出库及现负荷汇总"))"
                                       Disabled="@(_inOutSummary == null)">
                                打印
                            </MudButton>
                        </div>
                        @if (_inOutSummary == null)
                        {
                            <MudText Typo="Typo.body2" Class="text-hint">正在加载...</MudText>
                        }
                        else
                        {
                            <div id="report-inout-summary-table">
                            <table style="border-collapse: collapse; width: 100%; font-size: 0.8125rem;">
                                <thead>
                                    <tr>
                                        <th style="text-align:left; padding:4px 10px; background:#f5f5f5; border:1px solid #e0e0e0;">指标</th>
                                        @for (var m = 0; m < 12; m++)
                                        {
                                            <th style="padding:4px 10px; background:#f5f5f5; border:1px solid #e0e0e0; text-align:center;">@_inOutSummary.MonthLabels[m]</th>
                                        }
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td style="padding:4px 10px; border:1px solid #e0e0e0; font-weight:600;">接单量</td>
                                        @for (var m = 0; m < 12; m++)
                                        {
                                            <td style="padding:4px 10px; border:1px solid #e0e0e0; text-align:center;">@FormatInOutWeight(_inOutSummary.OrderWeightByMonth[m])</td>
                                        }
                                    </tr>
                                    <tr>
                                        <td style="padding:4px 10px; border:1px solid #e0e0e0; font-weight:600;">出库量</td>
                                        @for (var m = 0; m < 12; m++)
                                        {
                                            <td style="padding:4px 10px; border:1px solid #e0e0e0; text-align:center;">@FormatInOutWeight(_inOutSummary.OutboundWeightByMonth[m])</td>
                                        }
                                    </tr>
                                    <tr>
                                        <td style="padding:4px 10px; border:1px solid #e0e0e0; font-weight:600;">成品库存(完工)</td>
                                        @for (var m = 0; m < 12; m++)
                                        {
                                            <td style="padding:4px 10px; border:1px solid #e0e0e0; text-align:center;">@(m == _currentMonthIndex ? FormatInOutWeight(_inOutSummary.FinishedStockCompleted) : "-")</td>
                                        }
                                    </tr>
                                    <tr>
                                        <td style="padding:4px 10px; border:1px solid #e0e0e0; font-weight:600;">成品库存(未完工)</td>
                                        @for (var m = 0; m < 12; m++)
                                        {
                                            <td style="padding:4px 10px; border:1px solid #e0e0e0; text-align:center;">@(m == _currentMonthIndex ? FormatInOutWeight(_inOutSummary.FinishedStockUncompleted) : "-")</td>
                                        }
                                    </tr>
                                    <tr>
                                        <td style="padding:4px 10px; border:1px solid #e0e0e0; font-weight:600;">订单负荷量(实时)</td>
                                        @for (var m = 0; m < 12; m++)
                                        {
                                            <td style="padding:4px 10px; border:1px solid #e0e0e0; text-align:center;">@(m == _currentMonthIndex ? FormatInOutWeight(_inOutSummary.TurnoverTotal) : "-")</td>
                                        }
                                    </tr>
                                </tbody>
                            </table>
                            </div>

                            @* 两小表（订单交期预估：订单完成预估 / 延期交货订单预估），直接属于「订单接单·出库及现负荷汇总」表 *@
                            @if (_deliveryEstimate != null)
                            {
                                @for (var i = 0; i < _deliveryEstimate.Tables.Count; i++)
                                {
                                    var table = _deliveryEstimate.Tables[i];
                                    var tableId = $"report-delivery-estimate-{i}";
                                    <div class="mt-3">
                                        <div class="d-flex justify-space-between align-center mb-1">
                                            <MudText Typo="Typo.body2"><b>@table.Name</b></MudText>
                                            <MudButton Variant="Variant.Text" Size="Size.Small" Color="Color.Primary"
                                                       StartIcon="@Icons.Material.Filled.Print"
                                                       OnClick="@(() => PrintTableAsync("#" + tableId, "业务总况-" + table.Name))">
                                                打印
                                            </MudButton>
                                        </div>
                                        <div id="@tableId" style="overflow-x:auto;">
                                        <table style="border-collapse: collapse; width: 100%; font-size: 0.8125rem;">
                                            <thead>
                                                <tr>
                                                    <th style="text-align:left; padding:4px 10px; background:#f5f5f5; border:1px solid #e0e0e0;">交货日期范围</th>
                                                    @foreach (var label in table.BucketLabels)
                                                    {
                                                        <th style="padding:4px 10px; background:#f5f5f5; border:1px solid #e0e0e0; text-align:center;">@label</th>
                                                    }
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <tr>
                                                    <td style="padding:4px 10px; border:1px solid #e0e0e0; font-weight:600;">单数/重量</td>
                                                    @foreach (var bucket in table.Buckets)
                                                    {
                                                        <td style="padding:4px 10px; border:1px solid #e0e0e0; text-align:center;">@FormatDeliveryBucket(bucket)</td>
                                                    }
                                                </tr>
                                            </tbody>
                                        </table>
                                        </div>
                                    </div>
                                }
                            }
                        }
                    </MudPaper>
                }
            </div>
        </MudTabPanel>

        @* ========== Tab2 现订单负荷总量：嵌入订单负荷总量组件 ========== *@
        <MudTabPanel Text="现订单负荷总量" Icon="@Icons.Material.Filled.HourglassEmpty">
            <div class="pa-2">
                <WorkOrderLoadOverview Title="现订单负荷总量" @key="_refreshKey" />
            </div>
        </MudTabPanel>

        @* ========== Tab3 原料需求：原锁待投料量汇总（矩阵 + 截日） ========== *@
        <MudTabPanel Text="原料需求" Icon="@Icons.Material.Filled.Inventory">
            <div class="pa-2">
                @if (_loading[2])
                {
                    <div class="d-flex align-center" style="gap:8px;">
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                        <span>原料需求加载中...</span>
                    </div>
                }
                else if (_failed[2])
                {
                    <MudAlert Severity="Severity.Error">@_errorMessages[2]</MudAlert>
                }
                else
                {
                    <MudPaper Class="pa-3" Elevation="0">
                        @if (_pendingSummary == null)
                        {
                            <MudText Typo="Typo.body2" Class="text-hint">正在加载...</MudText>
                        }
                        else
                        {
                            <div class="d-flex justify-space-between align-center mb-2">
                                <MudText Typo="Typo.subtitle2"><b>待投料量汇总（原料锁定）</b></MudText>
                                <MudButton Variant="Variant.Text" Size="Size.Small" Color="Color.Primary"
                                           StartIcon="@Icons.Material.Filled.Print"
                                           OnClick="@(() => PrintTableAsync("#report-pending-summary", "原料需求-待投料量汇总"))">
                                    打印
                                </MudButton>
                            </div>

                            @* 标量徽章 *@
                            <div class="d-flex" style="gap:24px; flex-wrap:wrap; margin-bottom:12px;">
                                <MudText Typo="Typo.body2">
                                    <b>工单总数:</b> @_pendingSummary.TotalOrderCount 批
                                </MudText>
                                <MudText Typo="Typo.body2">
                                    <b>计划投料:</b> @((_pendingSummary.TotalWeight / 1000m).ToString("F1"))t
                                </MudText>
                                <MudText Typo="Typo.body2" Class="text-warning-orange">
                                    <b>待投料:</b> @((_pendingSummary.PendingWeight / 1000m).ToString("F1"))t
                                </MudText>
                                @if (_pendingSummary.HasPurchaseData)
                                {
                                    <MudText Typo="Typo.body2" Class="text-primary">
                                        <b>成购:</b> @((_pendingSummary.PurchaseWeight / 1000m).ToString("F1"))t（@_pendingSummary.PurchaseCount 行）
                                    </MudText>
                                }
                            </div>

                            <div id="report-pending-summary">
                                <div style="display:flex; gap:16px; flex-wrap:wrap;">
                                    @* 待投料矩阵：行=原料锁定备注，列=主号计划性 *@
                                    <div style="flex:1; min-width:340px;">
                                        <div style="font-weight:600; color:#E65100; margin-bottom:4px;">待投料</div>
                                        <table style="border-collapse: collapse; width: 100%; font-size: 0.8125rem;">
                                            <thead>
                                                <tr>
                                                    <th style="text-align:left; padding:4px 6px; background:#f5f5f5; border:1px solid #e0e0e0;">备注 \ 计划性</th>
                                                    @foreach (var label in _pendingSummary.MatrixColumnLabels)
                                                    {
                                                        <th style="padding:4px 6px; background:#f5f5f5; border:1px solid #e0e0e0; text-align:center;">@label</th>
                                                    }
                                                    <th style="padding:4px 10px; background:#eef3fa; border:1px solid #e0e0e0; text-align:center;">合计</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @for (var ri = 0; ri < _pendingSummary.MatrixRowLabels.Count; ri++)
                                                {
                                                    var row = _pendingSummary.MatrixRows[ri];
                                                    <tr>
                                                        <td style="padding:4px 10px; border:1px solid #e0e0e0; font-weight:600;">@_pendingSummary.MatrixRowLabels[ri]</td>
                                                        @foreach (var c in row.Cells)
                                                        {
                                                            <td style="padding:4px 10px; border:1px solid #e0e0e0; text-align:center;">@FormatMatrixPending(c.Count, c.PendingWeight)</td>
                                                        }
                                                        <td style="padding:4px 10px; border:1px solid #e0e0e0; text-align:center; background:#f0f7f0; font-weight:600;">@FormatMatrixPending(row.RowCount, row.RowPendingWeight)</td>
                                                    </tr>
                                                }
                                                <tr>
                                                    <td style="padding:4px 10px; border:1px solid #e0e0e0; font-weight:600; background:#eef3fa;">合计</td>
                                                    @foreach (var col in _pendingSummary.MatrixColumnTotals)
                                                    {
                                                        <td style="padding:4px 10px; border:1px solid #e0e0e0; text-align:center; background:#eef3fa; font-weight:600;">@FormatMatrixPending(col.Count, col.PendingWeight)</td>
                                                    }
                                                    <td style="padding:4px 10px; border:1px solid #e0e0e0; text-align:center; background:#e8f0e8; font-weight:700;">@FormatMatrixPending(_pendingSummary.MatrixGrandTotals.Count, _pendingSummary.MatrixGrandTotals.PendingWeight)</td>
                                                </tr>
                                            </tbody>
                                        </table>
                                    </div>

                                    @* 成购矩阵：仅当有外购成品未到时显示 *@
                                    @if (_pendingSummary.HasPurchaseData)
                                    {
                                        <div style="flex:1; min-width:340px;">
                                            <div style="font-weight:600; color:#1565C0; margin-bottom:4px;">成购（外购成品）</div>
                                            <table style="border-collapse: collapse; width: 100%; font-size: 0.8125rem;">
                                                <thead>
                                                    <tr>
                                                        <th style="text-align:left; padding:4px 6px; background:#f5f5f5; border:1px solid #e0e0e0;">备注 \ 计划性</th>
                                                        @foreach (var label in _pendingSummary.MatrixColumnLabels)
                                                        {
                                                            <th style="padding:4px 6px; background:#f5f5f5; border:1px solid #e0e0e0; text-align:center;">@label</th>
                                                        }
                                                        <th style="padding:4px 10px; background:#eef3fa; border:1px solid #e0e0e0; text-align:center;">合计</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @for (var ri = 0; ri < _pendingSummary.MatrixRowLabels.Count; ri++)
                                                    {
                                                        var row = _pendingSummary.MatrixRows[ri];
                                                        <tr>
                                                            <td style="padding:4px 10px; border:1px solid #e0e0e0; font-weight:600;">@_pendingSummary.MatrixRowLabels[ri]</td>
                                                            @foreach (var c in row.Cells)
                                                            {
                                                                <td style="padding:4px 10px; border:1px solid #e0e0e0; text-align:center;">@FormatMatrixPurchase(c.PurchaseCount, c.PurchaseWeight)</td>
                                                            }
                                                            <td style="padding:4px 10px; border:1px solid #e0e0e0; text-align:center; background:#f0f7f0; font-weight:600;">@FormatMatrixPurchase(row.RowPurchaseCount, row.RowPurchaseWeight)</td>
                                                        </tr>
                                                    }
                                                    <tr>
                                                        <td style="padding:4px 10px; border:1px solid #e0e0e0; font-weight:600; background:#eef3fa;">合计</td>
                                                        @foreach (var col in _pendingSummary.MatrixColumnTotals)
                                                        {
                                                            <td style="padding:4px 10px; border:1px solid #e0e0e0; text-align:center; background:#eef3fa; font-weight:600;">@FormatMatrixPurchase(col.PurchaseCount, col.PurchaseWeight)</td>
                                                        }
                                                        <td style="padding:4px 10px; border:1px solid #e0e0e0; text-align:center; background:#e8f0e8; font-weight:700;">@FormatMatrixPurchase(_pendingSummary.MatrixGrandTotals.PurchaseCount, _pendingSummary.MatrixGrandTotals.PurchaseWeight)</td>
                                                    </tr>
                                                </tbody>
                                            </table>
                                        </div>
                                    }
                                </div>

                                @* 理论待投料截日 *@
                                <div style="margin-top:16px;">
                                    <div style="font-weight:600; color:#1565C0; margin-bottom:4px;">理论待投料截日</div>
                                    <table style="border-collapse: collapse; width: 100%; font-size: 0.8125rem;">
                                        <thead>
                                            <tr>
                                                <th style="text-align:left; padding:4px 6px; background:#f5f5f5; border:1px solid #e0e0e0;">原锁类别</th>
                                                <th style="padding:4px 6px; background:#f5f5f5; border:1px solid #e0e0e0; text-align:center;">待投料总量</th>
                                                @foreach (var b in _pendingSummary.CutoffBucketLabels)
                                                {
                                                    <th style="padding:4px 6px; background:#f5f5f5; border:1px solid #e0e0e0; text-align:center; white-space:nowrap;">@b</th>
                                                }
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var r in _pendingSummary.CutoffRows)
                                            {
                                                var isTotal = r.Category == "合计";
                                                <tr>
                                                    <td style="padding:4px 10px; border:1px solid #e0e0e0; font-weight:600; @(isTotal ? "background:#e8f0e8;" : "")">@r.Category</td>
                                                    <td style="padding:4px 10px; border:1px solid #e0e0e0; text-align:center; @(isTotal ? "background:#e8f0e8;" : "")">@FormatCutoffCell(r.Total)</td>
                                                    @foreach (var v in r.Buckets)
                                                    {
                                                        <td style="padding:4px 10px; border:1px solid #e0e0e0; text-align:center; @(isTotal ? "background:#e8f0e8;" : "")">@FormatCutoffCell(v)</td>
                                                    }
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        }
                    </MudPaper>
                }
            </div>
        </MudTabPanel>

        @* ========== Tab4 物料执行：采购 6 卡 + 穿孔 3 卡 ========== *@
        <MudTabPanel Text="物料执行" Icon="@Icons.Material.Filled.LocalShipping">
            <div class="pa-2">
                @if (_loading[3])
                {
                    <div class="d-flex align-center" style="gap:8px;">
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                        <span>物料执行加载中...</span>
                    </div>
                }
                else if (_failed[3])
                {
                    <MudAlert Severity="Severity.Error">@_errorMessages[3]</MudAlert>
                }
                else
                {
                    @* 荒管待购（折叠：实时卡默认展开） *@
                    <MudCard Class="mb-2 summary-card" Elevation="0">
                        <MudCardContent>
                            <div class="d-flex align-center mb-2">
                                <MudIconButton Icon="@(IsCardCollapsed("material:semi-pending") ? Icons.Material.Filled.ExpandMore : Icons.Material.Filled.ExpandLess)"
                                               Size="Size.Small" Color="@(IsCardCollapsed("material:semi-pending") ? Color.Default : Color.Primary)"
                                               OnClick="@(() => ToggleCardAsync("material:semi-pending"))" Title="展开/折叠" />
                                <MudText Typo="Typo.subtitle2" Class="ml-1"><b>荒管待购实时数据</b></MudText>
                                <div class="ml-auto">
                                    <MudButton Variant="Variant.Text" Size="Size.Small" Color="Color.Primary"
                                               StartIcon="@Icons.Material.Filled.Print" OnClick="@(() => PrintTableAsync("#report-semi-pending", "荒管待购实时数据"))">打印</MudButton>
                                </div>
                            </div>
                            @if (!IsCardCollapsed("material:semi-pending"))
                            {
                                @if (_semiPendingItems.Count == 0)
                                {
                                    <MudText Typo="Typo.body2" Class="text-hint">暂无荒管待购数据</MudText>
                                }
                                else
                                {
                                    <div id="report-semi-pending" style="overflow-x: auto; max-height: 30vh;">
                                        <MudTable T="PurchasePendingDto" Items="@_semiPendingItems" Dense="true" Hover="true" Class="auto-table" Elevation="0">
                                            <HeaderContent>
                                                <MudTh Style="width: 120px;">工单号</MudTh>
                                                <MudTh Style="width: 90px;">工单关注</MudTh>
                                                <MudTh Style="width: 110px;">原锁执行</MudTh>
                                                <MudTh Style="width: 90px;">工单计划性</MudTh>
                                                <MudTh Style="width: 90px;">物料分类</MudTh>
                                                <MudTh Style="width: 130px;">厂内钢种</MudTh>
                                                <MudTh Style="width: 130px;">规格</MudTh>
                                                <MudTh Style="width: 100px;" Class="text-right">待购量(kg)</MudTh>
                                            </HeaderContent>
                                            <RowTemplate>
                                                <MudTd>@context.WorkOrderNo</MudTd>
                                                <MudTd>@IntStatusDisplayHelper.GetScheduleStageText(context.ExecutionScheduleStage, "-")</MudTd>
                                                <MudTd>@(context.ExecutionRawMaterialLockRemark != null ? (RawMaterialLockRemarkKeys.ToChinese(context.ExecutionRawMaterialLockRemark) ?? "-") : "-")</MudTd>
                                                <MudTd>@(context.ExecutionUrgencyLevel != null ? (DictValueDisplayHelper.GetText(DictValueDefaults.UrgencyLevelKey, context.ExecutionUrgencyLevel) ?? "-") : "-")</MudTd>
                                                <MudTd>@DisplayHelper.GetMaterialTypeText(context.MaterialCategory)</MudTd>
                                                <MudTd>@context.PlantGrade</MudTd>
                                                <MudTd>@context.Specification</MudTd>
                                                <MudTd Class="text-right">@FormatPendingWeight(context.PendingWeight)</MudTd>
                                            </RowTemplate>
                                        </MudTable>
                                    </div>
                                }
                            }
                        </MudCardContent>
                    </MudCard>

                    @* 荒管在购（供应商×厂内钢种二维表，折叠） *@
                    @if (_semiInProgressData is { Rows.Count: > 0 })
                    {
                        <MudCard Class="mb-2 summary-card" Elevation="0">
                            <MudCardContent>
                                <div class="d-flex align-center mb-2">
                                    <MudIconButton Icon="@(IsCardCollapsed("material:semi-in-progress") ? Icons.Material.Filled.ExpandMore : Icons.Material.Filled.ExpandLess)"
                                                   Size="Size.Small" Color="@(IsCardCollapsed("material:semi-in-progress") ? Color.Default : Color.Primary)"
                                                   OnClick="@(() => ToggleCardAsync("material:semi-in-progress"))" Title="展开/折叠" />
                                    <MudText Typo="Typo.subtitle2" Class="ml-1"><b>荒管在购实时数据</b></MudText>
                                    <div class="ml-auto">
                                        <MudButton Variant="Variant.Text" Size="Size.Small" Color="Color.Primary"
                                                   StartIcon="@Icons.Material.Filled.Print" OnClick="@(() => PrintTableAsync("#report-semi-in-progress", "荒管在购实时数据"))">打印</MudButton>
                                    </div>
                                </div>
                                @if (!IsCardCollapsed("material:semi-in-progress"))
                                {
                                <div id="report-semi-in-progress" style="overflow-x:auto;">
                                    <table style="border-collapse: collapse; width: 100%; font-size: 0.8125rem;">
                                        <thead>
                                            <tr>
                                                <th style="text-align:left; padding:4px 10px; background:#f5f5f5; border:1px solid #e0e0e0;">供应商</th>
                                                @foreach (var g in _semiInProgressData.SteelGrades)
                                                {
                                                    <th style="padding:4px 10px; background:#f5f5f5; border:1px solid #e0e0e0; text-align:center;">@g (t)</th>
                                                }
                                                <th style="padding:4px 10px; background:#fff8e1; border:1px solid #e0e0e0; text-align:center;">合计(t)</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var r in _semiInProgressData.Rows)
                                            {
                                                var isTotal = r.SupplierName == "合计";
                                                <tr>
