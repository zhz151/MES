                                    <MudTextField T="string" @bind-Value="_supplierTradeKeyword" Immediate="true" Variant="Variant.Outlined"
                                                  Dense="true" Margin="Margin.Dense" Style="width:220px" Label="搜索名称/物料分类/备注" />
                                    @* 出单日期区间（2026-09-14）：任一端填写即「区间出单」生效；起/止/应用/清除 = 一个整体 *@
                                    <div class="d-flex align-center" style="gap:6px;">
                                        <MudTextField T="string" @bind-Value="_supplierTradeOrderFrom" Immediate="true" Variant="Variant.Outlined"
                                                      Dense="true" Margin="Margin.Dense" Style="width:140px" Label="出单日期起"
                                                      Placeholder="yyyy-MM-dd" />
                                        <MudTextField T="string" @bind-Value="_supplierTradeOrderTo" Immediate="true" Variant="Variant.Outlined"
                                                      Dense="true" Margin="Margin.Dense" Style="width:140px" Label="出单日期止"
                                                      Placeholder="yyyy-MM-dd" />
                                        <MudButton Variant="Variant.Outlined" Size="Size.Small" Color="Color.Primary"
                                                   OnClick="OnSupplierTradeOrderChangedAsync">应用出单区间</MudButton>
                                        <MudButton Variant="Variant.Text" Size="Size.Small"
                                                   OnClick="@(() => { _supplierTradeOrderFrom = ""; _supplierTradeOrderTo = ""; return OnSupplierTradeOrderChangedAsync(); })"
                                                   Disabled="@(!SupplierTradeOrderRangeMode)">清除</MudButton>
                                    </div>
                                    <MudDivider Vertical="true" FlexItem="true" Style="height:28px;" />
                                    @* 到货日期区间（2026-09-14）：与出单区间互相独立、可叠加；起/止/应用/清除 = 一个整体 *@
                                    <div class="d-flex align-center" style="gap:6px;">
                                        <MudTextField T="string" @bind-Value="_supplierTradeArrivalFrom" Immediate="true" Variant="Variant.Outlined"
                                                      Dense="true" Margin="Margin.Dense" Style="width:140px" Label="到货日期起"
                                                      Placeholder="yyyy-MM-dd" />
                                        <MudTextField T="string" @bind-Value="_supplierTradeArrivalTo" Immediate="true" Variant="Variant.Outlined"
                                                      Dense="true" Margin="Margin.Dense" Style="width:140px" Label="到货日期止"
                                                      Placeholder="yyyy-MM-dd" />
                                        <MudButton Variant="Variant.Outlined" Size="Size.Small" Color="Color.Primary"
                                                   OnClick="OnSupplierTradeArrivalChangedAsync">应用到货区间</MudButton>
                                        <MudButton Variant="Variant.Text" Size="Size.Small"
                                                   OnClick="@(() => { _supplierTradeArrivalFrom = ""; _supplierTradeArrivalTo = ""; return OnSupplierTradeArrivalChangedAsync(); })"
                                                   Disabled="@(!SupplierTradeArrivalRangeMode)">清除</MudButton>
                                    </div>
                                    @* 显示行数 + 计数注释 = 一个整体 *@
                                    <div class="d-flex align-center" style="gap:6px;">
                                        <MudSelect T="int" @bind-Value="_supplierTradeTake" Dense="true" Variant="Variant.Outlined"
                                                   Margin="Margin.Dense" Style="width:110px" Label="显示行数">
                                            <MudSelectItem T="int" Value="10">10 行</MudSelectItem>
                                            <MudSelectItem T="int" Value="20">20 行</MudSelectItem>
                                            <MudSelectItem T="int" Value="50">50 行</MudSelectItem>
                                            <MudSelectItem T="int" Value="0">全部</MudSelectItem>
                                        </MudSelect>
                                        <MudText Typo="Typo.caption" Class="text-hint">显示 @supplierRows.Count / 共 @SupplierTradeVisible().Count 条｜合计按显示行计</MudText>
                                    </div>
                                    @if (SupplierTradeAnyRangeMode)
                                    {
                                        <MudButton Variant="Variant.Text" Size="Size.Small"
                                                   OnClick="ClearSupplierTradeRangeAsync">清空全部区间</MudButton>
                                    }
                                </div>
                                @if (SupplierTradeAnyRangeMode)
                                {
                                    <MudText Typo="Typo.caption" Class="text-hint mb-2">
                                        @SupplierTradeRangeHint()
                                    </MudText>
                                }
                                @if (supplierRows.Count == 0)
                                {
                                    <MudText Typo="Typo.body2" Class="text-hint">暂无供应商往来数据</MudText>
                                }
                                else
                                {
                                    <div id="report-supplier-trade" style="overflow-x:auto; max-height:50vh; overflow-y:auto;">
                                        <table style="border-collapse: collapse; width: 100%; font-size: 0.8125rem;">
                                            <thead>
                                                <tr>
                                                    <th class="report-th-sort@(SupplierTradeSortedClass("name"))" @onclick="@(() => SortSupplierTrade("name"))" title="点击排序">供应商名称</th>
                                                    <th class="report-th-sort@(SupplierTradeSortedClass("category"))" @onclick="@(() => SortSupplierTrade("category"))" title="点击排序">物料分类</th>
                                                    <th style="text-align:left; padding:4px 10px; background:#f5f5f5; border:1px solid #e0e0e0;">备注</th>
                                                    <th style="padding:4px 10px; background:#f5f5f5; border:1px solid #e0e0e0; text-align:center;">累计出单</th>
                                                    <th style="padding:4px 10px; background:#f5f5f5; border:1px solid #e0e0e0; text-align:center;">@SupplierTradeHeader("YearOrder")</th>
                                                    <th style="padding:4px 10px; background:#f5f5f5; border:1px solid #e0e0e0; text-align:center;">@SupplierTradeHeader("Arrived")</th>
                                                    @* 存量列表头强调色（2026-09-14）：待收货=暖橙，与「客户往来数据」待发货同源 *@
                                                    <th style="padding:4px 10px; background:#fff3e0; color:#E65100; border:1px solid #e0e0e0; border-bottom:2px solid #ffb74d; text-align:center; font-weight:700;">待收货</th>
                                                    <th style="padding:4px 10px; background:#f5f5f5; border:1px solid #e0e0e0; text-align:center;">@SupplierTradeHeader("YearReturn")</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var r in supplierRows)
                                                {
                                                    <tr>
                                                        <td style="padding:4px 10px; border:1px solid #e0e0e0;">@r.SupplierName</td>
                                                        <td style="padding:4px 10px; border:1px solid #e0e0e0;">@SupplierMaterialText(r)</td>
                                                        <td style="padding:4px 10px; border:1px solid #e0e0e0;">@r.Remark</td>
                                                        <td style="padding:4px 10px; border:1px solid #e0e0e0; text-align:center;">@SupplierTradeCell(r, "TotalOrder")</td>
                                                        <td style="padding:4px 10px; border:1px solid #e0e0e0; text-align:center;">@SupplierTradeCell(r, "YearOrder")</td>
                                                        <td style="padding:4px 10px; border:1px solid #e0e0e0; text-align:center;">@SupplierTradeCell(r, "Arrived")</td>
                                                        <td style="padding:4px 10px; border:1px solid #e0e0e0; text-align:center;">@SupplierTradeCell(r, "Pending")</td>
                                                        <td style="padding:4px 10px; border:1px solid #e0e0e0; text-align:center;">@SupplierTradeCell(r, "YearReturn")</td>
                                                    </tr>
                                                }
                                            </tbody>
                                            <tfoot>
                                                <tr>
                                                    <td colspan="3" style="padding:4px 10px; border:1px solid #e0e0e0; font-weight:700; background:#fffde7;">合计</td>
                                                    <td style="padding:4px 10px; border:1px solid #e0e0e0; text-align:center; font-weight:700; background:#fffde7;">@SupplierTradeSummary(supplierRows, "TotalOrder")</td>
                                                    <td style="padding:4px 10px; border:1px solid #e0e0e0; text-align:center; font-weight:700; background:#fffde7;">@SupplierTradeSummary(supplierRows, "YearOrder")</td>
                                                    <td style="padding:4px 10px; border:1px solid #e0e0e0; text-align:center; font-weight:700; background:#fffde7;">@SupplierTradeSummary(supplierRows, "Arrived")</td>
                                                    <td style="padding:4px 10px; border:1px solid #e0e0e0; text-align:center; font-weight:700; background:#fffde7;">@SupplierTradeSummary(supplierRows, "Pending")</td>
                                                    <td style="padding:4px 10px; border:1px solid #e0e0e0; text-align:center; font-weight:700; background:#fffde7;">@SupplierTradeSummary(supplierRows, "YearReturn")</td>
                                                </tr>
                                            </tfoot>
                                        </table>
                                    </div>
                                }
                            }
                        </MudCardContent>
                    </MudCard>
                }
            </div>
        </MudTabPanel>

        @* ========== Tab5 生产执行：段落/工段流转 + 近日/月度生产量 + 实时委外在产 + 月度委外 ========== *@
        <MudTabPanel Text="生产执行" Icon="@Icons.Material.Filled.Factory">
            <div class="pa-2">
                @if (_loading[4])
                {
                    <div class="d-flex align-center" style="gap:8px;">
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                        <span>生产执行加载中...</span>
                    </div>
                }
                else if (_failed[4])
                {
                    <MudAlert Severity="Severity.Error">@_errorMessages[4]</MudAlert>
                }
                else
                {
                    @* 冷轧拔近日排程（只读建议卡，前往冷轧计划页执行） *@
                    <MudCard Class="mb-2 summary-card card-accent-left" Elevation="0">
                        <MudCardContent>
                            <div class="d-flex align-center mb-2">
                                <MudIconButton Icon="@(IsCardCollapsed("production:cold-roll-suggestion") ? Icons.Material.Filled.ExpandMore : Icons.Material.Filled.ExpandLess)"
                                               Size="Size.Small" Color="@(IsCardCollapsed("production:cold-roll-suggestion") ? Color.Default : Color.Primary)"
                                               OnClick="@(() => ToggleCardAsync("production:cold-roll-suggestion"))" Title="展开/折叠" />
                                <MudText Typo="Typo.subtitle2" Class="ml-1"><span class="report-tt report-tt-1">冷轧拔近日排程</span></MudText>
                                <div class="ml-auto">
                                    <MudButton Variant="Variant.Text" Size="Size.Small" Color="Color.Primary"
                                               StartIcon="@Icons.Material.Filled.Print"
                                               OnClick="@(() => PrintTableAsync("#report-cold-roll-suggestion", "冷轧拔近日排程"))"
                                               Disabled="@(!_coldRollSuggestionRows.Any())">
                                        打印
                                    </MudButton>
                                </div>
                            </div>
                            @if (!IsCardCollapsed("production:cold-roll-suggestion"))
                            {
                            @if (!_coldRollSuggestionRows.Any())
                            {
                                <MudText Typo="Typo.body2" Class="text-hint">暂无排程建议（无机台数配置或无批次排程维度）</MudText>
                            }
                            else
                            {
                                <div id="report-cold-roll-suggestion" style="overflow-x:auto;">
                                    <table style="border-collapse: collapse; width: 100%; font-size: 0.8125rem;">
                                        <thead>
                                            <tr>
                                                <th style="text-align:left; padding:4px 10px; background:#f5f5f5; border:1px solid #e0e0e0;">机台类型</th>
                                                <th style="padding:4px 10px; background:#f5f5f5; border:1px solid #e0e0e0; text-align:center;">可流转量(t)</th>
                                                <th style="padding:4px 10px; background:#f5f5f5; border:1px solid #e0e0e0; text-align:center;">计划流转量(t)</th>
                                                <th style="padding:4px 10px; background:#fff8e1; border:1px solid #e0e0e0; text-align:center;">计划机台数</th>
                                                <th style="padding:4px 10px; background:#fff8e1; border:1px solid #e0e0e0; text-align:center;">流转档</th>
                                                <th style="padding:4px 10px; background:#f5f5f5; border:1px solid #e0e0e0; text-align:center;">后流转</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var group in _coldRollSuggestionRows)
                                            {
                                                <tr>
                                                    <td style="padding:4px 10px; border:1px solid #e0e0e0; font-weight:600;">@group.MachineType</td>
                                                    <td style="padding:4px 10px; border:1px solid #e0e0e0; text-align:center;">@TonsText(group.FlowTotalWeight)</td>
                                                    <td style="padding:4px 10px; border:1px solid #e0e0e0; text-align:center;">@TonsText(group.PlannedFlowWeight)</td>
                                                    <td style="padding:4px 10px; border:1px solid #e0e0e0; text-align:center; font-weight:600; background:#fff8e1;">@group.MachineCount</td>
                                                    <td style="padding:4px 10px; border:1px solid #e0e0e0; text-align:center; font-weight:600; background:#fff8e1;">@SuggestionTierDisplay(group)</td>
                                                    <td style="padding:4px 10px; border:1px solid #e0e0e0; text-align:center;">@FlowStateText(group.FlowState)</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                                <div class="mt-1 text-hint" style="font-size:0.8rem;">
                                    档位说明：急+＝特急且关注本机台；急＝特急（正常流转）；急-＝急单（非正常流转）
                                </div>
                            }
                            }
                        </MudCardContent>
                    </MudCard>

                    @* 段落流转分析 *@
                    <MudCard Class="mb-2 summary-card" Elevation="0">
                        <MudCardContent>
                            <div class="d-flex align-center mb-2">
                                <MudIconButton Icon="@(IsCardCollapsed("production:paragraph-flow") ? Icons.Material.Filled.ExpandMore : Icons.Material.Filled.ExpandLess)"
                                               Size="Size.Small" Color="@(IsCardCollapsed("production:paragraph-flow") ? Color.Default : Color.Primary)"
                                               OnClick="@(() => ToggleCardAsync("production:paragraph-flow"))" Title="展开/折叠" />
                                <MudText Typo="Typo.subtitle2" Class="ml-1"><span class="report-tt report-tt-2">段落流转分析</span></MudText>
                                <div class="ml-auto">
                                    <MudButton Variant="Variant.Text" Size="Size.Small" Color="Color.Primary"
                                               StartIcon="@Icons.Material.Filled.Print" OnClick="@(() => PrintTableAsync("#report-paragraph-flow", "段落流转分析"))">打印</MudButton>
                                </div>
                            </div>
                            @if (!IsCardCollapsed("production:paragraph-flow"))
                            {
                            <div id="report-paragraph-flow" style="overflow-x:auto;">
                            @* 2026-09-14：改用带纵横格线的 HTML 表格，样式对齐「冷轧拔近日排程」 *@
                            <table style="border-collapse: collapse; width: 100%; font-size: 0.8125rem;">
                                <thead>
                                    <tr>
                                        <th style="text-align:left; padding:4px 10px; background:#f5f5f5; border:1px solid #e0e0e0;">生产段落</th>
                                        <th style="padding:4px 10px; background:#f5f5f5; border:1px solid #e0e0e0; text-align:center;">待在产重量</th>
                                        <th style="padding:4px 10px; background:#f5f5f5; border:1px solid #e0e0e0; text-align:center;">总况判定</th>
                                        <th style="padding:4px 10px; background:#f5f5f5; border:1px solid #e0e0e0; text-align:center;">计划重点批流转量</th>
                                        <th style="padding:4px 10px; background:#f5f5f5; border:1px solid #e0e0e0; text-align:center;">计划流转判定</th>
                                        <th style="padding:4px 10px; background:#f5f5f5; border:1px solid #e0e0e0; text-align:center;">特急批重量</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in _paragraphRows)
                                    {
                                        <tr>
                                            <td style="padding:4px 10px; border:1px solid #e0e0e0; font-weight:600;">@item.ParagraphName</td>
                                            <td style="padding:4px 10px; border:1px solid #e0e0e0; text-align:center;">@RenderInt(item.PendingTotal)</td>
                                            <td style="padding:4px 10px; border:1px solid #e0e0e0; text-align:center;">
                                                <MudChip Size="Size.Small" Color="@GetStatusColor(item.StatusJudgment)">@(item.StatusJudgment ?? "-")</MudChip>
                                            </td>
                                            <td style="padding:4px 10px; border:1px solid #e0e0e0; text-align:center;">@RenderInt(item.PlanFlowQuantity)</td>
                                            <td style="padding:4px 10px; border:1px solid #e0e0e0; text-align:center;">
                                                <MudChip Size="Size.Small" Color="@GetPlanFlowJudgmentColor(item.PlanFlowJudgment)">@(item.PlanFlowJudgment ?? "-")</MudChip>
                                            </td>
                                            <td style="padding:4px 10px; border:1px solid #e0e0e0; text-align:center;">@RenderInt(item.PlanKeyWeight)</td>
                                        </tr>
                                    }
                                </tbody>
                                <tfoot>
                                    <tr>
                                        <td class="col-footer-cell" style="padding:4px 10px; border:1px solid #e0e0e0; text-align:center;">合计</td>
                                        <td class="col-footer-cell col-footer-sum" style="padding:4px 10px; border:1px solid #e0e0e0; text-align:center;">@RenderInt(_paragraphRows.Sum(x => x.PendingTotal ?? 0m))</td>
                                        <td class="col-footer-cell" style="padding:4px 10px; border:1px solid #e0e0e0;"></td>
                                        <td class="col-footer-cell col-footer-sum" style="padding:4px 10px; border:1px solid #e0e0e0; text-align:center;">@RenderInt(_paragraphRows.Sum(x => x.PlanFlowQuantity ?? 0m))</td>
                                        <td class="col-footer-cell" style="padding:4px 10px; border:1px solid #e0e0e0;"></td>
                                        <td class="col-footer-cell col-footer-sum" style="padding:4px 10px; border:1px solid #e0e0e0; text-align:center;">@RenderInt(_paragraphRows.Sum(x => x.PlanKeyWeight ?? 0m))</td>
                                    </tr>
                                </tfoot>
                            </table>
                            </div>
                            }
                        </MudCardContent>
                    </MudCard>

                    @* 近日生产量 *@
                    <MudCard Class="mb-2 summary-card" Elevation="0">
                        <MudCardContent>
                            <div class="d-flex align-center mb-2">
                                <MudIconButton Icon="@(IsCardCollapsed("production:recent-production") ? Icons.Material.Filled.ExpandMore : Icons.Material.Filled.ExpandLess)"
                                               Size="Size.Small" Color="@(IsCardCollapsed("production:recent-production") ? Color.Default : Color.Primary)"
                                               OnClick="@(() => ToggleCardAsync("production:recent-production"))" Title="展开/折叠" />
                                <MudText Typo="Typo.subtitle2" Class="ml-1"><span class="report-tt report-tt-3">近日生产量数据</span></MudText>
                                <div class="ml-auto">
                                    <MudButton Variant="Variant.Text" Size="Size.Small" Color="Color.Primary"
                                               StartIcon="@Icons.Material.Filled.Print" OnClick="@(() => PrintTableAsync("#report-summary", "近日生产量数据"))">打印</MudButton>
                                </div>
                            </div>
                            @if (!IsCardCollapsed("production:recent-production"))
                            {
                            <div id="report-summary" style="overflow-x:auto;">
                                <table style="border-collapse: collapse; width: 100%; font-size: 0.8125rem;">
                                    <thead>
                                        <tr>
                                            <th style="text-align:left; padding:4px 10px; background:#f5f5f5; border:1px solid #e0e0e0;">工段</th>
                                            <th style="padding:4px 10px; background:#f5f5f5; border:1px solid #e0e0e0; text-align:center;">前6日(t)</th>
                                            <th style="padding:4px 10px; background:#f5f5f5; border:1px solid #e0e0e0; text-align:center;">前3日(t)</th>
                                            <th style="padding:4px 10px; background:#fff8e1; border:1px solid #e0e0e0; text-align:center;">今日(t)</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var r in _summaryRows)
                                        {
                                            var isTotal = r.SectionName == "合计";
                                            <tr>
                                                <td style="padding:4px 10px; border:1px solid #e0e0e0; font-weight:@(isTotal ? "700" : "600"); @(isTotal ? "background:#eef3fa;" : "")">@r.SectionName</td>
                                                <td style="padding:4px 10px; border:1px solid #e0e0e0; text-align:center; @(isTotal ? "background:#eef3fa;" : "")">@FormatT(r.Last7DaysWeight)</td>
                                                <td style="padding:4px 10px; border:1px solid #e0e0e0; text-align:center; @(isTotal ? "background:#eef3fa;" : "")">@FormatT(r.Last3DaysWeight)</td>
                                                <td style="padding:4px 10px; border:1px solid #e0e0e0; text-align:center; @(isTotal ? "background:#eef3fa;" : "background:#fff8e1;")">@FormatT(r.TodayWeight)</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                            }
                        </MudCardContent>
                    </MudCard>

                    @* 月度生产量 *@
                    <MudCard Class="mb-2 summary-card" Elevation="0">
                        <MudCardContent>
                            <div class="d-flex align-center mb-2">
                                <MudIconButton Icon="@(IsCardCollapsed("production:monthly-production") ? Icons.Material.Filled.ExpandMore : Icons.Material.Filled.ExpandLess)"
                                               Size="Size.Small" Color="@(IsCardCollapsed("production:monthly-production") ? Color.Default : Color.Primary)"
                                               OnClick="@(() => ToggleCardAsync("production:monthly-production"))" Title="展开/折叠" />
                                <MudText Typo="Typo.subtitle2" Class="ml-1"><span class="report-tt report-tt-3">月度生产量数据</span></MudText>
                                <div class="ml-auto">
                                    <MudButton Variant="Variant.Text" Size="Size.Small" Color="Color.Primary"
                                               StartIcon="@Icons.Material.Filled.Print" OnClick="@(() => PrintTableAsync("#report-monthly-production", "月度生产量数据"))">打印</MudButton>
                                </div>
                            </div>
                            @if (!IsCardCollapsed("production:monthly-production"))
                            {
                            <div id="report-monthly-production" style="overflow-x:auto;">
                                <table style="border-collapse: collapse; width: 100%; font-size: 0.8125rem;">
                                    <thead>
                                        <tr>
                                            <th style="text-align:left; padding:4px 10px; background:#f5f5f5; border:1px solid #e0e0e0;">工段</th>
                                            @foreach (var label in _monthlyLabels)
                                            {
                                                <th style="padding:4px 10px; background:#f5f5f5; border:1px solid #e0e0e0; text-align:center;">@label</th>
                                            }
                                            <th style="padding:4px 10px; background:#fff8e1; border:1px solid #e0e0e0; text-align:center;">合计(t)</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var r in _monthlyProductionRows)
                                        {
                                            var isTotal = r.SectionName == "合计";
                                            <tr>
                                                <td style="padding:4px 10px; border:1px solid #e0e0e0; font-weight:@(isTotal ? "700" : "600"); @(isTotal ? "background:#eef3fa;" : "")">@r.SectionName</td>
                                                @for (var m = 0; m < _monthlyLabels.Count; m++)
                                                {
                                                    var val = m < r.MonthlyWeights.Count ? r.MonthlyWeights[m] : 0m;
                                                    <td style="padding:4px 10px; border:1px solid #e0e0e0; text-align:center; @(isTotal ? "background:#eef3fa;" : "")">@FormatT(val)</td>
                                                }
                                                <td style="padding:4px 10px; border:1px solid #e0e0e0; text-align:center; font-weight:700; @(isTotal ? "background:#eef3fa;" : "background:#fff8e1;")">@FormatT(r.MonthlyWeights.Sum())</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                            }
                        </MudCardContent>
                    </MudCard>

                    @* 实时委外在产（厂内过滤后，按在产单位×工段二维表） *@
                    @if (_outsourcePendingData.Sections.Count > 0)
                    {
                        <MudCard Class="mb-2 summary-card" Elevation="0">
                            <MudCardContent>
                                <div class="d-flex align-center mb-2">
                                    <MudIconButton Icon="@(IsCardCollapsed("production:outsource-pending") ? Icons.Material.Filled.ExpandMore : Icons.Material.Filled.ExpandLess)"
                                                   Size="Size.Small" Color="@(IsCardCollapsed("production:outsource-pending") ? Color.Default : Color.Primary)"
                                                   OnClick="@(() => ToggleCardAsync("production:outsource-pending"))" Title="展开/折叠" />
                                    <MudText Typo="Typo.subtitle2" Class="ml-1"><span class="report-tt report-tt-4">实时委外在产</span></MudText>
                                    <div class="ml-auto">
                                        <MudButton Variant="Variant.Text" Size="Size.Small" Color="Color.Primary"
                                                   StartIcon="@Icons.Material.Filled.Print" OnClick="@(() => PrintTableAsync("#report-outsource-pending", "实时委外在产"))">打印</MudButton>
                                    </div>
                                </div>
                                @if (!IsCardCollapsed("production:outsource-pending"))
                                {
                                <div id="report-outsource-pending" style="overflow-x:auto;">
                                    <table style="border-collapse: collapse; width: 100%; font-size: 0.8125rem;">
                                        <thead>
                                            <tr>
                                                <th style="text-align:left; padding:4px 10px; background:#f5f5f5; border:1px solid #e0e0e0;">在产单位</th>
                                                @foreach (var s in _outsourcePendingData.Sections)
                                                {
                                                    <th style="padding:4px 10px; background:#f5f5f5; border:1px solid #e0e0e0; text-align:center;">@s (t)</th>
                                                }
                                                <th style="padding:4px 10px; background:#fff8e1; border:1px solid #e0e0e0; text-align:center;">合计(t)</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var r in _outsourcePendingData.Rows)
                                            {
                                                var isTotal = r.OutsourceUnit == "合计";
                                                <tr>
                                                    <td style="padding:4px 10px; border:1px solid #e0e0e0; font-weight:@(isTotal ? "700" : "600"); @(isTotal ? "background:#eef3fa;" : "")">@r.OutsourceUnit</td>
                                                    @foreach (var s in _outsourcePendingData.Sections)
                                                    {
                                                        <td style="padding:4px 10px; border:1px solid #e0e0e0; text-align:center; @(isTotal ? "background:#eef3fa;" : "")">@FormatOutsourceCell(r.Cells.TryGetValue(s, out var c) ? c : null)</td>
                                                    }
                                                    <td style="padding:4px 10px; border:1px solid #e0e0e0; text-align:center; font-weight:700; @(isTotal ? "background:#eef3fa;" : "background:#fff8e1;")">@FormatOutsourceCell(r.TotalCell)</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                                }
                            </MudCardContent>
                        </MudCard>
                    }

                    @* 月度委外（委外单位×工段，单位合并单元格，不含厂内） *@
                    @if (_monthlyOutsourceRows.Count > 0)
                    {
                        <MudCard Class="mb-2 summary-card" Elevation="0">
                            <MudCardContent>
                                <div class="d-flex align-center mb-2">
                                    <MudIconButton Icon="@(IsCardCollapsed("production:monthly-outsource") ? Icons.Material.Filled.ExpandMore : Icons.Material.Filled.ExpandLess)"
                                                   Size="Size.Small" Color="@(IsCardCollapsed("production:monthly-outsource") ? Color.Default : Color.Primary)"
                                                   OnClick="@(() => ToggleCardAsync("production:monthly-outsource"))" Title="展开/折叠" />
                                    <MudText Typo="Typo.subtitle2" Class="ml-1"><span class="report-tt report-tt-4">月度委外数据</span></MudText>
                                    <div class="ml-auto">
                                        <MudButton Variant="Variant.Text" Size="Size.Small" Color="Color.Primary"
                                                   StartIcon="@Icons.Material.Filled.Print" OnClick="@(() => PrintTableAsync("#report-monthly-outsource", "月度委外数据"))">打印</MudButton>
                                    </div>
                                </div>
                                @if (!IsCardCollapsed("production:monthly-outsource"))
                                {
                                <div id="report-monthly-outsource" style="overflow-x:auto;">
                                    <table style="border-collapse: collapse; width: 100%; font-size: 0.8125rem;">
                                        <thead>
                                            <tr>
                                                <th style="text-align:left; padding:4px 10px; background:#f5f5f5; border:1px solid #e0e0e0;">委外单位</th>
                                                <th style="text-align:left; padding:4px 10px; background:#f5f5f5; border:1px solid #e0e0e0;">工段</th>
                                                @foreach (var label in _monthlyLabels)
                                                {
                                                    <th style="padding:4px 10px; background:#f5f5f5; border:1px solid #e0e0e0; text-align:center;">@label</th>
                                                }
                                                <th style="padding:4px 10px; background:#fff8e1; border:1px solid #e0e0e0; text-align:center;">合计(t)</th>
                                                <th style="padding:4px 10px; background:#ffe0b2; border:1px solid #e0e0e0; text-align:center;">现在产(t)</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @for (var i = 0; i < _monthlyOutsourceRows.Count; i++)
                                            {
                                                var r = _monthlyOutsourceRows[i];
                                                var isTotal = r.OutsourceVendor == "合计";
                                                var isVendorFirst = i == 0 || !string.Equals(_monthlyOutsourceRows[i - 1].OutsourceVendor, r.OutsourceVendor, StringComparison.OrdinalIgnoreCase);
                                                <tr>
                                                    @if (isVendorFirst)
                                                    {
                                                        <td style="padding:4px 10px; border:1px solid #e0e0e0; font-weight:@(isTotal ? "700" : "600"); @(isTotal ? "background:#eef3fa;" : "")"
                                                            rowspan="@_vendorRowspans.GetValueOrDefault(r.OutsourceVendor, 1)">@r.OutsourceVendor</td>
                                                    }
                                                    else
                                                    {
                                                        <td style="display:none"></td>
                                                    }
                                                    <td style="padding:4px 10px; border:1px solid #e0e0e0; font-weight:@(isTotal ? "700" : "600"); @(isTotal ? "background:#eef3fa;" : "")">@r.SectionName</td>
                                                    @for (var m = 0; m < _monthlyLabels.Count; m++)
                                                    {
                                                        var mv = m < r.Months.Count ? r.Months[m] : null;
                                                        <td style="padding:4px 10px; border:1px solid #e0e0e0; text-align:center; @(isTotal ? "background:#eef3fa;" : "")">@FormatSendRecoverText3(mv?.Send ?? 0m, mv?.Recover ?? 0m, mv?.Unprocessed ?? 0m)</td>
                                                    }
                                                    <td style="padding:4px 10px; border:1px solid #e0e0e0; text-align:center; font-weight:700; @(isTotal ? "background:#eef3fa;" : "background:#fff8e1;")">@FormatSendRecoverText3(r.TotalSend, r.TotalRecover, r.TotalUnprocessed)</td>
                                                    <td style="padding:4px 10px; border:1px solid #e0e0e0; text-align:center; font-weight:700; @(isTotal ? "background:#ffe0b2;" : "background:#fff3e0;")">@FormatNowInProduction(r.NowInProduction)</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                                }
                            </MudCardContent>
                        </MudCard>
                    }

                    @* 委外单位往来数据（同源委外单位档案：排除本厂 IsWorkshop，默认折叠；展开显 10 行可切换；身份列点击排序 + 搜索；合计按显示行） *@
                    <MudCard Class="mb-2 summary-card" Elevation="0">
                        <MudCardContent>
                            <div class="d-flex align-center mb-2">
                                <MudIconButton Icon="@(IsCardCollapsed("report:outsource-trade") ? Icons.Material.Filled.ExpandMore : Icons.Material.Filled.ExpandLess)"
                                               Size="Size.Small" Color="@(IsCardCollapsed("report:outsource-trade") ? Color.Default : Color.Primary)"
                                               OnClick="@(() => ToggleCardAsync("report:outsource-trade"))" Title="展开/折叠" />
                                <MudText Typo="Typo.subtitle2" Class="ml-1"><span class="report-tt report-tt-5">委外单位往来数据</span></MudText>
                                <MudText Typo="Typo.caption" Class="text-hint ml-2">同源「委外单位管理」列表（不含本厂）｜单数(蓝)/吨(绿)/万元(橙) 取整，0 省略</MudText>
                                <div class="ml-auto">
                                    <MudButton Variant="Variant.Text" Size="Size.Small" Color="Color.Primary"
                                               StartIcon="@Icons.Material.Filled.Print"
                                               OnClick="@(() => PrintTableAsync("#report-outsource-trade", "生产执行-委外单位往来数据", "report:outsource-trade"))"
                                               Disabled="@(!_outsourceTradeRows.Any())">打印</MudButton>
                                </div>
                            </div>
                            @if (!IsCardCollapsed("report:outsource-trade"))
                            {
                                var outsourceRows = OutsourceTradeShown();
                                @* 工具栏：外层 gap 16px 作为「组间隔离」，组内 gap 6px 紧凑（参照「客户往来数据」/「投料产出总况」日期范围组合） *@
                                <div class="d-flex align-center mb-2" style="gap:16px; flex-wrap:wrap;">
                                    <MudTextField T="string" @bind-Value="_outsourceTradeKeyword" Immediate="true" Variant="Variant.Outlined"
                                                  Dense="true" Margin="Margin.Dense" Style="width:220px" Label="搜索委外单位名/工段" />
                                    @* 发出日期区间（2026-09-14）：任一端填写即「区间委外」生效；起/止/应用/清除 = 一个整体 *@
                                    <div class="d-flex align-center" style="gap:6px;">
                                        <MudTextField T="string" @bind-Value="_outsourceTradeSendFrom" Immediate="true" Variant="Variant.Outlined"
                                                      Dense="true" Margin="Margin.Dense" Style="width:140px" Label="发出日期起"
                                                      Placeholder="yyyy-MM-dd" />
                                        <MudTextField T="string" @bind-Value="_outsourceTradeSendTo" Immediate="true" Variant="Variant.Outlined"
                                                      Dense="true" Margin="Margin.Dense" Style="width:140px" Label="发出日期止"
                                                      Placeholder="yyyy-MM-dd" />
                                        <MudButton Variant="Variant.Outlined" Size="Size.Small" Color="Color.Primary"
                                                   OnClick="OnOutsourceTradeSendChangedAsync">应用发出区间</MudButton>
                                        <MudButton Variant="Variant.Text" Size="Size.Small"
                                                   OnClick="@(() => { _outsourceTradeSendFrom = ""; _outsourceTradeSendTo = ""; return OnOutsourceTradeSendChangedAsync(); })"
                                                   Disabled="@(!OutsourceTradeSendRangeMode)">清除</MudButton>
                                    </div>
                                    <MudDivider Vertical="true" FlexItem="true" Style="height:28px;" />
                                    @* 回收日期区间（2026-09-14）：与发出区间互相独立、可叠加；起/止/应用/清除 = 一个整体 *@
                                    <div class="d-flex align-center" style="gap:6px;">
                                        <MudTextField T="string" @bind-Value="_outsourceTradeRecoveryFrom" Immediate="true" Variant="Variant.Outlined"
                                                      Dense="true" Margin="Margin.Dense" Style="width:140px" Label="回收日期起"
                                                      Placeholder="yyyy-MM-dd" />
                                        <MudTextField T="string" @bind-Value="_outsourceTradeRecoveryTo" Immediate="true" Variant="Variant.Outlined"
                                                      Dense="true" Margin="Margin.Dense" Style="width:140px" Label="回收日期止"
                                                      Placeholder="yyyy-MM-dd" />
                                        <MudButton Variant="Variant.Outlined" Size="Size.Small" Color="Color.Primary"
                                                   OnClick="OnOutsourceTradeRecoveryChangedAsync">应用回收区间</MudButton>
                                        <MudButton Variant="Variant.Text" Size="Size.Small"
                                                   OnClick="@(() => { _outsourceTradeRecoveryFrom = ""; _outsourceTradeRecoveryTo = ""; return OnOutsourceTradeRecoveryChangedAsync(); })"
                                                   Disabled="@(!OutsourceTradeRecoveryRangeMode)">清除</MudButton>
                                    </div>
                                    @* 显示行数 + 计数注释 = 一个整体 *@
                                    <div class="d-flex align-center" style="gap:6px;">
                                        <MudSelect T="int" @bind-Value="_outsourceTradeTake" Dense="true" Variant="Variant.Outlined"
                                                   Margin="Margin.Dense" Style="width:110px" Label="显示行数">
                                            <MudSelectItem T="int" Value="10">10 行</MudSelectItem>
                                            <MudSelectItem T="int" Value="20">20 行</MudSelectItem>
                                            <MudSelectItem T="int" Value="50">50 行</MudSelectItem>
                                            <MudSelectItem T="int" Value="0">全部</MudSelectItem>
                                        </MudSelect>
                                        <MudText Typo="Typo.caption" Class="text-hint">显示 @outsourceRows.Count / 共 @OutsourceTradeVisible().Count 条｜合计按显示行计</MudText>
                                    </div>
                                    @if (OutsourceTradeAnyRangeMode)
                                    {
                                        <MudButton Variant="Variant.Text" Size="Size.Small"
                                                   OnClick="ClearOutsourceTradeRangeAsync">清空全部区间</MudButton>
                                    }
                                </div>
                                @if (OutsourceTradeAnyRangeMode)
                                {
                                    <MudText Typo="Typo.caption" Class="text-hint mb-2">
                                        @OutsourceTradeRangeHint()
                                    </MudText>
                                }
                                @if (outsourceRows.Count == 0)
                                {
                                    <MudText Typo="Typo.body2" Class="text-hint">暂无委外单位往来数据</MudText>
                                }
                                else
                                {
                                    <div id="report-outsource-trade" style="overflow-x:auto; max-height:50vh; overflow-y:auto;">
                                        <table style="border-collapse: collapse; width: 100%; font-size: 0.8125rem;">
                                            <thead>
                                                <tr>
                                                    <th class="report-th-sort@(OutsourceTradeSortedClass("vendor"))" @onclick="@(() => SortOutsourceTrade("vendor"))" title="点击排序">委外单位名</th>
                                                    <th class="report-th-sort@(OutsourceTradeSortedClass("section"))" @onclick="@(() => SortOutsourceTrade("section"))" title="点击排序">委外工段</th>
                                                    <th style="padding:4px 10px; background:#f5f5f5; border:1px solid #e0e0e0; text-align:center;">累计委外</th>
                                                    <th style="padding:4px 10px; background:#f5f5f5; border:1px solid #e0e0e0; text-align:center;">@OutsourceTradeHeader("YearOrder")</th>
                                                    <th style="padding:4px 10px; background:#f5f5f5; border:1px solid #e0e0e0; text-align:center;">@OutsourceTradeHeader("YearRecovered")</th>
                                                    @* 存量列表头强调色（2026-09-14）：委外未回收=冷紫，与「客户往来数据」待在产同源 *@
                                                    <th style="padding:4px 10px; background:#f3e5f5; color:#6A1B9A; border:1px solid #e0e0e0; border-bottom:2px solid #ce93d8; text-align:center; font-weight:700;">委外未回收</th>
                                                    <th style="padding:4px 10px; background:#f5f5f5; border:1px solid #e0e0e0; text-align:center;">@OutsourceTradeHeader("YearReturn")</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var r in outsourceRows)
                                                {
                                                    <tr>
                                                        <td style="padding:4px 10px; border:1px solid #e0e0e0;">@r.VendorName</td>
                                                        <td style="padding:4px 10px; border:1px solid #e0e0e0;">@OutsourceSectionText(r)</td>
                                                        <td style="padding:4px 10px; border:1px solid #e0e0e0; text-align:center;">@OutsourceTradeCell(r, "TotalOrder")</td>
                                                        <td style="padding:4px 10px; border:1px solid #e0e0e0; text-align:center;">@OutsourceTradeCell(r, "YearOrder")</td>
                                                        <td style="padding:4px 10px; border:1px solid #e0e0e0; text-align:center;">@OutsourceTradeCell(r, "YearRecovered")</td>
                                                        <td style="padding:4px 10px; border:1px solid #e0e0e0; text-align:center;">@OutsourceTradeCell(r, "Pending")</td>
                                                        <td style="padding:4px 10px; border:1px solid #e0e0e0; text-align:center;">@OutsourceTradeCell(r, "YearReturn")</td>
                                                    </tr>
                                                }
                                            </tbody>
                                            <tfoot>
                                                <tr>
                                                    <td colspan="2" style="padding:4px 10px; border:1px solid #e0e0e0; font-weight:700; background:#fffde7;">合计</td>
                                                    <td style="padding:4px 10px; border:1px solid #e0e0e0; text-align:center; font-weight:700; background:#fffde7;">@OutsourceTradeSummary(outsourceRows, "TotalOrder")</td>
                                                    <td style="padding:4px 10px; border:1px solid #e0e0e0; text-align:center; font-weight:700; background:#fffde7;">@OutsourceTradeSummary(outsourceRows, "YearOrder")</td>
                                                    <td style="padding:4px 10px; border:1px solid #e0e0e0; text-align:center; font-weight:700; background:#fffde7;">@OutsourceTradeSummary(outsourceRows, "YearRecovered")</td>
                                                    <td style="padding:4px 10px; border:1px solid #e0e0e0; text-align:center; font-weight:700; background:#fffde7;">@OutsourceTradeSummary(outsourceRows, "Pending")</td>
                                                    <td style="padding:4px 10px; border:1px solid #e0e0e0; text-align:center; font-weight:700; background:#fffde7;">@OutsourceTradeSummary(outsourceRows, "YearReturn")</td>
                                                </tr>
                                            </tfoot>
                                        </table>
                                    </div>
                                }
                            }
                        </MudCardContent>
                    </MudCard>
                }
            </div>
        </MudTabPanel>

        @* ========== Tab6 质量管理：不合格品实时待处理 + 不合格品月度汇总 + 待检批支重汇总 + 近日成检量 + 月度成检量 ========== *@
        <MudTabPanel Text="质量管理" Icon="@Icons.Material.Filled.FactCheck">
            <div class="pa-2">
                @if (_loading[5])
                {
                    <div class="d-flex align-center" style="gap:8px;">
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                        <span>质量管理加载中...</span>
                    </div>
                }
                else if (_failed[5])
                {
                    <MudAlert Severity="Severity.Error">@_errorMessages[5]</MudAlert>
                }
                else
                {
                    @* 不合格品实时待处理（NCR 上下文） *@
                    <MudCard Class="mb-2 summary-card" Elevation="0">
                        <MudCardContent>
                            <div class="d-flex align-center mb-2">
                                <MudIconButton Icon="@(IsCardCollapsed("quality:ncr-pending") ? Icons.Material.Filled.ExpandMore : Icons.Material.Filled.ExpandLess)"
                                               Size="Size.Small" Color="@(IsCardCollapsed("quality:ncr-pending") ? Color.Default : Color.Primary)"
                                               OnClick="@(() => ToggleCardAsync("quality:ncr-pending"))" Title="展开/折叠" />
                                <MudText Typo="Typo.subtitle2" Class="ml-1"><span class="report-tt report-tt-1">不合格品实时待处理</span></MudText>
                                <div class="ml-auto">
                                    <MudButton Variant="Variant.Text" Size="Size.Small" Color="Color.Primary"
                                               StartIcon="@Icons.Material.Filled.Print" OnClick="@(() => PrintTableAsync("#report-ncr-pending", "不合格品实时待处理", "quality:ncr-pending"))">打印</MudButton>
                                </div>
                            </div>
                            @if (!IsCardCollapsed("quality:ncr-pending"))
                            {
                            <div id="report-ncr-pending" style="overflow-x:auto;">
                                @if (_ncrPendingItems.Count == 0)
                                {
                                    <MudText Typo="Typo.body2" Class="text-hint">暂无待处理的不合格品。</MudText>
                                }
                                else
                                {
                                <table style="border-collapse: collapse; width: 100%; font-size: 0.8125rem;">
                                    <thead>
                                        <tr>
                                            <th style="text-align:left; padding:4px 10px; background:#f5f5f5; border:1px solid #e0e0e0;">反馈日期</th>
                                            <th style="text-align:left; padding:4px 10px; background:#f5f5f5; border:1px solid #e0e0e0;">反馈部门</th>
                                            <th style="text-align:left; padding:4px 10px; background:#f5f5f5; border:1px solid #e0e0e0;">物料类型</th>
                                            <th style="text-align:left; padding:4px 10px; background:#f5f5f5; border:1px solid #e0e0e0;">工单号</th>
                                            <th style="text-align:left; padding:4px 10px; background:#f5f5f5; border:1px solid #e0e0e0;">生产编号</th>
                                            <th style="text-align:left; padding:4px 10px; background:#f5f5f5; border:1px solid #e0e0e0;">牌号</th>
                                            <th style="text-align:left; padding:4px 10px; background:#f5f5f5; border:1px solid #e0e0e0;">规格</th>
                                            <th style="padding:4px 10px; background:#f5f5f5; border:1px solid #e0e0e0; text-align:center;">次品支数</th>
                                            <th style="padding:4px 10px; background:#f5f5f5; border:1px solid #e0e0e0; text-align:center;">次品重量</th>
                                            <th style="text-align:left; padding:4px 10px; background:#f5f5f5; border:1px solid #e0e0e0;">问题描述</th>
                                            <th style="padding:4px 10px; background:#f5f5f5; border:1px solid #e0e0e0; text-align:center;">流向</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var item in _ncrPendingItems)
                                        {
                                            <tr>
                                                <td style="padding:4px 10px; border:1px solid #e0e0e0; white-space:nowrap;">@item.ReportDate.ToString("yyyy-MM-dd")</td>
                                                <td style="padding:4px 10px; border:1px solid #e0e0e0; white-space:nowrap;">@GetNcrPendingReportDepartment(item)</td>
                                                <td style="padding:4px 10px; border:1px solid #e0e0e0; white-space:nowrap;">@GetNcrPendingPipeCategoryText(item)</td>
                                                <td style="padding:4px 10px; border:1px solid #e0e0e0; white-space:nowrap;">@item.WorkOrderNo</td>
                                                <td style="padding:4px 10px; border:1px solid #e0e0e0; white-space:nowrap;">
                                                    @if (item.ProductionBatchId > 0)
                                                    {
                                                        <MudLink Typo="Typo.body2" OnClick="@(() => OpenBatchDetail(item.ProductionBatchId))">@item.BatchNo</MudLink>
                                                    }
                                                    else
                                                    {
                                                        @item.BatchNo
                                                    }
                                                </td>
                                                <td style="padding:4px 10px; border:1px solid #e0e0e0; white-space:nowrap;">@item.PlantGrade</td>
                                                <td style="padding:4px 10px; border:1px solid #e0e0e0; white-space:nowrap;">@item.Specification</td>
                                                <td style="padding:4px 10px; border:1px solid #e0e0e0; text-align:center;">@item.DefectQuantity</td>
                                                <td style="padding:4px 10px; border:1px solid #e0e0e0; text-align:center;">@(item.DefectiveWeight?.ToString() ?? "-")</td>
                                                <td style="padding:4px 10px; border:1px solid #e0e0e0;">@item.DefectDescription</td>
                                                <td style="padding:4px 10px; border:1px solid #e0e0e0; text-align:center; white-space:nowrap;">@(item.FlowDirection.HasValue ? DisplayHelper.GetFlowDirectionText(item.FlowDirection.Value) : "-")</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                                }
                            </div>
                            <MudText Typo="Typo.body2" Class="text-hint" Style="margin-top:4px; font-size:0.75rem;">
                                注：不合格品实时待处理列表（尚未建档不合格报告的检验批次，与不合格报告页待处理口径一致）；反馈部门=来源+检验项目、物料类型按检验来源判定，与不合格报告自动填充口径一致。
                            </MudText>
                            }
                        </MudCardContent>
                    </MudCard>

                    @* 不合格品月度汇总（NCR 上下文） *@
                    <MudCard Class="mb-2 summary-card" Elevation="0">
                        <MudCardContent>
                            <div class="d-flex align-center mb-2">
                                <MudIconButton Icon="@(IsCardCollapsed("quality:ncr-monthly") ? Icons.Material.Filled.ExpandMore : Icons.Material.Filled.ExpandLess)"
                                               Size="Size.Small" Color="@(IsCardCollapsed("quality:ncr-monthly") ? Color.Default : Color.Primary)"
                                               OnClick="@(() => ToggleCardAsync("quality:ncr-monthly"))" Title="展开/折叠" />
                                <MudText Typo="Typo.subtitle2" Class="ml-1"><span class="report-tt report-tt-1">不合格品月度汇总</span></MudText>
                                <div class="ml-auto">
                                    <MudButton Variant="Variant.Text" Size="Size.Small" Color="Color.Primary"
                                               StartIcon="@Icons.Material.Filled.Print" OnClick="PrintNcrMonthlySummaryAsync">打印</MudButton>
                                </div>
                            </div>
                            @if (!IsCardCollapsed("quality:ncr-monthly"))
                            {
                            <div id="report-ncr-monthly-summary" style="overflow-x:auto;">
                                @if (_ncrMonthlySummary == null || _ncrMonthlyRows.Count == 0)
                                {
                                    <MudText Typo="Typo.body2" Class="text-hint">暂无数据。</MudText>
                                }
                                else
                                {
                                <table style="border-collapse: collapse; width: 100%; font-size: 0.8125rem;">
                                    <thead>
                                        <tr>
                                            <th style="text-align:left; padding:4px 10px; background:#f5f5f5; border:1px solid #e0e0e0;">责任类别</th>
                                            <th style="text-align:left; padding:4px 10px; background:#f5f5f5; border:1px solid #e0e0e0;">责任部门</th>
                                            <th style="padding:4px 10px; background:#f5f5f5; border:1px solid #e0e0e0; text-align:center;">处置方式</th>
                                            @foreach (var label in _ncrMonthlySummary.MonthLabels)
                                            {
                                                <th style="padding:4px 10px; background:#f5f5f5; border:1px solid #e0e0e0; text-align:center;">@label</th>
                                            }
                                            <th style="padding:4px 10px; background:#fff8e1; border:1px solid #e0e0e0; text-align:center; font-weight:600;">合计</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @for (var i = 0; i < _ncrMonthlyRows.Count; i++)
                                        {
                                            var r = _ncrMonthlyRows[i];
                                            var catRowspan = _ncrCategoryRowspans[i];
                                            var deptRowspan = _ncrDeptRowspans[i];
                                            var catLabel = r.CategoryDisplay == "未填写" ? "-" : r.CategoryDisplay;
                                            var deptLabel = r.ResponsibleDept == "未填写" ? "-" : r.ResponsibleDept;
                                            <tr>
                                                @if (catRowspan > 0)
                                                {
                                                    <td style="padding:4px 10px; border:1px solid #e0e0e0; font-weight:600; white-space:nowrap;" rowspan="@catRowspan">@catLabel</td>
                                                }
                                                @if (deptRowspan > 0)
                                                {
                                                    <td style="padding:4px 10px; border:1px solid #e0e0e0; font-weight:600; white-space:nowrap;" rowspan="@deptRowspan">@deptLabel</td>
                                                }
                                                <td style="padding:4px 10px; border:1px solid #e0e0e0; text-align:center; white-space:nowrap;">@r.DisposalMethodDisplay</td>
                                                @for (var m = 0; m < _ncrMonthlySummary.MonthLabels.Count; m++)
                                                {
                                                    <td style="padding:4px 10px; border:1px solid #e0e0e0; text-align:center; white-space:nowrap;">@(m > _ncrMonthlySummary.CurrentMonthIndex ? string.Empty : FormatNcrCell(r.Months[m].Quantity, r.Months[m].Weight))</td>
                                                }
                                                <td style="padding:4px 10px; border:1px solid #e0e0e0; text-align:center; white-space:nowrap; font-weight:600; background:#fffde7;">@FormatNcrCell(r.TotalQuantity, r.TotalWeight)</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                                <MudText Typo="Typo.body2" Class="text-hint" Style="margin-top:4px; font-size:0.75rem;">
                                    注：按（责任类别→责任部门→处置方式）三级分组，分月基准=反馈日期（本年）；单元格「X支/YKg」，为 0 的部分省略；当前月份为 @(_ncrMonthlySummary.CurrentMonthIndex + 1) 月，之后月份尚未发生、单元格留空；责任类别/责任部门为空显示「-」；「合计」=该处置方式全年（12 个月）合计量。
                                </MudText>
                                }
                            </div>
                            }
                        </MudCardContent>
                    </MudCard>

                    @* 待检批支重汇总（成检计划上下文） *@
                    <MudCard Class="mb-2 summary-card" Elevation="0">
                        <MudCardContent>
                            <div class="d-flex align-center mb-2">
                                <MudIconButton Icon="@(IsCardCollapsed("quality:inspection-plan") ? Icons.Material.Filled.ExpandMore : Icons.Material.Filled.ExpandLess)"
                                               Size="Size.Small" Color="@(IsCardCollapsed("quality:inspection-plan") ? Color.Default : Color.Primary)"
                                               OnClick="@(() => ToggleCardAsync("quality:inspection-plan"))" Title="展开/折叠" />
                                <MudText Typo="Typo.subtitle2" Class="ml-1"><span class="report-tt report-tt-2">待检批支重汇总</span></MudText>
                                <div class="ml-auto">
                                    <MudButton Variant="Variant.Text" Size="Size.Small" Color="Color.Primary"
                                               StartIcon="@Icons.Material.Filled.Print" OnClick="@(() => PrintTableAsync("#report-inspection-plan-summary", "待检批支重汇总"))">打印</MudButton>
                                </div>
                            </div>
                            @if (!IsCardCollapsed("quality:inspection-plan"))
                            {
                            <div id="report-inspection-plan-summary" style="overflow-x:auto;">
                                <table style="border-collapse: collapse; width: 100%; font-size: 0.8125rem;">
                                    <thead>
                                        <tr>
                                            <th style="text-align:left; padding:4px 10px; background:#f5f5f5; border:1px solid #e0e0e0;">检验项</th>
                                            <th style="padding:4px 10px; background:#f5f5f5; border:1px solid #e0e0e0; text-align:center;">待到料</th>
                                            <th style="padding:4px 10px; background:#f5f5f5; border:1px solid #e0e0e0; text-align:center;">待检验+检验中</th>
                                            <th style="padding:4px 10px; background:#eef3fa; border:1px solid #e0e0e0; text-align:center; font-weight:600;">汇总数据</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var r in _inspectionPlanSummaryRows)
                                        {
                                            <tr>
                                                <td style="padding:4px 10px; border:1px solid #e0e0e0; font-weight:600; white-space:nowrap;">@r.InspectionItemName</td>
                                                <td style="padding:4px 10px; border:1px solid #e0e0e0; text-align:center; white-space:nowrap;">@RenderSummaryCell(r.WaitingMaterialCount, r.WaitingMaterialQuantity, r.WaitingMaterialWeight)</td>
                                                <td style="padding:4px 10px; border:1px solid #e0e0e0; text-align:center; white-space:nowrap;">@RenderSummaryCell(r.WaitingInspectionCount + r.InspectingCount, r.WaitingInspectionQuantity + r.InspectingQuantity, r.WaitingInspectionWeight + r.InspectingWeight)</td>
                                                <td style="padding:4px 10px; border:1px solid #e0e0e0; text-align:center; white-space:nowrap; font-weight:600; background:#eef3fa;">@RenderSummaryCell(r.TotalCount, r.TotalQuantity, r.TotalWeight)</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                            <MudText Typo="Typo.body2" Class="text-hint" Style="margin-top:4px; font-size:0.75rem;">
                                注：某检验项统计「要求该检验项且尚未完成该检验」的看板批次，按待到料/待检验+检验中分列；已检完该检验项的批次（含「完成检验待入库」档）不计入；每格=批次数/生产支数/生产重量(kg)；0 值显示 "-"；预+正式合并、按批次去重；汇总数据=两档之和。
                            </MudText>
                            }
                        </MudCardContent>
                    </MudCard>

                    @* 近日成检量数据（成品检验上下文） *@
                    <MudCard Class="mb-2 summary-card" Elevation="0">
                        <MudCardContent>
                            <div class="d-flex align-center mb-2">
                                <MudIconButton Icon="@(IsCardCollapsed("quality:recent-inspection") ? Icons.Material.Filled.ExpandMore : Icons.Material.Filled.ExpandLess)"
                                               Size="Size.Small" Color="@(IsCardCollapsed("quality:recent-inspection") ? Color.Default : Color.Primary)"
                                               OnClick="@(() => ToggleCardAsync("quality:recent-inspection"))" Title="展开/折叠" />
                                <MudText Typo="Typo.subtitle2" Class="ml-1"><span class="report-tt report-tt-3">近日成检量数据</span></MudText>
                                <div class="ml-auto">
                                    <MudButton Variant="Variant.Text" Size="Size.Small" Color="Color.Primary"
                                               StartIcon="@Icons.Material.Filled.Print" OnClick="@(() => PrintTableAsync("#report-recent-inspection", "近日成检量数据"))">打印</MudButton>
                                </div>
                            </div>
                            @if (!IsCardCollapsed("quality:recent-inspection"))
                            {
                            <div id="report-recent-inspection" style="overflow-x:auto;">
                                <table style="border-collapse: collapse; width: 100%; font-size: 0.8125rem;">
                                    <thead>
                                        <tr>
                                            <th style="text-align:left; padding:4px 10px; background:#f5f5f5; border:1px solid #e0e0e0;">检验项目</th>
                                            <th style="padding:4px 10px; background:#f5f5f5; border:1px solid #e0e0e0; text-align:center;">前6日(t)</th>
                                            <th style="padding:4px 10px; background:#f5f5f5; border:1px solid #e0e0e0; text-align:center;">前3日(t)</th>
                                            <th style="padding:4px 10px; background:#fff8e1; border:1px solid #e0e0e0; text-align:center;">今日(t)</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var r in _recentInspectionRows)
                                        {
                                            var isTotal = r.InspectionItem == "合计";
                                            <tr>
                                                <td style="padding:4px 10px; border:1px solid #e0e0e0; font-weight:@(isTotal ? "700" : "600"); @(isTotal ? "background:#eef3fa;" : "")">@r.InspectionItem</td>
                                                <td style="padding:4px 10px; border:1px solid #e0e0e0; text-align:center; @(isTotal ? "background:#eef3fa;" : "")">@FormatT(r.Last7DaysWeight)</td>
                                                <td style="padding:4px 10px; border:1px solid #e0e0e0; text-align:center; @(isTotal ? "background:#eef3fa;" : "")">@FormatT(r.Last3DaysWeight)</td>
                                                <td style="padding:4px 10px; border:1px solid #e0e0e0; text-align:center; @(isTotal ? "background:#eef3fa;" : "background:#fff8e1;")">@FormatT(r.TodayWeight)</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                            <MudText Typo="Typo.body2" Class="text-hint" Style="margin-top:4px; font-size:0.75rem;">
                                注：前6日/前3日均不含今日，今日列为实时数据（浅黄底色）；按检验项目统计检验重量（成品检验记录 Weight，预检/终检合并，与成品检验页口径一致）；合计行=各检验项目之和；0 值留空。
                            </MudText>
                            }
                        </MudCardContent>
                    </MudCard>

                    @* 月度成检量数据（成品检验上下文） *@
                    <MudCard Class="mb-2 summary-card" Elevation="0">
                        <MudCardContent>
                            <div class="d-flex align-center mb-2">
                                <MudIconButton Icon="@(IsCardCollapsed("quality:monthly-inspection") ? Icons.Material.Filled.ExpandMore : Icons.Material.Filled.ExpandLess)"
                                               Size="Size.Small" Color="@(IsCardCollapsed("quality:monthly-inspection") ? Color.Default : Color.Primary)"
                                               OnClick="@(() => ToggleCardAsync("quality:monthly-inspection"))" Title="展开/折叠" />
                                <MudText Typo="Typo.subtitle2" Class="ml-1"><span class="report-tt report-tt-3">月度成检量数据</span></MudText>
                                <div class="ml-auto">
                                    <MudButton Variant="Variant.Text" Size="Size.Small" Color="Color.Primary"
                                               StartIcon="@Icons.Material.Filled.Print" OnClick="@(() => PrintTableAsync("#report-monthly-inspection", "月度成检量数据"))">打印</MudButton>
                                </div>
                            </div>
                            @if (!IsCardCollapsed("quality:monthly-inspection"))
                            {
                            <div id="report-monthly-inspection" style="overflow-x:auto;">
                                <table style="border-collapse: collapse; width: 100%; font-size: 0.8125rem;">
                                    <thead>
                                        <tr>
                                            <th style="text-align:left; padding:4px 10px; background:#f5f5f5; border:1px solid #e0e0e0;">检验项目</th>
                                            @foreach (var label in _monthlyInspectionLabels)
                                            {
                                                <th style="padding:4px 10px; background:#f5f5f5; border:1px solid #e0e0e0; text-align:center;">@label</th>
                                            }
                                            <th style="padding:4px 10px; background:#fff8e1; border:1px solid #e0e0e0; text-align:center;">合计(t)</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var r in _monthlyInspectionRows)
                                        {
                                            var isTotal = r.InspectionItem == "合计";
                                            <tr>
                                                <td style="padding:4px 10px; border:1px solid #e0e0e0; font-weight:@(isTotal ? "700" : "600"); @(isTotal ? "background:#eef3fa;" : "")">@r.InspectionItem</td>
                                                @for (var m = 0; m < _monthlyInspectionLabels.Count; m++)
                                                {
                                                    var val = m < r.MonthlyWeights.Count ? r.MonthlyWeights[m] : 0m;
                                                    <td style="padding:4px 10px; border:1px solid #e0e0e0; text-align:center; @(isTotal ? "background:#eef3fa;" : "")">@FormatT(val)</td>
                                                }
                                                <td style="padding:4px 10px; border:1px solid #e0e0e0; text-align:center; font-weight:700; @(isTotal ? "background:#eef3fa;" : "background:#fff8e1;")">@FormatT(r.MonthlyWeights.Sum())</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                            <MudText Typo="Typo.body2" Class="text-hint" Style="margin-top:4px; font-size:0.75rem;">
                                注：按本年度各月份统计；按检验项目统计检验重量（成品检验记录 Weight，预检/终检合并，与成品检验页口径一致）；末列"合计"=该行 1月~12月之和；0 值留空。
                            </MudText>
                            }
                        </MudCardContent>
                    </MudCard>
                }
            </div>
        </MudTabPanel>

        @* ========== Tab7 仓库报表：嵌入物料进出存报表 ========== *@
        <MudTabPanel Text="仓库报表" Icon="@Icons.Material.Filled.Warehouse">
            <div class="pa-2">
                <MonthlyStock @key="_refreshKey" />
            </div>
        </MudTabPanel>

    </MudTabs>
</MudContainer>
