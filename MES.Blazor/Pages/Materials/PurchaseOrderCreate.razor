@page "/purchase-orders/create"
@using MES.Blazor.Services
@using MES.Blazor.Shared
@using MES.Blazor.Helpers
@using MES.Core.Enums
@using MES.Core.DTOs.Materials
@using MES.Core.DTOs.WorkOrder
@using Microsoft.AspNetCore.Authorization
@inject PurchaseOrderService PurchaseService
@inject SupplierService SupplierService
@inject WorkOrderService WorkOrderService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject IJSRuntime JS
@attribute [Authorize(Roles = Roles.Policies.MaterialRead)]

<MudContainer MaxWidth="MaxWidth.False" Class="mt-4">
    <MudCard>
        <MudCardHeader>
            <CardHeaderContent>
                <MudText Typo="Typo.h5" Class="font-weight-bold"><MudIcon Icon="@Icons.Material.Filled.ShoppingCart" Class="mr-2" Color="Color.Primary" />新建采购订单</MudText>
            </CardHeaderContent>
            <CardHeaderActions>
                <MudButton Variant="Variant.Text" OnClick="GoBack">返回</MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAll" Loading="@isSubmitting">
                    保存
                </MudButton>
            </CardHeaderActions>
        </MudCardHeader>

        <MudCardContent>
            @* 工单采购执行状态（未采购/部分采购） *@
            @if (procurementItems.Any())
            {
                var noneCount = procurementItems.Count(x => x.StatusText == "未采购");
                var partialCount = procurementItems.Count(x => x.StatusText == "部分采购");
                <MudPaper Class="pa-3 mb-3 form-card" Elevation="0">
                    <div Class="d-flex align-center" style="cursor: pointer;" @onclick="ToggleProcurementStatus">
                        <MudIcon Icon="@Icons.Material.Filled.Info" Color="Color.Info" Class="mr-2" />
                        <MudText Typo="Typo.body1" Class="font-weight-bold flex-grow-1">工单采购计划执行状态</MudText>
                        <MudChip Size="Size.Small" Color="Color.Error" Class="mr-1">未采购 @noneCount</MudChip>
                        <MudChip Size="Size.Small" Color="Color.Warning" Class="mr-1">部分采购 @partialCount</MudChip>
                        <MudIcon Icon="@(showProcurementStatus ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)" Color="Color.Default" />
                    </div>
                    @if (showProcurementStatus)
                    {
                        <div style="overflow-x: auto; overflow-y: auto; margin-top: 8px; max-height: 25vh;">
                            <MudTable T="ProcurementStatusDto" Items="@procurementItems" Dense="true" Hover="true" Elevation="0" Class="auto-table">
                                <HeaderContent>
                                    <MudTh Style="width: 120px;">工单号</MudTh>
                                    <MudTh Style="width: 90px;">物料分类</MudTh>
                                    <MudTh Style="width: 100px;" Class="text-right">计划总量(kg)</MudTh>
                                    <MudTh Style="width: 100px;" Class="text-right">已采购(kg)</MudTh>
                                    <MudTh Style="width: 100px;" Class="text-right">缺少量(kg)</MudTh>
                                    <MudTh Style="width: 90px;">工单关注</MudTh>
                                    <MudTh Style="width: 90px;">原锁执行</MudTh>
                                    <MudTh Style="width: 90px;">工单计划性</MudTh>
                                    <MudTh Style="width: 90px;">状态</MudTh>
                                </HeaderContent>
                                <RowTemplate>
                                    <MudTd>
                                        <MudText Class="text-link" @onclick="@(() => AddRowFromProcurement(context))">
                                            @context.WorkOrderNo
                                        </MudText>
                                    </MudTd>
                                    <MudTd>@DisplayHelper.GetMaterialTypeText(context.MaterialCategory)</MudTd>
                                    <MudTd Class="text-right">@context.PlanWeight.ToString("G29")</MudTd>
                                    <MudTd Class="text-right">@context.PurchaseWeight.ToString("G29")</MudTd>
                                    <MudTd Class="text-right">@context.MissingWeight.ToString("G29")</MudTd>
                                    <MudTd>@IntStatusDisplayHelper.GetScheduleStageText(context.ExecutionScheduleStage, "-")</MudTd>
                                    <MudTd>@(context.ExecutionRawMaterialLockRemark != null ? (DictValueDisplayHelper.GetText(DictValueDefaults.RawMaterialLockRemarkKey, context.ExecutionRawMaterialLockRemark) ?? "-") : "-")</MudTd>
                                    <MudTd>@(context.ExecutionUrgencyLevel != null ? (DictValueDisplayHelper.GetText(DictValueDefaults.UrgencyLevelKey, context.ExecutionUrgencyLevel) ?? "-") : "-")</MudTd>
                                    <MudTd>
                                        <MudChip Size="Size.Small" Color="@(context.StatusText == "未采购" ? Color.Error : Color.Warning)">
                                            @context.StatusText
                                        </MudChip>
                                    </MudTd>
                                </RowTemplate>
                            </MudTable>
                        </div>
                    }
                </MudPaper>
            }

            <div class="d-flex justify-space-between align-center mb-3">
                <MudText Typo="Typo.subtitle1">采购订单列表</MudText>
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="AddRow">添加订单</MudButton>
            </div>

            <div id="purchase-order-create-table"><div style="overflow-x: auto;">
                    <MudTable T="PurchaseOrderRow" Items="@rows" Dense="true" Hover="true" Elevation="0" Class="auto-table">
                        <HeaderContent>
                            <MudTh Style="width: 40px;">行号</MudTh>
                            <MudTh Style="width: 120px;">下单日期</MudTh>
                            <MudTh Style="width: 140px;">来源工单号</MudTh>
                            <MudTh Style="width: 100px;">物料分类<span class="required-star">*</span></MudTh>
                            <MudTh Style="width: 100px;">厂内钢种<span class="required-star">*</span></MudTh>
                            <MudTh Style="width: 120px;">规格<span class="required-star">*</span></MudTh>
                            <MudTh Style="width: 90px;">单支重量</MudTh>
                            <MudTh Style="width: 80px;">支数</MudTh>
                            <MudTh Style="width: 80px;">投料制成倍</MudTh>
                            <MudTh Style="width: 100px;">采购重量<span class="required-star">*</span></MudTh>
                            <MudTh Style="width: 140px;">要求到货日期</MudTh>
                            <MudTh Style="width: 120px;">备注</MudTh>
                            <MudTh Style="width: 140px;">供应商<span class="required-star">*</span></MudTh>
                            <MudTh Style="width: 70px;">单价</MudTh>
                            <MudTh Style="width: 50px;">操作</MudTh>
                        </HeaderContent>
                        <RowTemplate Context="row">
                            <MudTd><MudText Typo="Typo.body2">@row.Sequence</MudText></MudTd>
                            <MudTd>
                                <MudTextField T="string"
                                              @bind-Value="row.OrderDateStr"
                                              Dense="true" Variant="Variant.Outlined" Size="Size.Small"
                                              Style="width: 100px;"
                                              />
                            </MudTd>
                            <MudTd>
                                <div style="display: flex; align-items: center; gap: 4px;">
                                    <MudTextField T="string"
                                                  @bind-Value="row.SourceWorkOrderNo"
                                                  Dense="true" Variant="Variant.Outlined" Size="Size.Small"
                                                  Style="width: 110px;"
                                                  />
                                    <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Info"
                                               OnClick="() => ToggleWorkOrderInfo(row)">
                                        @(row.ShowWorkOrderInfo ? "隐藏" : "展示")
                                    </MudButton>
                                </div>
                                @if (row.ShowWorkOrderInfo)
                                {
                                    <div style="margin-top: 4px; padding: 6px; border: 1px solid #e8e8e8; border-radius: 4px; background: #fafafa; font-size: 0.7rem; line-height: 1.4;">
                                        @if (row.WorkOrderLoading)
                                        {
                                            <MudProgressCircular Size="Size.Small" Indeterminate Class="my-1" />
                                        }
                                        else if (row.WorkOrderInfo != null)
                                        {
                                            <div><strong>工单号：</strong>@row.WorkOrderInfo.WorkOrderNo</div>
                                            <div><strong>订单号：</strong>@row.WorkOrderInfo.SalesOrderNo</div>
                                            <div><strong>主号/次号：</strong>@row.WorkOrderInfo.ProductionMainNo@(!string.IsNullOrEmpty(row.WorkOrderInfo.ProductionSubNo) ? "/" + row.WorkOrderInfo.ProductionSubNo : "")</div>
                                            <div><strong>厂内牌号：</strong>@row.WorkOrderInfo.PlantGrade</div>
                                            <div><strong>规格：</strong>@row.WorkOrderInfo.Specification</div>
                                            <div><strong>交货状态：</strong>@DisplayHelper.GetDeliveryStateText(row.WorkOrderInfo.DeliveryState)</div>
                                            <div><strong>交货日期：</strong>@row.WorkOrderInfo.DeliveryDate.ToString("yyyy-MM-dd")</div>
                                            <div><strong>数量/重量：</strong>@row.WorkOrderInfo.TotalQuantity 支 / @row.WorkOrderInfo.TotalWeight kg</div>
                                        }
                                        else
                                        {
                                            <span style="color: #999;">无此工单</span>
                                        }
                                    </div>
                                }
                            </MudTd>
                            <MudTd>
                                <MudSelect T="MaterialType" @bind-Value="row.MaterialCategory"
                                           Dense="true" Variant="Variant.Outlined" Size="Size.Small">
                                    @foreach (var opt in DisplayHelper.GetEnumOptions<MaterialType>())
                                    {
                                        <MudSelectItem Value="@(Enum.Parse<MaterialType>(opt.Value))">@opt.Display</MudSelectItem>
                                    }
                                </MudSelect>
                            </MudTd>
                            <MudTd>
                                <MudTextField T="string"
                                              @bind-Value="row.PlantGrade"
                                              Dense="true" Variant="Variant.Outlined" Size="Size.Small"
                                              />
                            </MudTd>
                            <MudTd>
                                <MudTextField T="string"
                                              @bind-Value="row.Specification"
                                              Dense="true" Variant="Variant.Outlined" Size="Size.Small"
                                              />
                            </MudTd>
                            <MudTd>
                                <MudTextField T="string"
                                              @bind-Value="row.UnitWeightStr"
                                              Dense="true" Variant="Variant.Outlined" Size="Size.Small"
                                              Style="width: 70px;"
                                              />
                            </MudTd>
                            <MudTd>
                                <MudTextField T="string"
                                              @bind-Value="row.QuantityStr"
                                              Dense="true" Variant="Variant.Outlined" Size="Size.Small"
                                              Style="width: 60px;"
                                              />
                            </MudTd>
                            <MudTd>
                                <MudTextField T="string"
                                              @bind-Value="row.InputMultipleStr"
                                              Dense="true" Variant="Variant.Outlined" Size="Size.Small"
                                              Style="width: 60px;"
                                              Placeholder="1制几" />
                            </MudTd>
                            <MudTd>
                                <MudTextField T="string"
                                              @bind-Value="row.WeightStr"
                                              Dense="true" Variant="Variant.Outlined" Size="Size.Small"
                                              Style="width: 80px;"
                                              />
                            </MudTd>
                            <MudTd>
                                <MudTextField T="string"
                                              @bind-Value="row.RequiredDateStr"
                                              Dense="true" Variant="Variant.Outlined" Size="Size.Small"
                                              Placeholder="yyyy-MM-dd"
                                              Style="width: 120px;"
                                              />
                            </MudTd>
                            <MudTd>
                                <MudTextField T="string"
                                              @bind-Value="row.Remark"
                                              Dense="true" Variant="Variant.Outlined" Size="Size.Small"
                                              />
                            </MudTd>
                            <MudTd>
                                <MudAutocomplete T="SupplierProfileDto"
                                                 Value="@row.SelectedSupplier"
                                                 ValueChanged="@(v => { row.SelectedSupplier = v; if (v != null) row.SupplierName = v.SupplierName; })"
                                                 Text="@row.SupplierName"
                                                 TextChanged="@(t => { if (row.SelectedSupplier == null) row.SupplierName = t ?? string.Empty; })"
                                                 SearchFunc="@(search => FilterSuppliers(row, search))"
                                                 ToStringFunc="@FormatSupplier"
                                                 Dense="true" Variant="Variant.Outlined" Size="Size.Small"
                                                />
                            </MudTd>
                            <MudTd>
                                <MudTextField T="string"
                                              @bind-Value="row.UnitPriceStr"
                                              Dense="true" Variant="Variant.Outlined" Size="Size.Small"
                                              Style="width: 60px;"
                                              />
                            </MudTd>
                            <MudTd>
                                <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                               Color="Color.Error" Size="Size.Small"
                                               OnClick="() => RemoveRow(row)" />
                            </MudTd>
                        </RowTemplate>
                    </MudTable>
                </div></div>
        </MudCardContent>
    </MudCard>
</MudContainer>

@code {
    private List<PurchaseOrderRow> rows = new();
    private bool isSubmitting;
    private bool _isArrowNavSetup;
    private List<SupplierProfileDto> allSuppliers = new();
    private List<ProcurementStatusDto> procurementItems = new();
    private bool showProcurementStatus = false;

    class PurchaseOrderRow
    {
        public int Sequence { get; set; }
        public string OrderDateStr { get; set; } = DateTime.Today.ToString("yyyy-MM-dd");
        public string? SourceWorkOrderNo { get; set; }
        public string SupplierName { get; set; } = string.Empty;
        public SupplierProfileDto? SelectedSupplier { get; set; }
        public string RequiredDateStr { get; set; } = string.Empty;
        public MaterialType MaterialCategory { get; set; }
        public string PlantGrade { get; set; } = string.Empty;
        public string Specification { get; set; } = string.Empty;
        public string UnitWeightStr { get; set; } = string.Empty;
        public string QuantityStr { get; set; } = string.Empty;
        public string InputMultipleStr { get; set; } = string.Empty;
        public string WeightStr { get; set; } = string.Empty;
        public string UnitPriceStr { get; set; } = string.Empty;
        public string? Remark { get; set; }
        public bool ShowWorkOrderInfo { get; set; }
        public bool WorkOrderLoading { get; set; }
        public WorkOrderDetailDto? WorkOrderInfo { get; set; }

        public decimal? UnitWeight => ParseDecimal(UnitWeightStr);
        public int? Quantity => ParseInt(QuantityStr);
        public int? InputMultiple => ParseInt(InputMultipleStr);
        public decimal Weight => decimal.TryParse(WeightStr, out var v) ? v : 0;
        public decimal? UnitPrice => ParseDecimal(UnitPriceStr);
        private static decimal? ParseDecimal(string v) => decimal.TryParse(v, out var r) ? r : null;
        private static int? ParseInt(string v) => int.TryParse(v, out var r) ? r : null;
    }

    protected override async Task OnInitializedAsync()
    {
        allSuppliers = await SupplierService.GetActiveAsync();
        try
        {
            var statusResult = await PurchaseService.GetProcurementStatusAsync();
            if (statusResult.Success && statusResult.Data != null)
                procurementItems = statusResult.Data;
            else if (!statusResult.Success)
                Snackbar.Add($"加载用料计划执行状态失败: {statusResult.Message}", Severity.Warning);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"加载用料计划执行状态异常: {ex.Message}", Severity.Error);
        }
    }

    private void ToggleProcurementStatus() => showProcurementStatus = !showProcurementStatus;

    private async Task AddRowFromProcurement(ProcurementStatusDto item)
    {
        // 获取用料计划详情
        var result = await PurchaseService.GetPlanDetailAsync(item.WorkOrderNo, item.MaterialCategory?.ToString() ?? "");
        if (!result.Success || result.Data == null)
        {
            Snackbar.Add($"未找到工单 {item.WorkOrderNo} 的用料计划", Severity.Warning);
            return;
        }

        var plan = result.Data;
        var planCategory = EnumHelper.TryParse<MaterialType>(plan.MaterialCategory?.ToString() ?? "") ?? MaterialType.RoundBar;
        var existingRow = rows.FirstOrDefault(r =>
            r.SourceWorkOrderNo == plan.WorkOrderNo &&
            r.MaterialCategory == planCategory);

        if (existingRow != null)
        {
            Snackbar.Add($"工单 {plan.WorkOrderNo}（{DisplayHelper.GetMaterialTypeText(planCategory)}）已在列表中，可继续添加", Severity.Info);
        }

        rows.Add(new PurchaseOrderRow
        {
            Sequence = rows.Count + 1,
            OrderDateStr = DateTime.Today.ToString("yyyy-MM-dd"),
            SourceWorkOrderNo = plan.WorkOrderNo,
            MaterialCategory = planCategory,
            PlantGrade = plan.PlantGrade ?? string.Empty,
            Specification = plan.Specification ?? string.Empty,
            UnitWeightStr = plan.UnitWeight?.ToString("G29") ?? string.Empty,
            QuantityStr = plan.Quantity?.ToString() ?? string.Empty,
            InputMultipleStr = plan.InputMultiple?.ToString() ?? string.Empty,
            WeightStr = plan.Weight.ToString("G29"),
            Remark = plan.Remark,
            RequiredDateStr = plan.RequiredDate?.ToString("yyyy-MM-dd") ?? string.Empty
        });
        Snackbar.Add($"已添加工单 {plan.WorkOrderNo}（{DisplayHelper.GetMaterialTypeText(planCategory)}）", Severity.Success);
    }

    private string FormatSupplier(SupplierProfileDto? s) =>
        s == null ? "" : $"{s.MaterialCategoryDisplay ?? DisplayHelper.GetMaterialTypeText(s.MaterialCategory)} - {s.SupplierName}";

    private Task<IEnumerable<SupplierProfileDto>> FilterSuppliers(PurchaseOrderRow row, string search)
    {
        var query = allSuppliers.AsEnumerable();
        var catName = row.MaterialCategory.ToString();
        if (!string.IsNullOrWhiteSpace(catName))
            query = query.Where(s => s.MaterialCategory != null &&
                string.Equals(s.MaterialCategory?.ToString(), catName, StringComparison.OrdinalIgnoreCase));
        if (!string.IsNullOrWhiteSpace(search))
            query = query.Where(s => s.SupplierName.Contains(search, StringComparison.OrdinalIgnoreCase));
        return Task.FromResult(query.Take(30));
    }

    private void AddRow()
    {
        rows.Add(new PurchaseOrderRow { Sequence = rows.Count + 1 });
    }

    private void RemoveRow(PurchaseOrderRow row)
    {
        rows.Remove(row);
        for (int i = 0; i < rows.Count; i++) rows[i].Sequence = i + 1;
    }

    private async Task ToggleWorkOrderInfo(PurchaseOrderRow row)
    {
        if (row.ShowWorkOrderInfo)
        {
            row.ShowWorkOrderInfo = false;
            return;
        }

        if (string.IsNullOrWhiteSpace(row.SourceWorkOrderNo))
        {
            Snackbar.Add("请先输入工单号", Severity.Warning);
            return;
        }

        row.ShowWorkOrderInfo = true;
        row.WorkOrderLoading = true;
        row.WorkOrderInfo = null;
        StateHasChanged();

        try
        {
            var result = await WorkOrderService.GetByWorkOrderNoAsync(row.SourceWorkOrderNo);
            if (result.Success && result.Data != null)
                row.WorkOrderInfo = result.Data;
        }
        catch { }
        finally
        {
            row.WorkOrderLoading = false;
            StateHasChanged();
        }
    }

    private async Task SaveAll()
    {
        var errors = new List<string>();
        for (int i = 0; i < rows.Count; i++)
        {
            var r = rows[i];
            var seq = i + 1;
            if (!DateTime.TryParse(r.OrderDateStr, out _)) errors.Add($"行{seq}: 下单日期格式错误");
            if (string.IsNullOrWhiteSpace(r.SupplierName))
                errors.Add($"行{seq}: 请输入供应商名称");
            else if (r.SupplierName.Trim().Length < 2)
                errors.Add($"行{seq}: 供应商名称至少2个字符");
            if (!string.IsNullOrWhiteSpace(r.RequiredDateStr) && !DateTime.TryParse(r.RequiredDateStr, out _))
                errors.Add($"行{seq}: 要求到货日期格式错误");
            if (string.IsNullOrWhiteSpace(r.PlantGrade)) errors.Add($"行{seq}: 厂内钢种不能为空");
            if (string.IsNullOrWhiteSpace(r.Specification)) errors.Add($"行{seq}: 规格不能为空");
            if (r.Weight <= 0) errors.Add($"行{seq}: 采购重量必须大于0");
        }
        if (errors.Any()) { Snackbar.Add(string.Join("；", errors), Severity.Warning); return; }

        // 构建供应商(名称+物料分类)→ID 查询（同名不同分类视为不同供应商）
        var supplierLookup = allSuppliers
            .Where(s => !string.IsNullOrWhiteSpace(s.SupplierName))
            .ToDictionary(
                s => $"{s.SupplierName.Trim()}|{s.MaterialCategory?.ToString() ?? ""}",
                s => s.Id,
                StringComparer.OrdinalIgnoreCase);

        // 供应商确认（按名称+物料分类检测是否真正需要新建）
        var newSupplierEntries = rows
            .Select((r, i) => (
                Index: i + 1,
                Key: $"{r.SupplierName.Trim()}|{r.MaterialCategory.ToString()}",
                Display: $"{r.SupplierName.Trim()}（{DisplayHelper.GetMaterialTypeText(r.MaterialCategory)}）"))
            .Where(x => !supplierLookup.ContainsKey(x.Key))
            .GroupBy(x => x.Key)
            .Select(g => g.First())
            .ToList();
        if (newSupplierEntries.Any())
        {
            var lines = string.Join("\n", newSupplierEntries.Select(s => $"行{s.Index}: {s.Display}"));
            var dialog = DialogService.Show<ConfirmDialog>("新建供应商", new DialogParameters
            {
                { "ContentText", $"将自动创建以下新供应商档案：\n{lines}\n\n是否继续？" },
                { "ConfirmText", "继续保存" },
                { "Color", Color.Warning }
            });
            var result = await dialog.Result;
            if (result.Canceled) { Snackbar.Add("已取消保存", Severity.Normal); return; }
        }

        isSubmitting = true; StateHasChanged();

        // 解析供应商ID + 构建批量请求
        var requests = new List<(int Index, CreatePurchaseOrderRequest Request)>();
        var failMessages = new List<string>();

        for (int i = 0; i < rows.Count; i++)
        {
            var r = rows[i];
            var supplierName = r.SupplierName.Trim();
            var catDisplay = DisplayHelper.GetMaterialTypeText(r.MaterialCategory);
            var lookupKey = $"{supplierName}|{catDisplay}";
            int supplierId;

            if (r.SelectedSupplier != null)
            {
                supplierId = r.SelectedSupplier.Id;
            }
            else if (supplierLookup.TryGetValue(lookupKey, out var existingId))
            {
                supplierId = existingId;
            }
            else
            {
                try
                {
                    var createResult = await SupplierService.CreateAsync(new CreateSupplierRequest
                    {
                        SupplierName = supplierName,
                        MaterialCategory = EnumHelper.TryParse<MaterialType>(catDisplay),
                        IsActive = true
                    });
                    if (createResult.Success && createResult.Data != null)
                        supplierId = createResult.Data.Id;
                    else
                    {
                        failMessages.Add($"行{i + 1}: 创建供应商失败 - {createResult.Message}");
                        continue;
                    }
                }
                catch (Exception ex)
                {
                    failMessages.Add($"行{i + 1}: 创建供应商失败 - {ex.Message}");
                    continue;
                }
            }

            requests.Add((i + 1, new CreatePurchaseOrderRequest
            {
                SupplierId = supplierId,
                OrderDate = DateTime.Parse(r.OrderDateStr),
                RequiredDate = string.IsNullOrWhiteSpace(r.RequiredDateStr) ? DateTime.Today.AddDays(30) : DateTime.Parse(r.RequiredDateStr),
                MaterialCategory = r.MaterialCategory,
                PlantGrade = r.PlantGrade,
                Specification = r.Specification,
                UnitWeight = r.UnitWeight,
                Quantity = r.Quantity,
                InputMultiple = r.InputMultiple,
                Weight = r.Weight,
                UnitPrice = r.UnitPrice,
                SourceWorkOrderNo = r.SourceWorkOrderNo,
                Remark = r.Remark
            }));
        }

        if (failMessages.Any())
        {
            isSubmitting = false; StateHasChanged();
            Snackbar.Add($"失败 {failMessages.Count} 条：{string.Join("；", failMessages)}", Severity.Error);
            return;
        }

        // 批量保存
        try
        {
            var batchResult = await PurchaseService.CreateBatchAsync(requests.Select(r => r.Request).ToList());
            if (batchResult.Success && batchResult.Data != null)
            {
                Snackbar.Add($"成功创建 {batchResult.Data.Count} 条记录", Severity.Success);
                Navigation.NavigateTo("/purchase-orders");
            }
            else
            {
                Snackbar.Add($"批量创建失败: {batchResult.Message}", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"批量创建失败: {ex.Message}", Severity.Error);
        }
        finally
        {
            isSubmitting = false; StateHasChanged();
        }
    }

    private void GoBack() => Navigation.NavigateTo("/purchase-orders");

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_isArrowNavSetup)
        {
            _isArrowNavSetup = true;
            if (!await JS.InvokeAsync<bool>("enableTableArrowNav", "#purchase-order-create-table"))
                _isArrowNavSetup = false;
        }
    }
}
