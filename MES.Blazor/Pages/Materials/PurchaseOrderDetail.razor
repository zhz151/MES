@page "/purchase-orders/{id:int}"
@using MES.Blazor.Services
@using MES.Blazor.Helpers
@using MES.Core.Enums
@using MES.Core.DTOs.Materials
@using Microsoft.AspNetCore.Authorization
@inject PurchaseOrderService PurchaseService
@inject SupplierService SupplierService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject ColumnPrefsService ColumnPrefs
@inject IJSRuntime JS
@attribute [Authorize(Roles = Roles.Policies.MaterialRead)]

<MudContainer MaxWidth="MaxWidth.False" Class="mt-4">
    @if (_isLoading) { <MudProgressCircular Indeterminate Size="Size.Large" Class="d-flex justify-center ma-8" /> }
    else if (_order == null) { <MudText Typo="Typo.body2" Color="Color.Error">采购单不存在</MudText> }
    else
    {
        <MudCard>
            <MudCardHeader>
                <CardHeaderContent>
                    <MudText Typo="Typo.h5" Class="font-weight-bold">
                        <MudIcon Icon="@Icons.Material.Filled.ShoppingCart" Class="mr-2" Color="Color.Primary" />采购订单详情
                    </MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">单号：@_order.OrderNo</MudText>
                </CardHeaderContent>
                <CardHeaderActions>
                    <MudButton Variant="Variant.Text" OnClick="GoBack">返回</MudButton>
                    @if (_isEditMode)
                    {
                        <MudButton Variant="Variant.Text" Color="Color.Default" OnClick="CancelEdit">取消</MudButton>
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Save" Loading="@_isSubmitting">
                            保存
                        </MudButton>
                    }
                    else
                    {
                        <AuthorizeView Roles="@Roles.Policies.MaterialWrite">
                            <MudButton Variant="Variant.Outlined" Color="Color.Warning" OnClick="EnterEditMode">编辑</MudButton>
                        </AuthorizeView>
                    }
                </CardHeaderActions>
            </MudCardHeader>
            <MudCardContent>
                @* ========== 单行表格 ========== *@
                <div class="d-flex align-center mb-2">
                    <MudText Typo="Typo.subtitle1" Class="font-weight-bold">
                        <MudIcon Icon="@Icons.Material.Filled.Info" Size="Size.Small" Class="mr-1" />基本信息
                    </MudText>
                    <ColumnDisplaySelect Columns="@_allColumns"
                                         OnColumnToggle="@OnColumnToggle"
                                         OnMoveUp="@OnMoveUp"
                                         OnMoveDown="@OnMoveDown" />
                </div>

                <div id="purchase-order-detail-table" style="overflow-x: auto;">
                    <MudTable Items="@_singleItemList" Dense="true" Hover="true" Elevation="0" Class="auto-table" ReadOnly="true">
                        <HeaderContent>
                            @foreach (var col in _visibleColumns)
                            {
                                <MudTh>
                                    @col.Label
                                    @if (col.IsRequired) { <span class="required-star">*</span> }
                                </MudTh>
                            }
                        </HeaderContent>
                        <RowTemplate Context="item">
                            @foreach (var col in _visibleColumns)
                            {
                                <MudTd>@RenderCell(item, col)</MudTd>
                            }
                        </RowTemplate>
                    </MudTable>
                </div>

                @* 到货进度条 *@
                @{
                    var hasQty = _order.Quantity.HasValue && _order.Quantity > 0;
                    var receivedPct = hasQty ? Math.Min(100, (double)_order.ReceivedQuantity / (double)_order.Quantity!.Value * 100) : 0;
                }
                <div class="d-flex align-center mt-2">
                    <MudText Typo="Typo.body2" Class="mr-4">
                        <MudIcon Icon="@Icons.Material.Filled.Inventory" Size="Size.Small" Class="mr-1" />到货进度
                    </MudText>
                    @if (hasQty)
                    {
                        <div style="flex:1; max-width:300px;" class="mr-4">
                            <MudProgressLinear Value="@receivedPct" Color="@(receivedPct >= 100 ? Color.Success : Color.Primary)" />
                        </div>
                        <MudText Typo="Typo.body2">@_order.ReceivedQuantity.ToString("G29") / @_order.Quantity?.ToString("G29") 支</MudText>
                    }
                    else
                    {
                        <MudText Typo="Typo.body2">未设置采购支数</MudText>
                    }
                </div>
            </MudCardContent>
        </MudCard>
    }
</MudContainer>

@code {
    [Parameter] public int Id { get; set; }

    // ========== 状态 ==========
    private PurchaseOrderDto? _order;
    private bool _isLoading = true;
    private bool _isEditMode;
    private bool _isSubmitting;
    private bool _editIsForceCompleted;
    private bool _isArrowNavSetup;

    // ========== 编辑模型 ==========
    private EditOrderModel _editOrder = new();
    private string _dateText = "";
    private string _requiredDateText = "";
    private string _quantityStr = "";
    private string _inputMultipleStr = "";
    private string _unitWeightStr = "";
    private string _weightStr = "";
    private string _unitPriceStr = "";
    private List<SupplierProfileDto> _suppliers = new();

    // ========== 单行列表辅助 ==========
    private List<PurchaseOrderDto> _singleItemList => _order != null ? new List<PurchaseOrderDto> { _order } : new();

    // ========== 列定义 ==========
    private List<ColumnDef> _allColumns = new();
    private List<ColumnDef> _visibleColumns => _allColumns.Where(c => c.Visible).ToList();

    // ========== 内部模型 ==========
    private class EditOrderModel
    {
        public int SupplierId { get; set; }
        public MaterialType MaterialCategory { get; set; }
        public string PlantGrade { get; set; } = string.Empty;
        public string Specification { get; set; } = string.Empty;
        public decimal? SourceUnitWeight { get; set; }
        public int? SourceQuantity { get; set; }
        public int? SourceInputMultiple { get; set; }
        public decimal SourceWeight { get; set; }
        public DateTime SourceRequiredDate { get; set; }
        public decimal? SourceUnitPrice { get; set; }
        public string? SourceWorkOrderNo { get; set; }
        public string? Remark { get; set; }
    }

    // ========== 初始化 ==========
    protected override async Task OnInitializedAsync()
    {
        InitColumns();
        await LoadColumnPrefs();
        _suppliers = await SupplierService.GetActiveAsync();
        await LoadData();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_isEditMode && !_isArrowNavSetup)
        {
            _isArrowNavSetup = true;
            if (!await JS.InvokeAsync<bool>("enableTableArrowNav", "#purchase-order-detail-table"))
                _isArrowNavSetup = false;
        }
    }

    private void InitColumns()
    {
        _allColumns = new List<ColumnDef>
        {
            // 基本信息
            new() { Key = "orderno", Label = "采购单号", Visible = true, IsRequired = true },
            new() { Key = "suppliername", Label = "供应商", Visible = true, IsRequired = true },
            new() { Key = "orderdate", Label = "下单日期", Visible = true, IsRequired = true },
            new() { Key = "status", Label = "状态", Visible = true },
            // 物料信息
            new() { Key = "materialcategory", Label = "物料分类", Visible = true, IsRequired = true },
            new() { Key = "plantgrade", Label = "厂内钢种", Visible = true },
            new() { Key = "specification", Label = "规格", Visible = true },
            new() { Key = "unitweight", Label = "单支重量", Visible = true },
            new() { Key = "quantity", Label = "采购支数", Visible = true },
            new() { Key = "inputmultiple", Label = "投料制成倍", Visible = true },
            new() { Key = "weight", Label = "采购重量", Visible = true },
            new() { Key = "requireddate", Label = "要求到货日", Visible = true },
            new() { Key = "unitprice", Label = "单价", Visible = false },
            new() { Key = "totalamount", Label = "总金额", Visible = false },
            new() { Key = "sourceworkorderno", Label = "来源工单号", Visible = true },
            // 到货进度
            new() { Key = "receivedquantity", Label = "已到货支数", Visible = true },
            new() { Key = "receivedweight", Label = "已到货重量", Visible = true },
            new() { Key = "lastarrivaldate", Label = "最后到货日", Visible = false },
            // 备注
            new() { Key = "remark", Label = "备注", Visible = false },
            // Wo* 字段（17个）
            new() { Key = "wosalesorderno", Label = "订单号", Visible = false },
            new() { Key = "woproductionmainno", Label = "主号", Visible = false },
            new() { Key = "woproductionsubno", Label = "次号", Visible = false },
            new() { Key = "wosigndate", Label = "签订日期", Visible = false },
            new() { Key = "wosalesman", Label = "业务员", Visible = false },
            new() { Key = "woendcustomer", Label = "最终用户", Visible = false },
            new() { Key = "wodeliverydate", Label = "交货日期", Visible = false },
            new() { Key = "wodelaypenalty", Label = "延期罚款", Visible = false },
            new() { Key = "wosettlementmethod", Label = "结算方式", Visible = false },
            new() { Key = "woplantgrade", Label = "厂内牌号", Visible = false },
            new() { Key = "wospecification", Label = "成品规格", Visible = false },
            new() { Key = "wolengthstatus", Label = "长度状态", Visible = false },
            new() { Key = "womaxlength", Label = "最长长度", Visible = false },
            new() { Key = "wototalquantity", Label = "总支数", Visible = false },
            new() { Key = "wototalweight", Label = "总重量", Visible = false },
            new() { Key = "wodeliverystate", Label = "交货状态", Visible = false },
            new() { Key = "wototalitemcount", Label = "总项次数", Visible = false },
        };
    }

    // ========== 列偏好持久化 ==========
    private const string ColumnPrefsKey = "purchase_order_detail";

    private async Task LoadColumnPrefs()
    {
        var saved = await ColumnPrefs.LoadAsync(ColumnPrefsKey, null);
        if (saved.Count > 0) ApplyColumnPrefs(_allColumns, saved);
    }

    private static void ApplyColumnPrefs(List<ColumnDef> target, List<ColumnDef> saved)
    {
        var savedByKey = saved.ToDictionary(s => s.Key, s => s);
        foreach (var t in target)
        {
            if (savedByKey.TryGetValue(t.Key, out var pref))
                t.Visible = pref.Visible;
        }
        var savedKeys = saved.Select(s => s.Key).ToHashSet();
        var merged = saved
            .Select(s => target.FirstOrDefault(t => t.Key == s.Key))
            .Where(t => t != null)
            .Cast<ColumnDef>()
            .Concat(target.Where(t => !savedKeys.Contains(t.Key)))
            .ToList();
        if (merged.Count == target.Count)
        {
            for (int i = 0; i < target.Count; i++) target[i] = merged[i];
        }
    }

    private async Task SaveColumnPrefs()
    {
        await ColumnPrefs.SaveAsync(ColumnPrefsKey, null, _allColumns);
    }

    private async Task OnColumnToggle(ColumnDef col) => await SaveColumnPrefs();
    private async Task OnMoveUp(ColumnDef col) => await SaveColumnPrefs();
    private async Task OnMoveDown(ColumnDef col) => await SaveColumnPrefs();

    // ========== 数据加载 ==========
    private async Task LoadData()
    {
        if (Id <= 0) { Snackbar.Add("无效的ID", Severity.Error); _isLoading = false; return; }
        _isLoading = true; StateHasChanged();
        try
        {
            var result = await PurchaseService.GetByIdAsync(Id);
            if (result.Success && result.Data != null)
            {
                _order = result.Data;
                ResetEditModels();
            }
            else { Snackbar.Add(result.Message ?? "加载失败", Severity.Error); }
        }
        catch (Exception ex) { Snackbar.Add($"加载失败: {ex.Message}", Severity.Error); }
        finally { _isLoading = false; StateHasChanged(); }
    }

    private void ResetEditModels()
    {
        if (_order == null) return;
        _editIsForceCompleted = _order.IsForceCompleted;
        _editOrder = new EditOrderModel
        {
            SupplierId = _order.SupplierId,
            MaterialCategory = _order.MaterialCategory,
            PlantGrade = _order.PlantGrade,
            Specification = _order.Specification,
            SourceUnitWeight = _order.UnitWeight,
            SourceQuantity = _order.Quantity,
            SourceInputMultiple = _order.InputMultiple,
            SourceWeight = _order.Weight,
            SourceRequiredDate = _order.RequiredDate,
            SourceUnitPrice = _order.UnitPrice,
            SourceWorkOrderNo = _order.SourceWorkOrderNo,
            Remark = _order.Remark
        };
        _dateText = _order.OrderDate.ToString("yyyy-MM-dd");
        _requiredDateText = _order.RequiredDate.ToString("yyyy-MM-dd");
        _unitWeightStr = _order.UnitWeight?.ToString("G29") ?? "";
        _quantityStr = _order.Quantity?.ToString() ?? "";
        _inputMultipleStr = _order.InputMultiple?.ToString() ?? "";
        _weightStr = _order.Weight.ToString("G29");
        _unitPriceStr = _order.UnitPrice?.ToString("G29") ?? "";
    }

    // ========== 编辑模式 ==========
    private void EnterEditMode() { _isEditMode = true; }

    private Task CancelEdit()
    {
        _isEditMode = false;
        ResetEditModels();
        StateHasChanged();
        return Task.CompletedTask;
    }

    private async Task Save()
    {
        // 验证
        var errors = new List<string>();
        if (!DateTime.TryParse(_dateText, out var orderDate))
            errors.Add("下单日期格式错误，请使用 yyyy-MM-dd");
        if (!DateTime.TryParse(_requiredDateText, out var requiredDate))
            errors.Add("要求到货日期格式错误，请使用 yyyy-MM-dd");
        if (string.IsNullOrWhiteSpace(_editOrder.PlantGrade)) errors.Add("厂内钢种不能为空");
        if (string.IsNullOrWhiteSpace(_editOrder.Specification)) errors.Add("规格不能为空");
        if (!int.TryParse(_quantityStr, out var qty) || qty < 0)
            errors.Add("采购支数必须为大于等于0的整数");
        if (!decimal.TryParse(_weightStr, out var wgt) || wgt <= 0)
            errors.Add("采购重量必须大于0");
        if (errors.Any()) { Snackbar.Add(string.Join("；", errors), Severity.Warning); return; }

        _isSubmitting = true; StateHasChanged();
        try
        {
            _editOrder.SourceQuantity = qty;
            _editOrder.SourceWeight = wgt;
            _editOrder.SourceInputMultiple = int.TryParse(_inputMultipleStr, out var im) ? im : null;
            _editOrder.SourceUnitWeight = decimal.TryParse(_unitWeightStr, out var uw) ? uw : null;
            _editOrder.SourceUnitPrice = decimal.TryParse(_unitPriceStr, out var up) ? up : null;

            var req = new UpdatePurchaseOrderRequest
            {
                SupplierId = _editOrder.SupplierId,
                MaterialCategory = _editOrder.MaterialCategory,
                PlantGrade = _editOrder.PlantGrade,
                Specification = _editOrder.Specification,
                UnitWeight = _editOrder.SourceUnitWeight,
                Quantity = _editOrder.SourceQuantity,
                InputMultiple = _editOrder.SourceInputMultiple,
                Weight = _editOrder.SourceWeight,
                RequiredDate = requiredDate,
                UnitPrice = _editOrder.SourceUnitPrice,
                SourceWorkOrderNo = _editOrder.SourceWorkOrderNo,
                Remark = _editOrder.Remark
            };

            var result = await PurchaseService.UpdateAsync(Id, req);
            if (result.Success)
            {
                // 如果强制完成状态已改变，额外调用状态更新
                if (_order != null && _editIsForceCompleted != _order.IsForceCompleted)
                {
                    await PurchaseService.UpdateStatusAsync(Id, new UpdateOrderStatusRequest { IsForceCompleted = _editIsForceCompleted });
                }
                Snackbar.Add("保存成功", Severity.Success);
                _isEditMode = false;
                await LoadData();
            }
            else
            {
                Snackbar.Add(result.Message ?? "保存失败", Severity.Error);
            }
        }
        catch (Exception ex) { Snackbar.Add($"保存失败: {ex.Message}", Severity.Error); }
        finally { _isSubmitting = false; StateHasChanged(); }
    }

    // ========== 强制完成 ==========
    private async Task OnForceCompletedChanged(bool value)
    {
        _editIsForceCompleted = value;
        try
        {
            var result = await PurchaseService.UpdateStatusAsync(Id, new UpdateOrderStatusRequest { IsForceCompleted = value });
            if (result.Success) { Snackbar.Add("状态已更新", Severity.Success); await LoadData(); }
            else { Snackbar.Add(result.Message ?? "状态更新失败", Severity.Error); }
        }
        catch (Exception ex) { Snackbar.Add($"状态更新失败: {ex.Message}", Severity.Error); }
    }

    // ========== 导航 ==========
    private void GoBack() => Navigation.NavigateTo("/purchase-orders");

    private static string GetStatusText(PurchaseOrderStatus status) => DisplayHelper.GetPurchaseOrderStatusText(status);

    // ========== 渲染方法 ==========
    private RenderFragment RenderCell(PurchaseOrderDto item, ColumnDef col) => builder =>
    {
        switch (col.Key)
        {
            case "orderno":
                builder.AddContent(0, item.OrderNo);
                break;
            case "suppliername":
                if (_isEditMode)
                {
                    builder.OpenComponent<MudSelect<int>>(0);
                    builder.AddAttribute(1, "Value", _editOrder.SupplierId);
                    builder.AddAttribute(2, "ValueChanged", EventCallback.Factory.Create<int>(this, v => _editOrder.SupplierId = v));
                    builder.AddAttribute(3, "Dense", true);
                    builder.AddAttribute(4, "Variant", Variant.Outlined);
                    builder.AddAttribute(5, "Size", Size.Small);
                    builder.AddAttribute(6, "ChildContent", (RenderFragment)(cb =>
                    {
                        foreach (var s in _suppliers)
                        {
                            cb.OpenComponent<MudSelectItem<int>>(0);
                            cb.AddAttribute(1, "Value", s.Id);
                            cb.AddAttribute(2, "ChildContent", (RenderFragment)(b => b.AddContent(0, s.SupplierName)));
                            cb.CloseComponent();
                        }
                    }));
                    builder.CloseComponent();
                }
                else
                {
                    builder.AddContent(0, item.SupplierName);
                }
                break;
            case "orderdate":
                if (_isEditMode)
                {
                    builder.OpenComponent<MudTextField<string>>(0);
                    builder.AddAttribute(1, "Value", _dateText);
                    builder.AddAttribute(2, "ValueChanged", EventCallback.Factory.Create<string>(this, v => _dateText = v));
                    builder.AddAttribute(3, "Dense", true);
                    builder.AddAttribute(4, "Variant", Variant.Outlined);
                    builder.AddAttribute(5, "Size", Size.Small);
                    builder.AddAttribute(6, "Placeholder", "yyyy-MM-dd");
                    builder.CloseComponent();
                }
                else
                {
                    builder.AddContent(0, item.OrderDate.ToString("yyyy-MM-dd"));
                }
                break;
            case "status":
                if (_isEditMode)
                {
                    builder.OpenComponent<MudSwitch<bool>>(0);
                    builder.AddAttribute(1, "Value", _editIsForceCompleted);
                    builder.AddAttribute(2, "ValueChanged", EventCallback.Factory.Create<bool>(this, async v =>
                    {
                        _editIsForceCompleted = v;
                        await OnForceCompletedChanged(v);
                    }));
                    builder.AddAttribute(3, "Label", "强制完成");
                    builder.AddAttribute(4, "Color", Color.Success);
                    builder.AddAttribute(5, "Dense", true);
                    builder.CloseComponent();
                }
                else
                {
                    builder.AddContent(0, GetStatusText(item.Status));
                    if (item.IsForceCompleted)
                    {
                        builder.AddContent(1, " (强制完成)");
                    }
                }
                break;
            case "materialcategory":
                if (_isEditMode)
                {
                    builder.OpenComponent<MudSelect<MaterialType>>(0);
                    builder.AddAttribute(1, "Value", _editOrder.MaterialCategory);
                    builder.AddAttribute(2, "ValueChanged", EventCallback.Factory.Create<MaterialType>(this, v => _editOrder.MaterialCategory = v));
                    builder.AddAttribute(3, "Dense", true);
                    builder.AddAttribute(4, "Variant", Variant.Outlined);
                    builder.AddAttribute(5, "Size", Size.Small);
                    builder.AddAttribute(6, "ChildContent", (RenderFragment)(cb =>
                    {
                        foreach (var opt in DisplayHelper.GetEnumOptions<MaterialType>())
                        {
                            cb.OpenComponent<MudSelectItem<MaterialType>>(0);
                            cb.AddAttribute(1, "Value", Enum.Parse<MaterialType>(opt.Value));
                            cb.AddAttribute(2, "ChildContent", (RenderFragment)(b => b.AddContent(0, opt.Display)));
                            cb.CloseComponent();
                        }
                    }));
                    builder.CloseComponent();
                }
                else { builder.AddContent(0, DisplayHelper.GetMaterialTypeText(item.MaterialCategory)); }
                break;
            case "plantgrade":
                if (_isEditMode)
                {
                    builder.OpenComponent<MudTextField<string>>(0);
                    builder.AddAttribute(1, "Value", _editOrder.PlantGrade);
                    builder.AddAttribute(2, "ValueChanged", EventCallback.Factory.Create<string>(this, v => _editOrder.PlantGrade = v));
                    builder.AddAttribute(3, "Dense", true);
                    builder.AddAttribute(4, "Variant", Variant.Outlined);
                    builder.AddAttribute(5, "Size", Size.Small);
                    builder.CloseComponent();
                }
                else { builder.AddContent(0, item.PlantGrade); }
                break;
            case "specification":
                if (_isEditMode)
                {
                    builder.OpenComponent<MudTextField<string>>(0);
                    builder.AddAttribute(1, "Value", _editOrder.Specification);
                    builder.AddAttribute(2, "ValueChanged", EventCallback.Factory.Create<string>(this, v => _editOrder.Specification = v));
                    builder.AddAttribute(3, "Dense", true);
                    builder.AddAttribute(4, "Variant", Variant.Outlined);
                    builder.AddAttribute(5, "Size", Size.Small);
                    builder.CloseComponent();
                }
                else { builder.AddContent(0, item.Specification); }
                break;
            case "unitweight":
                if (_isEditMode)
                {
                    builder.OpenComponent<MudTextField<string>>(0);
                    builder.AddAttribute(1, "Value", _unitWeightStr);
                    builder.AddAttribute(2, "ValueChanged", EventCallback.Factory.Create<string>(this, v => _unitWeightStr = v));
                    builder.AddAttribute(3, "Dense", true);
                    builder.AddAttribute(4, "Variant", Variant.Outlined);
                    builder.AddAttribute(5, "Size", Size.Small);
                    builder.CloseComponent();
                }
                else { builder.AddContent(0, item.UnitWeight?.ToString("G29")); }
                break;
            case "quantity":
                if (_isEditMode)
                {
                    builder.OpenComponent<MudTextField<string>>(0);
                    builder.AddAttribute(1, "Value", _quantityStr);
                    builder.AddAttribute(2, "ValueChanged", EventCallback.Factory.Create<string>(this, v => _quantityStr = v));
                    builder.AddAttribute(3, "Dense", true);
                    builder.AddAttribute(4, "Variant", Variant.Outlined);
                    builder.AddAttribute(5, "Size", Size.Small);
                    builder.CloseComponent();
                }
                else { builder.AddContent(0, item.Quantity?.ToString("G29")); }
                break;
            case "inputmultiple":
                if (_isEditMode)
                {
                    builder.OpenComponent<MudTextField<string>>(0);
                    builder.AddAttribute(1, "Value", _inputMultipleStr);
                    builder.AddAttribute(2, "ValueChanged", EventCallback.Factory.Create<string>(this, v => _inputMultipleStr = v));
                    builder.AddAttribute(3, "Dense", true);
                    builder.AddAttribute(4, "Variant", Variant.Outlined);
                    builder.AddAttribute(5, "Size", Size.Small);
                    builder.CloseComponent();
                }
                else { builder.AddContent(0, item.InputMultiple?.ToString() ?? "-"); }
                break;
            case "weight":
                if (_isEditMode)
                {
                    builder.OpenComponent<MudTextField<string>>(0);
                    builder.AddAttribute(1, "Value", _weightStr);
                    builder.AddAttribute(2, "ValueChanged", EventCallback.Factory.Create<string>(this, v => _weightStr = v));
                    builder.AddAttribute(3, "Dense", true);
                    builder.AddAttribute(4, "Variant", Variant.Outlined);
                    builder.AddAttribute(5, "Size", Size.Small);
                    builder.CloseComponent();
                }
                else { builder.AddContent(0, item.Weight.ToString("G29")); }
                break;
            case "requireddate":
                if (_isEditMode)
                {
                    builder.OpenComponent<MudTextField<string>>(0);
                    builder.AddAttribute(1, "Value", _requiredDateText);
                    builder.AddAttribute(2, "ValueChanged", EventCallback.Factory.Create<string>(this, v => _requiredDateText = v));
                    builder.AddAttribute(3, "Dense", true);
                    builder.AddAttribute(4, "Variant", Variant.Outlined);
                    builder.AddAttribute(5, "Size", Size.Small);
                    builder.AddAttribute(6, "Placeholder", "yyyy-MM-dd");
                    builder.CloseComponent();
                }
                else { builder.AddContent(0, item.RequiredDate.ToString("yyyy-MM-dd")); }
                break;
            case "unitprice":
                if (_isEditMode)
                {
                    builder.OpenComponent<MudTextField<string>>(0);
                    builder.AddAttribute(1, "Value", _unitPriceStr);
                    builder.AddAttribute(2, "ValueChanged", EventCallback.Factory.Create<string>(this, v => _unitPriceStr = v));
                    builder.AddAttribute(3, "Dense", true);
                    builder.AddAttribute(4, "Variant", Variant.Outlined);
                    builder.AddAttribute(5, "Size", Size.Small);
                    builder.CloseComponent();
                }
                else { builder.AddContent(0, item.UnitPrice?.ToString("G29")); }
                break;
            case "totalamount":
