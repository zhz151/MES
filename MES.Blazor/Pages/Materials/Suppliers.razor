@page "/suppliers"
@using MES.Blazor.Services
@using MES.Core.Models
@using Microsoft.AspNetCore.Authorization
@using MES.Blazor.Shared
@using MES.Blazor.Models
@using MES.Core.DTOs.Materials
@using System.Text.Json
@inject SupplierService SupplierService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject IJSRuntime JS
@inject ColumnPrefsService ColumnPrefs
@inject PageStateService PageState
@attribute [Authorize(Roles = Roles.Policies.MaterialView)]

<MudContainer MaxWidth="MaxWidth.False" Class="mt-4 pl-0">
    <MudCard>
        <MudCardHeader>
            <CardHeaderContent>
                <MudText Typo="Typo.h5" Class="font-weight-bold">
                    <MudIcon Icon="@Icons.Material.Filled.Business" Class="mr-2" Color="Color.Primary" />
                    供应商管理
                </MudText>
            </CardHeaderContent>
            <CardHeaderActions>
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Add"
                           OnClick="NavigateToCreate">
                    新建供应商
                </MudButton>
            </CardHeaderActions>
        </MudCardHeader>

        <MudCardContent>
            <!-- 搜索栏 -->
            <MudGrid>
                <MudItem xs="12" md="6">
                    <MudTextField T="string"
                                  Label="模糊搜索 - 供应商编码/名称/物料分类/联系人/联系电话"
                                  Value="_searchKeyword" ValueExpression="@(() => _searchKeyword)"
                                  ValueChanged="@OnSearchChanged"
                                  Immediate="true"
                                  DebounceInterval="500"
                                  Adornment="Adornment.End"
                                  AdornmentIcon="@Icons.Material.Filled.Search" />
                </MudItem>
            </MudGrid>

            @* 双日期区间（2026-09-14）：出单区间驱动「区间出单」、到货区间驱动「区间到货/区间退货」；两区间互相独立可叠加 *@
            <div class="d-flex align-center mb-2" style="gap:16px; flex-wrap:wrap;">
                <div class="d-flex align-center" style="gap:6px;">
                    <MudTextField T="string" @bind-Value="_orderDateFrom" Immediate="true" Variant="Variant.Outlined"
                                  Dense="true" Margin="Margin.Dense" Style="width:140px" Label="出单日期起"
                                  Placeholder="yyyy-MM-dd" />
                    <MudTextField T="string" @bind-Value="_orderDateTo" Immediate="true" Variant="Variant.Outlined"
                                  Dense="true" Margin="Margin.Dense" Style="width:140px" Label="出单日期止"
                                  Placeholder="yyyy-MM-dd" />
                    <MudButton Variant="Variant.Outlined" Size="Size.Small" Color="Color.Primary"
                               OnClick="ApplyRangeAsync">应用出单区间</MudButton>
                    <MudButton Variant="Variant.Text" Size="Size.Small"
                               OnClick="@(() => { _orderDateFrom = ""; _orderDateTo = ""; return ApplyRangeAsync(); })"
                               Disabled="@(!OrderRangeMode)">清除</MudButton>
                </div>
                <MudDivider Vertical="true" FlexItem="true" Style="height:28px;" />
                <div class="d-flex align-center" style="gap:6px;">
                    <MudTextField T="string" @bind-Value="_arrivalDateFrom" Immediate="true" Variant="Variant.Outlined"
                                  Dense="true" Margin="Margin.Dense" Style="width:140px" Label="到货日期起"
                                  Placeholder="yyyy-MM-dd" />
                    <MudTextField T="string" @bind-Value="_arrivalDateTo" Immediate="true" Variant="Variant.Outlined"
                                  Dense="true" Margin="Margin.Dense" Style="width:140px" Label="到货日期止"
                                  Placeholder="yyyy-MM-dd" />
                    <MudButton Variant="Variant.Outlined" Size="Size.Small" Color="Color.Primary"
                               OnClick="ApplyRangeAsync">应用到货区间</MudButton>
                    <MudButton Variant="Variant.Text" Size="Size.Small"
                               OnClick="@(() => { _arrivalDateFrom = ""; _arrivalDateTo = ""; return ApplyRangeAsync(); })"
                               Disabled="@(!ArrivalRangeMode)">清除</MudButton>
                </div>
                @if (AnyRangeMode)
                {
                    <MudButton Variant="Variant.Text" Size="Size.Small"
                               OnClick="@(() => { _orderDateFrom = _orderDateTo = _arrivalDateFrom = _arrivalDateTo = ""; return ApplyRangeAsync(); })">
                        清空全部区间
                    </MudButton>
                }
            </div>
            @if (AnyRangeMode)
            {
                <MudText Typo="Typo.caption" Class="text-hint mb-2">@RangeHint()</MudText>
            }

            <!-- 工具栏 -->
            <div class="list-toolbar">
                <div class="d-flex align-center">
                    <ColumnDisplaySelect Columns="_allColumns"
                                         OnColumnToggle="OnColumnToggle"
                                         OnMoveUp="MoveColumnUp"
                                         OnMoveDown="MoveColumnDown" />
                    <MudButton Variant="Variant.Text" Size="Size.Small"
                               Color="Color.Default"
                               StartIcon="@Icons.Material.Filled.RestartAlt"
                               OnClick="ResetColumnDisplay" Class="ml-2">
                        重置
                    </MudButton>
                </div>
                <div class="d-flex align-center" style="margin-left:auto;">
                    <MudButton Variant="Variant.Outlined"
                               Size="Size.Small"
                               Color="Color.Info"
                               StartIcon="@Icons.Material.Filled.Print"
                               Disabled="@(!selectedIds.Any())"
                               OnClick="PrintSelected">
                        打印选中 (@selectedIds.Count)
                    </MudButton>
                    <MudText Typo="Typo.body2" Class="ml-4">
                        共 @_totalCount 条记录
                    </MudText>
                </div>
            </div>

            <!-- 数据表格 -->
            <div id="suppliers-list-table">
            @* ① 基本信息 / ② 往来信息 分组标题栏（仿客户管理/订单列表 B23） *@
            <div class="col-group-header-scroll">
                <div class="col-group-header-bar" style="width: @(_totalTableWidth)px">
                    @foreach (var gh in _groupHeaders)
                    {
                        <div class="col-group-header-item @gh.CssClass" style="width: @(gh.TotalWidth)px">
                            <span class="col-group-badge">@gh.GroupName</span>
                        </div>
                    }
                </div>
            </div>
            <MudTable Breakpoint="Breakpoint.None" @ref="table"
                      T="SupplierProfileDto"
                      ServerData="@LoadDataFromServer"
                      Dense="true"
                      Hover="true"
                      Class="mt-0 auto-table compact-table"
                      Elevation="0"
                      RowsPerPage="@_pageSize"
                      RowsPerPageLabel="每页行数:">
                <HeaderContent>
                    @{
                        int? _prevGk = null;
                    }
                    <MudTh Class="col-selection-th" Style="width:40px;padding:0 4px;">
                        <MudCheckBox T="bool" @bind-Value="allSelected" Dense="true" />
                    </MudTh>
                    @foreach (var col in _visibleColumns)
                    {
                        var _isGroupStart = col.GroupKey.HasValue && col.GroupKey != _prevGk;
                        _prevGk = col.GroupKey;
                        var _headerClass = GetHeaderGroupCss(col.GroupKey, _isGroupStart) + GetTradeAccentCss(col.Key);
                        <MudTh Class="@_headerClass" Style="@($"width:{col.Width}px")">
                            <div style="display:inline-flex; align-items:center; gap:4px;">
                                <span @onclick='() => ToggleSort(col.Key)' style="cursor:pointer" class="th-label">@TradeColumnLabel(col) @if (sortColumn == col.Key) {@(sortDescending ? " ▼" : " ▲")}</span>
                                @if (col.FilterType != null)
                                {
                                    <ExcelFilter T="SupplierProfileDto"
                                                 Label="@col.Label"
                                                 FieldKey="@col.Key"
                                                 FilterOptions="@(_filterContextOptions.GetValueOrDefault(col.Key))"
                                                 ActiveFilterValues="@(_columnFilters.GetValueOrDefault(col.Key))"
                                                 FilterChanged="@(args => OnColumnFilterChanged(args.fieldKey, args.selectedValues))" />

                                }
                            </div>
                        </MudTh>
                    }
                    <MudTh Style="width:100px;">操作</MudTh>
                </HeaderContent>
                <RowTemplate Context="item">
                    @{
                        int? _prevGk2 = null;
                    }
                    <MudTd Class="col-selection-td" Style="width:40px;padding:0 4px;">
                        @if (!_editingIds.Contains(item.Id))
                        {
                            <MudCheckBox T="bool"
                                         Value="@selectedIds.Contains(item.Id)"
                                         ValueChanged="@((v) => { if(v) selectedIds.Add(item.Id); else selectedIds.Remove(item.Id); StateHasChanged(); })"
                                         Dense="true" />
                        }
                    </MudTd>
                    @foreach (var col in _visibleColumns)
                    {
                        var _isGroupStart2 = col.GroupKey.HasValue && col.GroupKey != _prevGk2;
                        _prevGk2 = col.GroupKey;
                        // ② 往来信息统计列数据靠左（2026-09-09 供应商页对齐）
                        <MudTd Class="@GetCellGroupCss(col.GroupKey, _isGroupStart2)">@RenderCell(item, col)</MudTd>
                    }
                    <MudTd Style="min-width:100px;">
                        @if (_editingIds.Contains(item.Id))
                        {
                            <MudIconButton Icon="@Icons.Material.Filled.Save"
                                           Color="Color.Success" Size="Size.Small"
                                           Title="保存"
                                           OnClick="() => SaveEdit(item)"
                                           Disabled="@_isSaving" />
                            <MudIconButton Icon="@Icons.Material.Filled.Close"
                                           Color="Color.Default" Size="Size.Small"
                                           Title="取消"
                                           OnClick="() => CancelEdit(item)" />
                        }
                        else
                        {
                            <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                           Color="Color.Warning" Size="Size.Small"
                                           Title="编辑"
                                           OnClick="() => StartEdit(item)" />
                        <AuthorizeView Roles="@Roles.Policies.MaterialDelete">
                            <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                           Color="Color.Error" Size="Size.Small"
                                           Title="删除"
                                           OnClick="() => DeleteItem(item)" />
                        </AuthorizeView>
                        }
                    </MudTd>
                </RowTemplate>
                <FooterContent>
                    @{
                        int? _prevGk3 = null;
                    }
                    <MudTd Class="col-selection-td col-footer-cell" Style="width:40px;padding:0 4px;"></MudTd>  @* checkbox占位 *@
                    @foreach (var col in _visibleColumns)
                    {
                        var _isGroupStart3 = col.GroupKey.HasValue && col.GroupKey != _prevGk3;
                        _prevGk3 = col.GroupKey;
                        <MudTd Class="@(GetCellGroupCss(col.GroupKey, _isGroupStart3) + " col-footer-cell")"><span class="col-footer-sum">@RenderFooterCell(col)</span></MudTd>
                    }
                    <MudTd Class="col-footer-cell"></MudTd>  @* 操作列占位 *@
                </FooterContent>
                <PagerContent>
                    <MudTablePager PageSizeOptions="new int[]{10,15,25,50,100}" />
                </PagerContent>
            </MudTable>
            </div>
        </MudCardContent>
    </MudCard>
</MudContainer>
