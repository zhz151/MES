@page "/materials/create"
@using MES.Blazor.Services
@using MES.Blazor.Helpers
@using MES.Core.DTOs.Materials
@using Microsoft.AspNetCore.Authorization
@inject MaterialService MaterialService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject IJSRuntime JS
@attribute [Authorize(Roles = Roles.Policies.MaterialRead)]

<MudContainer MaxWidth="MaxWidth.False" Class="mt-4">
    <MudCard>
        <MudCardHeader>
            <CardHeaderContent>
                <MudText Typo="Typo.h5" Class="font-weight-bold">
                    <MudIcon Icon="@Icons.Material.Filled.Add" Class="mr-2" Color="Color.Primary" />
                    新建物料
                </MudText>
            </CardHeaderContent>
            <CardHeaderActions>
                <MudButton Variant="Variant.Text" OnClick="GoBack">返回</MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAll" Loading="@isSubmitting">
                    保存
                </MudButton>
            </CardHeaderActions>
        </MudCardHeader>

        <MudCardContent>
            <div class="d-flex justify-space-between align-center mb-3">
                <MudText Typo="Typo.subtitle1">物料列表</MudText>
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="AddRow">添加物料</MudButton>
            </div>

            <div id="materials-create-table" style="overflow-x: auto;">
                <MudTable T="MaterialRow" Items="@rows" Dense="true" Hover="true" Elevation="0" Class="auto-table">
                    <HeaderContent>
                        <MudTh Style="width: 50px;">行号</MudTh>
                        <MudTh Style="width: 130px;">物料分类<span class="required-star">*</span></MudTh>
                        <MudTh Style="width: 130px;">厂内钢种<span class="required-star">*</span></MudTh>
                        <MudTh Style="width:150px;">名义规格<span class="required-star">*</span></MudTh>
                        <MudTh Style="width: 70px;">启用</MudTh>
                        <MudTh Style="width:200px;">备注</MudTh>
                        <MudTh Style="width: 60px;">操作</MudTh>
                    </HeaderContent>
                    <RowTemplate Context="row">
                        <MudTd>
                            <MudText Typo="Typo.body2">@row.Sequence</MudText>
                        </MudTd>
                        <MudTd>
                            <MudSelect T="MaterialType" @bind-Value="row.MaterialCategory"
                                       Dense="true" Variant="Variant.Outlined" Size="Size.Small">
                                @foreach (var cat in materialCategories)
                                {
                                    <MudSelectItem Value="@(cat)">@DisplayHelper.GetMaterialTypeText(cat)</MudSelectItem>
                                }
                            </MudSelect>
                        </MudTd>
                        <MudTd>
                            <MudTextField T="string"
                                          @bind-Value="row.PlantGrade"
                                          Dense="true"
                                          Variant="Variant.Outlined"
                                          Size="Size.Small"
                                          />
                        </MudTd>
                        <MudTd>
                            <MudTextField T="string"
                                          @bind-Value="row.Specification"
                                          Dense="true"
                                          Variant="Variant.Outlined"
                                          Size="Size.Small"
                                          />
                        </MudTd>
                        <MudTd>
                            <MudCheckBox @bind-Value="row.IsActive" />
                        </MudTd>
                        <MudTd>
                            <MudTextField T="string"
                                          @bind-Value="row.Remark"
                                          Dense="true"
                                          Variant="Variant.Outlined"
                                          Size="Size.Small"
                                          />
                        </MudTd>
                        <MudTd>
                            @if (rows.Count > 1)
                            {
                                <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                               Color="Color.Error"
                                               Size="Size.Small"
                                               OnClick="() => RemoveRow(row)" />
                            }
                        </MudTd>
                    </RowTemplate>
                </MudTable>
            </div>
        </MudCardContent>
    </MudCard>
</MudContainer>

@code {
    private List<MaterialRow> rows = new();
    private bool isSubmitting;
    private List<MaterialType> materialCategories = new();
    private bool _isArrowNavSetup;

    private class MaterialRow
    {
        public int Sequence { get; set; }
        public MaterialType MaterialCategory { get; set; }
        public string PlantGrade { get; set; } = string.Empty;
        public string Specification { get; set; } = string.Empty;
        public bool IsActive { get; set; } = true;
        public string? Remark { get; set; }
    }

    protected override Task OnInitializedAsync()
    {
        materialCategories = Enum.GetValues<MaterialType>().ToList();
        AddRow();
        return Task.CompletedTask;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_isArrowNavSetup)
        {
            _isArrowNavSetup = true;
            if (!await JS.InvokeAsync<bool>("enableTableArrowNav", "#materials-create-table"))
                _isArrowNavSetup = false;
        }
    }

    private void AddRow()
    {
        rows.Add(new MaterialRow { Sequence = rows.Count + 1 });
    }

    private void RemoveRow(MaterialRow row)
    {
        if (rows.Count <= 1) { Snackbar.Add("至少保留一条记录", Severity.Warning); return; }
        rows.Remove(row);
        for (int i = 0; i < rows.Count; i++) rows[i].Sequence = i + 1;
    }

    private async Task SaveAll()
    {
        var errors = new List<string>();
        for (int i = 0; i < rows.Count; i++)
        {
            var r = rows[i];
            var seq = i + 1;
            if (string.IsNullOrWhiteSpace(r.PlantGrade)) errors.Add($"行{seq}: 厂内钢种不能为空");
            if (string.IsNullOrWhiteSpace(r.Specification)) errors.Add($"行{seq}: 名义规格不能为空");
        }
        if (errors.Any()) { Snackbar.Add(string.Join("；", errors), Severity.Warning); return; }

        isSubmitting = true; StateHasChanged();

        var requests = rows.Select(r => new CreateMaterialRequest
        {
            MaterialCategory = r.MaterialCategory,
            PlantGrade = r.PlantGrade,
            Specification = r.Specification,
            IsActive = r.IsActive,
            Remark = r.Remark
        }).ToList();

        try
        {
            var result = await MaterialService.CreateBatchAsync(requests);
            isSubmitting = false; StateHasChanged();

            if (result.Success)
            {
                Snackbar.Add($"成功创建 {result.Data?.Count ?? 0} 条记录", Severity.Success);
                Navigation.NavigateTo("/materials");
            }
            else
            {
                Snackbar.Add($"批量创建失败：{result.Message}", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            isSubmitting = false; StateHasChanged();
            Snackbar.Add($"批量创建失败：{ex.Message}", Severity.Error);
        }
    }

    private void GoBack() => Navigation.NavigateTo("/materials");
}
