@page "/material-checks"
@using MES.Blazor.Services
@using MES.Core.DTOs
@using MES.Core.Models
@using MES.Blazor.Helpers
@using Microsoft.AspNetCore.Authorization
@using MES.Blazor.Shared
@inject ProductionRecordService ProductionRecordService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject IJSRuntime JS
@inject ColumnPrefsService ColumnPrefs
@inject PageStateService PageState
@attribute [Authorize(Roles = Roles.Policies.BatchRead)]

<MudContainer MaxWidth="MaxWidth.False" Class="mt-4 pl-0">
    <MudCard>
        <MudCardHeader>
            <CardHeaderContent>
                <MudText Typo="Typo.h5" Class="font-weight-bold">
                    <MudIcon Icon="@Icons.Material.Filled.Inventory2" Class="mr-2" Color="Color.Primary" />
                    成检到料
                </MudText>
            </CardHeaderContent>
            <CardHeaderActions>
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Add"
                           OnClick="NavigateToCreate">
                    新建
                </MudButton>
            </CardHeaderActions>
        </MudCardHeader>

        <MudCardContent>
            <!-- 搜索栏 -->
            <MudGrid>
                <MudItem xs="12" md="6">
                    <MudTextField T="string"
                                  Label="模糊搜索 - 批次号/制造物品/钢种/规格/确认人"
                                  Value="_searchKeyword"
                                  ValueChanged="@OnSearchChanged"
                                  Immediate="true"
                                  DebounceInterval="500"
                                  Clearable="true"
                                  ClearButton="true"
                                  Adornment="Adornment.End"
                                  AdornmentIcon="@Icons.Material.Filled.Search" />
                </MudItem>
            </MudGrid>

            <!-- 待成检到料卡片 -->
            @if (_pendingItems.Any())
            {
                <MudPaper Class="pa-3 mb-3" Elevation="0" Style="border: 1px solid #e0e0e0; border-radius: 8px;">
                    <div Class="d-flex align-center" style="cursor: pointer;" @onclick="TogglePendingMaterialChecks">
                        <MudIcon Icon="@Icons.Material.Filled.Inbox" Color="Color.Info" Class="mr-2" />
                        <MudText Typo="Typo.body1" Class="font-weight-bold flex-grow-1">待成检到料批次</MudText>
                        <MudChip Size="Size.Small" Color="Color.Warning" Class="mr-1">待处理 @_pendingItems.Count</MudChip>
                        <MudIcon Icon="@(_showPending ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)" Color="Color.Default" />
                    </div>
                    @if (_showPending)
                    {
                        <div style="overflow-x: auto; overflow-y: auto; margin-top: 8px; max-height: 25vh;">
                            <MudTable T="PendingMaterialCheckDto" Items="@_pendingItems" Dense="true" Hover="true" Elevation="0" Class="auto-table">
                                <HeaderContent>
                                    <MudTh Style="width: 120px;">生产编号</MudTh>
                                    <MudTh Style="width: 110px;">工单号</MudTh>
                                    <MudTh Style="width: 80px;">业务员</MudTh>
                                    <MudTh Style="width: 100px;">工厂牌号</MudTh>
                                    <MudTh Style="width: 120px;">规格</MudTh>
                                    <MudTh Style="width: 80px;">重量</MudTh>
                                    <MudTh Style="width: 100px;">执行截止日</MudTh>
                                    <MudTh Style="width: 80px;">截止工段</MudTh>
                                </HeaderContent>
                                <RowTemplate>
                                    <MudTd>
                                        <MudLink Typo="Typo.body2" OnClick="@(() => NavigateToCreateWithBatch(context.BatchNo))">
                                            @context.BatchNo
                                        </MudLink>
                                    </MudTd>
                                    <MudTd>@context.WorkOrderNo</MudTd>
                                    <MudTd>@context.Salesman</MudTd>
                                    <MudTd>@context.PlantGrade</MudTd>
                                    <MudTd>@context.Specification</MudTd>
                                    <MudTd>@((int)context.CurrentValidWeight)</MudTd>
                                    <MudTd>@context.CurrentExecDate?.ToString("yyyy-MM-dd")</MudTd>
                                    <MudTd>@context.CurrentSectionName</MudTd>
                                </RowTemplate>
                            </MudTable>
                        </div>
                    }
                </MudPaper>
            }

            <!-- 数据表格 -->
            <div id="material-checks-list-table">
            <MudTable @ref="table"
                      T="MaterialReceiveCheckDto"
                      ServerData="@LoadDataFromServer"
                      Dense="true"
                      Hover="true"
                      Class="mt-4 auto-table compact-table"
                      Elevation="0"
                      RowsPerPage="@_pageSize"
                      RowsPerPageLabel="每页行数:">
                <ToolBarContent>
                    <ColumnDisplaySelect Columns="_allColumns"
                                         OnColumnToggle="OnColumnToggle"
                                         OnMoveUp="MoveColumnUp"
                                         OnMoveDown="MoveColumnDown" />
                    <MudButton Variant="Variant.Text" Size="Size.Small"
                               Color="Color.Default"
                               StartIcon="@Icons.Material.Filled.RestartAlt"
                               OnClick="ResetColumnDisplay" Class="ml-2">
                        重置
                    </MudButton>
                    <MudSpacer />
                    <MudButton Variant="Variant.Outlined"
                               Size="Size.Small"
                               Color="Color.Info"
                               StartIcon="@Icons.Material.Filled.Print"
                               Disabled="@(!selectedIds.Any())"
                               OnClick="PrintSelected">
                        打印选中 (@selectedIds.Count)
                    </MudButton>
                    <MudButton Variant="Variant.Text"
                               Size="Size.Small"
                               Color="Color.Info"
                               StartIcon="@Icons.Material.Filled.Print"
                               OnClick="PrintAll">
                        打印全部
                    </MudButton>
                    <MudText Typo="Typo.body2" Class="ml-4">
                        共 @_totalCount 条记录
                    </MudText>
                </ToolBarContent>
                <HeaderContent>
                    <MudTh Style="width: 40px;">
                        <MudCheckBox T="bool" Value="@_allSelected" ValueChanged="@((v) => { _allSelected = v; if (v) { selectedIds.Clear(); foreach (var i in _pageItems) selectedIds.Add(i.Id); } else { selectedIds.Clear(); } StateHasChanged(); })" Dense="true" />
                    </MudTh>
                    @foreach (var col in _visibleColumns)
                    {
                        <MudTh Style="@($"width:{col.Width}px")">
                            <div style="display:inline-flex; align-items:center; gap:4px;">
                                <span @onclick='() => ToggleSort(col.SortKey)' style="cursor:pointer" class="th-label">@col.Label @if (sortColumn == col.SortKey) {@(sortDescending ? " ▼" : " ▲")}</span>
                                @if (col.FilterType != null)
                                {
                                    <ExcelFilter T="MaterialReceiveCheckDto"
                                                 Label="@col.Label"
                                                 FieldKey="@col.Key"
                                                 FilterOptions="@(_filterContextOptions.GetValueOrDefault(col.Key))"
                                                 ActiveFilterValues="@(_columnFilters.GetValueOrDefault(col.Key))"
                                                 FilterChanged="@(args => OnColumnFilterChanged(args.fieldKey, args.selectedValues))" />

                                }
                            </div>
                        </MudTh>
                    }
                    <MudTh Style="width: 100px;">操作</MudTh>
                </HeaderContent>
                <RowTemplate Context="item">
                    <MudTd Style="width: 40px;">
                        @if (!_editingIds.Contains(item.Id))
                        {
                            <MudCheckBox T="bool"
                                         Value="@selectedIds.Contains(item.Id)"
                                         ValueChanged="@((v) => { if(v) selectedIds.Add(item.Id); else selectedIds.Remove(item.Id); _allSelected = _pageItems.Any() && _pageItems.All(i => selectedIds.Contains(i.Id)); StateHasChanged(); })"
                                         Dense="true" />
                        }
                    </MudTd>
                    @foreach (var col in _visibleColumns)
                    {
                        <MudTd>@RenderCell(item, col)</MudTd>
                    }
                    <MudTd>
                        @if (_editingIds.Contains(item.Id))
                        {
                            <MudIconButton Icon="@Icons.Material.Filled.Save"
                                           Color="Color.Success" Size="Size.Small"
                                           Title="保存"
                                           OnClick="() => SaveEdit(item)"
                                           Disabled="@_isSaving" />
                            <MudIconButton Icon="@Icons.Material.Filled.Close"
                                           Color="Color.Default" Size="Size.Small"
                                           Title="取消"
                                           OnClick="() => CancelEdit(item)" />
                        }
                        else
                        {
                            <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                           Color="Color.Warning" Size="Size.Small"
                                           Title="编辑"
                                           OnClick="() => StartEdit(item)" />
                            <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                           Color="Color.Error" Size="Size.Small"
                                           Title="删除"
                                           OnClick="() => DeleteItem(item)" />
                        }
                    </MudTd>
                </RowTemplate>
                <FooterContent>
                    <MudTd></MudTd>
                    @foreach (var col in _visibleColumns)
                    {
                        <MudTd Class="col-footer-cell"><span class="col-footer-sum">@RenderFooterCell(col)</span></MudTd>
                    }
                    <MudTd></MudTd>
                </FooterContent>
                <PagerContent>
                    <MudTablePager PageSizeOptions="new int[]{10,15,25,50,100}" />
                </PagerContent>
            </MudTable>
            </div>
        </MudCardContent>
    </MudCard>
</MudContainer>
