@page "/quality/final-inspection"
@using MES.Blazor.Services
@using MES.Core.Models
@using MES.Blazor.Models
@using Microsoft.AspNetCore.Authorization
@using MES.Blazor.Shared
@using MES.Core.DTOs.Quality
@inject FinalInspectionService FinalInspectionService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject IJSRuntime JS
@inject ColumnPrefsService ColumnPrefs
@inject PageStateService PageState
@inject HttpClient Http
@attribute [Authorize(Roles = Roles.Policies.QualityView)]

<MudContainer MaxWidth="MaxWidth.False" Class="mt-4 pl-0">
    <MudCard>
        <MudCardHeader>
            <CardHeaderContent>
                <MudText Typo="Typo.h5" Class="font-weight-bold">
                    <MudIcon Icon="@Icons.Material.Filled.Assignment" Class="mr-2" Color="Color.Primary" />
                    成品检验
                </MudText>
            </CardHeaderContent>
            <CardHeaderActions>
                <MudButton Variant="Variant.Outlined"
                           Color="@(_showRecentSummaryCard ? Color.Primary : Color.Default)"
                           StartIcon="@(_showRecentSummaryCard ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)"
                           OnClick="ToggleRecentSummaryCard">
                    近日成检量数据
                </MudButton>
                <MudButton Variant="Variant.Outlined"
                           Color="@(_showMonthlySummaryCard ? Color.Primary : Color.Default)"
                           StartIcon="@(_showMonthlySummaryCard ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)"
                           OnClick="ToggleMonthlySummaryCard">
                    月度成检量数据
                </MudButton>
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Add"
                           OnClick="NavigateToCreate">
                    新建
                </MudButton>
            </CardHeaderActions>
        </MudCardHeader>

        <MudCardContent>
            <!-- 产量统计：近日成检量数据（折叠卡片，按检验项目统计） -->
            @if (_showRecentSummaryCard)
            {
                <MudCard Class="mb-2 summary-card" Elevation="0">
                    <MudCardContent>
                        @if (_isLoadingRecentSummary)
                        {
                            <div class="d-flex align-center" style="gap:8px;">
                                <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                                <span>近日成检量加载中...</span>
                            </div>
                        }
                        else
                        {
                            <div class="d-flex justify-space-between align-center mb-2">
                                <MudText Typo="Typo.subtitle2"><b>近日成检量数据</b></MudText>
                                <MudButton Variant="Variant.Text" Size="Size.Small" Color="Color.Primary"
                                           StartIcon="@Icons.Material.Filled.Print" OnClick="PrintRecentSummaryTable">
                                    打印
                                </MudButton>
                            </div>
                            <div id="final-inspection-recent-summary-table" style="overflow-x:auto;">
                                <table style="border-collapse: collapse; width: 100%; font-size: 0.8125rem;">
                                    <thead>
                                        <tr>
                                            <th style="text-align:left; padding:4px 10px; background:#f5f5f5; border:1px solid #e0e0e0;">检验项目</th>
                                            <th style="padding:4px 10px; background:#f5f5f5; border:1px solid #e0e0e0; text-align:center;">前6日(t)</th>
                                            <th style="padding:4px 10px; background:#f5f5f5; border:1px solid #e0e0e0; text-align:center;">前3日(t)</th>
                                            <th style="padding:4px 10px; background:#fff8e1; border:1px solid #e0e0e0; text-align:center;">今日(t)</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var r in _recentSummaryRows)
                                        {
                                            var isTotal = r.InspectionItem == "合计";
                                            <tr>
                                                <td style="padding:4px 10px; border:1px solid #e0e0e0; font-weight:@(isTotal ? "700" : "600"); @(isTotal ? "background:#eef3fa;" : "")">@r.InspectionItem</td>
                                                <td style="padding:4px 10px; border:1px solid #e0e0e0; text-align:center; @(isTotal ? "background:#eef3fa;" : "")">@FormatT(r.Last7DaysWeight)</td>
                                                <td style="padding:4px 10px; border:1px solid #e0e0e0; text-align:center; @(isTotal ? "background:#eef3fa;" : "")">@FormatT(r.Last3DaysWeight)</td>
                                                <td style="padding:4px 10px; border:1px solid #e0e0e0; text-align:center; @(isTotal ? "background:#eef3fa;" : "background:#fff8e1;")">@FormatT(r.TodayWeight)</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                            <MudText Typo="Typo.body2" Class="text-hint" Style="margin-top:4px; font-size:0.75rem;">
                                注：前6日/前3日均不含今日，今日列为实时数据（浅黄底色）；按检验项目统计检验重量（成品检验记录 Weight，预检/终检合并）；合计行=各检验项目之和；0 值留空。
                            </MudText>
                        }
                    </MudCardContent>
                </MudCard>
            }

            <!-- 产量统计：月度成检量数据（折叠卡片，按本年 1月~12月统计，末列"合计"=该行各月之和） -->
            @if (_showMonthlySummaryCard)
            {
                <MudCard Class="mb-2 summary-card" Elevation="0">
                    <MudCardContent>
                        @if (_isLoadingMonthlySummary)
                        {
                            <div class="d-flex align-center" style="gap:8px;">
                                <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                                <span>月度成检量加载中...</span>
                            </div>
                        }
                        else
                        {
                            <div class="d-flex justify-space-between align-center mb-2">
                                <MudText Typo="Typo.subtitle2"><b>月度成检量数据</b></MudText>
                                <MudButton Variant="Variant.Text" Size="Size.Small" Color="Color.Primary"
                                           StartIcon="@Icons.Material.Filled.Print" OnClick="PrintMonthlySummaryTable">
                                    打印
                                </MudButton>
                            </div>
                            <div id="final-inspection-monthly-summary-table" style="overflow-x:auto;">
                                <table style="border-collapse: collapse; width: 100%; font-size: 0.8125rem;">
                                    <thead>
                                        <tr>
                                            <th style="text-align:left; padding:4px 10px; background:#f5f5f5; border:1px solid #e0e0e0;">检验项目</th>
                                            @foreach (var label in _monthlyLabels)
                                            {
                                                <th style="padding:4px 10px; background:#f5f5f5; border:1px solid #e0e0e0; text-align:center;">@label</th>
                                            }
                                            <th style="padding:4px 10px; background:#fff8e1; border:1px solid #e0e0e0; text-align:center;">合计(t)</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var r in _monthlySummaryRows)
                                        {
                                            var isTotal = r.InspectionItem == "合计";
                                            <tr>
                                                <td style="padding:4px 10px; border:1px solid #e0e0e0; font-weight:@(isTotal ? "700" : "600"); @(isTotal ? "background:#eef3fa;" : "")">@r.InspectionItem</td>
                                                @for (var m = 0; m < _monthlyLabels.Count; m++)
                                                {
                                                    var val = m < r.MonthlyWeights.Count ? r.MonthlyWeights[m] : 0m;
                                                    <td style="padding:4px 10px; border:1px solid #e0e0e0; text-align:center; @(isTotal ? "background:#eef3fa;" : "")">@FormatT(val)</td>
                                                }
                                                <td style="padding:4px 10px; border:1px solid #e0e0e0; text-align:center; font-weight:700; @(isTotal ? "background:#eef3fa;" : "background:#fff8e1;")">@FormatT(r.MonthlyWeights.Sum())</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                            <MudText Typo="Typo.body2" Class="text-hint" Style="margin-top:4px; font-size:0.75rem;">
                                注：按本年度各月份统计；按检验项目统计检验重量（成品检验记录 Weight，预检/终检合并）；末列"合计"=该行 1月~12月之和；0 值留空。
                            </MudText>
                        }
                    </MudCardContent>
                </MudCard>
            }

            <!-- 搜索栏 -->
            <MudGrid>
                <MudItem xs="12" md="6">
                    <MudTextField T="string"
                                  Label="模糊搜索 - 生产编号/物料类型/牌号/规格"
                                  Value="_searchKeyword" ValueExpression="@(() => _searchKeyword)"
                                  ValueChanged="@OnSearchChanged"
                                  Immediate="true"
                                  DebounceInterval="500"
                                  Adornment="Adornment.End"
                                  AdornmentIcon="@Icons.Material.Filled.Search" />
                </MudItem>
                <MudItem xs="12" md="3">
                    <MudTextField T="string"
                                  Label="日期从"
                                  Value="_dateFrom"
                                  ValueChanged="@OnDateFromChanged"
                                  Immediate="true"
                                  DebounceInterval="500"
                                  Placeholder="yyyy-MM-dd" />
                </MudItem>
                <MudItem xs="12" md="3">
                    <MudTextField T="string"
                                  Label="日期至"
                                  Value="_dateTo"
                                  ValueChanged="@OnDateToChanged"
                                  Immediate="true"
                                  DebounceInterval="500"
                                  Placeholder="yyyy-MM-dd" />
                </MudItem>
            </MudGrid>

            <!-- 实时健康校验通知条（按当前筛选条件列出「成检类型与成检到料不符」的生产编号） -->
            @if (_healthSummary is { IssueCount: > 0 } health)
            {
                <MudAlert Severity="Severity.Warning" Dismissible="true" Class="mb-3"
                          OnClose="() => _healthSummary = null">
                    <MudText Typo="Typo.body2">
                        <strong>异常：</strong>
                        @if (health.InspectionTypeMismatchBatchNos.Count > 0)
                        {
                            <div>（1）成检类型疑问：@string.Join("，", health.InspectionTypeMismatchBatchNos)</div>
                        }
                        @if (health.NoMaterialCheckBatchNos.Count > 0)
                        {
                            <div>（2）无成检到料：@string.Join("，", health.NoMaterialCheckBatchNos)</div>
                        }
                    </MudText>
                </MudAlert>
            }

            <!-- 数据表格 -->
            <div id="final-inspection-list-table">
            <div class="list-toolbar">
                <div class="d-flex align-center">
                    <ColumnDisplaySelect Columns="_allColumns"
                                         OnColumnToggle="OnColumnToggle"
                                         OnMoveUp="MoveColumnUp"
                                         OnMoveDown="MoveColumnDown" />
                    <MudButton Variant="Variant.Text" Size="Size.Small"
                               Color="Color.Default"
                               StartIcon="@Icons.Material.Filled.RestartAlt"
                               OnClick="ResetColumnDisplay" Class="ml-2">
                        重置
                    </MudButton>
                </div>
                <div class="d-flex align-center" style="margin-left:auto;">
                    <MudButton Variant="Variant.Outlined"
                               Size="Size.Small"
                               Color="Color.Info"
                               StartIcon="@Icons.Material.Filled.Print"
                               Disabled="@(!selectedIds.Any())"
                               OnClick="PrintSelected">
                        打印选中 (@selectedIds.Count)
                    </MudButton>
                    <MudButton Variant="Variant.Text"
                               Size="Size.Small"
                               Color="Color.Info"
                               StartIcon="@Icons.Material.Filled.Print"
                               OnClick="PrintAll">
                        打印全部
                    </MudButton>
                    <MudText Typo="Typo.body2" Class="ml-4">
                        共 @_totalCount 条记录
                    </MudText>
                </div>
            </div>
            @* 分组标题栏 *@
            <div class="col-group-header-scroll" id="final-inspection-group-header-scroll">
                <div class="col-group-header-bar" style="width: @(_totalTableWidth)px">
                    @foreach (var gh in GetGroupHeaders())
                    {
                        <div class="col-group-header-item @gh.CssClass" style="width: @(gh.TotalWidth)px">
                            <span class="col-group-badge">@gh.GroupName</span>
                        </div>
                    }
                </div>
            </div>
            <MudTable @ref="table"
                      T="FinalInspectionDto"
                      ServerData="@LoadDataFromServer"
                      Dense="true"
                      Hover="true"
                      Class="mt-0 auto-table compact-table"
                      Elevation="0"
                      RowsPerPage="@_pageSize">
                <HeaderContent>
                    <MudTh Class="col-selection-th" Style="width:40px;padding:0 4px;">
                        <MudCheckBox T="bool" @bind-Value="allSelected" Dense="true" />
                    </MudTh>
                    @{
                        int? _prevGk = null;
                    }
                    @foreach (var col in _visibleColumns)
                    {
                        var _isGroupStart = col.GroupKey.HasValue && col.GroupKey != _prevGk;
                        _prevGk = col.GroupKey;
                        var _headerClass = GetHeaderGroupCss(col.GroupKey, _isGroupStart);
                        <MudTh Class="@_headerClass" Style="@($"width:{col.Width}px")">
                            <div style="display:inline-flex; align-items:center; gap:4px;">
                                <span @onclick='() => ToggleSort(col.Key)' style="cursor:pointer" class="th-label">@col.Label @if (sortColumn == col.Key) {@(sortDescending ? " ▼" : " ▲")}</span>
                                @if (col.FilterType != null)
                                {
                                    <ExcelFilter T="FinalInspectionDto"
                                                 Label="@col.Label"
                                                 FieldKey="@col.Key"
                                                 FilterOptions="@(_filterContextOptions.GetValueOrDefault(col.Key))"
                                                 ActiveFilterValues="@(_columnFilters.GetValueOrDefault(col.Key))"
                                                 FilterChanged="@(args => OnColumnFilterChanged(args.fieldKey, args.selectedValues))" />

                                }
                            </div>
                        </MudTh>
                    }
                    <MudTh Style="width: 90px;" Class="@GetHeaderGroupCss(null, false)">操作</MudTh>
                </HeaderContent>
                <RowTemplate Context="item">
                    <MudTd Class="col-selection-td" Style="width:40px;padding:0 4px;">
                        @if (!_editingIds.Contains(item.Id))
                        {
                            <MudCheckBox T="bool"
                                         Value="@selectedIds.Contains(item.Id)"
                                         ValueChanged="@((v) => { if(v) selectedIds.Add(item.Id); else selectedIds.Remove(item.Id); StateHasChanged(); })"
                                         Dense="true" />
                        }
                    </MudTd>
                    @{
                        int? _prevGk2 = null;
                    }
                    @foreach (var col in _visibleColumns)
                    {
                        var _isGroupStart2 = col.GroupKey.HasValue && col.GroupKey != _prevGk2;
                        _prevGk2 = col.GroupKey;
                        var _cellClass = GetCellGroupCss(col.GroupKey, _isGroupStart2);
                        <MudTd Class="@_cellClass">@RenderCell(item, col)</MudTd>
                    }
                    <MudTd Style="white-space: nowrap; width: 90px;">
                        @{
                            var isEditing = _editingIds.Contains(item.Id);
                        }
                        @if (isEditing)
                        {
                            <MudIconButton Icon="@Icons.Material.Filled.Check" Color="Color.Success" Size="Size.Small" OnClick="() => SaveEdit(item)" Disabled="@_isSaving" />
                            <MudIconButton Icon="@Icons.Material.Filled.Close" Color="Color.Default" Size="Size.Small" OnClick="() => CancelEdit(item)" />
                        }
                        else
                        {
                            <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Info" Size="Size.Small" OnClick="() => StartEdit(item)" />
                        <AuthorizeView Roles="@Roles.Policies.QualityDelete">
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" Title="删除" OnClick="() => DeleteItem(item)" />
                        </AuthorizeView>
                        }
                    </MudTd>
                </RowTemplate>
                <FooterContent>
                    <MudTd Class="col-selection-td col-footer-cell" Style="width:40px;padding:0 4px;"></MudTd>
                    @{
                        int? _prevGk3 = null;
                    }
                    @foreach (var col in _visibleColumns)
                    {
                        var _isGroupStart3 = col.GroupKey.HasValue && col.GroupKey != _prevGk3;
                        _prevGk3 = col.GroupKey;
                        var _footerCellClass = GetCellGroupCss(col.GroupKey, _isGroupStart3) + " col-footer-cell";
                        <MudTd Class="@_footerCellClass"><span class="col-footer-sum">@RenderFooterCell(col)</span></MudTd>
                    }
                    <MudTd Class="col-footer-cell"></MudTd>
                </FooterContent>
                <PagerContent>
                    <MudTablePager PageSizeOptions="new int[]{10,15,25,50,100}" />
                </PagerContent>
            </MudTable>
            </div>
        </MudCardContent>
    </MudCard>
</MudContainer>

