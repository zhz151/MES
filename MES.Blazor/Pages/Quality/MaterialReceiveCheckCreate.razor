@page "/quality/material-receive-checks/create"
@using MES.Blazor.Services
@using Microsoft.AspNetCore.Authorization
@using MES.Blazor.Shared
@using MES.Core.DTOs.Quality
@using MES.Core.Enums
@using MES.Blazor.Helpers
@inject MaterialReceiveCheckService ProdRecordService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject IJSRuntime JS
@inject ColumnPrefsService ColumnPrefs
@attribute [Authorize(Roles = Roles.Policies.QualityEdit)]

<MudContainer MaxWidth="MaxWidth.False" Class="mt-4">
    <style>
        .edit-table td.mud-table-cell,
        .edit-table th.mud-table-cell {
            padding: 1px 4px !important;
        }
        .edit-table .mud-input-input-control {
            margin-top: 0;
        }
        .edit-table .mud-input {
            font-size: 13px;
            width: 100%;
            min-width: 0;
        }
        .edit-table th.mud-table-cell {
            white-space: nowrap;
        }
        .table-scroll {
            max-height: calc(100vh - 280px);
            overflow-y: auto;
            overflow-x: auto;
        }
    </style>

    <MudCard>
        <MudCardHeader>
            <CardHeaderContent>
                <MudText Typo="Typo.h5" Class="font-weight-bold">
                    <MudIcon Icon="@Icons.Material.Filled.AddCircleOutline" Class="mr-2" Color="Color.Primary" />
                    新建成检到料
                </MudText>
            </CardHeaderContent>
            <CardHeaderActions>
                <MudButton Variant="Variant.Text" Color="Color.Default" OnClick="GoBack">返回</MudButton>
            </CardHeaderActions>
        </MudCardHeader>

        <MudCardContent>

            <!-- 待成检到料卡片 -->
            @if (_pendingItems.Any())
            {
                <MudPaper Class="pa-3 mb-3 form-card" Elevation="0">
                    <div Class="d-flex align-center" style="cursor: pointer;" @onclick="TogglePendingMaterialChecks">
                        <MudIcon Icon="@Icons.Material.Filled.Inbox" Color="Color.Info" Class="mr-2" />
                        <MudText Typo="Typo.body1" Class="font-weight-bold flex-grow-1">待成检到料批次</MudText>
                        <MudChip Size="Size.Small" Color="Color.Warning" Class="mr-1">待处理 @_pendingItems.Count</MudChip>
                        <MudIcon Icon="@(_showPending ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)" Color="Color.Default" />
                    </div>
                    @if (_showPending)
                    {
                        <div style="overflow-x: auto; overflow-y: auto; margin-top: 8px; max-height: 25vh;">
                            <MudTable T="PendingMaterialCheckDto" Items="@_pendingItems" Dense="true" Hover="true" Elevation="0" Class="auto-table">
                                <HeaderContent>
                                    <MudTh Style="width: 120px;">生产编号</MudTh>
                                    <MudTh Style="width: 110px;">工单号</MudTh>
                                    <MudTh Style="width: 80px;">业务员</MudTh>
                                    <MudTh Style="width: 100px;">工厂牌号</MudTh>
                                    <MudTh Style="width: 120px;">规格</MudTh>
                                    <MudTh Style="width: 80px;">重量</MudTh>
                                    <MudTh Style="width: 100px;">执行截止日</MudTh>
                                    <MudTh Style="width: 80px;">截止工段</MudTh>
                                    <MudTh Style="width: 100px;">匹配工序组</MudTh>
                                    <MudTh Style="width: 60px;">操作</MudTh>
                                </HeaderContent>
                                <RowTemplate>
                                    <MudTd>@context.BatchNo</MudTd>
                                    <MudTd>@context.WorkOrderNo</MudTd>
                                    <MudTd>@context.Salesman</MudTd>
                                    <MudTd>@context.PlantGrade</MudTd>
                                    <MudTd>@context.Specification</MudTd>
                                    <MudTd>@((int)context.CurrentValidWeight)</MudTd>
                                    <MudTd>@context.CurrentExecDate?.ToString("yyyy-MM-dd")</MudTd>
                                    <MudTd>@SectionDisplayHelper.GetSectionNameText(context.CurrentSectionName)</MudTd>
                                    <MudTd>@ProcessDisplayHelper.GetProcessNameText(context.ProcessGroupName)</MudTd>
                                    <MudTd>
                                        <MudIconButton Icon="@Icons.Material.Filled.AddCircle"
                                                       Color="Color.Primary" Size="Size.Small"
                                                       Title="添加行"
                                                       OnClick="() => AddRowFromPending(context)" />
                                    </MudTd>
                                </RowTemplate>
                            </MudTable>
                        </div>
                    }
                </MudPaper>
            }

            <div id="material-check-create-table">
                @if (_rows.Any())
                {
                    <div class="d-flex align-center mb-2">
                        <ColumnDisplaySelect Columns="_allColumns"
                                             OnColumnToggle="OnColumnToggle"
                                             OnMoveUp="MoveColumnUp"
                                             OnMoveDown="MoveColumnDown" />
                        <MudButton Variant="Variant.Text" Size="Size.Small"
                                   Color="Color.Default"
                                   StartIcon="@Icons.Material.Filled.RestartAlt"
                                   OnClick="ResetColumnDisplay" Class="ml-2">
                            重置
                        </MudButton>
                        <MudSpacer />
                        <MudText Typo="Typo.body2">共 @_rows.Count 行</MudText>
                        <MudButton Variant="Variant.Text" Size="Size.Small"
                                   Color="Color.Default"
                                   StartIcon="@Icons.Material.Filled.AddCircleOutline"
                                   OnClick="AddRow" Class="ml-2">
                            添加行
                        </MudButton>
                    </div>
                    <div class="table-scroll">
                        <MudTable Items="@_rows" Dense="true" Hover="true" Elevation="0" Striped="true"
                                  Class="edit-table auto-table" SortMode="SortMode.None" FixedHeader="true">
                            <HeaderContent>
                                @foreach (var col in _visibleColumns)
                                {
                                    <MudTh>
                                        @col.Label
                                        @if (col.IsRequired)
                                        {
                                            <span class="required-star">*</span>
                                        }
                                    </MudTh>
                                }
                                <MudTh Style="width:60px;">操作</MudTh>
                            </HeaderContent>
                            <RowTemplate Context="r">
                                @foreach (var col in _visibleColumns)
                                {
                                    <MudTd>@RenderCell(r, col)</MudTd>
                                }
                                <MudTd>
                                    <MudIconButton Icon="@Icons.Material.Filled.RemoveCircleOutline"
                                                   Color="Color.Error" Size="Size.Small"
                                                   Title="删除"
                                                   OnClick="() => RemoveRow(r)"
                                                   Disabled="@(_rows.Count <= 1)" />
                                </MudTd>
                            </RowTemplate>
                            <FooterContent>
                                <MudTd colspan="@(_visibleColumns.Count + 1)">
                                    <MudIconButton Icon="@Icons.Material.Filled.AddCircleOutline"
                                                   Color="Color.Primary" Size="Size.Small"
                                                   OnClick="AddRow" />
                                </MudTd>
                            </FooterContent>
                        </MudTable>
                    </div>
                }
            </div>

            @if (!string.IsNullOrEmpty(_errorMessage))
            {
                <MudText Typo="Typo.body2" Color="Color.Error" Class="mt-4">@_errorMessage</MudText>
            }

            @if (_rows.Any())
            {
                <MudGrid Class="mt-4">
                    <MudItem xs="12" Class="d-flex justify-end">
                        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.CloudUpload"
                                   OnClick="Submit" Loading="@_isSubmitting"
                                   Size="Size.Large">
                            确认提交 (@_rows.Count 条)
                        </MudButton>
                    </MudItem>
                </MudGrid>
            }
        </MudCardContent>
    </MudCard>
</MudContainer>

@code {
    private List<EditRow> _rows = new();
    private bool _isSubmitting;
    private bool _isArrowNavSetup;
    private string _errorMessage = string.Empty;

    // ========== 待成检到料卡片 ==========

    private List<PendingMaterialCheckDto> _pendingItems = new();
    private bool _showPending = true;

    private async Task LoadPendingMaterialChecksAsync()
    {
        try
        {
            var result = await ProdRecordService.GetPendingMaterialChecksAsync();
            if (result.Success && result.Data != null)
                _pendingItems = result.Data;
        }
        catch { }
    }

    private void TogglePendingMaterialChecks() => _showPending = !_showPending;

    private void AddRowFromPending(PendingMaterialCheckDto item)
    {
        var existing = _rows.FirstOrDefault(r => r.BatchNo == item.BatchNo);
        if (existing != null)
        {
            Snackbar.Add($"批次 {item.BatchNo} 已在列表中", Severity.Info);
            return;
        }
        _rows.Add(new EditRow
        {
            ReceiveDate = DateTime.Today.ToString("yyyy-MM-dd"),
            BatchNo = item.BatchNo,
            ProcessName = item.ProcessGroupName,
            ProcessGroupId = item.ProcessGroupId
        });
        Snackbar.Add($"已添加批次 {item.BatchNo}", Severity.Success);
        StateHasChanged();
    }

    // ========== 列定义 ==========

    private List<ColumnDef> _allColumns = new();
    private List<ColumnDef> _visibleColumns =>
        _allColumns.Where(c => c.IsApplicable && c.Visible).ToList();

    private static List<ColumnDef> GetAllColumnDefs() => new()
    {
        new() { Key = "ReceiveDate",       Label = "到料日期", IsRequired = true },
        new() { Key = "BatchNo",           Label = "生产编号", IsRequired = true },
        new() { Key = "ProcessName",       Label = "工序名称" },
        new() { Key = "Shift",             Label = "班次" },
        new() { Key = "Checker",           Label = "检验员" },
        new() { Key = "Remark",            Label = "备注" },
    };

    private async Task OnColumnToggle(ColumnDef col)
    {
        await SaveColumnPrefs();
    }

    private async Task SaveColumnPrefs()
    {
        await ColumnPrefs.SaveAsync("material-receive-checks-create", null, _allColumns);
    }

    private async Task ResetColumnDisplay()
    {
        _allColumns = GetAllColumnDefs();
        await SaveColumnPrefs();
    }

    private async Task MoveColumnUp(ColumnDef col)
    {
        await SaveColumnPrefs();
    }

    private async Task MoveColumnDown(ColumnDef col)
    {
        await SaveColumnPrefs();
    }

    private class EditRow
    {
        public string ReceiveDate { get; set; } = DateTime.Today.ToString("yyyy-MM-dd");
        public string BatchNo { get; set; } = string.Empty;
        public string? ProcessName { get; set; }
        public ShiftType? Shift { get; set; }
        public string? Checker { get; set; }
        public string? Remark { get; set; }
        public int ProcessGroupId { get; set; }
    }

    protected override async Task OnInitializedAsync()
    {
        _allColumns = GetAllColumnDefs();
        var saved = await ColumnPrefs.LoadAsync("material-receive-checks-create", null);
        if (saved.Count > 0)
        {
            foreach (var s in saved)
            {
                var match = _allColumns.FirstOrDefault(c => c.Key == s.Key);
                if (match != null)
                    match.Visible = s.Visible;
            }
            var reordered = new List<ColumnDef>();
            foreach (var s in saved)
            {
                var match = _allColumns.FirstOrDefault(c => c.Key == s.Key);
                if (match != null && !reordered.Contains(match))
                    reordered.Add(match);
            }
            foreach (var c in _allColumns)
            {
                if (!reordered.Contains(c))
                    reordered.Add(c);
            }
            _allColumns = reordered;
        }

        // 从查询参数中获取批次号（从列表页卡片跳转）
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        var query = System.Web.HttpUtility.ParseQueryString(uri.Query);
        if (!string.IsNullOrWhiteSpace(query["batchNo"]))
        {
            var batchNo = query["batchNo"];
            var pgId = int.TryParse(query["processGroupId"], out var pid) ? pid : 0;
            var pgName = query["processGroupName"];
            if (!string.IsNullOrWhiteSpace(batchNo))
            {
                _rows.Clear();
                _rows.Add(new EditRow
                {
                    ReceiveDate = DateTime.Today.ToString("yyyy-MM-dd"),
                    BatchNo = batchNo,
                    ProcessGroupId = pgId,
                    ProcessName = pgName
                });
            }
        }

        if (!_rows.Any())
            _rows.Add(new EditRow());

        // 加载待成检到料卡片数据
        await LoadPendingMaterialChecksAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_isArrowNavSetup)
        {
            _isArrowNavSetup = true;
            if (!await JS.InvokeAsync<bool>("enableTableArrowNav", "#material-check-create-table"))
                _isArrowNavSetup = false;
        }
    }

    private void AddRow()
    {
        _rows.Add(new EditRow());
    }

    private void RemoveRow(EditRow row)
    {
        if (_rows.Count <= 1) return;
        _rows.Remove(row);
    }

    private async Task Submit()
    {
        _errorMessage = string.Empty;

        var errors = new List<string>();
        for (int i = 0; i < _rows.Count; i++)
        {
            var r = _rows[i];
            if (string.IsNullOrWhiteSpace(r.BatchNo))
                errors.Add($"第{i + 1}行：批次号不能为空");
            if (!DateTime.TryParse(r.ReceiveDate, out _))
                errors.Add($"第{i + 1}行：到料日期格式无效（请用 yyyy-MM-dd）");
        }

        if (errors.Any())
        {
            Snackbar.Add(string.Join("；", errors), Severity.Error);
            return;
        }

        _isSubmitting = true;
        StateHasChanged();

        try
        {
            var requests = _rows.Select(r => new CreateMaterialReceiveCheckRequest
            {
                BatchNo = r.BatchNo,
                ReceiveDate = DateTime.Parse(r.ReceiveDate),
                Shift = r.Shift,
                Checker = r.Checker,
                Remark = r.Remark,
                ProcessName = r.ProcessName,
                ProcessGroupId = r.ProcessGroupId,
                DataSource = "MANUAL",
            }).ToList();

            var result = await ProdRecordService.BatchCreateMaterialReceiveChecksAsync(requests);

            if (result.Success && result.Data != null)
            {
                Snackbar.Add($"成检到料创建成功，共{result.Data.Count}条", Severity.Success);
                Navigation.NavigateTo("/quality/material-receive-checks");
            }
            else
            {
                _errorMessage = result.Message ?? "批量创建失败";
            }
        }
        catch (Exception ex)
        {
            _errorMessage = $"网络错误: {ex.Message}";
        }
        finally
        {
            _isSubmitting = false;
            StateHasChanged();
        }
    }

    private void GoBack()
    {
        Navigation.NavigateTo("/quality/material-receive-checks");
    }

    // ========== 单元格渲染 ==========

    private RenderFragment RenderCell(EditRow r, ColumnDef col) => builder =>
    {
        switch (col.Key)
        {
            case "ReceiveDate":
                builder.OpenComponent<MudTextField<string>>(0);
                builder.AddAttribute(1, "Dense", true);
                builder.AddAttribute(2, "Variant", Variant.Outlined);
                builder.AddAttribute(3, "Size", Size.Small);
                builder.AddAttribute(4, "Value", r.ReceiveDate);
                builder.AddAttribute(5, "ValueChanged", EventCallback.Factory.Create<string>(this, v => r.ReceiveDate = v));
                builder.AddAttribute(6, "Placeholder", "yyyy-MM-dd");
                builder.CloseComponent();
                break;
            case "BatchNo":
                builder.OpenComponent<MudTextField<string>>(0);
                builder.AddAttribute(1, "Dense", true);
                builder.AddAttribute(2, "Variant", Variant.Outlined);
                builder.AddAttribute(3, "Size", Size.Small);
                builder.AddAttribute(4, "Value", r.BatchNo);
                builder.AddAttribute(5, "ValueChanged", EventCallback.Factory.Create<string>(this, v => r.BatchNo = v));
                builder.CloseComponent();
                break;
            case "ProcessName":
                if (!string.IsNullOrEmpty(r.ProcessName))
                {
                    // 待成检批次自动填充 → 只读显示
                    builder.OpenComponent<MudText>(0);
                    builder.AddAttribute(1, "Typo", Typo.body2);
                    builder.AddAttribute(2, "Class", "px-2 py-1");
                    builder.AddAttribute(3, "ChildContent", (RenderFragment)(b =>
                        b.AddContent(0, ProcessDisplayHelper.GetProcessNameText(r.ProcessName))));
                    builder.CloseComponent();
                }
                else
                {
                    // 手动添加行 → 文本输入
                    builder.OpenComponent<MudTextField<string>>(0);
                    builder.AddAttribute(1, "Dense", true);
                    builder.AddAttribute(2, "Variant", Variant.Outlined);
                    builder.AddAttribute(3, "Size", Size.Small);
                    builder.AddAttribute(4, "Value", r.ProcessName);
                    builder.AddAttribute(5, "ValueChanged", EventCallback.Factory.Create<string?>(this, v => r.ProcessName = v));
                    builder.CloseComponent();
                }
                break;
            case "Shift":
                builder.OpenComponent<MudSelect<ShiftType>>(0);
                builder.AddAttribute(1, "Dense", true);
                builder.AddAttribute(2, "Variant", Variant.Outlined);
                builder.AddAttribute(3, "Size", Size.Small);
                builder.AddAttribute(4, "Value", r.Shift ?? default(ShiftType));
                builder.AddAttribute(5, "ValueChanged", EventCallback.Factory.Create<ShiftType>(this, v => r.Shift = v));
                builder.AddAttribute(6, "ChildContent", (RenderFragment)(b =>
                {
                    foreach (var opt in DisplayHelper.GetEnumOptions<ShiftType>())
                    {
                        b.OpenComponent<MudSelectItem<ShiftType>>(0);
                        b.AddAttribute(1, "Value", Enum.Parse<ShiftType>(opt.Value));
                        b.AddAttribute(2, "Text", opt.Display);
                        b.AddAttribute(3, "ChildContent", (RenderFragment)(b2 =>
                            b2.AddContent(0, opt.Display)));
                        b.CloseComponent();
                    }
                }));
                builder.CloseComponent();
                break;
            case "Checker":
                builder.OpenComponent<MudTextField<string>>(0);
                builder.AddAttribute(1, "Dense", true);
                builder.AddAttribute(2, "Variant", Variant.Outlined);
                builder.AddAttribute(3, "Size", Size.Small);
                builder.AddAttribute(4, "Value", r.Checker);
                builder.AddAttribute(5, "ValueChanged", EventCallback.Factory.Create<string?>(this, v => r.Checker = v));
                builder.CloseComponent();
                break;
            case "Remark":
                builder.OpenComponent<MudTextField<string>>(0);
                builder.AddAttribute(1, "Dense", true);
                builder.AddAttribute(2, "Variant", Variant.Outlined);
                builder.AddAttribute(3, "Size", Size.Small);
                builder.AddAttribute(4, "Value", r.Remark);
                builder.AddAttribute(5, "ValueChanged", EventCallback.Factory.Create<string?>(this, v => r.Remark = v));
                builder.CloseComponent();
                break;
            default:
                builder.AddContent(0, "");
                break;
        }
    };
}
