    /// <summary>
    /// 支数输入后自动回填对应重量（仅当重量为空时，不覆盖用户手填值）。
    /// 公式：单支重 × 支数，与服务端 CreateAsync 兜底逻辑一致。
    /// </summary>
    private void AutoFillWeight(EditRow r, string weightKey, string qtyKey)
    {
        if (r.UnitWeight is null) return;
        int? qty = qtyKey switch
        {
            "Quantity" => r.Quantity,
            "QualifiedQuantity" => r.QualifiedQuantity,
            "DefectReworkQuantity" => r.DefectReworkQuantity,
            "DefectWarehouseQuantity" => r.DefectWarehouseQuantity,
            "DefectScrapQuantity" => r.DefectScrapQuantity,
            _ => null
        };
        if (!qty.HasValue || qty.Value <= 0) return;

        int? weight = weightKey switch
        {
            "Weight" => r.Weight,
            "QualifiedWeight" => r.QualifiedWeight,
            "DefectReworkWeight" => r.DefectReworkWeight,
            "DefectWarehouseWeight" => r.DefectWarehouseWeight,
            "DefectScrapWeight" => r.DefectScrapWeight,
            _ => null
        };
        if (weight.HasValue) return; // 已有值不覆盖

        var newWeight = (int?)(r.UnitWeight.Value * qty.Value);
        switch (weightKey)
        {
            case "Weight": r.Weight = newWeight; break;
            case "QualifiedWeight": r.QualifiedWeight = newWeight; break;
            case "DefectReworkWeight": r.DefectReworkWeight = newWeight; break;
            case "DefectWarehouseWeight": r.DefectWarehouseWeight = newWeight; break;
            case "DefectScrapWeight": r.DefectScrapWeight = newWeight; break;
        }
        StateHasChanged();
    }

    private static string? GetStringField(EditRow r, string key) => key switch
    {
        "EquipmentName" => r.EquipmentName,
        "Operator" => r.Operator,
        "QualificationLevel" => r.QualificationLevel,
        "TagNo" => r.TagNo,
        "Salesman" => r.Salesman,
