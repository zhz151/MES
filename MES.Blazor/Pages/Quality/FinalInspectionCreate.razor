        var source = _rows[index - 1];
        var dest = new EditRow();
        // G1：检验执行
        dest.InspectionItem = source.InspectionItem;
        dest.InspectionDate = source.InspectionDate;
        dest.BatchNo = source.BatchNo;
        dest.EquipmentName = source.EquipmentName;
        dest.Shift = source.Shift;
        dest.Operator = source.Operator;
        dest.InspectionType = source.InspectionType;
        dest.QualificationLevel = source.QualificationLevel;
        // G2：生产批次
        dest.TagNo = source.TagNo;
        dest.ProductionType = source.ProductionType;
        dest.ManufacturingItem = source.ManufacturingItem;
        dest.ManufacturingStatus = source.ManufacturingStatus;
        dest.DeliveryState = source.DeliveryState;
        dest.WorkOrderNo = source.WorkOrderNo;
        dest.SalesOrderNo = source.SalesOrderNo;
        dest.Salesman = source.Salesman;
        dest.EndCustomer = source.EndCustomer;
        dest.ProductionCutQuantity = source.ProductionCutQuantity;
        dest.ProductionWeight = source.ProductionWeight;
        dest.SourceUnit = source.SourceUnit;
        dest.FurnaceNo = source.FurnaceNo;
        dest.PlantGrade = source.PlantGrade;
        dest.Specification = source.Specification;
        dest.LengthStatus = source.LengthStatus;
        // G5：尺寸值
        dest.OuterDiameterRange = source.OuterDiameterRange;
        dest.WallThicknessRange = source.WallThicknessRange;
        dest.LengthAllowanceRange = source.LengthAllowanceRange;
        // G6：压力值
        dest.Pressure = source.Pressure;
        dest.HoldTime = source.HoldTime;
        // G7：涡流/超声波探伤
        dest.InspectionStandard = source.InspectionStandard;
        dest.InspectionGrade = source.InspectionGrade;
        dest.InstrumentModel = source.InstrumentModel;
        dest.NdtMethod = source.NdtMethod;
        dest.StandardSampleSize = source.StandardSampleSize;
        dest.StandardSampleDefect = source.StandardSampleDefect;
        dest.ProbeType = source.ProbeType;
        dest.Couplant = source.Couplant;
        dest.CalibrationFrequency = source.CalibrationFrequency;
        dest.DetectionFrequency = source.DetectionFrequency;
        dest.DetectionSensitivity = source.DetectionSensitivity;
        dest.DetectionPhase = source.DetectionPhase;
        dest.DetectionSpeed = source.DetectionSpeed;
        // G8：辅助信息
        dest.Remark = source.Remark;
        _rows[index] = dest;
        _rows = new List<EditRow>(_rows);
        StateHasChanged();
    }

    private async Task OnBatchNoChanged(EditRow row, string value)
    {
        row.BatchNo = value ?? string.Empty;
        if (string.IsNullOrWhiteSpace(value))
            return;

        var result = await FinalInspectionService.LookupBatchAsync(value.Trim());
        if (result.Success && result.Data != null)
        {
            var lookup = result.Data;
            row.ManufacturingItem = ParseMaterialType(lookup.ManufacturingItem);
            row.TagNo = lookup.TagNo;
            row.WorkOrderNo = lookup.WorkOrderNo;
            row.SalesOrderNo = lookup.SalesOrderNo;
            row.SourceUnit = lookup.SourceUnit;
            row.FurnaceNo = lookup.FurnaceNo;
            row.PlantGrade = lookup.PlantGrade;
            row.Specification = lookup.Specification;
            row.ProductionType = lookup.ProductionType;
            row.Salesman = lookup.Salesman;
            row.ManufacturingStatus = lookup.ManufacturingStatus?.ToString();
            row.DeliveryState = lookup.DeliveryState?.ToString();
            row.EndCustomer = lookup.EndCustomer;
            row.ProductionCutQuantity = lookup.ProductionCutQuantity;
            row.ProductionWeight = lookup.ProductionWeight;
            row.LengthStatus = lookup.LengthStatus;
            row.FixedLength = lookup.FixedLength;
            row.InspectionType = lookup.InspectionType?.ToString();
            row.UnitWeight = lookup.UnitWeight;
        }
    }

    private async Task Submit()
    {
        _errorMessage = string.Empty;

        var errors = new List<string>();
        for (int i = 0; i < _rows.Count; i++)
        {
            var r = _rows[i];
            if (string.IsNullOrWhiteSpace(r.BatchNo))
                errors.Add($"第{i + 1}行：生产编号不能为空");
            if (string.IsNullOrWhiteSpace(r.InspectionDate))
                errors.Add($"第{i + 1}行：检验日期不能为空");
            if (!string.IsNullOrWhiteSpace(r.InspectionDate) && !DateTime.TryParse(r.InspectionDate, out _))
                errors.Add($"第{i + 1}行：检验日期格式无效（请用 yyyy-MM-dd）");

            // 定尺长度校验：批次长度状态=定尺→定尺长度必填；非定尺→定尺长度必须为空
            if (r.LengthStatus == LengthStatus.Fixed && string.IsNullOrWhiteSpace(r.FixedLength))
                errors.Add($"第{i + 1}行：批次长度状态为'定尺'，定尺长度不能为空");
            if (r.LengthStatus.HasValue && r.LengthStatus.Value != LengthStatus.Fixed && !string.IsNullOrWhiteSpace(r.FixedLength))
                errors.Add($"第{i + 1}行：批次长度状态非'定尺'，定尺长度必须为空");

            // 检验支数 = 合格支数 + 返整支数 + 入库支数 + 报废支数
            if (r.Quantity.HasValue)
            {
                var sum = (r.QualifiedQuantity ?? 0)
                        + (r.DefectReworkQuantity ?? 0)
                        + (r.DefectWarehouseQuantity ?? 0)
                        + (r.DefectScrapQuantity ?? 0);
                if (sum != r.Quantity.Value)
                    errors.Add($"第{i + 1}行：检验支数({r.Quantity})须等于合格支数+返整支数+入库支数+报废支数(={sum})");
            }
        }

        if (errors.Any())
        {
            Snackbar.Add(string.Join("；", errors), Severity.Error);
            return;
        }

        _isSubmitting = true;
        StateHasChanged();

        try
        {
            var requests = _rows.Select(r =>
            {
                DateTime.TryParse(r.InspectionDate, out var date);
                return new CreateFinalInspectionRequest
                {
                    InspectionItem = r.InspectionItem,
                    InspectionDate = date == default ? DateTime.Now : date,
                    BatchNo = r.BatchNo.Trim(),
                    InspectionType = EnumHelper.TryParse<InspectionType>(r.InspectionType),
                    ManufacturingItem = r.ManufacturingItem,
                    TagNo = r.TagNo,
                    WorkOrderNo = r.WorkOrderNo,
                    SalesOrderNo = r.SalesOrderNo,
                    SourceUnit = r.SourceUnit,
                    FurnaceNo = r.FurnaceNo,
                    PlantGrade = r.PlantGrade,
                    Specification = r.Specification,
                    FixedLength = r.FixedLength,
                    NonFixedLengthRange = r.NonFixedLengthRange,
                    ProductionType = r.ProductionType,
                    Salesman = r.Salesman,
                    LengthStatus = r.LengthStatus,
                    EquipmentName = r.EquipmentName,
                    Shift = r.Shift,
                    Operator = r.Operator,
                    Quantity = r.Quantity,
                    Weight = r.Weight,
                    QualifiedQuantity = r.QualifiedQuantity,
                    QualifiedWeight = r.QualifiedWeight,
                    QualifiedConcessionQuantity = r.QualifiedConcessionQuantity,
                    ConcessionRemark = r.ConcessionRemark,
                    DefectReworkQuantity = r.DefectReworkQuantity,
                    DefectWarehouseQuantity = r.DefectWarehouseQuantity,
                    DefectScrapQuantity = r.DefectScrapQuantity,
                    DefectReworkWeight = r.DefectReworkWeight,
                    DefectWarehouseWeight = r.DefectWarehouseWeight,
                    DefectScrapWeight = r.DefectScrapWeight,
                    DefectDescription = r.DefectDescription,
                    OuterDiameterRange = r.OuterDiameterRange,
                    WallThicknessRange = r.WallThicknessRange,
                    LengthAllowanceRange = r.LengthAllowanceRange,
                    Pressure = r.Pressure,
                    HoldTime = r.HoldTime,
                    QualificationLevel = r.QualificationLevel,
                    InspectionStandard = r.InspectionStandard,
                    InspectionGrade = r.InspectionGrade,
                    InstrumentModel = r.InstrumentModel,
                    NdtMethod = r.NdtMethod,
                    StandardSampleSize = r.StandardSampleSize,
                    StandardSampleDefect = r.StandardSampleDefect,
                    ProbeType = r.ProbeType,
                    Couplant = r.Couplant,
                    CalibrationFrequency = r.CalibrationFrequency,
                    DetectionFrequency = r.DetectionFrequency,
                    DetectionSensitivity = r.DetectionSensitivity,
                    DetectionPhase = r.DetectionPhase,
                    DetectionSpeed = r.DetectionSpeed,
                    Remark = r.Remark,
                    DataSource = "MANUAL"
                };
            }).ToList();

            var result = await FinalInspectionService.BatchCreateAsync(requests);

            if (result.Success && result.Data != null)
            {
                Snackbar.Add($"批量新建成品检验成功，共{result.Data.Count}条", Severity.Success);
                Navigation.NavigateTo("/quality/final-inspection");
            }
            else
            {
                _errorMessage = result.Message ?? "批量创建失败";
            }
        }
        catch (Exception ex)
        {
            _errorMessage = $"网络错误: {ex.Message}";
        }
        finally
        {
            _isSubmitting = false;
            StateHasChanged();
        }
    }

    private void GoBack()
    {
        Navigation.NavigateTo("/quality/final-inspection");
    }

    /// <summary>解析制造物品，兼容历史数据特殊值</summary>
    private static MaterialType? ParseMaterialType(string? value)
    {
        if (string.IsNullOrEmpty(value)) return null;
        return value switch
        {
            "OrderFinishedProduct" => MaterialType.OrderFinished,
            "PreparedMaterial" or "PreparedFinished" or "StockFinished" => MaterialType.Finished,
            "SurplusStock" => MaterialType.Surplus,
            "IntermediateProduct" => MaterialType.SemiFinished,
            _ => Enum.TryParse<MaterialType>(value, true, out var r) ? r : null
        };
    }

