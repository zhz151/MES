@page "/quality/ncr/print/{Id:int}"
@using MES.Blazor.Services
@using MES.Core.DTOs
@using MES.Core.Enums
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = Roles.Policies.QualityRead)]

<MudContainer MaxWidth="MaxWidth.False" Class="mt-4 pl-0">
    @if (_loading)
    {
        <div class="d-flex justify-center ma-16">
            <MudProgressCircular Indeterminate="true" Size="Size.Large" />
        </div>
    }
    else if (_error || _ncr == null)
    {
        <MudCard>
            <MudCardContent>
                <div class="d-flex flex-column align-center pa-8">
                    <MudIcon Icon="@Icons.Material.Filled.ErrorOutline" Size="Size.Large" Color="Color.Error" />
                    <MudText Typo="Typo.h6" Class="mt-4">加载失败</MudText>
                    <MudText Typo="Typo.body2" Class="mt-2">无法加载不合格报告 #@Id</MudText>
                    <MudButton Variant="Variant.Outlined" Class="mt-4" OnClick="GoBack">返回列表</MudButton>
                </div>
            </MudCardContent>
        </MudCard>
    }
    else
    {
        @* 屏幕按钮区 - 打印时隐藏 *@
        <div class="ncr-print-no-print mb-4">
            <MudPaper Elevation="1" Class="pa-4 d-flex align-center">
                <MudButton Variant="Variant.Filled" Color="Color.Info"
                           StartIcon="@Icons.Material.Filled.Print"
                           OnClick="Print" Class="mr-4">
                    打印
                </MudButton>
                <MudButton Variant="Variant.Text" Color="Color.Default"
                           StartIcon="@Icons.Material.Filled.ArrowBack"
                           OnClick="GoBack">
                    返回列表
                </MudButton>
            </MudPaper>
        </div>

        @* 报告内容 *@
        <div class="ncr-print-report">

            @* 报告头 *@
            <div class="ncr-print-header">
                <h1>不合格报告</h1>
                <div class="ncr-print-id">编号: NCR-@(_ncr.Id.ToString("D4"))</div>
                <div class="ncr-print-status">
                    <span class="ncr-status-badge @GetStatusCss(_ncr.Status)">@GetStatusText(_ncr.Status)</span>
                </div>
            </div>

            @* G1 问题反馈 *@
            <div class="ncr-print-section">
                <h2 class="ncr-section-title ncr-section-g1">G1 问题反馈</h2>
                <table class="ncr-print-table">
                    <tr>
                        <td class="ncr-label">反馈日期</td>
                        <td style="width:25%">@_ncr.ReportDate.ToString("yyyy-MM-dd")</td>
                        <td class="ncr-label">反馈部门</td>
                        <td style="width:25%">@_ncr.ReportDepartment</td>
                    </tr>
                    <tr>
                        <td class="ncr-label">反馈人</td>
                        <td>@_ncr.Reporter</td>
                        <td class="ncr-label">钢管类别</td>
                        <td>@GetPipeCategoryText(_ncr.PipeCategory)</td>
                    </tr>
                    <tr>
                        <td class="ncr-label">生产编号</td>
                        <td>@_ncr.BatchNo</td>
                        <td class="ncr-label">工单号</td>
                        <td>@_ncr.WorkOrderNo</td>
                    </tr>
                    <tr>
                        <td class="ncr-label">牌号</td>
                        <td>@_ncr.PlantGrade</td>
                        <td class="ncr-label">规格</td>
                        <td>@_ncr.Specification</td>
                    </tr>
                    <tr>
                        <td class="ncr-label">不合格支数</td>
                        <td>@_ncr.DefectiveQuantity</td>
                        <td class="ncr-label"></td>
                        <td></td>
                    </tr>
                    <tr>
                        <td class="ncr-label">问题描述</td>
                        <td colspan="3">@_ncr.ProblemDescription</td>
                    </tr>
                </table>
            </div>

            @* G2 不合格品处置 *@
            <div class="ncr-print-section">
                <h2 class="ncr-section-title ncr-section-g2">G2 不合格品处置</h2>
                <table class="ncr-print-table">
                    <tr>
                        <td class="ncr-label">处置方式</td>
                        <td style="width:25%">@GetDisposalMethodText(_ncr.DisposalMethod)</td>
                        <td class="ncr-label">处置完结</td>
                        <td style="width:25%">@GetYesNoText(_ncr.DisposalIsCompleted)</td>
                    </tr>
                    <tr>
                        <td class="ncr-label">处置完结日期</td>
                        <td>@FormatDate(_ncr.DisposalCompleteDate)</td>
                        <td class="ncr-label"></td>
                        <td></td>
                    </tr>
                    <tr>
                        <td class="ncr-label">处置备注</td>
                        <td colspan="3">@_ncr.DisposalRemark</td>
                    </tr>
                </table>
            </div>

            @* G3 原因分析 *@
            <div class="ncr-print-section">
                <h2 class="ncr-section-title ncr-section-g3">G3 原因分析</h2>
                <table class="ncr-print-table">
                    <tr>
                        <td class="ncr-label">严重程度</td>
                        <td style="width:25%">@GetSeverityText(_ncr.Severity)</td>
                        <td class="ncr-label">分析确认人</td>
                        <td style="width:25%">@_ncr.AnalysisConfirmer</td>
                    </tr>
                    <tr>
                        <td class="ncr-label">确认日期</td>
                        <td>@FormatDate(_ncr.AnalysisConfirmDate)</td>
                        <td class="ncr-label"></td>
                        <td></td>
                    </tr>
                    <tr>
                        <td class="ncr-label">原因分析</td>
                        <td colspan="3">@_ncr.RootCauseAnalysis</td>
                    </tr>
                </table>
            </div>

            @* G4 责任人及处理 *@
            <div class="ncr-print-section">
                <h2 class="ncr-section-title ncr-section-g4">G4 责任人及处理</h2>
                <table class="ncr-print-table">
                    <tr>
                        <td class="ncr-label">责任类别</td>
                        <td style="width:25%">@GetResponsibilityCategoryText(_ncr.ResponsibilityCategory)</td>
                        <td class="ncr-label">责任部门</td>
                        <td style="width:25%">@_ncr.ResponsibleDept</td>
                    </tr>
                    <tr>
                        <td class="ncr-label">责任人</td>
                        <td>@_ncr.ResponsiblePerson</td>
                        <td class="ncr-label">操作日期</td>
                        <td>@FormatDate(_ncr.OperationDate)</td>
                    </tr>
                    <tr>
                        <td class="ncr-label">处理完结</td>
                        <td>@GetYesNoText(_ncr.PersonIsCompleted)</td>
                        <td class="ncr-label">完结日期</td>
                        <td>@FormatDate(_ncr.PersonCompleteDate)</td>
                    </tr>
                    <tr>
                        <td class="ncr-label">对责任人的处理</td>
                        <td colspan="3">@_ncr.PersonDisposition</td>
                    </tr>
                </table>
            </div>

            @* G5 纠正预防措施及结果验证 *@
            <div class="ncr-print-section">
                <h2 class="ncr-section-title ncr-section-g5">G5 纠正预防措施及结果验证</h2>
                <table class="ncr-print-table">
                    <tr>
                        <td class="ncr-label">计划人</td>
                        <td style="width:25%">@_ncr.ActionPlanner</td>
                        <td class="ncr-label">计划日期</td>
                        <td style="width:25%">@FormatDate(_ncr.ActionPlanDate)</td>
                    </tr>
                    <tr>
                        <td class="ncr-label">验证人</td>
                        <td>@_ncr.ActionVerifier</td>
                        <td class="ncr-label">验证日期</td>
                        <td>@FormatDate(_ncr.ActionVerifyDate)</td>
                    </tr>
                    <tr>
                        <td class="ncr-label">验证结论</td>
                        <td>@GetVerifyResultText(_ncr.VerifyResult)</td>
                        <td class="ncr-label">结果判定</td>
                        <td>@_ncr.ActionResult</td>
                    </tr>
                    <tr>
                        <td class="ncr-label">纠正预防措施</td>
                        <td colspan="3">@_ncr.CorrectiveAction</td>
                    </tr>
                </table>
            </div>

            @* 页脚 *@
            <div class="ncr-print-footer">
                <div class="ncr-print-audit">
                    创建时间: @FormatDateTime(_ncr.CreatedTime) |
                    更新时间: @FormatDateTime(_ncr.UpdatedTime)
                </div>
            </div>

        </div>
    }
</MudContainer>

<style>
    /* ===== 屏幕按钮区 ===== */
    .ncr-print-no-print {
        margin-bottom: 16px;
    }

    /* ===== 报告整体 ===== */
    .ncr-print-report {
        font-family: "Helvetica Neue", Helvetica, Arial, "Microsoft YaHei", sans-serif;
        font-size: 12px;
        color: #222;
        max-width: 210mm;
        margin: 0 auto;
        padding: 20px 10px;
    }

    .ncr-print-header {
        text-align: center;
        border-bottom: 2px solid #d32f2f;
        margin-bottom: 16px;
        padding-bottom: 10px;
    }

    .ncr-print-header h1 {
        font-size: 22px;
        font-weight: bold;
        margin: 0 0 6px;
        color: #d32f2f;
    }

    .ncr-print-id {
        font-size: 13px;
        color: #555;
        margin-bottom: 4px;
    }

    .ncr-print-status {
        font-size: 12px;
    }

    .ncr-status-badge {
        display: inline-block;
        padding: 2px 12px;
        border-radius: 3px;
        font-weight: 600;
    }

    .ncr-status-processing {
        background-color: #fff3e0;
        color: #e65100;
    }

    .ncr-status-closed {
        background-color: #e8f5e9;
        color: #2e7d32;
    }

    /* ===== 区块标题 ===== */
    .ncr-section-title {
        font-size: 13px;
        font-weight: bold;
        padding: 5px 10px;
        margin: 14px 0 8px;
        border-left: 4px solid #999;
    }

    .ncr-section-g1 { border-left-color: #d32f2f; background: #fff5f5; }
    .ncr-section-g2 { border-left-color: #f57c00; background: #fff8e1; }
    .ncr-section-g3 { border-left-color: #1976d2; background: #e3f2fd; }
    .ncr-section-g4 { border-left-color: #5c6bc0; background: #e8eaf6; }
    .ncr-section-g5 { border-left-color: #388e3c; background: #e8f5e9; }

    /* ===== 表格 ===== */
    .ncr-print-table {
        width: 100%;
        border-collapse: collapse;
        margin-bottom: 4px;
    }

    .ncr-print-table td {
        border: 1px solid #ccc;
        padding: 5px 8px;
        vertical-align: top;
    }

    .ncr-label {
        background-color: #f5f5f5;
        font-weight: 600;
        white-space: nowrap;
        width: 110px;
    }

    /* ===== 页脚 ===== */
    .ncr-print-footer {
        margin-top: 24px;
        padding-top: 8px;
        border-top: 1px solid #ccc;
    }

    .ncr-print-audit {
        font-size: 10px;
        color: #888;
        text-align: center;
    }

    /* ===== 打印样式 ===== */
    @@media print {
        @@page {
            size: portrait;
            margin: 15mm 12mm;
        }

        body {
            -webkit-print-color-adjust: exact;
            print-color-adjust: exact;
        }

        .mud-drawer,
        .mud-appbar,
        .mud-main-content .mud-drawer,
        .ncr-print-no-print {
            display: none !important;
        }

        .mud-main-content {
            margin-left: 0 !important;
            padding: 0 !important;
        }

        .ncr-print-report {
            margin: 0;
            padding: 0;
            max-width: none;
        }

        .ncr-print-section {
            page-break-inside: avoid;
        }
    }
</style>
