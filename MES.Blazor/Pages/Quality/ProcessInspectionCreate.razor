    // ========== 自动填充 ==========

    /// <summary>
    /// 批次号变更时自动填充批次级字段（挂牌号/工厂牌号/来料单位）
    /// </summary>
    private async Task OnBatchNoChangedAsync(EditRow row, string batchNo)
    {
        row.BatchNo = batchNo;
        if (string.IsNullOrWhiteSpace(batchNo))
            return;

        var result = await BatchService.GetByBatchNoAsync(batchNo);
        if (!result.Success || result.Data == null)
            return;

        var batch = result.Data;
        _batchCache[batch.BatchNo] = batch;
        row.TagNo = batch.TagNo;
        row.PlantGrade = batch.PlantGrade;
        row.SourceUnit = batch.SourceName;
        ResolveProcessGroupAfterBatchChange(row, batch.ProcessGroups);
        StateHasChanged();
    }

    /// <summary>
    /// 制造规格变更时自动填充工序名称（并同步选中工序组 Id）
    /// </summary>
    private async Task OnManufacturingSpecChangedAsync(EditRow row, string? spec)
    {
        row.ManufacturingSpec = spec;
        if (string.IsNullOrWhiteSpace(row.BatchNo) || string.IsNullOrWhiteSpace(spec))
            return;

        var result = await BatchService.GetByBatchNoAsync(row.BatchNo);
        if (!result.Success || result.Data == null)
            return;

        var batch = result.Data;
        _batchCache[batch.BatchNo] = batch;
        var pg = batch.ProcessGroups?.FirstOrDefault(p => p.ManufacturingSpec == spec);
        if (pg != null)
        {
            row.ProcessGroupId = pg.Id;
            row.ProcessName = pg.ProcessName;
        }

        StateHasChanged();
    }

    // ========== 自动填充理论重量 ==========

    private void AutoFillTheoryWeights(EditRow r)
    {
        if (!r.Quantity.HasValue || r.Quantity.Value <= 0 || !r.Weight.HasValue || r.Weight.Value <= 0)
        {
            r.TheoreticalReworkWeight = null;
            r.TheoreticalWarehouseWeight = null;
            r.TheoreticalScrapWeight = null;
            return;
        }
        if (r.DefectReworkQuantity.HasValue && r.DefectReworkQuantity.Value > 0)
            r.TheoreticalReworkWeight = (int?)(r.Weight.Value / r.Quantity.Value * r.DefectReworkQuantity.Value);
        else
            r.TheoreticalReworkWeight = null;

        if (r.DefectWarehouseQuantity.HasValue && r.DefectWarehouseQuantity.Value > 0)
            r.TheoreticalWarehouseWeight = (int?)(r.Weight.Value / r.Quantity.Value * r.DefectWarehouseQuantity.Value);
        else
            r.TheoreticalWarehouseWeight = null;

        if (r.DefectScrapQuantity.HasValue && r.DefectScrapQuantity.Value > 0)
            r.TheoreticalScrapWeight = (int?)(r.Weight.Value / r.Quantity.Value * r.DefectScrapQuantity.Value);
        else
            r.TheoreticalScrapWeight = null;
    }

