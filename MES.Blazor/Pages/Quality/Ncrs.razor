@page "/quality/ncr"
@using MES.Blazor.Services
@using MES.Core.Models
@using MES.Core.Enums
@using MES.Core.DTOs.Quality

<MudContainer MaxWidth="MaxWidth.False" Class="mt-4 pl-0">
    <MudCard>
        <MudCardHeader>
            <CardHeaderContent>
                <MudText Typo="Typo.h5" Class="font-weight-bold">
                    <MudIcon Icon="@Icons.Material.Filled.BugReport" Class="mr-2" Color="Color.Error" />
                    不合格报告
                </MudText>
            </CardHeaderContent>
            <CardHeaderActions>
                <AuthorizeView Roles="@Roles.Policies.QualityWrite">
                    <MudButton Variant="Variant.Filled" Color="Color.Error"
                               StartIcon="@Icons.Material.Filled.Add" OnClick="CreateNew">
                        新建
                    </MudButton>
                </AuthorizeView>
            </CardHeaderActions>
        </MudCardHeader>

        <MudCardContent>
            <!-- 待处理批次卡片 -->
            <MudPaper Elevation="0" Class="mb-4 pa-4" Style="border: 1px solid #e0e0e0; border-radius: 8px;">
                <div style="display: flex; align-items: center; cursor: pointer;" @onclick="TogglePendingChecks">
                    <MudIcon Icon="@Icons.Material.Filled.Inbox" Color="Color.Error" Class="mr-2" />
                    <MudText Typo="Typo.body1" Class="font-weight-medium mr-4">待处理批次</MudText>
                    <MudChip Color="@GetWarningColor()" Size="Size.Small">@_pendingItems.Count 条</MudChip>
                    <MudSpacer />
                    <MudIcon Icon="@(_showPending ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)" />
                </div>
                @if (_showPending && _pendingItems.Count > 0)
                {
                    <div style="overflow-x: auto; overflow-y: auto; max-height: 25vh; margin-top: 8px;">
                        <MudTable T="NcrPendingCheckDto"
                                  Items="@_pendingItems"
                                  Dense="true" Hover="true"
                                  Elevation="0"
                                  Class="auto-table">
                            <HeaderContent>
                                <MudTh>生产编号</MudTh>
                                <MudTh>工单号</MudTh>
                                <MudTh>来源</MudTh>
                                <MudTh>检验项目</MudTh>
                                <MudTh>处置方式</MudTh>
                                <MudTh>不合格/总检</MudTh>
                                <MudTh>占比</MudTh>
                            </HeaderContent>
                            <RowTemplate Context="item">
                                <MudTd>
                                    <MudLink @onclick='() => CreateFromPending(item)'
                                             Style="cursor: pointer;">
                                        @item.BatchNo
                                    </MudLink>
                                </MudTd>
                                <MudTd>@item.WorkOrderNo</MudTd>
                                <MudTd>
                                    <MudChip Size="Size.Small"
                                             Color="@GetSourceTypeColor(item.SourceType)">
                                        @GetSourceTypeText(item.SourceType)
                                    </MudChip>
                                </MudTd>
                                <MudTd>@GetInspectionItemDisplay(item.InspectionItem, item.SourceType)</MudTd>
                                <MudTd>
                                    <MudChip Size="Size.Small"
                                             Color="@GetDisposalChipColor(item.DisposalMethod)">
                                        @GetDisposalMethodText(item.DisposalMethod)
                                    </MudChip>
                                </MudTd>
                                <MudTd>@item.DefectQuantity / @item.TotalQuantity</MudTd>
                                <MudTd>@item.Percentage.ToString("F1")%</MudTd>
                            </RowTemplate>
                        </MudTable>
                    </div>
                }
            </MudPaper>

            <!-- 搜索栏 -->
            <MudGrid>
                <MudItem xs="12" md="6">
                    <MudTextField T="string"
                                  Label="模糊搜索 - 编号/炉号/牌号/责任部门"
                                  Value="_searchKeyword" ValueChanged="@OnSearchChanged"
                                  Immediate="true" DebounceInterval="500"
                                  Clearable="true" ClearButton="true"
                                  Adornment="Adornment.End"
                                  AdornmentIcon="@Icons.Material.Filled.Search" />
                </MudItem>
                <MudItem xs="12" md="3">
                    <MudTextField T="string"
                                  Label="日期从"
                                  Value="_dateFrom"
                                  ValueChanged="@OnDateFromChanged"
                                  Immediate="true"
                                  DebounceInterval="500"
                                  Clearable="true"
                                  ClearButton="true"
                                  Placeholder="yyyy-MM-dd" />
                </MudItem>
                <MudItem xs="12" md="3">
                    <MudTextField T="string"
                                  Label="日期至"
                                  Value="_dateTo"
                                  ValueChanged="@OnDateToChanged"
                                  Immediate="true"
                                  DebounceInterval="500"
                                  Clearable="true"
                                  ClearButton="true"
                                  Placeholder="yyyy-MM-dd" />
                </MudItem>
            </MudGrid>

            <!-- 数据表格 -->
            <div id="ncrs-list-table">
            @{
                var _groupHeaders = GetGroupHeaders();
                var _totalTableWidth = _visibleColumns.Sum(c => int.TryParse(c.Width, out var w) ? w : 100) + 40 + 160;
            }
            @* 工具栏：列显隐 + 重置（左）+ 打印 + 记录数（右） *@
            <div class="woe-toolbar">
                <div class="d-flex align-center">
                    <ColumnDisplaySelect Columns="@_allColumns"
                                         OnColumnToggle="@OnColumnToggle"
                                         OnMoveUp="@MoveColumnUp"
                                         OnMoveDown="@MoveColumnDown" />
                    <MudButton Variant="Variant.Text" Size="Size.Small"
                               Color="Color.Default"
                               StartIcon="@Icons.Material.Filled.RestartAlt"
                               OnClick="ResetColumnDisplay" Class="ml-2">
                        重置
                    </MudButton>
                </div>
                <div class="d-flex align-center" style="margin-left:auto;">
                    <MudButton Variant="Variant.Text" Size="Size.Small"
                               Color="Color.Default"
                               StartIcon="@Icons.Material.Filled.Print"
                               OnClick="PrintSelected" Class="ml-2">
                        打印选中
                    </MudButton>
                    <MudButton Variant="Variant.Text" Size="Size.Small"
                               Color="Color.Default"
                               StartIcon="@Icons.Material.Filled.Print"
                               OnClick="PrintAll" Class="ml-2">
                        打印全部
                    </MudButton>
                    <MudText Typo="Typo.body2" Class="ml-4">
                        共 @_totalCount 条记录
                    </MudText>
                </div>
            </div>
            @* 分组标题栏 *@
            <div class="col-group-header-scroll" id="ncrs-group-header-scroll">
                <div class="col-group-header-bar" style="width: @(_totalTableWidth)px">
                    @foreach (var gh in _groupHeaders)
                    {
                        <div class="col-group-header-item @gh.CssClass" style="width: @(gh.TotalWidth)px">
                            <span class="col-group-badge">@gh.GroupName</span>
                        </div>
                    }
                </div>
            </div>
            <MudTable @ref="table"
                      T="NcrDto"
                      ServerData="@LoadDataFromServer"
                      Dense="true" Hover="true"
                      Elevation="0" RowsPerPage="@_pageSize"
                      Class="mt-0 auto-table compact-table">
                <HeaderContent>
                    @{
                        int? _prevGk = null;
                    }
                    <MudTh Class="col-selection-th" Style="width: 40px;">
                        <MudCheckBox T="bool" Value="@allSelected"
                                     ValueChanged="@((bool v) => { selectedIds = v ? new HashSet<int>(_pageItems.Select(i => i.Id)) : new(); StateHasChanged(); })" />
                    </MudTh>
                    @foreach (var col in _visibleColumns)
                    {
                        var _isGroupStart = col.GroupKey.HasValue && col.GroupKey != _prevGk;
                        _prevGk = col.GroupKey;
                        var _headerClass = GetHeaderGroupCss(col.GroupKey, _isGroupStart);
                        <MudTh Class="@_headerClass" Style="@($"width:{col.Width}px")">
                            <div class="col-header-cell">
                                <span @onclick='() => ToggleSort(col.Key)'
                                      style="cursor: pointer; white-space: nowrap; user-select: none;"
                                      class="th-label">
                                    @col.Label
                                    @if (sortColumn == col.Key)
                                    {
                                        @(sortDescending ? " ▼" : " ▲")
                                    }
                                </span>
                                @if (col.FilterType != null)
                                {
                                    <ExcelFilter T="NcrDto"
                                                 Label="@col.Label"
                                                 FieldKey="@col.Key"
                                                 FilterOptions="@(_filterContextOptions.GetValueOrDefault(col.Key))"
                                                 ActiveFilterValues="@(_columnFilters.GetValueOrDefault(col.Key))"
                                                 FilterChanged="@(args => OnColumnFilterChanged(args.fieldKey, args.selectedValues))" />
                                }
                            </div>
                        </MudTh>
                    }
                    <MudTh Style="width: 160px;" Class="@GetHeaderGroupCss(null, false)">操作</MudTh>
                </HeaderContent>
                <RowTemplate Context="item">
                    @{
                        int? _prevGk2 = null;
                    }
                    <MudTd Class="col-selection-td">
                        <MudCheckBox T="bool" Value="@(selectedIds.Contains(item.Id))"
                                     ValueChanged="@((bool v) => { if(v) selectedIds.Add(item.Id); else selectedIds.Remove(item.Id); StateHasChanged(); })" />
                    </MudTd>
                    @foreach (var col in _visibleColumns)
                    {
                        var _isGroupStart2 = col.GroupKey.HasValue && col.GroupKey != _prevGk2;
                        _prevGk2 = col.GroupKey;
                        var _cellClass = GetCellGroupCss(col.GroupKey, _isGroupStart2);
                        <MudTd Class="@_cellClass">
                            @RenderCell(item, col)
                        </MudTd>
                    }
                    <MudTd Class="@GetCellGroupCss(null, false)">
                        <AuthorizeView Roles="@Roles.Policies.QualityWrite">
                            <MudIconButton Icon="@Icons.Material.Filled.Print"
                                           Size="Size.Small" Color="Color.Default"
                                           Title="打印"
                                           OnClick='() => PrintItem(item.Id)' />
                            <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                           Size="Size.Small" Color="Color.Warning"
                                           Title="编辑"
                                           OnClick='() => EditItem(item.Id)' />
                            <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                           Size="Size.Small" Color="Color.Error"
                                           Title="删除"
                                           OnClick='() => DeleteItem(item.Id)' />
                        </AuthorizeView>
                    </MudTd>
                </RowTemplate>
                <FooterContent>
                    @{
                        int? _prevGk3 = null;
                    }
                    <MudTd Class="col-footer-cell" Style="width: 40px;"></MudTd>
                    @foreach (var col in _visibleColumns)
                    {
                        var _isGroupStart3 = col.GroupKey.HasValue && col.GroupKey != _prevGk3;
                        _prevGk3 = col.GroupKey;
                        var _footerClass = GetCellGroupCss(col.GroupKey, _isGroupStart3) + " col-footer-cell";
                        <MudTd Class="@_footerClass">
                            <span class="col-footer-sum">@RenderFooterCell(col)</span>
                        </MudTd>
                    }
                    <MudTd Class="col-footer-cell"></MudTd>
                </FooterContent>
                <PagerContent>
                    <MudTablePager PageSizeOptions="new int[]{10,15,25,50,100}" />
                </PagerContent>
            </MudTable>
            </div>
        </MudCardContent>
    </MudCard>
</MudContainer>
