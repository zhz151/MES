@page "/quality/ncr"
@using MES.Blazor.Services
@using MES.Core.Models
@using MES.Core.Enums
@using MES.Core.DTOs.Quality

<MudContainer MaxWidth="MaxWidth.False" Class="mt-4 pl-0">
    <MudCard>
        <MudCardHeader>
            <CardHeaderContent>
                <MudText Typo="Typo.h5" Class="font-weight-bold">
                    <MudIcon Icon="@Icons.Material.Filled.BugReport" Class="mr-2" Color="Color.Error" />
                    不合格报告
                </MudText>
            </CardHeaderContent>
            <CardHeaderActions>
                <MudButton Variant="Variant.Outlined" Size="Size.Small"
                           Color="@(_showPendingOverview ? Color.Primary : Color.Default)"
                           StartIcon="@(_showPendingOverview ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)"
                           OnClick="TogglePendingOverview">不合格品实时待处理</MudButton>
                <MudButton Variant="Variant.Outlined" Size="Size.Small"
                           Color="@(_showMonthlySummary ? Color.Primary : Color.Default)"
                           StartIcon="@(_showMonthlySummary ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)"
                           OnClick="ToggleMonthlySummary">不合格品月度汇总</MudButton>
                <AuthorizeView Roles="@Roles.Policies.QualityWrite">
                    <MudButton Variant="Variant.Filled" Color="Color.Error"
                               StartIcon="@Icons.Material.Filled.Add" OnClick="CreateNew">
                        新建
                    </MudButton>
                </AuthorizeView>
            </CardHeaderActions>
        </MudCardHeader>

        <MudCardContent>
            @* ==================== 不合格品实时待处理汇总表（表1） ==================== *@

            @if (_showPendingOverview)
            {
                <MudCard Class="mb-2 summary-card" Elevation="0">
                    <MudCardContent>
                        @if (_pendingItems.Count == 0)
                        {
                            <MudText Typo="Typo.body2" Class="text-hint">暂无待处理数据</MudText>
                        }
                        else
                        {
                            <div class="d-flex justify-space-between align-center mb-2">
                                <MudText Typo="Typo.subtitle2"><b>不合格品实时待处理</b></MudText>
                                <MudButton Variant="Variant.Text" Size="Size.Small" Color="Color.Primary"
                                           StartIcon="@Icons.Material.Filled.Print" OnClick="PrintPendingOverviewTable">打印</MudButton>
                            </div>
                            <div id="ncrs-pending-overview-table" style="overflow-x: auto; max-height: 30vh;">
                                <MudTable T="NcrPendingCheckDto"
                                          Items="@_pendingItems"
                                          Dense="true" Hover="true"
                                          Elevation="0"
                                          Class="auto-table">
                                    <HeaderContent>
                                        <MudTh>反馈日期</MudTh>
                                        <MudTh>反馈部门</MudTh>
                                        <MudTh>物料类型</MudTh>
                                        <MudTh>工单号</MudTh>
                                        <MudTh>生产编号</MudTh>
                                        <MudTh>牌号</MudTh>
                                        <MudTh>规格</MudTh>
                                        <MudTh>次品支数</MudTh>
                                        <MudTh>次品重量</MudTh>
                                        <MudTh>问题描述</MudTh>
                                        <MudTh>处置方式</MudTh>
                                    </HeaderContent>
                                    <RowTemplate Context="item">
                                        <MudTd>@item.ReportDate.ToString("yyyy-MM-dd")</MudTd>
                                        <MudTd>@GetPendingReportDepartment(item)</MudTd>
                                        <MudTd>@GetPendingPipeCategoryText(item)</MudTd>
                                        <MudTd>@item.WorkOrderNo</MudTd>
                                        <MudTd>@item.BatchNo</MudTd>
                                        <MudTd>@item.PlantGrade</MudTd>
                                        <MudTd>@item.Specification</MudTd>
                                        <MudTd>@item.DefectQuantity</MudTd>
                                        <MudTd>@(item.DefectiveWeight?.ToString() ?? "-")</MudTd>
                                        <MudTd>@item.DefectDescription</MudTd>
                                        <MudTd>@GetDisposalMethodText(item.DisposalMethod)</MudTd>
                                    </RowTemplate>
                                </MudTable>
                            </div>
                            <MudText Typo="Typo.body2" Class="text-hint" Style="margin-top:4px; font-size:0.75rem;">
                                注：按（生产编号×处置方式×检验项目）聚合识别尚未创建不合格报告的待处理批次；反馈部门=来源-检验项目，物料类型按检验来源判定。
                            </MudText>
                        }
                    </MudCardContent>
                </MudCard>
            }

            @* ==================== 不合格品月度汇总表（表2） ==================== *@

            @if (_showMonthlySummary)
            {
                <MudCard Class="mb-2 summary-card" Elevation="0">
                    <MudCardContent>
                        @if (_isLoadingMonthly)
                        {
                            <div class="d-flex align-center" style="gap:8px;">
                                <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                                <span>不合格品月度汇总加载中...</span>
                            </div>
                        }
                        else if (_monthlySummary == null || _monthlyRows.Count == 0)
                        {
                            <MudText Typo="Typo.body2" Class="text-hint">暂无月度汇总数据</MudText>
                        }
                        else
                        {
                            <div class="d-flex justify-space-between align-center mb-2">
                                <MudText Typo="Typo.subtitle2"><b>不合格品月度汇总</b></MudText>
                                <MudButton Variant="Variant.Text" Size="Size.Small" Color="Color.Primary"
                                           StartIcon="@Icons.Material.Filled.Print" OnClick="PrintMonthlySummaryTable">打印</MudButton>
                            </div>
                            <div class="ncrs-monthly-table-wrap" id="ncrs-monthly-summary-table-wrap">
                                <table id="ncrs-monthly-summary-table" class="auto-table ncrs-monthly-table">
                                    <thead>
                                        <tr>
                                            <th class="ncrs-sticky-cat">责任类别</th>
                                            <th class="ncrs-sticky-dept">责任部门</th>
                                            <th>处置方式</th>
                                            @foreach (var label in _monthlySummary.MonthLabels)
                                            {
                                                <th class="ncrs-monthly-month-col">@label</th>
                                            }
                                            <th>处置方式汇总</th>
                                            <th class="ncrs-total-col">责任部门汇总</th>
                                            <th class="ncrs-total-col">责任类别汇总</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @for (var i = 0; i < _monthlyRows.Count; i++)
                                        {
                                            var r = _monthlyRows[i];
                                            var catRowspan = _monthlyCategoryRowspans[i];
                                            var deptRowspan = _monthlyDeptRowspans[i];
                                            <tr>
                                                @if (catRowspan > 0)
                                                {
                                                    <td class="ncrs-sticky-cat ncrs-monthly-cat" rowspan="@catRowspan">@r.CategoryDisplay</td>
                                                }
                                                @if (deptRowspan > 0)
                                                {
                                                    <td class="ncrs-sticky-dept ncrs-monthly-dept" rowspan="@deptRowspan">@r.ResponsibleDept</td>
                                                }
                                                <td class="ncrs-monthly-method">@r.DisposalMethodDisplay</td>
                                                @for (var m = 0; m < 12; m++)
                                                {
                                                    <td class="ncrs-monthly-cell">@(m > _monthlySummary.CurrentMonthIndex ? string.Empty : FormatNcrCell(r.Months[m].Quantity, r.Months[m].Weight))</td>
                                                }
                                                <td class="ncrs-monthly-method-total">@FormatNcrCell(r.TotalQuantity, r.TotalWeight)</td>
                                                @if (deptRowspan > 0)
                                                {
                                                    <td class="ncrs-total-col ncrs-monthly-dept-total" rowspan="@deptRowspan">@FormatNcrCell(_monthlyDeptTotals[i].Qty, _monthlyDeptTotals[i].Weight)</td>
                                                }
                                                @if (catRowspan > 0)
                                                {
                                                    <td class="ncrs-total-col ncrs-monthly-cat-total" rowspan="@catRowspan">@FormatNcrCell(_monthlyCategoryTotals[i].Qty, _monthlyCategoryTotals[i].Weight)</td>
                                                }
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                            <MudText Typo="Typo.body2" Class="text-hint" Style="margin-top:4px; font-size:0.75rem;">
                                注：按（责任类别→责任部门→处置方式）三级分组，分月基准=反馈日期（本年）；单元格「X支/YKg」，为 0 的部分省略；
                                当前月份为 @(_monthlySummary.CurrentMonthIndex + 1) 月，之后月份尚未发生、单元格留空；责任类别/责任部门/处置方式为空归「未填写」。
                            </MudText>
                        }
                    </MudCardContent>
                </MudCard>
            }

            <!-- 待处理批次卡片 -->
            <MudPaper Elevation="0" Class="mb-4 pa-4 form-card">
                <div style="display: flex; align-items: center; cursor: pointer;" @onclick="TogglePendingChecks">
                    <MudIcon Icon="@Icons.Material.Filled.Inbox" Color="Color.Error" Class="mr-2" />
                    <MudText Typo="Typo.body1" Class="font-weight-medium mr-4">待处理批次</MudText>
                    <MudChip Color="@GetWarningColor()" Size="Size.Small">@_pendingItems.Count 条</MudChip>
                    <MudSpacer />
                    <MudIcon Icon="@(_showPending ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)" />
                </div>
                @if (_showPending && _pendingItems.Count > 0)
                {
                    <div style="overflow-x: auto; overflow-y: auto; max-height: 25vh; margin-top: 8px;">
                        <MudTable T="NcrPendingCheckDto"
                                  Items="@_pendingItems"
                                  Dense="true" Hover="true"
                                  Elevation="0"
                                  Class="auto-table">
                            <HeaderContent>
                                <MudTh>生产编号</MudTh>
                                <MudTh>工单号</MudTh>
                                <MudTh>来源</MudTh>
                                <MudTh>检验项目</MudTh>
                                <MudTh>处置方式</MudTh>
                                <MudTh>不合格/总检</MudTh>
                                <MudTh>占比</MudTh>
                            </HeaderContent>
                            <RowTemplate Context="item">
                                <MudTd>
                                    <MudLink @onclick='() => CreateFromPending(item)'
                                             Style="cursor: pointer;">
                                        @item.BatchNo
                                    </MudLink>
                                </MudTd>
                                <MudTd>@item.WorkOrderNo</MudTd>
                                <MudTd>
                                    <MudChip Size="Size.Small"
                                             Color="@GetSourceTypeColor(item.SourceType)">
                                        @GetSourceTypeText(item.SourceType)
                                    </MudChip>
                                </MudTd>
                                <MudTd>@GetInspectionItemDisplay(item.InspectionItem, item.SourceType)</MudTd>
                                <MudTd>
                                    <MudChip Size="Size.Small"
                                             Color="@GetDisposalChipColor(item.DisposalMethod)">
                                        @GetDisposalMethodText(item.DisposalMethod)
                                    </MudChip>
                                </MudTd>
                                <MudTd>@item.DefectQuantity / @item.TotalQuantity</MudTd>
                                <MudTd>@item.Percentage.ToString("F1")%</MudTd>
                            </RowTemplate>
                        </MudTable>
                    </div>
                }
            </MudPaper>

            <!-- 搜索栏 -->
            <MudGrid>
                <MudItem xs="12" md="6">
                    <MudTextField T="string"
                                  Label="模糊搜索 - 编号/炉号/牌号/责任部门"
                                  Value="_searchKeyword" ValueExpression="@(() => _searchKeyword)" ValueChanged="@OnSearchChanged"
                                  Immediate="true" DebounceInterval="500"
                                  Adornment="Adornment.End"
                                  AdornmentIcon="@Icons.Material.Filled.Search" />
                </MudItem>
                <MudItem xs="12" md="3">
                    <MudTextField T="string"
                                  Label="日期从"
                                  Value="_dateFrom"
                                  ValueChanged="@OnDateFromChanged"
                                  Immediate="true"
                                  DebounceInterval="500"
                                  Placeholder="yyyy-MM-dd" />
                </MudItem>
                <MudItem xs="12" md="3">
                    <MudTextField T="string"
                                  Label="日期至"
                                  Value="_dateTo"
                                  ValueChanged="@OnDateToChanged"
                                  Immediate="true"
                                  DebounceInterval="500"
                                  Placeholder="yyyy-MM-dd" />
                </MudItem>
            </MudGrid>

            <!-- 数据表格 -->
            <div id="ncrs-list-table">
            @{
                var _groupHeaders = GetGroupHeaders();
                var _totalTableWidth = _visibleColumns.Sum(c => int.TryParse(c.Width, out var w) ? w : 100) + 40 + 160;
            }
            @* 工具栏：列显隐 + 重置（左）+ 打印 + 记录数（右） *@
            <div class="list-toolbar">
                <div class="d-flex align-center">
                    <ColumnDisplaySelect Columns="@_allColumns"
                                         OnColumnToggle="@OnColumnToggle"
                                         OnMoveUp="@MoveColumnUp"
                                         OnMoveDown="@MoveColumnDown" />
                    <MudButton Variant="Variant.Text" Size="Size.Small"
                               Color="Color.Default"
                               StartIcon="@Icons.Material.Filled.RestartAlt"
                               OnClick="ResetColumnDisplay" Class="ml-2">
                        重置
                    </MudButton>
                </div>
                <div class="d-flex align-center" style="margin-left:auto;">
                    <MudButton Variant="Variant.Text" Size="Size.Small"
                               Color="Color.Default"
                               StartIcon="@Icons.Material.Filled.Print"
                               OnClick="PrintSelected" Class="ml-2">
                        打印选中
                    </MudButton>
                    <MudButton Variant="Variant.Text" Size="Size.Small"
                               Color="Color.Default"
                               StartIcon="@Icons.Material.Filled.Print"
                               OnClick="PrintAll" Class="ml-2">
                        打印全部
                    </MudButton>
                    <MudText Typo="Typo.body2" Class="ml-4">
                        共 @_totalCount 条记录
                    </MudText>
                </div>
            </div>
            @* 分组标题栏 *@
            <div class="col-group-header-scroll" id="ncrs-group-header-scroll">
                <div class="col-group-header-bar" style="width: @(_totalTableWidth)px">
                    @foreach (var gh in _groupHeaders)
                    {
                        <div class="col-group-header-item @gh.CssClass" style="width: @(gh.TotalWidth)px">
                            <span class="col-group-badge">@gh.GroupName</span>
                        </div>
                    }
                </div>
            </div>
            <MudTable @ref="table"
                      T="NcrDto"
                      ServerData="@LoadDataFromServer"
                      Dense="true" Hover="true"
                      Elevation="0" RowsPerPage="@_pageSize"
                      Class="mt-0 auto-table compact-table">
                <HeaderContent>
                    @{
                        int? _prevGk = null;
                    }
                    <MudTh Class="col-selection-th" Style="width: 40px;">
                        <MudCheckBox T="bool" Value="@allSelected"
                                     ValueChanged="@((bool v) => { selectedIds = v ? new HashSet<int>(_pageItems.Select(i => i.Id)) : new(); StateHasChanged(); })" />
                    </MudTh>
                    @foreach (var col in _visibleColumns)
                    {
                        var _isGroupStart = col.GroupKey.HasValue && col.GroupKey != _prevGk;
                        _prevGk = col.GroupKey;
                        var _headerClass = GetHeaderGroupCss(col.GroupKey, _isGroupStart);
                        <MudTh Class="@_headerClass" Style="@($"width:{col.Width}px")">
                            <div class="col-header-cell">
                                <span @onclick='() => ToggleSort(col.Key)'
                                      style="cursor: pointer; white-space: nowrap; user-select: none;"
                                      class="th-label">
                                    @col.Label
                                    @if (sortColumn == col.Key)
                                    {
                                        @(sortDescending ? " ▼" : " ▲")
                                    }
                                </span>
                                @if (col.FilterType != null)
                                {
                                    <ExcelFilter T="NcrDto"
                                                 Label="@col.Label"
                                                 FieldKey="@col.Key"
                                                 FilterOptions="@(_filterContextOptions.GetValueOrDefault(col.Key))"
                                                 ActiveFilterValues="@(_columnFilters.GetValueOrDefault(col.Key))"
                                                 FilterChanged="@(args => OnColumnFilterChanged(args.fieldKey, args.selectedValues))" />
                                }
                            </div>
                        </MudTh>
                    }
                    <MudTh Style="width: 160px;" Class="@GetHeaderGroupCss(null, false)">操作</MudTh>
                </HeaderContent>
                <RowTemplate Context="item">
                    @{
                        int? _prevGk2 = null;
                    }
                    <MudTd Class="col-selection-td">
                        <MudCheckBox T="bool" Value="@(selectedIds.Contains(item.Id))"
                                     ValueChanged="@((bool v) => { if(v) selectedIds.Add(item.Id); else selectedIds.Remove(item.Id); StateHasChanged(); })" />
                    </MudTd>
                    @foreach (var col in _visibleColumns)
                    {
                        var _isGroupStart2 = col.GroupKey.HasValue && col.GroupKey != _prevGk2;
                        _prevGk2 = col.GroupKey;
                        var _cellClass = GetCellGroupCss(col.GroupKey, _isGroupStart2);
                        <MudTd Class="@_cellClass">
                            @RenderCell(item, col)
                        </MudTd>
                    }
                    <MudTd Class="@GetCellGroupCss(null, false)">
                        <AuthorizeView Roles="@Roles.Policies.QualityWrite">
                            <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                           Size="Size.Small" Color="Color.Warning"
                                           Title="编辑"
                                           OnClick='() => EditItem(item.Id)' />
                            <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                           Size="Size.Small" Color="Color.Error"
                                           Title="删除"
                                           OnClick='() => DeleteItem(item.Id)' />
                        </AuthorizeView>
                    </MudTd>
                </RowTemplate>
                <FooterContent>
                    @{
                        int? _prevGk3 = null;
                    }
                    <MudTd Class="col-footer-cell" Style="width: 40px;"></MudTd>
                    @foreach (var col in _visibleColumns)
                    {
                        var _isGroupStart3 = col.GroupKey.HasValue && col.GroupKey != _prevGk3;
                        _prevGk3 = col.GroupKey;
                        var _footerClass = GetCellGroupCss(col.GroupKey, _isGroupStart3) + " col-footer-cell";
                        <MudTd Class="@_footerClass">
                            <span class="col-footer-sum">@RenderFooterCell(col)</span>
                        </MudTd>
                    }
                    <MudTd Class="col-footer-cell"></MudTd>
                </FooterContent>
                <PagerContent>
                    <MudTablePager PageSizeOptions="new int[]{10,15,25,50,100}" />
                </PagerContent>
            </MudTable>
            </div>
        </MudCardContent>
    </MudCard>
</MudContainer>

<style>
    /* 不合格品月度汇总表（表2） */
    .ncrs-monthly-table-wrap {
        overflow-x: auto;
    }
    .ncrs-monthly-table {
        font-size: 0.8rem;
        border-collapse: separate;
        border-spacing: 0;
    }
    .ncrs-monthly-table th,
    .ncrs-monthly-table td {
        text-align: center;
        white-space: nowrap;
        /* 浅色表格线（独立边框模型，保证 sticky 表头/列边框不随折叠丢失） */
        border-bottom: 1px solid #d0d0d0;
        border-right: 1px solid #d0d0d0;
    }
    .ncrs-monthly-table tr:first-child th {
        border-top: 1px solid #d0d0d0;
    }
    .ncrs-monthly-table th:first-child,
    .ncrs-monthly-table td:first-child {
        border-left: 1px solid #d0d0d0;
    }
    .ncrs-monthly-table .ncrs-monthly-month-col,
    .ncrs-monthly-table .ncrs-monthly-cell {
        min-width: 90px;
    }
    .ncrs-sticky-cat {
        position: sticky;
        left: 0;
        z-index: 3;
        background-color: #f5f5f5;
        width: 110px;
        font-weight: 600;
    }
    .ncrs-sticky-dept {
        position: sticky;
        left: 110px;
        z-index: 2;
        background-color: white;
        width: 110px;
        font-weight: 600;
    }
    .ncrs-monthly-table thead th {
        position: sticky;
        top: 0;
        z-index: 4;
        background-color: #f5f5f5;
    }
    .ncrs-monthly-table thead th.ncrs-sticky-cat,
    .ncrs-monthly-table thead th.ncrs-sticky-dept {
        z-index: 5;
    }
    .ncrs-monthly-cat {
        font-weight: 600;
    }
    .ncrs-monthly-method {
        min-width: 90px;
    }
    .ncrs-monthly-table .ncrs-total-col {
        min-width: 90px;
        background-color: #fff8e1;
    }
    .ncrs-monthly-dept-total,
    .ncrs-monthly-cat-total {
        font-weight: 600;
    }
</style>
