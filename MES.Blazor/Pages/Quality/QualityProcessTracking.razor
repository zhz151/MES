@page "/quality/process-tracking"
@using MES.Blazor.Services
@using MES.Blazor.Components
@using MES.Blazor.Models
@using MES.Blazor.Shared
@using MES.Core.Models
@using MES.Core.DTOs.Quality
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Web
@inject QualityProcessTrackingService TrackingService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject IJSRuntime JS
@inject PageStateService PageState
@inject ColumnPrefsService ColumnPrefs
@inject HttpClient Http
@attribute [Authorize(Roles = Roles.Policies.QualityView)]

<MudContainer MaxWidth="MaxWidth.False" Class="mt-4 pl-0">
    <div class="d-flex justify-space-between align-center mb-4">
        <MudText Typo="Typo.h5" Class="font-weight-bold">
            <MudIcon Icon="@Icons.Material.Filled.Assignment" Class="mr-2" Color="Color.Primary" />
            成检追踪
        </MudText>
    </div>

    <MudCard>
        <MudCardContent>
            <MudGrid>
                <MudItem xs="12" md="6">
                    <MudTextField T="string" Label="模糊搜索 - 批次号/制造物品/工厂牌号/规格/工单号/订单号/炉号/挂牌号/来料单位/业务员/交货状态/确认人"
                                  Value="@_searchKeyword" ValueExpression="@(() => _searchKeyword)" ValueChanged="@OnSearchChanged"
                                  Immediate="true" DebounceInterval="500"
                                  Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.Search" />
                </MudItem>
                <MudItem xs="12" md="3">
                    <MudTextField T="string" Label="日期从" Value="_dateFrom"
                                  ValueChanged="@OnDateFromChanged"
                                  Immediate="true" DebounceInterval="500"
                                  Placeholder="yyyy-MM-dd" />
                </MudItem>
                <MudItem xs="12" md="3">
                    <MudTextField T="string" Label="日期至" Value="_dateTo"
                                  ValueChanged="@OnDateToChanged"
                                  Immediate="true" DebounceInterval="500"
                                  Placeholder="yyyy-MM-dd" />
                </MudItem>
            </MudGrid>

            <div id="quality-process-tracking-list-table">
            @{
                var _groupHeaders = GetGroupHeaders();
                var _totalTableWidth = 40 + _visibleColumns.Sum(c => int.TryParse(c.Width, out var w) ? w : 100);
            }
            @* 工具栏：列显隐 + 重置（左）+ 打印 + 记录数（右） *@
            <div class="list-toolbar">
                <div class="d-flex align-center">
                    <ColumnDisplaySelect Columns="_allColumns"
                                         OnColumnToggle="OnColumnToggle"
                                         OnMoveUp="MoveColumnUp"
                                         OnMoveDown="MoveColumnDown" />
                    <MudButton Variant="Variant.Text" Size="Size.Small"
                               Color="Color.Default"
                               StartIcon="@Icons.Material.Filled.RestartAlt"
                               OnClick="ResetColumnDisplay" Class="ml-2">
                        重置
                    </MudButton>
                </div>
                <div class="d-flex align-center" style="margin-left:auto;">
                    <MudButton Variant="Variant.Outlined"
                               Size="Size.Small"
                               Color="Color.Info"
                               StartIcon="@Icons.Material.Filled.Print"
                               Disabled="@(!_selectedIds.Any())"
                               OnClick="PrintSelected">
                        打印选中 (@_selectedIds.Count)
                    </MudButton>
                    <MudText Typo="Typo.body2" Class="ml-4">
                        共 @_totalCount 条记录
                    </MudText>
                </div>
            </div>
            @* 分组标题栏 *@
            <div class="col-group-header-scroll" id="qpt-group-header-scroll">
                <div class="col-group-header-bar" style="@("width: " + _totalTableWidth + "px")">
                    @foreach (var gh in _groupHeaders)
                    {
                        <div class="col-group-header-item @gh.CssClass" style="width: @(gh.TotalWidth)px">
                            <span class="col-group-badge">@gh.GroupName</span>
                        </div>
                    }
                </div>
            </div>
            <MudTable @ref="table" T="QualityProcessTrackingDto"
                      ServerData="@LoadDataFromServer"
                      Dense="true" Hover="true" Class="mt-0 auto-table compact-table"
                      Elevation="0" RowsPerPage="@_pageSize" RowsPerPageLabel="每页行数:">

                <HeaderContent>
                    <MudTh Class="col-selection-th" Style="@("width: 40px")">
                        <MudCheckBox T="bool"
                                     Value="@(_pageItems.Any() && _pageItems.All(i => _selectedIds.Contains(i.Id)))"
                                     ValueChanged="@((v) => { if(v) { foreach(var i in _pageItems) _selectedIds.Add(i.Id); } else { foreach(var i in _pageItems) _selectedIds.Remove(i.Id); } StateHasChanged(); })"
                                     Dense="true" />
                    </MudTh>
                    @{
                        int? _prevGk = null;
                    }
                    @foreach (var col in _visibleColumns)
                    {
                        var _isGroupStart = col.GroupKey.HasValue && col.GroupKey != _prevGk;
                        _prevGk = col.GroupKey;
                        var _headerClass = GetHeaderGroupCss(col.GroupKey, _isGroupStart);
                        <MudTh Class="@_headerClass" Style="@($"width: {col.Width}px")">
                            <div class="col-header-cell">
                                <span @onclick='() => ToggleSort(col.Key)'
                                      style="cursor:pointer" class="th-label">
                                    @col.Label @if (sortColumn == col.Key) {@(sortDescending ? " ▼" : " ▲")}
                                </span>
                                @if (col.FilterType != null)
                                {
                                    <ExcelFilter T="QualityProcessTrackingDto"
                                                 Label="@col.Label"
                                                 FieldKey="@col.Key"
                                                 FilterOptions="@(_filterContextOptions.GetValueOrDefault(col.Key))"
                                                 ActiveFilterValues="@(_columnFilters.GetValueOrDefault(col.Key))"
                                                 FilterChanged="@(args => OnColumnFilterChanged(args.fieldKey, args.selectedValues))" />
                                }
                            </div>
                        </MudTh>
                    }
                </HeaderContent>

                <RowTemplate Context="item">
                    <MudTd Class="col-selection-td" Style="@("width: 40px")">
                        <MudCheckBox T="bool"
                                     Value="@_selectedIds.Contains(item.Id)"
                                     ValueChanged="@(v => { if(v) _selectedIds.Add(item.Id); else _selectedIds.Remove(item.Id); StateHasChanged(); })"
                                     Dense="true" />
                    </MudTd>
                    @{
                        int? _prevGk2 = null;
                    }
                    @foreach (var col in _visibleColumns)
                    {
                        var _isGroupStart2 = col.GroupKey.HasValue && col.GroupKey != _prevGk2;
                        _prevGk2 = col.GroupKey;
                        var _cellClass = GetCellGroupCss(col.GroupKey, _isGroupStart2);
                        <MudTd Class="@_cellClass">@RenderCell(item, col)</MudTd>
                    }
                </RowTemplate>

                <FooterContent>
                    <MudTd Style="@("width: 40px")" Class="col-footer-cell"></MudTd>
                    @{
                        int? _prevGk3 = null;
                    }
                    @foreach (var col in _visibleColumns)
                    {
                        var _isGroupStart3 = col.GroupKey.HasValue && col.GroupKey != _prevGk3;
                        _prevGk3 = col.GroupKey;
                        var _footerClass = GetCellGroupCss(col.GroupKey, _isGroupStart3) + " col-footer-cell";
                        <MudTd Class="@_footerClass">
                            <span class="col-footer-sum">@RenderFooterCell(col)</span>
                        </MudTd>
                    }
                </FooterContent>

                <PagerContent>
                    <MudTablePager PageSizeOptions="new int[]{10,15,25,50,100}" />
                </PagerContent>
            </MudTable>
            </div>
        </MudCardContent>
    </MudCard>
</MudContainer>
