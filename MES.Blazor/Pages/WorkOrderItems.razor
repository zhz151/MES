@page "/workorders/{WorkOrderId:int}/items"
@using MES.Blazor.Services
@using MES.Core.DTOs
@using Microsoft.AspNetCore.Authorization
@inject WorkOrderService WorkOrderService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

@attribute [Authorize(Roles = "WorkOrderStaff,WorkOrderDirector,Admin")]

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4">
    @if (isLoading)
    {
        <MudProgressCircular Indeterminate Size="Size.Large" Class="d-flex justify-center ma-8" />
    }
    else
    {
        <MudCard>
            <MudCardHeader>
                <CardHeaderContent>
                    <MudText Typo="Typo.h5" Class="font-weight-bold">
                        <MudIcon Icon="@Icons.Material.Filled.ListAlt" Class="mr-2" Color="Color.Primary" />
                        工单项次明细
                    </MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">
                        工单号：@workOrderNo | 主号：@productionMainNo | 次号：@(productionSubNo ?? "-")
                    </MudText>
                </CardHeaderContent>
                <CardHeaderActions>
                    <MudButton Variant="Variant.Text" OnClick="GoBack">返回</MudButton>
                </CardHeaderActions>
            </MudCardHeader>

            <MudCardContent>
                @if (orderItems == null || !orderItems.Any())
                {
                    <MudAlert Severity="Severity.Info">该工单没有关联的订单项次。</MudAlert>
                }
                else
                {
                    <MudTable T="OrderItemForWorkOrderDto"
                              Items="@orderItems"
                              Dense="true"
                              Hover="true"
                              Elevation="0">
                        <HeaderContent>
                            <MudTh>项次号</MudTh>
                            <MudTh>物料名称</MudTh>
                            <MudTh>规格</MudTh>
                            <MudTh>长度状态</MudTh>
                            <MudTh>最小长度(mm)</MudTh>
                            <MudTh>最大长度(mm)</MudTh>
                            <MudTh>支数</MudTh>
                            <MudTh>米数</MudTh>
                            <MudTh>合同重量(kg)</MudTh>
                            <MudTh>理算重量(kg)</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd>@context.Sequence</MudTd>
                            <MudTd>@GetMaterialNameText(context.MaterialName)</MudTd>
                            <MudTd>@FormatSpecification(context.Specification)</MudTd>
                            <MudTd>@GetLengthStatusText(context.LengthStatus)</MudTd>
                            <MudTd>@FormatNullableDecimal(context.MinLength)</MudTd>
                            <MudTd>@FormatNullableDecimal(context.MaxLength)</MudTd>
                            <MudTd>@context.Quantity</MudTd>
                            <MudTd>@FormatNullableDecimal(context.Meters)</MudTd>
                            <MudTd>@FormatDecimal(context.ContractWeight)</MudTd>
                            <MudTd>@FormatDecimal(context.TheoreticalWeight)</MudTd>
                        </RowTemplate>
                    </MudTable>
                }
            </MudCardContent>
        </MudCard>
    }
</MudContainer>

@code {
    [Parameter] public int WorkOrderId { get; set; }
    private List<OrderItemForWorkOrderDto>? orderItems;
    private string workOrderNo = string.Empty;
    private string productionMainNo = string.Empty;
    private string? productionSubNo;
    private bool isLoading = true;

    private string FormatDecimal(decimal value) => value.ToString("G29");
    private string FormatNullableDecimal(decimal? value) => value?.ToString("G29") ?? "";

    private string FormatSpecification(string specification)
    {
        if (string.IsNullOrEmpty(specification)) return "";
        var parts = specification.Split('*');
        if (parts.Length != 2) return specification;
        var od = decimal.TryParse(parts[0], out var odValue) ? odValue.ToString("G29") : parts[0];
        var wt = decimal.TryParse(parts[1], out var wtValue) ? wtValue.ToString("G29") : parts[1];
        return $"{od}*{wt}";
    }

    protected override async Task OnInitializedAsync() => await LoadData();

    private async Task LoadData()
    {
        isLoading = true;
        StateHasChanged();

        try
        {
            // 获取工单基本信息
            var orderResult = await WorkOrderService.GetByIdAsync(WorkOrderId);
            if (orderResult.Success && orderResult.Data != null)
            {
                workOrderNo = orderResult.Data.WorkOrderNo;
                productionMainNo = orderResult.Data.ProductionMainNo;
                productionSubNo = orderResult.Data.ProductionSubNo;
            }

            // 获取项次明细
            var result = await WorkOrderService.GetWorkOrderItemsAsync(WorkOrderId);
            if (result.Success && result.Data != null)
            {
                orderItems = result.Data;
            }
            else
            {
                Snackbar.Add(result.Message ?? "获取项次明细失败", Severity.Error);
                orderItems = new List<OrderItemForWorkOrderDto>();
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"加载失败: {ex.Message}", Severity.Error);
            orderItems = new List<OrderItemForWorkOrderDto>();
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private void GoBack() => Navigation.NavigateTo($"/workorders/{WorkOrderId}");

    private string GetMaterialNameText(string materialName)
    {
        return materialName switch
        {
            "SeamlessPipe" => "无缝管",
            "WeldedPipe" => "焊管",
            _ => materialName
        };
    }

    private string GetLengthStatusText(string lengthStatus)
    {
        return lengthStatus switch
        {
            "Fixed" => "定尺",
            "Range" => "范围尺",
            "NonFixed" => "非定尺",
            _ => lengthStatus
        };
    }
}