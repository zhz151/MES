@page "/standard-registers"
@using System.Text.Json
@using MES.Blazor.Helpers
@using MES.Blazor.Services
@using MES.Blazor.Models
@using MES.Core.Models
@using Microsoft.AspNetCore.Authorization
@using MES.Blazor.Shared
@using MES.Blazor.Components
@using MES.Core.DTOs.StandardRegister
@inject StandardRegisterService Svc
@inject PageStateService PageState
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject IJSRuntime JS
@inject ColumnPrefsService ColumnPrefs
@inject HttpClient Http
@attribute [Authorize(Roles = Roles.Policies.StandardRead)]

<MudContainer MaxWidth="MaxWidth.False" Class="mt-4 pl-0">
    <MudCard>
        <MudCardHeader>
            <CardHeaderContent>
                <MudText Typo="Typo.h5" Class="font-weight-bold">
                    <MudIcon Icon="@Icons.Material.Filled.Description" Class="mr-2" Color="Color.Primary" />
                    标准号列表
                </MudText>
            </CardHeaderContent>
            <CardHeaderActions>
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Add"
                           OnClick="NavigateToCreate">
                    新建
                </MudButton>
            </CardHeaderActions>
        </MudCardHeader>

        <MudCardContent>
            <!-- 筛选栏 -->
            <MudGrid>
                <MudItem xs="12" md="6">
                    <MudTextField T="string"
                                  Label="关键字搜索"
                                  Value="@_searchKeyword"
                                  ValueChanged="@OnSearchChanged"
                                  Immediate="true"
                                  DebounceInterval="500"
                                  Clearable="true"
                                  ClearButton="true"
                                  Adornment="Adornment.End"
                                  AdornmentIcon="@Icons.Material.Filled.Search" />
                </MudItem>
            </MudGrid>

            <!-- 数据表格 -->
            <div id="standard-registers-table">
            <!-- 工具栏 -->
            <div class="woe-toolbar">
                <div class="d-flex align-center">
                    <ColumnDisplaySelect Columns="_allColumns"
                                         OnColumnToggle="OnColumnToggle"
                                         OnMoveUp="MoveColumnUp"
                                         OnMoveDown="MoveColumnDown" />
                    <MudButton Variant="Variant.Text" Size="Size.Small"
                               Color="Color.Default"
                               StartIcon="@Icons.Material.Filled.RestartAlt"
                               OnClick="ResetColumnDisplay" Class="ml-2">
                        重置
                    </MudButton>
                </div>
                <div class="d-flex align-center" style="margin-left:auto;">
                    <MudButton Variant="Variant.Text" Size="Size.Small"
                               Color="Color.Default"
                               StartIcon="@Icons.Material.Filled.Print"
                               OnClick="PrintSelected" Class="ml-2">
                        打印选中
                    </MudButton>
                    <MudButton Variant="Variant.Text" Size="Size.Small"
                               Color="Color.Default"
                               StartIcon="@Icons.Material.Filled.Print"
                               OnClick="PrintAll" Class="ml-2">
                        打印全部
                    </MudButton>
                    <MudText Typo="Typo.body2" Class="ml-4">
                        共 @_totalCount 条记录
                    </MudText>
                </div>
            </div>
            <MudTable @ref="table"
                      T="StandardRegisterDto"
                      ServerData="@LoadDataFromServer"
                      Dense="true"
                      Hover="true"
                      Class="mt-0 auto-table"
                      Elevation="0"
                      RowsPerPage="@_pageSize"
                      RowsPerPageLabel="每页行数:">
                <HeaderContent>
                    <MudTh Class="col-selection-th" Style="width: 40px;">
                        <MudCheckBox T="bool" Value="@allSelected"
                                     ValueChanged="@((bool v) => { selectedIds = v ? new HashSet<int>(_pageItems.Select(i => i.Id)) : new(); StateHasChanged(); })" />
                    </MudTh>
                    @foreach (var col in _visibleColumns)
                    {
                        <MudTh>
                            <div style="display:inline-flex; align-items:center; gap:4px;">
                                <span @onclick='() => ToggleSort(col.Key)' style="cursor:pointer" class="th-label">@col.Label @if (sortColumn == col.Key) {@(sortDescending ? " ▼" : " ▲")}</span>
                                @if (col.FilterType != null)
                                {
                                    <ExcelFilter T="StandardRegisterDto"
                                                 Label="@col.Label"
                                                 FieldKey="@col.Key"
                                                 FilterOptions="@(_filterContextOptions.GetValueOrDefault(col.Key))"
                                                 ActiveFilterValues="@(_columnFilters.GetValueOrDefault(col.Key))"
                                                 FilterChanged="@(args => OnColumnFilterChanged(args.fieldKey, args.selectedValues))" />
                                }
                            </div>
                        </MudTh>
                    }
                    <MudTh Style="width: 120px;">操作</MudTh>
                </HeaderContent>
                <RowTemplate Context="item">
                    <MudTd Class="col-selection-td">
                        <MudCheckBox T="bool" Value="@(selectedIds.Contains(item.Id))"
                                     ValueChanged="@((bool v) => { if(v) selectedIds.Add(item.Id); else selectedIds.Remove(item.Id); StateHasChanged(); })" />
                    </MudTd>
                    @foreach (var col in _visibleColumns)
                    {
                        <MudTd>@RenderCell(item, col)</MudTd>
                    }
                    <MudTd Style="white-space: nowrap;">
                        <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                       Color="Color.Warning"
                                       Size="Size.Small"
                                       OnClick="@(() => ViewDetail(item.Id))"
                                       Title="编辑" />
                        <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                       Color="Color.Error"
                                       Size="Size.Small"
                                       OnClick="@(() => DeleteItem(item))"
                                       Title="删除" />
                    </MudTd>
                </RowTemplate>
                <FooterContent>
                    @foreach (var col in _visibleColumns)
                    {
                        <MudTd Class="col-footer-cell"><span class="col-footer-sum">@RenderFooterCell(col)</span></MudTd>
                    }
                    <MudTd Class="col-footer-cell"></MudTd>
                </FooterContent>
                <PagerContent>
                    <MudTablePager PageSizeOptions="new int[]{10,15,25,50,100}" />
                </PagerContent>
            </MudTable>
            </div>
        </MudCardContent>
    </MudCard>
</MudContainer>
