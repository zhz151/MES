@page "/standards/create"
@using MES.Blazor.Services
@using MES.Core.DTOs
@using Microsoft.AspNetCore.Authorization
@inject ProductionStandardService StandardService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@attribute [Authorize(Roles = "OrderDirector,Admin")]

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-4">
    <MudCard>
        <MudCardHeader>
            <CardHeaderContent>
                <MudText Typo="Typo.h5" Class="font-weight-bold">
                    <MudIcon Icon="@Icons.Material.Filled.Add" Class="mr-2" Color="Color.Primary" />
                    新建产品标准
                </MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">创建新的生产标准，可批量添加多条记录</MudText>
            </CardHeaderContent>
            <CardHeaderActions>
                <MudButton Variant="Variant.Text" OnClick="GoBack">返回</MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAll" Disabled="@isSubmitting">
                    @if (isSubmitting) { <MudProgressCircular Size="Size.Small" Color="Color.Inherit" /> }
                    else { <span>保存</span> }
                </MudButton>
            </CardHeaderActions>
        </MudCardHeader>

        <MudCardContent>
            <div class="d-flex justify-space-between align-center mb-3">
                <MudText Typo="Typo.subtitle1">产品标准列表</MudText>
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="AddRow">添加标准</MudButton>
            </div>

            @if (rows.Count == 0)
            {
                <MudAlert Severity="Severity.Info">请点击"添加标准"按钮添加记录</MudAlert>
            }
            else
            {
                <MudAlert Severity="Severity.Warning" Class="mb-3">点击右上角"保存"按钮一次性提交所有记录。</MudAlert>

                <div style="overflow-x: auto;">
                    <MudTable T="StandardRow" Items="@rows" Dense="true" Hover="true" Elevation="0">
                        <HeaderContent>
                            <MudTh Style="width: 50px;">行号</MudTh>
                            <MudTh Style="width: 150px;">标准编码</MudTh>
                            <MudTh Style="min-width: 200px;">标准名称</MudTh>
                            <MudTh Style="width: 80px;">启用</MudTh>
                            <MudTh Style="min-width: 200px;">备注</MudTh>
                            <MudTh Style="width: 60px;">操作</MudTh>
                        </HeaderContent>
                        <RowTemplate Context="row">
                            <MudTd>
                                <MudText Typo="Typo.body2">@row.Sequence</MudText>
                            </MudTd>
                            <MudTd>
                                <MudTextField T="string"
                                              @bind-Value="row.StandardCode"
                                              Dense="true"
                                              Variant="Variant.Outlined"
                                              Size="Size.Small"
                                              Immediate="true" />
                            </MudTd>
                            <MudTd>
                                <MudTextField T="string"
                                              @bind-Value="row.StandardName"
                                              Dense="true"
                                              Variant="Variant.Outlined"
                                              Size="Size.Small"
                                              Immediate="true" />
                            </MudTd>
                            <MudTd>
                                <MudCheckBox @bind-Value="row.IsActive" Dense="true" Size="Size.Small" />
                            </MudTd>
                            <MudTd>
                                <MudTextField T="string"
                                              @bind-Value="row.Remark"
                                              Dense="true"
                                              Variant="Variant.Outlined"
                                              Size="Size.Small"
                                              Immediate="true" />
                            </MudTd>
                            <MudTd>
                                @if (rows.Count > 1)
                                {
                                    <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                                   Color="Color.Error"
                                                   Size="Size.Small"
                                                   OnClick="() => RemoveRow(row)" />
                                }
                            </MudTd>
                        </RowTemplate>
                    </MudTable>
                </div>
            }
        </MudCardContent>
    </MudCard>
</MudContainer>

@code {
    private List<StandardRow> rows = new();
    private bool isSubmitting;

    private class StandardRow
    {
        public int Sequence { get; set; }
        public string StandardCode { get; set; } = string.Empty;
        public string StandardName { get; set; } = string.Empty;
        public bool IsActive { get; set; } = true;
        public string? Remark { get; set; }
    }

    protected override void OnInitialized()
    {
        AddRow();
    }

    private void AddRow()
    {
        rows.Add(new StandardRow { Sequence = rows.Count + 1 });
    }

    private void RemoveRow(StandardRow row)
    {
        if (rows.Count <= 1) { Snackbar.Add("至少保留一条记录", Severity.Warning); return; }
        rows.Remove(row);
        for (int i = 0; i < rows.Count; i++) rows[i].Sequence = i + 1;
    }

    private async Task SaveAll()
    {
        var errors = new List<string>();
        for (int i = 0; i < rows.Count; i++)
        {
            var r = rows[i];
            var seq = i + 1;
            if (string.IsNullOrWhiteSpace(r.StandardCode)) errors.Add($"行{seq}: 标准编码不能为空");
            if (string.IsNullOrWhiteSpace(r.StandardName)) errors.Add($"行{seq}: 标准名称不能为空");
        }
        if (errors.Any()) { Snackbar.Add(string.Join("；", errors), Severity.Warning); return; }

        isSubmitting = true; StateHasChanged();
        var successCount = 0;
        var failCount = 0;
        var failMessages = new List<string>();

        for (int i = 0; i < rows.Count; i++)
        {
            var r = rows[i];
            var request = new CreateProductionStandardRequest
            {
                StandardCode = r.StandardCode,
                StandardName = r.StandardName,
                IsActive = r.IsActive,
                Remark = r.Remark
            };

            try
            {
                var result = await StandardService.CreateAsync(request);
                if (result.Success) successCount++;
                else { failCount++; failMessages.Add($"行{i + 1}: {result.Message}"); }
            }
            catch (Exception ex) { failCount++; failMessages.Add($"行{i + 1}: {ex.Message}"); }
        }

        isSubmitting = false; StateHasChanged();

        if (failCount == 0)
        {
            Snackbar.Add($"成功创建 {successCount} 条记录", Severity.Success);
            Navigation.NavigateTo("/standards");
        }
        else
        {
            Snackbar.Add($"成功 {successCount} 条，失败 {failCount} 条：{string.Join("；", failMessages)}", Severity.Error);
        }
    }

    private void GoBack() => Navigation.NavigateTo("/standards");
}
