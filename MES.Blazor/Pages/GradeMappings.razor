@page "/grade-mappings"
@using MES.Blazor.Services
@using MES.Core.DTOs
@using MES.Core.Models
@using Microsoft.AspNetCore.Authorization
@using MES.Blazor.Shared
@inject GradeMappingService GradeMappingService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject IJSRuntime JS
@attribute [Authorize(Roles = "OrderStaff,OrderDirector,Admin")]

<div class="mt-4">
    <MudCard>
        <MudCardHeader>
            <CardHeaderContent>
                <MudText Typo="Typo.h5" Class="font-weight-bold">
                    <MudIcon Icon="@Icons.Material.Filled.Science" Class="mr-2" Color="Color.Primary" />
                    牌号对照管理
                </MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">标准牌号 ↔ 工厂牌号 映射配置</MudText>
            </CardHeaderContent>
            <CardHeaderActions>
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Add"
                           OnClick="NavigateToCreate">
                    新建牌号
                </MudButton>
            </CardHeaderActions>
        </MudCardHeader>

        <MudCardContent>
            <!-- 搜索栏 -->
            <MudGrid>
                <MudItem xs="12" md="12">
                    <MudTextField T="string"
                                  Label="模糊搜索 - 标准牌号/工厂牌号/热处理工艺/特殊材料"
                                  Placeholder="输入关键字..."
                                  Value="searchKeyword"
                                  ValueChanged="@OnSearchChanged"
                                  Immediate="true"
                                  DebounceInterval="500"
                                  Clearable="true"
                                  ClearButton="true"
                                  Adornment="Adornment.End"
                                  AdornmentIcon="@Icons.Material.Filled.Search" />
                </MudItem>
            </MudGrid>

            <MudTable @ref="table"
                      T="StandardGradeMappingDto"
                      ServerData="OnServerData"
                      Loading="@isLoading"
                      Dense="true"
                      Hover="true"
                      Class="mt-4"
                      Elevation="0"
                      RowsPerPageLabel="每页行数:">
                <ToolBarContent>
                    <MudButton Variant="Variant.Outlined"
                               Size="Size.Small"
                               Color="Color.Info"
                               StartIcon="@Icons.Material.Filled.Print"
                               Disabled="@(!selectedIds.Any())"
                               OnClick="PrintSelected">
                        打印选中 (@selectedIds.Count)
                    </MudButton>
                    <MudButton Variant="Variant.Text"
                               Size="Size.Small"
                               Color="Color.Info"
                               StartIcon="@Icons.Material.Filled.Print"
                               OnClick="PrintAll">
                        打印全部
                    </MudButton>
                    <MudText Typo="Typo.body2" Class="ml-auto">
                        共 @totalCount 条记录
                    </MudText>
                </ToolBarContent>
                <HeaderContent>
                    <MudTh Style="width: 40px;">
                        <MudCheckBox T="bool" @bind-Value="allSelected" Dense="true" OnValueChanged="ToggleSelectAll" />
                    </MudTh>
                    <MudTh>
                        <span @onclick='() => ToggleSort("standardgrade")' class="sortable-header">
                            标准牌号
                            @if (sortColumn == "standardgrade")
                            {
                                <span class="sort-arrow">@GetSortIndicator("standardgrade")</span>
                            }
                        </span>
                    </MudTh>
                    <MudTh>
                        <span @onclick='() => ToggleSort("plantgrade")' class="sortable-header">
                            工厂牌号
                            @if (sortColumn == "plantgrade")
                            {
                                <span class="sort-arrow">@GetSortIndicator("plantgrade")</span>
                            }
                        </span>
                    </MudTh>
                    <MudTh>
                        <span @onclick='() => ToggleSort("density")' class="sortable-header">
                            密度(g/cm³)
                            @if (sortColumn == "density")
                            {
                                <span class="sort-arrow">@GetSortIndicator("density")</span>
                            }
                        </span>
                    </MudTh>
                    <MudTh>
                        <span @onclick='() => ToggleSort("heattreatment")' class="sortable-header">
                            热处理工艺
                            @if (sortColumn == "heattreatment")
                            {
                                <span class="sort-arrow">@GetSortIndicator("heattreatment")</span>
                            }
                        </span>
                    </MudTh>
                    <MudTh>
                        <span @onclick='() => ToggleSort("specialmaterial")' class="sortable-header">
                            特殊材料
                            @if (sortColumn == "specialmaterial")
                            {
                                <span class="sort-arrow">@GetSortIndicator("specialmaterial")</span>
                            }
                        </span>
                    </MudTh>
                    <MudTh>操作</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd Style="width: 40px;">
                        <MudCheckBox T="bool"
                                     Value="@selectedIds.Contains(context.Id)"
                                     ValueChanged="@((v) => { if(v) selectedIds.Add(context.Id); else selectedIds.Remove(context.Id); StateHasChanged(); })"
                                     Dense="true" />
                    </MudTd>
                    <MudTd title="@context.StandardGrade">
                        <MudLink Typo="Typo.body2" OnClick="() => ViewGradeMapping(context.Id)">@context.StandardGrade</MudLink>
                    </MudTd>
                    <MudTd title="@context.PlantGrade">@context.PlantGrade</MudTd>
                    <MudTd>@context.Density.ToString("F4")</MudTd>
                    <MudTd title="@context.HeatTreatment">@context.HeatTreatment</MudTd>
                    <MudTd>
                        <MudChip Size="Size.Small" Color="@(context.SpecialMaterial? Color.Warning: Color.Default)">
                            @(context.SpecialMaterial ? "特殊" : "常规")
                        </MudChip>
                    </MudTd>
                    <MudTd>
                        <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                       Color="Color.Warning"
                                       Size="Size.Small"
                                       OnClick="() => EditGradeMapping(context.Id)" />
                        <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                       Color="Color.Error"
                                       Size="Size.Small"
                                       OnClick="() => DeleteGradeMapping(context)" />
                    </MudTd>
                </RowTemplate>
                <PagerContent>
                    <MudTablePager />
                </PagerContent>
            </MudTable>
        </MudCardContent>
    </MudCard>
</div>

@code {
    private MudTable<StandardGradeMappingDto>? table;
    private List<StandardGradeMappingDto> gradeMappings = new();
    private HashSet<int> selectedIds = new();
    private bool allSelected;
    private bool isLoading = false;
    private string searchKeyword = string.Empty;
    private int totalCount = 0;

    private string sortColumn = "standardgrade";
    private bool sortDescending = false;

    private string GetSortIndicator(string column)
    {
        if (sortColumn != column) return "";
        return sortDescending ? "\u25BC" : "\u25B2";
    }

    private async Task<TableData<StandardGradeMappingDto>> OnServerData(TableState state)
    {
        isLoading = true;
        StateHasChanged();

        try
        {
            var queryParams = new QueryParams
            {
                PageIndex = state.Page + 1,
                PageSize = state.PageSize,
                Keyword = string.IsNullOrWhiteSpace(searchKeyword) ? null : searchKeyword,
                SortBy = sortColumn,
                IsDescending = sortDescending
            };

            var result = await GradeMappingService.GetPagedAsync(queryParams);

            if (result.Success && result.Data != null)
            {
                gradeMappings = result.Data.Items;
                totalCount = result.Data.TotalCount;
                return new TableData<StandardGradeMappingDto>
                {
                    Items = gradeMappings,
                    TotalItems = totalCount
                };
            }

            return new TableData<StandardGradeMappingDto>
            {
                Items = new List<StandardGradeMappingDto>(),
                TotalItems = 0
            };
        }
        catch (Exception ex)
        {
            Console.WriteLine($"加载失败: {ex.Message}");
            Snackbar.Add($"加载失败: {ex.Message}", Severity.Error);
            return new TableData<StandardGradeMappingDto>
            {
                Items = new List<StandardGradeMappingDto>(),
                TotalItems = 0
            };
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task ToggleSort(string column)
    {
        if (sortColumn == column)
            sortDescending = !sortDescending;
        else
        {
            sortColumn = column;
            sortDescending = false;
        }
        if (table != null)
            await table.ReloadServerData();
    }

    private async Task Search()
    {
        if (table != null)
        {
            await table.ReloadServerData();
        }
    }

    private async Task OnSearchChanged(string value)
    {
        searchKeyword = value ?? string.Empty;
        if (table != null)
            await table.ReloadServerData();
    }

    private void NavigateToCreate() => Navigation.NavigateTo("/grade-mappings/create");
    private void ViewGradeMapping(int id) => Navigation.NavigateTo($"/grade-mappings/{id}");
    private void EditGradeMapping(int id) => Navigation.NavigateTo($"/grade-mappings/{id}/edit");

    private async Task DeleteGradeMapping(StandardGradeMappingDto mapping)
    {
        var dialog = DialogService.Show<ConfirmDialog>("确认", new DialogParameters
        {
            ["ContentText"] = $"确定要删除牌号对照 \"{mapping.StandardGrade}\" 吗？\n\n如果该牌号已被订单使用，删除后可能导致数据问题！",
            ["ConfirmText"] = "确认删除",
            ["Color"] = Color.Error
        });
        var dialogResult = await dialog.Result;
        if (!dialogResult.Canceled)
        {
            try
            {
                var result = await GradeMappingService.DeleteAsync(mapping.Id);
                if (result.Success)
                {
                    Snackbar.Add("删除成功", Severity.Success);
                    await Search();
                }
                else
                {
                    Snackbar.Add(result.Message ?? "删除失败", Severity.Error);
                }
            }
            catch (Exception ex)
            {
                Snackbar.Add($"删除失败: {ex.Message}", Severity.Error);
            }
        }
    }

    // ========== 选择方法 ==========

    private async Task ToggleSelectAll(bool select)
    {
        allSelected = select;
        if (select)
        {
            foreach (var item in gradeMappings)
                selectedIds.Add(item.Id);
        }
        else
        {
            selectedIds.Clear();
        }
        await Task.CompletedTask;
    }

    // ========== 打印方法 ==========

    private async Task PrintSelected()
    {
        if (!selectedIds.Any())
        {
            Snackbar.Add("请先选择要打印的牌号", Severity.Warning);
            return;
        }
        try
        {
            var ids = selectedIds.ToArray();
            var result = await GradeMappingService.PrintGradeMappingBatchAsync(ids);
            if (result.Success && result.Data != null)
                await JS.InvokeVoidAsync("openPdf", result.Data);
            else
                Snackbar.Add(result.Message ?? "打印失败", Severity.Error);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"打印失败: {ex.Message}", Severity.Error);
        }
    }

    private async Task PrintAll()
    {
        try
        {
            var result = await GradeMappingService.PrintGradeMappingAllAsync(
                string.IsNullOrWhiteSpace(searchKeyword) ? null : searchKeyword,
                sortColumn, sortDescending);
            if (result.Success && result.Data != null)
                await JS.InvokeVoidAsync("openPdf", result.Data);
            else
                Snackbar.Add(result.Message ?? "打印失败", Severity.Error);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"打印失败: {ex.Message}", Severity.Error);
        }
    }
}