@page "/purchase-orders/{id:int}"
@page "/purchase-orders/{id:int}/edit"
@using MES.Blazor.Services
@using MES.Core.DTOs
@using Microsoft.AspNetCore.Authorization
@inject PurchaseOrderService PurchaseService
@inject SupplierService SupplierService
@inject WorkOrderService WorkOrderService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@attribute [Authorize(Roles = "MaterialStaff,MaterialDirector,Admin")]

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-4">
    @if (isLoading) { <MudProgressCircular Indeterminate Size="Size.Large" Class="d-flex justify-center ma-8" /> }
    else if (order == null) { <MudAlert Severity="Severity.Error">采购单不存在</MudAlert> }
    else
    {
        <MudCard>
            <MudCardHeader>
                <CardHeaderContent>
                    <MudText Typo="Typo.h5" Class="font-weight-bold"><MudIcon Icon="@Icons.Material.Filled.ShoppingCart" Class="mr-2" Color="Color.Primary" />采购订单详情</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">单号：@order.OrderNo</MudText>
                </CardHeaderContent>
                <CardHeaderActions>
                    <MudButton Variant="Variant.Text" OnClick="GoBack">返回</MudButton>
                    @if (isEditMode)
                    {
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Save" Disabled="@isSubmitting">
                            @if (isSubmitting) { <MudProgressCircular Size="Size.Small" Color="Color.Inherit" /> } else { <span>保存</span> }
                        </MudButton>
                    }
                    else
                    {
                        <AuthorizeView Roles="MaterialDirector,Admin"><MudButton Variant="Variant.Outlined" Color="Color.Warning" OnClick="EnterEditMode">编辑</MudButton></AuthorizeView>
                    }
                </CardHeaderActions>
            </MudCardHeader>
            <MudCardContent>
                <MudText Typo="Typo.subtitle1" Class="mb-4 font-weight-bold"><MudIcon Icon="@Icons.Material.Filled.Info" Size="Size.Small" Class="mr-1" />基本信息</MudText>
                <MudGrid>
                    <MudItem xs="12" md="3"><MudTextField T="string" Label="采购单号" Value="@order.OrderNo" Disabled="true" /></MudItem>
                    <MudItem xs="12" md="3">
                        <MudSelect T="int" Label="供应商" @bind-Value="editOrder.SupplierId" Disabled="!isEditMode" Required="true">
                            @foreach (var s in suppliers) { <MudSelectItem Value="s.Id">@s.SupplierName</MudSelectItem> }
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" md="3"><MudTextField T="string" Label="下单日期" @bind-Value="dateText" Disabled="!isEditMode" Required="true" Placeholder="yyyy-MM-dd" /></MudItem>
                    <MudItem xs="12" md="3">
                        @if (isEditMode || isStatusEditMode)
                        {
                            <MudSelect T="string" Label="状态辅助" @bind-Value="editManualStatus" OnValueChanged="OnManualStatusChanged" Clearable="true">
                                <MudSelectItem Value="@("")">（自动）</MudSelectItem>
                                <MudSelectItem Value="@("Open")">已下单</MudSelectItem>
                                <MudSelectItem Value="@("Partial")">部分到货</MudSelectItem>
                                <MudSelectItem Value="@("Completed")">已完成</MudSelectItem>
                                <MudSelectItem Value="@("Cancelled")">已取消</MudSelectItem>
                            </MudSelect>
                        }
                        else
                        {
                            <MudTextField T="string" Label="状态" Value="@GetStatusText(order.Status)" Disabled="true" />
                        }
                        <MudText Typo="Typo.caption" Color="Color.Secondary">当前：@GetStatusText(order.Status)@(!string.IsNullOrEmpty(order.ManualStatus) ? "（手动覆盖）" : "")</MudText>
                    </MudItem>
                </MudGrid>
                <MudGrid>
                    <MudItem xs="12" md="6">
                        <MudTextField T="string" Label="来源工单号" @bind-Value="editOrder.SourceWorkOrderNo" Disabled="!isEditMode" />
                    </MudItem>
                    <MudItem xs="12" md="6" Class="d-flex align-center">
                        @if (!string.IsNullOrEmpty(order.SourceWorkOrderNo))
                        {
                            <MudButton Variant="Variant.Text" Color="Color.Info" Size="Size.Small" OnClick="ToggleWorkOrderInfo">
                                @(showWorkOrder ? "隐藏工单信息" : "查看工单信息")
                            </MudButton>
                        }
                    </MudItem>
                </MudGrid>
                @if (showWorkOrder && workOrder != null)
                {
                    <MudAlert Severity="Severity.Info" Class="mb-4" Variant="Variant.Outlined">
                        <MudText Typo="Typo.body2"><strong>工单号：</strong>@workOrder.WorkOrderNo</MudText>
                        <MudText Typo="Typo.body2"><strong>订单号/主号/次号：</strong>@workOrder.SalesOrderNo / @workOrder.ProductionMainNo / @workOrder.ProductionSubNo</MudText>
                        <MudText Typo="Typo.body2"><strong>物料名称：</strong>@workOrder.MaterialName</MudText>
                        <MudText Typo="Typo.body2"><strong>结算方式：</strong>@workOrder.SettlementMethod</MudText>
                        <MudText Typo="Typo.body2"><strong>交货状态：</strong>@workOrder.DeliveryState</MudText>
                        <MudText Typo="Typo.body2"><strong>延期罚款：</strong>@(workOrder.DelayPenalty ? "是" : "否")</MudText>
                        <MudText Typo="Typo.body2"><strong>交货日期：</strong>@workOrder.DeliveryDate.ToString("yyyy-MM-dd")</MudText>
                        <MudText Typo="Typo.body2"><strong>工厂牌号：</strong>@workOrder.PlantGrade</MudText>
                        <MudText Typo="Typo.body2"><strong>规格：</strong>@workOrder.Specification</MudText>
                        <MudText Typo="Typo.body2"><strong>外径公差：</strong>@workOrder.OuterDiameterNegative ~ @workOrder.OuterDiameterPositive</MudText>
                        <MudText Typo="Typo.body2"><strong>壁厚公差：</strong>@workOrder.WallThicknessNegative ~ @workOrder.WallThicknessPositive</MudText>
                        <MudText Typo="Typo.body2"><strong>长度状态：</strong>@workOrder.LengthStatus</MudText>
                        <MudText Typo="Typo.body2"><strong>数量/重量：</strong>@workOrder.TotalQuantity 支 / @workOrder.TotalWeight.ToString("G29") kg</MudText>
                        <MudText Typo="Typo.body2"><strong>理论单支重：</strong>@workOrder.UnitWeight?.ToString("G29") kg</MudText>
                    </MudAlert>
                }

                <MudText Typo="Typo.subtitle1" Class="mb-4 mt-4 font-weight-bold"><MudIcon Icon="@Icons.Material.Filled.Category" Size="Size.Small" Class="mr-1" />物料信息</MudText>
                <MudGrid>
                    <MudItem xs="12" md="4"><MudTextField T="string" Label="物料分类" @bind-Value="editOrder.MaterialCategory" Disabled="!isEditMode" Required="true" /></MudItem>
                    <MudItem xs="12" md="4"><MudTextField T="string" Label="厂内钢种" @bind-Value="editOrder.PlantGrade" Disabled="!isEditMode" Required="true" /></MudItem>
                    <MudItem xs="12" md="4"><MudTextField T="string" Label="规格" @bind-Value="editOrder.Specification" Disabled="!isEditMode" Required="true" /></MudItem>
                    <MudItem xs="12" md="3"><MudTextField T="decimal?" Label="单支重量(kg)" @bind-Value="editOrder.UnitWeight" Disabled="!isEditMode" /></MudItem>
                    <MudItem xs="12" md="3"><MudTextField T="int?" Label="采购支数" @bind-Value="editOrder.Quantity" Disabled="!isEditMode" /></MudItem>
                    <MudItem xs="12" md="3"><MudTextField T="decimal" Label="采购重量(kg)" @bind-Value="editOrder.Weight" Disabled="!isEditMode" Required="true" /></MudItem>
                    <MudItem xs="12" md="3"><MudTextField T="string" Label="要求到货日期" @bind-Value="requiredDateText" Disabled="!isEditMode" Required="true" Placeholder="yyyy-MM-dd" /></MudItem>
                    <MudItem xs="12" md="3"><MudTextField T="decimal?" Label="单价" @bind-Value="editOrder.UnitPrice" Disabled="!isEditMode" /></MudItem>
                    <MudItem xs="12" md="3">
                        <MudTextField T="decimal?" Label="总金额" Value="@(editOrder.Quantity.HasValue && editOrder.UnitPrice.HasValue ? editOrder.Quantity.Value * editOrder.UnitPrice.Value : (decimal?)null)" Disabled="true" />
                    </MudItem>
                    <MudItem xs="12" md="12"><MudTextField T="string" Label="备注" @bind-Value="editOrder.Remark" Disabled="!isEditMode" Multiline="true" Lines="2" /></MudItem>
                </MudGrid>

                <MudText Typo="Typo.subtitle1" Class="mb-4 mt-4 font-weight-bold"><MudIcon Icon="@Icons.Material.Filled.Inventory" Size="Size.Small" Class="mr-1" />到货进度（仓库同步）</MudText>
                <MudGrid>
                    <MudItem xs="12" md="3"><MudTextField T="int" Label="已到货支数" Value="@order.ReceivedQuantity" Disabled="true" /></MudItem>
                    <MudItem xs="12" md="3"><MudTextField T="decimal" Label="已到货重量(kg)" Value="@order.ReceivedWeight" Disabled="true" /></MudItem>
                    <MudItem xs="12" md="3"><MudTextField T="string" Label="最后到货日期" Value="@(order.LastArrivalDate?.ToString("yyyy-MM-dd"))" Disabled="true" /></MudItem>
                    <MudItem xs="12" md="3">
                        <MudButton Variant="Variant.Outlined" Color="Color.Info" Size="Size.Small" OnClick="SyncSingle" Disabled="@isSyncing" StartIcon="@Icons.Material.Filled.Sync">
                            即时更新
                        </MudButton>
                    </MudItem>
                </MudGrid>
                @if (order.Quantity.HasValue && order.Quantity > 0)
                {
                    <MudProgressLinear Value="@Math.Min(100, (double)order.ReceivedQuantity / order.Quantity.Value * 100)" Color="@(order.ReceivedQuantity >= order.Quantity.Value ? Color.Success : Color.Primary)" Class="mt-2" />
                }
            </MudCardContent>
        </MudCard>
    }
</MudContainer>

@code {
    [Parameter] public int Id { get; set; }
    private bool isEditMode => Navigation.Uri.Contains("/edit");
    private bool isStatusEditMode = true;
    private PurchaseOrderDto? order;
    private EditOrderModel editOrder = new();
    private string dateText = "";
    private string requiredDateText = "";
    private List<SupplierProfileDto> suppliers = new();
    private bool isLoading = true, isSubmitting, isSyncing, showWorkOrder;
    private WorkOrderDetailDto? workOrder;
    private string? editManualStatus;

    private class EditOrderModel
    {
        public int SupplierId { get; set; }
        public DateTime Date { get; set; }
        public string MaterialCategory { get; set; } = string.Empty;
        public string PlantGrade { get; set; } = string.Empty;
        public string Specification { get; set; } = string.Empty;
        public decimal? UnitWeight { get; set; }
        public int? Quantity { get; set; }
        public decimal Weight { get; set; }
        public DateTime RequiredDate { get; set; }
        public decimal? UnitPrice { get; set; }
        public string? SourceWorkOrderNo { get; set; }
        public string? Remark { get; set; }
    }

    protected override async Task OnInitializedAsync()
    {
        // 供应商列表和订单数据可并行加载
        var suppliersTask = SupplierService.GetActiveAsync();
        await LoadData();
        suppliers = await suppliersTask;
    }

    private async Task LoadData()
    {
        if (Id <= 0) { Snackbar.Add("无效的ID", Severity.Error); isLoading = false; return; }
        isLoading = true; StateHasChanged();
        try
        {
            var result = await PurchaseService.GetByIdAsync(Id);
            if (result.Success && result.Data != null)
            {
                order = result.Data;
                editManualStatus = order.ManualStatus;
                editOrder = new EditOrderModel
                {
                    SupplierId = order.SupplierId,
                    Date = order.OrderDate,
                    MaterialCategory = order.MaterialCategory,
                    PlantGrade = order.PlantGrade,
                    Specification = order.Specification,
                    UnitWeight = order.UnitWeight,
                    Quantity = order.Quantity,
                    Weight = order.Weight,
                    RequiredDate = order.RequiredDate,
                    UnitPrice = order.UnitPrice,
                    SourceWorkOrderNo = order.SourceWorkOrderNo,
                    Remark = order.Remark
                };
                dateText = order.OrderDate.ToString("yyyy-MM-dd");
                requiredDateText = order.RequiredDate.ToString("yyyy-MM-dd");
            }
            else { Snackbar.Add(result.Message ?? "加载失败", Severity.Error); }
        }
        catch (Exception ex) { Snackbar.Add($"加载失败: {ex.Message}", Severity.Error); }
        finally { isLoading = false; StateHasChanged(); }
    }

    private void EnterEditMode() => Navigation.NavigateTo($"/purchase-orders/{Id}/edit");

    private async Task Save()
    {
        isSubmitting = true; StateHasChanged();
        try
        {
            var req = new UpdatePurchaseOrderRequest
            {
                SupplierId = editOrder.SupplierId,
                MaterialCategory = editOrder.MaterialCategory,
                PlantGrade = editOrder.PlantGrade,
                Specification = editOrder.Specification,
                UnitWeight = editOrder.UnitWeight,
                Quantity = editOrder.Quantity,
                Weight = editOrder.Weight,
                RequiredDate = editOrder.RequiredDate,
                UnitPrice = editOrder.UnitPrice,
                SourceWorkOrderNo = editOrder.SourceWorkOrderNo,
                Remark = editOrder.Remark
            };
            if (!DateTime.TryParse(dateText, out var dateVal)) { Snackbar.Add("下单日期格式错误", Severity.Warning); isSubmitting = false; return; }
            if (!DateTime.TryParse(requiredDateText, out var requiredDateVal)) { Snackbar.Add("要求到货日期格式错误", Severity.Warning); isSubmitting = false; return; }
            editOrder.Date = dateVal;
            editOrder.RequiredDate = requiredDateVal;
            req.RequiredDate = requiredDateVal;
            var result = await PurchaseService.UpdateAsync(Id, req);
            if (result.Success) { Snackbar.Add("更新成功", Severity.Success); Navigation.NavigateTo($"/purchase-orders/{Id}"); }
            else { Snackbar.Add(result.Message ?? "更新失败", Severity.Error); }
        }
        catch (Exception ex) { Snackbar.Add($"更新失败: {ex.Message}", Severity.Error); }
        finally { isSubmitting = false; StateHasChanged(); }
    }

    private async Task OnManualStatusChanged(string? value)
    {
        editManualStatus = value;
        try
        {
            var result = await PurchaseService.UpdateStatusAsync(Id, new UpdateOrderStatusRequest { ManualStatus = value });
            if (result.Success) { Snackbar.Add("状态已更新", Severity.Success); await LoadData(); }
            else { Snackbar.Add(result.Message ?? "状态更新失败", Severity.Error); }
        }
        catch (Exception ex) { Snackbar.Add($"状态更新失败: {ex.Message}", Severity.Error); }
    }

    private async Task SyncSingle()
    {
        isSyncing = true; StateHasChanged();
        try
        {
            var result = await PurchaseService.SyncSingleAsync(Id);
            if (result.Success) { Snackbar.Add("同步完成", Severity.Success); await LoadData(); }
            else { Snackbar.Add(result.Message ?? "同步失败", Severity.Error); }
        }
        catch (Exception ex) { Snackbar.Add($"同步失败: {ex.Message}", Severity.Error); }
        finally { isSyncing = false; StateHasChanged(); }
    }

    private async Task ToggleWorkOrderInfo()
    {
        showWorkOrder = !showWorkOrder;
        if (showWorkOrder && workOrder == null && !string.IsNullOrEmpty(order?.SourceWorkOrderNo))
        {
            try
            {
                var result = await WorkOrderService.GetByWorkOrderNoAsync(order.SourceWorkOrderNo);
                if (result.Success && result.Data != null)
                    workOrder = result.Data;
                else
                    Snackbar.Add(result.Message ?? "未找到工单信息", Severity.Warning);
            }
            catch (Exception ex) { Snackbar.Add($"查询工单失败: {ex.Message}", Severity.Warning); }
        }
    }

    private void GoBack() => Navigation.NavigateTo("/purchase-orders");
    private static string GetStatusText(string status) => status switch { "Open" => "已下单", "Partial" => "部分到货", "Completed" => "已完成", "Cancelled" => "已取消", _ => status };
}
