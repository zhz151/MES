@page "/customers"
@using MES.Blazor.Services
@using MES.Core.Models
@using MES.Core.Enums
@using Microsoft.AspNetCore.Authorization
@using MES.Blazor.Shared
@using MES.Blazor.Components
@using MES.Core.DTOs.Order
@inject CustomerService CustomerService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject IJSRuntime JS
@inject HttpClient Http
@inject ColumnPrefsService ColumnPrefs
@inject PageStateService PageState
@attribute [Authorize(Roles = Roles.Policies.OrderView)]

<MudContainer MaxWidth="MaxWidth.False" Class="mt-4 pl-0">
    <MudCard>
        <MudCardHeader>
            <CardHeaderContent>
                <MudText Typo="Typo.h5" Class="font-weight-bold">
                    <MudIcon Icon="@Icons.Material.Filled.Business" Class="mr-2" Color="Color.Primary" />
                    客户管理
                </MudText>
            </CardHeaderContent>
            <CardHeaderActions>
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Add"
                           OnClick="NavigateToCreate">
                    新建客户
                </MudButton>
            </CardHeaderActions>
        </MudCardHeader>

        <MudCardContent>
            <!-- 搜索栏 + 双日期区间（区间顺序：业务员/最终用户 → 接单起止 → 发货起止，2026-09-14） -->
            <MudGrid>
                <MudItem xs="12" md="4">
                    <MudTextField T="string"
                                  Label="模糊搜索 - 客户编码/单位/业务员/最终客户/状态"
                                  Value="_searchKeyword" ValueExpression="@(() => _searchKeyword)"
                                  ValueChanged="@OnSearchChanged"
                                  Immediate="true"
                                  DebounceInterval="500"
                                  Adornment="Adornment.End"
                                  AdornmentIcon="@Icons.Material.Filled.Search" />
                </MudItem>
                <MudItem xs="12" md="8">
                    @* 工具栏：外层 gap 16px 作为「组间隔离」，组内 gap 6px 紧凑（参照「投料产出总况」日期范围组合） *@
                    <div class="d-flex align-center" style="gap:16px; flex-wrap:wrap;">
                        @* 接单区间：任一端有值即生效，仅「区间接单」有数据；起/止/应用/清除 = 一个整体 *@
                        <div class="d-flex align-center" style="gap:6px;">
                            <MudTextField T="string" @bind-Value="_signDateFrom" Immediate="true" Variant="Variant.Outlined"
                                          Dense="true" Margin="Margin.Dense" Style="width:140px" Label="接单日期起"
                                          Placeholder="yyyy-MM-dd" />
                            <MudTextField T="string" @bind-Value="_signDateTo" Immediate="true" Variant="Variant.Outlined"
                                          Dense="true" Margin="Margin.Dense" Style="width:140px" Label="接单日期止"
                                          Placeholder="yyyy-MM-dd" />
                            <MudButton Variant="Variant.Outlined" Size="Size.Small" Color="Color.Primary"
                                       OnClick="ApplyRangeAsync">应用接单区间</MudButton>
                            <MudButton Variant="Variant.Text" Size="Size.Small"
                                       OnClick="@(() => { _signDateFrom = ""; _signDateTo = ""; return ApplyRangeAsync(); })"
                                       Disabled="@(!SignRangeMode)">清除</MudButton>
                        </div>
                        <MudDivider Vertical="true" FlexItem="true" Style="height:28px;" />
                        @* 发货区间：与接单区间互相独立、可叠加；起/止/应用/清除 = 一个整体 *@
                        <div class="d-flex align-center" style="gap:6px;">
                            <MudTextField T="string" @bind-Value="_shipDateFrom" Immediate="true" Variant="Variant.Outlined"
                                          Dense="true" Margin="Margin.Dense" Style="width:140px" Label="发货日期起"
                                          Placeholder="yyyy-MM-dd" />
                            <MudTextField T="string" @bind-Value="_shipDateTo" Immediate="true" Variant="Variant.Outlined"
                                          Dense="true" Margin="Margin.Dense" Style="width:140px" Label="发货日期止"
                                          Placeholder="yyyy-MM-dd" />
                            <MudButton Variant="Variant.Outlined" Size="Size.Small" Color="Color.Primary"
                                       OnClick="ApplyRangeAsync">应用发货区间</MudButton>
                            <MudButton Variant="Variant.Text" Size="Size.Small"
                                       OnClick="@(() => { _shipDateFrom = ""; _shipDateTo = ""; return ApplyRangeAsync(); })"
                                       Disabled="@(!ShipRangeMode)">清除</MudButton>
                        </div>
                        @if (AnyRangeMode)
                        {
                            <MudButton Variant="Variant.Text" Size="Size.Small"
                                       OnClick="@(() => { _signDateFrom = _signDateTo = _shipDateFrom = _shipDateTo = ""; return ApplyRangeAsync(); })">
                                清空全部区间
                            </MudButton>
                        }
                    </div>
                </MudItem>
            </MudGrid>
            @if (AnyRangeMode)
            {
                <MudText Typo="Typo.caption" Class="text-hint mb-2">@RangeHint()</MudText>
            }

            <!-- 数据表格 -->
            <div id="customers-list-table">
            <!-- 工具栏 -->
            <div class="list-toolbar">
                <div class="d-flex align-center">
                    <ColumnDisplaySelect Columns="_allColumns"
                                         OnColumnToggle="OnColumnToggle"
                                         OnMoveUp="MoveColumnUp"
                                         OnMoveDown="MoveColumnDown" />
                    <MudButton Variant="Variant.Text" Size="Size.Small"
                               Color="Color.Default"
                               StartIcon="@Icons.Material.Filled.RestartAlt"
                               OnClick="ResetColumnDisplay" Class="ml-2">
                        重置
                    </MudButton>
                </div>
                <div class="d-flex align-center" style="margin-left:auto;">
                    <MudButton Variant="Variant.Outlined"
                               Size="Size.Small"
                               Color="Color.Info"
                               StartIcon="@Icons.Material.Filled.Print"
                               Disabled="@(!selectedIds.Any())"
                               OnClick="PrintSelected">
                        打印选中 (@selectedIds.Count)
                    </MudButton>
                    <MudText Typo="Typo.body2" Class="ml-4">
                        共 @_totalCount 条记录
                    </MudText>
                </div>
            </div>
            @* ①② 分组标题栏（仿订单列表 B23） *@
            <div class="col-group-header-scroll">
                <div class="col-group-header-bar" style="width: @(_totalTableWidth)px">
                    @foreach (var gh in _groupHeaders)
                    {
                        <div class="col-group-header-item @gh.CssClass" style="width: @(gh.TotalWidth)px">
                            <span class="col-group-badge">@gh.GroupName</span>
                        </div>
                    }
                </div>
            </div>
            <MudTable Breakpoint="Breakpoint.None" @ref="table"
                      T="CustomerProfileDto"
                      ServerData="@LoadDataFromServer"
                      Dense="true"
                      Hover="true"
                      Class="mt-0 auto-table"
                      Elevation="0"
                      RowsPerPage="@_pageSize"
                      RowsPerPageLabel="每页行数:">
                <HeaderContent>
                    @{
                        int? _prevGk = null;
                    }
                    <MudTh Style="width: 40px;">
                        <MudCheckBox T="bool" @bind-Value="allSelected" Dense="true" />
                    </MudTh>
                    @foreach (var col in _visibleColumns)
                    {
                        var _isGroupStart = col.GroupKey.HasValue && col.GroupKey != _prevGk;
                        _prevGk = col.GroupKey;
                        var _headerClass = GetHeaderGroupCss(col.GroupKey, _isGroupStart) + GetTradeAccentCss(col.Key);
                        <MudTh Class="@_headerClass" Style="@($"width:{col.Width}px")">
                            <div style="display:inline-flex; align-items:center; gap:4px;">
                                <span @onclick='() => ToggleSort(col.Key)' style="cursor:pointer" class="th-label">@TradeColumnLabel(col)@if (col.IsRequired) {<span class="required-star">*</span>} @if (sortColumn == col.Key) {@(sortDescending ? " ▼" : " ▲")}</span>
                                @if (col.FilterType != null)
                                {
                                    <ExcelFilter T="CustomerProfileDto"
                                                 Label="@TradeColumnLabel(col)"
                                                 FieldKey="@col.Key"
                                                 FilterOptions="@(_filterContextOptions.GetValueOrDefault(col.Key))"
                                                 ActiveFilterValues="@(_columnFilters.GetValueOrDefault(col.Key))"
                                                 FilterChanged="@(args => OnColumnFilterChanged(args.fieldKey, args.selectedValues))" />

                                }
                            </div>
                        </MudTh>
                    }
                    <MudTh Style="width: 90px;">操作</MudTh>
                </HeaderContent>
                <RowTemplate Context="item">
                    @{
                        int? _prevGk2 = null;
                    }
                    <MudTd Style="width: 40px;">
                        @if (!_editingIds.Contains(item.Id))
                        {
                            <MudCheckBox T="bool"
                                         Value="@selectedIds.Contains(item.Id)"
                                         ValueChanged="@((v) => { if(v) selectedIds.Add(item.Id); else selectedIds.Remove(item.Id); StateHasChanged(); })"
                                         Dense="true" />
                        }
                    </MudTd>
                    @foreach (var col in _visibleColumns)
                    {
                        var _isGroupStart2 = col.GroupKey.HasValue && col.GroupKey != _prevGk2;
                        _prevGk2 = col.GroupKey;
                        var _cellClass = GetCellGroupCss(col.GroupKey, _isGroupStart2);
                        <MudTd Class="@_cellClass">@RenderCell(item, col)</MudTd>
                    }
                    <MudTd Style="white-space: nowrap; width: 90px;">
                        @{
                            var isEditing = _editingIds.Contains(item.Id);
                        }
                        @if (isEditing)
                        {
                            <MudIconButton Icon="@Icons.Material.Filled.Check" Color="Color.Success" Size="Size.Small" OnClick="() => SaveEdit(item)" Disabled="@_isSaving" Title="保存" />
                            <MudIconButton Icon="@Icons.Material.Filled.Close" Color="Color.Default" Size="Size.Small" OnClick="() => CancelEdit(item)" Title="取消" />
                        }
                        else
                        {
                            <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Info" Size="Size.Small" OnClick="() => StartEdit(item)" Title="编辑" />
                        <AuthorizeView Roles="@Roles.Policies.OrderDelete">
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" OnClick="() => DeleteItem(item)" Title="删除" />
                        </AuthorizeView>
                        }
                    </MudTd>
                </RowTemplate>
                <FooterContent>
                    @{
                        int? _prevGk3 = null;
                    }
                    <MudTd Style="width:40px;min-width:40px;max-width:40px;"></MudTd>
                    @foreach (var col in _visibleColumns)
                    {
                        var _isGroupStart3 = col.GroupKey.HasValue && col.GroupKey != _prevGk3;
                        _prevGk3 = col.GroupKey;
                        var _footerClass = GetCellGroupCss(col.GroupKey, _isGroupStart3) + " col-footer-cell";
                        <MudTd Class="@_footerClass"><span class="col-footer-sum">@RenderFooterCell(col)</span></MudTd>
                    }
                    <MudTd Class="col-footer-cell"></MudTd>
                </FooterContent>
                <PagerContent>
                    <MudTablePager PageSizeOptions="new int[]{10,15,25,50,100}" />
                </PagerContent>
            </MudTable>
            </div>
        </MudCardContent>
    </MudCard>
</MudContainer>
