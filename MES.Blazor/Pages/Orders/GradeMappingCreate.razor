@page "/grade-mappings/create"
@using MES.Blazor.Services
@using MES.Core.DTOs
@using Microsoft.AspNetCore.Authorization
@inject GradeMappingService GradeMappingService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject IJSRuntime JS
@attribute [Authorize(Roles = Roles.Policies.OrderWrite)]

<MudContainer MaxWidth="MaxWidth.False" Class="mt-4">
    <MudCard>
        <MudCardHeader>
            <CardHeaderContent>
                <MudText Typo="Typo.h5" Class="font-weight-bold">
                    <MudIcon Icon="@Icons.Material.Filled.Add" Class="mr-2" Color="Color.Primary" />
                    新建牌号对照
                </MudText>
            </CardHeaderContent>
            <CardHeaderActions>
                <MudButton Variant="Variant.Text" OnClick="GoBack">返回</MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAll" Loading="@isSubmitting">
                    保存
                </MudButton>
            </CardHeaderActions>
        </MudCardHeader>

        <MudCardContent>
            <div class="d-flex justify-space-between align-center mb-3">
                <MudText Typo="Typo.subtitle1">牌号对照列表</MudText>
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="AddRow">添加牌号</MudButton>
            </div>

            <div id="grade-mappings-create-table">
            @if (rows.Count == 0)
            {
            }
            else
            {
                <div style="overflow-x: auto;">
                    <MudTable T="GradeMappingRow" Items="@rows" Dense="true" Hover="true" Elevation="0" Class="auto-table">
                        <HeaderContent>
                            <MudTh Style="width: 50px;">行号</MudTh>
                            <MudTh Style="width: 120px;">标准牌号<span class="required-star">*</span></MudTh>
                            <MudTh Style="width: 120px;">工厂牌号<span class="required-star">*</span></MudTh>
                            <MudTh Style="width: 130px;">密度 (g/cm³)<span class="required-star">*</span></MudTh>
                            <MudTh Style="width: 80px;">特殊材料</MudTh>
                            <MudTh Style="width: 80px;">钢性</MudTh>
                            <MudTh Style="width:180px;">热处理工艺</MudTh>
                            <MudTh Style="width:180px;">特殊注意事项</MudTh>
                            <MudTh Style="width:150px;">备注</MudTh>
                            <MudTh Style="width: 60px;">操作</MudTh>
                        </HeaderContent>
                        <RowTemplate Context="row">
                            <MudTd>
                                <MudText Typo="Typo.body2">@row.Sequence</MudText>
                            </MudTd>
                            <MudTd>
                                <MudTextField T="string"
                                              @bind-Value="row.StandardGrade"
                                              Dense="true"
                                              Variant="Variant.Outlined"
                                              Size="Size.Small"
                                              />
                            </MudTd>
                            <MudTd>
                                <MudTextField T="string"
                                              @bind-Value="row.PlantGrade"
                                              Dense="true"
                                              Variant="Variant.Outlined"
                                              Size="Size.Small"
                                              />
                            </MudTd>
                            <MudTd>
                                <MudNumericField T="decimal"
                                                 @bind-Value="row.Density"
                                                 Format="G29"
                                                 Min="0"
                                                 Dense="true"
                                                 Variant="Variant.Outlined"
                                                 Size="Size.Small"
                                                 Style="width: 110px;"
                                                 HideSpinButtons="true" />
                            </MudTd>
                            <MudTd>
                                <MudCheckBox @bind-Value="row.SpecialMaterial" />
                            </MudTd>
                            <MudTd>
                                <MudText Typo="Typo.body2">@row.SteelProperty</MudText>
                            </MudTd>
                            <MudTd>
                                <MudTextField T="string"
                                              @bind-Value="row.HeatTreatment"
                                              Dense="true"
                                              Variant="Variant.Outlined"
                                              Size="Size.Small"
                                              />
                            </MudTd>
                            <MudTd>
                                <MudTextField T="string"
                                              @bind-Value="row.SpecialNote"
                                              Dense="true"
                                              Variant="Variant.Outlined"
                                              Size="Size.Small"
                                              />
                            </MudTd>
                            <MudTd>
                                <MudTextField T="string"
                                              @bind-Value="row.Remark"
                                              Dense="true"
                                              Variant="Variant.Outlined"
                                              Size="Size.Small"
                                              />
                            </MudTd>
                            <MudTd>
                                @if (rows.Count > 1)
                                {
                                    <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                                   Color="Color.Error"
                                                   Size="Size.Small"
                                                   OnClick="() => RemoveRow(row)" />
                                }
                            </MudTd>
                        </RowTemplate>
                    </MudTable>
                </div>
            }
            </div>
        </MudCardContent>
    </MudCard>
</MudContainer>

@code {
    private List<GradeMappingRow> rows = new();
    private bool isSubmitting;
    private bool _isArrowNavSetup;

    private class GradeMappingRow
    {
        public int Sequence { get; set; }
        public string StandardGrade { get; set; } = string.Empty;
        public string PlantGrade { get; set; } = string.Empty;
        public decimal Density { get; set; }
        public bool SpecialMaterial { get; set; }
        public string SteelProperty => ComputeSteelProperty(PlantGrade);
        public string? HeatTreatment { get; set; }
        public string? SpecialNote { get; set; }
        public string? Remark { get; set; }
    }

    private static string ComputeSteelProperty(string plantGrade)
    {
        if (string.IsNullOrWhiteSpace(plantGrade)) return "镍基合金";
        var firstChar = plantGrade.Trim()[0];
        return firstChar switch
        {
            '3' or '9' => "奥氏体",
            '2' => "双相钢",
            _ => "镍基合金"
        };
    }

    protected override void OnInitialized()
    {
        AddRow();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_isArrowNavSetup)
        {
            _isArrowNavSetup = true;
            if (!await JS.InvokeAsync<bool>("enableTableArrowNav", "#grade-mappings-create-table"))
                _isArrowNavSetup = false;
        }
    }

    private void AddRow()
    {
        rows.Add(new GradeMappingRow { Sequence = rows.Count + 1 });
    }

    private void RemoveRow(GradeMappingRow row)
    {
        if (rows.Count <= 1) { Snackbar.Add("至少保留一条记录", Severity.Warning); return; }
        rows.Remove(row);
        for (int i = 0; i < rows.Count; i++) rows[i].Sequence = i + 1;
    }

    private async Task SaveAll()
    {
        var errors = new List<string>();
        for (int i = 0; i < rows.Count; i++)
        {
            var r = rows[i];
            var seq = i + 1;
            if (string.IsNullOrWhiteSpace(r.StandardGrade)) errors.Add($"行{seq}: 标准牌号不能为空");
            if (string.IsNullOrWhiteSpace(r.PlantGrade)) errors.Add($"行{seq}: 工厂牌号不能为空");
            if (r.Density <= 0) errors.Add($"行{seq}: 密度必须大于0");
        }
        if (errors.Any()) { Snackbar.Add(string.Join("；", errors), Severity.Warning); return; }

        isSubmitting = true; StateHasChanged();
        var successCount = 0;
        var failCount = 0;
        var failMessages = new List<string>();

        for (int i = 0; i < rows.Count; i++)
        {
            var r = rows[i];
            var request = new CreateGradeMappingRequest
            {
                StandardGrade = r.StandardGrade,
                PlantGrade = r.PlantGrade,
                Density = r.Density,
                SpecialMaterial = r.SpecialMaterial,
                HeatTreatment = r.HeatTreatment,
                SpecialNote = r.SpecialNote,
                Remark = r.Remark
            };

            try
            {
                var result = await GradeMappingService.CreateAsync(request);
                if (result.Success) successCount++;
                else { failCount++; failMessages.Add($"行{i + 1}: {result.Message}"); }
            }
            catch (Exception ex) { failCount++; failMessages.Add($"行{i + 1}: {ex.Message}"); }
        }

        isSubmitting = false; StateHasChanged();

        if (failCount == 0)
        {
            Snackbar.Add($"成功创建 {successCount} 条记录", Severity.Success);
            Navigation.NavigateTo("/grade-mappings");
        }
        else
        {
            Snackbar.Add($"成功 {successCount} 条，失败 {failCount} 条：{string.Join("；", failMessages)}", Severity.Error);
        }
    }

    private void GoBack() => Navigation.NavigateTo("/grade-mappings");
}
