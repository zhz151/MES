@using MudBlazor
@using MES.Shared.Constants

@page "/orders/progress"
@attribute [Authorize(Roles = Roles.Policies.OrderView)]
@inject IJSRuntime JS

@* 树本体已抽为 Shared/OrderProgressTree.razor（与首页「订单进度查询」卡共用）：
   本页只负责取数、页头（打印/返回）与打印样式；Compact=false → 保留原「非完结主号默认展开、完结主号默认折叠」行为。 *@
<MudContainer MaxWidth="MaxWidth.False" Class="mt-4 pl-0">
    <MudCard>
        <MudCardHeader>
            <CardHeaderContent>
                <MudText Typo="Typo.h5" Class="font-weight-bold">
                    <MudIcon Icon="@Icons.Material.Filled.AccountTree" Class="mr-2" Color="Color.Primary" />
                    订单进度树
                </MudText>
            </CardHeaderContent>
            <CardHeaderActions>
                @* 打印当前所见（保留折叠/展开状态，2026-09-14） *@
                <MudButton Variant="Variant.Outlined"
                           Color="Color.Primary"
                           Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.Print"
                           OnClick="OnPrintAsync"
                           Class="op-print-hide ml-2">
                    打印
                </MudButton>
                <MudButton Variant="Variant.Outlined"
                           Color="Color.Primary"
                           Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.ArrowBack"
                           OnClick="Back"
                           Class="op-print-hide ml-2">
                    返回订单列表
                </MudButton>
            </CardHeaderActions>
        </MudCardHeader>

        <MudCardContent>
            @if (_loading)
            {
                <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="mb-4" />
            }
            else if (string.IsNullOrWhiteSpace(_orderNo) || _tree == null)
            {
                <MudAlert Severity="Severity.Info" Variant="Variant.Text">未找到该订单的工单数据（请从订单列表行内「进度树」图标进入）。</MudAlert>
            }
            else
            {
                <OrderProgressTree Tree="_tree" />
            }

            @* 打印页脚（屏幕隐藏、仅打印可见；与项目其它打印同款「打印日期：yyyy-MM-dd」） *@
            <div class="op-print-footer">打印日期：@_printDate.ToString("yyyy-MM-dd")</div>
        </MudCardContent>
    </MudCard>
</MudContainer>

@* ===== 打印样式（就地打印 window.print，所见即所得：折叠状态的展开区本就不在 DOM 中） =====
   全局选择器（.mud-appbar/.mud-drawer/.mud-main-content）必须写在此处而非 scoped css —— 那些元素不属于本组件，
   Blazor scoped CSS 加 [b-xxx] 属性后匹配不到。
   ⚠️ .op-main-node / .op-print-footer 是普通类选择器（不带 scoped 属性），树本体虽已移入 OrderProgressTree 组件，
      本块仍能命中（类名保留、scope 属性只是附加）。 *@
<style>
    /* 打印页脚：屏幕隐藏，仅打印输出 */
    .op-print-footer { display: none; }

    @@media print {
        @@page { size: landscape; margin: 8mm; }

        .op-print-footer {
            display: block !important;
            margin-top: 10px;
            padding-top: 6px;
            border-top: 1px solid #999;
            font-size: 14px;
            color: #333;
        }

        /* 保留屏幕上的底色/字色（主号灰底、比率红字） */
        body { -webkit-print-color-adjust: exact; print-color-adjust: exact; }

        /* 隐藏全局布局（顶栏 / 左侧菜单）与操作按钮 */
        .mud-appbar,
        .mud-drawer { display: none !important; }
        .op-print-hide { display: none !important; }

        /* 内容区脱离 MudLayout 的 flex/滚动容器与 appbar 占位，否则多页内容只打印首屏 */
        .mud-layout {
            display: block !important;
            height: auto !important;
            min-height: 0 !important;
            overflow: visible !important;
        }
        .mud-main-content {
            margin-left: 0 !important;
            padding-top: 0 !important;
            overflow: visible !important;
            height: auto !important;
        }

        .mud-container { padding: 0 !important; }
        .mud-card { box-shadow: none !important; border: none !important; }

        /* 一个主号尽量不跨页撕开（内容超一页时浏览器自动忽略此约束） */
        .op-main-node { break-inside: avoid; }
    }
</style>
