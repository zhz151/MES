@page "/orders"
@using System.Text.Json
@using MES.Blazor.Helpers
@using MES.Blazor.Services
@using MES.Blazor.Models
@using MES.Core.Models
@using MES.Core.Enums
@using Microsoft.AspNetCore.Authorization
@using MES.Blazor.Shared
@using MES.Blazor.Components
@using MES.Core.DTOs.Order
@inject OrderService OrderService
@inject PageStateService PageState
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject IJSRuntime JS
@inject HttpClient Http
@inject ColumnPrefsService ColumnPrefs
@attribute [Authorize(Roles = Roles.Policies.OrderView)]

<MudContainer MaxWidth="MaxWidth.False" Class="mt-4 pl-0">
    <MudCard>
        <MudCardHeader>
            <CardHeaderContent>
                <MudText Typo="Typo.h5" Class="font-weight-bold">
                    <MudIcon Icon="@Icons.Material.Filled.Receipt" Class="mr-2" Color="Color.Primary" />
                    订单列表
                </MudText>
            </CardHeaderContent>
            <CardHeaderActions>
                <MudButton Variant="Variant.Outlined"
                           Size="Size.Small"
                           Color="@(_showEstimateCard ? Color.Primary : Color.Default)"
                           StartIcon="@(_showEstimateCard ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)"
                           OnClick="ToggleEstimateCard">
                    完成预估及延期风险
                </MudButton>
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Add"
                           OnClick="NavigateToCreate">
                    新建订单
                </MudButton>
            </CardHeaderActions>
        </MudCardHeader>

        <MudCardContent>
            <!-- 完成预估及延期风险卡片（默认折叠，标题栏按钮切换显隐；内仅展示两张交期预估小表：订单(整单)完成预估 / 风险-已延期订单(整单)） -->
            @if (_showEstimateCard)
            {
                <MudCard Class="mb-2 summary-card" Elevation="0">
                    <MudCardContent>
                        <MudText Typo="Typo.subtitle2" Class="mb-2"><b>完成预估及延期风险</b></MudText>
                        @if (_deliveryEstimate != null)
                        {
                            @for (var i = 0; i < _deliveryEstimate.Tables.Count; i++)
                            {
                                var tableIndex = i; // 捕获副本（for 循环变量被闭包共享，事件触发时读到结束值）
                                var estimateTable = _deliveryEstimate.Tables[i];
                                var tableId = $"order-delivery-estimate-{i}";
                                <div class="mt-3">
                                    <div class="d-flex justify-space-between align-center mb-1">
                                        <MudText Typo="Typo.body2"><b>@estimateTable.Name</b></MudText>
                                        <MudButton Variant="Variant.Text" Size="Size.Small" Color="Color.Primary"
                                                   StartIcon="@Icons.Material.Filled.Print"
                                                   OnClick="@(() => PrintDeliveryEstimate("#" + tableId, estimateTable.Name))">
                                            打印
                                        </MudButton>
                                    </div>
                                    <div id="@tableId" style="overflow-x:auto;">
                                    <table style="border-collapse: collapse; width: 100%; font-size: 0.8125rem;">
                                        <thead>
                                            <tr>
                                                <th style="text-align:left; padding:4px 10px; background:#f5f5f5; border:1px solid #e0e0e0;">交货日期范围</th>
                                                @foreach (var label in estimateTable.BucketLabels)
                                                {
                                                    <th style="padding:4px 10px; background:#f5f5f5; border:1px solid #e0e0e0; text-align:center;">@label</th>
                                                }
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <tr>
                                                <td style="padding:4px 10px; border:1px solid #e0e0e0; font-weight:600;">单数/重量/金额</td>
                                                @for (var bi = 0; bi < estimateTable.Buckets.Count; bi++)
                                                {
                                                    var bucketIndex = bi; // 捕获副本（for 循环变量被闭包共享，事件触发时读到结束值）
                                                    var bucket = estimateTable.Buckets[bi];
                                                    var isClickable = bucket.Count > 0 || bucket.Weight > 0;
                                                    var cellStyle = "padding:4px 10px; border:1px solid #e0e0e0; text-align:center;" + (isClickable ? " cursor:pointer;" : "");
                                                    <td class="@(isClickable ? "estimate-cell" : "")"
                                                        style="@cellStyle"
                                                        @onclick="() => OnEstimateBucketClick(tableIndex, bucketIndex)">
                                                        @FormatDeliveryBucket(bucket)
                                                    </td>
                                                }
                                            </tr>
                                        </tbody>
                                    </table>
                                    </div>
                                </div>
                            }
                            <MudText Typo="Typo.caption" Class="text-hint">
                                注：单元格 = 单数(蓝)/重量吨(绿)/金额万元(橙)，均取整显示，点击联动筛选订单。金额 = 桶内订单项次计价总价合计（未计价订单计 0）。
                            </MudText>
                        }
                        else
                        {
                            <MudText Typo="Typo.body2" Class="text-hint">正在加载...</MudText>
                        }
                    </MudCardContent>
                </MudCard>
            }

            <!-- 订单交期预估小表点击联动筛选提示条 -->
            @if (_estimateLinkFilter != null)
            {
                <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mb-2" Dense="true">
                    <div class="d-flex align-center justify-space-between" style="gap: 8px;">
                        <MudText Class="d-inline">已按「@_estimateLinkLabel」联动筛选订单列表（共 @_totalCount 条）</MudText>
                        <MudButton Variant="Variant.Text" Size="Size.Small" Color="Color.Primary" OnClick="ClearEstimateLinkFilter">
                            清除筛选
                        </MudButton>
                    </div>
                </MudAlert>
            }

            <!-- 筛选栏 -->
            <MudGrid>
                <MudItem xs="12" md="4">
                    <MudTextField T="string"
                                  Label="模糊搜索 - 订单号/客户/业务员/状态"
                                  Value="@_searchKeyword" ValueExpression="@(() => _searchKeyword)"
                                  ValueChanged="@OnSearchChanged"
                                  Immediate="true"
                                  DebounceInterval="500"
                                  Adornment="Adornment.End"
                                  AdornmentIcon="@Icons.Material.Filled.Search" />
                </MudItem>
                <MudItem xs="12" md="4">
                    <div style="display:flex; gap:8px;">
                        <MudTextField T="string"
                                      Label="签订日期从"
                                      Value="@_dateFrom"
                                      ValueChanged="@OnDateFromChanged"
                                      Placeholder="yyyy-MM-dd"
                                      Style="flex:1;min-width:0" />
                        <MudTextField T="string"
                                      Label="签订日期至"
                                      Value="@_dateTo"
                                      ValueChanged="@OnDateToChanged"
                                      Placeholder="yyyy-MM-dd"
                                      Style="flex:1;min-width:0" />
                    </div>
                </MudItem>
                <MudItem xs="12" md="4">
                    <div style="display:flex; gap:8px;">
                        <MudTextField T="string"
                                      Label="交货日期从"
                                      Value="@_deliveryDateFrom"
                                      ValueChanged="@OnDeliveryDateFromChanged"
                                      Placeholder="yyyy-MM-dd"
                                      Style="flex:1;min-width:0" />
                        <MudTextField T="string"
                                      Label="交货日期至"
                                      Value="@_deliveryDateTo"
                                      ValueChanged="@OnDeliveryDateToChanged"
                                      Placeholder="yyyy-MM-dd"
                                      Style="flex:1;min-width:0" />
                    </div>
                </MudItem>
            </MudGrid>

            <!-- 数据表格 -->
            <div id="orders-list-table">
            <!-- 工具栏 -->
            <div class="list-toolbar">
                <div class="d-flex align-center">
                    <ColumnDisplaySelect Columns="_allColumns"
                                         OnColumnToggle="OnColumnToggle"
                                         OnMoveUp="MoveColumnUp"
                                         OnMoveDown="MoveColumnDown" />
                    <MudButton Variant="Variant.Text" Size="Size.Small"
                               Color="Color.Default"
                               StartIcon="@Icons.Material.Filled.RestartAlt"
                               OnClick="ResetColumnDisplay" Class="ml-2">
                        重置
                    </MudButton>
                </div>
                <div class="d-flex align-center" style="margin-left:auto;">
                    <MudMenu Variant="Variant.Outlined"
                             Size="Size.Small"
                             Color="Color.Info"
                             StartIcon="@Icons.Material.Filled.Print"
                             Disabled="@(!selectedOrderIds.Any())"
                             Label="@($"打印选中订单 ({selectedOrderIds.Count})")">
                        <MudMenuItem OnClick="@(() => PrintSelected(true))">含金额确认单</MudMenuItem>
                        <MudMenuItem OnClick="@(() => PrintSelected(false))">不含金额确认单</MudMenuItem>
                    </MudMenu>
                    <MudButton Variant="Variant.Text"
                               Size="Size.Small"
                               Color="Color.Info"
                               StartIcon="@Icons.Material.Filled.Print"
                               Disabled="@(!selectedOrderIds.Any())"
                               OnClick="PrintSelectedList">
                        打印选中列表
                    </MudButton>
                    <MudText Typo="Typo.body2" Class="ml-4">
                        共 @_totalCount 条记录
                    </MudText>
                </div>
            </div>
            @* 分组标题栏 *@
            <div class="col-group-header-scroll">
                <div class="col-group-header-bar" style="width: @(_totalTableWidth)px">
                    @foreach (var gh in _groupHeaders)
                    {
                        <div class="col-group-header-item @gh.CssClass" style="width: @(gh.TotalWidth)px">
                            <span class="col-group-badge">@gh.GroupName</span>
                        </div>
                    }
                </div>
            </div>
            <MudTable @ref="table"
                      T="SalesOrderListDto"
                      ServerData="@LoadDataFromServer"
                      Dense="true"
                      Hover="true"
                      Class="mt-0 auto-table"
                      Elevation="0"
                      RowsPerPage="@_pageSize"
                      RowsPerPageLabel="每页行数:">
                <HeaderContent>
                    @{
                        int? _prevGk = null;
                    }
                    <MudTh Class="col-selection-th">
                        <MudCheckBox T="bool"
                                     Value="@(_pageItems.Count > 0 && _pageItems.All(i => selectedOrderIds.Contains(i.Id)))"
                                     ValueChanged="@(v => { if(v) { foreach(var item in _pageItems) selectedOrderIds.Add(item.Id); } else { selectedOrderIds.Clear(); } StateHasChanged(); })"
                                     Dense="true" />
                    </MudTh>
                    @foreach (var col in _visibleColumns)
                    {
                        var _isGroupStart = col.GroupKey.HasValue && col.GroupKey != _prevGk;
                        _prevGk = col.GroupKey;
                        var _headerClass = GetHeaderGroupCss(col.GroupKey, _isGroupStart);
                        <MudTh Class="@_headerClass" Style="@($"width:{col.Width}px")">
                            <div style="display:inline-flex; align-items:center; gap:4px;">
                                <span @onclick='() => ToggleSort(col.Key)' style="cursor:pointer" class="th-label">@col.Label @if (sortColumn == col.Key) {@(sortDescending ? " ▼" : " ▲")}</span>
                                @if (col.FilterType != null)
                                {
                                    <ExcelFilter T="SalesOrderListDto"
                                                 Label="@col.Label"
                                                 FieldKey="@col.Key"
                                                 FilterOptions="@(_filterContextOptions.GetValueOrDefault(col.Key))"
                                                 ActiveFilterValues="@(_columnFilters.GetValueOrDefault(col.Key))"
                                                 FilterChanged="@(args => OnColumnFilterChanged(args.fieldKey, args.selectedValues))" />

                                }
                            </div>
                        </MudTh>
                    }
                    <MudTh Style="width:150px;">操作</MudTh>
                </HeaderContent>
                <RowTemplate Context="order">
                    @{
                        int? _prevGk2 = null;
                    }
                    <MudTd Class="col-selection-td">
                        <MudCheckBox T="bool"
                                     Value="@selectedOrderIds.Contains(order.Id)"
                                     ValueChanged="@((v) => { if(v) selectedOrderIds.Add(order.Id); else selectedOrderIds.Remove(order.Id); StateHasChanged(); })"
                                     Dense="true" />
                    </MudTd>
                    @foreach (var col in _visibleColumns)
                    {
                        var _isGroupStart2 = col.GroupKey.HasValue && col.GroupKey != _prevGk2;
                        _prevGk2 = col.GroupKey;
                        var _cellClass = GetCellGroupCss(col.GroupKey, _isGroupStart2);
                        var _cellAlignClass = IsNumericColumn(col) ? " text-center" : "";
                        <MudTd Class="@(_cellClass + _cellAlignClass)">@RenderCell(order, col)</MudTd>
                    }
                    <MudTd>
                        @if (order.Status == SalesOrderStatus.Pending)
                        {
                            <AuthorizeView Roles="@Roles.Policies.OrderEdit">
                                <MudIconButton Icon="@Icons.Material.Filled.CheckCircle"
                                               Color="Color.Success"
                                               Size="Size.Small"
                                               OnClick="() => ConfirmOrder(order)"
                                               Title="确认订单" />
                            </AuthorizeView>
                        }

                        <MudIconButton Icon="@Icons.Material.Filled.AccountTree"
                                       Color="Color.Primary"
                                       Size="Size.Small"
                                       OnClick="() => NavigateToProgress(order.OrderNumber)"
                                       Title="订单进度树" />

                        <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                       Color="Color.Warning"
                                       Size="Size.Small"
                                       OnClick="() => EditOrder(order.Id)"
                                       Title="编辑" />

                        <AuthorizeView Roles="@Roles.Policies.OrderEdit">
                            <MudIconButton Icon="@Icons.Material.Filled.Cancel"
                                           Color="Color.Error"
                                           Size="Size.Small"
                                           OnClick="() => CancelOrder(order)"
                                           Title="取消订单" />
                        </AuthorizeView>
                    </MudTd>
                </RowTemplate>
                <FooterContent>
                    @{
                        int? _prevGk3 = null;
                    }
                    <MudTd Style="width:40px;min-width:40px;max-width:40px;"></MudTd>
                    @foreach (var col in _visibleColumns)
                    {
                        var _isGroupStart3 = col.GroupKey.HasValue && col.GroupKey != _prevGk3;
                        _prevGk3 = col.GroupKey;
                        var _footerClass = GetCellGroupCss(col.GroupKey, _isGroupStart3) + " col-footer-cell";
                        var _footerAlignClass = IsNumericColumn(col) ? " text-center" : "";
                        <MudTd Class="@(_footerClass + _footerAlignClass)"><span class="col-footer-sum">@RenderFooterCell(col)</span></MudTd>
                    }
                    <MudTd Class="col-footer-cell"></MudTd>
                </FooterContent>
                <PagerContent>
                    <MudTablePager PageSizeOptions="new int[]{10,15,25,50,100}" />
                </PagerContent>
            </MudTable>
            </div>
        </MudCardContent>
    </MudCard>
</MudContainer>

