@page "/orders/{orderId:int}/requirements"
@using MES.Blazor.Services
@using MES.Blazor.Helpers
@using MES.Core.DTOs
@using MES.Core.Enums
@using Microsoft.AspNetCore.Authorization
@inject ProductRequirementService RequirementService
@inject OrderService OrderService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject IJSRuntime JS
@inject ColumnPrefsService ColumnPrefs
@attribute [Authorize(Roles = "OrderStaff,OrderDirector,Admin")]

<MudContainer MaxWidth="MaxWidth.False" Class="mt-4 pl-0">
    @if (_isLoading)
    {
        <MudProgressCircular Indeterminate Size="Size.Large" Class="d-flex justify-center ma-8" />
    }
    else if (!string.IsNullOrEmpty(_loadErrorMessage))
    {
        <MudPaper Class="pa-4 mb-4" Elevation="0" Style="border:1px solid var(--mud-palette-lines-default); border-radius:8px;">
            <MudText Typo="Typo.body2" Color="Color.Error"><strong>加载失败：</strong>@_loadErrorMessage</MudText>
            <div class="mt-3">
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="GoBack">返回</MudButton>
            </div>
        </MudPaper>
    }
    else
    {
        <MudCard>
            <MudCardHeader>
                <CardHeaderContent>
                    <MudText Typo="Typo.h5" Class="font-weight-bold">
                        <MudIcon Icon="@Icons.Material.Filled.Description" Class="mr-2" Color="Color.Primary" />
                        技术要求
                    </MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">订单号：@_orderNumber</MudText>
                    @if (_orderStatus == SalesOrderStatus.Cancelled)
                    {
                        <MudChip Size="Size.Small" Color="Color.Error" Class="ml-2">已取消</MudChip>
                    }
                </CardHeaderContent>
                <CardHeaderActions>
                    <MudButton Variant="Variant.Text" OnClick="GoBack">返回</MudButton>
                    @if (!_isEditMode)
                    {
                        <MudButton Variant="Variant.Outlined" Color="Color.Info"
                                   StartIcon="@Icons.Material.Filled.Print"
                                   OnClick="PrintRequirements">
                            打印
                        </MudButton>
                    }
                    @if (_isEditMode)
                    {
                        @if (_orderStatus != SalesOrderStatus.Cancelled)
                        {
                            <MudButton Variant="Variant.Text" Color="Color.Default" OnClick="CancelEdit">取消</MudButton>
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAllRequirements" Loading="@_isSubmitting">
                                保存修改
                            </MudButton>
                        }
                        else
                        {
                            @* 已取消的订单无法编辑 *@
                        }
                    }
                    else
                    {
                        @if (_orderStatus != SalesOrderStatus.Cancelled)
                        {
                            <AuthorizeView Roles="OrderDirector,Admin">
                                <MudButton Variant="Variant.Outlined" Color="Color.Warning" OnClick="EnterEditMode">编辑技术要求</MudButton>
                            </AuthorizeView>
                        }
                    }
                </CardHeaderActions>
            </MudCardHeader>

            <MudCardContent>
                <div class="d-flex align-center mb-2">
                    <MudText Typo="Typo.subtitle1" Class="font-weight-bold">
                        <MudIcon Icon="@Icons.Material.Filled.ListAlt" Size="Size.Small" Class="mr-1" />项次技术要求
                    </MudText>
                    <ColumnDisplaySelect Columns="@_allColumns"
                                         OnColumnToggle="@OnColumnToggle"
                                         OnMoveUp="@OnMoveUp"
                                         OnMoveDown="@OnMoveDown" />
                </div>

                <div id="product-requirement-table">
                <div style="overflow-x: auto;">
                    <MudTable Items="@(_isEditMode ? _editItems : _viewItems)"
                              Dense="true"
                              Hover="true"
                              Elevation="0"
                              RowsPerPage="10"
                              RowsPerPageLabel="每页行数:"
                              Class="auto-table">
                        <HeaderContent>
                            @foreach (var col in _visibleColumns)
                            {
                                <MudTh>
                                    @col.Label
                                </MudTh>
                            }
                        </HeaderContent>
                        <RowTemplate Context="item">
                            @foreach (var col in _visibleColumns)
                            {
                                <MudTd>@RenderCell(item, col)</MudTd>
                            }
                        </RowTemplate>
                    </MudTable>
                </div>

                </div>
            </MudCardContent>
        </MudCard>
    }
</MudContainer>

@code {
    [Parameter] public int orderId { get; set; }

    // ========== 状态 ==========
    private string _orderNumber = string.Empty;
    private SalesOrderStatus _orderStatus = SalesOrderStatus.Pending;
    private bool _isLoading = true;
    private bool _isEditMode;
    private bool _isSubmitting;
    private string _loadErrorMessage = string.Empty;
    private bool _isArrowNavSetup;

    // ========== 数据 ==========
    private List<OrderItemRequirement> _viewItems = new();
    private List<OrderItemRequirement> _editItems = new();

    /// <summary>
    /// 项次技术要求视图模型
    /// </summary>
    private class OrderItemRequirement
    {
        public int OrderItemId { get; set; }
        public int Sequence { get; set; }
        public bool HasExisting { get; set; }
        public RequirementType RequirementType { get; set; } = RequirementType.Normal;
        public string? ChemicalComposition { get; set; }
        public string? MechanicalProperty { get; set; }
        public string? ToleranceRequirement { get; set; }
        public string? SurfaceQuality { get; set; }
        public string? NdtRequirement { get; set; }
        public string? OtherRequirement { get; set; }
        public DateTimeOffset CreatedTime { get; set; }
        public DateTimeOffset UpdatedTime { get; set; }
    }

    // ========== 列定义 ==========
    private List<ColumnDef> _allColumns = new();
    private List<ColumnDef> _visibleColumns => _allColumns.Where(c => c.Visible).ToList();
    private const string ColumnPrefsKey = "requirement_detail";

    // ========== 初始化 ==========
    protected override async Task OnInitializedAsync()
    {
        InitColumns();
        await LoadColumnPrefs();
        await LoadData();
    }

    private void InitColumns()
    {
        _allColumns = new List<ColumnDef>
        {
            new() { Key = "sequence", Label = "项次", Visible = true },
            new() { Key = "requirementtype", Label = "要求类型", Visible = true },
            new() { Key = "chemicalcomposition", Label = "化学成分", Visible = true },
            new() { Key = "mechanicalproperty", Label = "机械性能", Visible = true },
            new() { Key = "tolerancerequirement", Label = "尺寸公差", Visible = true },
            new() { Key = "surfacequality", Label = "表面质量", Visible = true },
            new() { Key = "ndtreq", Label = "无损检测", Visible = true },
            new() { Key = "otherrequirement", Label = "其他要求", Visible = true },
            new() { Key = "createdtime", Label = "创建时间", Visible = false },
            new() { Key = "updatedtime", Label = "更新时间", Visible = false },
        };
    }

    // ========== 列偏好持久化 ==========
    private async Task LoadColumnPrefs()
    {
        var saved = await ColumnPrefs.LoadAsync(ColumnPrefsKey, null);
        if (saved.Count > 0) ApplyColumnPrefs(_allColumns, saved);
    }

    private static void ApplyColumnPrefs(List<ColumnDef> target, List<ColumnDef> saved)
    {
        var savedByKey = saved.ToDictionary(s => s.Key, s => s);
        foreach (var t in target)
        {
            if (savedByKey.TryGetValue(t.Key, out var pref))
                t.Visible = pref.Visible;
        }
        var savedKeys = saved.Select(s => s.Key).ToHashSet();
        var merged = saved
            .Select(s => target.FirstOrDefault(t => t.Key == s.Key))
            .Where(t => t != null)
            .Cast<ColumnDef>()
            .Concat(target.Where(t => !savedKeys.Contains(t.Key)))
            .ToList();
        if (merged.Count == target.Count)
        {
            for (int i = 0; i < target.Count; i++) target[i] = merged[i];
        }
    }

    private async Task SaveColumnPrefs() => await ColumnPrefs.SaveAsync(ColumnPrefsKey, null, _allColumns);
    private async Task OnColumnToggle(ColumnDef col) => await SaveColumnPrefs();
    private async Task OnMoveUp(ColumnDef col) => await SaveColumnPrefs();
    private async Task OnMoveDown(ColumnDef col) => await SaveColumnPrefs();

    // ========== 数据加载 ==========
    private async Task LoadData()
    {
        if (orderId <= 0)
        {
            Snackbar.Add("无效的订单ID", Severity.Error);
            _isLoading = false;
            return;
        }
        _isLoading = true;
        StateHasChanged();
        try
        {
            var orderResult = await OrderService.GetByIdAsync(orderId);
            if (orderResult.Success && orderResult.Data != null)
            {
                _orderNumber = orderResult.Data.OrderNumber;
                _orderStatus = orderResult.Data.Status;
            }
            else
            {
                _loadErrorMessage = orderResult.Message ?? "无法获取订单信息";
                return;
            }

            var allItems = orderResult.Data?.Items ?? new List<OrderItemDto>();

            var reqResult = await RequirementService.GetByOrderIdAsync(orderId);
            var existingReqs = new Dictionary<int, ProductRequirementDto>();
            if (reqResult.Success && reqResult.Data != null)
            {
                foreach (var req in reqResult.Data)
                {
                    existingReqs[req.OrderItemId] = req;
                }
            }

            var viewList = allItems.OrderBy(i => i.Sequence).Select(i =>
            {
                existingReqs.TryGetValue(i.Id, out var req);
                return new OrderItemRequirement
                {
                    OrderItemId = i.Id,
                    Sequence = i.Sequence,
                    HasExisting = req != null,
                    RequirementType = req?.RequirementType ?? RequirementType.Normal,
                    ChemicalComposition = req?.ChemicalComposition,
                    MechanicalProperty = req?.MechanicalProperty,
                    ToleranceRequirement = req?.ToleranceRequirement,
                    SurfaceQuality = req?.SurfaceQuality,
                    NdtRequirement = req?.NdtRequirement,
                    OtherRequirement = req?.OtherRequirement,
                    CreatedTime = req?.CreatedTime ?? DateTimeOffset.MinValue,
                    UpdatedTime = req?.UpdatedTime ?? DateTimeOffset.MinValue
                };
            }).ToList();

            _viewItems = viewList.Select(v => new OrderItemRequirement
            {
                OrderItemId = v.OrderItemId,
                Sequence = v.Sequence,
                HasExisting = v.HasExisting,
                RequirementType = v.RequirementType,
                ChemicalComposition = v.ChemicalComposition,
                MechanicalProperty = v.MechanicalProperty,
                ToleranceRequirement = v.ToleranceRequirement,
                SurfaceQuality = v.SurfaceQuality,
                NdtRequirement = v.NdtRequirement,
                OtherRequirement = v.OtherRequirement,
                CreatedTime = v.CreatedTime,
                UpdatedTime = v.UpdatedTime
            }).ToList();

            _editItems = viewList.Select(v => new OrderItemRequirement
            {
                OrderItemId = v.OrderItemId,
                Sequence = v.Sequence,
                HasExisting = v.HasExisting,
                RequirementType = v.RequirementType,
                ChemicalComposition = v.ChemicalComposition,
                MechanicalProperty = v.MechanicalProperty,
                ToleranceRequirement = v.ToleranceRequirement,
                SurfaceQuality = v.SurfaceQuality,
                NdtRequirement = v.NdtRequirement,
                OtherRequirement = v.OtherRequirement,
                CreatedTime = v.CreatedTime,
                UpdatedTime = v.UpdatedTime
            }).ToList();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"加载失败: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    // ========== 编辑模式 ==========
    private void EnterEditMode()
    {
        if (_orderStatus == SalesOrderStatus.Cancelled)
        {
            Snackbar.Add("已取消的订单无法编辑技术要求", Severity.Warning);
            return;
        }
        _isEditMode = true;
    }

    private Task CancelEdit()
    {
        _isEditMode = false;
        // 重置编辑数据
        _editItems = _viewItems.Select(v => new OrderItemRequirement
        {
            OrderItemId = v.OrderItemId,
            Sequence = v.Sequence,
            HasExisting = v.HasExisting,
            RequirementType = v.RequirementType,
            ChemicalComposition = v.ChemicalComposition,
            MechanicalProperty = v.MechanicalProperty,
            ToleranceRequirement = v.ToleranceRequirement,
            SurfaceQuality = v.SurfaceQuality,
            NdtRequirement = v.NdtRequirement,
            OtherRequirement = v.OtherRequirement,
            CreatedTime = v.CreatedTime,
            UpdatedTime = v.UpdatedTime
        }).ToList();
        StateHasChanged();
        return Task.CompletedTask;
    }

    // ========== 保存 ==========
    private async Task SaveAllRequirements()
    {
        if (_orderStatus == SalesOrderStatus.Cancelled)
        {
            Snackbar.Add("已取消的订单无法保存技术要求", Severity.Warning);
            return;
        }

        _isSubmitting = true;
        StateHasChanged();

        try
        {
            var savedCount = 0;

            foreach (var item in _editItems)
            {
                var request = new CreateProductRequirementRequest
                {
                    RequirementType = item.RequirementType,
                    ChemicalComposition = item.ChemicalComposition,
                    MechanicalProperty = item.MechanicalProperty,
                    ToleranceRequirement = item.ToleranceRequirement,
                    SurfaceQuality = item.SurfaceQuality,
                    NdtRequirement = item.NdtRequirement,
                    OtherRequirement = item.OtherRequirement
                };

                var result = await RequirementService.CreateOrUpdateAsync(orderId, item.OrderItemId, request);
                if (result.Success)
                {
                    savedCount++;
                }
                else
                {
                    Snackbar.Add($"保存项次 {item.Sequence} 技术要求失败: {result.Message}", Severity.Error);
                    return;
                }
            }

            Snackbar.Add($"保存成功，已保存 {savedCount} 个项次的技术要求", Severity.Success);
            _isEditMode = false;
            await LoadData();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"保存失败: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isSubmitting = false;
            StateHasChanged();
        }
    }

    // ========== 导航 ==========

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_isArrowNavSetup)
        {
            _isArrowNavSetup = true;
            if (!await JS.InvokeAsync<bool>("enableTableArrowNav", "#product-requirement-table"))
                _isArrowNavSetup = false;
        }
    }

    private void GoBack() => Navigation.NavigateTo($"/orders/{orderId}");

    private async Task PrintRequirements()
    {
        try
        {
            var result = await OrderService.PrintOrderRequirementsAsync(orderId);
            if (result.Success && result.Data != null)
                await JS.InvokeVoidAsync("openPdf", result.Data);
            else
                Snackbar.Add(result.Message ?? "打印失败", Severity.Error);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"打印失败: {ex.Message}", Severity.Error);
        }
    }

    // ========== 辅助方法 ==========
    private string GetRequirementTypeText(RequirementType type) => DisplayHelper.GetRequirementTypeText(type);

    private string FormatDateTime(DateTimeOffset dt)
    {
        return dt == DateTimeOffset.MinValue ? "-" : dt.LocalDateTime.ToString("yyyy-MM-dd HH:mm");
    }

    // ========== 渲染方法 ==========
    private RenderFragment RenderCell(OrderItemRequirement item, ColumnDef col) => builder =>
    {
        switch (col.Key)
        {
            case "sequence":
                builder.AddContent(0, item.Sequence.ToString());
                break;
            case "requirementtype":
                if (_isEditMode && _orderStatus != SalesOrderStatus.Cancelled)
                {
                    builder.OpenComponent<MudSelect<RequirementType>>(0);
                    builder.AddAttribute(1, "Value", item.RequirementType);
                    builder.AddAttribute(2, "ValueChanged", EventCallback.Factory.Create<RequirementType>(this, v => item.RequirementType = v));
                    builder.AddAttribute(3, "Dense", true);
                    builder.AddAttribute(4, "Variant", Variant.Outlined);
                    builder.AddAttribute(5, "Size", Size.Small);
                    builder.AddAttribute(6, "ChildContent", (RenderFragment)(cb =>
                    {
                        cb.OpenComponent<MudSelectItem<RequirementType>>(0);
                        cb.AddAttribute(1, "Value", RequirementType.Normal);
                        cb.AddAttribute(2, "ChildContent", (RenderFragment)(b => b.AddContent(0, "常规")));
                        cb.CloseComponent();
                        cb.OpenComponent<MudSelectItem<RequirementType>>(0);
                        cb.AddAttribute(1, "Value", RequirementType.Special);
                        cb.AddAttribute(2, "ChildContent", (RenderFragment)(b => b.AddContent(0, "特殊")));
                        cb.CloseComponent();
                    }));
                    builder.CloseComponent();
                }
                else { builder.AddContent(0, GetRequirementTypeText(item.RequirementType)); }
                break;
            case "chemicalcomposition":
                if (_isEditMode && _orderStatus != SalesOrderStatus.Cancelled)
                {
                    builder.OpenComponent<MudTextField<string>>(0);
                    builder.AddAttribute(1, "Value", item.ChemicalComposition);
                    builder.AddAttribute(2, "ValueChanged", EventCallback.Factory.Create<string>(this, v => item.ChemicalComposition = v));
                    builder.AddAttribute(3, "Dense", true);
                    builder.AddAttribute(4, "Variant", Variant.Outlined);
                    builder.AddAttribute(5, "Size", Size.Small);
                    builder.AddAttribute(6, "FullWidth", true);
                    builder.CloseComponent();
                }
                else { builder.AddContent(0, item.ChemicalComposition); }
                break;
            case "mechanicalproperty":
                if (_isEditMode && _orderStatus != SalesOrderStatus.Cancelled)
                {
                    builder.OpenComponent<MudTextField<string>>(0);
                    builder.AddAttribute(1, "Value", item.MechanicalProperty);
                    builder.AddAttribute(2, "ValueChanged", EventCallback.Factory.Create<string>(this, v => item.MechanicalProperty = v));
                    builder.AddAttribute(3, "Dense", true);
                    builder.AddAttribute(4, "Variant", Variant.Outlined);
                    builder.AddAttribute(5, "Size", Size.Small);
                    builder.AddAttribute(6, "FullWidth", true);
                    builder.CloseComponent();
                }
                else { builder.AddContent(0, item.MechanicalProperty); }
                break;
            case "tolerancerequirement":
                if (_isEditMode && _orderStatus != SalesOrderStatus.Cancelled)
                {
                    builder.OpenComponent<MudTextField<string>>(0);
                    builder.AddAttribute(1, "Value", item.ToleranceRequirement);
                    builder.AddAttribute(2, "ValueChanged", EventCallback.Factory.Create<string>(this, v => item.ToleranceRequirement = v));
                    builder.AddAttribute(3, "Dense", true);
                    builder.AddAttribute(4, "Variant", Variant.Outlined);
                    builder.AddAttribute(5, "Size", Size.Small);
                    builder.AddAttribute(6, "FullWidth", true);
                    builder.CloseComponent();
                }
                else { builder.AddContent(0, item.ToleranceRequirement); }
                break;
            case "surfacequality":
                if (_isEditMode && _orderStatus != SalesOrderStatus.Cancelled)
                {
                    builder.OpenComponent<MudTextField<string>>(0);
                    builder.AddAttribute(1, "Value", item.SurfaceQuality);
                    builder.AddAttribute(2, "ValueChanged", EventCallback.Factory.Create<string>(this, v => item.SurfaceQuality = v));
                    builder.AddAttribute(3, "Dense", true);
                    builder.AddAttribute(4, "Variant", Variant.Outlined);
                    builder.AddAttribute(5, "Size", Size.Small);
                    builder.AddAttribute(6, "FullWidth", true);
                    builder.CloseComponent();
                }
                else { builder.AddContent(0, item.SurfaceQuality); }
                break;
            case "ndtreq":
                if (_isEditMode && _orderStatus != SalesOrderStatus.Cancelled)
                {
                    builder.OpenComponent<MudTextField<string>>(0);
                    builder.AddAttribute(1, "Value", item.NdtRequirement);
                    builder.AddAttribute(2, "ValueChanged", EventCallback.Factory.Create<string>(this, v => item.NdtRequirement = v));
                    builder.AddAttribute(3, "Dense", true);
                    builder.AddAttribute(4, "Variant", Variant.Outlined);
                    builder.AddAttribute(5, "Size", Size.Small);
                    builder.AddAttribute(6, "FullWidth", true);
                    builder.CloseComponent();
                }
                else { builder.AddContent(0, item.NdtRequirement); }
                break;
            case "otherrequirement":
                if (_isEditMode && _orderStatus != SalesOrderStatus.Cancelled)
                {
                    builder.OpenComponent<MudTextField<string>>(0);
                    builder.AddAttribute(1, "Value", item.OtherRequirement);
                    builder.AddAttribute(2, "ValueChanged", EventCallback.Factory.Create<string>(this, v => item.OtherRequirement = v));
                    builder.AddAttribute(3, "Dense", true);
                    builder.AddAttribute(4, "Variant", Variant.Outlined);
                    builder.AddAttribute(5, "Size", Size.Small);
                    builder.AddAttribute(6, "FullWidth", true);
                    builder.CloseComponent();
                }
                else { builder.AddContent(0, item.OtherRequirement); }
                break;
            case "createdtime":
                builder.AddContent(0, FormatDateTime(item.CreatedTime));
                break;
            case "updatedtime":
                builder.AddContent(0, FormatDateTime(item.UpdatedTime));
                break;
        }
    };
}
