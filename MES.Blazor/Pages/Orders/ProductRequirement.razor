    // ========== 列偏好持久化 ==========
    private async Task LoadColumnPrefs()
    {
        var saved = await ColumnPrefs.LoadAsync(ColumnPrefsKey, null);
        if (saved.Count > 0) ApplyColumnPrefs(_allColumns, saved);
    }

    private static void ApplyColumnPrefs(List<ColumnDef> target, List<ColumnDef> saved)
    {
        var savedByKey = saved.ToDictionary(s => s.Key, s => s);
        foreach (var t in target)
        {
            if (savedByKey.TryGetValue(t.Key, out var pref))
                t.Visible = pref.Visible;
        }
        var savedKeys = saved.Select(s => s.Key).ToHashSet();
        var merged = saved
            .Select(s => target.FirstOrDefault(t => t.Key == s.Key))
            .Where(t => t != null)
            .Cast<ColumnDef>()
            .Concat(target.Where(t => !savedKeys.Contains(t.Key)))
            .ToList();
        if (merged.Count == target.Count)
        {
            for (int i = 0; i < target.Count; i++) target[i] = merged[i];
        }
    }

    private async Task SaveColumnPrefs() => await ColumnPrefs.SaveAsync(ColumnPrefsKey, null, _allColumns);
    private async Task OnColumnToggle(ColumnDef col) => await SaveColumnPrefs();
    private async Task OnMoveUp(ColumnDef col) => await SaveColumnPrefs();
    private async Task OnMoveDown(ColumnDef col) => await SaveColumnPrefs();

    // ========== 数据加载 ==========
    private async Task LoadData()
    {
        if (orderId <= 0)
        {
            Snackbar.Add("无效的订单ID", Severity.Error);
            _isLoading = false;
            return;
        }
        _isLoading = true;
        StateHasChanged();
        try
        {
            var orderResult = await OrderService.GetByIdAsync(orderId);
            if (orderResult.Success && orderResult.Data != null)
            {
                _orderNumber = orderResult.Data.OrderNumber;
                _orderStatus = orderResult.Data.Status;
            }
            else
            {
                _loadErrorMessage = orderResult.Message ?? "无法获取订单信息";
                return;
            }

            var allItems = orderResult.Data?.Items ?? new List<OrderItemDto>();

            var reqResult = await RequirementService.GetByOrderIdAsync(orderId);
            var existingReqs = new Dictionary<int, ProductRequirementDto>();
            if (reqResult.Success && reqResult.Data != null)
            {
                foreach (var req in reqResult.Data)
                {
                    existingReqs[req.OrderItemId] = req;
                }
            }

            var viewList = allItems.OrderBy(i => i.Sequence).Select(i =>
            {
                existingReqs.TryGetValue(i.Id, out var req);
                return new OrderItemRequirement
                {
                    OrderItemId = i.Id,
                    Sequence = i.Sequence,
                    HasExisting = req != null,
                    StandardNo = i.StandardNo,
                    DeliveryState = i.DeliveryState,
                    StandardGrade = i.StandardGrade,
                    OuterDiameter = i.OuterDiameter,
                    WallThickness = i.WallThickness,
                    LengthStatus = i.LengthStatus,
                    Quantity = i.Quantity,
                    ContractWeight = i.ContractWeight,
                    RequirementType = req?.RequirementType ?? RequirementType.Normal,
                    ChemicalComposition = req?.ChemicalComposition ?? false,
                    PmiInspection = req?.PmiInspection ?? InspectionRequirementStage.FinalOnly,
                    SurfaceInspection = req?.SurfaceInspection ?? InspectionRequirementStage.FinalOnly,
                    Dimension = req?.Dimension ?? InspectionRequirementStage.FinalOnly,
                    Endoscopy = req?.Endoscopy ?? InspectionRequirementStage.FinalOnly,
                    HydrostaticTest = req?.HydrostaticTest ?? InspectionRequirementStage.FinalOnly,
                    UnderwaterPressure = req?.UnderwaterPressure ?? InspectionRequirementStage.FinalOnly,
                    EddyCurrent = req?.EddyCurrent ?? InspectionRequirementStage.FinalOnly,
                    UltrasonicTest = req?.UltrasonicTest ?? InspectionRequirementStage.FinalOnly,
                    PortColoring = req?.PortColoring ?? InspectionRequirementStage.FinalOnly,
                    RadiographicTest = req?.RadiographicTest ?? InspectionRequirementStage.FinalOnly,
                    HardnessRockwell = req?.HardnessRockwell ?? false,
                    HardnessBrinell = req?.HardnessBrinell ?? false,
                    HardnessVickers = req?.HardnessVickers ?? false,
                    TensileRoomTemp = req?.TensileRoomTemp ?? false,
                    TensileHighTemp = req?.TensileHighTemp ?? false,
                    WeldJointTensile = req?.WeldJointTensile ?? false,
                    ImpactTest = req?.ImpactTest ?? false,
                    WeldJointImpact = req?.WeldJointImpact ?? false,
                    FlatteningTest = req?.FlatteningTest ?? false,
                    FlaringTest = req?.FlaringTest ?? false,
                    ExpandingTest = req?.ExpandingTest ?? false,
                    BendTest = req?.BendTest ?? false,
                    WeldJointBend = req?.WeldJointBend ?? false,
                    GrainSize = req?.GrainSize ?? false,
                    IntergranularCorrosion = req?.IntergranularCorrosion ?? false,
                    PittingCorrosion = req?.PittingCorrosion ?? false,
                    FerriteContent = req?.FerriteContent ?? false,
                    Macrostructure = req?.Macrostructure ?? false,
                    OtherRequirement = req?.OtherRequirement,
                    CreatedTime = req?.CreatedTime ?? DateTimeOffset.MinValue,
                    UpdatedTime = req?.UpdatedTime ?? DateTimeOffset.MinValue
                };
            }).ToList();

            _viewItems = viewList.Select(v => new OrderItemRequirement
            {
                OrderItemId = v.OrderItemId,
                Sequence = v.Sequence,
                HasExisting = v.HasExisting,
                StandardNo = v.StandardNo,
                DeliveryState = v.DeliveryState,
                StandardGrade = v.StandardGrade,
                OuterDiameter = v.OuterDiameter,
                WallThickness = v.WallThickness,
                LengthStatus = v.LengthStatus,
                Quantity = v.Quantity,
                ContractWeight = v.ContractWeight,
                RequirementType = v.RequirementType,
                ChemicalComposition = v.ChemicalComposition,
                PmiInspection = v.PmiInspection,
                SurfaceInspection = v.SurfaceInspection,
                Dimension = v.Dimension,
                Endoscopy = v.Endoscopy,
                HydrostaticTest = v.HydrostaticTest,
                UnderwaterPressure = v.UnderwaterPressure,
                EddyCurrent = v.EddyCurrent,
                UltrasonicTest = v.UltrasonicTest,
                PortColoring = v.PortColoring,
                RadiographicTest = v.RadiographicTest,
                HardnessRockwell = v.HardnessRockwell,
                HardnessBrinell = v.HardnessBrinell,
                HardnessVickers = v.HardnessVickers,
                TensileRoomTemp = v.TensileRoomTemp,
                TensileHighTemp = v.TensileHighTemp,
                WeldJointTensile = v.WeldJointTensile,
                ImpactTest = v.ImpactTest,
                WeldJointImpact = v.WeldJointImpact,
                FlatteningTest = v.FlatteningTest,
                FlaringTest = v.FlaringTest,
                ExpandingTest = v.ExpandingTest,
                BendTest = v.BendTest,
                WeldJointBend = v.WeldJointBend,
                GrainSize = v.GrainSize,
                IntergranularCorrosion = v.IntergranularCorrosion,
                PittingCorrosion = v.PittingCorrosion,
                FerriteContent = v.FerriteContent,
                Macrostructure = v.Macrostructure,
                OtherRequirement = v.OtherRequirement,
                CreatedTime = v.CreatedTime,
                UpdatedTime = v.UpdatedTime
            }).ToList();

            _editItems = viewList.Select(v => new OrderItemRequirement
            {
                OrderItemId = v.OrderItemId,
                Sequence = v.Sequence,
                HasExisting = v.HasExisting,
                StandardNo = v.StandardNo,
                DeliveryState = v.DeliveryState,
                StandardGrade = v.StandardGrade,
                OuterDiameter = v.OuterDiameter,
                WallThickness = v.WallThickness,
                LengthStatus = v.LengthStatus,
                Quantity = v.Quantity,
                ContractWeight = v.ContractWeight,
                RequirementType = v.RequirementType,
                ChemicalComposition = v.ChemicalComposition,
                PmiInspection = v.PmiInspection,
                SurfaceInspection = v.SurfaceInspection,
                Dimension = v.Dimension,
                Endoscopy = v.Endoscopy,
                HydrostaticTest = v.HydrostaticTest,
                UnderwaterPressure = v.UnderwaterPressure,
                EddyCurrent = v.EddyCurrent,
                UltrasonicTest = v.UltrasonicTest,
                PortColoring = v.PortColoring,
                RadiographicTest = v.RadiographicTest,
                HardnessRockwell = v.HardnessRockwell,
                HardnessBrinell = v.HardnessBrinell,
                HardnessVickers = v.HardnessVickers,
                TensileRoomTemp = v.TensileRoomTemp,
                TensileHighTemp = v.TensileHighTemp,
                WeldJointTensile = v.WeldJointTensile,
                ImpactTest = v.ImpactTest,
                WeldJointImpact = v.WeldJointImpact,
                FlatteningTest = v.FlatteningTest,
                FlaringTest = v.FlaringTest,
                ExpandingTest = v.ExpandingTest,
                BendTest = v.BendTest,
                WeldJointBend = v.WeldJointBend,
                GrainSize = v.GrainSize,
                IntergranularCorrosion = v.IntergranularCorrosion,
                PittingCorrosion = v.PittingCorrosion,
                FerriteContent = v.FerriteContent,
                Macrostructure = v.Macrostructure,
                OtherRequirement = v.OtherRequirement,
                CreatedTime = v.CreatedTime,
                UpdatedTime = v.UpdatedTime
            }).ToList();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"加载失败: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    // ========== 编辑模式 ==========
    private async Task EnterEditMode()
    {
        if (_orderStatus == SalesOrderStatus.Cancelled)
        {
            Snackbar.Add("已取消的订单无法编辑技术要求", Severity.Warning);
            return;
        }

        // 尚未保存过技术要求的项次（无 ProductRequirement 记录）：按标准号从工厂检验项要求带出默认值（必检→「终」/「-」，10 个成品检验项 4 值；理化 20 项 bool）
        // 已保存过真实值的项次不覆盖，保护手工配置
        var pendingItems = _editItems.Where(x => !x.HasExisting && !string.IsNullOrWhiteSpace(x.StandardNo)).ToList();
        var handledStandardNos = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
        foreach (var item in pendingItems)
        {
            if (!handledStandardNos.Add(item.StandardNo!)) continue;
            var defaultsResult = await RequirementService.GetDefaultsByStandardNoAsync(orderId, item.StandardNo);
            if (!defaultsResult.Success || defaultsResult.Data == null) continue;
            var d = defaultsResult.Data;
            foreach (var target in _editItems.Where(x => !x.HasExisting && string.Equals(x.StandardNo, item.StandardNo, StringComparison.OrdinalIgnoreCase)))
            {
                target.ChemicalComposition = d.ChemicalComposition;
                target.PmiInspection = d.PmiInspection;
                target.SurfaceInspection = d.SurfaceInspection;
                target.Dimension = d.Dimension;
                target.Endoscopy = d.Endoscopy;
                // 液压检验（水压）仅定尺钢管按标准号带出；非定尺默认"-"（不适用）
                target.HydrostaticTest = target.LengthStatus == LengthStatus.Fixed ? d.HydrostaticTest : InspectionRequirementStage.None;
                target.UnderwaterPressure = d.UnderwaterPressure;
                target.EddyCurrent = d.EddyCurrent;
                target.UltrasonicTest = d.UltrasonicTest;
                target.PortColoring = d.PortColoring;
                target.RadiographicTest = d.RadiographicTest;
                target.HardnessRockwell = d.HardnessRockwell;
                target.HardnessBrinell = d.HardnessBrinell;
                target.HardnessVickers = d.HardnessVickers;
                target.TensileRoomTemp = d.TensileRoomTemp;
                target.TensileHighTemp = d.TensileHighTemp;
                target.WeldJointTensile = d.WeldJointTensile;
                target.ImpactTest = d.ImpactTest;
                target.WeldJointImpact = d.WeldJointImpact;
                target.FlatteningTest = d.FlatteningTest;
                target.FlaringTest = d.FlaringTest;
                target.ExpandingTest = d.ExpandingTest;
                target.BendTest = d.BendTest;
                target.WeldJointBend = d.WeldJointBend;
                target.GrainSize = d.GrainSize;
                target.IntergranularCorrosion = d.IntergranularCorrosion;
                target.PittingCorrosion = d.PittingCorrosion;
                target.FerriteContent = d.FerriteContent;
                target.Macrostructure = d.Macrostructure;
            }
        }

        _isEditMode = true;
    }

