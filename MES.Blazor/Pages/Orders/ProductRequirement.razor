@page "/orders/{orderId:int}/requirements"
@using MES.Blazor.Services
@using MES.Blazor.Helpers
@using MES.Core.Enums
@using MES.Core.DTOs.Order
@using Microsoft.AspNetCore.Authorization
@using System.Text.Json
@using MES.Shared.Constants
@inject ProductRequirementService RequirementService
@inject OrderService OrderService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject IJSRuntime JS
@inject HttpClient Http
@inject ColumnPrefsService ColumnPrefs
@attribute [Authorize(Roles = Roles.Policies.OrderRead)]

<MudContainer MaxWidth="MaxWidth.False" Class="mt-4 pl-0">
    @if (_isLoading)
    {
        <MudProgressCircular Indeterminate Size="Size.Large" Class="d-flex justify-center ma-8" />
    }
    else if (!string.IsNullOrEmpty(_loadErrorMessage))
    {
        <MudPaper Class="pa-4 mb-4" Elevation="0" Style="border:1px solid var(--mud-palette-lines-default); border-radius:8px;">
            <MudText Typo="Typo.body2" Color="Color.Error"><strong>加载失败：</strong>@_loadErrorMessage</MudText>
            <div class="mt-3">
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="GoBack">返回</MudButton>
            </div>
        </MudPaper>
    }
    else
    {
        <MudCard>
            <MudCardHeader>
                <CardHeaderContent>
                    <MudText Typo="Typo.h5" Class="font-weight-bold">
                        <MudIcon Icon="@Icons.Material.Filled.Description" Class="mr-2" Color="Color.Primary" />
                        技术要求
                    </MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">订单号：@_orderNumber</MudText>
                    @if (_orderStatus == SalesOrderStatus.Cancelled)
                    {
                        <MudChip Size="Size.Small" Color="Color.Error" Class="ml-2">已取消</MudChip>
                    }
                </CardHeaderContent>
                <CardHeaderActions>
                    <MudButton Variant="Variant.Text" OnClick="GoBack">返回</MudButton>
                    @if (!_isEditMode)
                    {
                        <MudButton Variant="Variant.Outlined" Color="Color.Info"
                                   StartIcon="@Icons.Material.Filled.Print"
                                   OnClick="PrintRequirements">
                            打印
                        </MudButton>
                    }
                    @if (_isEditMode)
                    {
                        @if (_orderStatus != SalesOrderStatus.Cancelled)
                        {
                            <MudButton Variant="Variant.Text" Color="Color.Default" OnClick="CancelEdit">取消</MudButton>
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAllRequirements" Loading="@_isSubmitting">
                                保存修改
                            </MudButton>
                        }
                        else
                        {
                            @* 已取消的订单无法编辑 *@
                        }
                    }
                    else
                    {
                        @if (_orderStatus != SalesOrderStatus.Cancelled)
                        {
                            <AuthorizeView Roles="@Roles.Policies.OrderWrite">
                                <MudButton Variant="Variant.Outlined" Color="Color.Warning" OnClick="EnterEditMode">编辑技术要求</MudButton>
                            </AuthorizeView>
                        }
                    }
                </CardHeaderActions>
            </MudCardHeader>

            <MudCardContent>
                <div class="d-flex align-center mb-2">
                    <MudText Typo="Typo.subtitle1" Class="font-weight-bold">
                        <MudIcon Icon="@Icons.Material.Filled.ListAlt" Size="Size.Small" Class="mr-1" />项次技术要求
                    </MudText>
                    <ColumnDisplaySelect Columns="@_allColumns"
                                         OnColumnToggle="@OnColumnToggle"
                                         OnMoveUp="@OnMoveUp"
                                         OnMoveDown="@OnMoveDown" />
                </div>

                <div id="product-requirement-table">
                @{
                    var _groupHeaders = GetGroupHeaders();
                }
                <div class="col-group-header-scroll">
                    <div class="col-group-header-bar">
                        @foreach (var gh in _groupHeaders)
                        {
                            <div class="col-group-header-item @gh.CssClass">
                                <span class="col-group-badge">@gh.GroupName</span>
                            </div>
                        }
                    </div>
                </div>
                <MudTable Items="@(_isEditMode ? _editItems : _viewItems)"
                          Dense="true"
                          Hover="true"
                          Elevation="0"
                          RowsPerPage="10"
                          RowsPerPageLabel="每页行数:"
                          Class="auto-table">
                    <HeaderContent>
                        @{
                            int? _prevGk = null;
                        }
                        @foreach (var col in _visibleColumns)
                        {
                            var _isGroupStart = col.GroupKey.HasValue && col.GroupKey != _prevGk;
                            _prevGk = col.GroupKey;
                            var _headerClass = GetHeaderGroupCss(col.GroupKey, _isGroupStart);
                            <MudTh Class="@_headerClass" Style="@($"width:{col.Width}px")">
                                <div class="col-header-cell">@col.Label</div>
                            </MudTh>
                        }
                    </HeaderContent>
                    <RowTemplate Context="item">
                        @{
                            int? _prevGk2 = null;
                        }
                        @foreach (var col in _visibleColumns)
                        {
                            var _isGroupStart2 = col.GroupKey.HasValue && col.GroupKey != _prevGk2;
                            _prevGk2 = col.GroupKey;
                            <MudTd Class="@GetCellGroupCss(col.GroupKey, _isGroupStart2)">@RenderCell(item, col)</MudTd>
                        }
                    </RowTemplate>
                </MudTable>
                </div>
            </MudCardContent>
        </MudCard>
    }
</MudContainer>

