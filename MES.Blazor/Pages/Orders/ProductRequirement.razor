    private string GetRequirementTypeText(RequirementType type) => DisplayHelper.GetRequirementTypeText(type);

    private static bool GetBool(OrderItemRequirement item, string key)
        => (bool)(typeof(OrderItemRequirement).GetProperty(key, System.Reflection.BindingFlags.Public | System.Reflection.BindingFlags.Instance | System.Reflection.BindingFlags.IgnoreCase)?.GetValue(item) ?? false);

    private static void SetBool(OrderItemRequirement item, string key, bool value)
        => typeof(OrderItemRequirement).GetProperty(key, System.Reflection.BindingFlags.Public | System.Reflection.BindingFlags.Instance | System.Reflection.BindingFlags.IgnoreCase)?.SetValue(item, value);

    private static string BoolText(bool value) => value ? "是" : "-";

    private static InspectionRequirementStage GetStage(OrderItemRequirement item, string key)
        => (InspectionRequirementStage)(typeof(OrderItemRequirement).GetProperty(key, System.Reflection.BindingFlags.Public | System.Reflection.BindingFlags.Instance | System.Reflection.BindingFlags.IgnoreCase)?.GetValue(item) ?? InspectionRequirementStage.FinalOnly);

    private static void SetStage(OrderItemRequirement item, string key, InspectionRequirementStage value)
        => typeof(OrderItemRequirement).GetProperty(key, System.Reflection.BindingFlags.Public | System.Reflection.BindingFlags.Instance | System.Reflection.BindingFlags.IgnoreCase)?.SetValue(item, value);

    /// <summary>
    /// 检验阶段中文文本（终/预/预+终/-），统一走 EnumHelper 注册（防散落 switch 漂移）
    /// </summary>
    private static string StageText(InspectionRequirementStage value) => MES.Core.Helpers.EnumHelper.GetDisplayName(value);

    // ========== 分组表头 ==========
    private class GroupHeaderInfo
    {
        public int GroupKey { get; init; }
        public string GroupName { get; init; } = "";
        public string CssClass { get; init; } = "";
    }

    private List<GroupHeaderInfo> GetGroupHeaders()
    {
        var result = new List<GroupHeaderInfo>();
        int? lastKey = null;
        foreach (var col in _visibleColumns)
        {
            var gk = col.GroupKey ?? 0;
            if (gk == 0) continue;
            if (lastKey.HasValue && gk == lastKey.Value) continue;
            result.Add(new GroupHeaderInfo
            {
                GroupKey = gk,
                GroupName = col.GroupName ?? "",
                CssClass = GetHeaderGroupCss(gk, true)
            });
            lastKey = gk;
        }
        return result;
    }

    private static string GetHeaderGroupCss(int? groupKey, bool isGroupStart)
    {
        var cls = groupKey switch
        {
            1 => "col-g1",
            2 => "col-g2",
            3 => "col-g3",
            4 => "col-g4",
            5 => "col-g5",
            _ => ""
        };
        if (isGroupStart && groupKey > 1) cls += " col-group-start";
        return cls;
    }

    private static string GetCellGroupCss(int? groupKey, bool isGroupStart)
    {
        var cls = groupKey switch
        {
            1 => "col-g1-cell",
            2 => "col-g2-cell",
            3 => "col-g3-cell",
            4 => "col-g4-cell",
            5 => "col-g5-cell",
            _ => ""
        };
        if (isGroupStart && groupKey > 1) cls += " col-group-start-cell";
        return cls;
    }

    private string FormatDateTime(DateTimeOffset dt)
    {
        return dt == DateTimeOffset.MinValue ? "-" : dt.LocalDateTime.ToString("yyyy-MM-dd HH:mm");
    }

    // ========== 渲染方法 ==========
    private RenderFragment RenderCell(OrderItemRequirement item, ColumnDef col) => builder =>
    {
        switch (col.Key)
        {
            case "sequence":
                builder.AddContent(0, item.Sequence.ToString());
                break;
            case "standardgrade":
                builder.AddContent(0, item.StandardGrade);
                break;
            case "outerdiameter":
                builder.AddContent(0, item.OuterDiameter.ToString("G29"));
                break;
            case "wallthickness":
                builder.AddContent(0, item.WallThickness.ToString("G29"));
                break;
            case "lengthstatus":
                builder.AddContent(0, DisplayHelper.GetLengthStatusText(item.LengthStatus));
                break;
            case "quantity":
                builder.AddContent(0, item.Quantity?.ToString() ?? "-");
                break;
            case "contractweight":
                builder.AddContent(0, item.ContractWeight.ToString("G29"));
                break;
            case "standardno":
                builder.AddContent(0, item.StandardNo);
                break;
            case "deliverystate":
                if (_isEditMode && _orderStatus != SalesOrderStatus.Cancelled)
                {
                    builder.OpenComponent<MudSelect<DeliveryState>>(0);
                    builder.AddAttribute(1, "Value", item.DeliveryState);
                    builder.AddAttribute(2, "ValueChanged", EventCallback.Factory.Create<DeliveryState>(this, v => item.DeliveryState = v));
                    builder.AddAttribute(3, "Dense", true);
                    builder.AddAttribute(4, "Variant", Variant.Outlined);
                    builder.AddAttribute(5, "Size", Size.Small);
                    builder.AddAttribute(6, "ChildContent", (RenderFragment)(cb =>
                    {
                        foreach (var opt in DisplayHelper.GetEnumOptions<DeliveryState>())
                        {
                            cb.OpenComponent<MudSelectItem<DeliveryState>>(0);
                            cb.AddAttribute(1, "Value", Enum.Parse<DeliveryState>(opt.Value));
                            cb.AddAttribute(2, "Text", opt.Display);
                            cb.AddAttribute(3, "ChildContent", (RenderFragment)(b => b.AddContent(0, opt.Display)));
                            cb.CloseComponent();
                        }
                    }));
                    builder.CloseComponent();
                }
                else { builder.AddContent(0, DisplayHelper.GetDeliveryStateText(item.DeliveryState)); }
                break;
            case "requirementtype":
                if (_isEditMode && _orderStatus != SalesOrderStatus.Cancelled)
                {
                    builder.OpenComponent<MudSelect<RequirementType>>(0);
                    builder.AddAttribute(1, "Value", item.RequirementType);
                    builder.AddAttribute(2, "ValueChanged", EventCallback.Factory.Create<RequirementType>(this, v => item.RequirementType = v));
                    builder.AddAttribute(3, "Dense", true);
                    builder.AddAttribute(4, "Variant", Variant.Outlined);
                    builder.AddAttribute(5, "Size", Size.Small);
                    builder.AddAttribute(6, "ChildContent", (RenderFragment)(cb =>
                    {
                        foreach (var opt in DisplayHelper.GetEnumOptions<RequirementType>())
                        {
                            cb.OpenComponent<MudSelectItem<RequirementType>>(0);
                            cb.AddAttribute(1, "Value", Enum.Parse<RequirementType>(opt.Value));
                            cb.AddAttribute(2, "Text", opt.Display);
                            cb.AddAttribute(3, "ChildContent", (RenderFragment)(b => b.AddContent(0, opt.Display)));
                            cb.CloseComponent();
                        }
                    }));
                    builder.CloseComponent();
                }
                else { builder.AddContent(0, GetRequirementTypeText(item.RequirementType)); }
                break;
            case "pmiinspection":
            case "surfaceinspection":
            case "dimension":
            case "endoscopy":
            case "hydrostatictest":
            case "underwaterpressure":
            case "eddycurrent":
            case "ultrasonictest":
            case "portcoloring":
            case "radiographictest":
                // 10 个成品检验项（含射线探伤）：检验阶段 4 值（终/预/预+终/-）
                if (_isEditMode && _orderStatus != SalesOrderStatus.Cancelled)
                {
                    builder.OpenComponent<MudSelect<InspectionRequirementStage>>(0);
                    builder.AddAttribute(1, "Value", GetStage(item, col.Key));
                    builder.AddAttribute(2, "ValueChanged", EventCallback.Factory.Create<InspectionRequirementStage>(this, v => SetStage(item, col.Key, v)));
                    builder.AddAttribute(3, "Dense", true);
                    builder.AddAttribute(4, "Variant", Variant.Outlined);
                    builder.AddAttribute(5, "Size", Size.Small);
                    builder.AddAttribute(6, "ChildContent", (RenderFragment)(cb =>
                    {
                        foreach (var opt in DisplayHelper.GetEnumOptions<InspectionRequirementStage>())
                        {
                            cb.OpenComponent<MudSelectItem<InspectionRequirementStage>>(0);
                            cb.AddAttribute(1, "Value", Enum.Parse<InspectionRequirementStage>(opt.Value));
                            cb.AddAttribute(2, "Text", opt.Display);
                            cb.AddAttribute(3, "ChildContent", (RenderFragment)(b => b.AddContent(0, opt.Display)));
                            cb.CloseComponent();
                        }
                    }));
                    builder.CloseComponent();
                }
                else { builder.AddContent(0, StageText(GetStage(item, col.Key))); }
                break;
            case "chemicalcomposition":
            case "hardnessrockwell":
            case "hardnessbrinell":
            case "hardnessvickers":
            case "tensileroomtemp":
            case "tensilehightemp":
            case "weldjointtensile":
            case "impacttest":
            case "weldjointimpact":
            case "flatteningtest":
            case "flaringtest":
            case "expandingtest":
            case "bendtest":
            case "weldjointbend":
            case "grainsize":
            case "intergranularcorrosion":
            case "pittingcorrosion":
            case "ferritecontent":
            case "macrostructure":
                // 化学分析(成品) + 理化检测 20 项：bool 开关
                if (_isEditMode && _orderStatus != SalesOrderStatus.Cancelled)
                {
                    builder.OpenComponent<MudSwitch<bool>>(0);
                    builder.AddAttribute(1, "Value", GetBool(item, col.Key));
                    builder.AddAttribute(2, "ValueChanged", EventCallback.Factory.Create<bool>(this, v => SetBool(item, col.Key, v)));
                    builder.AddAttribute(3, "Dense", true);
                    builder.AddAttribute(4, "Color", Color.Primary);
                    builder.AddAttribute(5, "Class", "d-flex justify-center");
                    builder.CloseComponent();
                }
                else { builder.AddContent(0, BoolText(GetBool(item, col.Key))); }
                break;
            case "otherrequirement":
                if (_isEditMode && _orderStatus != SalesOrderStatus.Cancelled)
                {
                    builder.OpenComponent<MudTextField<string>>(0);
                    builder.AddAttribute(1, "Value", item.OtherRequirement);
                    builder.AddAttribute(2, "ValueChanged", EventCallback.Factory.Create<string>(this, v => item.OtherRequirement = v));
                    builder.AddAttribute(3, "Dense", true);
                    builder.AddAttribute(4, "Variant", Variant.Outlined);
                    builder.AddAttribute(5, "Size", Size.Small);
                    builder.AddAttribute(6, "FullWidth", true);
                    builder.CloseComponent();
                }
                else { builder.AddContent(0, item.OtherRequirement); }
                break;
            case "createdtime":
                builder.AddContent(0, FormatDateTime(item.CreatedTime));
                break;
            case "updatedtime":
                builder.AddContent(0, FormatDateTime(item.UpdatedTime));
                break;
        }
    };
