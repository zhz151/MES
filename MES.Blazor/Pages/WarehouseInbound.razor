@page "/warehouse/inbound"
@page "/warehouse/inbound/{Code}"
@using MES.Blazor.Services
@using MES.Core.DTOs
@using MES.Core.Models
@using Microsoft.AspNetCore.Authorization
@inject WarehouseService WarehouseService
@inject InventoryService InventoryService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject ColumnPrefsService ColumnPrefs
@attribute [Authorize]

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4">
    <MudCard>
        <MudCardHeader>
            <CardHeaderContent>
                <MudText Typo="Typo.h5" Class="font-weight-bold">
                    <MudIcon Icon="@Icons.Material.Filled.AddCircleOutline" Class="mr-2" Color="Color.Primary" />
                    批量入库
                </MudText>
            </CardHeaderContent>
            <CardHeaderActions>
                <MudButton Variant="Variant.Text" Color="Color.Default" OnClick="GoBack">返回</MudButton>
            </CardHeaderActions>
        </MudCardHeader>

        <MudCardContent>
            <!-- ============ 仓库 + 条目数 ============ -->
            <MudGrid Class="mb-4">
                @if (!string.IsNullOrEmpty(Code))
                {
                    <MudItem xs="12" md="4" Class="d-flex align-center">
                        <MudText Typo="Typo.body2">
                            仓库：<strong>@_warehouseName</strong>
                        </MudText>
                    </MudItem>
                }
                else
                {
                    <MudItem xs="12" md="4">
                        <MudSelect T="int?" Label="仓库 *"
                                   @bind-Value="_warehouseId"
                                   Required="true"
                                   RequiredError="请选择仓库"
                                   OnValueChanged="OnWarehouseChanged">
                            @foreach (var wh in _warehouses)
                            {
                                <MudSelectItem Value="(int?)wh.Id">@wh.Name</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                }
                <MudItem xs="12" md="3">
                    <MudNumericField T="int" Label="入库条目数"
                                     @bind-Value="_rowCount"
                                     Min="1" Max="200"
                                     HelperText="1~200条" />
                </MudItem>
                <MudItem xs="12" md="3" Class="d-flex align-center">
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.TableChart"
                               OnClick="GenerateRows">
                        生成入库明细
                    </MudButton>
                </MudItem>
            </MudGrid>

            <!-- ============ 入库明细表 ============ -->
            @if (_rows.Any())
            {
                <MudTable Items="@_rows" Dense="true" Hover="true" Elevation="0" Striped="true"
                          Class="mt-2" SortMode="SortMode.None">
                    <ToolBarContent>
                        <MudText Typo="Typo.body2">共 @_rows.Count 行</MudText>
                        <MudSpacer />
                        <MudMenu>
                            <ActivatorContent>
                                <MudButton Variant="Variant.Outlined" Size="Size.Small"
                                           Color="Color.Primary"
                                           StartIcon="@Icons.Material.Filled.ViewColumn">
                                    列选择
                                </MudButton>
                            </ActivatorContent>
                            <ChildContent>
                                <MudPaper Class="pa-4" Elevation="8" Style="max-height:400px; overflow-y:auto; min-width:260px;">
                                    @* 适用列 *@
                                    <MudText Typo="Typo.body2" Class="font-weight-bold mb-2" Color="Color.Primary">适用字段</MudText>
                                    @foreach (var col in _allColumns.Where(c => c.IsApplicable))
                                    {
                                        <MudGrid Class="d-flex align-center" Style="flex-wrap:nowrap;">
                                            <MudItem>
                                                <MudIconButton Icon="@Icons.Material.Filled.KeyboardArrowUp"
                                                               Size="Size.Small" Disabled="@(_allColumns.IndexOf(col) == 0)"
                                                               OnClick="async () => await MoveColumnUp(col)" />
                                            </MudItem>
                                            <MudItem>
                                                <MudIconButton Icon="@Icons.Material.Filled.KeyboardArrowDown"
                                                               Size="Size.Small" Disabled="@(_allColumns.IndexOf(col) == _allColumns.Count - 1)"
                                                               OnClick="async () => await MoveColumnDown(col)" />
                                            </MudItem>
                                            <MudItem Style="min-width:100px;">
                                                <MudSwitch T="bool" Value="col.Visible"
                                                           ValueChanged="@((bool v) => OnColumnToggle(col, v))"
                                                           Color="Color.Primary" Dense="true">
                                                    @col.Label
                                                </MudSwitch>
                                            </MudItem>
                                        </MudGrid>
                                    }
                                    @* 分隔线 *@
                                    <MudDivider Class="my-2" />
                                    @* 不适用列 *@
                                    <MudText Typo="Typo.body2" Class="font-weight-bold mb-2" Color="Color.Error">不适用字段</MudText>
                                    @foreach (var col in _allColumns.Where(c => !c.IsApplicable))
                                    {
                                        <MudGrid Class="d-flex align-center" Style="flex-wrap:nowrap;opacity:0.5;">
                                            <MudItem>
                                                <MudIconButton Icon="@Icons.Material.Filled.Block"
                                                               Size="Size.Small"
                                                               Disabled="true"
                                                               Color="Color.Error" />
                                            </MudItem>
                                            <MudItem Style="pointer-events:none;">
                                                <MudSwitch T="bool" Value="false" Disabled="true" Color="Color.Error" Dense="true">
                                                    @col.Label
                                                </MudSwitch>
                                            </MudItem>
                                        </MudGrid>
                                    }
                                </MudPaper>
                            </ChildContent>
                        </MudMenu>
                    </ToolBarContent>
                    <HeaderContent>
                        @foreach (var col in _visibleColumns)
                        {
                            <MudTh Style="@($"min-width:{GetColWidth(col.Key)}px;white-space:nowrap;")">@col.Label</MudTh>
                        }
                        <MudTh Style="width:140px;">操作</MudTh>
                    </HeaderContent>
                    <RowTemplate Context="r">
                        @foreach (var col in _visibleColumns)
                        {
                            <MudTd Class="@GetCellClass(col.Key)">
                                @RenderCell(r, col)
                            </MudTd>
                        }
                        <MudTd>
                            <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                           Color="Color.Primary" Size="Size.Small"
                                           Title="编辑"
                                           OnClick="() => StartInlineEdit(r, _rows.IndexOf(r))" />
                            @if (_rows.IndexOf(r) > 0)
                            {
                                <MudIconButton Icon="@Icons.Material.Filled.ContentCopy"
                                               Color="Color.Info" Size="Size.Small"
                                               Title="与上行相同"
                                               OnClick="() => CopyFromAbove(r, _rows.IndexOf(r))" />
                            }
                            <MudIconButton Icon="@Icons.Material.Filled.RemoveCircleOutline"
                                           Color="Color.Error" Size="Size.Small"
                                           Title="删除"
                                           OnClick="() => RemoveRow(r)"
                                           Disabled="@(_rows.Count <= 1)" />
                        </MudTd>
                    </RowTemplate>
                    <FooterContent>
                        @foreach (var col in _visibleColumns)
                        {
                            <MudTd Class="@GetCellClass(col.Key)">
                                @RenderFooter(col)
                            </MudTd>
                        }
                        <MudTd>
                            <MudIconButton Icon="@Icons.Material.Filled.AddCircleOutline"
                                           Color="Color.Primary" Size="Size.Small"
                                           OnClick="AddRow" />
                        </MudTd>
                    </FooterContent>
                </MudTable>
            }

            @* ===== 内联编辑面板 ===== *@
            @if (_editingRow != null)
            {
                <MudPaper Class="pa-4 mt-4" Elevation="1">
                    <MudText Typo="Typo.h6" Class="mb-4">
                        <MudIcon Icon="@Icons.Material.Filled.Edit" Class="mr-2" Color="Color.Primary" />
                        编辑入库明细 — 第 @(_editingIndex + 1) 行
                    </MudText>
                    <MudGrid>
                        @foreach (var col in _allColumns.Where(c => c.IsApplicable))
                        {
                            @if (col.Key is "WorkOrderNo" or "SalesOrderNo" or "OrderItemIds" && !_editingRow.IsLinkedToWorkOrder)
                            {
                                continue;
                            }
                            <MudItem xs="12" md="@GetEditFieldMd(col.Key)">
                                @RenderEditField(_editingRow, col)
                            </MudItem>
                        }
                    </MudGrid>
                    <MudGrid Class="mt-4">
                        <MudItem xs="12" Class="d-flex justify-end">
                            <MudButton Variant="Variant.Text" Color="Color.Default" OnClick="CancelInlineEdit" Class="mr-2">取消</MudButton>
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="ConfirmInlineEdit">确定</MudButton>
                        </MudItem>
                    </MudGrid>
                </MudPaper>
            }

            @if (!string.IsNullOrEmpty(_errorMessage))
            {
                <MudAlert Severity="Severity.Error" Class="mt-4">@_errorMessage</MudAlert>
            }

            @if (_rows.Any())
            {
                <MudGrid Class="mt-4">
                    <MudItem xs="12" Class="d-flex justify-end">
                        <MudButton Variant="Variant.Text" Color="Color.Default" OnClick="ResetAll" Class="mr-2">重置</MudButton>
                        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.CloudUpload"
                                   OnClick="Submit" Loading="@_isSubmitting"
                                   Size="Size.Large">
                            确认入库 (@_rows.Count 条)
                        </MudButton>
                    </MudItem>
                </MudGrid>
            }
        </MudCardContent>
    </MudCard>
</MudContainer>

@code {
    [Parameter]
    public string? Code { get; set; }

    // ========== 仓库 ==========
    private List<WarehouseDto> _warehouses = new();
    private int? _warehouseId;
    private string _warehouseName = "";
    private string _warehouseCode = "";

    // ========== 条目数 ==========
    private int _rowCount = 1;
    private List<InboundRowModel> _rows = new();

    // ========== 列定义 ==========
    private List<EditColumnDef> _allColumns = new();
    private List<EditColumnDef> _visibleColumns =>
        _allColumns.Where(c => c.IsApplicable && c.Visible).ToList();

    // ========== 状态 ==========
    private bool _isSubmitting;
    private string _errorMessage = string.Empty;

    // ========== 内联编辑 ==========
    private InboundRowModel? _editingRow;
    private int _editingIndex;

    // ========== 行模型 ==========

    private class InboundRowModel
    {
        public string? MaterialType { get; set; }
        public string? InboundSource { get; set; }
        public string? SourceName { get; set; }
        public string? InboundDateStr { get; set; }
        public string? HeatNo { get; set; }
        public string? PlantGrade { get; set; }
        public string? Specification { get; set; }
        public string? LengthStatus { get; set; }
        public int InitialQuantity { get; set; } = 1;
        public decimal InitialWeight { get; set; }
        public decimal? UnitWeight { get; set; }
        public string? SurfaceCondition { get; set; }
        public string? LocationArea { get; set; }
        public string? LocationRack { get; set; }
        public string? Remark { get; set; }
        public bool IsLinkedToWorkOrder { get; set; }
        public string? WorkOrderNo { get; set; }
        public string? SalesOrderNo { get; set; }
        public string? OrderItemIds { get; set; }
        // 新增模板字段
        public decimal? MinLength { get; set; }
        public decimal? MaxLength { get; set; }
        public decimal? Meters { get; set; }
        public string? ActualSpecification { get; set; }
        public decimal? ActualOuterDiameter { get; set; }
        public decimal? ActualWallThickness { get; set; }
        public string? ProductionBatchNo { get; set; }
        public string? DefectReason { get; set; }
        public string? LiabilityType { get; set; }
        public string? OriginalSupplier { get; set; }
        public string? TagNo { get; set; }
        public string? DefectRemark { get; set; }
    }

    // ========== 列定义 ==========

    private class EditColumnDef
    {
        public string Key { get; set; } = "";
        public string Label { get; set; } = "";
        public string Type { get; set; } = "text";
        public bool Visible { get; set; } = true;
        public bool IsApplicable { get; set; } = true;
    }

    private class EditRowData
    {
        public string? MaterialType { get; set; }
        public string? InboundSource { get; set; }
        public string? SourceName { get; set; }
        public string? InboundDateStr { get; set; }
        public string? HeatNo { get; set; }
        public string? PlantGrade { get; set; }
        public string? Specification { get; set; }
        public string? LengthStatus { get; set; }
        public int InitialQuantity { get; set; } = 1;
        public decimal InitialWeight { get; set; }
        public decimal? UnitWeight { get; set; }
        public string? SurfaceCondition { get; set; }
        public string? LocationArea { get; set; }
        public string? LocationRack { get; set; }
        public string? Remark { get; set; }
        public bool IsLinkedToWorkOrder { get; set; }
        public string? WorkOrderNo { get; set; }
        public string? SalesOrderNo { get; set; }
        public string? OrderItemIds { get; set; }
        public decimal? MinLength { get; set; }
        public decimal? MaxLength { get; set; }
        public decimal? Meters { get; set; }
        public string? ActualSpecification { get; set; }
        public decimal? ActualOuterDiameter { get; set; }
        public decimal? ActualWallThickness { get; set; }
        public string? ProductionBatchNo { get; set; }
        public string? DefectReason { get; set; }
        public string? LiabilityType { get; set; }
        public string? OriginalSupplier { get; set; }
        public string? TagNo { get; set; }
        public string? DefectRemark { get; set; }
    }

    // ========== 列定义初始化 ==========

    private static List<EditColumnDef> GetAllColumnDefs() => new()
    {
        new() { Key = "MaterialType",        Label = "物料名称",       Type = "text",   Visible = true },
        new() { Key = "InboundSource",       Label = "入库来源",       Type = "select", Visible = false },
        new() { Key = "SourceName",          Label = "来料单位或部门", Type = "text",   Visible = false },
        new() { Key = "InboundDateStr",      Label = "入库日期",       Type = "text",   Visible = false },
        new() { Key = "HeatNo",              Label = "炉号",           Type = "text",   Visible = false },
        new() { Key = "PlantGrade",          Label = "工厂牌号",       Type = "text",   Visible = false },
        new() { Key = "Specification",       Label = "名义规格",       Type = "text",   Visible = true },
        new() { Key = "LengthStatus",        Label = "长度状态",       Type = "select", Visible = true },
        new() { Key = "InitialQuantity",     Label = "支数",           Type = "int",    Visible = true },
        new() { Key = "InitialWeight",       Label = "重量",           Type = "decimal",Visible = true },
        new() { Key = "UnitWeight",          Label = "理论单支重",     Type = "decimal",Visible = false },
        new() { Key = "SurfaceCondition",    Label = "物料状态",       Type = "text",   Visible = true },
        new() { Key = "LocationArea",        Label = "放置区域",       Type = "text",   Visible = false },
        new() { Key = "LocationRack",        Label = "放置框架",       Type = "text",   Visible = false },
        new() { Key = "Remark",              Label = "物料备注",       Type = "text",   Visible = false },
        new() { Key = "IsLinkedToWorkOrder", Label = "关联工单",       Type = "bool",   Visible = false },
        new() { Key = "WorkOrderNo",         Label = "工单号",         Type = "text",   Visible = false },
        new() { Key = "SalesOrderNo",        Label = "订单号",         Type = "text",   Visible = false },
        new() { Key = "OrderItemIds",        Label = "项次ID列表",     Type = "text",   Visible = false },
        // 长度
        new() { Key = "MinLength",           Label = "最小长度",       Type = "decimal",Visible = false },
        new() { Key = "MaxLength",           Label = "最大长度",       Type = "decimal",Visible = false },
        new() { Key = "Meters",              Label = "米数",           Type = "decimal",Visible = false },
        // 实际规格
        new() { Key = "ActualSpecification", Label = "实际规格",       Type = "text",   Visible = false },
        new() { Key = "ActualOuterDiameter", Label = "实际外径",       Type = "decimal",Visible = false },
        new() { Key = "ActualWallThickness", Label = "实际壁厚",       Type = "decimal",Visible = false },
        // 生产
        new() { Key = "ProductionBatchNo",   Label = "生产批号",       Type = "text",   Visible = false },
        // 次品
        new() { Key = "DefectReason",        Label = "次品原因",       Type = "text",   Visible = false },
        new() { Key = "LiabilityType",       Label = "责任类型",       Type = "text",   Visible = false },
        new() { Key = "OriginalSupplier",    Label = "原始来料单位",   Type = "text",   Visible = false },
        new() { Key = "TagNo",               Label = "挂牌号",         Type = "text",   Visible = false },
        new() { Key = "DefectRemark",        Label = "次品备注",       Type = "text",   Visible = false },
    };

    private readonly List<(string Value, string Text)> _inboundSourceOptions = new()
    {
        ("Purchase", "外购"),
        ("ProductionInbound", "生产入库"),
        ("InspectionInbound", "检验入库"),
        ("SubcontractPiercing", "委外穿孔"),
        ("SelfProduced", "自产"),
        ("TransferIn", "移库入库"),
        ("ReturnIn", "退货入库"),
    };

    private readonly List<(string Value, string Text)> _lengthStatusOptions = new()
    {
        ("定尺", "定尺"),
        ("范围尺", "范围尺"),
        ("不定尺", "不定尺"),
    };

    private static int GetColWidth(string key) => key switch
    {
        "InitialQuantity" => 70,
        "InitialWeight" => 80,
        "UnitWeight" => 90,
        "LengthStatus" => 80,
        "InboundDateStr" => 100,
        "Specification" => 120,
        _ => 100
    };

    private static string GetCellClass(string key) => key switch
    {
        "InitialQuantity" or "InitialWeight" or "UnitWeight" => "text-right",
        _ => ""
    };

    // ========== 仓库模板默认列 ==========

    private static void ApplyWarehouseDefaults(List<EditColumnDef> cols, string whCode)
    {
        // 先全部重置为适用
        foreach (var c in cols)
            c.IsApplicable = true;

        switch (whCode)
        {
            case "RAW":
                // 原料库不含：长度/米数/实际规格/生产批号/次品
                SetNotApplicable(cols, "MinLength");
                SetNotApplicable(cols, "MaxLength");
                SetNotApplicable(cols, "Meters");
                SetNotApplicable(cols, "ActualSpecification");
                SetNotApplicable(cols, "ActualOuterDiameter");
                SetNotApplicable(cols, "ActualWallThickness");
                SetNotApplicable(cols, "ProductionBatchNo");
                SetNotApplicable(cols, "DefectReason");
                SetNotApplicable(cols, "LiabilityType");
                SetNotApplicable(cols, "OriginalSupplier");
                SetNotApplicable(cols, "TagNo");
                SetNotApplicable(cols, "DefectRemark");
                break;
            case "FG":
                // 成品库不含：次品
                SetNotApplicable(cols, "DefectReason");
                SetNotApplicable(cols, "LiabilityType");
                SetNotApplicable(cols, "OriginalSupplier");
                SetNotApplicable(cols, "TagNo");
                SetNotApplicable(cols, "DefectRemark");
                break;
            case "DEFECT":
                // 次品库不含：米数/实际规格/外径/壁厚
                SetNotApplicable(cols, "Meters");
                SetNotApplicable(cols, "ActualSpecification");
                SetNotApplicable(cols, "ActualOuterDiameter");
                SetNotApplicable(cols, "ActualWallThickness");
                break;
            case "WIP":
                // 在制品库不含：工单关联/次品/米数
                SetNotApplicable(cols, "IsLinkedToWorkOrder");
                SetNotApplicable(cols, "WorkOrderNo");
                SetNotApplicable(cols, "SalesOrderNo");
                SetNotApplicable(cols, "OrderItemIds");
                SetNotApplicable(cols, "DefectReason");
                SetNotApplicable(cols, "LiabilityType");
                SetNotApplicable(cols, "OriginalSupplier");
                SetNotApplicable(cols, "TagNo");
                SetNotApplicable(cols, "DefectRemark");
                SetNotApplicable(cols, "Meters");
                break;
        }
    }

    private static void SetNotApplicable(List<EditColumnDef> cols, string key)
    {
        var c = cols.FirstOrDefault(x => x.Key == key);
        if (c != null)
        {
            c.IsApplicable = false;
            c.Visible = false;
        }
    }

    // ========== 列管理 ==========

    private async Task MoveColumnUp(EditColumnDef col)
    {
        var idx = _allColumns.IndexOf(col);
        if (idx > 0)
        {
            _allColumns.RemoveAt(idx);
            _allColumns.Insert(idx - 1, col);
            await SaveColumnPrefs();
        }
    }

    private async Task MoveColumnDown(EditColumnDef col)
    {
        var idx = _allColumns.IndexOf(col);
        if (idx < _allColumns.Count - 1)
        {
            _allColumns.RemoveAt(idx);
            _allColumns.Insert(idx + 1, col);
            await SaveColumnPrefs();
        }
    }

    private async Task OnColumnToggle(EditColumnDef col, bool visible)
    {
        col.Visible = visible;
        await SaveColumnPrefs();
    }

    private async Task LoadColumnPrefs()
    {
        var saved = await ColumnPrefs.LoadAsync("inbound", _warehouseCode);
        if (saved.Count > 0)
        {
            foreach (var s in saved)
            {
                var match = _allColumns.FirstOrDefault(c => c.Key == s.Key);
                if (match != null)
                {
                    match.Visible = s.Visible;
                }
            }
            // 恢复顺序：将saved中存在的列按saved顺序重排，新列追加在末尾
            var reordered = new List<EditColumnDef>();
            foreach (var s in saved)
            {
                var match = _allColumns.FirstOrDefault(c => c.Key == s.Key);
                if (match != null && !reordered.Contains(match))
                    reordered.Add(match);
            }
            foreach (var c in _allColumns)
            {
                if (!reordered.Contains(c))
                    reordered.Add(c);
            }
            _allColumns = reordered;
        }

        // 不适用列强制隐藏
        foreach (var c in _allColumns)
        {
            if (!c.IsApplicable) c.Visible = false;
        }
    }

    private async Task SaveColumnPrefs()
    {
        var list = _allColumns.Select(c => new MES.Blazor.Services.ColumnDef
        {
            Key = c.Key,
            Label = c.Label,
            Visible = c.Visible
        }).ToList();
        await ColumnPrefs.SaveAsync("inbound", _warehouseCode, list);
    }

    // ========== 初始化 ==========

    protected override async Task OnInitializedAsync()
    {
        _allColumns = GetAllColumnDefs();

        var result = await WarehouseService.GetAllAsync(true);
        if (result.Success && result.Data != null)
        {
            _warehouses = result.Data;

            if (!string.IsNullOrEmpty(Code))
            {
                var wh = _warehouses.FirstOrDefault(w => w.Code.Equals(Code, StringComparison.OrdinalIgnoreCase));
                if (wh != null)
                {
                    _warehouseId = wh.Id;
                    _warehouseName = wh.Name;
                    _warehouseCode = wh.Code.ToUpperInvariant();
                }
            }

            if (_warehouseId is null or <= 0 && _warehouses.Any())
            {
                _warehouseId = _warehouses[0].Id;
                _warehouseName = _warehouses[0].Name;
                _warehouseCode = _warehouses[0].Code.ToUpperInvariant();
            }
        }

        // 按仓库模板设置适用列
        ApplyWarehouseDefaults(_allColumns, _warehouseCode);
        await LoadColumnPrefs();
    }

    private async Task OnWarehouseChanged(int? whId)
    {
        if (whId.HasValue)
        {
            var wh = _warehouses.FirstOrDefault(w => w.Id == whId.Value);
            if (wh != null)
            {
                _warehouseName = wh.Name;
                _warehouseCode = wh.Code.ToUpperInvariant();
                ResetAll();
                ApplyWarehouseDefaults(_allColumns, _warehouseCode);
                await LoadColumnPrefs();
            }
        }
    }

    // ========== 生成明细行 ==========

    private void GenerateRows()
    {
        if (_rowCount < 1) _rowCount = 1;
        if (_rowCount > 200) _rowCount = 200;

        _rows.Clear();
        for (int i = 0; i < _rowCount; i++)
        {
            _rows.Add(new InboundRowModel());
        }
    }

