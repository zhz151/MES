@page "/"
@using Microsoft.AspNetCore.Authorization
@using MES.Blazor.Services
@inject WorkOrderExecutionService WorkOrderService
@inject SectionParagraphFlowAnalysisService ParagraphFlowSvc
@inject FinalInspectionPlanService FinalInspectionSvc
@inject NcrService NcrSvc
@inject NavigationManager Navigation
@attribute [Authorize]

<MudContainer MaxWidth="MaxWidth.False" Class="mt-4">
    <MudGrid Spacing="3">
        <!-- ======== 左列：工单执行 + 成品检验（各占页面 1/4） ======== -->
        <MudItem xs="12" md="6" Class="d-flex flex-column">
            <MudPaper Class="pa-4 d-flex flex-column flex-grow-1 mb-3" Elevation="1" Style="height:50%">
                <div class="d-flex justify-space-between align-center mb-3">
                    <MudText Typo="Typo.h6" Class="font-weight-bold d-flex align-center">
                        <MudIcon Icon="@Icons.Material.Filled.Assignment" Class="mr-1" Color="Color.Primary" />
                        工单执行
                    </MudText>
                    <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small"
                               OnClick="@(() => Navigation.NavigateTo("/workorder-execution"))">
                        详情 →
                    </MudButton>
                </div>

                <MudTable Items="@_rows" Dense="true" Elevation="0" Class="auto-table">
                    <HeaderContent>
                        <MudTh Class="font-weight-bold">执行阶段</MudTh>
                        <MudTh Class="mud-table-cell--right font-weight-bold">合计（工单数/吨）</MudTh>
                        <MudTh Class="mud-table-cell--right font-weight-bold text-brand">急单合计（工单数/吨）</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd>
                            <a href="@context.NavigateUrl" class="mud-link font-weight-bold" style="text-decoration:none; color:#ffffff; background-color:#0d47a1; padding:3px 10px; border-radius:4px; display:inline-block">
                                @context.StageName
                            </a>
                        </MudTd>
                        <MudTd Class="mud-table-cell--right font-weight-bold">@context.TotalText</MudTd>
                        <MudTd Class="mud-table-cell--right font-weight-bold text-brand">@context.UrgentTotalText</MudTd>
                    </RowTemplate>
                    <FooterContent>
                        <MudTd Class="font-weight-bold">合计</MudTd>
                        <MudTd Class="mud-table-cell--right font-weight-bold">@_footerTotal</MudTd>
                        <MudTd Class="mud-table-cell--right font-weight-bold text-brand">@_footerUrgentTotal</MudTd>
                    </FooterContent>
                </MudTable>

                @if (_isLoadingCard1)
                {
                    <div class="d-flex justify-center mt-3">
                        <MudProgressCircular Indeterminate="true" Size="Size.Small" />
                    </div>
                }
            </MudPaper>

            <MudPaper Class="pa-4 d-flex flex-column flex-grow-1" Elevation="1" Style="height:50%">
                <div class="d-flex justify-space-between align-center mb-3">
                    <MudText Typo="Typo.h6" Class="font-weight-bold d-flex align-center">
                        <MudIcon Icon="@Icons.Material.Filled.FactCheck" Class="mr-1" Color="Color.Primary" />
                        质量检验
                    </MudText>
                </div>

                <div class="d-flex justify-space-between align-center mb-2">
                    <MudText Typo="Typo.subtitle2" Class="font-weight-bold">成品检验</MudText>
                    <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small"
                               OnClick="@(() => Navigation.NavigateTo("/final-inspection-plan"))">
                        成检计划 →
                    </MudButton>
                </div>
                <MudGrid Spacing="2">
                    <MudItem xs="4">
                        <MudPaper Class="pa-3 text-center form-card" Elevation="0">
                            <MudText Typo="Typo.caption" Class="font-weight-bold">@Card3StatText(_card3AwaitingMaterialCount, _card3AwaitingMaterialWeight)</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Error" Class="font-weight-bold">@Card3StatText(_card3AwaitingMaterialUrgentCount, _card3AwaitingMaterialUrgentWeight)</MudText>
                            <MudChip Size="Size.Small" Color="Color.Warning" Class="mt-1">待到料</MudChip>
                        </MudPaper>
                    </MudItem>
                    <MudItem xs="4">
                        <MudPaper Class="pa-3 text-center form-card" Elevation="0">
                            <MudText Typo="Typo.caption" Class="font-weight-bold">@Card3StatText(_card3AwaitingInspectionCount, _card3AwaitingInspectionWeight)</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Error" Class="font-weight-bold">@Card3StatText(_card3AwaitingInspectionUrgentCount, _card3AwaitingInspectionUrgentWeight)</MudText>
                            <MudChip Size="Size.Small" Color="Color.Primary" Class="mt-1">待检验</MudChip>
                        </MudPaper>
                    </MudItem>
                    <MudItem xs="4">
                        <MudPaper Class="pa-3 text-center form-card" Elevation="0">
                            <MudText Typo="Typo.caption" Class="font-weight-bold">@Card3StatText(_card3InInspectionCount, _card3InInspectionWeight)</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Error" Class="font-weight-bold">@Card3StatText(_card3InInspectionUrgentCount, _card3InInspectionUrgentWeight)</MudText>
                            <MudChip Size="Size.Small" Color="Color.Info" Class="mt-1">检验中</MudChip>
                        </MudPaper>
                    </MudItem>
                </MudGrid>

                <div class="d-flex justify-space-between align-center mb-2 mt-3">
                    <MudText Typo="Typo.subtitle2" Class="font-weight-bold">不合格报告</MudText>
                    <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small"
                               OnClick="@(() => Navigation.NavigateTo("/quality/ncr"))">
                        NCR列表 →
                    </MudButton>
                </div>
                <MudGrid Spacing="2">
                    <MudItem xs="6">
                        <MudPaper Class="pa-3 text-center form-card" Elevation="0">
                            <MudText Typo="Typo.h5" Class="font-weight-bold" Color="Color.Error">@_card3PendingCheckBatches</MudText>
                            <MudText Typo="Typo.caption">待处理批次</MudText>
                        </MudPaper>
                    </MudItem>
                    <MudItem xs="6">
                        <MudPaper Class="pa-3 text-center form-card" Elevation="0">
                            <MudText Typo="Typo.h5" Class="font-weight-bold" Color="Color.Warning">@_card3ProcessingNcrs</MudText>
                            <MudText Typo="Typo.caption">处理中</MudText>
                        </MudPaper>
                    </MudItem>
                </MudGrid>

                @if (_isLoadingCard3)
                {
                    <div class="d-flex justify-center mt-3">
                        <MudProgressCircular Indeterminate="true" Size="Size.Small" />
                    </div>
                }
            </MudPaper>
        </MudItem>

        <!-- ======== 右列：批次生产（占页面 1/2，段落流转分析列表） ======== -->
        <MudItem xs="12" md="6">
            <MudPaper Class="pa-4 d-flex flex-column" Elevation="1" Style="height:100%">
                <div class="d-flex justify-space-between align-center mb-3">
                    <MudText Typo="Typo.h6" Class="font-weight-bold d-flex align-center">
                        <MudIcon Icon="@Icons.Material.Filled.Analytics" Class="mr-1" Color="Color.Primary" />
                        批次生产
                    </MudText>
                    <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small"
                               OnClick="@(() => Navigation.NavigateTo("/section-paragraph-flow-analysis"))">
                        详情 →
                    </MudButton>
                </div>

                <MudTable Items="@_paragraphFlowItems" Dense="true" Hover="true" Elevation="0" Class="auto-table"
                          RowsPerPage="25" RowsPerPageLabel="每页行数:">
                    <HeaderContent>
                        <MudTh Class="font-weight-bold">
                            <span @onclick='() => ToggleFlowSort("Category")' style="cursor:pointer">
                                生产段落 @FlowSortIndicator("Category")
                            </span>
                        </MudTh>
                        <MudTh Class="mud-table-cell--right font-weight-bold">
                            <span @onclick='() => ToggleFlowSort("PendingTotal")' style="cursor:pointer">
                                待在产重量 @FlowSortIndicator("PendingTotal")
                            </span>
                        </MudTh>
                        <MudTh Class="mud-table-cell--center font-weight-bold">
                            <span @onclick='() => ToggleFlowSort("StatusJudgment")' style="cursor:pointer">
                                总况判定 @FlowSortIndicator("StatusJudgment")
                            </span>
                        </MudTh>
                        <MudTh Class="mud-table-cell--right font-weight-bold">
                            <span @onclick='() => ToggleFlowSort("PlanFlowQuantity")' style="cursor:pointer">
                                计划重点批流转量 @FlowSortIndicator("PlanFlowQuantity")
                            </span>
                        </MudTh>
                        <MudTh Class="mud-table-cell--center font-weight-bold">
                            <span @onclick='() => ToggleFlowSort("PlanFlowJudgment")' style="cursor:pointer">
                                计划流转判定 @FlowSortIndicator("PlanFlowJudgment")
                            </span>
                        </MudTh>
                        <MudTh Class="mud-table-cell--right font-weight-bold">
                            <span @onclick='() => ToggleFlowSort("PlanKeyWeight")' style="cursor:pointer">
                                特急批重量 @FlowSortIndicator("PlanKeyWeight")
                            </span>
                        </MudTh>
                    </HeaderContent>
                    <RowTemplate Context="item">
                        <MudTd>
                            <span class="font-weight-bold">@item.ParagraphName</span>
                        </MudTd>
                        <MudTd Class="mud-table-cell--right">
                            @FlowRenderInt(item.PendingTotal)
                        </MudTd>
                        <MudTd Class="mud-table-cell--center">
                            <MudChip Size="Size.Small" Color="@FlowGetStatusColor(item.StatusJudgment)">
                                @(item.StatusJudgment ?? "-")
                            </MudChip>
                        </MudTd>
                        <MudTd Class="mud-table-cell--right">
                            @FlowRenderInt(item.PlanFlowQuantity)
                        </MudTd>
                        <MudTd Class="mud-table-cell--center">
                            <MudChip Size="Size.Small" Color="@FlowGetPlanFlowJudgmentColor(item.PlanFlowJudgment)">
                                @(item.PlanFlowJudgment ?? "-")
                            </MudChip>
                        </MudTd>
                        <MudTd Class="mud-table-cell--right">
                            @FlowRenderInt(item.PlanKeyWeight)
                        </MudTd>
                    </RowTemplate>
                    <FooterContent>
                        <MudTd Class="col-footer-cell">&nbsp;</MudTd>
                        <MudTd Class="col-footer-cell col-footer-sum">合计: @FlowRenderInt(_flowTotalPending)</MudTd>
                        <MudTd Class="col-footer-cell">&nbsp;</MudTd>
                        <MudTd Class="col-footer-cell col-footer-sum">合计: @FlowRenderInt(_flowTotalPlanFlowQuantity)</MudTd>
                        <MudTd Class="col-footer-cell">&nbsp;</MudTd>
                        <MudTd Class="col-footer-cell col-footer-sum">合计: @FlowRenderInt(_flowTotalPlanKeyWeight)</MudTd>
                    </FooterContent>
                </MudTable>

                @if (_isLoadingCard2)
                {
                    <div class="d-flex justify-center mt-3">
                        <MudProgressCircular Indeterminate="true" Size="Size.Small" />
                    </div>
                }
            </MudPaper>
        </MudItem>
    </MudGrid>
</MudContainer>
