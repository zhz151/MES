@page "/"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]

@* 手机端（MobileLayout 下传 IsMobile=true）走 mh-* 手机看板（常用入口磁贴 + 两张查询卡，纵向堆叠）；
   桌面端走下方 stack（常用入口 + 两张查询卡）。 *@
<MudContainer MaxWidth="MaxWidth.False" Class="@(IsMobile ? "mh-container" : "mt-4")">
@if (IsMobile)
{
    <!-- ============ 手机端首页看板（上：常用入口 / 下：两张查询卡） ============ -->

    <MudPaper Class="mh-card pa-3" Elevation="0">
        <div class="d-flex align-center mb-2">
            <MudIcon Icon="@Icons.Material.Filled.Apps" Class="mr-1" Color="Color.Primary" />
            <MudText Typo="Typo.subtitle1" Class="font-weight-bold">常用入口</MudText>
        </div>
        @* 与桌面同一份清单（Shared/AppShortcuts.cs），仅样式在手机断点下更紧凑（三列） *@
        <div class="shortcut-grid">
            @foreach (var shortcut in AppShortcuts.Items)
            {
                <AuthorizeView @key="shortcut.Href" Roles="@shortcut.Policy">
                    <a href="@shortcut.Href" class="shortcut-tile">
                        <MudIcon Icon="@shortcut.Icon" Size="Size.Small" Style="@($"color:{shortcut.Accent}")" />
                        <span>@shortcut.Label</span>
                    </a>
                </AuthorizeView>
            }
        </div>
    </MudPaper>

    @* 查询卡：结果就地渲染（非链接跳转）；两个组件自判 IsMobile 走 mh-card 外壳 *@
    <OrderProgressQueryCard />
    <BatchProgressQueryCard />
}
else
{
    <!-- ======== 桌面端：上下堆叠（常用入口卡 + 两张查询卡），各约半屏宽并居中 ======== -->
    <div class="d-flex flex-column home-stack">
        <!-- 区块1：常用入口（高频直达磁贴，按角色过滤；非全量菜单复刻，见 Shared/AppShortcuts.cs） -->
        <MudPaper Class="pa-3 home-stack-card" Elevation="1">
            <div class="d-flex align-center mb-3">
                <MudIcon Icon="@Icons.Material.Filled.Apps" Class="mr-1" Color="Color.Primary" />
                <MudText Typo="Typo.h6" Class="font-weight-bold">常用入口</MudText>
            </div>
            <div class="shortcut-grid">
                @foreach (var shortcut in AppShortcuts.Items)
                {
                    @* @key：确保每项独立实例，避免 AuthorizeView 按顺序复用导致角色判定串位 *@
                    <AuthorizeView @key="shortcut.Href" Roles="@shortcut.Policy">
                        <a href="@shortcut.Href" class="shortcut-tile">
                            <MudIcon Icon="@shortcut.Icon" Size="Size.Small" Style="@($"color:{shortcut.Accent}")" />
                            <span>@shortcut.Label</span>
                        </a>
                    </AuthorizeView>
                }
            </div>
        </MudPaper>

        <!-- 区块2/3：订单进度查询 / 生产批次进度查询（卡内查询框，结果就地渲染，非链接跳转；
             数据源端点 2026-09-14 起仅需登录 → 首页人人可查。外壳 .home-stack-card，与常用入口卡等宽居中） -->
        <OrderProgressQueryCard />
        <BatchProgressQueryCard />
    </div>
}
</MudContainer>
