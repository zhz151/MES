@page "/materials/create"
@using MES.Blazor.Services
@using MES.Core.DTOs
@using Microsoft.AspNetCore.Authorization
@inject MaterialService MaterialService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@attribute [Authorize(Roles = "MaterialStaff,MaterialDirector,Admin")]

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-4">
    <MudCard>
        <MudCardHeader>
            <CardHeaderContent>
                <MudText Typo="Typo.h5" Class="font-weight-bold">
                    <MudIcon Icon="@Icons.Material.Filled.Add" Class="mr-2" Color="Color.Primary" />
                    新建物料
                </MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">创建新的物料档案</MudText>
            </CardHeaderContent>
            <CardHeaderActions>
                <MudButton Variant="Variant.Text" OnClick="GoBack">返回</MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Save" Disabled="@isSubmitting">
                    @if (isSubmitting) { <MudProgressCircular Size="Size.Small" Color="Color.Inherit" /> }
                    else { <span>保存</span> }
                </MudButton>
            </CardHeaderActions>
        </MudCardHeader>
        <MudCardContent>
            <MudGrid>
                <MudItem xs="12" md="4">
                    <MudSelect T="string" Label="物料分类" @bind-Value="request.MaterialCategory" Required="true" Immediate="true">
                        @foreach (var cat in materialCategories)
                        {
                            <MudSelectItem Value="cat">@cat</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudTextField T="string" Label="厂内钢种" @bind-Value="request.PlantGrade" Required="true" />
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudTextField T="string" Label="名义规格" @bind-Value="request.Specification" Required="true" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudSwitch @bind-Value="request.IsActive" Label="启用" />
                </MudItem>
                <MudItem xs="12" md="12">
                    <MudTextField T="string" Label="备注" @bind-Value="request.Remark" Multiline="true" Lines="3" />
                </MudItem>
            </MudGrid>
        </MudCardContent>
    </MudCard>
</MudContainer>

@code {
    private CreateMaterialRequest request = new();
    private bool isSubmitting;
    private List<string> materialCategories = new()
    {
        "圆棒", "荒管", "中间品", "订单成品", "备料成品", "临界成品",
        "次品圆棒", "次品荒管", "次品中间品", "次品成品", "报废品", "余库料"
    };

    private async Task Save()
    {
        if (string.IsNullOrWhiteSpace(request.MaterialCategory)) { Snackbar.Add("物料分类不能为空", Severity.Warning); return; }
        if (string.IsNullOrWhiteSpace(request.PlantGrade)) { Snackbar.Add("厂内钢种不能为空", Severity.Warning); return; }
        if (string.IsNullOrWhiteSpace(request.Specification)) { Snackbar.Add("名义规格不能为空", Severity.Warning); return; }

        isSubmitting = true; StateHasChanged();
        try
        {
            var result = await MaterialService.CreateAsync(request);
            if (result.Success) { Snackbar.Add("创建成功", Severity.Success); Navigation.NavigateTo("/materials"); }
            else { Snackbar.Add(result.Message ?? "创建失败", Severity.Error); }
        }
        catch (Exception ex) { Snackbar.Add($"创建失败: {ex.Message}", Severity.Error); }
        finally { isSubmitting = false; StateHasChanged(); }
    }

    private void GoBack() => Navigation.NavigateTo("/materials");
}
